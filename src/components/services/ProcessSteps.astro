---
import type { HomePageLifecycle, HomePageLifecycleStep } from '../../lib/sanity/types';
import SectionBackground from '../SectionBackground.astro';

interface Step {
  
  number?: string | number;
  title: string;
  headline: string;
  shortDesc?: string;
  description: string;
  image: string;
  iconImage: string;
  badge?: string;
  imageAlt?: string;
}

interface Props {
  lifecycle?: HomePageLifecycle;
  steps?: HomePageLifecycleStep[];
  title?: string;
  subtitle?: string;
}

const fallbackDefaultSteps: Step[] = [
  {
    
    number: '1',
    title: 'COLLECT',
    headline: 'GPS-Tracked Transit',
    shortDesc: 'GPS-Tracked Transit',
    description:
      'We collect your IT equipment securely and transport it through a fully tracked process, ensuring complete visibility from pickup to arrival.',
    badge: 'PHASE 01 // AUDIT & TRANSIT',
    image: '/images/process/01. COLLECT.webp',
    iconImage: '/images/process/01. COLLECT-1.webp',
    imageAlt: 'Techsteps secure collection vehicle and logistics specialist',
  },
  {
    
    
    title: 'SECURE',
    headline: 'Chain of Custody',
    shortDesc: 'Chain of Custody',
    description:
      'Ingestion into biometric-monitored facilities with tamper-evident serialized containment and audited chain of custody.',
    badge: 'PHASE 02 // CUSTODY & CONTAINMENT',
    image: '/images/process/02. SECURE.webp',
    iconImage: '/images/process/02. SECURE-1.webp',
    imageAlt:
      'Techsteps tamper-evident flight case tracking and digital custody verification',
  },
  {
    
    number: '3',
    title: 'PROCESS',
    headline: 'Data Sanitisation',
    shortDesc: 'Data Sanitisation',
    description:
      'Certified sanitisation to NIST 800-88 standards or on-site mobile DIN 66399 mechanical granulation.',
    badge: 'PHASE 03 // DATA SANITISATION',
    image: '/images/process/03. PROCESS.webp',
    iconImage: '/images/process/03. PROCESS-1.webp',
    imageAlt:
      'NIST 800-88 certified hardware data sanitisation and live progress verification',
  },
  {
    
    number: '4',
    title: 'RECOVER',
    headline: 'Value Recovery',
    shortDesc: 'Value Recovery',
    description:
      'Refurbishment, grading, and component testing to extract maximum economic residual value for your enterprise budget.',
    badge: 'PHASE 04 // VALUE RECOVERY',
    image: '/images/process/04. RECOVER.webp',
    iconImage: '/images/process/04. RECOVER-1.webp',
    imageAlt:
      'Enterprise laptop and hard drive component testing and value recovery',
  },
  {
    
    number: '5',
    title: 'RECYCLE',
    headline: 'Zero Landfill',
    shortDesc: 'Zero Landfill',
    description:
      'Ethical B2B remarketing or domestic closed-loop raw material separation, guaranteeing 100% landfill diversion.',
    badge: 'PHASE 05 // ZERO LANDFILL RECYCLING',
    image: '/images/process/RECYCLE.webp',
    iconImage: '/images/process/RECYCLE-1.webp',
    imageAlt:
      'Zero-landfill closed-loop sorting and responsible component recycling',
  },
];

const {
  lifecycle,
  steps: customSteps,
  title: customTitle,
  subtitle: customSubtitle,
} = Astro.props;

const sectionTitle =
  customTitle ||
  lifecycle?.heading ||
  'Our Certified Lifecycle Process';

const sectionSubtitle =
  customSubtitle ||
  lifecycle?.description ||
  'A secure, auditable, and environmentally responsible end-to-end chain of custody.';

const rawSteps =
  customSteps && customSteps.length > 0
    ? customSteps
    : lifecycle?.steps && lifecycle.steps.length > 0
      ? lifecycle.steps
      : fallbackDefaultSteps;

const fallbackImages = [
  {
    main: '/images/process/01. COLLECT.webp',
    icon: '/images/process/01. COLLECT-1.webp',
    badge: 'PHASE 01 // AUDIT & TRANSIT',
  },
  {
    main: '/images/process/02. SECURE.webp',
    icon: '/images/process/02. SECURE-1.webp',
    badge: 'PHASE 02 // CUSTODY & CONTAINMENT',
  },
  {
    main: '/images/process/03. PROCESS.webp',
    icon: '/images/process/03. PROCESS-1.webp',
    badge: 'PHASE 03 // DATA SANITISATION',
  },
  {
    main: '/images/process/04. RECOVER.webp',
    icon: '/images/process/04. RECOVER-1.webp',
    badge: 'PHASE 04 // VALUE RECOVERY',
  },
  {
    main: '/images/process/RECYCLE.webp',
    icon: '/images/process/RECYCLE-1.webp',
    badge: 'PHASE 05 // ZERO LANDFILL RECYCLING',
  },
];

const normalizedSteps: Step[] = rawSteps.map(
  (step: any, idx: number) => {
    const defaultPair =
      fallbackImages[idx % fallbackImages.length];

    const stepNum =
      step.stepNumber ||
      step.number ||
      String(idx + 1).padStart(2, '0');

    const formattedNum =
      String(stepNum)
        .replace(/[^0-9]/g, '')
        .padStart(2, '0') ||
      String(idx + 1).padStart(2, '0');

    let mainImg = defaultPair.main;

    if (typeof step.image === 'string' && step.image) {
      mainImg = step.image;
    } else if (step.imageUrl) {
      mainImg = step.imageUrl;
    } else if (step.image?.asset?.url) {
      mainImg = step.image.asset.url;
    }

    let iconImg = defaultPair.icon;

    if (typeof step.iconImage === 'string' && step.iconImage) {
      iconImg = step.iconImage;
    } else if (step.iconImageUrl) {
      iconImg = step.iconImageUrl;
    } else if (step.iconImage?.asset?.url) {
      iconImg = step.iconImage.asset.url;
    }

    return {
      stepNumber: formattedNum,
      number: step.number || idx + 1,
      title: (
        step.title ||
        `STEP ${formattedNum}`
      ).toUpperCase(),
      headline:
        step.headline ||
        step.shortDesc ||
        step.title ||
        `Phase ${formattedNum}`,
      shortDesc:
        step.shortDesc ||
        step.headline ||
        '',
      description:
        step.description ||
        step.lead ||
        '',
      badge:
        step.badge ||
        defaultPair.badge,
      image: mainImg,
      iconImage: iconImg,
      imageAlt:
        step.imageAlt ||
        `${step.title || 'Process Step'} - Techsteps Certified Lifecycle`,
    };
  }
);

const initialStep =
  normalizedSteps[0] ||
  fallbackDefaultSteps[0];

const navigationIconUrls = [
  'https://res.cloudinary.com/dlbeckur1/image/upload/v1792657475/box_yyzn30.png',
  'https://res.cloudinary.com/dlbeckur1/image/upload/v1792657476/shield_u7rb1s.png',
  'https://res.cloudinary.com/dlbeckur1/image/upload/v1792657476/management_ng3btb.png',
  'https://res.cloudinary.com/dlbeckur1/image/upload/v1792657475/backup_lvmjuu.png',
  'https://res.cloudinary.com/dlbeckur1/image/upload/v1792657475/triangular-arrows-sign-for-recycle_bt41zv.png',
];
---

<section
  class="w-full font-sans relative overflow-hidden isolate"
  id="hero-section-41-lifecycle"
>
  <!-- Subtle ambient glow and mild floating bubbles (Hero style) -->
  <SectionBackground
    variant="hero"
    showBubbles={true}
    bubbleCount={3}
    glow={true}
    glowPosition="center"
  />

  <!-- =====================================================
       SECTION HEADER
       ===================================================== -->
  <div
    class="text-center w-full max-w-3xl mx-auto mb-8 sm:mb-10"
  >
    <h2
      class="text-3xl sm:text-4xl lg:text-[44px] font-bold font-display text-slate-900 tracking-tight leading-[1.14] mb-3 sm:mb-4"
    >
      {sectionTitle}
    </h2>

    <p
      class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal max-w-2xl mx-auto"
    >
      {sectionSubtitle}
    </p>
  </div>

  <!-- =====================================================
       CENTERED WORK PROCESS ANIMATION & CONTENT
       ===================================================== -->
  <div class="mx-auto w-full max-w-4xl px-4 flex flex-col items-center text-center mt-6 sm:mt-8">

    <!-- 1. Scrolling / Circular Process Steps Carousel in Center -->
    <div
      class="relative w-full max-w-[560px] mx-auto overflow-hidden"
      role="region"
      aria-roledescription="carousel"
      aria-label="Lifecycle process steps"
    >
      <!-- Soft fade edge masks -->
      <div
        class="pointer-events-none absolute inset-y-0 left-0 z-20 w-12 sm:w-16 bg-gradient-to-r from-white to-transparent"
        aria-hidden="true"
      ></div>
      <div
        class="pointer-events-none absolute inset-y-0 right-0 z-20 w-12 sm:w-16 bg-gradient-to-l from-white to-transparent"
        aria-hidden="true"
      ></div>

      <!-- Track Viewport -->
      <div class="overflow-hidden w-full" id="hero41-thumb-viewport">
        <div
          class="flex items-stretch transition-transform duration-500 ease-out"
          id="hero41-thumb-track"
        >
          {normalizedSteps.map((step, idx) => {
            const isFirst = idx === 0;

            return (
              <div
                role="button"
                tabindex="0"
                aria-label={`Select Step ${step.stepNumber}: ${step.title}`}
                aria-selected={isFirst ? 'true' : 'false'}
                class={`hero41-thumb-item min-w-0 shrink-0 grow-0 basis-1/5 cursor-pointer px-1 flex flex-col items-center justify-center ${
                  isFirst ? 'active' : ''
                }`}
                data-thumb-index={idx}
                data-number={step.stepNumber}
                data-title={step.title}
                data-headline={step.headline}
                data-desc={step.description}
                data-badge={step.badge}
                data-icon={navigationIconUrls[idx]}
                data-short={step.shortDesc}
              >
                <img
                  src={navigationIconUrls[idx]}
                  alt=""
                  aria-hidden="true"
                  class="hero41-thumb-img w-10 h-10 sm:w-12 sm:h-12 object-contain"
                  loading="lazy"
                  decoding="async"
                />

                <!-- <span class="hero41-thumb-title font-bold text-[10px] sm:text-xs uppercase tracking-wider text-center">
                  {step.title}
                </span> -->
              </div>
            );
          })}
        </div>
      </div>
    </div>

    <!-- 2. Centered Active Step Dynamic Content Below Animation -->
    <div class="max-w-2xl mx-auto flex flex-col items-center text-center mt-3 sm:mt-4">
      
      <!-- Phase Pill Badge -->
      <div
        id="hero41-step-badge"
        class="inline-flex items-center px-3.5 py-1 rounded-full text-xs font-bold font-mono uppercase tracking-[0.16em] bg-[#0F623A]/10 text-[#0F623A] mb-3 transition-opacity duration-200"
      >
        {initialStep.badge || `PHASE ${initialStep.stepNumber} // ${initialStep.title}`}
      </div>

      <!-- Headline -->
      <h3
        id="hero41-step-headline"
        class="text-2xl sm:text-3xl lg:text-[34px] font-semibold font-display text-slate-900 tracking-tight leading-tight transition-opacity duration-200"
      >
        {initialStep.headline}
      </h3>

      <!-- Description -->
      <p
        id="hero41-step-desc"
        class="text-slate-600 text-base sm:text-lg lg:text-[18px] max-w-xl mx-auto leading-relaxed font-normal mt-2.5 transition-opacity duration-200"
      >
        {initialStep.description}
      </p>
    </div>

  </div>
</section>

<!-- =====================================================
     ACTIVE STEP HIGHLIGHT STYLES
     ===================================================== -->
<style>
  .hero41-thumb-item {
    position: relative;
    transition:
      transform 300ms ease,
      opacity 300ms ease;
  }

  /* Default step label */
  .hero41-thumb-label {
    color: #94a3b8;
    opacity: 0.7;
    transform: translateY(2px);
  }

  .hero41-thumb-number,
  .hero41-thumb-title {
    color: #94a3b8;
    transition:
      color 300ms ease,
      opacity 300ms ease;
  }

  /* Active step */
  .hero41-thumb-item.active {
    transform: translateY(-2px);
  }

  .hero41-thumb-item.active .hero41-thumb-label {
    opacity: 1;
    transform: translateY(0);
  }

  .hero41-thumb-item.active .hero41-thumb-number,
  .hero41-thumb-item.active .hero41-thumb-title {
    color: #146b5c;
  }

  /* Active label underline/highlight */
  .hero41-thumb-item.active .hero41-thumb-label::after {
    content: '';
    display: block;
    width: 32px;
    height: 3px;
    margin: 5px auto 0;
    border-radius: 999px;
    background: #146b5c;
  }

  /* Active icon */
  .hero41-thumb-item.active .hero41-thumb-img {
    filter: drop-shadow(0 5px 10px rgba(20, 107, 92, 0.25));
  }

  /* Hover */
  .hero41-thumb-item:hover .hero41-thumb-number,
  .hero41-thumb-item:hover .hero41-thumb-title {
    color: #146b5c;
  }

  /* Keyboard focus */
  .hero41-thumb-item:focus-visible {
    outline: 2px solid #146b5c;
    outline-offset: 4px;
    border-radius: 8px;
  }

  /* Only the existing five-icon navigation moves. */
  #hero41-thumb-viewport {
    height: 164px;
    padding: 24px 0 16px;
    overflow: hidden;
  }

  #hero41-thumb-track {
    position: relative;
    display: block;
    width: 100%;
    height: 124px;
    transform: none !important;
    transition: none !important;
    isolation: isolate;
  }

  .hero41-thumb-item,
  .hero41-thumb-item.active {
    position: absolute;
    top: 15px;
    left: 50%;
    width: 20%;
    height: 100px;
    min-width: 0;
    margin: 0;
    padding: 8px 2px;
    gap: 9px;
    transform-origin: center center;
    will-change: transform;
    transition: none;
  }

  .hero41-thumb-img {
    display: block;
    flex-shrink: 0;
    transform: none;
    opacity: 1;
    filter: none;
    transition: filter 640ms ease;
  }

  .hero41-thumb-title {
    opacity: 1;
    white-space: nowrap;
    transition: color 640ms ease;
  }

  .hero41-thumb-item.active .hero41-thumb-title {
    color: #146B5C;
  }

  @media (max-width: 639px) {
    #hero41-thumb-viewport { height: 144px; padding-top: 20px; }
    #hero41-thumb-track { height: 112px; }
    .hero41-thumb-item, .hero41-thumb-item.active {
      height: 88px;
      top: 14px;
      gap: 7px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero41-thumb-item,
    .hero41-thumb-img,
    .hero41-thumb-title { transition: none !important; }
  }
</style>

<!-- =====================================================
     AUTO-SCROLL ENGINE
     ===================================================== -->
<script is:inline>
  (() => {
    if (window.__hero41LifecycleScriptBound) return;
    window.__hero41LifecycleScriptBound = true;
    const initHero41Lifecycle = () => {
      const container = document.getElementById(
        'hero-section-41-lifecycle'
      );

      if (!container) return;
      if (container.dataset.lifecycleInitialized === 'true') return;
      container.dataset.lifecycleInitialized = 'true';

      const thumbItems =
        container.querySelectorAll('.hero41-thumb-item');

      const thumbTrack =
        document.getElementById('hero41-thumb-track');

      const thumbViewport =
        document.getElementById('hero41-thumb-viewport');

      const stepBadgeEl =
        document.getElementById('hero41-step-badge');

      const headlineEl =
        document.getElementById('hero41-step-headline');

      const descEl =
        document.getElementById('hero41-step-desc');

      const totalItems = thumbItems.length;

      if (totalItems === 0) return;

      let currentIndex = 0;
      let autoplayTimer = null;
      let contentTransitionTimer = null;

      const AUTO_SCROLL_DELAY = 1800;

      /* =================================================
         KEEP EXISTING HORIZONTAL SCROLLING
         ================================================= */
       /* Three-visible circular carousel. Keep all five original items mounted. */
       let visualPhase = 0;
       let motionFrame = 0;
       const MOTION_MS = 680;
       const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

       const renderThumbPositions = (phase) => {
         const width = thumbViewport?.clientWidth || 400;
         const distance = width * 0.285;
         const count = thumbItems.length;

         thumbItems.forEach((item, idx) => {
           // Shortest signed circular distance: RECYCLE -> COLLECT is continuous.
           let offset = ((idx - phase + count / 2) % count + count) % count - count / 2;
           const visible = Math.abs(offset) < 1.5;
           const depth = Math.max(0, 1 - Math.abs(offset));
           const scale = 0.88 + depth * 0.42;
           const x = offset * distance;
           const y = -depth * 6;

           // Three items max at every animation frame, including wraparound.
           item.style.visibility = visible ? 'visible' : 'hidden';
           item.style.pointerEvents = visible ? 'auto' : 'none';
           item.style.opacity = visible ? '1' : '0';
           item.style.transform = `translateX(-50%) translateX(${x.toFixed(2)}px) translateY(${y.toFixed(2)}px) scale(${scale.toFixed(4)})`;
           item.style.zIndex = String(10 + Math.round(depth * 90));
         });
       };

       const updateThumbTrackPosition = (index) => {
         if (!thumbTrack || !thumbViewport || !thumbItems.length) return;
         cancelAnimationFrame(motionFrame);
         const count = thumbItems.length;
         const wrapped = ((Math.round(visualPhase) % count) + count) % count;
         let delta = (index - wrapped + count) % count;
         if (delta > count / 2) delta -= count;
         const startPhase = visualPhase;
         const targetPhase = Math.round(visualPhase) + delta;
         if (reducedMotion.matches || Math.abs(targetPhase - startPhase) < 0.001) {
           visualPhase = targetPhase;
           renderThumbPositions(visualPhase);
           return;
         }
         const started = performance.now();
         const animate = (now) => {
           const t = Math.min(1, (now - started) / MOTION_MS);
           const eased = 1 - Math.pow(1 - t, 3);
           visualPhase = startPhase + (targetPhase - startPhase) * eased;
           renderThumbPositions(visualPhase);
           if (t < 1) motionFrame = requestAnimationFrame(animate);
         };
         motionFrame = requestAnimationFrame(animate);
       };

      /* =================================================
         SELECT STEP
         ================================================= */
      const selectStep = (
        index,
        userInitiated = false
      ) => {
        const previousIndex = currentIndex;
        currentIndex =
          (index + totalItems) %
          totalItems;

        const activeItem =
          thumbItems[currentIndex];

        if (!activeItem) return;

        /* ===============================================
           1. UPDATE DYNAMIC NARRATIVE CONTENT
           =============================================== */
        if (headlineEl && descEl) {
          clearTimeout(contentTransitionTimer);
          const headline = activeItem.getAttribute('data-headline') || '';
          const desc = activeItem.getAttribute('data-desc') || '';
          const num = activeItem.getAttribute('data-number') || '';
          const title = activeItem.getAttribute('data-title') || '';
          const badge = activeItem.getAttribute('data-badge') || '';
          const reduced = reducedMotion.matches;
          const commitContent = () => {
            headlineEl.textContent = headline;
            descEl.textContent = desc;
            if (stepBadgeEl) stepBadgeEl.textContent = badge || `PHASE ${num} // ${title}`;
            headlineEl.style.opacity = '1';
            descEl.style.opacity = '1';
            if (stepBadgeEl) stepBadgeEl.style.opacity = '1';
          };

          if (reduced || previousIndex === currentIndex) {
            commitContent();
          } else {
            headlineEl.style.opacity = '0';
            descEl.style.opacity = '0';
            if (stepBadgeEl) stepBadgeEl.style.opacity = '0';
            contentTransitionTimer = setTimeout(commitContent, 150);
          }
        }

        /* ===============================================
           2. HIGHLIGHT THE ACTIVE STEP
           =============================================== */
        thumbItems.forEach(
          (item, idx) => {
            const isActive =
              idx === currentIndex;

            item.setAttribute(
              'aria-selected',
              isActive
                ? 'true'
                : 'false'
            );

            const numberEl =
              item.querySelector(
                '.hero41-thumb-number'
              );

            const titleEl =
              item.querySelector(
                '.hero41-thumb-title'
              );

            if (isActive) {
              /* -----------------------------------------
                 ACTIVE STEP
                 ----------------------------------------- */
              item.classList.add(
                'active'
              );

              if (numberEl) {
                numberEl.style.color =
                  '#146B5C';
              }

              if (titleEl) {
                titleEl.style.color =
                  '#146B5C';
              }

            } else {
              /* -----------------------------------------
                 INACTIVE STEP
                 ----------------------------------------- */
              item.classList.remove(
                'active'
              );

              if (numberEl) {
                numberEl.style.color =
                  '#94A3B8';
              }

              if (titleEl) {
                titleEl.style.color =
                  '#94A3B8';
              }
            }
          }
        );

        /* ===============================================
           4. KEEP THE EXISTING SCROLLING BEHAVIOR
           =============================================== */
        updateThumbTrackPosition(
          currentIndex
        );

        /* ===============================================
           5. RESET AUTOPLAY
           =============================================== */
         resetAutoplay();
      };

      /* =================================================
         AUTOPLAY
         ================================================= */
      const startAutoplay = () => {
        stopAutoplay();
        if (reducedMotion.matches) return;

        autoplayTimer =
          setInterval(() => {
            selectStep(
              currentIndex + 1
            );
          }, AUTO_SCROLL_DELAY);
      };

      const stopAutoplay = () => {
        if (autoplayTimer) {
          clearInterval(
            autoplayTimer
          );

          autoplayTimer = null;
        }
      };

      document.addEventListener(
        'astro:before-swap',
        () => {
          stopAutoplay();
          cancelAnimationFrame(motionFrame);
          clearTimeout(contentTransitionTimer);
          container.removeAttribute('data-lifecycle-initialized');
        },
        { once: true }
      );

      const resetAutoplay = () => {
        stopAutoplay();
        startAutoplay();
      };

      /* =================================================
         CLICK + KEYBOARD
         ================================================= */
      thumbItems.forEach(
        (item, idx) => {
          item.addEventListener(
            'click',
            () => {
              selectStep(
                idx,
                true
              );
            }
          );

          item.addEventListener(
            'keydown',
            (e) => {
              if (
                e.key === 'Enter' ||
                e.key === ' '
              ) {
                e.preventDefault();

                selectStep(
                  idx,
                  true
                );

              } else if (
                e.key ===
                'ArrowRight'
              ) {
                e.preventDefault();

                const next =
                  (idx + 1) %
                  totalItems;

                thumbItems[
                  next
                ]?.focus();

                selectStep(
                  next,
                  true
                );

              } else if (
                e.key ===
                'ArrowLeft'
              ) {
                e.preventDefault();

                const prev =
                  (idx - 1 +
                    totalItems) %
                  totalItems;

                thumbItems[
                  prev
                ]?.focus();

                selectStep(
                  prev,
                  true
                );
              }
            }
          );
        }
      );

      /* =================================================
         RESIZE
         ================================================= */
      window.addEventListener(
        'resize',
        () => {
          updateThumbTrackPosition(
            currentIndex
          );
        }
      );

      /* =================================================
         INITIALIZE
         ================================================= */
      updateThumbTrackPosition(0);

      /* Make sure first step is highlighted */
      selectStep(0);

      /* selectStep already starts autoplay */
    };

    if (
      document.readyState ===
      'loading'
    ) {
      document.addEventListener(
        'DOMContentLoaded',
        initHero41Lifecycle
      );
    } else {
      initHero41Lifecycle();
    }

    document.addEventListener(
      'astro:page-load',
      initHero41Lifecycle
    );
  })();
</script>