---
interface Step {
  stepNumber: number;
  title: string;
  description: string;
  shortDesc?: string;
  image: string;
}

interface Props {
  steps?: Step[];
  title?: string;
  subtitle?: string;
  lifecycle?: any;
}

const defaultLifecycleSteps: Step[] = [
  {
    stepNumber: 1,
    title: 'COLLECT',
    shortDesc: 'GPS-Tracked Transit',
    description: 'Point-to-point transit in GPS-monitored vehicles with BS 7858 security-vetted drivers.',
    image: '/images/process/new/step-1-collect.png',
  },
  {
    stepNumber: 2,
    title: 'SECURE',
    shortDesc: 'Chain of Custody',
    description: 'Ingestion into biometric-monitored facilities with tamper-evident serialized containment.',
    image: '/images/process/new/step-2-secure.png',
  },
  {
    stepNumber: 3,
    title: 'PROCESS',
    shortDesc: 'Data Sanitisation',
    description: 'Certified sanitisation to NIST 800-88 or on-site mobile DIN 66399 mechanical granulation.',
    image: '/images/process/new/step-3-sanitise.png',
  },
  {
    stepNumber: 4,
    title: 'RECOVER',
    shortDesc: 'Value Recovery',
    description: 'Refurbishment and testing to extract maximum economic residual value for your budget.',
    image: '/images/process/new/step-4-recover.png',
  },
  {
    stepNumber: 5,
    title: 'REUSE / RECYCLE',
    shortDesc: 'Zero Landfill',
    description: 'Ethical B2B remarketing or domestic closed-loop raw material separation (0% landfill).',
    image: '/images/process/new/step-5-recycle.png',
  },
];

const {
  lifecycle,
  steps: propSteps,
  title: propTitle,
  subtitle: propSubtitle,
} = Astro.props;

const title = lifecycle?.heading || propTitle || 'Our Certified Lifecycle Process';
const subtitle = lifecycle?.description || propSubtitle || 'A secure, auditable, and environmentally responsible end-to-end chain of custody.';

const steps: Step[] = (lifecycle?.steps && lifecycle.steps.length > 0)
  ? lifecycle.steps.map((s: any, idx: number) => ({
      stepNumber: parseInt(s.number, 10) || idx + 1,
      title: s.title,
      shortDesc: s.badge ? s.badge.replace(/^PHASE \d+\s*[•\/\/]\s*/i, '') : (defaultLifecycleSteps[idx]?.shortDesc || s.title),
      description: s.description,
      image: defaultLifecycleSteps[idx]?.image || '',
    }))
  : (propSteps || defaultLifecycleSteps);

// Precise coordinates calibrated to the graphic layout:
// textX, textY: Coordinates of the live text block
// objX, objY: Center of the 3D element
// nodeX, nodeY: Position of the circular node along the ascending curve
const stepPositions = [
  {
    textX: 14.9,
    textY: 48.0,
    objX: 14.9,
    objY: 72.0,
    nodeX: 16.6,
    nodeY: 78.3,
  },
  {
    textX: 31.0,
    textY: 25.3,
    objX: 31.5,
    objY: 62.0,
    nodeX: 32.3,
    nodeY: 75.7,
  },
  {
    textX: 48.4,
    textY: 25.3,
    objX: 49.0,
    objY: 52.0,
    nodeX: 50.9,
    nodeY: 58.4,
  },
  {
    textX: 65.5,
    textY: 16.2,
    objX: 66.5,
    objY: 34.0,
    nodeX: 67.6,
    nodeY: 39.1,
  },
  {
    textX: 84.0,
    textY: 5.8,
    objX: 85.5,
    objY: 24.0,
    nodeX: 86.7,
    nodeY: 30.9,
  },
];
---

<div class="space-y-6 sm:space-y-10">
  <!-- Section Header -->
  <div class="text-center max-w-3xl mx-auto space-y-2.5">
    <h2 class="text-3xl font-extrabold font-display text-brand-navy tracking-tight sm:text-4xl lg:text-5xl">
      {title}
    </h2>
    <p class="text-base sm:text-lg text-slate-700 leading-relaxed max-w-xl mx-auto font-medium">
      {subtitle}
    </p>
  </div>

  <!-- DESKTOP WORKFLOW: Clean Graphic with Live Semantic HTML Text Overlays -->
  <div class="hidden md:block relative w-full max-w-6xl mx-auto select-none pt-4 pb-2">
    <!-- Aspect-ratio container exactly matching the 2560x963 image canvas -->
    <div class="relative w-full aspect-[2560/963] overflow-visible">
      <!-- High-resolution clean visual graphic (curved path, 3D elements, glowing aura, nodes) -->
      <img
        src="/images/process/process-graphic-clean-opt.webp"
        alt="Techsteps 5-step lifecycle process flow from collection to certified recycling"
        class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none drop-shadow-sm"
        loading="eager"
        decoding="async"
      />

      <!-- Interactive Step Groups (Text Overlays + Hotspots) -->
      {steps.map((step, idx) => {
        const pos = stepPositions[idx] || { textX: (idx + 1) * 18, textY: 30, nodeX: (idx + 1) * 18, nodeY: 50 };
        const isFirst = idx === 0;

        return (
          <div
            class={`process-step-group group cursor-pointer ${isFirst ? 'active' : ''}`}
            data-process-step={idx}
            role="button"
            tabindex="0"
            aria-label={`Step ${step.stepNumber}: ${step.title} - ${step.shortDesc}`}
          >
            <!-- 1. Live Semantic Text Overlay (Positioned exactly above each 3D object) -->
            <div
              class="process-text-overlay absolute flex flex-col items-center text-center transition-all duration-300 pointer-events-auto"
              style={`left: ${pos.textX}%; top: ${pos.textY}%; transform: translate(-50%, -50%);`}
              data-process-step={idx}
              data-number={step.stepNumber}
              data-title={step.title}
              data-short={step.shortDesc || ''}
              data-desc={step.description}
            >
              <!-- Number & Title -->
              <div class="flex items-center justify-center gap-1.5 font-display font-extrabold uppercase tracking-[0.14em] text-slate-900 group-hover:text-[#0F623A] group-[.active]:text-[#0F623A] group-hover:scale-105 group-[.active]:scale-105 transition-all whitespace-nowrap text-[clamp(11px,1.22vw,16px)] leading-tight">
                <span class="text-[#0F623A] font-black">{step.stepNumber}.</span>
                <span>{step.title}</span>
              </div>

              <!-- Subtitle / Short Description -->
              <p class="font-sans font-medium text-slate-600 group-hover:text-slate-900 group-[.active]:text-slate-950 group-hover:font-semibold group-[.active]:font-semibold transition-all mt-0.5 whitespace-nowrap text-[clamp(9px,0.98vw,13px)] leading-tight">
                {step.shortDesc || step.title}
              </p>
            </div>

            <!-- 2. Interactive Object Hotspot (Enables clicking/hovering directly over the 3D element) -->
            <div
              class="absolute -translate-x-1/2 -translate-y-1/2 w-[14%] h-[34%] rounded-2xl transition-all duration-300 pointer-events-auto z-10"
              style={`left: ${pos.objX}%; top: ${pos.objY}%;`}
              data-process-step={idx}
              title={`Click to view Phase 0${step.stepNumber}: ${step.title}`}
            >
              <!-- Subtle Aura Glow on Hover/Active -->
              <div class="w-full h-full rounded-2xl bg-emerald-400/0 group-hover:bg-emerald-400/10 group-[.active]:bg-emerald-400/15 group-hover:backdrop-blur-[1px] transition-all duration-300"></div>
            </div>

            <!-- 3. Pulsing Luminous Halo around the Line Node when Hovered/Active -->
            <div
              class="absolute -translate-x-1/2 -translate-y-1/2 w-5 h-5 rounded-full border-2 border-emerald-500 bg-emerald-400/30 opacity-0 group-hover:opacity-100 group-[.active]:opacity-100 group-hover:scale-125 group-[.active]:scale-125 transition-all duration-300 pointer-events-none shadow-[0_0_12px_rgba(16,185,129,0.8)] z-20"
              style={`left: ${pos.nodeX}%; top: ${pos.nodeY}%;`}
            ></div>
          </div>
        );
      })}
    </div>
  </div>

  <!-- INTERACTIVE DETAIL CARD (Highlights the selected phase with compliance context) -->
  <div class="hidden md:block max-w-2xl mx-auto text-center p-4 sm:p-5 rounded-2xl bg-white/95 border border-slate-200/90 shadow-sm backdrop-blur-sm transition-all duration-300 mt-2" id="step-detail-card">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-[#0F623A] text-xs font-bold uppercase tracking-wider mb-2">
      <span id="detail-card-badge">Phase 01</span>
      <span class="text-emerald-300">&bull;</span>
      <span id="detail-card-title">{steps[0].title}</span>
    </div>
    <p id="detail-card-desc" class="text-sm sm:text-base text-slate-700 leading-relaxed font-medium">
      {steps[0].description}
    </p>
  </div>

  <!-- MOBILE / TABLET RESPONSIVE WORKFLOW (Vertical timeline with prominent 3D images) -->
  <div class="md:hidden relative pl-6 sm:pl-8 space-y-6 sm:space-y-8 pt-4">
    <!-- Vertical Connecting Glowing Guideline -->
    <div class="absolute left-10 sm:left-12 top-6 bottom-6 w-0.5 bg-gradient-to-b from-[#0F623A] via-[#0F623A] to-[#146B5C] rounded-full" aria-hidden="true"></div>

    {steps.map((step) => (
      <div class="relative flex items-start gap-4 sm:gap-6 group">
        <!-- Pure Step Image (No Box) -->
        <div class="relative z-10 shrink-0 w-20 h-20 flex items-center justify-center">
          <img
            src={step.image}
            alt={`${step.title} process step`}
            class="w-18 h-18 object-contain drop-shadow-md"
            loading="lazy"
            decoding="async"
          />
          <!-- Step Number Badge -->
          <span class="absolute top-0 right-0 w-5 h-5 rounded-full bg-[#0F623A] text-white text-[10px] font-bold flex items-center justify-center shadow-xs">
            {step.stepNumber}
          </span>
        </div>

        <!-- Step Narrative -->
        <div class="space-y-1 pt-2 min-w-0 flex-1">
          <h3 class="text-base sm:text-lg font-bold font-display text-brand-navy tracking-tight group-hover:text-[#0F623A] transition-colors">
            {step.stepNumber}. {step.title}
          </h3>
          <p class="text-xs sm:text-sm font-semibold text-[#0F623A] mb-1">
            {step.shortDesc}
          </p>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
            {step.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</div>

<!-- Interactive Hover & Click Script for Ascending Workflow -->
<script is:inline>
  (() => {
    const initWorkflowCurve = () => {
      const groups = document.querySelectorAll('.process-step-group');
      const badgeEl = document.getElementById('detail-card-badge');
      const titleEl = document.getElementById('detail-card-title');
      const descEl = document.getElementById('detail-card-desc');
      if (!groups.length) return;

      const activateStep = (stepIdx) => {
        groups.forEach((g) => {
          if (g.getAttribute('data-process-step') === stepIdx) {
            g.classList.add('active');
          } else {
            g.classList.remove('active');
          }
        });

        const activeOverlay = document.querySelector(`.process-text-overlay[data-process-step="${stepIdx}"]`);
        if (!activeOverlay) return;

        const number = activeOverlay.getAttribute('data-number') || '1';
        const title = activeOverlay.getAttribute('data-title') || '';
        const desc = activeOverlay.getAttribute('data-desc') || '';

        if (badgeEl) badgeEl.textContent = `Phase 0${number}`;
        if (titleEl) titleEl.textContent = title;
        if (descEl) descEl.textContent = desc;
      };

      groups.forEach((group) => {
        const stepIdx = group.getAttribute('data-process-step');
        group.addEventListener('mouseenter', () => activateStep(stepIdx));
        group.addEventListener('click', () => activateStep(stepIdx));
        group.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activateStep(stepIdx);
          }
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWorkflowCurve);
    } else {
      initWorkflowCurve();
    }
  })();
</script>
