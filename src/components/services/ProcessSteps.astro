---
interface Step {
  stepNumber: number;
  title: string;
  description: string;
  shortDesc?: string;
  image: string;
}

interface Props {
  steps?: Step[];
  title?: string;
  subtitle?: string;
}

const vbWidth = 1200;
const vbHeight = 460;

// Upward Bezier curve control points
const p0 = { x: 0, y: 395 };
const p1 = { x: 300, y: 375 };
const p2 = { x: 700, y: 245 };
const p3 = { x: 1200, y: 95 };

const pathD = `M ${p0.x} ${p0.y} C ${p1.x} ${p1.y}, ${p2.x} ${p2.y}, ${p3.x} ${p3.y}`;

function bezier(t: number, c0: number, c1: number, c2: number, c3: number) {
  const mt = 1 - t;
  return mt * mt * mt * c0 + 3 * mt * mt * t * c1 + 3 * mt * t * t * c2 + t * t * t * c3;
}

function getYAtXPct(xPct: number) {
  const targetX = (xPct / 100) * vbWidth;
  let low = 0, high = 1;
  for (let i = 0; i < 40; i++) {
    const mid = (low + high) / 2;
    const x = bezier(mid, p0.x, p1.x, p2.x, p3.x);
    if (x < targetX) low = mid;
    else high = mid;
  }
  const t = (low + high) / 2;
  const y = bezier(t, p0.y, p1.y, p2.y, p3.y);
  return (y / vbHeight) * 100;
}

const defaultLifecycleSteps: Step[] = [
  {
    stepNumber: 1,
    title: 'Collect',
    shortDesc: 'GPS-Tracked Transit',
    description: 'Point-to-point transit in GPS-monitored vehicles with BS 7858 security-vetted drivers.',
    image: '/images/process/new/step-1-collect.png',
  },
  {
    stepNumber: 2,
    title: 'Secure',
    shortDesc: 'Chain of Custody',
    description: 'Ingestion into biometric-monitored facilities with tamper-evident serialized containment.',
    image: '/images/process/new/step-2-secure.png',
  },
  {
    stepNumber: 3,
    title: 'Process',
    shortDesc: 'Data Sanitisation',
    description: 'Certified sanitisation to NIST 800-88 or on-site mobile DIN 66399 mechanical granulation.',
    image: '/images/process/new/step-3-sanitise.png',
  },
  {
    stepNumber: 4,
    title: 'Recover',
    shortDesc: 'Value Recovery',
    description: 'Refurbishment and testing to extract maximum economic residual value for your budget.',
    image: '/images/process/new/step-4-recover.png',
  },
  {
    stepNumber: 5,
    title: 'Reuse / Recycle',
    shortDesc: 'Zero Landfill',
    description: 'Ethical B2B remarketing or domestic closed-loop raw material separation (0% landfill).',
    image: '/images/process/new/step-5-recycle.png',
  },
];

const {
  steps = defaultLifecycleSteps,
  title = 'Our Certified Lifecycle Process',
  subtitle = 'A secure, auditable, and environmentally responsible end-to-end chain of custody.',
} = Astro.props;

// 5 evenly spaced steps along the curve (10%, 30%, 50%, 70%, 90%)
const curvePositions = [
  { x: 10, y: getYAtXPct(10) },
  { x: 30, y: getYAtXPct(30) },
  { x: 50, y: getYAtXPct(50) },
  { x: 70, y: getYAtXPct(70) },
  { x: 90, y: getYAtXPct(90) },
];
---

<div class="space-y-6 sm:space-y-10">
  <!-- Section Header -->
  <div class="text-center max-w-3xl mx-auto space-y-2.5">
    <h2 class="text-3xl font-extrabold font-display text-brand-navy tracking-tight sm:text-4xl lg:text-5xl">
      {title}
    </h2>
    <p class="text-base sm:text-lg text-slate-700 leading-relaxed max-w-xl mx-auto font-medium">
      {subtitle}
    </p>
  </div>

  <!-- DESKTOP ASCENDING WORKFLOW PATH (Big floating 3D images touching the line, NO box shape) -->
  <div class="hidden lg:block relative w-full max-w-7xl mx-auto min-h-[500px] xl:min-h-[540px] select-none pt-4 pb-2">
    <!-- Ambient glowing path background -->
    <div class="absolute inset-x-0 bottom-6 h-48 bg-gradient-to-t from-emerald-500/10 via-emerald-500/5 to-transparent pointer-events-none blur-3xl"></div>

    <!-- Ascending SVG Track Curve -->
    <svg
      class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-visible"
      viewBox={`0 0 ${vbWidth} ${vbHeight}`}
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <defs>
        <!-- Linear gradient along path from emerald to dark green -->
        <linearGradient id="processCurveGrad" x1="0%" y1="100%" x2="100%" y2="0%">
          <stop offset="0%" stop-color="#0F623A" stop-opacity="0.3" />
          <stop offset="25%" stop-color="#0F623A" stop-opacity="0.8" />
          <stop offset="65%" stop-color="#2EC458" stop-opacity="1" />
          <stop offset="100%" stop-color="#146B5C" stop-opacity="0.9" />
        </linearGradient>

        <!-- Soft diffuse glow filter -->
        <filter id="processGlow" x="-20%" y="-20%" width="140%" height="140%">
          <feGaussianBlur stdDeviation="6" result="blur" />
        </filter>
      </defs>

      <!-- Diffuse Glow under curve -->
      <path
        d={pathD}
        fill="none"
        stroke="#2EC458"
        stroke-width="12"
        stroke-opacity="0.35"
        filter="url(#processGlow)"
      />

      <!-- Solid Primary Track Line -->
      <path
        d={pathD}
        fill="none"
        stroke="url(#processCurveGrad)"
        stroke-width="3"
        stroke-linecap="round"
      />

      <!-- Animated Pulse Dash Line -->
      <path
        d={pathD}
        fill="none"
        stroke="#FFFFFF"
        stroke-width="2.2"
        stroke-dasharray="6 14"
        stroke-linecap="round"
        stroke-opacity="0.8"
        class="animate-pulse"
      />
    </svg>

    <!-- Step Items situated along the Ascending Curve (Touching the line) -->
    {steps.map((step, idx) => {
      const pos = curvePositions[idx] || { x: (idx + 1) * 18, y: 50 };
      const isFirst = idx === 0;

      return (
        <div
          class={`curve-step-node group absolute cursor-pointer z-10 ${isFirst ? 'active' : ''}`}
          style={`left: ${pos.x}%; top: ${pos.y}%; transform: translate(-50%, calc(-100% + 4px));`}
          data-step={idx}
          data-number={step.stepNumber}
          data-title={step.title}
          data-short={step.shortDesc || ''}
          data-desc={step.description}
          role="button"
          tabindex="0"
          aria-label={`Step ${step.stepNumber}: ${step.title}`}
        >
          <div class="flex flex-col items-center text-center">
            <!-- 1. Text Header above Image (Number, Title & Short Desc) -->
            <div class="mb-2 text-center transition-transform duration-300 group-hover:-translate-y-1.5">
              <div class="flex items-center justify-center gap-1.5 text-sm sm:text-[15px] font-extrabold uppercase tracking-wider text-brand-navy group-hover:text-[#0F623A] group-[.active]:text-[#0F623A] transition-colors whitespace-nowrap">
                <span class="text-[#0F623A] group-hover:text-[#2EC458] group-[.active]:text-[#2EC458] font-black">{step.stepNumber}.</span>
                <span>{step.title}</span>
              </div>
              <p class="text-xs sm:text-[13px] text-slate-600 font-semibold tracking-normal mt-0.5 whitespace-nowrap group-hover:text-slate-950 group-[.active]:text-slate-950 transition-colors">
                {step.shortDesc || step.title}
              </p>
            </div>

            <!-- 2. Pure 3D Illustration Image touching the line -->
            <div class="relative group/pedestal flex flex-col items-center justify-end">
              <!-- Soft Aura Glow behind 3D image -->
              <div class="absolute inset-0 bg-emerald-400/25 rounded-full blur-xl opacity-0 group-hover:opacity-100 group-[.active]:opacity-100 transition-opacity duration-300 pointer-events-none"></div>

              <!-- Contact Shadow right on the line -->
              <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-24 sm:w-28 h-3 bg-emerald-950/25 rounded-full blur-[3px] pointer-events-none transition-all group-hover:w-32"></div>

              <!-- Large Prominent 3D Step Image (Bottom touches the line) -->
              <img
                src={step.image}
                alt={`${step.title} process step`}
                class="relative z-10 h-28 sm:h-32 lg:h-36 xl:h-40 w-auto max-w-[150px] sm:max-w-[170px] lg:max-w-[190px] object-contain object-bottom block drop-shadow-xl transition-all duration-300 group-hover:scale-110 group-[.active]:scale-110 group-hover:-translate-y-2 group-[.active]:-translate-y-2 select-none"
                loading="eager"
                decoding="async"
              />

              <!-- Alignment Dot Anchoring Directly on SVG Curve Track -->
              <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 w-3.5 h-3.5 rounded-full bg-[#0F623A] border-2 border-white shadow-md z-20 group-hover:scale-125 group-hover:bg-[#2EC458] group-[.active]:bg-[#2EC458] group-[.active]:scale-125 transition-all"></div>
            </div>
          </div>
        </div>
      );
    })}
  </div>

  <!-- INTERACTIVE DETAIL CARD (Highlights the selected phase with compliance context) -->
  <div class="hidden lg:block max-w-2xl mx-auto text-center p-4 sm:p-5 rounded-2xl bg-white/90 border border-slate-200/80 shadow-xs backdrop-blur-sm transition-all duration-300 mt-2" id="step-detail-card">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 text-[#0F623A] text-xs font-bold uppercase tracking-wider mb-2">
      <span id="detail-card-badge">Phase 01</span>
      <span class="text-emerald-300">&bull;</span>
      <span id="detail-card-title">{steps[0].title}</span>
    </div>
    <p id="detail-card-desc" class="text-sm sm:text-base text-slate-700 leading-relaxed font-medium">
      {steps[0].description}
    </p>
  </div>

  <!-- MOBILE / TABLET RESPONSIVE WORKFLOW (Vertical timeline with prominent images, NO box) -->
  <div class="lg:hidden relative pl-6 sm:pl-8 space-y-6 sm:space-y-8">
    <!-- Vertical Connecting Glowing Guideline -->
    <div class="absolute left-10 sm:left-12 top-6 bottom-6 w-0.5 bg-gradient-to-b from-[#0F623A] via-[#2EC458] to-[#146B5C] rounded-full" aria-hidden="true"></div>

    {steps.map((step) => (
      <div class="relative flex items-start gap-4 sm:gap-6 group">
        <!-- Pure Step Image (No Box) -->
        <div class="relative z-10 shrink-0 w-20 h-20 flex items-center justify-center">
          <img
            src={step.image}
            alt={`${step.title} process step`}
            class="w-18 h-18 object-contain drop-shadow-md"
            loading="lazy"
            decoding="async"
          />
          <!-- Step Number Badge -->
          <span class="absolute top-0 right-0 w-5 h-5 rounded-full bg-[#0F623A] text-white text-[10px] font-bold flex items-center justify-center shadow-xs">
            {step.stepNumber}
          </span>
        </div>

        <!-- Step Narrative -->
        <div class="space-y-1 pt-2 min-w-0 flex-1">
          <h3 class="text-base sm:text-lg font-bold font-display text-brand-navy tracking-tight group-hover:text-[#0F623A] transition-colors">
            {step.stepNumber}. {step.title}
          </h3>
          <p class="text-xs sm:text-sm font-semibold text-[#0F623A] mb-1">
            {step.shortDesc}
          </p>
          <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-medium">
            {step.description}
          </p>
        </div>
      </div>
    ))}
  </div>
</div>

<!-- Interactive Hover & Click Script for Ascending Workflow -->
<script is:inline>
  (() => {
    const initWorkflowCurve = () => {
      const nodes = document.querySelectorAll('.curve-step-node');
      const badgeEl = document.getElementById('detail-card-badge');
      const titleEl = document.getElementById('detail-card-title');
      const descEl = document.getElementById('detail-card-desc');
      if (!nodes.length) return;

      const activateStep = (node) => {
        nodes.forEach((n) => n.classList.remove('active'));
        node.classList.add('active');

        const number = node.getAttribute('data-number') || '1';
        const title = node.getAttribute('data-title') || '';
        const desc = node.getAttribute('data-desc') || '';

        if (badgeEl) badgeEl.textContent = `Phase 0${number}`;
        if (titleEl) titleEl.textContent = title;
        if (descEl) descEl.textContent = desc;
      };

      nodes.forEach((node) => {
        node.addEventListener('mouseenter', () => activateStep(node));
        node.addEventListener('click', () => activateStep(node));
        node.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' || e.key === ' ') {
            e.preventDefault();
            activateStep(node);
          }
        });
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWorkflowCurve);
    } else {
      initWorkflowCurve();
    }
  })();
</script>
