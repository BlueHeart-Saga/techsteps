---
import type { HomePageLifecycle, HomePageLifecycleStep } from '../../lib/sanity/types';

interface Step {
  stepNumber: string;
  number?: string | number;
  title: string;
  headline: string;
  shortDesc?: string;
  description: string;
  image: string;
  iconImage?: string;
  badge?: string;
  imageAlt?: string;
}

interface Props {
  lifecycle?: HomePageLifecycle;
  steps?: HomePageLifecycleStep[];
  title?: string;
  subtitle?: string;
}

const fallbackDefaultSteps: Step[] = [
  {
    stepNumber: '01',
    number: '1',
    title: 'COLLECT',
    headline: 'GPS-Tracked Transit',
    shortDesc: 'GPS-Tracked Transit',
    description: 'We collect your IT equipment securely and transport it through a fully tracked process, ensuring complete visibility from pickup to arrival.',
    badge: 'PHASE 01 // AUDIT & TRANSIT',
    image: '/images/process/01. COLLECT.webp',
    imageAlt: 'Techsteps secure collection vehicle and logistics specialist',
  },
  {
    stepNumber: '02',
    number: '2',
    title: 'SECURE',
    headline: 'Chain of Custody',
    shortDesc: 'Chain of Custody',
    description: 'Ingestion into biometric-monitored facilities with tamper-evident serialized containment and audited chain of custody.',
    badge: 'PHASE 02 // CUSTODY & CONTAINMENT',
    image: '/images/process/02. SECURE.webp',
    imageAlt: 'Techsteps tamper-evident flight case tracking and digital custody verification',
  },
  {
    stepNumber: '03',
    number: '3',
    title: 'PROCESS',
    headline: 'Data Sanitisation',
    shortDesc: 'Data Sanitisation',
    description: 'Certified sanitisation to NIST 800-88 standards or on-site mobile DIN 66399 mechanical granulation.',
    badge: 'PHASE 03 // DATA SANITISATION',
    image: '/images/process/03. PROCESS.webp',
    imageAlt: 'NIST 800-88 certified hardware data sanitisation and live progress verification',
  },
  {
    stepNumber: '04',
    number: '4',
    title: 'RECOVER',
    headline: 'Value Recovery',
    shortDesc: 'Value Recovery',
    description: 'Refurbishment, grading, and component testing to extract maximum economic residual value for your enterprise budget.',
    badge: 'PHASE 04 // VALUE RECOVERY',
    image: '/images/process/04. RECOVER.webp',
    imageAlt: 'Enterprise laptop and hard drive component testing and value recovery',
  },
  {
    stepNumber: '05',
    number: '5',
    title: 'RECYCLE',
    headline: 'Zero Landfill',
    shortDesc: 'Zero Landfill',
    description: 'Ethical B2B remarketing or domestic closed-loop raw material separation, guaranteeing 100% landfill diversion.',
    badge: 'PHASE 05 // ZERO LANDFILL RECYCLING',
    image: '/images/process/RECYCLE.webp',
    imageAlt: 'Zero-landfill closed-loop sorting and responsible component recycling',
  },
];

const { lifecycle, steps: customSteps, title: customTitle, subtitle: customSubtitle } = Astro.props;

const sectionEyebrow = lifecycle?.eyebrow || 'CERTIFIED PROCESS';
const sectionTitle = customTitle || lifecycle?.heading || 'Our Certified Lifecycle Process';
const sectionSubtitle = customSubtitle || lifecycle?.description || 'A Secure, Auditable, And Environmentally Responsible End-To-End Chain Of Custody.';

const rawSteps = (customSteps && customSteps.length > 0)
  ? customSteps
  : (lifecycle?.steps && lifecycle.steps.length > 0)
    ? lifecycle.steps
    : fallbackDefaultSteps;

const fallbackImages = [
  '/images/process/01. COLLECT.webp',
  '/images/process/02. SECURE.webp',
  '/images/process/03. PROCESS.webp',
  '/images/process/04. RECOVER.webp',
  '/images/process/RECYCLE.webp',
];

const normalizedSteps: Step[] = rawSteps.map((step: any, idx: number) => {
  const stepNum = step.stepNumber || step.number || String(idx + 1).padStart(2, '0');
  const formattedNum = String(stepNum).replace(/[^0-9]/g, '').padStart(2, '0') || String(idx + 1).padStart(2, '0');

  let mainImg = fallbackImages[idx % fallbackImages.length];
  if (typeof step.image === 'string' && step.image) {
    mainImg = step.image;
  } else if (step.imageUrl) {
    mainImg = step.imageUrl;
  } else if (step.image?.asset?.url) {
    mainImg = step.image.asset.url;
  }

  return {
    stepNumber: formattedNum,
    number: step.number || idx + 1,
    title: (step.title || `STEP ${formattedNum}`).toUpperCase(),
    headline: step.headline || step.shortDesc || step.title || `Phase ${formattedNum}`,
    shortDesc: step.shortDesc || step.headline || '',
    description: step.description || step.lead || '',
    badge: step.badge || `PHASE ${formattedNum}`,
    image: mainImg,
    imageAlt: step.imageAlt || `${step.title || 'Process Step'} - Techsteps Certified Lifecycle`,
  };
});
---

<div class="work-process-journey w-full select-none font-sans" id="work-process-section">
  
  <!-- ========================================================= -->
  <!-- SECTION HEADER                                            -->
  <!-- ========================================================= -->
  <div class="text-center w-full max-w-3xl mx-auto space-y-3 mb-8 sm:mb-10 lg:mb-12">
    <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/20 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono">
      <span class="w-1.5 h-1.5 rounded-full bg-[#3FB33D] animate-pulse"></span>
      {sectionEyebrow}
    </span>
    
    <h2 class="text-3xl sm:text-4xl lg:text-[46px] xl:text-[50px] font-extrabold font-display text-slate-900 tracking-tight leading-[1.14]">
      {sectionTitle}
    </h2>

    <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal max-w-2xl mx-auto">
      {sectionSubtitle}
    </p>
  </div>

  <!-- ========================================================= -->
  <!-- DESKTOP ZIG-ZAG TIMELINE JOURNEY (Screen >= 1024px)       -->
  <!-- ========================================================= -->
  <div class="hidden lg:block relative w-full max-w-[1340px] mx-auto min-h-[520px] xl:min-h-[550px] px-2" id="zigzag-desktop-container">
    
    <!-- SVG CONNECTING PATH LAYER (Behind the items) -->
    <svg
      id="zigzag-svg"
      class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-visible"
      aria-hidden="true"
    >
      <defs>
        <!-- Soft glowing filter for active line energy pulse -->
        <filter id="zigzag-glow" x="-20%" y="-20%" width="140%" height="140%">
          <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#3FB33D" flood-opacity="0.35" />
        </filter>
      </defs>

      <!-- Inactive Master Connecting Path (#D8E7DD) -->
      <path
        id="zigzag-inactive-path"
        class="zigzag-inactive-path"
        d=""
        stroke="#D8E7DD"
        stroke-width="3"
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-dasharray="6 6"
        fill="none"
      />

      <!-- Progressive Active Green Segments (#3FB33D) -->
      {normalizedSteps.slice(0, -1).map((_, idx) => (
        <path
          id={`zigzag-active-seg-${idx}`}
          class="zigzag-active-segment"
          data-segment-index={idx}
          d=""
          stroke="#3FB33D"
          stroke-width="3.5"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
          filter="url(#zigzag-glow)"
          style="stroke-dasharray: 400; stroke-dashoffset: 400; transition: stroke-dashoffset 0.65s cubic-bezier(0.25, 1, 0.5, 1);"
        />
      ))}

      <!-- Segment Waypoint Dots (Centered along each zig-zag connection) -->
      {normalizedSteps.slice(0, -1).map((_, idx) => (
        <g
          id={`waypoint-node-${idx}`}
          class="waypoint-node transition-transform duration-500"
          data-waypoint-index={idx}
          transform="translate(-100, -100)"
        >
          <!-- Outer pulsing halo when active -->
          <circle
            r="12"
            fill="#3FB33D"
            class="waypoint-halo opacity-0 transition-opacity duration-300"
          />
          <!-- Outer circle -->
          <circle
            r="6"
            fill="#D8E7DD"
            class="waypoint-outer transition-colors duration-400"
          />
          <!-- Inner crisp white core -->
          <circle
            r="2.5"
            fill="#FFFFFF"
          />
        </g>
      ))}
    </svg>

    <!-- HORIZONTAL 5-STEP ZIG-ZAG GRID (Alternating Upper & Lower) -->
    <div class="relative z-10 grid grid-cols-5 gap-3 xl:gap-5 w-full h-full items-start">
      {normalizedSteps.map((step, idx) => {
        // Alternating positions: 0, 2, 4 = upper (01, 03, 05) | 1, 3 = lower (02, 04)
        const isUpper = idx % 2 === 0;
        const isFirst = idx === 0;

        return (
          <div
            class={`zigzag-step-item relative flex flex-col items-center text-center transition-all duration-700 ease-out cursor-pointer ${
              isUpper ? 'pt-2 pb-24' : 'pt-36 xl:pt-40 pb-2'
            } ${isFirst ? 'is-revealed is-active' : 'is-hidden'}`}
            data-step-index={idx}
            id={`desktop-step-${idx}`}
            role="button"
            tabindex="0"
            aria-label={`Step ${step.stepNumber}: ${step.title}`}
          >
            <!-- Anchor Dot for SVG Path Alignment -->
            <div
              class="step-anchor absolute opacity-0 pointer-events-none"
              data-anchor-index={idx}
              style="top: 140px; left: 50%; transform: translateX(-50%);"
            ></div>

            <!-- 1. STEP NUMBER -->
            <div class="step-num-wrap mb-2 sm:mb-2.5">
              <span class="step-number font-mono font-extrabold text-xl sm:text-2xl tracking-wider text-[#0F623A] transition-colors duration-400">
                {step.stepNumber}
              </span>
            </div>

            <!-- 2. 3D PROCESS IMAGE (Clean floating graphic without white box) -->
            <div class="process-image-plate relative group/img mb-3">
              <div
                class="plate-card relative w-[160px] xl:w-[185px] h-[118px] xl:h-[135px] flex items-center justify-center transition-all duration-400 group-hover/img:-translate-y-1.5"
              >
                <img
                  src={step.image}
                  alt={step.imageAlt}
                  class="step-img w-full h-full object-contain select-none transition-transform duration-400 group-hover/img:scale-[1.06] drop-shadow-[0_12px_24px_rgba(15,98,58,0.15)] mix-blend-multiply"
                  loading={idx < 2 ? 'eager' : 'lazy'}
                  decoding="async"
                />
              </div>
            </div>

            <!-- 3. PROCESS TITLE -->
            <h3 class="step-title font-display font-bold text-base xl:text-[17px] text-[#0F623A] tracking-wider uppercase mb-1.5 transition-colors duration-400">
              {step.title}
            </h3>

            <!-- 4. PROCESS DESCRIPTION (Constrained to ~180-230px) -->
            <p class="step-description text-xs sm:text-[13px] text-slate-600 leading-relaxed max-w-[190px] xl:max-w-[220px] mx-auto font-normal transition-colors duration-400">
              {step.description}
            </p>

          </div>
        );
      })}
    </div>

  </div>

  <!-- ========================================================= -->
  <!-- MOBILE & TABLET VERTICAL JOURNEY (Screen < 1024px)        -->
  <!-- ========================================================= -->
  <div class="lg:hidden relative w-full max-w-[500px] mx-auto px-4" id="zigzag-mobile-container">
    <div class="flex flex-col items-center w-full">
      {normalizedSteps.map((step, idx) => {
        const isFirst = idx === 0;
        const isLast = idx === normalizedSteps.length - 1;

        return (
          <div class="w-full flex flex-col items-center">
            
            <!-- Step Item Block -->
            <div
              class={`mobile-step-item w-full flex flex-col items-center text-center transition-all duration-700 ease-out ${
                isFirst ? 'is-revealed is-active' : 'is-hidden'
              }`}
              data-mobile-index={idx}
              id={`mobile-step-${idx}`}
            >
              <!-- Step Number -->
              <span class="step-number font-mono font-extrabold text-xl tracking-wider text-[#0F623A] mb-2 transition-colors duration-400">
                {step.stepNumber}
              </span>

              <!-- 3D Process Image (Clean floating graphic without white box) -->
              <div class="process-image-plate relative mb-3">
                <div class="relative w-[180px] sm:w-[200px] h-[130px] sm:h-[145px] flex items-center justify-center p-1">
                  <img
                    src={step.image}
                    alt={step.imageAlt}
                    class="w-full h-full object-contain select-none drop-shadow-[0_10px_20px_rgba(15,98,58,0.15)] mix-blend-multiply"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>

              <!-- Title -->
              <h3 class="step-title font-display font-bold text-lg text-[#0F623A] tracking-wider uppercase mb-1">
                {step.title}
              </h3>

              <!-- Description -->
              <p class="step-description text-sm text-slate-600 leading-relaxed max-w-[260px] mx-auto font-normal">
                {step.description}
              </p>
            </div>

            <!-- Vertical Animated Connecting Line Between Steps -->
            {!isLast && (
              <div
                class="mobile-connector-line h-16 sm:h-20 w-[3px] bg-[#D8E7DD] my-4 relative overflow-hidden rounded-full"
                data-mobile-line-index={idx}
              >
                <!-- Animated Active Fill -->
                <div
                  class="mobile-line-fill w-full h-full bg-[#3FB33D] rounded-full transform -translate-y-full transition-transform duration-600 ease-out"
                ></div>
                <!-- Midpoint Waypoint Dot -->
                <div
                  class="mobile-waypoint-dot w-3 h-3 rounded-full bg-[#D8E7DD] border-2 border-white absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 transition-colors duration-400 shadow-xs"
                ></div>
              </div>
            )}

          </div>
        );
      })}
    </div>
  </div>

</div>

<style>
  /* -------------------------------------------------- */
  /* Sequential Animation Base States                    */
  /* -------------------------------------------------- */
  
  /* Hidden step before animation reaches it */
  .zigzag-step-item.is-hidden,
  .mobile-step-item.is-hidden {
    opacity: 0.15;
    pointer-events: none;
  }

  .zigzag-step-item.is-hidden .process-image-plate,
  .mobile-step-item.is-hidden .process-image-plate {
    opacity: 0;
    transform: translateY(25px) scale(0.96);
  }

  .zigzag-step-item.is-hidden .step-number,
  .mobile-step-item.is-hidden .step-number {
    opacity: 0;
    transform: translateY(10px);
  }

  .zigzag-step-item.is-hidden .step-title,
  .mobile-step-item.is-hidden .step-title {
    opacity: 0;
    transform: translateY(10px);
  }

  .zigzag-step-item.is-hidden .step-description,
  .mobile-step-item.is-hidden .step-description {
    opacity: 0;
    transform: translateY(10px);
  }

  /* Revealed state */
  .zigzag-step-item.is-revealed,
  .mobile-step-item.is-revealed {
    opacity: 1;
    pointer-events: auto;
  }

  .zigzag-step-item.is-revealed .process-image-plate,
  .mobile-step-item.is-revealed .process-image-plate {
    opacity: 1;
    transform: translateY(0) scale(1);
    transition:
      opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1),
      transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .zigzag-step-item.is-revealed .step-number,
  .mobile-step-item.is-revealed .step-number {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.5s ease 0.1s,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.1s;
  }

  .zigzag-step-item.is-revealed .step-title,
  .mobile-step-item.is-revealed .step-title {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.5s ease 0.15s,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.15s;
  }

  .zigzag-step-item.is-revealed .step-description,
  .mobile-step-item.is-revealed .step-description {
    opacity: 1;
    transform: translateY(0);
    transition:
      opacity 0.5s ease 0.2s,
      transform 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.2s;
  }

  /* -------------------------------------------------- */
  /* Active Step Visual Emphasis                        */
  /* -------------------------------------------------- */
  .zigzag-step-item.is-active .step-number,
  .mobile-step-item.is-active .step-number {
    color: #3FB33D;
    text-shadow: 0 0 12px rgba(63, 179, 61, 0.25);
  }

  .zigzag-step-item.is-active .step-img,
  .mobile-step-item.is-active img {
    filter: drop-shadow(0 14px 24px rgba(15, 98, 58, 0.22));
    transform: scale(1.04);
  }

  .zigzag-step-item.is-active .step-title,
  .mobile-step-item.is-active .step-title {
    color: #0F623A;
  }

  /* -------------------------------------------------- */
  /* Waypoint Nodes                                     */
  /* -------------------------------------------------- */
  .waypoint-node.is-active .waypoint-outer {
    fill: #3FB33D;
  }

  .waypoint-node.is-active .waypoint-halo {
    opacity: 0.35;
  }

  /* -------------------------------------------------- */
  /* Reduced Motion Support                             */
  /* -------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .zigzag-step-item,
    .mobile-step-item {
      opacity: 1 !important;
      pointer-events: auto !important;
    }

    .zigzag-step-item .process-image-plate,
    .mobile-step-item .process-image-plate,
    .zigzag-step-item .step-number,
    .mobile-step-item .step-number,
    .zigzag-step-item .step-title,
    .mobile-step-item .step-title,
    .zigzag-step-item .step-description,
    .mobile-step-item .step-description {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }

    .zigzag-active-segment {
      stroke-dashoffset: 0 !important;
      transition: none !important;
    }

    .mobile-line-fill {
      transform: translateY(0) !important;
      transition: none !important;
    }

    .waypoint-outer,
    .mobile-waypoint-dot {
      fill: #3FB33D !important;
      background-color: #3FB33D !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const initWorkProcessTimeline = () => {
      const section = document.getElementById('work-process-section');
      if (!section) return;

      const desktopContainer = section.querySelector('#zigzag-desktop-container');
      const mobileContainer = section.querySelector('#zigzag-mobile-container');
      const svg = section.querySelector('#zigzag-svg');
      const inactivePath = section.querySelector('#zigzag-inactive-path');
      const desktopSteps = Array.from(section.querySelectorAll('.zigzag-step-item'));
      const activeSegments = Array.from(section.querySelectorAll('.zigzag-active-segment'));
      const waypointNodes = Array.from(section.querySelectorAll('.waypoint-node'));

      const mobileSteps = Array.from(section.querySelectorAll('.mobile-step-item'));
      const mobileLineFills = Array.from(section.querySelectorAll('.mobile-line-fill'));
      const mobileWaypointDots = Array.from(section.querySelectorAll('.mobile-waypoint-dot'));

      const totalSteps = desktopSteps.length;
      if (totalSteps <= 1) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ----------------------------------------------------
      // 1. RECOMPUTE SVG ZIG-ZAG PATH COORDINATES (Desktop)
      // ----------------------------------------------------
      let segmentLengths = [];

      const updateSvgPaths = () => {
        if (!svg || !desktopContainer || window.innerWidth < 1024) return;

        const svgRect = svg.getBoundingClientRect();
        if (svgRect.width === 0 || svgRect.height === 0) return;

        const points = desktopSteps.map((step) => {
          const card = step.querySelector('.plate-card');
          if (!card) return { x: 0, y: 0 };
          const rect = card.getBoundingClientRect();
          return {
            x: rect.left + rect.width / 2 - svgRect.left,
            y: rect.top + rect.height / 2 - svgRect.top,
          };
        });

        // 1.1 Inactive connecting path (Dashed #D8E7DD)
        let d = '';
        points.forEach((p, i) => {
          d += i === 0 ? `M ${p.x.toFixed(1)} ${p.y.toFixed(1)}` : ` L ${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
        });
        if (inactivePath) {
          inactivePath.setAttribute('d', d);
        }

        // 1.2 Individual Active Segments (#3FB33D)
        segmentLengths = [];
        for (let i = 0; i < points.length - 1; i++) {
          const seg = activeSegments[i];
          if (seg) {
            const p1 = points[i];
            const p2 = points[i + 1];
            const segD = `M ${p1.x.toFixed(1)} ${p1.y.toFixed(1)} L ${p2.x.toFixed(1)} ${p2.y.toFixed(1)}`;
            seg.setAttribute('d', segD);

            const len = Math.hypot(p2.x - p1.x, p2.y - p1.y);
            segmentLengths[i] = len;

            // Preserve current reveal state of the segment
            const isRevealed = seg.classList.contains('is-drawn');
            seg.style.strokeDasharray = `${len.toFixed(1)}`;
            seg.style.strokeDashoffset = isRevealed ? '0' : `${len.toFixed(1)}`;
          }

          // 1.3 Waypoint Dots at midpoint of segment
          const wp = waypointNodes[i];
          if (wp) {
            const midX = (points[i].x + points[i + 1].x) / 2;
            const midY = (points[i].y + points[i + 1].y) / 2;
            wp.setAttribute('transform', `translate(${midX.toFixed(1)}, ${midY.toFixed(1)})`);
          }
        }
      };

      // ----------------------------------------------------
      // 2. SEQUENTIAL JOURNEY CONTROLLER (01 -> 02 -> 03 ...)
      // ----------------------------------------------------
      let currentStepIndex = 0;
      let isAnimating = false;
      let sequenceTimer = null;
      let hasStarted = false;

      const advanceToStep = (targetIndex, immediate = false) => {
        if (targetIndex <= currentStepIndex && hasStarted) return;
        currentStepIndex = Math.min(totalSteps - 1, targetIndex);

        // Update Desktop & Mobile Steps up to targetIndex
        desktopSteps.forEach((step, idx) => {
          if (idx <= currentStepIndex) {
            step.classList.remove('is-hidden');
            step.classList.add('is-revealed');
          }
          if (idx === currentStepIndex) {
            step.classList.add('is-active');
          } else {
            step.classList.remove('is-active');
          }
        });

        mobileSteps.forEach((step, idx) => {
          if (idx <= currentStepIndex) {
            step.classList.remove('is-hidden');
            step.classList.add('is-revealed');
          }
          if (idx === currentStepIndex) {
            step.classList.add('is-active');
          } else {
            step.classList.remove('is-active');
          }
        });

        // Update Desktop Path Segments
        activeSegments.forEach((seg, idx) => {
          if (idx < currentStepIndex) {
            seg.classList.add('is-drawn');
            seg.style.strokeDashoffset = '0';
          }
        });

        waypointNodes.forEach((wp, idx) => {
          if (idx < currentStepIndex) {
            wp.classList.add('is-active');
          }
        });

        // Update Mobile Connector Lines
        mobileLineFills.forEach((fill, idx) => {
          if (idx < currentStepIndex) {
            fill.style.transform = 'translateY(0)';
          }
        });

        mobileWaypointDots.forEach((dot, idx) => {
          if (idx < currentStepIndex) {
            dot.style.backgroundColor = '#3FB33D';
          }
        });
      };

      const runStepTransition = (fromIdx) => {
        if (fromIdx >= totalSteps - 1) return;
        const nextIdx = fromIdx + 1;
        isAnimating = true;

        // 1. Draw segment fromIdx -> nextIdx
        const seg = activeSegments[fromIdx];
        if (seg) {
          seg.classList.add('is-drawn');
          seg.style.strokeDashoffset = '0';
        }

        const mobFill = mobileLineFills[fromIdx];
        if (mobFill) {
          mobFill.style.transform = 'translateY(0)';
        }

        // Halfway mark: waypoint activates
        setTimeout(() => {
          if (waypointNodes[fromIdx]) {
            waypointNodes[fromIdx].classList.add('is-active');
          }
          if (mobileWaypointDots[fromIdx]) {
            mobileWaypointDots[fromIdx].style.backgroundColor = '#3FB33D';
          }
        }, 280);

        // When line reaches the next step: reveal next step
        setTimeout(() => {
          advanceToStep(nextIdx);
          isAnimating = false;

          // Schedule next step transition
          if (nextIdx < totalSteps - 1) {
            sequenceTimer = setTimeout(() => {
              runStepTransition(nextIdx);
            }, 420);
          }
        }, 580);
      };

      const startSequence = () => {
        if (hasStarted) return;
        hasStarted = true;

        if (prefersReducedMotion) {
          advanceToStep(totalSteps - 1, true);
          return;
        }

        // Step 01 is already visible; start animating connection toward Step 02 after 350ms
        sequenceTimer = setTimeout(() => {
          runStepTransition(0);
        }, 350);
      };

      // ----------------------------------------------------
      // 3. SCROLL & INTERSECTION TRIGGER
      // ----------------------------------------------------
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                updateSvgPaths();
                startSequence();
              }
            });
          },
          {
            threshold: 0.15,
            rootMargin: '0px 0px -10% 0px',
          }
        );

        observer.observe(section);
      } else {
        startSequence();
      }

      // Fast-forward on click of any step
      desktopSteps.forEach((step, idx) => {
        step.addEventListener('click', () => {
          if (sequenceTimer) clearTimeout(sequenceTimer);
          advanceToStep(idx, true);
          if (idx < totalSteps - 1) {
            sequenceTimer = setTimeout(() => runStepTransition(idx), 350);
          }
        });
      });

      // Window resize handling with debouncing
      let resizeTimer = null;
      window.addEventListener(
        'resize',
        () => {
          if (resizeTimer) clearTimeout(resizeTimer);
          resizeTimer = setTimeout(updateSvgPaths, 80);
        },
        { passive: true }
      );

      // Initial layout measurement
      setTimeout(updateSvgPaths, 100);
      setTimeout(updateSvgPaths, 400);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initWorkProcessTimeline);
    } else {
      initWorkProcessTimeline();
    }

    document.addEventListener('astro:page-load', initWorkProcessTimeline);
  })();
</script>
