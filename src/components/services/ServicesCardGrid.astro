---
import Container from '../layout/Container.astro';
import { getHomePage } from '../../lib/sanity/client';

interface ServiceItem {
  id?: number | string;
  divisionNumber?: string;
  number?: string;
  title: string;
  description: string;
  image?: any;
  imageUrl?: string;
  imageAlt?: string;
  buttonText?: string;
  link?: string;
}

interface Props {
  services?: ServiceItem[];
  eyebrow?: string;
  heading?: string;
  description?: string;
  viewAllText?: string;
  viewAllLink?: string;
}

const homePage = await getHomePage();

const {
  services: propServices,
  eyebrow = homePage?.services?.eyebrow || 'OUR SERVICES',
  heading = homePage?.services?.heading || 'Services For The Complete Business Lifecycle',
  viewAllText = 'Explore Our Services→',
  viewAllLink = homePage?.services?.viewAllLink || '/services',
} = Astro.props;

const fallbackImages = [
  '/images/services/1.webp',
  '/images/services/2.webp',
  '/images/services/3.webp',
  '/images/services/4.webp',
];

const formatServiceNumber = (numStr?: string, fallback = '01') => {
  if (!numStr) return fallback;
  const digits = numStr.replace(/[^0-9]/g, '');
  return digits ? digits.padStart(2, '0') : fallback;
};

const defaultServiceCards = (homePage?.services?.cards || []).map((card, idx) => {
  const cardImg = fallbackImages[idx % fallbackImages.length];

  return {
    id: idx,
    divisionNumber: card.divisionNumber || `DIVISION ${String(idx + 1).padStart(2, '0')}`,
    number: formatServiceNumber(card.divisionNumber, String(idx + 1).padStart(2, '0')),
    title: card.title || '',
    description: card.description || '',
    image: cardImg,
    imageAlt: card.imageAlt || card.title || '',
    link: card.link || '#',
    buttonText: card.buttonText || 'View Service',
  };
});

const services = (propServices && propServices.length > 0) ? propServices : defaultServiceCards;

const items = services
  .map((item, idx) => {
    let imgUrl =
      (typeof item.image === 'string' && item.image.length > 0)
        ? item.image
        : (item.image?.asset?.url || item.imageUrl || fallbackImages[idx % fallbackImages.length]);

    return {
      id: item.id ?? idx,
      title: item.title,
      description: item.description,
      image: imgUrl,
      imageAlt: item.imageAlt || `${item.title} - TechSteps Service`,
      buttonText: item.buttonText || 'View Service',
      link: item.link || '#',
    };
  })
  .sort((a, b) => {
    const aIsLifecycle = a.title.toLowerCase().includes('it lifecycle');
    const bIsLifecycle = b.title.toLowerCase().includes('it lifecycle');

    if (aIsLifecycle) return -1;
    if (bIsLifecycle) return 1;
    return 0;
  });
---

<section
  id="divisions"
  class="services-grid-section relative py-8 sm:py-10 lg:py-12 bg-white overflow-hidden text-slate-900"
  aria-labelledby="services-section-heading"
>
  <Container size="wide" className="!max-w-[1360px] relative z-10">
    
    <header class="text-center w-full max-w-3xl mx-auto space-y-3 mb-6 sm:mb-8 select-none">
      <h2
        id="services-section-heading"
        class="text-3xl sm:text-4xl lg:text-[44px] font-semibold font-display text-slate-900 tracking-tight leading-[1.12] text-balance mx-auto"
      >
        {heading}
      </h2>
    </header>

    <div
      class="services-cards-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-6 lg:gap-7 items-stretch"
      id="services-interactive-grid"
    >
      {items.map((item, idx) => (
        <article
          class="service-card group relative flex flex-col rounded-[16px] bg-white border border-slate-200/90 hover:border-[#0B2545]/40 overflow-hidden shadow-xs hover:shadow-xl transition-all duration-500 ease-out h-[470px] select-none"
          data-service-index={idx}
          tabindex="0"
          aria-labelledby={`service-title-${idx}`}
          role="region"
        >
          <!-- UPPER PORTION: Image Area -->
          <div class="service-image-area relative w-full h-[340px] overflow-hidden rounded-t-[16px] shrink-0 bg-slate-100">
            
            <!-- Image -->
            <div class="relative w-full h-full overflow-hidden select-none">
              <img
                src={item.image}
                alt={item.imageAlt}
                class="service-img w-full h-full object-cover object-top select-none transition-transform duration-500 group-hover:scale-105"
                loading={idx === 0 ? 'eager' : 'lazy'}
                decoding="async"
                width="600"
                height="400"
                onerror={`this.onerror=null; this.src='/images/services/${idx + 1}.webp';`}
              />
            </div>

            <!-- ─── NEW: SVG GREEN WAVE OVERLAY ─── -->
            <!-- This hides the white wave and replaces it with the brand green -->
            <div class="absolute bottom-0 left-0 right-0 pointer-events-none w-full z-10">
              <svg 
                viewBox="0 0 500 60" 
                preserveAspectRatio="none" 
                class="w-full h-[50px] block"
              >
                <path 
                  d="M0,20 C150,-30 350,50 500,10 L500,100 L0,90 Z" 
                  fill="#0F623A"
                ></path>
              </svg>
            </div>
            <!-- ─────────────────────────────────── -->

            <!-- Ultra-Subtle Inner Rim Glow -->
            <div class="absolute inset-x-0 top-0 h-px bg-white/15 pointer-events-none z-20" aria-hidden="true"></div>
          </div>

          <!-- LOWER PORTION -->
          <div class="service-content-panel absolute bottom-0 inset-x-0 bg-white p-5 sm:p-6 rounded-b-[16px] border-t border-slate-100 flex flex-col justify-start transition-all duration-500 ease-out z-20">
            
            <div class="service-default-header min-h-[78px] flex flex-col justify-start space-y-2">
              <span class="service-accent-bar inline-block h-[2.5px] w-7 rounded-full bg-[#0B2545] transition-all duration-400 ease-out group-hover:w-12 group-hover:bg-[#133B6B]" aria-hidden="true"></span>

              <h3
                id={`service-title-${idx}`}
                class="service-title text-xl lg:text-[21px] font-semibold font-display text-slate-900 group-hover:text-[#0B2545] transition-colors duration-300 leading-snug tracking-tight"
              >
                <a href={item.link} class="service-title-link focus:outline-none focus:underline" tabindex="-1">
                  {item.title}
                </a>
              </h3>
            </div>

            <div class="service-collapsible-wrapper">
              <div class="service-collapsible-content pt-1 space-y-3.5">
                
                <p class="service-desc text-sm sm:text-[15px] text-black leading-relaxed font-normal line-clamp-3">
                  {item.description}
                </p>

                <div class="service-cta-row pt-1">
                  <a
                    href={item.link}
                    class="service-cta-link inline-flex items-center gap-2.5 text-xs sm:text-[13px] font-mono font-bold tracking-wider text-[#0B2545] uppercase hover:text-[#133B6B] transition-colors duration-200 group/cta focus:outline-none focus:ring-2 focus:ring-[#0B2545] focus:ring-offset-2 rounded-sm"
                  >
                    <span class="cta-label relative">
                      View Service
                      <span class="absolute -bottom-0.5 left-0 w-0 h-[1.5px] bg-[#0B2545] transition-all duration-300 ease-out group-hover/cta:w-full" aria-hidden="true"></span>
                    </span>
                    <svg class="cta-arrow w-4 h-4 text-[#0B2545] transition-transform duration-300 ease-out group-hover/cta:translate-x-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>

              </div>
            </div>

          </div>
        </article>
      ))}
    </div>

    {viewAllLink && (
      <div class="mt-6 sm:mt-8 text-center">
        <a
          href={viewAllLink}
          class="inline-flex items-center gap-2.5 px-6 py-3 rounded-[12px] bg-[#0B2545] hover:bg-[#133B6B] text-white text-xs sm:text-sm font-bold tracking-wide transition-all duration-300 shadow-sm hover:shadow-md focus:outline-none focus:ring-2 focus:ring-[#0B2545]"
        >
          <span>Explore Our Services →</span>
        </a>
      </div>
    )}

  </Container>
</section>

<style>
  .service-card {
    will-change: transform, box-shadow, border-color;
  }

  .service-content-panel {
    box-shadow: 0 -4px 20px rgba(0, 0, 0, 0.04);
  }

  .service-img {
    will-change: transform;
  }

  .service-collapsible-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    opacity: 0;
    transition:
      grid-template-rows 0.45s cubic-bezier(0.16, 1, 0.3, 1),
      opacity 0.4s ease;
  }

  .service-collapsible-content {
    overflow: hidden;
  }

  .service-desc {
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.35s ease 0.06s,
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.06s;
  }

  .service-cta-row {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.35s ease 0.12s,
      transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) 0.12s;
  }

  .service-card:hover .service-collapsible-wrapper,
  .service-card:focus-within .service-collapsible-wrapper,
  .service-card.is-active .service-collapsible-wrapper {
    grid-template-rows: 1fr;
    opacity: 1;
  }

  .service-card:hover .service-desc,
  .service-card:focus-within .service-desc,
  .service-card.is-active .service-desc {
    opacity: 1;
    transform: translateY(0);
  }

  .service-card:hover .service-cta-row,
  .service-card:focus-within .service-cta-row,
  .service-card.is-active .service-cta-row {
    opacity: 1;
    transform: translateY(0);
  }

  .service-card:focus-visible {
    outline: 2px solid #0B2545;
    outline-offset: 4px;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-img,
    .service-accent-bar,
    .service-collapsible-wrapper,
    .service-desc,
    .service-cta-row,
    .cta-arrow {
      transition: none !important;
      transform: none !important;
    }
    .service-collapsible-wrapper {
      opacity: 1 !important;
      grid-template-rows: 1fr !important;
    }
    .service-desc,
    .service-cta-row {
      opacity: 1 !important;
      transform: none !important;
    }
  }

  .service-card[data-service-index="1"] .service-title {
    white-space: nowrap;
    font-size: 20px;
    letter-spacing: -0.02em;
  }
</style>

<script is:inline>
  (() => {
    const initInteractiveServiceCards = () => {
      const container = document.getElementById('services-interactive-grid');
      if (!container) return;

      const cards = Array.from(container.querySelectorAll('.service-card'));
      if (!cards.length) return;

      cards.forEach((card) => {
        card.addEventListener('click', (e) => {
          if (e.target.closest('.service-cta-link')) return;

          const isTouch = window.matchMedia('(pointer: coarse)').matches || window.innerWidth < 1024;
          if (isTouch) {
            const isAlreadyActive = card.classList.contains('is-active');
            cards.forEach((c) => { if (c !== card) c.classList.remove('is-active'); });
            if (!isAlreadyActive) {
              card.classList.add('is-active');
            } else {
              const link = card.querySelector('.service-cta-link');
              if (link && link.href) window.location.href = link.href;
            }
          }
        });
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('.service-card')) {
          cards.forEach((c) => c.classList.remove('is-active'));
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initInteractiveServiceCards);
    } else {
      initInteractiveServiceCards();
    }

    document.addEventListener('astro:page-load', initInteractiveServiceCards);
  })();
</script>