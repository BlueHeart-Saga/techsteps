---
import Container from '../layout/Container.astro';
import SectionBackground from '../SectionBackground.astro';
import EcoJourneyBridge from '../content/EcoJourneyBridge.astro';
import { getHomePage } from '../../lib/sanity/client';

interface ServiceItem {
  id?: number | string;
  divisionNumber?: string;
  number?: string;
  title: string;
  description: string;
  image?: any;
  imageUrl?: string;
  imageAlt?: string;
  buttonText?: string;
  link?: string;
}

interface Props {
  services?: ServiceItem[];
  eyebrow?: string;
  heading?: string;
  description?: string;
  viewAllText?: string;
  viewAllLink?: string;
  showCollectionSection?: boolean;
}

const homePage = await getHomePage();

const {
  services: propServices,
  eyebrow = homePage?.services?.eyebrow || 'OUR SERVICES',
  heading: propHeading,
  description: propDescription,
  viewAllText = 'Explore Our Services →',
  viewAllLink = homePage?.services?.viewAllLink || '/services',
  showCollectionSection = true,
} = Astro.props;

const defaultHeading = 'Complete Solutions for Every Stage of Your Business';
const defaultDescription = 'From IT asset management and secure data destruction to information management and business relocation, TechSteps delivers integrated services that help organisations operate securely, efficiently and responsibly.';

const heading = (!propHeading || propHeading === 'Services For The Complete Business Lifecycle')
  ? (homePage?.services?.heading && homePage?.services?.heading !== 'Services For The Complete Business Lifecycle' ? homePage.services.heading : defaultHeading)
  : propHeading;

const description = propDescription || homePage?.services?.description || defaultDescription;



const fallbackImages = [
  '/images/services/1.webp',
  '/images/services/2.webp',
  '/images/services/3.webp',
  '/images/services/4.webp',
];

const formatServiceNumber = (numStr?: string, fallback = '01') => {
  if (!numStr) return fallback;
  const digits = numStr.replace(/[^0-9]/g, '');
  return digits ? digits.padStart(2, '0') : fallback;
};

const defaultServiceCards = (homePage?.services?.cards || []).map((card, idx) => {
  const cardImg = fallbackImages[idx % fallbackImages.length];

  return {
    id: idx,
    divisionNumber: card.divisionNumber || `DIVISION ${String(idx + 1).padStart(2, '0')}`,
    number: formatServiceNumber(card.divisionNumber, String(idx + 1).padStart(2, '0')),
    title: card.title || '',
    description: card.description || '',
    image: cardImg,
    imageAlt: card.imageAlt || card.title || '',
    link: card.link || '#',
    buttonText: card.buttonText || 'View Service',
  };
});

const services = (propServices && propServices.length > 0) ? propServices : defaultServiceCards;

const getInitialIllustration = (title: string, index: number): string => {
  const t = (title || '').toLowerCase();
  if (t.includes('it lifecycle') || t.includes('lifecycle')) {
    return '/images/services/hover/1.png';
  }
  if (t.includes('information') || t.includes('archive') || t.includes('storage') || t.includes('records') || t.includes('scanning')) {
    return '/images/services/hover/2.png';
  }
  if (t.includes('shred') || t.includes('integrity') || t.includes('confidential')) {
    return '/images/services/hover/3.png';
  }
  if (t.includes('relocation') || t.includes('moving') || t.includes('moves') || t.includes('warehouse')) {
    return '/images/services/hover/4.png';
  }

  const illustrations = [
    '/images/services/hover/1.png',
    '/images/services/hover/2.png',
    '/images/services/hover/3.png',
    '/images/services/hover/4.png',
  ];
  return illustrations[index % illustrations.length];
};

const getHarmonizedTitle = (title: string): string => {
  const t = (title || '').toLowerCase();
  if (t.includes('lifecycle')) return 'IT Lifecycle Solutions';
  if (t.includes('information') || t.includes('archive') || t.includes('records') || t.includes('storage')) return 'Information Management';
  if (t.includes('shred') || t.includes('destruction') || t.includes('integrity')) return 'Secure Data Destruction';
  if (t.includes('relocation') || t.includes('moving') || t.includes('moves')) return 'Specialist Relocations';
  return title;
};

const items = services
  .map((item, idx) => {
    let imgUrl =
      (typeof item.image === 'string' && item.image.length > 0)
        ? item.image
        : (item.image?.asset?.url || item.imageUrl || fallbackImages[idx % fallbackImages.length]);

    const cleanTitle = getHarmonizedTitle(item.title);

    return {
      id: item.id ?? idx,
      title: cleanTitle,
      description: item.description,
      image: imgUrl,
      imageAlt: item.imageAlt || `${cleanTitle} - TechSteps Service`,
      buttonText: item.buttonText || 'View Service',
      link: item.link || '#',
    };
  })
  .sort((a, b) => {
    const aIsLifecycle = a.title.toLowerCase().includes('it lifecycle');
    const bIsLifecycle = b.title.toLowerCase().includes('it lifecycle');

    if (aIsLifecycle) return -1;
    if (bIsLifecycle) return 1;
    return 0;
  })
  .map((item, idx) => ({
    ...item,
    initialImage: getInitialIllustration(item.title, idx),
  }));

---

<section
  id="divisions"
  class="services-grid-section relative py-12 sm:py-16 lg:py-20 overflow-hidden text-slate-900 isolate"
  style="background: linear-gradient(180deg, #ffffff 0%, #f3fbf7 50%, #ffffff 100%);"
  aria-labelledby="services-section-heading"
>
  <!-- Subtle ambient glow and mild floating bubbles (Hero style) -->
  <SectionBackground
    variant="hero"
    glow={true}
    glowPosition="both"
    showBubbles={true}
    bubbleCount={5}
  />

  <Container className="relative z-10">
    
    <header class="text-center w-full max-w-3xl mx-auto mb-10 sm:mb-12">
      <h2
        id="services-section-heading"
        class="text-3xl sm:text-4xl lg:text-[44px] font-bold font-display text-slate-900 tracking-tight leading-[1.14] mb-3 sm:mb-4"
      >
        {heading}
      </h2>
      
      {description && (
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal max-w-2xl mx-auto">
          {description}
        </p>
      )}
    </header>

    <div
      class="services-cards-grid grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-7 lg:gap-8 items-stretch"
      id="services-interactive-grid"
    >
      {items.map((item, idx) => (
        <article
          class="service-item group flex flex-col h-full"
          data-service-index={idx}
          tabindex="0"
          aria-labelledby={`service-title-${idx}`}
          role="region"
        >
          <!-- UPPER PORTION: Initial Illustration Image Only (No Box, No Borderlines) -->
          <a 
            href={item.link}
            class="service-image-area relative w-full h-[220px] sm:h-[240px] lg:h-[250px] cursor-pointer flex items-center justify-center block focus:outline-none focus-visible:ring-2 focus-visible:ring-[#0F623A] transition-transform duration-300 group-hover:-translate-y-1"
            aria-label={`View ${item.title}`}
          >
            <!-- Show Image Only (No box frame, no borderlines) -->
            <img
              src={item.initialImage}
              alt={item.imageAlt}
              class="service-initial-img w-full h-full object-contain object-center transition-transform duration-500 ease-out group-hover:scale-105 select-none"
              loading={idx === 0 ? 'eager' : 'lazy'}
              decoding="async"
              width="600"
              height="400"
              onerror={`this.onerror=null; this.src='/images/services/hover/${idx + 1}.png';`}
            />
          </a>

          <!-- LOWER PORTION: Details directly below image (Locked alignment across all cards) -->
          <div class="service-details-area pt-5 flex flex-col flex-grow">
            <!-- 1. Accent Bar & Title: Single line with locked height across all cards -->
            <div class="service-title-container min-h-[46px] sm:min-h-[50px] flex flex-col justify-start space-y-2">
              <span class="service-accent-bar inline-block h-[2.5px] w-7 rounded-full bg-[#0F623A] transition-all duration-300 ease-out group-hover:w-12 group-hover:bg-[#133B6B]" aria-hidden="true"></span>

              <h3
                id={`service-title-${idx}`}
                class="service-title text-[15px] sm:text-[16.5px] lg:text-[16px] xl:text-[17.5px] font-semibold font-display text-slate-900 group-hover:text-[#0B2545] transition-colors duration-200 leading-snug tracking-tight truncate whitespace-nowrap overflow-hidden text-ellipsis"
                title={item.title}
              >
                <a href={item.link} class="service-title-link focus:outline-none hover:underline block truncate">
                  {item.title}
                </a>
              </h3>
            </div>

            <!-- 2. Description: Locked height & line clamp for matching space across all cards 
            <div class="service-desc-container min-h-[72px] sm:min-h-[78px] mt-2.5">
              <p class="service-desc text-sm sm:text-[14.5px] text-slate-600 leading-relaxed font-normal line-clamp-3">
                {item.description}
              </p>
            </div>
            -->

            <!-- 3. Bottom CTA Link: Locked to the exact same bottom position across all cards -->
            <div class="service-cta-container mt-auto pt-4">
              <a
                href={item.link}
                class="service-cta-link inline-flex items-center gap-2 text-xs sm:text-[13px] font-mono font-bold tracking-wider text-[#0B2545] uppercase hover:text-[#0F623A] transition-colors duration-200 group/cta focus:outline-none"
              >
                <span class="cta-label relative">
                  View Service
                  <span class="absolute -bottom-0.5 left-0 w-0 h-[1.5px] bg-[#0F623A] transition-all duration-300 ease-out group-hover/cta:w-full" aria-hidden="true"></span>
                </span>
                <svg class="cta-arrow w-4 h-4 text-[#0B2545] group-hover/cta:text-[#0F623A] transition-transform duration-300 ease-out group-hover/cta:translate-x-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- Continuous Eco Journey Bridge: Cards -> Collection Showcase (Right Gutter) -->
    <EcoJourneyBridge side="right" type="leaflet" rotation={15} offsetY="-top-6" delay="-3s" />

    <!-- =========================================================
         FREE IT EQUIPMENT COLLECTION HEADING & BANNER SHOWCASE
         ========================================================= -->
    {showCollectionSection && (
      <div class="mt-12 sm:mt-16 text-center">
        <!-- Heading & Description -->
        <div class="max-w-3xl mx-auto space-y-3 px-4 mb-5 sm:mb-6">
          <h3 class="text-2xl sm:text-3xl lg:text-[36px] font-bold font-display text-[#0B2545] tracking-tight leading-tight">
            Free IT Equipment Collection for UK Businesses
          </h3>
          <p class="text-slate-600 text-sm sm:text-base lg:text-[16.5px] leading-relaxed max-w-2xl mx-auto font-normal">
            From laptops and computers to servers and office electronics, TechSteps makes IT equipment disposal simple, secure and sustainable. Explore our collection services and give your unwanted technology a responsible next step.
          </p>
        </div>

        <!-- Banner Image: Clean with soft subtle ambient glow behind illustration -->
        <div class="relative w-full max-w-5xl mx-auto px-2 py-2">
          <!-- Soft ambient glow behind collection illustration -->
          <div class="absolute inset-0 -inset-x-2 sm:-inset-x-6 rounded-3xl bg-gradient-to-r from-[#DDF5EB]/40 via-[#E5F7F1]/60 to-[#DDF5EB]/40 -z-10 blur-xl pointer-events-none" aria-hidden="true"></div>
          <img
            src="/images/services/banner-3.png"
            alt="TechSteps nationwide IT equipment collection and certified recycling process"
            class="relative z-10 w-full h-auto object-contain mx-auto block max-h-[440px] select-none"
            loading="lazy"
            decoding="async"
          />
        </div>

        <!-- Feel-Good Quote: Right below image with minimal gap -->
        <div class="max-w-3xl mx-auto mt-3 sm:mt-4 px-4">
          <p class="text-base sm:text-lg lg:text-xl font-display font-medium italic text-slate-800 leading-snug tracking-tight">
            &ldquo;Giving redundant technology a purposeful next chapter &mdash; certified data security, 100% circular commitment, and effortless nationwide collection for UK businesses.&rdquo;
          </p>
        </div>
      </div>
    )}

  </Container>
</section>

<style>
  .service-item {
    will-change: transform;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-item,
    .service-accent-bar,
    .service-initial-img {
      transition: none !important;
      transform: none !important;
      animation: none !important;
    }
  }
</style>