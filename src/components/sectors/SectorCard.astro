---
import type { Sector } from '../../lib/sanity/types';

interface Props {
  sector: Sector;
}

const { sector } = Astro.props;
---

<div class="group flex flex-col bg-white rounded-2xl border border-slate-200 shadow-xs hover:shadow-xl hover:border-brand-accent/50 transition-all duration-300 overflow-hidden transform hover:-translate-y-1">
  <!-- Accent Card Header -->
  <div class="h-44 relative bg-gradient-to-br from-brand-navy via-slate-900 to-brand-blue p-6 flex flex-col justify-between overflow-hidden">
    <div class="absolute inset-0 bg-[radial-gradient(#008170_1px,transparent_1px)] [background-size:16px_16px] opacity-20 group-hover:opacity-30 transition-opacity"></div>

    <div class="relative z-10 flex items-center justify-between">
      <span class="px-2.5 py-1 rounded-md bg-white/10 backdrop-blur-md text-emerald-300 text-[11px] font-bold border border-white/15">
        Sector Compliance
      </span>
      <span class="h-2 w-2 rounded-full bg-emerald-400"></span>
    </div>

    <div class="relative z-10">
      <h3 class="text-2xl font-black text-white group-hover:text-emerald-300 transition-colors">
        {sector.title}
      </h3>
    </div>
  </div>

  <!-- Card Body -->
  <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
    <div class="space-y-3">
      <p class="text-xs font-bold text-brand-accent uppercase tracking-wider">
        {sector.tagline}
      </p>
      <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">
        {sector.summary}
      </p>
    </div>

    <!-- Compliance Badges -->
    <div class="pt-2 flex flex-wrap gap-1.5">
      {sector.complianceStandards.slice(0, 3).map((std) => (
        <span class="px-2 py-0.5 rounded bg-brand-slate text-slate-700 text-[11px] font-semibold border border-slate-200">
          {std}
        </span>
      ))}
    </div>

    <!-- CTA -->
    <div class="pt-2 border-t border-slate-100">
      <a
        href={`/sectors/${sector.slug}`}
        class="inline-flex items-center gap-2 text-sm font-bold text-brand-navy group-hover:text-brand-accent transition-colors"
      >
        <span>Explore {sector.title} Solutions</span>
        <svg class="h-4 w-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
    </div>
  </div>
</div>
