---
import type { Sector } from '../../lib/sanity/types';

interface Props {
  sectors?: Sector[];
}

const { sectors = [] } = Astro.props;

interface SectorItem {
  id: string;
  number: string;
  title: string;
  slug: string;
  category: string;
  image: string;
  icon: string;
  description: string;
}

const defaultSectorItems: SectorItem[] = [
  {
    id: 'sec-nhs',
    number: '01',
    title: 'NHS & Healthcare',
    slug: 'nhs',
    category: 'Healthcare & Trusts',
    image: '/images/sectors/nhs.jpg',
    icon: '/icons/NHS & Healthcare.svg',
    description: 'Caldicott-compliant patient records vaulting, BS 10008 legal scanning, emergency 1-hour recall, and hospital ward IT decommissioning.',
  },
  {
    id: 'sec-finance',
    number: '02',
    title: 'Financial Services',
    slug: 'finance',
    category: 'Banking & Finance',
    image: '/images/sectors/finance.jpg',
    icon: '/icons/Financial Services.svg',
    description: 'FCA & PRA aligned governance, trading floor relocations, PCI-DSS compliance, and ADISA-certified sanitisation.',
  },
  {
    id: 'sec-defence',
    number: '03',
    title: 'Defence & Aerospace',
    slug: 'defence',
    category: 'Defence & Security',
    image: '/images/sectors/defence.jpg',
    icon: '/icons/Defence & Aerospace.svg',
    description: 'JSP 440 security-cleared personnel, on-site mobile DIN 66399 shredding, SC/DV vetted logistics, and classified plant disposal.',
  },
  {
    id: 'sec-government',
    number: '04',
    title: 'Central Government & Public Sector',
    slug: 'central-government',
    category: 'Public Sector',
    image: '/images/sectors/government.jpg',
    icon: '/icons/Central Government.svg',
    description: 'Crown Commercial Service frameworks, Greening Government Commitments (GGC), zero landfill ITAD, and public records governance.',
  },
  {
    id: 'sec-legal',
    number: '05',
    title: 'Legal & Professional Services',
    slug: 'legal-professional-services',
    category: 'Legal & Corporate',
    image: '/images/sectors/legal.jpg',
    icon: '/icons/Corporate & Legal.svg',
    description: 'SRA-aligned confidentiality, litigation bundle digitization, deep vault storage, and on-site hardware sanitisation.',
  },
  {
    id: 'sec-education',
    number: '06',
    title: 'Education & Universities',
    slug: 'education-universities',
    category: 'Higher Education',
    image: '/images/sectors/education.jpg',
    icon: '/icons/Education & Universities.svg',
    description: 'Secure campus IT retirement, academic research archive digitization, and climate-monitored lab instrument relocations.',
  },
  {
    id: 'sec-manufacturing',
    number: '07',
    title: 'Manufacturing & Engineering',
    slug: 'manufacturing-engineering',
    category: 'Advanced Industry',
    image: '/images/sectors/manufacturing.jpg',
    icon: '/icons/Manufacturing & Engineering.svg',
    description: 'CAD/CAM blueprint protection, industrial control ITAD, prototype destruction, and clean production lab relocations.',
  },
  {
    id: 'sec-technology',
    number: '08',
    title: 'IT & Technology',
    slug: 'it-technology',
    category: 'Technology & Cloud',
    image: '/images/sectors/technology.jpg',
    icon: '/icons/IT & Technology.svg',
    description: 'Hyperscale data centre de-racking, NIST 800-88 certified mass erasure, zero landfill asset lifecycle, and server remarketing.',
  },
];

const sectorItems: SectorItem[] = (sectors && sectors.length > 0)
  ? defaultSectorItems.map((defaultItem) => {
      const match = sectors.find(
        (s) => s.slug === defaultItem.slug ||
               (s.slug === 'legal-professional-sector' && defaultItem.slug === 'legal-professional-services') ||
               (s.slug === 'education' && defaultItem.slug === 'education-universities') ||
               (s.slug === 'manufacturing' && defaultItem.slug === 'manufacturing-engineering') ||
               (s.slug === 'technology' && defaultItem.slug === 'it-technology')
      );
      if (!match) return defaultItem;
      return {
        ...defaultItem,
        title: match.title || defaultItem.title,
        slug: defaultItem.slug,
        description: match.summary || match.tagline || defaultItem.description,
        image: match.heroImage || defaultItem.image,
      };
    })
  : defaultSectorItems;
---

<div
  id="sector-carousel-root"
  class="relative w-full max-w-[1440px] mx-auto py-4 select-none"
  data-total={sectorItems.length}
  aria-roledescription="carousel"
  aria-label="Sectors We Serve Carousel"
>
  <!-- Carousel Stage Wrapper -->
  <div class="relative w-full flex items-center justify-center overflow-hidden py-6 sm:py-8">
    
    <!-- Left Navigation Arrow -->
    <button
      type="button"
      id="sector-carousel-prev"
      class="sector-carousel-nav-btn absolute left-2 sm:left-4 lg:left-6 xl:left-8 top-1/2 -translate-y-1/2 z-40 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/95 backdrop-blur-md border border-slate-200/90 shadow-[0_4px_16px_rgba(0,0,0,0.08)] text-[#0F623A] flex items-center justify-center transition-all duration-300 hover:scale-110 hover:border-[#3FB33D] hover:bg-[#0F623A] hover:text-white focus:outline-none focus:ring-2 focus:ring-[#0F623A] cursor-pointer group"
      aria-label="Previous Sector"
    >
      <svg class="w-5 h-5 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
      </svg>
    </button>

    <!-- Right Navigation Arrow -->
    <button
      type="button"
      id="sector-carousel-next"
      class="sector-carousel-nav-btn absolute right-2 sm:right-4 lg:right-6 xl:right-8 top-1/2 -translate-y-1/2 z-40 w-11 h-11 sm:w-12 sm:h-12 rounded-full bg-white/95 backdrop-blur-md border border-slate-200/90 shadow-[0_4px_16px_rgba(0,0,0,0.08)] text-[#0F623A] flex items-center justify-center transition-all duration-300 hover:scale-110 hover:border-[#3FB33D] hover:bg-[#0F623A] hover:text-white focus:outline-none focus:ring-2 focus:ring-[#0F623A] cursor-pointer group"
      aria-label="Next Sector"
    >
      <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
      </svg>
    </button>

    <!-- Carousel 3D Cards Stage -->
    <div
      id="sector-carousel-stage"
      class="sector-carousel-stage carousel-entering relative w-full h-[520px] sm:h-[550px] lg:h-[580px] xl:h-[600px] flex items-center justify-center"
    >
      {sectorItems.map((item, idx) => (
        <article
          key={item.id}
          class="sector-carousel-card group"
          data-index={idx}
          data-slug={item.slug}
          data-pos={idx === 0 ? "0" : idx === 1 ? "1" : idx === sectorItems.length - 1 ? "-1" : idx === 2 ? "2" : idx === sectorItems.length - 2 ? "-2" : "hidden-right"}
          role="group"
          aria-roledescription="slide"
          aria-label={`${item.title} (${idx + 1} of ${sectorItems.length})`}
        >
          <div class="sector-card-inner relative w-full h-full bg-white rounded-[26px] p-5 sm:p-6 flex flex-col justify-between border border-slate-200/90 overflow-hidden">
            <!-- Ambient Top Subtle Tint -->
            <div class="absolute top-0 inset-x-0 h-2 bg-gradient-to-r from-transparent via-[#0F623A]/20 to-transparent pointer-events-none opacity-0 group-data-[pos='0']:opacity-100 transition-opacity duration-500"></div>

            <!-- Top Row: Index Badge & Category + Icon -->
            <div class="flex items-center justify-between gap-2 mb-3.5 shrink-0">
              <div class="flex items-center gap-2 min-w-0">
                <span class="inline-flex items-center justify-center font-mono text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-[#0F623A]/10 text-[#0F623A] border border-[#0F623A]/15 shrink-0">
                  {item.number}
                </span>
                <span class="text-[11px] font-semibold uppercase tracking-wider text-slate-500 truncate">
                  {item.category}
                </span>
              </div>
              <div class="w-7 h-7 rounded-full bg-[#F4F7F4] flex items-center justify-center p-1.5 shrink-0 border border-slate-200/60">
                <img src={item.icon} alt="" class="w-full h-full object-contain opacity-75" loading="lazy" />
              </div>
            </div>

            <!-- Image Container -->
            <div class="sector-card-image-box relative w-full aspect-[16/10] sm:aspect-[16/11] rounded-2xl overflow-hidden mb-3.5 bg-slate-100 shrink-0">
              <img
                src={item.image}
                alt={item.title}
                class="sector-card-img w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <!-- Subtle photo bottom gradient overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
            </div>

            <!-- Text Content -->
            <div class="flex-1 flex flex-col justify-between min-h-0">
              <div>
                <h3 class="sector-card-title text-xl sm:text-[22px] font-bold font-display text-slate-900 tracking-tight leading-snug group-hover:text-[#0F623A] transition-colors line-clamp-1 mb-2">
                  <a
                    href={`/sectors/${item.slug}`}
                    class="sector-card-link focus:outline-none"
                    tabindex="-1"
                  >
                    {item.title}
                  </a>
                </h3>
                <p class="sector-card-desc text-xs sm:text-[13px] text-slate-600 font-normal leading-relaxed line-clamp-3">
                  {item.description}
                </p>
              </div>

              <!-- Bottom Action CTA -->
              <div class="sector-card-action mt-3.5 pt-3 border-t border-slate-100 flex items-center justify-between shrink-0">
                <span class="sector-card-cta-label text-xs font-bold text-[#0F623A] tracking-wider uppercase inline-flex items-center gap-1.5 transition-colors">
                  <span>Explore Sector</span>
                </span>

                <a
                  href={`/sectors/${item.slug}`}
                  class="sector-card-arrow-btn w-9 h-9 rounded-full bg-[#0F623A] text-white flex items-center justify-center shadow-sm group-hover:bg-[#3FB33D] group-hover:scale-105 transition-all duration-300 focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
                  aria-label={`Explore ${item.title}`}
                  tabindex="-1"
                >
                  <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <!-- Pagination Indicators -->
  <div
    class="sector-carousel-dots flex items-center justify-center gap-2 mt-4 sm:mt-6"
    role="tablist"
    aria-label="Sectors carousel navigation"
  >
    {sectorItems.map((item, idx) => (
      <button
        type="button"
        class="sector-dot-btn h-2.5 rounded-full transition-all duration-300 ease-out cursor-pointer focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
        data-dot-index={idx}
        role="tab"
        aria-selected={idx === 0 ? "true" : "false"}
        aria-label={`Go to ${item.title}`}
        style={idx === 0 ? "width: 2rem; background-color: #0F623A;" : "width: 0.625rem; background-color: #CBD5E1;"}
      >
        <span class="sr-only">{item.title}</span>
      </button>
    ))}
  </div>
</div>

<style>
  /* Stage Setup */
  .sector-carousel-stage {
    position: relative;
    width: 100%;
    transform-style: preserve-3d;
    perspective: 1200px;
  }

  /* Base Card Styles */
  .sector-carousel-card {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 82vw;
    max-width: 320px;
    height: 470px;
    will-change: transform, opacity;
    transition: transform 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                opacity 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                filter 0.65s cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: center center;
    cursor: pointer;
  }

  @media (min-width: 640px) {
    .sector-carousel-card {
      max-width: 340px;
      height: 490px;
    }
  }

  @media (min-width: 1024px) {
    .sector-carousel-card {
      max-width: 350px;
      height: 510px;
    }
  }

  @media (min-width: 1280px) {
    .sector-carousel-card {
      max-width: 370px;
      height: 520px;
    }
  }

  /* Card Inner Shadows & Borders */
  .sector-card-inner {
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.05), 0 4px 10px -2px rgba(0, 0, 0, 0.02);
    transition: box-shadow 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.65s cubic-bezier(0.22, 1, 0.36, 1),
                transform 0.65s cubic-bezier(0.22, 1, 0.36, 1);
  }

  /* Entrance Animation: Cards start lower, scaled down and transparent */
  .sector-carousel-stage.carousel-entering .sector-carousel-card {
    opacity: 0 !important;
    transform: translate3d(-50%, calc(-50% + 45px), 0) scale(0.72) !important;
  }

  /* ========================================================
     3D CAROUSEL POSITIONS (DESKTOP >= 1280px)
     ======================================================== */
  @media (min-width: 1280px) {
    /* Center Active (0) */
    .sector-carousel-card[data-pos="0"] {
      transform: translate3d(-50%, -53%, 0) scale(1.06);
      z-index: 30;
      opacity: 1;
      cursor: default;
    }
    .sector-carousel-card[data-pos="0"] .sector-card-inner {
      border-color: rgba(15, 98, 58, 0.28);
      box-shadow: 0 25px 60px -15px rgba(15, 98, 58, 0.22), 0 8px 24px -4px rgba(0, 0, 0, 0.06);
    }

    /* Immediate Right (1) */
    .sector-carousel-card[data-pos="1"] {
      transform: translate3d(calc(-50% + 290px), -48%, 0) scale(0.9);
      z-index: 20;
      opacity: 0.85;
    }
    .sector-carousel-card[data-pos="1"]:hover {
      opacity: 0.98;
      transform: translate3d(calc(-50% + 290px), -50%, 0) scale(0.92);
    }

    /* Immediate Left (-1) */
    .sector-carousel-card[data-pos="-1"] {
      transform: translate3d(calc(-50% - 290px), -48%, 0) scale(0.9);
      z-index: 20;
      opacity: 0.85;
    }
    .sector-carousel-card[data-pos="-1"]:hover {
      opacity: 0.98;
      transform: translate3d(calc(-50% - 290px), -50%, 0) scale(0.92);
    }

    /* Far Right (2) */
    .sector-carousel-card[data-pos="2"] {
      transform: translate3d(calc(-50% + 530px), -46%, 0) scale(0.78);
      z-index: 10;
      opacity: 0.52;
    }
    .sector-carousel-card[data-pos="2"]:hover {
      opacity: 0.82;
      transform: translate3d(calc(-50% + 530px), -48%, 0) scale(0.81);
    }

    /* Far Left (-2) */
    .sector-carousel-card[data-pos="-2"] {
      transform: translate3d(calc(-50% - 530px), -46%, 0) scale(0.78);
      z-index: 10;
      opacity: 0.52;
    }
    .sector-carousel-card[data-pos="-2"]:hover {
      opacity: 0.82;
      transform: translate3d(calc(-50% - 530px), -48%, 0) scale(0.81);
    }

    /* Hidden Cards */
    .sector-carousel-card[data-pos="hidden-right"] {
      transform: translate3d(calc(-50% + 720px), -45%, 0) scale(0.65);
      z-index: 1;
      opacity: 0;
      pointer-events: none;
    }
    .sector-carousel-card[data-pos="hidden-left"] {
      transform: translate3d(calc(-50% - 720px), -45%, 0) scale(0.65);
      z-index: 1;
      opacity: 0;
      pointer-events: none;
    }
  }

  /* ========================================================
     3D CAROUSEL POSITIONS (LARGE DESKTOP 1024px - 1279px)
     ======================================================== */
  @media (min-width: 1024px) and (max-width: 1279px) {
    .sector-carousel-card[data-pos="0"] {
      transform: translate3d(-50%, -53%, 0) scale(1.05);
      z-index: 30;
      opacity: 1;
      cursor: default;
    }
    .sector-carousel-card[data-pos="0"] .sector-card-inner {
      border-color: rgba(15, 98, 58, 0.28);
      box-shadow: 0 25px 60px -15px rgba(15, 98, 58, 0.22), 0 8px 24px -4px rgba(0, 0, 0, 0.06);
    }

    .sector-carousel-card[data-pos="1"] {
      transform: translate3d(calc(-50% + 250px), -48%, 0) scale(0.88);
      z-index: 20;
      opacity: 0.85;
    }
    .sector-carousel-card[data-pos="1"]:hover {
      opacity: 0.98;
      transform: translate3d(calc(-50% + 250px), -50%, 0) scale(0.91);
    }

    .sector-carousel-card[data-pos="-1"] {
      transform: translate3d(calc(-50% - 250px), -48%, 0) scale(0.88);
      z-index: 20;
      opacity: 0.85;
    }
    .sector-carousel-card[data-pos="-1"]:hover {
      opacity: 0.98;
      transform: translate3d(calc(-50% - 250px), -50%, 0) scale(0.91);
    }

    .sector-carousel-card[data-pos="2"] {
      transform: translate3d(calc(-50% + 460px), -46%, 0) scale(0.76);
      z-index: 10;
      opacity: 0.52;
    }
    .sector-carousel-card[data-pos="2"]:hover {
      opacity: 0.82;
      transform: translate3d(calc(-50% + 460px), -48%, 0) scale(0.79);
    }

    .sector-carousel-card[data-pos="-2"] {
      transform: translate3d(calc(-50% - 460px), -46%, 0) scale(0.76);
      z-index: 10;
      opacity: 0.52;
    }
    .sector-carousel-card[data-pos="-2"]:hover {
      opacity: 0.82;
      transform: translate3d(calc(-50% - 460px), -48%, 0) scale(0.79);
    }

    .sector-carousel-card[data-pos="hidden-right"] {
      transform: translate3d(calc(-50% + 640px), -45%, 0) scale(0.65);
      z-index: 1;
      opacity: 0;
      pointer-events: none;
    }
    .sector-carousel-card[data-pos="hidden-left"] {
      transform: translate3d(calc(-50% - 640px), -45%, 0) scale(0.65);
      z-index: 1;
      opacity: 0;
      pointer-events: none;
    }
  }

  /* ========================================================
     3D CAROUSEL POSITIONS (TABLET 768px - 1023px)
     ======================================================== */
  @media (min-width: 768px) and (max-width: 1023px) {
    .sector-carousel-card[data-pos="0"] {
      transform: translate3d(-50%, -52%, 0) scale(1.04);
      z-index: 30;
      opacity: 1;
      cursor: default;
    }
    .sector-carousel-card[data-pos="0"] .sector-card-inner {
      border-color: rgba(15, 98, 58, 0.28);
      box-shadow: 0 25px 60px -15px rgba(15, 98, 58, 0.22), 0 8px 24px -4px rgba(0, 0, 0, 0.06);
    }

    .sector-carousel-card[data-pos="1"] {
      transform: translate3d(calc(-50% + 230px), -48%, 0) scale(0.86);
      z-index: 20;
      opacity: 0.78;
    }
    .sector-carousel-card[data-pos="1"]:hover {
      opacity: 0.95;
      transform: translate3d(calc(-50% + 230px), -50%, 0) scale(0.89);
    }

    .sector-carousel-card[data-pos="-1"] {
      transform: translate3d(calc(-50% - 230px), -48%, 0) scale(0.86);
      z-index: 20;
      opacity: 0.78;
    }
    .sector-carousel-card[data-pos="-1"]:hover {
      opacity: 0.95;
      transform: translate3d(calc(-50% - 230px), -50%, 0) scale(0.89);
    }

    .sector-carousel-card[data-pos="2"],
    .sector-carousel-card[data-pos="-2"],
    .sector-carousel-card[data-pos="hidden-right"],
    .sector-carousel-card[data-pos="hidden-left"] {
      transform: translate3d(-50%, -46%, 0) scale(0.65);
      z-index: 1;
      opacity: 0;
      pointer-events: none;
    }
  }

  /* ========================================================
     3D CAROUSEL POSITIONS (MOBILE < 768px)
     ======================================================== */
  @media (max-width: 767px) {
    .sector-carousel-card[data-pos="0"] {
      transform: translate3d(-50%, -50%, 0) scale(1);
      z-index: 30;
      opacity: 1;
      cursor: default;
    }
    .sector-carousel-card[data-pos="0"] .sector-card-inner {
      border-color: rgba(15, 98, 58, 0.25);
      box-shadow: 0 20px 45px -10px rgba(15, 98, 58, 0.2), 0 4px 16px -2px rgba(0, 0, 0, 0.05);
    }

    .sector-carousel-card[data-pos="1"] {
      transform: translate3d(calc(-50% + 82vw), -50%, 0) scale(0.88);
      z-index: 15;
      opacity: 0.45;
    }

    .sector-carousel-card[data-pos="-1"] {
      transform: translate3d(calc(-50% - 82vw), -50%, 0) scale(0.88);
      z-index: 15;
      opacity: 0.45;
    }

    .sector-carousel-card[data-pos="2"],
    .sector-carousel-card[data-pos="-2"],
    .sector-carousel-card[data-pos="hidden-right"],
    .sector-carousel-card[data-pos="hidden-left"] {
      transform: translate3d(-50%, -50%, 0) scale(0.65);
      z-index: 1;
      opacity: 0;
      pointer-events: none;
    }
  }

  /* Reduced Motion Support */
  @media (prefers-reduced-motion: reduce) {
    .sector-carousel-card {
      transition: opacity 0.2s ease !important;
    }
    .sector-carousel-stage.carousel-entering .sector-carousel-card {
      opacity: 1 !important;
      transform: none !important;
    }
    .sector-dot-btn {
      transition: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const initSectorCarousel = () => {
      const root = document.getElementById('sector-carousel-root');
      if (!root) return;

      // Prevent duplicate attachment across view transitions
      if (root.dataset.carouselInitialized === 'true') return;
      root.dataset.carouselInitialized = 'true';

      const stage = root.querySelector('#sector-carousel-stage');
      const cards = Array.from(root.querySelectorAll('.sector-carousel-card'));
      const dots = Array.from(root.querySelectorAll('.sector-dot-btn'));
      const prevBtn = document.getElementById('sector-carousel-prev');
      const nextBtn = document.getElementById('sector-carousel-next');

      const total = cards.length;
      if (!total || !stage) return;

      let currentIndex = 0;
      let timer = null;
      const AUTOPLAY_INTERVAL = 5000;
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Update positions of all cards relative to active index
      const updatePositions = (newIndex) => {
        currentIndex = (newIndex + total) % total;

        cards.forEach((card, idx) => {
          let diff = (idx - currentIndex) % total;
          if (diff > total / 2) diff -= total;
          if (diff < -total / 2) diff += total;

          let posAttr = 'hidden-right';
          if (diff === 0) {
            posAttr = '0';
          } else if (diff === 1) {
            posAttr = '1';
          } else if (diff === -1) {
            posAttr = '-1';
          } else if (diff === 2) {
            posAttr = '2';
          } else if (diff === -2) {
            posAttr = '-2';
          } else if (diff > 2) {
            posAttr = 'hidden-right';
          } else if (diff < -2) {
            posAttr = 'hidden-left';
          }

          card.setAttribute('data-pos', posAttr);

          // Update tab indices and links accessibility
          const isFeatured = (posAttr === '0');
          const links = card.querySelectorAll('a, button');
          links.forEach((el) => {
            if (isFeatured) {
              el.setAttribute('tabindex', '0');
            } else {
              el.setAttribute('tabindex', '-1');
            }
          });
        });

        // Update pagination indicators
        dots.forEach((dot, idx) => {
          const isActive = (idx === currentIndex);
          dot.setAttribute('aria-selected', isActive ? 'true' : 'false');
          if (isActive) {
            dot.style.width = '2rem';
            dot.style.backgroundColor = '#0F623A';
          } else {
            dot.style.width = '0.625rem';
            dot.style.backgroundColor = '#CBD5E1';
          }
        });
      };

      // Autoplay controls
      const startTimer = () => {
        if (prefersReducedMotion) return;
        stopTimer();
        timer = setInterval(() => {
          updatePositions(currentIndex + 1);
        }, AUTOPLAY_INTERVAL);
      };

      const stopTimer = () => {
        if (timer) {
          clearInterval(timer);
          timer = null;
        }
      };

      // Navigation Actions
      const goToPrev = () => {
        updatePositions(currentIndex - 1);
        startTimer();
      };

      const goToNext = () => {
        updatePositions(currentIndex + 1);
        startTimer();
      };

      if (prevBtn) {
        prevBtn.addEventListener('click', (e) => {
          e.preventDefault();
          goToPrev();
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', (e) => {
          e.preventDefault();
          goToNext();
        });
      }

      // Dot click navigation
      dots.forEach((dot, idx) => {
        dot.addEventListener('click', (e) => {
          e.preventDefault();
          updatePositions(idx);
          startTimer();
        });
      });

      // Card Click Handler: Clicking side card smoothly brings it to center.
      // Clicking center card or its link/button allows navigation to sector details page.
      cards.forEach((card, idx) => {
        card.addEventListener('click', (e) => {
          const pos = card.getAttribute('data-pos');
          if (pos !== '0') {
            e.preventDefault();
            e.stopPropagation();
            updatePositions(idx);
            startTimer();
          } else {
            // Center card clicked: if clicked on an element other than direct link, navigate to sector page
            const target = e.target;
            if (!target.closest('a')) {
              const slug = card.getAttribute('data-slug');
              if (slug) {
                window.location.href = `/sectors/${slug}`;
              }
            }
          }
        });
      });

      // Pause autoplay on mouse enter, resume on mouse leave
      root.addEventListener('mouseenter', stopTimer);
      root.addEventListener('mouseleave', startTimer);

      // Mobile Touch / Swipe Handling
      let touchStartX = 0;
      let touchStartY = 0;
      let isTouching = false;

      stage.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
        touchStartY = e.changedTouches[0].screenY;
        isTouching = true;
        stopTimer();
      }, { passive: true });

      stage.addEventListener('touchend', (e) => {
        if (!isTouching) return;
        isTouching = false;
        const touchEndX = e.changedTouches[0].screenX;
        const touchEndY = e.changedTouches[0].screenY;
        const deltaX = touchEndX - touchStartX;
        const deltaY = touchEndY - touchStartY;

        // Ensure clear horizontal intent (threshold 40px)
        if (Math.abs(deltaX) > 40 && Math.abs(deltaX) > Math.abs(deltaY) * 1.2) {
          if (deltaX < 0) {
            goToNext();
          } else {
            goToPrev();
          }
        }
        startTimer();
      }, { passive: true });

      // Pause timer when document is hidden / tab switched
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stopTimer();
        } else {
          startTimer();
        }
      });

      // ========================================================
      // ENTRANCE ANIMATION VIA INTERSECTION OBSERVER
      // ========================================================
      const entranceObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              // Apply staggered entrance delays
              cards.forEach((card) => {
                const pos = card.getAttribute('data-pos');
                let delay = '0ms';
                if (pos === '0') delay = '60ms';
                else if (pos === '1' || pos === '-1') delay = '180ms';
                else if (pos === '2' || pos === '-2') delay = '300ms';
                card.style.transitionDelay = delay;
              });

              // Trigger entrance
              stage.classList.remove('carousel-entering');

              // Clear transition delays after entrance completes so slide navigation has no delay
              setTimeout(() => {
                cards.forEach((card) => {
                  card.style.transitionDelay = '';
                });
                startTimer();
              }, 950);

              entranceObserver.disconnect();
            }
          });
        },
        { threshold: 0.15 }
      );

      entranceObserver.observe(root);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initSectorCarousel);
    } else {
      initSectorCarousel();
    }
    document.addEventListener('astro:page-load', initSectorCarousel);
  })();
</script>
