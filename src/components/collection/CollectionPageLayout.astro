---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import HeroHeader from '../../components/global/HeroHeader.astro';
import CTA from '../../components/global/cta.astro';
import type { CollectionServiceData } from '../../data/collectionServices';
import { collectionServices } from '../../data/collectionServices';
import FAQSection from '../FAQSection.astro';
import { getPageFaqs } from '../../data/pageFaqs';

interface Props {
  data: CollectionServiceData;
}

const { data } = Astro.props;

const canonicalUrl = `https://techsteps.co.uk${data.route}`;

// Breadcrumb Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://techsteps.co.uk/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Services',
      item: 'https://techsteps.co.uk/services',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'IT Equipment Collection',
      item: 'https://techsteps.co.uk/services/collection',
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: data.title,
      item: canonicalUrl,
    },
  ],
};

// Service Schema
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: data.title,
  serviceType: 'IT Equipment Collection & Asset Recovery',
  provider: {
    '@type': 'Organization',
    name: 'TechSteps UK',
    url: 'https://techsteps.co.uk',
    telephone: '+44 1784 640216',
    email: 'collection@techsteps.co.uk',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United Kingdom',
  },
  description: data.metaDescription,
  url: canonicalUrl,
};

// FAQ Data & Schema
const faqConfig = getPageFaqs(data.slug);
const faqs = faqConfig?.faqs || data.faqs;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};

const relatedServices = data.relatedSlugs
  .map((slug) => collectionServices[slug])
  .filter(Boolean);
---

<BaseLayout
  title={data.metaTitle}
  description={data.metaDescription}
  canonicalUrl={canonicalUrl}
  jsonLd={[breadcrumbSchema, serviceSchema, faqSchema]}
  hasHeroHeader={true}
>
  <!-- Sticky Header -->
  <HeroHeader isHome={false} />

  <!-- =====================================================
       1. HERO SECTION WITH EQUIPMENT-SPECIFIC IMAGE
       ===================================================== -->
  <section class="relative bg-white pt-6 sm:pt-8 lg:pt-10 pb-12 sm:pb-16 lg:pb-20 border-b border-slate-200/80 overflow-hidden">
    <Container size="normal">
      
      <!-- BREADCRUMB NAVIGATION -->
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-medium text-slate-500 mb-6 sm:mb-8">
        <a href="/" class="text-slate-600 hover:text-[#07572F] transition-colors">Home</a>
        <span class="text-slate-400" aria-hidden="true">&rsaquo;</span>
        <a href="/services" class="text-slate-600 hover:text-[#07572F] transition-colors">Services</a>
        <span class="text-slate-400" aria-hidden="true">&rsaquo;</span>
        <a href="/services/collection" class="text-slate-600 hover:text-[#07572F] transition-colors">IT Equipment Collection</a>
        <span class="text-slate-400" aria-hidden="true">&rsaquo;</span>
        <span class="text-[#07572F] font-semibold" aria-current="page">{data.title}</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-center">
        
        <!-- Left: Text content -->
        <div class="lg:col-span-7 space-y-5 sm:space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#07572F]/10 border border-[#07572F]/20 text-[#07572F] text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-[#07572F] animate-pulse"></span>
            <span>{data.heroBadge}</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-[46px] xl:text-[50px] font-semibold text-slate-900 tracking-tight leading-[1.12] font-display">
            {data.h1}
          </h1>

          <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-normal max-w-2xl">
            {data.valueProposition}
          </p>

          <!-- Primary & Secondary CTAs -->
          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href={`/request-a-collection?service=${encodeURIComponent(data.slug)}`}
              class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-[12px] bg-[#07572F] hover:bg-[#054324] text-white text-base font-semibold shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#07572F]"
            >
              <span>Request a Collection</span>
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a
              href="/contact"
              class="inline-flex items-center justify-center px-6 py-3.5 rounded-[12px] bg-slate-50 hover:bg-slate-100 border border-slate-300 text-slate-800 text-base font-semibold transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-slate-400"
            >
              Speak to a Specialist
            </a>
          </div>

          <!-- Quick Trust Badges -->
          <div class="pt-4 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs sm:text-sm text-slate-600 font-medium">
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#07572F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Vetted Logistics Fleet</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#07572F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Chain-of-Custody Manifest</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#07572F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>WEEE & GDPR Compliant</span>
            </div>
          </div>
        </div>

        <!-- Right: Equipment-specific Hero Image -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-[20px] overflow-hidden border border-slate-200/80 shadow-[0_20px_50px_rgba(0,0,0,0.08)] bg-slate-100">
            <img
              src={data.heroImage}
              alt={data.heroImageAlt}
              width="800"
              height="600"
              class="w-full h-auto object-cover object-center aspect-[4/3] select-none"
              loading="eager"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/20 via-transparent to-transparent pointer-events-none"></div>
          </div>
        </div>

      </div>
    </Container>
  </section>


  <!-- =====================================================
       2. TYPES OF EQUIPMENT COLLECTED
       ===================================================== -->
  <section class="py-12 sm:py-16 lg:py-20 bg-[#FBFDFB] border-b border-slate-200/80">
    <Container size="normal">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#07572F] font-mono">
          ACCEPTED HARDWARE SPECIFICATIONS
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-semibold text-slate-900 tracking-tight font-display mt-2 leading-[1.15]">
          {data.equipmentTypesHeading}
        </h2>
        <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal mt-3">
          {data.equipmentTypesIntro}
        </p>
      </div>

      <!-- 4-Card Grid for Equipment Types -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {data.typesCollected.map((category) => (
          <div class="bg-white rounded-[16px] p-6 sm:p-7 border border-slate-200/90 shadow-xs hover:border-[#07572F]/40 hover:shadow-md transition-all duration-200 flex flex-col justify-between">
            <div>
              <div class="flex items-center gap-3 mb-3">
                <span class="w-9 h-9 rounded-[10px] bg-[#07572F]/10 text-[#07572F] flex items-center justify-center shrink-0">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                  </svg>
                </span>
                <h3 class="text-lg sm:text-xl font-semibold text-slate-900 font-display">
                  {category.category}
                </h3>
              </div>
              
              <p class="text-sm text-slate-600 mb-4 leading-relaxed">
                {category.description}
              </p>

              <ul class="space-y-2.5 pt-2 border-t border-slate-100">
                {category.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm sm:text-[14.5px] text-slate-800">
                    <svg class="w-4 h-4 text-[#07572F] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        ))}
      </div>

      <!-- Quick note on unlisted equipment -->
      <div class="mt-8 p-5 rounded-[14px] bg-white border border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <svg class="w-5 h-5 text-[#07572F] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <span class="text-sm text-slate-700 font-medium">
            Have mixed estates, custom rack mounts, or unlisted equipment models? We collect diverse corporate inventories.
          </span>
        </div>
        <a
          href="/contact"
          class="shrink-0 text-sm font-semibold text-[#07572F] hover:underline inline-flex items-center gap-1"
        >
          <span>Ask our logistics team</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </Container>
  </section>


  <!-- =====================================================
       3. HOW THE COLLECTION PROCESS WORKS
       ===================================================== -->
  <section class="py-12 sm:py-16 lg:py-20 bg-white border-b border-slate-200/80">
    <Container size="normal">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#07572F] font-mono">
          NATIONWIDE LOGISTICS DISCIPLINE
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-semibold text-slate-900 tracking-tight font-display mt-2 leading-[1.15]">
          How the Collection Process Works
        </h2>
        <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal mt-3">
          {data.processIntro}
        </p>
      </div>

      <!-- Process Steps Progression Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
        {data.processSteps.map((step) => (
          <div class="bg-slate-50 rounded-[16px] p-5 sm:p-6 border border-slate-200/80 flex flex-col justify-between hover:border-[#07572F]/40 transition-all duration-200">
            <div>
              <span class="inline-block text-xl font-bold font-mono text-[#07572F] bg-[#07572F]/10 px-2.5 py-1 rounded-md mb-4 select-none">
                {step.step}
              </span>
              <h3 class="text-base sm:text-[17px] font-semibold text-slate-900 mb-2 font-display">
                {step.title}
              </h3>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                {step.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>


  <!-- =====================================================
       4. DATA SECURITY & HANDLING CONSIDERATIONS
       ===================================================== -->
  <section class="py-12 sm:py-16 lg:py-20 bg-[#F4F8F5] border-b border-slate-200/80">
    <Container size="normal">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#07572F] font-mono">
          CONFIDENTIALITY & GOVERNANCE
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-semibold text-slate-900 tracking-tight font-display mt-2 leading-[1.15]">
          {data.securityHeading}
        </h2>
        <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal mt-3">
          {data.securityIntro}
        </p>
      </div>

      <!-- 3 Key Security Protocols -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {data.securityPoints.map((point) => (
          <div class="bg-white rounded-[16px] p-6 sm:p-7 border border-slate-200/80 shadow-xs flex flex-col justify-start">
            <div class="w-10 h-10 rounded-[12px] bg-[#07572F]/10 text-[#07572F] flex items-center justify-center shrink-0 mb-4">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>

            <h3 class="text-lg sm:text-xl font-semibold text-slate-900 mb-2.5 font-display">
              {point.title}
            </h3>

            <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
              {point.description}
            </p>
          </div>
        ))}
      </div>
    </Container>
  </section>


  <!-- =====================================================
       5. REUSE, REFURBISHMENT & RECYCLING (CIRCULAR PATHWAYS)
       ===================================================== -->
  <section class="py-12 sm:py-16 lg:py-20 bg-white border-b border-slate-200/80">
    <Container size="normal">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#07572F] font-mono">
          ENVIRONMENTAL RESPONSIBILITY
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-semibold text-slate-900 tracking-tight font-display mt-2 leading-[1.15]">
          {data.circularHeading}
        </h2>
        <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal mt-3">
          {data.circularIntro}
        </p>
      </div>

      <!-- Circular Options Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {data.circularOptions.map((opt) => (
          <div class="bg-slate-50 rounded-[16px] p-6 sm:p-7 border border-slate-200/80 flex flex-col justify-between hover:border-[#07572F]/40 transition-colors">
            <div>
              <span class="inline-block text-xs font-semibold uppercase tracking-wider text-[#07572F] bg-[#07572F]/10 px-2.5 py-1 rounded-full mb-4">
                {opt.tag}
              </span>

              <h3 class="text-lg sm:text-xl font-semibold text-slate-900 mb-2.5 font-display">
                {opt.title}
              </h3>

              <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
                {opt.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>


  <!-- =====================================================
       6. RELATED COLLECTION SERVICES
       ===================================================== -->
  <section class="py-12 sm:py-16 lg:py-20 bg-white border-b border-slate-200/80">
    <Container size="normal">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 sm:mb-12">
        <div class="max-w-2xl">
          <span class="text-xs font-bold uppercase tracking-widest text-[#07572F] font-mono">
            COMPREHENSIVE COLLECTION CAPABILITIES
          </span>
          <h2 class="text-3xl sm:text-4xl font-semibold text-slate-900 tracking-tight font-display mt-2 leading-[1.15]">
            {data.relatedServicesHeading}
          </h2>
          <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal mt-2">
            {data.relatedServicesIntro}
          </p>
        </div>

        <a
          href="/services/collection"
          class="inline-flex items-center gap-1.5 text-sm font-semibold text-[#07572F] hover:underline shrink-0"
        >
          <span>All Collection Services Overview</span>
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>

      <!-- 3 Related Service Cards -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {relatedServices.map((service) => (
          <a
            href={service.route}
            class="group bg-slate-50 hover:bg-white rounded-[16px] p-6 sm:p-7 border border-slate-200/80 hover:border-[#07572F]/50 shadow-xs hover:shadow-md transition-all duration-200 flex flex-col justify-between"
          >
            <div>
              <div class="w-full h-40 rounded-[12px] overflow-hidden mb-4 bg-slate-200">
                <img
                  src={service.heroImage}
                  alt={service.title}
                  width="400"
                  height="250"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>

              <span class="text-xs font-bold uppercase tracking-wider text-[#07572F] block mb-2 font-mono">
                {service.heroBadge}
              </span>

              <h3 class="text-lg font-semibold text-slate-900 group-hover:text-[#07572F] transition-colors font-display mb-2">
                {service.title}
              </h3>

              <p class="text-sm text-slate-600 leading-relaxed">
                {service.valueProposition}
              </p>
            </div>

            <div class="pt-4 mt-4 border-t border-slate-200/60 flex items-center justify-between text-sm font-semibold text-[#07572F]">
              <span>View Service Details</span>
              <span class="group-hover:translate-x-1 transition-transform" aria-hidden="true">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>


  <!-- =====================================================
       7. FREQUENTLY ASKED QUESTIONS
       ===================================================== -->
  <FAQSection
    eyebrow={faqConfig?.eyebrow || "COMMON QUESTIONS"}
    title={faqConfig?.title || "Frequently Asked Questions"}
    subtitle={faqConfig?.subtitle || "Everything you need to know about our secure IT equipment collection process."}
    faqs={faqs}
    sectionId="faqs"
  />


  <!-- =====================================================
       8. FINAL CONTACT & COLLECTION CTA
       ===================================================== -->
  <CTA />

</BaseLayout>
