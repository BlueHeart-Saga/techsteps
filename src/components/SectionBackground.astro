---
interface Props {
  variant?: 'hero' | 'modern' | 'foliage' | 'bubbles' | 'glow' | 'minimal' | 'none';
  showBubbles?: boolean;
  bubbleCount?: 3 | 5;
  glow?: boolean;
  glowPosition?: 'center' | 'left' | 'right' | 'both';
  showFoliage?: boolean;
  foliagePosition?: 'top-right' | 'bottom-left' | 'top-left' | 'bottom-right';
  theme?: 'mint' | 'dark' | 'teal';
  className?: string;
}

const {
  variant = 'modern',
  showBubbles = true,
  bubbleCount = 3,
  glow = true,
  glowPosition = 'center',
  showFoliage = false,
  foliagePosition = 'top-right',
  theme = 'mint',
  className = '',
} = Astro.props;

// Generate unique identifier for SVG gradient IDs to avoid SVG collision
const uid = Math.random().toString(36).substring(2, 8);
---

<div class={`section-decoration theme-${theme} ${className}`} aria-hidden="true">
  <!-- 1. Ambient Mild Glow Orbs (Soft, elegant depth like Hero) -->
  {glow && (
    <>
      {glowPosition === 'both' ? (
        <>
          <div class="glow-orb glow-left" aria-hidden="true" />
          <div class="glow-orb glow-right" aria-hidden="true" />
        </>
      ) : (
        <div class={`glow-orb glow-${glowPosition}`} aria-hidden="true" />
      )}
    </>
  )}

  <!-- 2. Modern Eco Foliage Asset (Matching the Testimonial leaf style) -->
  {showFoliage && (
    <div class={`foliage-wrapper foliage-${foliagePosition}`} aria-hidden="true">
      <svg viewBox="0 0 240 260" fill="none" class="foliage-svg" aria-hidden="true">
        <!-- Botanical curved stem -->
        <path
          d="M230 10 C180 50, 160 120, 190 220"
          stroke="#2E7D32"
          stroke-width="2"
          stroke-linecap="round"
          opacity="0.35"
        />
        <!-- Leaf 1 -->
        <path
          d="M190 60 C150 40, 130 65, 145 95 C165 95, 185 80, 190 60 Z"
          fill={`url(#leaf-g1-${uid})`}
          opacity="0.55"
        />
        <!-- Leaf 2 -->
        <path
          d="M175 110 C130 100, 115 130, 135 155 C155 150, 170 135, 175 110 Z"
          fill={`url(#leaf-g2-${uid})`}
          opacity="0.65"
        />
        <!-- Leaf 3 -->
        <path
          d="M182 165 C145 160, 135 190, 155 210 C170 205, 180 185, 182 165 Z"
          fill={`url(#leaf-g1-${uid})`}
          opacity="0.5"
        />
        <!-- Leaf 4 (Accent) -->
        <path
          d="M210 35 C185 20, 175 40, 190 55 C202 52, 210 42, 210 35 Z"
          fill={`url(#leaf-g2-${uid})`}
          opacity="0.45"
        />
        <defs>
          <linearGradient id={`leaf-g1-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#4ADE80" />
            <stop offset="100%" stop-color="#0F623A" />
          </linearGradient>
          <linearGradient id={`leaf-g2-${uid}`} x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#86EFAC" />
            <stop offset="100%" stop-color="#15803D" />
          </linearGradient>
        </defs>
      </svg>
    </div>
  )}

  <!-- 3. Mild Organic Modern Shapes (Soft rounded gradient contours) -->
  <div class="modern-shape modern-shape-left" aria-hidden="true" />
  <div class="modern-shape modern-shape-right" aria-hidden="true" />

  <!-- 4. Mild Floating Orbs / Bubbles (Hero-inspired, slow and elegant) -->
  {showBubbles && (
    <>
      <span class="bubble bubble-1"></span>
      <span class="bubble bubble-2"></span>
      <span class="bubble bubble-3"></span>
      {bubbleCount >= 5 && (
        <>
          <span class="bubble bubble-4"></span>
          <span class="bubble bubble-5"></span>
        </>
      )}
    </>
  )}
</div>

<style>
  .section-decoration {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    z-index: 0;
  }

  /* =========================================================
     AMBIENT GLOW ORBS (Hero style: smooth, soft, and calming)
     ========================================================= */
  .glow-orb {
    position: absolute;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(221, 245, 235, 0.5) 0%, rgba(229, 247, 241, 0.22) 55%, transparent 75%);
    filter: blur(52px);
    pointer-events: none;
  }

  .glow-center {
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 680px;
    height: 380px;
  }

  .glow-left {
    top: 25%;
    left: -100px;
    width: 520px;
    height: 360px;
  }

  .glow-right {
    top: 25%;
    right: -90px;
    width: 520px;
    height: 360px;
  }

  /* =========================================================
     MODERN ORGANIC SHAPES (Soft rounded contours, mild & premium)
     ========================================================= */
  .modern-shape {
    position: absolute;
    border-radius: 50px 120px 40px 100px;
    pointer-events: none;
    opacity: 0.45;
  }

  .modern-shape-left {
    top: 15%;
    left: -60px;
    width: 220px;
    height: 140px;
    background: radial-gradient(ellipse at center, rgba(221, 245, 235, 0.4) 0%, rgba(240, 253, 248, 0.1) 65%, transparent 80%);
    filter: blur(28px);
    transform: rotate(-12deg);
  }

  .modern-shape-right {
    bottom: 12%;
    right: -50px;
    width: 260px;
    height: 160px;
    background: radial-gradient(ellipse at center, rgba(229, 247, 241, 0.45) 0%, rgba(240, 253, 248, 0.1) 65%, transparent 80%);
    filter: blur(32px);
    transform: rotate(18deg);
  }

  /* =========================================================
     MODERN ECO FOLIAGE ASSET (Mild, refined corner accent)
     ========================================================= */
  .foliage-wrapper {
    position: absolute;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }

  .foliage-svg {
    display: block;
    width: 100%;
    height: auto;
  }

  .foliage-top-right {
    top: -10px;
    right: -10px;
    width: 160px;
    opacity: 0.45;
  }

  .foliage-bottom-left {
    bottom: -15px;
    left: -15px;
    width: 170px;
    opacity: 0.4;
    transform: rotate(180deg);
  }

  .foliage-top-left {
    top: -10px;
    left: -10px;
    width: 160px;
    opacity: 0.4;
    transform: scaleX(-1);
  }

  .foliage-bottom-right {
    bottom: -15px;
    right: -15px;
    width: 170px;
    opacity: 0.4;
    transform: rotate(180deg) scaleX(-1);
  }

  /* =========================================================
     SLOW ELEGANT FLOATING BUBBLES (Hero style)
     ========================================================= */
  .bubble {
    position: absolute;
    display: block;
    border-radius: 50%;
    background: rgba(93, 202, 171, 0.12);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.6);
    animation: floatBubble 9s ease-in-out infinite;
    pointer-events: none;
  }

  .theme-dark .bubble {
    background: rgba(255, 255, 255, 0.08);
    box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.2);
  }

  .theme-teal .bubble {
    background: rgba(20, 107, 92, 0.1);
  }

  .bubble-1 {
    width: 52px;
    height: 52px;
    top: 18%;
    left: 4%;
  }

  .bubble-2 {
    width: 80px;
    height: 80px;
    top: 52%;
    right: 3%;
    animation-delay: -3.5s;
  }

  .bubble-3 {
    width: 24px;
    height: 24px;
    bottom: 15%;
    left: 42%;
    animation-delay: -6s;
  }

  .bubble-4 {
    width: 38px;
    height: 38px;
    top: 28%;
    right: 16%;
    animation-delay: -2s;
  }

  .bubble-5 {
    width: 28px;
    height: 28px;
    bottom: 22%;
    left: 10%;
    animation-delay: -7s;
  }

  @keyframes floatBubble {
    0%, 100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-12px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bubble {
      animation: none;
    }
  }

  @media (max-width: 768px) {
    .foliage-wrapper {
      width: 110px;
      opacity: 0.3;
    }
    .bubble-1 {
      width: 32px;
      height: 32px;
    }
    .bubble-2 {
      width: 46px;
      height: 46px;
    }
    .bubble-3 {
      width: 18px;
      height: 18px;
    }
    .bubble-4, .bubble-5 {
      display: none;
    }
    .modern-shape {
      display: none;
    }
  }
</style>
