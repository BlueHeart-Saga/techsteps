---
/**
 * ITSupportMegaMenu.astro
 * Premium enterprise mega-menu for "IT Support"
 * - Responsive 6-category grid matching TechSteps design system
 * - Soft-green category badges with custom SVG stroke icons
 * - Clean, legible subservice links with semibold typography & enhanced font size
 * - Reuses existing service pages where applicable (e.g. Office Relocation)
 */

import { itSupportCategories } from '../../data/itSupportServices';

const currentPath = Astro.url.pathname;

const isPathActive = (href: string) => {
  return currentPath === href || currentPath === `${href}/`;
};
---

<!-- =========================================================
     IT SUPPORT MEGA MENU PANEL
========================================================= -->
<div
  id="it-support-megamenu-panel"
  class="fixed top-[82px] inset-x-0 z-[998] hidden opacity-0 -translate-y-1 transition-[opacity,transform] duration-150 ease-out pointer-events-none before:absolute before:-top-10 before:inset-x-0 before:h-10 before:content-['']"
  role="region"
  aria-label="IT Support Menu"
>
  <div
    id="it-support-megamenu-wrapper"
    class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
  >
    <div
      id="it-support-megamenu-card"
      class="it-support-dropdown-card bg-white rounded-[20px] border border-slate-200/80 shadow-[0_20px_50px_rgba(0,0,0,0.08)] pointer-events-auto p-6 sm:p-7 lg:p-8 flex flex-col w-full box-border"
    >

      <!-- =====================================================
           TOP HEADER: TITLE
      ====================================================== -->
      <div class="mb-6 pb-3.5 border-b border-slate-100 flex items-center justify-between">
        <div>
          <div class="flex items-center gap-2">
            <span class="inline-block w-2 h-2 rounded-full bg-[#07572F] animate-pulse"></span>
            <h3 class="text-xs font-bold uppercase tracking-wider text-[#5A6874]">
              IT SUPPORT &amp; MANAGED SERVICES
            </h3>
          </div>
          <p class="text-[13.5px] text-slate-500 font-normal mt-0.5">
            Enterprise-grade technical support, certified hardware maintenance, network infrastructure &amp; proactive UK helpdesk.
          </p>
        </div>
      </div>

      <!-- =====================================================
           6 CATEGORIES GRID (3 COLUMNS x 2 ROWS)
      ====================================================== -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-7 flex-1">
        {itSupportCategories.map((category) => (
          <div class="it-support-category-block flex flex-col">
            <!-- Category Header -->
            <div class="flex items-center gap-2.5 mb-3 pb-2 border-b border-slate-100/90">
              <div class="w-8 h-8 rounded-[9px] bg-[#EAF5F1] text-[#07572F] flex items-center justify-center shrink-0">
                {category.iconName === 'helpdesk' && (
                  <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2zM9 9h6M9 13h4" />
                  </svg>
                )}
                {category.iconName === 'office' && (
                  <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                  </svg>
                )}
                {category.iconName === 'hardware' && (
                  <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                  </svg>
                )}
                {category.iconName === 'software' && (
                  <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                  </svg>
                )}
                {category.iconName === 'network' && (
                  <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
                  </svg>
                )}
                {category.iconName === 'managed' && (
                  <svg class="w-4.5 h-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
              </div>

              <h4 class="text-[15.5px] font-bold text-slate-900 tracking-tight">
                {category.name}
              </h4>
            </div>

            <!-- Subservice Links with Semibold & Visible Font Size -->
            <div class="flex flex-col space-y-1">
              {category.services.map((subservice) => {
                const href = subservice.customRoute || `/it-support/${subservice.slug}`;
                const active = isPathActive(href);

                return (
                  <a
                    href={href}
                    class={`it-support-sublink group flex items-center justify-between px-3 py-2 rounded-[10px] transition-all duration-150 text-[15px] xl:text-[15.5px] font-semibold leading-snug ${
                      active
                        ? 'bg-[#EAF5F1] text-[#07572F]'
                        : 'text-slate-800 hover:bg-[#EAF5F1]/85 hover:text-[#07572F]'
                    }`}
                  >
                    <span class="truncate">{subservice.name}</span>
                    <span class="text-sm font-bold text-[#07572F] opacity-0 -translate-x-1 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-150 shrink-0 ml-2" aria-hidden="true">
                      &rarr;
                    </span>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>

    </div>
  </div>
</div>
