---
import { getDivisions, getSectors, getSiteSettings } from '../../lib/sanity/client';
import BrandLogo from './BrandLogo.astro';

const [divisions, sectors, siteSettings] = await Promise.all([
  getDivisions(),
  getSectors(),
  getSiteSettings(),
]);

const currentYear = new Date().getFullYear();
---

<footer class="relative w-full bg-[#071F19] overflow-x-clip" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <!-- Main Deep Teal-Green Body -->
  <div class="w-full bg-[#071F19] text-white pt-12 sm:pt-14 lg:pt-16 pb-12 sm:pb-14 lg:pb-16 px-4 sm:px-6 lg:px-12 relative overflow-visible">

    <!-- Subtle ambient green radial glow in the corner -->
    <div class="absolute inset-0 bg-radial-[ellipse_at_top_left] from-[#3FB33D]/12 via-transparent to-transparent pointer-events-none select-none"></div>

    <div class="relative z-10 max-w-[1480px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-10 lg:gap-10 xl:gap-12 items-start">
        
        <!-- Column 1: Brand Logo & Freshworks-style Contact Block -->
        <div class="space-y-4 font-sans">
          <!-- Logo -->
          <a
            href="/"
            class="inline-block focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] focus-visible:ring-offset-2 focus-visible:ring-offset-[#071F19] rounded-lg"
            aria-label="TechSteps Home"
          >
            <BrandLogo size="md" variant="light" showTagline={false} />
          </a>

          <!-- Get in Touch Heading & Details (avoiding repeated 'Contact' and 'TechSteps') -->
          <div class="space-y-2.5 pt-1">
            <h3 class="text-[18px] sm:text-[19px] font-medium text-white tracking-tight">
              Get in Touch
            </h3>

            <!-- Action Link (Speak with our team ↗) -->
            <div>
              <a
                href="/contact"
                class="group inline-flex items-center gap-1.5 text-[15px] font-semibold text-white hover:text-[#6EE7B7] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] rounded-sm"
              >
                <span>Speak with our team</span>
                <span class="text-base font-normal leading-none transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
              </a>
            </div>

            <!-- Email & Phone Links -->
            <div class="space-y-1.5 pt-0.5">
              {siteSettings.email && (
                <a
                  href={`mailto:${siteSettings.email}`}
                  class="text-[14px] text-slate-300 hover:text-[#6EE7B7] transition-colors block leading-snug focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] rounded-sm"
                >
                  {siteSettings.email}
                </a>
              )}
              {siteSettings.phone && (
                <a
                  href={`tel:${siteSettings.phone.replace(/[^0-9+]/g, '')}`}
                  class="text-[14px] text-slate-300/80 hover:text-[#6EE7B7] transition-colors block leading-snug focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] rounded-sm"
                >
                  {siteSettings.phone}
                </a>
              )}
            </div>

            <!-- Social Media Icons Row (clean, borderless, no background) -->
            <div class="flex items-center gap-4 pt-2">
              <!-- LinkedIn -->
              <a
                href={siteSettings.socialLinks?.linkedin || "https://www.linkedin.com/company/techsteps-uk/posts/?feedView=all"}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center text-slate-300 hover:text-white transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] focus-visible:ring-offset-2 focus-visible:ring-offset-[#071F19] rounded-sm"
                aria-label="TechSteps on LinkedIn"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </a>

              <!-- X / Twitter -->
              <a
                href={siteSettings.socialLinks?.twitter || "https://twitter.com/techsteps_uk"}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center text-slate-300 hover:text-white transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] focus-visible:ring-offset-2 focus-visible:ring-offset-[#071F19]"
                aria-label="TechSteps on X"
              >
                <svg class="w-[18px] h-[18px] fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>

              <!-- Facebook -->
              <a
                href={siteSettings.socialLinks?.facebook || "http://facebook.com/profile.php?id=61584942775645"}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center text-slate-300 hover:text-white transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] focus-visible:ring-offset-2 focus-visible:ring-offset-[#071F19]"
                aria-label="TechSteps on Facebook"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M9 8H6v4h3v12h5V12h3.642L18 8h-4V6.333C14 5.374 14.5 5 15.65 5H18V0h-3.808C10.597 0 9 1.583 9 4.615V8z"/>
                </svg>
              </a>

              <!-- Instagram -->
              <a
                href={siteSettings.socialLinks?.instagram || "https://www.instagram.com/techsteps_official/"}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center justify-center text-slate-300 hover:text-white transition-colors duration-200 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] focus-visible:ring-offset-2 focus-visible:ring-offset-[#071F19]"
                aria-label="TechSteps on Instagram"
              >
                <svg class="w-5 h-5 fill-none stroke-current" viewBox="0 0 24 24" stroke-width="2" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5" />
                  <circle cx="12" cy="12" r="4" />
                  <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                </svg>
              </a>
            </div>
          </div>
        </div>

        <!-- Column 2: Services Navigation Links -->
        <div class="space-y-4 font-sans">
          <h3 class="text-[14px] font-semibold text-white uppercase tracking-[0.05em] pb-3 border-b border-white/10">
            Services
          </h3>
          <ul class="space-y-3 text-[14px]">
            {(siteSettings.footerServices || []).map((link, idx) => {
              const isLast = idx === (siteSettings.footerServices?.length || 0) - 1;
              let targetUrl = link.url;
              if (targetUrl?.startsWith('/services/')) {
                const parts = targetUrl.split('/').filter(Boolean);
                if (parts.length === 3) {
                  targetUrl = `/services/${parts[2]}`;
                }
              }
              return (
                <li class={isLast ? 'pt-1.5' : ''}>
                  <a
                    href={targetUrl}
                    target={link.openInNewTab ? '_blank' : undefined}
                    rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
                    class={isLast
                      ? 'group inline-flex items-center gap-1.5 text-[14px] font-semibold text-[#3FB33D] hover:text-[#6EE7B7] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] rounded-sm'
                      : 'text-slate-300 hover:text-[#6EE7B7] transition-colors block leading-snug focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] rounded-sm'}
                  >
                    <span>{link.label}</span>
                    {isLast && (
                      <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                      </svg>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        <!-- Column 3: Industries Navigation Links -->
        <div class="space-y-4 font-sans">
          <h3 class="text-[14px] font-semibold text-white uppercase tracking-[0.05em] pb-3 border-b border-white/10">
            Industries
          </h3>
          <ul class="space-y-3 text-[14px]">
            {(siteSettings.footerSectors || []).map((link, idx) => {
              const isLast = idx === (siteSettings.footerSectors?.length || 0) - 1;
              return (
                <li class={isLast ? 'pt-1.5' : ''}>
                  <a
                    href={link.url}
                    target={link.openInNewTab ? '_blank' : undefined}
                    rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
                    class={isLast
                      ? 'group inline-flex items-center gap-1.5 text-[14px] font-semibold text-[#3FB33D] hover:text-[#6EE7B7] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] rounded-sm'
                      : 'text-slate-300 hover:text-[#6EE7B7] transition-colors block leading-snug focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] rounded-sm'}
                  >
                    <span>{link.label}</span>
                    {isLast && (
                      <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                      </svg>
                    )}
                  </a>
                </li>
              );
            })}
          </ul>
        </div>

        <!-- Column 4: Company / Quick Links -->
        <div class="space-y-4 font-sans">
          <h3 class="text-[14px] font-semibold text-white uppercase tracking-[0.05em] pb-3 border-b border-white/10">
            Company
          </h3>
          <ul class="space-y-3 text-[14px]">
            {(siteSettings.footerCompany || []).map((link) => (
              <li>
                <a
                  href={link.url}
                  target={link.openInNewTab ? '_blank' : undefined}
                  rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
                  class="text-slate-300 hover:text-[#6EE7B7] transition-colors block leading-snug focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] rounded-sm"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </div>

  <!-- Bottom Legal Strip -->
  <div class="w-full bg-[#051813] py-5 px-4 sm:px-6 lg:px-12 border-t border-white/10 relative z-30">
    <div class="max-w-[1480px] mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-[13px] text-slate-400 font-sans">
      <p class="text-slate-400 text-center md:text-left">
        &copy; {currentYear} {siteSettings.footerCopyright || `${siteSettings.legalName || 'Techsteps UK Limited'}. All rights reserved.`}
      </p>
      <div class="flex flex-wrap items-center justify-center md:justify-end gap-x-6 gap-y-2 text-[13px] text-slate-400 font-sans">
        {(siteSettings.footerLegal || []).map((link) => (
          <a
            href={link.url}
            target={link.openInNewTab ? '_blank' : undefined}
            rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
            class="text-slate-400 hover:text-[#6EE7B7] transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-[#3FB33D] rounded-sm"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
