---
import { getDivisions, getSectors, getSiteSettings } from '../../lib/sanity/client';
import BrandLogo from './BrandLogo.astro';

const [divisions, sectors, siteSettings] = await Promise.all([
  getDivisions(),
  getSectors(),
  getSiteSettings(),
]);

const currentYear = new Date().getFullYear();
---

<footer class="relative w-full bg-white overflow-x-clip" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <!-- Main Black Body -->
  <div class="w-full bg-[#0B0F0D] text-white pt-10 sm:pt-12 pb-10 sm:pb-12 px-4 sm:px-6 lg:px-12 relative overflow-visible">

    <!-- Subtle ambient green radial glow in the corner -->
    <div class="absolute inset-0 bg-radial-[ellipse_at_top_left] from-[#23853A]/15 via-transparent to-transparent pointer-events-none select-none"></div>

    <div class="relative z-10 max-w-[1480px] mx-auto">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-8 lg:gap-10 xl:gap-12 relative items-start">
        
        <!-- Column 1: Brand Logo & Social Media Links -->
        <div class="sm:col-span-2 lg:col-span-3 space-y-4 font-sans">
          <!-- Logo -->
          <a href="/" class="inline-block focus:outline-none focus:ring-2 focus:ring-white rounded-lg" aria-label="TechSteps Home">
            <BrandLogo size="md" variant="light" showTagline={false} />
          </a>

<!-- Follow Us / Social Links -->
<div class="flex items-center gap-6 pt-2">

  <!-- LinkedIn -->
  <a
    href="https://www.linkedin.com/company/techsteps-uk/posts/?feedView=all"
    target="_blank"
    rel="noopener noreferrer"
    class="group flex items-center justify-center
           text-white/55 hover:text-white
           transition-colors duration-300"
    aria-label="TechSteps on LinkedIn"
  >
    <svg
      class="w-[25px] h-[25px] fill-current
             transition-all duration-300
             group-hover:drop-shadow-[0_0_6px_rgba(255,255,255,0.25)]"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
    </svg>
  </a>


  <!-- Instagram -->
  <a
    href="https://www.instagram.com/techsteps_official/"
    target="_blank"
    rel="noopener noreferrer"
    class="group flex items-center justify-center
           text-white/55 hover:text-white
           transition-colors duration-300"
    aria-label="TechSteps on Instagram"
  >
    <svg
      class="w-[27px] h-[27px] fill-none stroke-current
             transition-all duration-300
             group-hover:drop-shadow-[0_0_6px_rgba(255,255,255,0.25)]"
      viewBox="0 0 24 24"
      stroke-width="1.8"
      aria-hidden="true"
    >
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </svg>
  </a>


  <!-- Phone -->
  {siteSettings.phone && (
    <a
      href={`tel:${siteSettings.phone.replace(/[^0-9+]/g, '')}`}
      class="group flex items-center justify-center
             text-white/55 hover:text-white
             transition-colors duration-300"
      aria-label="Call TechSteps"
    >
      <svg
        class="w-[25px] h-[25px] fill-none stroke-current
               transition-all duration-300
               group-hover:drop-shadow-[0_0_6px_rgba(255,255,255,0.25)]"
        viewBox="0 0 24 24"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a2 2 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
        />
      </svg>
    </a>
  )}


  <!-- Email -->
  {siteSettings.email && (
    <a
      href={`mailto:${siteSettings.email}`}
      class="group flex items-center justify-center
             text-white/55 hover:text-white
             transition-colors duration-300"
      aria-label="Email TechSteps"
    >
      <svg
        class="w-[26px] h-[26px] fill-none stroke-current
               transition-all duration-300
               group-hover:drop-shadow-[0_0_6px_rgba(255,255,255,0.25)]"
        viewBox="0 0 24 24"
        stroke-width="2"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
        />
      </svg>
    </a>
  )}

</div>
        </div>

        <!-- Column 2: Services Navigation Links -->
        <div class="lg:col-span-3 space-y-3 font-sans">
          <h3 class="text-xs sm:text-[13px] font-semibold text-white uppercase tracking-wider pb-1.5 border-b border-white/10">
            Services
          </h3>
          <ul class="space-y-2.5 text-xs sm:text-[13px] text-slate-300">
            {(siteSettings.footerServices || []).map((link, idx) => (
              <li class={idx === (siteSettings.footerServices?.length || 0) - 1 ? 'pt-1.5' : ''}>
                <a
                  href={link.url}
                  target={link.openInNewTab ? '_blank' : undefined}
                  rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
                  class={idx === (siteSettings.footerServices?.length || 0) - 1
                    ? 'text-[#0F623A] font-bold hover:underline transition-colors inline-flex items-center gap-1'
                    : 'hover:text-[#0F623A] hover:underline transition-colors block leading-tight'}
                >
                  <span>{link.label}</span>
                  {idx === (siteSettings.footerServices?.length || 0) - 1 && <span>&rarr;</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Column 3: Industries Navigation Links -->
        <div class="lg:col-span-3 space-y-3 font-sans">
          <h3 class="text-xs sm:text-[13px] font-semibold text-white uppercase tracking-wider pb-1.5 border-b border-white/10">
            Industries
          </h3>
          <ul class="space-y-2.5 text-xs sm:text-[13px] text-slate-300">
            {(siteSettings.footerSectors || []).map((link, idx) => (
              <li class={idx === (siteSettings.footerSectors?.length || 0) - 1 ? 'pt-1.5' : ''}>
                <a
                  href={link.url}
                  target={link.openInNewTab ? '_blank' : undefined}
                  rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
                  class={idx === (siteSettings.footerSectors?.length || 0) - 1
                    ? 'text-[#0F623A] font-bold hover:underline transition-colors inline-flex items-center gap-1'
                    : 'hover:text-[#0F623A] hover:underline transition-colors block leading-tight'}
                >
                  <span>{link.label}</span>
                  {idx === (siteSettings.footerSectors?.length || 0) - 1 && <span>&rarr;</span>}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <!-- Column 4: Company / Quick Links -->
        <div class="lg:col-span-3 space-y-3 font-sans">
          <h3 class="text-xs sm:text-[13px] font-semibold text-white uppercase tracking-wider pb-1.5 border-b border-white/10">
            Company
          </h3>
          <ul class="space-y-2 text-xs sm:text-[13px] text-slate-300">
            {(siteSettings.footerCompany || []).map((link) => (
              <li>
                <a
                  href={link.url}
                  target={link.openInNewTab ? '_blank' : undefined}
                  rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
                  class="hover:text-[#0F623A] hover:underline transition-colors block leading-tight"
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>

      </div>
    </div>
  </div>

  <!-- Bottom Legal Strip -->
  <div class="w-full bg-[#060907] py-4 px-4 sm:px-6 lg:px-12 border-t border-white/10 relative z-30">
    <div class="max-w-[1480px] mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-white font-sans">
      <p class="text-white">&copy; {currentYear} {siteSettings.footerCopyright || `${siteSettings.legalName}. All rights reserved.`}</p>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-white font-sans">
        {(siteSettings.footerLegal || []).map((link) => (
          <a
            href={link.url}
            target={link.openInNewTab ? '_blank' : undefined}
            rel={link.openInNewTab ? 'noopener noreferrer' : undefined}
            class="text-white hover:underline transition-colors"
          >
            {link.label}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>
