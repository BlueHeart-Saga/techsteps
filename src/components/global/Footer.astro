---
import { getDivisions, getSectors, getSiteSettings } from '../../lib/sanity/client';
import BrandLogo from './BrandLogo.astro';
import FooterNewsletter from '../newsletter/FooterNewsletter';

const [divisions, sectors, siteSettings] = await Promise.all([
  getDivisions(),
  getSectors(),
  getSiteSettings(),
]);

const currentYear = new Date().getFullYear();
---

<footer class="relative w-full bg-transparent mt-16 sm:mt-24 md:mt-28 lg:mt-32 overflow-x-clip" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <!-- Main Black Body -->
  <div class="w-full bg-[#0B0F0D] text-white pt-8 pb-0 px-4 sm:px-6 lg:px-12 relative overflow-visible">

    <!-- Subtle ambient green radial glow in the corner -->
    <div class="absolute inset-0 bg-radial-[ellipse_at_top_left] from-[#23853A]/15 via-transparent to-transparent pointer-events-none select-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-6 lg:gap-8 items-end relative">
        <!-- Column 1: Navigation & Socials -->
        <div class="md:col-span-4 lg:col-span-3 space-y-5 pb-8 md:pb-10">
          <a href="/" class="inline-block focus:outline-none focus:ring-2 focus:ring-white rounded-lg" aria-label="TechSteps Home">
            <BrandLogo size="md" variant="light" showTagline={false} />
          </a>

          <nav aria-label="Footer Quick Links">
            <ul class="space-y-2.5 text-sm font-medium text-white">
              <li>
                <a href="/about-us" class="text-white hover:text-white/80 hover:underline transition-all inline-block">About Us</a>
              </li>
              <li>
                <a href="/services" class="text-white hover:text-white/80 hover:underline transition-all inline-block">Services</a>
              </li>
              <li>
                <a href="/sectors" class="text-white hover:text-white/80 hover:underline transition-all inline-block">Sectors</a>
              </li>
              <li>
                <a href="/sustainability" class="text-white hover:text-white/80 hover:underline transition-all inline-block">Sustainability &amp; ESG</a>
              </li>
              <li>
                <a href="/insights" class="text-white hover:text-white/80 hover:underline transition-all inline-block">Insights &amp; News</a>
              </li>
              <li>
                <a href="/contact" class="text-white hover:text-white/80 hover:underline transition-all inline-block">Contact Us</a>
              </li>
            </ul>
          </nav>

          <!-- Circular Outline Social Icons -->
          <div class="flex items-center gap-3 pt-2">
            {siteSettings.socialLinks.linkedin && (
              <a
                href={siteSettings.socialLinks.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="h-8 w-8 rounded-full border border-white/60 hover:border-white hover:bg-white/20 flex items-center justify-center text-white transition-colors"
                aria-label="TechSteps on LinkedIn"
              >
                <svg class="h-3.5 w-3.5 fill-current text-white" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </a>
            )}
            {siteSettings.socialLinks.twitter && (
              <a
                href={siteSettings.socialLinks.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="h-8 w-8 rounded-full border border-white/60 hover:border-white hover:bg-white/20 flex items-center justify-center text-white transition-colors"
                aria-label="TechSteps on X"
              >
                <svg class="h-3 w-3 fill-current text-white" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            )}
            <a
              href={`tel:${siteSettings.phone.replace(/[^0-9+]/g, '')}`}
              class="h-8 w-8 rounded-full border border-white/60 hover:border-white hover:bg-white/20 flex items-center justify-center text-white transition-colors"
              aria-label="Call TechSteps"
            >
              <svg class="h-3.5 w-3.5 fill-none stroke-current text-white" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Column 2: Newsletter "Get Updates" -->
        <div class="md:col-span-4 lg:col-span-5 md:border-l md:border-white/20 md:pl-6 lg:pl-10 text-center pb-8 md:pb-10 self-center">
          <FooterNewsletter client:load />
        </div>

        <!-- Column 3: Technician Image (Big & Popping Out of the Footer) -->
        <div class="md:col-span-4 lg:col-span-4 flex justify-center md:justify-end items-end self-end relative z-20">
          <!-- Backlight Ambient Glow behind Technician -->
          <div class="absolute -top-12 md:-top-24 right-0 sm:right-4 md:right-8 w-64 h-64 md:w-84 md:h-84 rounded-full bg-emerald-300/20 blur-3xl pointer-events-none -z-10"></div>

          <img
            src="/images/footer-technician.png"
            alt="TechSteps certified technician"
            class="h-80 sm:h-96 md:h-[460px] lg:h-[520px] xl:h-[580px] w-auto max-w-none object-contain object-bottom -mt-8 sm:-mt-12 md:-mt-32 lg:-mt-44 xl:-mt-52 -mb-px drop-shadow-[0_25px_35px_rgba(0,0,0,0.55)] select-none pointer-events-auto transition-transform duration-500 ease-out hover:scale-[1.04] hover:-translate-y-1.5"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Strip -->
  <div class="w-full bg-[#060907] py-4 px-4 sm:px-6 lg:px-12 border-t border-white/10 relative z-30">
    <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-white font-sans">
      <p class="text-white">&copy; {currentYear} {siteSettings.legalName}. All rights reserved.</p>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-white font-sans">
        <a href="/privacy-policy" class="text-white hover:underline transition-colors">Privacy Policy</a>
        <a href="/cookie-policy" class="text-white hover:underline transition-colors">Cookie Policy</a>
        <a href="/terms-and-conditions" class="text-white hover:underline transition-colors">Terms &amp; Conditions</a>
        <a href="/accessibility" class="text-white hover:underline transition-colors">Accessibility</a>
        <a href="/modern-slavery-statement" class="text-white hover:underline transition-colors">Modern Slavery</a>
        <a href="/environmental-policy" class="text-white hover:underline transition-colors">Environmental Policy</a>
        <a href="/information-security-policy" class="text-white hover:underline transition-colors">Information Security</a>
      </div>
    </div>
  </div>
</footer>
