---
import { getDivisions, getSectors, getSiteSettings } from '../../lib/sanity/client';
import BrandLogo from './BrandLogo.astro';

const [divisions, sectors, siteSettings] = await Promise.all([
  getDivisions(),
  getSectors(),
  getSiteSettings(),
]);

const currentYear = new Date().getFullYear();
---

<footer class="relative w-full bg-transparent mt-16 sm:mt-24 md:mt-28 lg:mt-32 overflow-x-clip" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>

  <!-- Main Black Body -->
  <div class="w-full bg-[#0B0F0D] text-white pt-10 sm:pt-12 pb-0 px-4 sm:px-6 lg:px-12 relative overflow-visible">

    <!-- Subtle ambient green radial glow in the corner -->
    <div class="absolute inset-0 bg-radial-[ellipse_at_top_left] from-[#23853A]/15 via-transparent to-transparent pointer-events-none select-none"></div>

    <div class="relative z-10 max-w-[1480px] mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8 lg:gap-8 xl:gap-10 items-end relative">
        
        <!-- Column 1: Brand Logo, Short Site Definition, Strategic Callout & Operational Bullets -->
        <div class="md:col-span-12 lg:col-span-4 xl:col-span-4 space-y-4 pb-6 lg:pb-10 font-sans">
          <!-- Logo -->
          <a href="/" class="inline-block focus:outline-none focus:ring-2 focus:ring-white rounded-lg" aria-label="TechSteps Home">
            <BrandLogo size="md" variant="light" showTagline={false} />
          </a>

          <!-- Short Definition about the site -->
          <p class="text-xs sm:text-[13px] text-slate-300/90 leading-relaxed max-w-sm">
            UK's certified lifecycle partner delivering secure IT asset disposition, defensible data destruction, compliant records management, and specialized commercial relocation nationwide.
          </p>

          <!-- Highlighted Callout Box with Accent Left Border -->
          <div class="border-l-2 border-[#3FB33D] pl-3 py-1 bg-white/[0.02]">
            <p class="text-[11px] sm:text-xs font-bold tracking-wider text-[#3FB33D] uppercase leading-snug font-mono">
              STRATEGIC LIFECYCLE &amp; DATA DESTRUCTION SOLUTIONS FOR UK ENTERPRISE.
            </p>
          </div>

          <!-- Operational Locations / Scope with Icons -->
          <ul class="space-y-2 text-xs sm:text-[13px] text-slate-300 font-medium pt-1">
            <li class="flex items-center gap-2.5">
              <span class="text-[#3FB33D] shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </span>
              <span>UK Nationwide Operations</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#3FB33D] shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </span>
              <span>GPS-Tracked Security Fleet</span>
            </li>
            <li class="flex items-center gap-2.5">
              <span class="text-[#3FB33D] shrink-0">
                <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </span>
              <span>Zero-Landfill &amp; Scope 3 ESG Compliance</span>
            </li>
          </ul>

          <!-- Follow Us / Social Links -->
          <div class="flex items-center gap-2.5 pt-2">
            {siteSettings.socialLinks.linkedin && (
              <a
                href={siteSettings.socialLinks.linkedin}
                target="_blank"
                rel="noopener noreferrer"
                class="h-7 w-7 rounded-full border border-white/40 hover:border-white hover:bg-white/20 flex items-center justify-center text-white transition-colors"
                aria-label="TechSteps on LinkedIn"
              >
                <svg class="h-3.5 w-3.5 fill-current text-white" viewBox="0 0 24 24">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </a>
            )}
            {siteSettings.socialLinks.twitter && (
              <a
                href={siteSettings.socialLinks.twitter}
                target="_blank"
                rel="noopener noreferrer"
                class="h-7 w-7 rounded-full border border-white/40 hover:border-white hover:bg-white/20 flex items-center justify-center text-white transition-colors"
                aria-label="TechSteps on X"
              >
                <svg class="h-3 w-3 fill-current text-white" viewBox="0 0 24 24">
                  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                </svg>
              </a>
            )}
            <a
              href={`tel:${siteSettings.phone.replace(/[^0-9+]/g, '')}`}
              class="h-7 w-7 rounded-full border border-white/40 hover:border-white hover:bg-white/20 flex items-center justify-center text-white transition-colors"
              aria-label="Call TechSteps"
            >
              <svg class="h-3.5 w-3.5 fill-none stroke-current text-white" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Column 2 (Center): Navigation Links for Services, Sectors, and Company -->
        <div class="md:col-span-8 lg:col-span-5 xl:col-span-5 grid grid-cols-2 sm:grid-cols-3 gap-6 sm:gap-8 pb-6 lg:pb-10 font-sans">
          
          <!-- Services Navigation Column (Main 4 Divisions from Services Dropdown) -->
          <div class="space-y-3">
            <h3 class="text-xs sm:text-[13px] font-bold text-white uppercase tracking-wider pb-1.5 border-b border-white/10">
              Services
            </h3>
            <ul class="space-y-2.5 text-xs sm:text-[13px] text-slate-300">
              <li>
                <a href="/information-management" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">Information Management</a>
              </li>
              <li>
                <a href="/it-lifecycle-services-destruction" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">IT Lifecycle Services &amp; Destruction</a>
              </li>
              <li>
                <a href="/secure-shredding-document-integrity" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">Secure Shredding &amp; Document Integrity</a>
              </li>
              <li>
                <a href="/moving-relocation-services" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">Moving &amp; Relocation Services</a>
              </li>
              <li class="pt-1.5">
                <a href="/services" class="text-[#3FB33D] font-bold hover:underline transition-colors inline-flex items-center gap-1">
                  <span>All Services</span>
                  <span>&rarr;</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Sectors / Industries Navigation Column (Main 4 Core Sectors from Sectors Dropdown) -->
          <div class="space-y-3">
            <h3 class="text-xs sm:text-[13px] font-bold text-white uppercase tracking-wider pb-1.5 border-b border-white/10">
              Industries
            </h3>
            <ul class="space-y-2.5 text-xs sm:text-[13px] text-slate-300">
              <li>
                <a href="/sectors/defence" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">Defence</a>
              </li>
              <li>
                <a href="/sectors/nhs" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">NHS &amp; Healthcare</a>
              </li>
              <li>
                <a href="/sectors/finance" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">Financial Services</a>
              </li>
              <li>
                <a href="/sectors/central-government" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">Central Government</a>
              </li>
              <li class="pt-1.5">
                <a href="/sectors" class="text-[#3FB33D] font-bold hover:underline transition-colors inline-flex items-center gap-1">
                  <span>All Sectors</span>
                  <span>&rarr;</span>
                </a>
              </li>
            </ul>
          </div>

          <!-- Company / Quick Links Column -->
          <div class="space-y-3 col-span-2 sm:col-span-1">
            <h3 class="text-xs sm:text-[13px] font-bold text-white uppercase tracking-wider pb-1.5 border-b border-white/10">
              Company
            </h3>
            <ul class="space-y-2 text-xs sm:text-[13px] text-slate-300">
              <li>
                <a href="/about-us" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">About Us</a>
              </li>
              <li>
                <a href="/sustainability" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">Sustainability &amp; ESG</a>
              </li>
              <li>
                <a href="/insights" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">Insights &amp; News</a>
              </li>
              <li>
                <a href="/request-a-quote" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">Request Collection</a>
              </li>
              <li>
                <a href="/contact" class="hover:text-[#3FB33D] hover:underline transition-colors block leading-tight">Contact Us</a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Column 3 (Right): Technician Image (Kept Exactly as it is, Big & Popping Out) -->
        <div class="md:col-span-4 lg:col-span-3 xl:col-span-3 flex justify-center lg:justify-end items-end self-end relative z-20">
          <!-- Backlight Ambient Glow behind Technician -->
          <div class="absolute -top-12 md:-top-24 right-0 sm:right-4 md:right-8 w-64 h-64 md:w-84 md:h-84 rounded-full bg-emerald-300/20 blur-3xl pointer-events-none -z-10"></div>

          <img
            src="/images/footer-technician.png"
            alt="TechSteps certified technician"
            class="h-80 sm:h-96 md:h-[440px] lg:h-[480px] xl:h-[540px] w-auto max-w-none object-contain object-bottom -mt-8 sm:-mt-12 md:-mt-24 lg:-mt-36 xl:-mt-44 -mb-px drop-shadow-[0_25px_35px_rgba(0,0,0,0.55)] select-none pointer-events-auto transition-transform duration-500 ease-out hover:scale-[1.04] hover:-translate-y-1.5"
            loading="lazy"
          />
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom Legal Strip -->
  <div class="w-full bg-[#060907] py-4 px-4 sm:px-6 lg:px-12 border-t border-white/10 relative z-30">
    <div class="max-w-[1480px] mx-auto flex flex-col md:flex-row items-center justify-between gap-4 text-xs text-white font-sans">
      <p class="text-white">&copy; {currentYear} {siteSettings.legalName}. All rights reserved.</p>
      <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-xs text-white font-sans">
        <a href="/privacy-policy" class="text-white hover:underline transition-colors">Privacy Policy</a>
        <a href="/cookie-policy" class="text-white hover:underline transition-colors">Cookie Policy</a>
        <a href="/terms-and-conditions" class="text-white hover:underline transition-colors">Terms &amp; Conditions</a>
        <a href="/accessibility" class="text-white hover:underline transition-colors">Accessibility</a>
        <a href="/modern-slavery-statement" class="text-white hover:underline transition-colors">Modern Slavery</a>
        <a href="/environmental-policy" class="text-white hover:underline transition-colors">Environmental Policy</a>
        <a href="/information-security-policy" class="text-white hover:underline transition-colors">Information Security</a>
      </div>
    </div>
  </div>
</footer>
