---
const freephone = '+44 1784 640216';
const phoneRaw = '+441784640216';
const email = 'collection@techsteps.co.uk';
---

<!-- =====================================================
     TECHSTEPS TOP UTILITY BAR (Minimal UK Corporate Design)
     Height: ~42px, Background: #062E20, Inter typography 12-13px
====================================================== -->
<aside
  id="site-topbar"
  aria-label="Direct Contact and Trust Information"
  class="w-full bg-[#062E20] text-white/90 border-b border-emerald-950/40 select-none relative z-[996] transition-colors duration-200"
>
  <div
    class="w-full max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 h-[42px] flex items-center justify-between text-[12px] sm:text-[13px] font-sans font-medium"
  >
    <!-- LEFT: OUTLINED SHIELD ICON + TEXT -->
    <div class="hidden sm:flex items-center gap-2 text-white/90">
      <!-- Minimal Outlined Shield Icon -->
      <svg
        class="w-3.5 h-3.5 text-emerald-400 shrink-0"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
        stroke-width="1.75"
        aria-hidden="true"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
        />
      </svg>
      <span>Secure IT Asset Disposal</span>
    </div>

    <!-- RIGHT: MINIMAL EMAIL & PHONE WITH OUTLINE ICONS -->
    <div class="flex items-center justify-end w-full sm:w-auto gap-4 sm:gap-6 text-white/90">
      
      <!-- EMAIL (Desktop) -->
      <a
        href={`mailto:${email}`}
        aria-label={`Email TechSteps at ${email}`}
        class="hidden md:inline-flex items-center gap-1.5 text-white/85 hover:text-white transition-colors duration-150 focus:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded-sm"
      >
        <!-- Minimal Outlined Mail Icon -->
        <svg
          class="w-3.5 h-3.5 text-emerald-400 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
          />
        </svg>
        <span>{email}</span>
      </a>

      <!-- PHONE NUMBER (Simple, Minimal Outline Icon) -->
      <a
        href={`tel:${phoneRaw}`}
        aria-label={`Call TechSteps on ${freephone}`}
        class="inline-flex items-center gap-1.5 text-white/90 hover:text-white transition-colors duration-150 focus:outline-none focus-visible:ring-1 focus-visible:ring-emerald-400 rounded-sm"
      >
        <!-- Minimal Outlined Phone Icon -->
        <svg
          class="w-3.5 h-3.5 text-emerald-400 shrink-0"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
          stroke-width="1.75"
          aria-hidden="true"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"
          />
        </svg>
        <span class="tracking-tight font-medium">{freephone}</span>
      </a>

    </div>
  </div>
</aside>
