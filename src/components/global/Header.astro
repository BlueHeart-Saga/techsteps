---
import MobileDrawer from './MobileDrawer.astro';
import BrandLogo from './BrandLogo.astro';
import { getSiteSettings } from '../../lib/sanity/client';

const siteSettings = await getSiteSettings();

interface Props {
  isHome?: boolean;
  hideUntilScroll?: boolean;
  hasHeroHeader?: boolean;
}

const { isHome = false, hideUntilScroll = false, hasHeroHeader = false } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Services', url: '/services', hasDropdown: true, type: 'services' },
  { label: 'Sectors', url: '/sectors', hasDropdown: true, type: 'sectors' },
  { label: 'Insights', url: '/insights', hasDropdown: false },
  { label: 'About Us', url: '/about-us', hasDropdown: false },
  { label: 'Contact', url: '/contact', hasDropdown: false },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-[999] transition-all duration-500 pt-3 sm:pt-4 px-4 sm:px-6 lg:px-8 pointer-events-none -translate-y-full opacity-0"
  data-is-home={isHome ? 'true' : 'false'}
>
  <div class="max-w-[1240px] mx-auto">
    <!-- Floating Sharp Glass Container -->
    <div
      class="relative flex items-center justify-between h-16 sm:h-[72px] px-3.5 sm:px-6 bg-[#FAF6EE]/60 backdrop-blur-md rounded-none border border-black/10 shadow-[0_16px_40px_-10px_rgba(0,0,0,0.08)] transition-all duration-300"
      style="background-color: rgba(250, 246, 238, 0.60); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);"
    >
      
      <!-- Left: Logo inside dark sharp badge -->
      <div class="flex items-center">
        <a
          href="/"
          class="h-11 sm:h-12 flex items-center gap-3 bg-[#12181A] hover:bg-black text-white px-4 sm:px-5 rounded-none shadow-xs transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-emerald-500"
          aria-label="TechSteps UK Home"
        >
          <img
            src="/images/brand/logo.png"
            alt="TechSteps Logo"
            class="h-8 w-8 sm:h-9 sm:w-9 object-contain shrink-0"
            width="36"
            height="36"
            loading="eager"
            decoding="async"
          />
          <span class="font-display font-bold text-xl sm:text-[22px] tracking-wider text-white leading-none">TECHSTEPS</span>
        </a>
      </div>

      <!-- Right: Main Navigation Links (Services, Sectors, Insights, About Us, Contact) -->
      <nav class="hidden lg:flex items-center space-x-7 xl:space-x-9 text-slate-800 font-display font-semibold text-[20px] xl:text-[21px] tracking-wide" aria-label="Main Navigation">
        {navItems.map((item) => {
          if (item.type === 'services') {
            const isActive = currentPath.startsWith('/services') || currentPath === '/information-management' || currentPath === '/it-lifecycle-services-destruction' || currentPath === '/secure-shredding-document-integrity' || currentPath === '/moving-relocation-services';
            return (
              <div class="relative flex items-center nav-menu-trigger-wrap">
                <button
                  type="button"
                  id="services-menu-trigger"
                  class={`services-megamenu-toggle inline-flex items-center gap-1.5 py-1.5 px-1 transition-colors cursor-pointer focus:outline-none ${
                    isActive ? 'text-[#0F623A]' : 'text-slate-800 hover:text-[#0F623A]'
                  }`}
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="services-megamenu-panel"
                >
                  <span>{item.label}</span>
                  <svg class="h-4 w-4 text-slate-600 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              </div>
            );
          }

          if (item.type === 'sectors') {
            const isActive = currentPath.startsWith('/sectors');
            return (
              <div class="relative flex items-center nav-menu-trigger-wrap">
                <button
                  type="button"
                  id="sectors-menu-trigger"
                  class={`sectors-dropdown-toggle inline-flex items-center gap-1.5 py-1.5 px-1 transition-colors cursor-pointer focus:outline-none ${
                    isActive ? 'text-[#0F623A]' : 'text-slate-800 hover:text-[#0F623A]'
                  }`}
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="sectors-dropdown-panel"
                >
                  <span>{item.label}</span>
                  <svg class="h-4 w-4 text-slate-600 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              </div>
            );
          }

          const isActive = currentPath === item.url || (item.url !== '/' && currentPath.startsWith(item.url));
          return (
            <a
              href={item.url}
              class={`py-1.5 px-1 transition-colors ${
                isActive ? 'text-[#0F623A]' : 'text-slate-800 hover:text-[#0F623A]'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Menu Hamburger Button -->
      <div class="flex items-center lg:hidden">
        <button
          type="button"
          id="open-mobile-menu"
          class="open-mobile-menu-btn p-2 rounded-none text-slate-800 hover:text-black hover:bg-black/5 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors"
          aria-label="Open mobile navigation menu"
        >
          <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Component -->
  <MobileDrawer />
</header>

<script>
  function initScrollNavbar() {
    const header = document.getElementById('site-header');
    if (!header) return;

    // Show navbar once user scrolls past ~120px down the page
    const SCROLL_THRESHOLD = 120;

    const show = () => {
      header.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
      header.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
    };

    const hide = () => {
      header.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
      header.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
    };

    const onScroll = () => {
      if (window.scrollY > SCROLL_THRESHOLD) {
        show();
      } else {
        hide();
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    // Run once on load in case page is already scrolled
    onScroll();
  }

  initScrollNavbar();
  document.addEventListener('astro:page-load', initScrollNavbar);
</script>
