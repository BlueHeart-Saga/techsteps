---
import MobileDrawer from './MobileDrawer.astro';
import BrandLogo from './BrandLogo.astro';
import { getSiteSettings } from '../../lib/sanity/client';

const siteSettings = await getSiteSettings();

interface Props {
  isHome?: boolean;
  hideUntilScroll?: boolean;
  hasHeroHeader?: boolean;
}

const { isHome = false, hideUntilScroll = false, hasHeroHeader = false } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { label: 'Services', url: '/services', hasDropdown: true, type: 'services' },
  { label: 'Sectors', url: '/sectors', hasDropdown: true, type: 'sectors' },
  { label: 'Sustainability', url: '/sustainability', hasDropdown: false },
  { label: 'Insights', url: '/insights', hasDropdown: false },
  { label: 'About', url: '/about-us', hasDropdown: false },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-[999] transition-all duration-500 pt-3 sm:pt-4 px-4 sm:px-6 lg:px-8 pointer-events-none -translate-y-full opacity-0"
  data-is-home={isHome ? 'true' : 'false'}
>
  <div class="max-w-[1300px] mx-auto">
    <!-- Floating Glass Capsule Container -->
    <div class="relative flex items-center justify-between h-16 sm:h-18 px-4 sm:px-6 bg-white/80 backdrop-blur-2xl rounded-2xl border border-slate-200/60 shadow-[0_24px_64px_-12px_rgba(15,23,42,0.14)] transition-all duration-300">
      
      <!-- Left: Brand Logo -->
      <div class="flex items-center">
        <a
          href="/"
          class="h-10 sm:h-11 flex items-center bg-[#0F172A] hover:bg-black text-white px-4 rounded-xl shadow-xs transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-emerald-500 border border-white/10"
          aria-label="TechSteps UK Home"
        >
          <BrandLogo size="md" variant="light" showTagline={false} />
        </a>
      </div>

      <!-- Center: Restrained Top Navigation Bar -->
      <nav class="hidden lg:flex items-center space-x-7 xl:space-x-9 text-sm xl:text-[15px] font-sans font-semibold tracking-wide" aria-label="Main Navigation">
        {navItems.map((item) => {
          if (item.type === 'services') {
            const isActive = currentPath.startsWith('/services') || currentPath === '/information-management' || currentPath === '/it-lifecycle-services-destruction' || currentPath === '/secure-shredding-document-integrity' || currentPath === '/moving-relocation-services';
            return (
              <div class="relative flex items-center nav-menu-trigger-wrap">
                <button
                  type="button"
                  id="services-menu-trigger"
                  class={`services-megamenu-toggle inline-flex items-center gap-1.5 py-2 px-1 transition-colors cursor-pointer focus:outline-none ${
                    isActive ? 'text-[#0F623A] font-bold' : 'text-slate-700 hover:text-slate-950'
                  }`}
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="services-megamenu-panel"
                >
                  <span>{item.label}</span>
                  <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              </div>
            );
          }

          if (item.type === 'sectors') {
            const isActive = currentPath.startsWith('/sectors');
            return (
              <div class="relative flex items-center nav-menu-trigger-wrap">
                <button
                  type="button"
                  id="sectors-menu-trigger"
                  class={`sectors-dropdown-toggle inline-flex items-center gap-1.5 py-2 px-1 transition-colors cursor-pointer focus:outline-none ${
                    isActive ? 'text-[#0F623A] font-bold' : 'text-slate-700 hover:text-slate-950'
                  }`}
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="sectors-dropdown-panel"
                >
                  <span>{item.label}</span>
                  <svg class="h-3.5 w-3.5 text-slate-400 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </button>
              </div>
            );
          }

          const isActive = currentPath === item.url || (item.url !== '/' && currentPath.startsWith(item.url));
          return (
            <a
              href={item.url}
              class={`py-2 px-1 transition-colors ${
                isActive ? 'text-[#0F623A] font-bold' : 'text-slate-700 hover:text-slate-950'
              }`}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Right: Commercial Conversion CTAs & Mobile Hamburger -->
      <div class="flex items-center space-x-3">
        <!-- Desktop Commercial CTAs -->
        <div class="hidden sm:flex items-center space-x-2.5">
          <a
            href="/request-a-collection"
            class="px-4 py-2 rounded-xl border border-slate-300/90 text-slate-700 hover:text-slate-900 hover:bg-slate-100/80 text-xs sm:text-sm font-bold transition-all duration-200"
          >
            Request Collection
          </a>
          <a
            href="/request-a-quote"
            class="px-4 sm:px-5 py-2 sm:py-2.5 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-xs sm:text-sm font-bold shadow-md hover:shadow-lg transition-all duration-200"
          >
            Get Quote
          </a>
        </div>

        <!-- Mobile Menu Hamburger Button -->
        <div class="flex items-center lg:hidden">
          <button
            type="button"
            id="open-mobile-menu"
            class="open-mobile-menu-btn p-2 rounded-xl text-slate-700 hover:text-slate-950 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors"
            aria-label="Open mobile navigation menu"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Component -->
  <MobileDrawer />
</header>

<script>
  function initScrollNavbar() {
    const header = document.getElementById('site-header');
    if (!header) return;

    // Show navbar once user scrolls past ~80% of viewport height (hero section)
    const SCROLL_THRESHOLD = window.innerHeight * 0.75;

    const show = () => {
      header.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
      header.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
    };

    const hide = () => {
      header.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
      header.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
    };

    const onScroll = () => {
      if (window.scrollY > SCROLL_THRESHOLD) {
        show();
      } else {
        hide();
      }
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    // Run once on load in case page is already scrolled
    onScroll();
  }

  initScrollNavbar();
  document.addEventListener('astro:page-load', initScrollNavbar);
</script>
