---
import MobileDrawer from './MobileDrawer.astro';
import BrandLogo from './BrandLogo.astro';
import { getSiteSettings } from '../../lib/sanity/client';

const siteSettings = await getSiteSettings();

interface Props {
  isHome?: boolean;
  hideUntilScroll?: boolean;
  hasHeroHeader?: boolean;
}

const {
  isHome = false,
  hideUntilScroll = false,
  hasHeroHeader = false
} = Astro.props;

const currentPath = Astro.url.pathname;

const navItems = [
  {
    label: 'Services',
    url: '/services',
    hasDropdown: true,
    type: 'services'
  },
  {
    label: 'Sectors',
    url: '/sectors',
    hasDropdown: true,
    type: 'sectors'
  },
  {
    label: 'Insights',
    url: '/insights',
    hasDropdown: false
  },
  {
    label: 'About Us',
    url: '/about-us',
    hasDropdown: true,
    type: 'about'
  },
  {
    label: 'Contact',
    url: '/contact',
    hasDropdown: false
  },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-[999] transition-all duration-500 pt-3 sm:pt-4 px-4 sm:px-6 lg:px-8 pointer-events-none -translate-y-full opacity-0"
  data-is-home={isHome ? 'true' : 'false'}
>
  <div class="max-w-[1240px] mx-auto">

    <!-- =====================================================
         FLOATING SCROLLING NAVBAR
    ====================================================== -->

    <div
      class="relative flex items-center justify-between h-16 sm:h-[72px] px-3.5 sm:px-6 bg-[#FAF6EE]/60 backdrop-blur-md rounded-none border border-black/10 shadow-[0_16px_40px_-10px_rgba(0,0,0,0.08)] transition-all duration-300"
      style="background-color: rgba(250, 246, 238, 0.60); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);"
    >

      <!-- =====================================================
           LEFT: BRAND LOGO
      ====================================================== -->

      <div class="flex items-center">

        <a
          href="/"
          class="flex items-center focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded-lg py-1"
          aria-label="TechSteps UK Home"
        >
          <BrandLogo
            size="md"
            variant="dark"
            showTagline={false}
          />
        </a>

      </div>


      <!-- =====================================================
           MAIN NAVIGATION
      ====================================================== -->

      <nav
        class="hidden lg:flex items-center h-full space-x-7 xl:space-x-8 text-slate-800 font-sans font-medium text-[18px] tracking-[-0.01em]"
        aria-label="Main Navigation"
      >

        {navItems.map((item) => {

          /* ===================================================
             SERVICES
          =================================================== */

          if (item.type === 'services') {

            const isActive =
              currentPath.startsWith('/services') ||
              currentPath === '/information-management' ||
              currentPath === '/it-lifecycle-services-destruction' ||
              currentPath === '/secure-shredding-document-integrity' ||
              currentPath === '/moving-relocation-services';

            return (
              <div class="flex items-center">

                <!-- Services text navigates to Services page -->

                <a
                  href="/services"
                  class={`py-1.5 px-1 transition-colors ${
                    isActive
                      ? 'text-[#0F623A]'
                      : 'text-slate-800 hover:text-[#0F623A]'
                  }`}
                >
                  {item.label}
                </a>


                <!-- Arrow only opens dropdown -->

                <button
                  type="button"
                  id="services-menu-trigger"
                  class="services-megamenu-toggle inline-flex items-center justify-center p-1 transition-all duration-200 cursor-pointer focus:outline-none"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="services-megamenu-panel"
                  aria-label="Open Services menu"
                >
                  <svg
                    class="h-4 w-4 text-slate-600 transition-all duration-200 caret-icon shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </button>

              </div>
            );
          }


          /* ===================================================
             SECTORS
          =================================================== */

          if (item.type === 'sectors') {

            const isActive =
              currentPath.startsWith('/sectors');

            return (
              <div class="flex items-center">

                <!-- Sectors text navigates to Sectors page -->

                <a
                  href="/sectors"
                  class={`py-1.5 px-1 transition-colors ${
                    isActive
                      ? 'text-[#0F623A]'
                      : 'text-slate-800 hover:text-[#0F623A]'
                  }`}
                >
                  {item.label}
                </a>


                <!-- Arrow only opens dropdown -->

                <button
                  type="button"
                  id="sectors-menu-trigger"
                  class="sectors-dropdown-toggle inline-flex items-center justify-center p-1 transition-all duration-200 cursor-pointer focus:outline-none"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="sectors-dropdown-panel"
                  aria-label="Open Sectors menu"
                >
                  <svg
                    class="h-4 w-4 text-slate-600 transition-all duration-200 caret-icon shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </button>

              </div>
            );
          }


          /* ===================================================
             ABOUT US
          =================================================== */

          if (item.type === 'about') {

            const isActive =
              currentPath === '/about-us' ||
              currentPath.startsWith('/leadership') ||
              currentPath.startsWith('/people-culture') ||
              currentPath.startsWith('/our-people-culture') ||
              currentPath.startsWith('/global-presence');

            return (
              <div class="flex items-center relative">

                <!-- About Us text navigates to About Us page -->

                <a
                  href="/about-us"
                  class={`py-1.5 px-1 transition-colors ${
                    isActive
                      ? 'text-[#0F623A]'
                      : 'text-slate-800 hover:text-[#0F623A]'
                  }`}
                >
                  {item.label}
                </a>


                <!-- =================================================
                     ABOUT US ARROW
                ================================================== -->

                <button
                  type="button"
                  id="about-menu-trigger"
                  class="about-dropdown-toggle inline-flex items-center justify-center p-1 rounded-md transition-all duration-200 cursor-pointer focus:outline-none"
                  aria-expanded="false"
                  aria-haspopup="true"
                  aria-controls="about-dropdown-panel"
                  aria-label="Open About Us menu"
                >
                  <svg
                    class="h-4 w-4 text-slate-600 transition-all duration-200 about-caret caret-icon shrink-0"
                    fill="none"
                    viewBox="0 0 24 24"
                    stroke="currentColor"
                    stroke-width="2"
                  >
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M19 9l-7 7-7-7"
                    />
                  </svg>
                </button>


                <!-- =================================================
                     ABOUT US DROPDOWN

                     IMPORTANT:
                     Added extra vertical spacing so the dropdown
                     sits clearly below the scrolling navbar.
                ================================================== -->

<div
  id="about-dropdown-panel"
  class="about-dropdown-panel hidden absolute top-[calc(100%+30px)] right-0 min-w-[230px] rounded-xl z-[1000]"
>

                  <a
                    href="/about-us"
                    class="block px-5 py-3 text-sm text-slate-700 transition-colors"
                  >
                    About Us
                  </a>

                  <a
                    href="/leadership"
                    class="block px-5 py-3 text-sm text-slate-700 transition-colors"
                  >
                    Leadership
                  </a>

                  <a
                    href="/our-people-culture"
                    class="block px-5 py-3 text-sm text-slate-700 transition-colors"
                  >
                    Our People &amp; Culture
                  </a>

                  <a
                    href="/global-presence"
                    class="block px-5 py-3 text-sm text-slate-700 transition-colors"
                  >
                    Global Presence
                  </a>

                </div>

              </div>
            );
          }


          /* ===================================================
             NORMAL NAVIGATION ITEMS
          =================================================== */

          const isActive =
            currentPath === item.url ||
            (
              item.url !== '/' &&
              currentPath.startsWith(item.url)
            );

          return (
            <a
              href={item.url}
              class={`py-1.5 px-1 transition-colors ${
                isActive
                  ? 'text-[#0F623A]'
                  : 'text-slate-800 hover:text-[#0F623A]'
              }`}
            >
              {item.label}
            </a>
          );
        })}

      </nav>


      <!-- =====================================================
           MOBILE MENU HAMBURGER
      ====================================================== -->

      <div class="flex items-center lg:hidden">

        <button
          type="button"
          id="open-mobile-menu"
          class="open-mobile-menu-btn p-2 rounded-none text-slate-800 hover:text-black hover:bg-black/5 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors"
          aria-label="Open mobile navigation menu"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>

      </div>

    </div>
  </div>


  <!-- =====================================================
       MOBILE DRAWER
  ====================================================== -->

  <MobileDrawer />


  <!-- =====================================================
       ABOUT DROPDOWN SCRIPT
  ====================================================== -->

  <script>
    function setupAboutDropdown() {

      const trigger =
        document.getElementById('about-menu-trigger');

      const panel =
        document.getElementById('about-dropdown-panel');

      if (!trigger || !panel) return;


      /* ===================================================
         PREVENT DUPLICATE INITIALIZATION
      =================================================== */

      if (
        trigger.dataset.aboutReady === 'true'
      ) {
        return;
      }

      trigger.dataset.aboutReady = 'true';


      /* ===================================================
         CLOSE ABOUT DROPDOWN
      =================================================== */

      const closeAbout = () => {

        panel.classList.add('hidden');

        trigger.setAttribute(
          'aria-expanded',
          'false'
        );

        const icon =
          trigger.querySelector('.about-caret');

        icon?.classList.remove(
          'rotate-180'
        );

      };


      /* ===================================================
         OPEN ABOUT DROPDOWN
      =================================================== */

      const openAbout = () => {

        panel.classList.remove('hidden');

        trigger.setAttribute(
          'aria-expanded',
          'true'
        );

        const icon =
          trigger.querySelector('.about-caret');

        icon?.classList.add(
          'rotate-180'
        );

      };


      /* ===================================================
         ABOUT ARROW CLICK
      =================================================== */

      trigger.addEventListener(
        'click',
        (event) => {

          event.stopPropagation();

          const isOpen =
            trigger.getAttribute(
              'aria-expanded'
            ) === 'true';


          if (isOpen) {

            closeAbout();

          } else {

            /*
             * Close Services and Sectors first.
             * This guarantees only one dropdown
             * remains open at a time.
             */

            window.dispatchEvent(
              new CustomEvent(
                'techsteps:close-services'
              )
            );

            window.dispatchEvent(
              new CustomEvent(
                'techsteps:close-sectors'
              )
            );

            openAbout();

          }

        }
      );


      /* ===================================================
         CLOSE WHEN SERVICES OPENS
      =================================================== */

      window.addEventListener(
        'techsteps:close-about',
        closeAbout
      );


      /* ===================================================
         CLOSE WHEN CLICKING OUTSIDE
      =================================================== */

      document.addEventListener(
        'click',
        (event) => {

          const target =
            event.target as HTMLElement;


          /*
           * Do nothing when clicking the About
           * trigger itself.
           */

          if (
            target.closest(
              '#about-menu-trigger'
            )
          ) {
            return;
          }


          /*
           * Do nothing when clicking inside
           * the About dropdown.
           */

          if (
            target.closest(
              '#about-dropdown-panel'
            )
          ) {
            return;
          }


          /*
           * Everything else closes About.
           */

          closeAbout();

        }
      );


      /* ===================================================
         CLOSE WHEN CLICKING ABOUT LINKS
      =================================================== */

      panel.addEventListener(
        'click',
        () => {
          closeAbout();
        }
      );


      /* ===================================================
         ESCAPE KEY
      =================================================== */

      document.addEventListener(
        'keydown',
        (event) => {

          if (
            event.key === 'Escape'
          ) {

            closeAbout();

          }

        }
      );


      /* ===================================================
         EXPOSE CLOSE FUNCTION
         Useful for debugging / other scripts.
      =================================================== */

      (
        window as any
      ).__closeAboutDropdown =
        closeAbout;

    }


    /* =====================================================
       INITIAL SETUP
    ====================================================== */

    setupAboutDropdown();


    /* =====================================================
       ASTRO PAGE LOAD
    ====================================================== */

    document.addEventListener(
      'astro:page-load',
      () => {

        setupAboutDropdown();

      }
    );
  </script>


  <!-- =====================================================
       SCROLL NAVBAR
       Show when scrolling up / hide when scrolling down
  ====================================================== -->

  <script>
    function initScrollNavbar() {

      const header =
        document.getElementById('site-header');

      if (!header) return;


      const SCROLL_THRESHOLD = 120;

      const DIRECTION_THRESHOLD = 4;

      let lastScrollY =
        window.scrollY;

      let ticking = false;


      /* ===================================================
         SHOW
      =================================================== */

      const show = () => {

        header.classList.remove(
          '-translate-y-full',
          'opacity-0',
          'pointer-events-none'
        );

        header.classList.add(
          'translate-y-0',
          'opacity-100',
          'pointer-events-auto'
        );

      };


      /* ===================================================
         HIDE
      =================================================== */

      const hide = () => {

        header.classList.add(
          '-translate-y-full',
          'opacity-0',
          'pointer-events-none'
        );

        header.classList.remove(
          'translate-y-0',
          'opacity-100',
          'pointer-events-auto'
        );

      };


      /* ===================================================
         UPDATE NAVBAR
      =================================================== */

      const updateNavbar = () => {

        const currentScrollY =
          window.scrollY;

        const difference =
          currentScrollY -
          lastScrollY;


        /* =================================================
           AT TOP OF PAGE
        ================================================= */

        if (
          currentScrollY <=
          SCROLL_THRESHOLD
        ) {

          hide();

          lastScrollY =
            currentScrollY;

          ticking = false;

          return;
        }


        /* =================================================
           IGNORE VERY SMALL SCROLL MOVEMENTS
        ================================================= */

        if (
          Math.abs(difference) <
          DIRECTION_THRESHOLD
        ) {

          ticking = false;

          return;
        }


        /* =================================================
           SCROLLING DOWN
           → HIDE NAVBAR
        ================================================= */

        if (
          difference > 0
        ) {

          hide();

        }


        /* =================================================
           SCROLLING UP
           → SHOW NAVBAR
        ================================================= */

        else if (
          difference < 0
        ) {

          show();

        }


        lastScrollY =
          currentScrollY;

        ticking = false;

      };


      /* ===================================================
         SCROLL EVENT
      =================================================== */

      const onScroll = () => {

        if (!ticking) {

          window.requestAnimationFrame(
            updateNavbar
          );

          ticking = true;

        }

      };


      window.addEventListener(
        'scroll',
        onScroll,
        {
          passive: true
        }
      );


      /* ===================================================
         INITIAL STATE
      =================================================== */

      hide();

    }


    /* =====================================================
       INITIAL SETUP
    ====================================================== */

    initScrollNavbar();


    /* =====================================================
       ASTRO PAGE LOAD
    ====================================================== */

    document.addEventListener(
      'astro:page-load',
      () => {

        initScrollNavbar();

      }
    );
  </script>


  <!-- =====================================================
       DROPDOWN GLASS EFFECT
  ====================================================== -->

  <style>

    /* =====================================================
       EXACT SAME GLASS AS SCROLLING NAVBAR

       Navbar:
       background:
         rgba(250, 246, 238, 0.60)

       Navbar blur:
         12px

       Navbar border:
         rgba(0, 0, 0, 0.10)

       Navbar shadow:
         0 16px 40px -10px rgba(0,0,0,0.08)
    ====================================================== */

    :global(#services-megamenu-card.scroll-glass-active),
    :global(#sectors-dropdown-card.scroll-glass-active),
    #about-dropdown-panel {

      /* EXACT NAVBAR COLOR */

      background-color:
        rgba(250, 246, 238, 0.60) !important;


      /* EXACT NAVBAR GLASS BLUR */

      -webkit-backdrop-filter:
        blur(12px) !important;

      backdrop-filter:
        blur(12px) !important;


      /* EXACT NAVBAR BORDER */

      border:
        1px solid rgba(0, 0, 0, 0.10) !important;


      /* EXACT NAVBAR SHADOW */

      box-shadow:
        0 16px 40px -10px
        rgba(0, 0, 0, 0.08) !important;

    }


    /* =====================================================
       SERVICES DROPDOWN
    ====================================================== */

    #services-megamenu-panel {

      background-color:
        rgba(250, 246, 238, 0.60) !important;

      -webkit-backdrop-filter:
        blur(12px) !important;

      backdrop-filter:
        blur(12px) !important;

    }


    /* =====================================================
       SECTORS DROPDOWN
    ====================================================== */

    #sectors-dropdown-panel {

      background-color:
        rgba(250, 246, 238, 0.60) !important;

      -webkit-backdrop-filter:
        blur(12px) !important;

      backdrop-filter:
        blur(12px) !important;

    }


    /* =====================================================
       ABOUT DROPDOWN
    ====================================================== */

    #about-dropdown-panel {

      background-color:
        rgba(250, 246, 238, 0.60) !important;

      -webkit-backdrop-filter:
        blur(12px) !important;

      backdrop-filter:
        blur(12px) !important;


      border:
        1px solid rgba(0, 0, 0, 0.10) !important;


      box-shadow:
        0 16px 40px -10px
        rgba(0, 0, 0, 0.08) !important;

    }


    /* =====================================================
       ABOUT DROPDOWN ARROW
       NORMAL STATE
    ====================================================== */

    .about-dropdown-toggle {

      border-radius:
        6px;

      color:
        #475569;

      transition:
        color 0.2s ease,
        background-color 0.2s ease,
        transform 0.2s ease;

    }


    /* =====================================================
       ABOUT DROPDOWN ARROW HOVER
    ====================================================== */

    .about-dropdown-toggle:hover {

      color:
        #0F623A;

      background-color:
        rgba(255, 255, 255, 0.25);

    }


    .about-dropdown-toggle:hover
    .about-caret {

      color:
        #0F623A;

    }


    /* =====================================================
       ABOUT DROPDOWN ARROW OPEN STATE
    ====================================================== */

    .about-dropdown-toggle[aria-expanded="true"] {

      color:
        #0F623A;

      background-color:
        rgba(255, 255, 255, 0.25);

    }


    .about-dropdown-toggle[aria-expanded="true"]
    .about-caret {

      color:
        #0F623A;

    }


    /* =====================================================
       ABOUT DROPDOWN LINKS
    ====================================================== */

    #about-dropdown-panel a {

      color:
        #334155;

      transition:
        color 0.2s ease,
        background-color 0.2s ease;

    }


    #about-dropdown-panel a:hover {

      color:
        #0F623A;

      background-color:
        rgba(255, 255, 255, 0.20);

    }


    /* =====================================================
       SERVICES DROPDOWN LINKS
    ====================================================== */

    #services-megamenu-panel a {

      transition:
        color 0.2s ease,
        background-color 0.2s ease;

    }


    #services-megamenu-panel a:hover {

      background-color:
        rgba(255, 255, 255, 0.20);

    }


    /* =====================================================
       SECTORS DROPDOWN LINKS
    ====================================================== */

    #sectors-dropdown-panel a {

      transition:
        color 0.2s ease,
        background-color 0.2s ease;

    }


    #sectors-dropdown-panel a:hover {

      background-color:
        rgba(255, 255, 255, 0.20);

    }


    /* =====================================================
       DROPDOWN PANELS
       PREVENT SOLID CHILD BACKGROUNDS FROM HIDING GLASS
    ====================================================== */

    #services-megamenu-panel,
    #sectors-dropdown-panel,
    #about-dropdown-panel {

      isolation:
        isolate;

      overflow:
        hidden;

    }
/* About dropdown - blur entire page */
body:has(#about-dropdown-panel:not(.hidden))::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: 997;
  pointer-events: none;
  backdrop-filter: blur(7px);
  -webkit-backdrop-filter: blur(7px);
}
  </style>

</header>