---
import MegaMenu from './MegaMenu.astro';
import MobileDrawer from './MobileDrawer.astro';
import BrandLogo from './BrandLogo.astro';
import { getSiteSettings, getSectors } from '../../lib/sanity/client';

const [siteSettings, sectors] = await Promise.all([
  getSiteSettings(),
  getSectors(),
]);

interface Props {
  isHome?: boolean;
  hideUntilScroll?: boolean;
  hasHeroHeader?: boolean;
}

const { isHome = false, hideUntilScroll = false, hasHeroHeader = false } = Astro.props;
const shouldHide = isHome || hideUntilScroll || hasHeroHeader;
const currentPath = Astro.url.pathname;

const rawNav = siteSettings.mainNav || [];
const navOrder = ['services', 'sectors', 'insights', 'about us', 'contact'];
const navItems = [...rawNav].sort((a, b) => {
  const idxA = navOrder.indexOf(a.label?.toLowerCase() || '');
  const idxB = navOrder.indexOf(b.label?.toLowerCase() || '');
  return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
});
---

<header
  id="site-header"
  class:list={[
    'fixed top-0 inset-x-0 z-[9999] transition-all duration-300 pt-3 sm:pt-4 px-3 sm:px-6 lg:px-8 pointer-events-auto',
    shouldHide
      ? '-translate-y-full opacity-0 pointer-events-none'
      : 'translate-y-0 opacity-100',
  ]}
  data-is-home={isHome ? 'true' : 'false'}
  data-hide-until-scroll={shouldHide ? 'true' : 'false'}
>
  <div class="max-w-7xl mx-auto">
    <!-- Premium Floating Glassic Capsule Container with Sharp Edges -->
    <div class="relative flex items-center justify-between h-16 sm:h-18 px-3.5 sm:px-6 bg-white/80 backdrop-blur-2xl backdrop-saturate-200 rounded-none border border-white/70 shadow-[0_10px_35px_0_rgba(15,23,42,0.12)] hover:shadow-[0_14px_45px_0_rgba(15,23,42,0.18)] hover:bg-white/90 hover:border-white transition-all duration-300">
      
      <!-- Left: Brand Badge Capsule with Sharp Edges -->
      <div class="flex items-center">
        <a
          href="/"
          class="h-11 sm:h-12 flex items-center bg-[#12181A] hover:bg-black text-white px-4 sm:px-5 rounded-none shadow-md transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-emerald-400 border border-white/10"
          aria-label="TechSteps UK Home"
        >
          <BrandLogo size="md" variant="light" showTagline={false} />
        </a>
      </div>

      <!-- Right: Navigation Glassic Links with Bottom Border Hover -->
      <div class="flex items-center space-x-1 sm:space-x-2">
        <nav class="hidden lg:flex items-center space-x-6 xl:space-x-8 text-[19px] xl:text-[21px] font-display capitalize tracking-wide" aria-label="Main Navigation">
          {navItems.map((navItem) => {
            const isServices = navItem.label.toLowerCase() === 'services' || navItem.url === '/services';
            const isSectors = navItem.label.toLowerCase() === 'sectors' || navItem.url === '/sectors';

            if (isServices) {
              return (
                <div class="relative flex items-center group">
                  <a
                    href={navItem.url || '/services'}
                    class={`services-megamenu-toggle inline-flex items-center gap-1.5 py-1.5 px-1 border-b-2 bg-transparent transition-all duration-150 cursor-pointer focus:outline-none ${
                      currentPath.startsWith('/services') || currentPath === '/information-management' || currentPath === '/it-lifecycle-services-destruction' || currentPath === '/secure-shredding-document-integrity' || currentPath === '/moving-relocation-services'
                        ? 'border-slate-900 text-slate-950 font-bold'
                        : 'border-transparent text-slate-700 hover:text-slate-950 hover:border-slate-800 font-bold'
                    }`}
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls="services-megamenu-panel"
                    data-is-active-route={currentPath.startsWith('/services') || currentPath === '/information-management' || currentPath === '/it-lifecycle-services-destruction' || currentPath === '/secure-shredding-document-integrity' || currentPath === '/moving-relocation-services' ? 'true' : 'false'}
                  >
                    <span>{navItem.label}</span>
                    <svg class="h-3.5 w-3.5 text-slate-500 group-hover:text-slate-800 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </a>
                </div>
              );
            }

            if (isSectors) {
              return (
                <div class="relative sectors-trigger-wrap flex items-center group">
                  <a
                    href={navItem.url || '/sectors'}
                    class={`sectors-dropdown-toggle inline-flex items-center gap-1.5 py-1.5 px-1 border-b-2 bg-transparent transition-all duration-150 cursor-pointer focus:outline-none ${
                      currentPath.startsWith('/sectors')
                        ? 'border-slate-900 text-slate-950 font-bold'
                        : 'border-transparent text-slate-700 hover:text-slate-950 hover:border-slate-800 font-bold'
                    }`}
                    aria-expanded="false"
                    aria-haspopup="true"
                    aria-controls="sectors-dropdown-panel"
                    data-is-active-route={currentPath.startsWith('/sectors') ? 'true' : 'false'}
                  >
                    <span>{navItem.label}</span>
                    <svg class="h-3.5 w-3.5 text-slate-500 group-hover:text-slate-800 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                    </svg>
                  </a>
                </div>
              );
            }

            const isActive = currentPath === navItem.url || (navItem.url !== '/' && currentPath.startsWith(navItem.url || ''));
            return (
              <a
                href={navItem.url}
                target={navItem.openInNewTab ? '_blank' : undefined}
                rel={navItem.openInNewTab ? 'noopener noreferrer' : undefined}
                class={`py-1.5 px-1 border-b-2 bg-transparent transition-all duration-150 ${
                  isActive
                    ? 'border-slate-900 text-slate-950 font-bold'
                    : 'border-transparent text-slate-700 hover:text-slate-950 hover:border-slate-800 font-bold'
                }`}
              >
                {navItem.label}
              </a>
            );
          })}
        </nav>

        <!-- Mobile Trigger -->
        <div class="flex items-center lg:hidden">
          <button
            type="button"
            id="open-mobile-menu"
            class="open-mobile-menu-btn p-2.5 rounded-none text-slate-700 hover:text-black hover:bg-slate-100/80 focus:outline-none focus:ring-2 focus:ring-emerald-400 transition-colors"
            aria-label="Open mobile navigation menu"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Drawer Component -->
  <MobileDrawer />
</header>

<script>
  function setupHeader() {
    const header = document.getElementById('site-header');
    if (!header) return;

    if (header.dataset.hideUntilScroll === 'true') {
      const onScroll = () => {
        if (window.scrollY > 120) {
          header.classList.remove('-translate-y-full', 'opacity-0', 'pointer-events-none');
          header.classList.add('translate-y-0', 'opacity-100', 'pointer-events-auto');
        } else {
          header.classList.add('-translate-y-full', 'opacity-0', 'pointer-events-none');
          header.classList.remove('translate-y-0', 'opacity-100', 'pointer-events-auto');
        }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();
    }
  }

  setupHeader();
  document.addEventListener('astro:page-load', setupHeader);
</script>
