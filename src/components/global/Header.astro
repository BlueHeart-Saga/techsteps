---
import MobileDrawer from './MobileDrawer.astro';
import BrandLogo from './BrandLogo.astro';
import { getSiteSettings } from '../../lib/sanity/client';

const siteSettings = await getSiteSettings();

interface Props {
  isHome?: boolean;
  hideUntilScroll?: boolean;
  hasHeroHeader?: boolean;
}

const {
  isHome = false,
  hideUntilScroll = false,
  hasHeroHeader = false
} = Astro.props;

const currentPath = Astro.url.pathname;

const navItems = [
  {
    label: 'Free Collection',
    url: '/services/collection',
    hasDropdown: true,
    type: 'free-collection'
  },
  {
    label: 'Services',
    url: '/services',
    hasDropdown: true,
    type: 'services'
  },
  {
    label: 'Sectors',
    url: '/sectors',
    hasDropdown: true,
    type: 'sectors'
  },
  {
    label: 'Insights',
    url: '/insights',
    hasDropdown: false
  },
  {
    label: 'About Us',
    url: '/about-us',
    hasDropdown: true,
    type: 'about'
  },
  {
    label: 'Contact Us',
    url: '/contact',
    hasDropdown: false
  },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-[999] pointer-events-none -translate-y-full opacity-0 pt-3 sm:pt-4 px-3 sm:px-6 transition-all duration-300 ease-in-out"
  data-is-home={isHome ? 'true' : 'false'}
>
  <div class="max-w-[1240px] mx-auto">

    <!-- =====================================================
         FLOATING SCROLLING NAVBAR
    ====================================================== -->

    <div
      class="relative flex items-center justify-between h-16 sm:h-[72px] px-3.5 sm:px-6 bg-[#FAF6EE]/88 backdrop-blur-md rounded-[16px] border border-black/10 shadow-[0_16px_40px_-10px_rgba(0,0,0,0.10)] transition-all duration-300"
      style="background-color: rgba(250, 246, 238, 0.88); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);"
    >

      <!-- =====================================================
           LEFT: BRAND LOGO
      ====================================================== -->

      <div class="flex items-center">

        <a
          href="/"
          class="flex items-center focus:outline-none focus:ring-2 focus:ring-emerald-500 rounded-lg py-1"
          aria-label="TechSteps UK Home"
        >
          <BrandLogo
            size="md"
            variant="dark"
            showTagline={false}
          />
        </a>

      </div>


      <!-- =====================================================
           MAIN NAVIGATION
      ====================================================== -->

      <nav
        class="hidden lg:flex items-center h-full space-x-7 xl:space-x-8 text-slate-800 font-sans font-medium text-[18px] tracking-[-0.01em]"
        aria-label="Main Navigation"
      >

        {navItems.map((item) => {
          /* SERVICES */
          if (item.type === 'services') {
            const isCollection =
              currentPath.startsWith('/services/collection') ||
              currentPath === '/av-media-equipment-collection' ||
              currentPath === '/computer-collection' ||
              currentPath === '/laptop-collection' ||
              currentPath === '/mobile-device-collection' ||
              currentPath === '/monitor-screen-collection' ||
              currentPath === '/printer-copier-collection' ||
              currentPath === '/server-collection';

            const isActive =
              (!isCollection && currentPath.startsWith('/services')) ||
              currentPath === '/information-management' ||
              currentPath === '/it-lifecycle-services-destruction' ||
              currentPath === '/secure-shredding-document-integrity' ||
              currentPath === '/moving-relocation-services';

            return (
              <a
                href="javascript:void(0)"
                id="services-menu-trigger"
                data-route-active={isActive ? "true" : "false"}
                class={`nav-link services-megamenu-toggle py-1.5 px-0 transition-colors cursor-pointer focus:outline-none ${
                  isActive ? 'active' : ''
                }`}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="services-megamenu-panel"
                role="button"
              >
                {item.label}
              </a>
            );
          }

          /* FREE COLLECTION */
          if (item.type === 'free-collection') {
            const isActive =
              currentPath.startsWith('/services/collection') ||
              currentPath.startsWith('/collection') ||
              currentPath === '/book-pickup' ||
              currentPath === '/av-media-equipment-collection' ||
              currentPath === '/computer-collection' ||
              currentPath === '/laptop-collection' ||
              currentPath === '/mobile-device-collection' ||
              currentPath === '/monitor-screen-collection' ||
              currentPath === '/printer-copier-collection' ||
              currentPath === '/server-collection';

            return (
              <a
                href="javascript:void(0)"
                id="free-collection-menu-trigger"
                data-route-active={isActive ? "true" : "false"}
                class={`nav-link free-collection-megamenu-toggle py-1.5 px-0 transition-colors cursor-pointer focus:outline-none whitespace-nowrap ${
                  isActive ? 'active' : ''
                }`}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="free-collection-megamenu-panel"
                role="button"
              >
                {item.label}
              </a>
            );
          }

          /* SECTORS */
          if (item.type === 'sectors') {
            const isActive = currentPath.startsWith('/sectors');
            return (
              <a
                href="javascript:void(0)"
                id="sectors-menu-trigger"
                data-route-active={isActive ? "true" : "false"}
                class={`nav-link sectors-dropdown-toggle py-1.5 px-0 transition-colors cursor-pointer focus:outline-none ${
                  isActive ? 'active' : ''
                }`}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="sectors-dropdown-panel"
                role="button"
              >
                {item.label}
              </a>
            );
          }

          /* ABOUT US */
          if (item.type === 'about') {
            const isActive =
              currentPath === '/about-us' ||
              currentPath.startsWith('/leadership') ||
              currentPath.startsWith('/our-commitment') ||
              currentPath.startsWith('/our-people-culture') ||
              currentPath.startsWith('/global-presence') ||
              currentPath.startsWith('/sustainability') ||
              currentPath.startsWith('/certifications') ||
              currentPath.startsWith('/partners');

            return (
              <a
                href="javascript:void(0)"
                id="about-menu-trigger"
                data-route-active={isActive ? "true" : "false"}
                class={`nav-link about-megamenu-toggle py-1.5 px-0 transition-colors cursor-pointer focus:outline-none ${
                  isActive ? 'active' : ''
                }`}
                aria-expanded="false"
                aria-haspopup="true"
                aria-controls="about-megamenu-panel"
                role="button"
              >
                {item.label}
              </a>
            );
          }

          /* NORMAL ITEMS: INSIGHTS, CONTACT US */
          const isActive =
            currentPath === item.url ||
            (item.url !== '/' && currentPath.startsWith(item.url));

          return (
            <a
              href={item.url}
              class={`nav-link py-1.5 px-0 transition-colors focus:outline-none ${
                isActive ? 'active' : ''
              }`}
            >
              {item.label}
            </a>
          );
        })}

      </nav>


      <!-- =====================================================
           RIGHT: REQUEST A COLLECTION BUTTON + MOBILE MENU
      ====================================================== -->

      <div class="flex items-center gap-2.5 sm:gap-3 shrink-0">

        <!-- Request a Collection CTA -->
        <a
          href={siteSettings.headerRequestButtonLink || "/request-a-quote"}
          class="hidden sm:inline-flex items-center justify-center h-[42px] px-5 sm:px-6 rounded-[10px] bg-[#07572F] hover:bg-[#054324] text-white font-sans text-[14.5px] sm:text-[15px] font-semibold tracking-tight transition-all duration-150 shadow-xs hover:shadow-sm whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-[#07572F] focus-visible:ring-offset-2"
        >
          {siteSettings.headerRequestButtonText || "Request a Collection"}
        </a>

        <!-- Hamburger for mobile -->
        <button
          type="button"
          id="open-mobile-menu"
          class="open-mobile-menu-btn lg:hidden p-2 rounded-[12px] text-slate-800 hover:text-black hover:bg-black/5 focus:outline-none focus:ring-2 focus:ring-emerald-500 transition-colors"
          aria-label="Open mobile navigation menu"
        >
          <svg
            class="h-6 w-6"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"
            />
          </svg>
        </button>

      </div>

    </div>
  </div>


  <!-- =====================================================
       MOBILE DRAWER
  ====================================================== -->

  <MobileDrawer />





  <!-- =====================================================
       SCROLL NAVBAR
       Show when scrolling up / hide when scrolling down
  ====================================================== -->

  <script>
    function initScrollNavbar() {
      const header = document.getElementById('site-header');
      if (!header) return;

      const SCROLL_THRESHOLD = 140;
      const DIRECTION_THRESHOLD = 5;

      let lastScrollY = Math.max(0, window.scrollY);
      let ticking = false;

      /* ===================================================
         SHOW
      =================================================== */
      const show = () => {
        header.classList.remove(
          '-translate-y-full',
          'opacity-0',
          'pointer-events-none'
        );
        header.classList.add(
          'translate-y-0',
          'opacity-100',
          'pointer-events-auto'
        );
      };

      /* ===================================================
         HIDE
      =================================================== */
      const hide = () => {
        header.classList.add(
          '-translate-y-full',
          'opacity-0',
          'pointer-events-none'
        );
        header.classList.remove(
          'translate-y-0',
          'opacity-100',
          'pointer-events-auto'
        );
      };

      /* ===================================================
         UPDATE NAVBAR
      =================================================== */
      const updateNavbar = () => {
        const currentScrollY = Math.max(0, window.scrollY);
        const difference = currentScrollY - lastScrollY;

        /* AT TOP OF PAGE (Near Hero / TopBar) */
        if (currentScrollY <= SCROLL_THRESHOLD) {
          hide();
          lastScrollY = currentScrollY;
          ticking = false;
          return;
        }

        /* IGNORE VERY SMALL MOVEMENTS */
        if (Math.abs(difference) < DIRECTION_THRESHOLD) {
          ticking = false;
          return;
        }

        /* SCROLLING DOWN → HIDE NAVBAR */
        if (difference > 0) {
          hide();
        }
        /* SCROLLING UP → POPUP / SHOW NAVBAR */
        else if (difference < 0) {
          show();
        }

        lastScrollY = currentScrollY;
        ticking = false;
      };

      /* ===================================================
         SCROLL EVENT
      =================================================== */
      const onScroll = () => {
        if (!ticking) {
          window.requestAnimationFrame(updateNavbar);
          ticking = true;
        }
      };

      /* Clean up previous listener to prevent duplicate handlers across Astro page transitions */
      if ((window as any).__scrollNavbarHandler) {
        window.removeEventListener('scroll', (window as any).__scrollNavbarHandler);
      }
      (window as any).__scrollNavbarHandler = onScroll;
      window.addEventListener('scroll', onScroll, { passive: true });

      /* INITIAL STATE */
      hide();
    }

    /* INITIAL SETUP */
    initScrollNavbar();

    /* ASTRO PAGE LOAD */
    document.addEventListener('astro:page-load', () => {
      initScrollNavbar();
    });
  </script>


  <!-- =====================================================
       DROPDOWN GLASS EFFECT
  ====================================================== -->

  <style>

    /* =====================================================
       EXACT SAME GLASS AS SCROLLING NAVBAR

       Navbar:
       background:
         rgba(250, 246, 238, 0.60)

       Navbar blur:
         12px

       Navbar border:
         rgba(0, 0, 0, 0.10)

       Navbar shadow:
         0 16px 40px -10px rgba(0,0,0,0.08)
    ====================================================== */

    :global(#services-megamenu-card.scroll-glass-active),
    :global(#sectors-dropdown-card.scroll-glass-active),
    :global(#about-megamenu-card.scroll-glass-active) {

      /* EXACT NAVBAR COLOR */
      background-color:
        rgba(250, 246, 238, 0.60) !important;

      /* EXACT NAVBAR GLASS BLUR */
      -webkit-backdrop-filter:
        blur(12px) !important;
      backdrop-filter:
        blur(12px) !important;

      /* EXACT NAVBAR BORDER */
      border:
        1px solid rgba(0, 0, 0, 0.10) !important;

      /* EXACT NAVBAR SHADOW */
      box-shadow:
        0 16px 40px -10px
        rgba(0, 0, 0, 0.08) !important;
    }

    /* =====================================================
       SERVICES DROPDOWN
    ====================================================== */
    #services-megamenu-panel {
      background-color:
        rgba(250, 246, 238, 0.60) !important;
      -webkit-backdrop-filter:
        blur(12px) !important;
      backdrop-filter:
        blur(12px) !important;
    }

    /* =====================================================
       SECTORS DROPDOWN
    ====================================================== */
    #sectors-dropdown-panel {
      background-color:
        rgba(250, 246, 238, 0.60) !important;
      -webkit-backdrop-filter:
        blur(12px) !important;
      backdrop-filter:
        blur(12px) !important;
    }

    /* =====================================================
       ABOUT DROPDOWN
    ====================================================== */
    #about-megamenu-panel {
      background-color:
        rgba(250, 246, 238, 0.60) !important;
      -webkit-backdrop-filter:
        blur(12px) !important;
      backdrop-filter:
        blur(12px) !important;
    }

    /* =====================================================
       DROPDOWN PANELS
       PREVENT SOLID CHILD BACKGROUNDS FROM HIDING GLASS
    ====================================================== */
    #services-megamenu-panel,
    #sectors-dropdown-panel,
    #about-megamenu-panel {
      isolation:
        isolate;
      overflow:
        hidden;
    }
  </style>

</header>