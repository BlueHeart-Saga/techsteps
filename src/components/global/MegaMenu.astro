---
import { getDivisions, getServices, getSectors } from '../../lib/sanity/client';
import BrandLogo from './BrandLogo.astro';

const [divisions, services, sectors] = await Promise.all([
  getDivisions(),
  getServices(),
  getSectors(),
]);

interface Props {
  id?: string;
}

const { id = 'services-megamenu' } = Astro.props;
---

<div id={id} class="megamenu-dropdown hidden fixed inset-0 z-50 overflow-y-auto bg-brand-navy p-4 sm:p-8 lg:p-12" role="dialog" aria-modal="true" aria-label="Site navigation">
  <div class="relative min-h-full overflow-hidden rounded-2xl border border-white/15 bg-brand-slate shadow-2xl">
    <div class="absolute inset-x-0 bottom-0 h-[42%] bg-[radial-gradient(ellipse_at_15%_100%,rgba(20,107,92,.45),transparent_46%),radial-gradient(ellipse_at_90%_100%,rgba(71,86,77,.52),transparent_42%)]"></div>
    <div class="relative z-10 flex min-h-full flex-col p-6 sm:p-10 lg:p-14">
      <div class="flex items-center justify-between border-b border-brand-border pb-6">
        <a href="/" class="flex items-center gap-4 focus:outline-none focus:ring-2 focus:ring-brand-accent rounded-lg" aria-label="TechSteps UK Home">
          <BrandLogo size="sm" variant="dark" showTagline={false} />
          <span class="hidden sm:inline font-mono text-[10px] uppercase tracking-[0.14em] text-brand-muted border-l border-brand-border pl-4">Secure lifecycle partner</span>
        </a>
        <button id="close-megamenu" type="button" class="inline-flex items-center gap-2 text-sm font-bold text-brand-navy hover:text-brand-accent" aria-label="Close navigation menu">
          <span>Close</span>
          <span class="flex h-9 w-9 items-center justify-center rounded-full border border-brand-border text-xl leading-none">&times;</span>
        </button>
      </div>

      <div class="grid grid-cols-1 gap-10 py-10 lg:grid-cols-12 lg:gap-12">
        <div class="lg:col-span-4">
          <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-brand-accent">Navigate Techsteps</p>
          <h2 class="mt-3 max-w-sm text-4xl leading-[.95] text-brand-navy sm:text-5xl">Every asset. Every record. Every outcome.</h2>
          <div class="mt-8 flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold">
            <a href="/request-a-quote" class="text-brand-accent hover:text-brand-accent-hover">Request a quote &rarr;</a>
            <a href="/contact" class="text-brand-blue hover:text-brand-accent">Contact our team &rarr;</a>
          </div>
        </div>

        <div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:col-span-8 lg:grid-cols-3">
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-brand-muted">Company</p>
            <div class="mt-4 flex flex-col gap-3 text-lg">
              <a href="/" class="text-brand-navy hover:text-brand-accent">Home</a>
              <a href="/about-us" class="text-brand-navy hover:text-brand-accent">About us</a>
              <a href="/sustainability" class="text-brand-navy hover:text-brand-accent">Sustainability</a>
              <a href="/insights" class="text-brand-navy hover:text-brand-accent">Insights</a>
              <a href="/investors" class="text-brand-navy hover:text-brand-accent">Investors</a>
            </div>
          </div>
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-brand-muted">Our divisions</p>
            <div class="mt-4 flex flex-col gap-3">
              {divisions.map((div) => (
                <a href={`/${div.slug}`} class="text-lg leading-tight text-brand-navy hover:text-brand-accent">{div.title}</a>
              ))}
            </div>
          </div>
          <div>
            <p class="font-mono text-[11px] uppercase tracking-[0.14em] text-brand-muted">Sectors</p>
            <div class="mt-4 flex flex-col gap-3">
              {sectors.map((sector) => (
                <a href={`/sectors/${sector.slug}`} class="text-lg text-brand-navy hover:text-brand-accent">{sector.title}</a>
              ))}
              <a href="/services" class="mt-2 font-mono text-xs uppercase tracking-[.08em] text-brand-accent hover:text-brand-accent-hover">All services &rarr;</a>
            </div>
          </div>
        </div>
      </div>

      <div class="relative mt-auto grid gap-5 border-t border-brand-border pt-6 text-sm text-brand-blue sm:flex sm:items-center sm:justify-between">
        <span>UK-wide secure collections, processing and reporting.</span>
        <a href="tel:+442079460888" class="font-mono text-xs text-brand-navy hover:text-brand-accent">+44 (0) 20 7946 0888</a>
      </div>
    </div>
  </div>
</div>

<!-- Retained service mapping for search engines and future service-specific navigation. -->
<div class="hidden">
  {divisions.map((div) => {
    const divServices = services.filter((s) => s.divisionSlug === div.slug).slice(0, 5);
    return (
      <div>
      {divisions.map((div) => {
        const divServices = services.filter((s) => s.divisionSlug === div.slug).slice(0, 5);
        return (
          <div class="space-y-4">
            <div class="border-b border-slate-100 pb-3">
              <a
                href={`/${div.slug}`}
                class="group flex items-center justify-between text-base font-bold text-brand-navy hover:text-brand-accent transition-colors"
              >
                <span>{div.title}</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-brand-accent transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
              <p class="text-xs text-slate-500 mt-1 line-clamp-2">{div.headline}</p>
            </div>

            <ul class="space-y-2.5">
              {divServices.map((srv) => (
                <li>
                  <a
                    href={`/services/${srv.slug}`}
                    class="text-sm font-medium text-slate-600 hover:text-brand-accent transition-colors block py-0.5"
                  >
                    {srv.title}
                  </a>
                </li>
              ))}
            </ul>

            <div class="pt-2">
              <a
                href={`/${div.slug}`}
                class="text-xs font-semibold text-brand-blue hover:text-brand-accent flex items-center gap-1 group"
              >
                <span>View all {div.title} services</span>
                <span class="transition-transform group-hover:translate-x-0.5">→</span>
              </a>
            </div>
          </div>
        );
      })}
      </div>
    );
  })}
</div>
