---
import BrandLogo from './BrandLogo.astro';

const currentPath = Astro.url.pathname;
---

<div
  id="mobile-menu-drawer"
  class="fixed inset-0 z-[9999] transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden"
  aria-hidden="true"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile Navigation Menu"
>
  <!-- Glass Backdrop -->
  <div id="mobile-menu-backdrop" class="fixed inset-0 bg-slate-950/60 backdrop-blur-md opacity-0 transition-opacity duration-300"></div>

  <!-- Drawer Panel -->
  <div class="fixed inset-y-0 right-0 w-full max-w-sm bg-white shadow-2xl flex flex-col justify-between overflow-y-auto border-l border-slate-200">
    
    <!-- Drawer Header -->
    <div class="p-5 border-b border-slate-200/80 flex items-center justify-between bg-slate-50">
      <a href="/" class="flex items-center" aria-label="TechSteps UK Home">
        <BrandLogo size="sm" variant="dark" showTagline={false} />
      </a>
      <button
        type="button"
        id="close-mobile-menu"
        class="p-2 rounded-xl text-slate-500 hover:text-slate-900 hover:bg-slate-200/70 focus:outline-none transition-colors"
        aria-label="Close navigation menu"
      >
        <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <!-- Accordion Navigation Body -->
    <div class="p-5 space-y-3 flex-1 overflow-y-auto">
      
      <!-- 1. Services Accordion -->
      <div class="border-b border-slate-200/80 pb-3">
        <button
          type="button"
          class="mobile-accordion-btn w-full flex items-center justify-between py-2.5 text-base font-bold text-slate-900 hover:text-[#0F623A] transition-colors"
          aria-expanded="false"
        >
          <span>Services</span>
          <svg class="w-4 h-4 text-slate-400 transition-transform duration-200 accordion-caret" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="mobile-accordion-content hidden space-y-2.5 pl-3 pt-2 text-sm">
          <a href="/information-management" class="block font-semibold text-slate-800 hover:text-[#0F623A]">
            Information Management
          </a>
          <a href="/it-lifecycle-services-destruction" class="block font-semibold text-slate-800 hover:text-[#0F623A]">
            IT Lifecycle & Destruction
          </a>
          <a href="/secure-shredding-document-integrity" class="block font-semibold text-slate-800 hover:text-[#0F623A]">
            Secure Shredding
          </a>
          <a href="/moving-relocation-services" class="block font-semibold text-slate-800 hover:text-[#0F623A]">
            Moving & Relocation
          </a>
          <a href="/services" class="block pt-1.5 font-bold text-[#0F623A] hover:underline">
            View all 27 certified services &rarr;
          </a>
        </div>
      </div>

      <!-- 2. Sectors Accordion -->
      <div class="border-b border-slate-200/80 pb-3">
        <button
          type="button"
          class="mobile-accordion-btn w-full flex items-center justify-between py-2.5 text-base font-bold text-slate-900 hover:text-[#0F623A] transition-colors"
          aria-expanded="false"
        >
          <span>Sectors</span>
          <svg class="w-4 h-4 text-slate-400 transition-transform duration-200 accordion-caret" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <div class="mobile-accordion-content hidden space-y-2 pl-3 pt-2 text-xs sm:text-sm">
          <a href="/sectors/nhs" class="block font-medium text-slate-700 hover:text-[#0F623A]">NHS & Healthcare</a>
          <a href="/sectors/finance" class="block font-medium text-slate-700 hover:text-[#0F623A]">Financial Services</a>
          <a href="/sectors/central-government" class="block font-medium text-slate-700 hover:text-[#0F623A]">Central Government</a>
          <a href="/sectors/defence" class="block font-medium text-slate-700 hover:text-[#0F623A]">Defence & Aerospace</a>
          <a href="/sectors/legal-professional-services" class="block font-medium text-slate-700 hover:text-[#0F623A]">Corporate & Legal</a>
          <a href="/sectors/education-universities" class="block font-medium text-slate-700 hover:text-[#0F623A]">Education & Universities</a>
          <a href="/sectors/manufacturing-engineering" class="block font-medium text-slate-700 hover:text-[#0F623A]">Manufacturing & Engineering</a>
          <a href="/sectors/it-technology" class="block font-medium text-slate-700 hover:text-[#0F623A]">IT & Technology</a>
          <a href="/sectors" class="block pt-1.5 font-bold text-[#0F623A] hover:underline">Explore all sectors &rarr;</a>
        </div>
      </div>

      <!-- 3. Sustainability Link -->
      <a href="/sustainability" class="block py-2.5 text-base font-bold text-slate-900 hover:text-[#0F623A] border-b border-slate-200/80">
        Sustainability
      </a>

      <!-- 4. Insights Link -->
      <a href="/insights" class="block py-2.5 text-base font-bold text-slate-900 hover:text-[#0F623A] border-b border-slate-200/80">
        Insights
      </a>

      <!-- 5. About Link -->
      <a href="/about-us" class="block py-2.5 text-base font-bold text-slate-900 hover:text-[#0F623A]">
        About
      </a>
    </div>

    <!-- Commercial Action Footer -->
    <div class="p-5 border-t border-slate-200 space-y-3 bg-slate-50">
      <a
        href="/request-a-collection"
        class="block w-full py-3 text-center rounded-xl border border-slate-300 text-slate-800 text-sm font-bold hover:bg-slate-200/60 transition-colors"
      >
        Request a Collection
      </a>
      <a
        href="/request-a-quote"
        class="block w-full py-3 text-center rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm font-bold shadow-md transition-colors"
      >
        Get a Quote
      </a>
    </div>

  </div>
</div>

<script>
  function setupMobileDrawer() {
    const drawer = document.getElementById('mobile-menu-drawer');
    const backdrop = document.getElementById('mobile-menu-backdrop');
    const openBtns = document.querySelectorAll('.open-mobile-menu-btn');
    const closeBtn = document.getElementById('close-mobile-menu');

    if (!drawer || !backdrop) return;

    const openDrawer = () => {
      drawer.classList.remove('translate-x-full');
      drawer.classList.add('translate-x-0');
      backdrop.classList.remove('opacity-0');
      backdrop.classList.add('opacity-100');
      document.body.style.overflow = 'hidden';
    };

    const closeDrawer = () => {
      drawer.classList.remove('translate-x-0');
      drawer.classList.add('translate-x-full');
      backdrop.classList.remove('opacity-100');
      backdrop.classList.add('opacity-0');
      document.body.style.overflow = '';
    };

    openBtns.forEach((btn) => btn.addEventListener('click', openDrawer));
    if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
    backdrop.addEventListener('click', closeDrawer);

    // Accordions
    const accordionBtns = drawer.querySelectorAll('.mobile-accordion-btn');
    accordionBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const content = btn.nextElementSibling;
        const caret = btn.querySelector('.accordion-caret');
        const isExpanded = btn.getAttribute('aria-expanded') === 'true';

        if (isExpanded) {
          btn.setAttribute('aria-expanded', 'false');
          content?.classList.add('hidden');
          caret?.classList.remove('rotate-180');
        } else {
          btn.setAttribute('aria-expanded', 'true');
          content?.classList.remove('hidden');
          caret?.classList.add('rotate-180');
        }
      });
    });
  }

  setupMobileDrawer();
  document.addEventListener('astro:page-load', setupMobileDrawer);
</script>
