---
import Container from '../layout/Container.astro';
import { getHomePage } from '../../lib/sanity/client';

interface Props {
  eyebrow?: string;
  title?: string;
  heading?: string;
  description?: string;
  primaryText?: string;
  primaryHref?: string;
  primaryButtonText?: string;
  primaryButtonLink?: string;
  secondaryText?: string;
  secondaryHref?: string;
  secondaryButtonText?: string;
  secondaryButtonLink?: string;
  className?: string;
}

const {
  eyebrow,
  title,
  heading,
  description,
  primaryText,
  primaryHref,
  primaryButtonText,
  primaryButtonLink,
  secondaryText,
  secondaryHref,
  secondaryButtonText,
  secondaryButtonLink,
  className = "",
} = Astro.props;

// Fetch Sanity CTA if available as default
let sanityCta: any = null;
try {
  const homeData = await getHomePage();
  sanityCta = homeData?.cta;
} catch {
  // Graceful fallback to static defaults
}

// Default reference values if props are not explicitly provided
const defaultTitle = sanityCta?.heading || "Let’s Find The Right Solution for Your Business.";
const defaultDescription = sanityCta?.description || "Partner with TechSteps to manage your IT assets securely, responsibly, and sustainably.";
const defaultPrimaryText = sanityCta?.primaryButtonText || "Schedule Asset Pickup";
const defaultPrimaryHref = sanityCta?.primaryButtonLink || "/request-a-collection";
const defaultSecondaryText = sanityCta?.secondaryButtonText || "Explore Services";
const defaultSecondaryHref = sanityCta?.secondaryButtonLink || "/services";

const resolvedTitle = title || heading || defaultTitle;
const resolvedDescription = description || defaultDescription;
const resolvedPrimaryText = primaryText || primaryButtonText || defaultPrimaryText;
const resolvedPrimaryHref = primaryHref || primaryButtonLink || defaultPrimaryHref;
const resolvedSecondaryText = secondaryText || secondaryButtonText || defaultSecondaryText;
const resolvedSecondaryHref = secondaryHref || secondaryButtonLink || defaultSecondaryHref;
---

<section class={`common-cta-section relative bg-white pt-24 sm:pt-32 lg:pt-40 pb-12 sm:pb-16 lg:pb-20 overflow-visible ${className}`}>
  <Container size="wide" className="relative">
    
    <!-- Deep Green CTA Container (#0F623A) -->
    <div class="relative bg-[#0F623A] rounded-[24px] shadow-[0_20px_50px_rgba(15,98,58,0.22)] min-h-[260px] sm:min-h-[270px] md:min-h-[280px] lg:min-h-[300px] xl:min-h-[310px] overflow-visible">
      
      <!-- Background Clipped Layer: Subtle depth + Oversized Recycling Watermark on far right -->
      <div class="absolute inset-0 rounded-[24px] overflow-hidden pointer-events-none select-none" aria-hidden="true">
        <!-- Subtle gradient overlay -->
        <div class="absolute inset-0 bg-gradient-to-br from-[#136b41]/40 via-transparent to-[#09351e]/50"></div>
        
        <!-- Soft ambient glow -->
        <div class="absolute right-10 top-1/2 -translate-y-1/2 w-96 h-96 bg-[#3FB33D]/10 rounded-full blur-3xl"></div>
        
        <!-- Oversized subtle recycling watermark graphic on far right (matching reference) -->
        <img
          src="/images/brand/cta-watermark-alpha.png"
          alt=""
          aria-hidden="true"
          class="absolute right-0 bottom-0 h-full w-auto max-w-[42%] object-contain object-right-bottom opacity-80 pointer-events-none select-none hidden sm:block"
        />
      </div>

      <!-- Main Content Grid -->
      <div class="relative z-10 grid grid-cols-1 md:grid-cols-12 items-center min-h-[260px] sm:min-h-[270px] md:min-h-[280px] lg:min-h-[300px] xl:min-h-[310px]">
        
        <!-- Left: Female TechSteps Worker Cutout (Extending naturally above/outside container) -->
<div class="md:col-span-4 lg:col-span-4 xl:col-span-4 relative flex justify-center md:justify-start pointer-events-none self-end h-full">          <div class="relative w-full flex justify-center md:justify-start h-full">
<img
  src="/images/brand/cta.webp"
  alt="TechSteps certified IT recycling technician with asset collection bin"
  class="relative z-20 w-auto object-contain object-bottom select-none
         -mt-16 sm:-mt-24
         md:mt-0 md:absolute md:bottom-0
         md:left-2 lg:left-4 xl:left-6
h-[320px] sm:h-[390px]
md:h-[135%] lg:h-[140%] xl:h-[145%]
max-h-[430px] md:max-h-[420px] lg:max-h-[440px] xl:max-h-[460px]
         drop-shadow-[0_15px_30px_rgba(0,0,0,0.35)]"
  loading="lazy"
  decoding="async"
  width="1053"
  height="1473"
/>
          </div>
        </div>

        <!-- Right: Text & Actions Column -->
<div class="md:col-span-8 lg:col-span-8 xl:col-span-8 pt-4 pb-7 sm:pb-8 md:py-8 lg:py-9 xl:py-10 px-6 sm:px-10 md:pl-2 lg:pl-4 md:pr-8 lg:pr-12 xl:pr-16 text-center md:text-left">          
          <!-- Optional Eyebrow -->
          {eyebrow && (
            <div class="mb-3.5 flex items-center justify-center md:justify-start gap-2.5">
              <span class="h-px w-6 bg-[#3FB33D]/80"></span>
              <span class="text-xs font-bold uppercase tracking-[0.2em] text-[#72D96F] font-mono">
                {eyebrow}
              </span>
              <span class="h-px w-6 bg-[#3FB33D]/80"></span>
            </div>
          )}

          <!-- Heading -->
          <h2 class="text-2xl sm:text-3xl lg:text-[38px] xl:text-[44px] font-semibold text-white tracking-tight leading-[1.14] font-display">
            {resolvedTitle === defaultTitle ? (
              <span>
                Let’s Find The<br class="hidden sm:inline" /> Right Solution for Your Business.
              </span>
            ) : (
              <span>{resolvedTitle}</span>
            )}
          </h2>

          <!-- Supporting Paragraph -->
          {/*<p class="mt-3.5 sm:mt-4 text-sm sm:text-base xl:text-[18px] text-white/90 leading-relaxed font-normal max-w-xl mx-auto md:mx-0">
            {resolvedDescription}
          </p>*/}

          <!-- Buttons -->
          <div class="mt-7 sm:mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center md:justify-start gap-3 sm:gap-4">
            
            <!-- Primary Button (White bg, Dark Green text, Truck icon) -->
            <a
              href={resolvedPrimaryHref}
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3.5 rounded-[12px] bg-white hover:bg-slate-100 text-[#0F623A] font-semibold text-sm sm:text-base shadow-sm hover:shadow-md transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#0F623A]"
            >
              <svg
                class="w-5 h-5 shrink-0 text-[#0F623A]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2" />
                <path d="M14 8h4.5a1.5 1.5 0 0 1 1.2.6L22 12v5a1 1 0 0 1-1 1h-2" />
                <circle cx="7" cy="18" r="2" />
                <circle cx="17" cy="18" r="2" />
              </svg>
              <span>{resolvedPrimaryText}</span>
            </a>

            <!-- Secondary Button (Translucent dark green bg, White text, Arrow icon) -->
            <a
              href={resolvedSecondaryHref}
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3.5 rounded-[12px] bg-[#245239]/85 hover:bg-[#2b6043] text-white font-semibold text-sm sm:text-base border border-white/10 hover:border-white/20 transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#0F623A] group"
            >
              <span>{resolvedSecondaryText}</span>
              <svg
                class="w-4 h-4 text-white shrink-0 transition-transform duration-200 group-hover:translate-x-1"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.2"
                aria-hidden="true"
              >
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

          </div>

        </div>

      </div>

    </div>

  </Container>
</section>