---
interface Props {
  eyebrow?: string;
  title?: string;
  description?: string;
  primaryText?: string;
  primaryHref?: string;
  secondaryText?: string;
  secondaryHref?: string;
}

const {
  eyebrow = 'LET’S WORK TOGETHER',
  title = 'Ready to take the next step?',
  description = 'From secure IT asset management to responsible recovery and lifecycle services, TechSteps helps organisations manage technology with confidence.',
  primaryText = 'Request a Collection',
  primaryHref = '/request-a-collection',
  secondaryText = 'Contact Our Team',
  secondaryHref = '/contact',
} = Astro.props;
---

<section class="relative overflow-hidden bg-[#0F623A] py-16 sm:py-20 lg:py-24">
  <!-- Background decorative elements -->
  <div
    class="pointer-events-none absolute -right-32 -top-32 h-80 w-80 rounded-full border-[60px] border-[#3FB33D]/10"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute -bottom-40 -left-24 h-96 w-96 rounded-full border-[70px] border-white/[0.04]"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute right-[12%] bottom-10 h-3 w-3 rounded-full bg-[#3FB33D]/50"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute right-[18%] bottom-20 h-2 w-2 rounded-full bg-white/20"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto w-full max-w-7xl px-5 sm:px-6 lg:px-8">
    <div
      class="relative overflow-hidden rounded-[2rem] border border-white/10 bg-white/[0.04] px-6 py-10 shadow-[0_25px_80px_rgba(0,0,0,0.18)] backdrop-blur-sm sm:px-10 sm:py-12 lg:px-16 lg:py-14"
    >
      <!-- Decorative glow -->
      <div
        class="pointer-events-none absolute -right-20 -top-20 h-64 w-64 rounded-full bg-[#3FB33D]/10 blur-3xl"
        aria-hidden="true"
      ></div>

      <div
        class="pointer-events-none absolute -bottom-24 left-1/3 h-56 w-56 rounded-full bg-white/[0.03] blur-3xl"
        aria-hidden="true"
      ></div>

      <div
        class="relative z-10 flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between lg:gap-12"
      >
        <!-- Content -->
        <div class="max-w-3xl">
          <div class="mb-4 flex items-center gap-3">
            <span class="h-px w-8 bg-[#3FB33D]"></span>

            <span
              class="text-xs font-bold uppercase tracking-[0.2em] text-[#72D96F]"
            >
              {eyebrow}
            </span>

            <span class="h-px w-8 bg-[#3FB33D]"></span>
          </div>

          <h2
            class="max-w-3xl text-3xl font-bold leading-[1.08] tracking-tight text-white sm:text-4xl lg:text-5xl"
          >
            {title}
          </h2>

          <p
            class="mt-5 max-w-2xl text-sm leading-7 text-white/70 sm:text-base sm:leading-8"
          >
            {description}
          </p>
        </div>

        <!-- Actions -->
        <div
          class="relative z-10 flex shrink-0 flex-col gap-3 sm:flex-row lg:flex-col xl:flex-row"
        >
          <a
            href={primaryHref}
            class="group inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[#3FB33D] px-6 py-3 text-sm font-bold text-[#0F623A] shadow-lg shadow-black/10 transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#4ACF46] hover:shadow-xl focus:outline-none focus:ring-2 focus:ring-[#3FB33D] focus:ring-offset-2 focus:ring-offset-[#0F623A]"
          >
            <span>{primaryText}</span>

            <svg
              class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 10h11M10.5 5.5 15 10l-4.5 4.5"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>

          <a
            href={secondaryHref}
            class="inline-flex min-h-12 items-center justify-center rounded-full border border-white/30 bg-white/[0.04] px-6 py-3 text-sm font-bold text-white transition-all duration-300 hover:-translate-y-0.5 hover:border-white/60 hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#0F623A]"
          >
            {secondaryText}
          </a>
        </div>
      </div>

      <!-- Bottom accent -->
      <div
        class="absolute bottom-0 left-0 h-1 w-full bg-gradient-to-r from-transparent via-[#3FB33D] to-transparent opacity-70"
        aria-hidden="true"
      ></div>
    </div>
  </div>
</section>