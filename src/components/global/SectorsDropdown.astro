---
// Sectors dropdown items matching reference image:
// 3 columns:
// Column 1: NHS & Healthcare, Defence & Aerospace, Manufacturing & Engineering
// Column 2: Financial Services, Corporate & Legal, IT & Technology
// Column 3: Central Government, Education & Universities
const column1 = [
  { title: 'NHS & Healthcare', slug: 'nhs', icon: '/icons/NHS%20&%20Healthcare.svg', active: true },
  { title: 'Defence & Aerospace', slug: 'defence', icon: '/icons/Defence%20&%20Aerospace.svg' },
  { title: 'Manufacturing & Engineering', slug: 'manufacturing-engineering', icon: '/icons/Manufacturing%20&%20Engineering.svg' },
];

const column2 = [
  { title: 'Financial Services', slug: 'finance', icon: '/icons/Financial%20Services.svg' },
  { title: 'Corporate & Legal', slug: 'legal-professional-services', icon: '/icons/Corporate%20&%20Legal.svg' },
  { title: 'IT & Technology', slug: 'it-technology', icon: '/icons/IT%20&%20Technology.svg' },
];

const column3 = [
  { title: 'Central Government', slug: 'central-government', icon: '/icons/Central%20Government.svg' },
  { title: 'Education & Universities', slug: 'education-universities', icon: '/icons/Education%20&%20Universities.svg' },
];
---

<!-- Sectors Dropdown Panel -->
<div
  id="sectors-dropdown-panel"
  class="fixed top-[82px] inset-x-0 z-[998] hidden opacity-0 -translate-y-2 transition-all duration-200 pointer-events-none before:absolute before:-top-6 before:inset-x-0 before:h-6 before:content-['']"
  role="region"
  aria-label="Sectors Menu"
>
  <div id="sectors-dropdown-wrapper" class="w-full flex justify-center px-4 sm:px-6">
    <div
      id="sectors-dropdown-card"
      class="sectors-dropdown-card bg-white rounded-[12px] border border-slate-200/80 shadow-[0_16px_48px_rgba(0,0,0,0.08)] pointer-events-auto p-4 sm:p-5 flex items-stretch w-[1408px] max-w-[1408px] min-h-[322px] box-border"
    >
      <!-- LEFT: Industries We Serve Section (3 Columns) -->
      <div class="flex-1 flex flex-col pt-6 pb-5 pl-2 sm:pl-3 pr-4 sm:pr-8">
        <!-- Section Heading -->
        <h3 class="sectors-heading text-[#5A6874] mb-6">
          Industries We Serve
        </h3>

        <!-- 3-Column Grid matching reference image -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-x-6 xl:gap-x-12 gap-y-2.5">
          <!-- Column 1 -->
          <div class="flex flex-col space-y-2.5">
            {column1.map((item) => (
              <a
                href={`/sectors/${item.slug}`}
                class={`sector-link group flex items-center gap-3.5 px-3.5 py-2.5 rounded-[8px] transition-all duration-150 cursor-pointer ${
                  item.active
                    ? 'active-sector bg-[#BCE6CE] text-[#0F172A]'
                    : 'text-[#1E293B] hover:bg-[#E0F2E7]'
                }`}
              >
                <!-- Icon -->
                <span class="shrink-0 flex items-center justify-center w-5 h-5">
                  <img
                    src={item.icon}
                    alt=""
                    class="w-5 h-5 object-contain"
                    width="20"
                    height="20"
                  />
                </span>
                <span class="sector-label leading-snug">{item.title}</span>
              </a>
            ))}
          </div>

          <!-- Column 2 -->
          <div class="flex flex-col space-y-2.5">
            {column2.map((item) => (
              <a
                href={`/sectors/${item.slug}`}
                class="sector-link group flex items-center gap-3.5 px-3.5 py-2.5 rounded-[8px] transition-all duration-150 cursor-pointer text-[#1E293B] hover:bg-[#E0F2E7]"
              >
                <!-- Icon -->
                <span class="shrink-0 flex items-center justify-center w-5 h-5">
                  <img
                    src={item.icon}
                    alt=""
                    class="w-5 h-5 object-contain"
                    width="20"
                    height="20"
                  />
                </span>
                <span class="sector-label leading-snug">{item.title}</span>
              </a>
            ))}
          </div>

          <!-- Column 3 -->
          <div class="flex flex-col space-y-2.5">
            {column3.map((item) => (
              <a
                href={`/sectors/${item.slug}`}
                class="sector-link group flex items-center gap-3.5 px-3.5 py-2.5 rounded-[8px] transition-all duration-150 cursor-pointer text-[#1E293B] hover:bg-[#E0F2E7]"
              >
                <!-- Icon -->
                <span class="shrink-0 flex items-center justify-center w-5 h-5">
                  <img
                    src={item.icon}
                    alt=""
                    class="w-5 h-5 object-contain"
                    width="20"
                    height="20"
                  />
                </span>
                <span class="sector-label leading-snug">{item.title}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- RIGHT: Investors Section matching reference image -->
      <div class="sectors-right-col w-[250px] shrink-0 pt-6 pb-[13px] pr-2 flex flex-col ml-8 xl:ml-12">
        <h3 class="sectors-right-heading text-[#5A6874] mb-5">Investors</h3>
        <!-- Image link -->
        <a href="/investors" class="group block shrink-0">
          <div
            class="rounded-xl overflow-hidden shadow-xs border border-slate-200/60 bg-slate-100"
            style="width: 248px; height: 164.96px;"
          >
            <img
              src="/images/brand/nav-sectors.webp"
              alt="Investors"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
              width="248"
              height="165"
            />
          </div>
        </a>
        <!-- Visit ↗ link -->
        <a
          href="/investors"
          class="investors-link mt-[36px] inline-flex items-center gap-1.5 font-['Inter',sans-serif] text-[16px] font-semibold text-[#171717] hover:text-[#07572F] transition-colors group"
        >
          <span>Visit</span>
          <span class="font-bold transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  /* Container Dimensions & Specifications matching reference */
  #sectors-dropdown-panel .sectors-dropdown-card {
    width: 1408px;
    max-width: 1408px;
    height: 322px;
    min-height: 322px;
    max-height: 322px;
    border-radius: 12px;
    box-sizing: border-box;
    padding: 8px;
  }

  /* Headings typography: Lora 500, 16px */
  #sectors-dropdown-panel .sectors-heading,
  #sectors-dropdown-panel .sectors-right-heading {
    font-family: 'Lora', Georgia, serif;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  /* Sector items typography & layout */
  #sectors-dropdown-panel .sector-link {
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.45;
    text-decoration: none;
  }

  /* Hover & Active States */
  #sectors-dropdown-panel .sector-link.active-sector {
    background-color: #BCE6CE;
    color: #0F172A;
  }

  #sectors-dropdown-panel .sector-link:not(.active-sector):hover {
    background-color: #E0F2E7;
    color: #0F172A;
  }

  /* Visit link typography */
  #sectors-dropdown-panel .investors-link {
    font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.5;
  }

  @media (max-width: 1440px) {
    #sectors-dropdown-panel .sectors-dropdown-card {
      width: calc(100vw - 32px);
      max-width: 1408px;
    }
  }

  @media (max-width: 1024px) {
    #sectors-dropdown-panel .sectors-dropdown-card {
      height: auto;
      min-height: 0;
      max-height: none;
      flex-direction: column;
    }

    #sectors-dropdown-panel .sectors-right-col {
      margin-left: 0;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid #f1f5f9;
      width: 100%;
    }
  }
</style>

<script>
  function setupSectorsMegaMenu() {
    const triggers = document.querySelectorAll('#sectors-menu-trigger, .sectors-dropdown-toggle');
    const panel = document.getElementById('sectors-dropdown-panel');
    if (!panel || triggers.length === 0) return;

    let timeoutId: any = null;

    const sectorLinks = panel.querySelectorAll<HTMLElement>('.sector-link');

    // Hover effect dynamically switches the green active background
    sectorLinks.forEach((link) => {
      link.addEventListener('mouseenter', () => {
        sectorLinks.forEach((l) => {
          l.classList.remove('active-sector', 'bg-[#BCE6CE]');
        });
        link.classList.add('active-sector', 'bg-[#BCE6CE]');
      });
    });

    const updatePosition = () => {
      const siteHeader = document.getElementById('site-header');
      const heroHeader = document.getElementById('hero-header');
      const card = document.getElementById('sectors-dropdown-card');
      const wrapper = document.getElementById('sectors-dropdown-wrapper');

      const isScrollNavActive =
        siteHeader &&
        !siteHeader.classList.contains('opacity-0') &&
        !siteHeader.classList.contains('-translate-y-full');

      if (isScrollNavActive && siteHeader) {
        const maxWrap = siteHeader.querySelector<HTMLElement>(':scope > div');
        const floatingBar = maxWrap?.querySelector<HTMLElement>(':scope > div');
        const ref = floatingBar ?? siteHeader;
        const rect = ref.getBoundingClientRect();

        panel.style.top = `${Math.round(rect.bottom + 8)}px`;
        panel.style.left = `${Math.round(rect.left)}px`;
        panel.style.right = 'auto';
        panel.style.width = `${Math.round(rect.width)}px`;

        if (wrapper) {
          wrapper.classList.add('scroll-dropdown-wrapper');
        }

        if (card) {
          card.style.width = `${Math.round(rect.width)}px`;
          card.style.maxWidth = `${Math.round(rect.width)}px`;
        }
      } else if (heroHeader) {
        const rect = heroHeader.getBoundingClientRect();

        panel.style.top = `${Math.round(rect.bottom + 8)}px`;
        panel.style.left = '';
        panel.style.right = '';
        panel.style.width = '';

        if (card) {
          card.style.width = '';
          card.style.maxWidth = '';
        }

        if (wrapper) {
          wrapper.classList.remove('scroll-dropdown-wrapper');
        }
      }
    };

    const openMenu = () => {
      clearTimeout(timeoutId);
      updatePosition();

      // Close Services mega menu if open
      const servicesPanel = document.getElementById('services-megamenu-panel');
      const servicesTriggers = document.querySelectorAll('#services-menu-trigger, .services-megamenu-toggle');
      if (servicesPanel) {
        servicesPanel.classList.add('hidden', 'opacity-0', '-translate-y-2', 'pointer-events-none');
        servicesPanel.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      }
      servicesTriggers.forEach((t) => {
        t.setAttribute('aria-expanded', 'false');
        const caret = t.querySelector('.caret-icon');
        if (caret) caret.classList.remove('rotate-180');
      });

      panel.classList.remove('hidden');
      requestAnimationFrame(() => {
        updatePosition();
        panel.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
        panel.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        triggers.forEach((t) => {
          t.setAttribute('aria-expanded', 'true');
          const caret = t.querySelector('.caret-icon');
          if (caret) caret.classList.add('rotate-180');
        });
      });
    };

    const closeMenu = () => {
      timeoutId = setTimeout(() => {
        panel.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        panel.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
        triggers.forEach((t) => {
          t.setAttribute('aria-expanded', 'false');
          const caret = t.querySelector('.caret-icon');
          if (caret) caret.classList.remove('rotate-180');
        });
        setTimeout(() => {
          if (panel.classList.contains('opacity-0')) panel.classList.add('hidden');
        }, 200);
      }, 200);
    };

    triggers.forEach((t) => {
      t.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        const isExpanded = t.getAttribute('aria-expanded') === 'true';
        if (isExpanded) closeMenu();
        else openMenu();
      });
      t.addEventListener('mouseenter', openMenu);
      t.addEventListener('mouseleave', closeMenu);
    });

    panel.addEventListener('mouseenter', () => clearTimeout(timeoutId));
    panel.addEventListener('mouseleave', closeMenu);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu();
    });
    document.addEventListener('click', (e) => {
      let inside = false;
      triggers.forEach((t) => {
        if (t.contains(e.target as Node)) inside = true;
      });
      if (!panel.contains(e.target as Node) && !inside) closeMenu();
    });

    window.addEventListener('resize', updatePosition, { passive: true });
    window.addEventListener('scroll', updatePosition, { passive: true });
  }

  setupSectorsMegaMenu();
  document.addEventListener('astro:page-load', setupSectorsMegaMenu);
</script>
