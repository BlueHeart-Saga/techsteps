---
/**
 * SectorsDropdown.astro
 * Balanced 3-column + 26% featured card mega menu for "Industries We Serve"
 * Organised into 3 balanced columns (3-3-2 layout) with concise display labels
 * and aligned in the same premium style as the About Us dropdown.
 */

import { getSectors } from '../../lib/sanity/client';

const sanitySectors = await getSectors().catch(() => []);
const currentPath = Astro.url.pathname;

// Shorter, elegant display titles to prevent awkward wrapping, with underlying slugs
const column1 = [
  {
    title: 'NHS & Healthcare',
    slug: 'nhs',
    href: '/sectors/nhs',
    icon: '/icons/NHS%20&%20Healthcare.svg',
    active: currentPath === '/sectors/nhs' || currentPath === '/sectors/nhs/',
  },
  {
    title: 'Defence & Aerospace',
    slug: 'defence',
    href: '/sectors/defence',
    icon: '/icons/Defence%20&%20Aerospace.svg',
    active: currentPath === '/sectors/defence' || currentPath === '/sectors/defence/',
  },
  {
    title: 'Manufacturing & Engineering',
    slug: 'manufacturing-engineering',
    href: '/sectors/manufacturing-engineering',
    icon: '/icons/Manufacturing%20&%20Engineering.svg',
    active: currentPath === '/sectors/manufacturing-engineering' || currentPath === '/sectors/manufacturing-engineering/',
  },
];

const column2 = [
  {
    title: 'Financial Services',
    slug: 'finance',
    href: '/sectors/finance',
    icon: '/icons/Financial%20Services.svg',
    active: currentPath === '/sectors/finance' || currentPath === '/sectors/finance/',
  },
  {
    title: 'Corporate & Legal',
    slug: 'legal-professional-services',
    href: '/sectors/legal-professional-services',
    icon: '/icons/Corporate%20&%20Legal.svg',
    active: currentPath === '/sectors/legal-professional-services' || currentPath === '/sectors/legal-professional-services/',
  },
  {
    title: 'IT & Technology',
    slug: 'it-technology',
    href: '/sectors/it-technology',
    icon: '/icons/IT%20&%20Technology.svg',
    active: currentPath === '/sectors/it-technology' || currentPath === '/sectors/it-technology/',
  },
];

const column3 = [
  {
    title: 'Government & Public Sector',
    slug: 'central-government',
    href: '/sectors/central-government',
    icon: '/icons/Central%20Government.svg',
    active: currentPath === '/sectors/central-government' || currentPath === '/sectors/central-government/',
  },
  {
    title: 'Education & Universities',
    slug: 'education-universities',
    href: '/sectors/education-universities',
    icon: '/icons/Education%20&%20Universities.svg',
    active: currentPath === '/sectors/education-universities' || currentPath === '/sectors/education-universities/',
  },
];

const enrichTitle = (slug: string, fallback: string) => {
  const match = sanitySectors.find((s: any) => s.slug === slug);
  return match?.title || fallback;
};

const processedColumn1 = column1.map(item => ({ ...item, title: enrichTitle(item.slug, item.title) }));
const processedColumn2 = column2.map(item => ({ ...item, title: enrichTitle(item.slug, item.title) }));
const processedColumn3 = column3.map(item => ({ ...item, title: enrichTitle(item.slug, item.title) }));

const hasActive =
  processedColumn1.some((item) => item.active) ||
  processedColumn2.some((item) => item.active) ||
  processedColumn3.some((item) => item.active);

if (!hasActive) {
  processedColumn1[0].active = true;
}
---

<!-- =========================================================
     SECTORS DROPDOWN PANEL
========================================================= -->
<div
  id="sectors-dropdown-panel"
  class="fixed top-[82px] inset-x-0 z-[998] hidden opacity-0 -translate-y-1 transition-[opacity,transform] duration-150 ease-out pointer-events-none before:absolute before:-top-10 before:inset-x-0 before:h-10 before:content-['']"
  role="region"
  aria-label="Sectors Menu"
>
  <div
    id="sectors-dropdown-wrapper"
    class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
  >
    <div
      id="sectors-dropdown-card"
      class="sectors-dropdown-card bg-white rounded-[20px] border border-slate-200/80 shadow-[0_20px_50px_rgba(0,0,0,0.08)] pointer-events-auto p-6 sm:p-7 lg:p-8 flex flex-col lg:flex-row items-stretch justify-between gap-8 xl:gap-10 w-full box-border"
    >

      <!-- =====================================================
           LEFT: NAVIGATION AREA (~74%)
      ====================================================== -->
      <div class="flex-1 w-full flex flex-col min-w-0">
        <!-- Main Section Header -->
        <div class="mb-4 pb-2.5 border-b border-slate-100 flex items-center justify-between">
          <div>
            <h3 class="sectors-heading text-xs font-bold uppercase tracking-wider text-[#5A6874]">
              Industries We Serve
            </h3>
            <p class="text-[12px] text-slate-500 font-normal mt-0.5">
              Explore our sector expertise
            </p>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 xl:gap-8 flex-1">
          <!-- Column 1 -->
          <div class="sectors-menu-column flex flex-col space-y-1.5">
            {processedColumn1.map((item) => (
              <a
                href={item.href}
                class={`sector-link group flex items-center gap-3 px-3 py-2.5 rounded-[12px] transition-all duration-150 cursor-pointer min-h-[46px] ${
                  item.active
                    ? 'active-sector bg-[#BCE6CE] text-[#0F172A] font-semibold'
                    : 'text-[#101E2C] hover:bg-[#E0F2E7]'
                }`}
              >
                <span class="shrink-0 flex items-center justify-center w-5 h-5">
                  <img
                    src={item.icon}
                    alt=""
                    class="w-5 h-5 object-contain"
                    width="20"
                    height="20"
                  />
                </span>
                <span class="sector-label text-[15px] leading-snug whitespace-nowrap">
                  {item.title}
                </span>
              </a>
            ))}
          </div>

          <!-- Column 2 -->
          <div class="sectors-menu-column flex flex-col space-y-1.5">
            {processedColumn2.map((item) => (
              <a
                href={item.href}
                class={`sector-link group flex items-center gap-3 px-3 py-2.5 rounded-[12px] transition-all duration-150 cursor-pointer min-h-[46px] ${
                  item.active
                    ? 'active-sector bg-[#BCE6CE] text-[#0F172A] font-semibold'
                    : 'text-[#101E2C] hover:bg-[#E0F2E7]'
                }`}
              >
                <span class="shrink-0 flex items-center justify-center w-5 h-5">
                  <img
                    src={item.icon}
                    alt=""
                    class="w-5 h-5 object-contain"
                    width="20"
                    height="20"
                  />
                </span>
                <span class="sector-label text-[15px] leading-snug whitespace-nowrap">
                  {item.title}
                </span>
              </a>
            ))}
          </div>

          <!-- Column 3 -->
          <div class="sectors-menu-column flex flex-col space-y-1.5">
            {processedColumn3.map((item) => (
              <a
                href={item.href}
                class={`sector-link group flex items-center gap-3 px-3 py-2.5 rounded-[12px] transition-all duration-150 cursor-pointer min-h-[46px] ${
                  item.active
                    ? 'active-sector bg-[#BCE6CE] text-[#0F172A] font-semibold'
                    : 'text-[#101E2C] hover:bg-[#E0F2E7]'
                }`}
              >
                <span class="shrink-0 flex items-center justify-center w-5 h-5">
                  <img
                    src={item.icon}
                    alt=""
                    class="w-5 h-5 object-contain"
                    width="20"
                    height="20"
                  />
                </span>
                <span class="sector-label text-[15px] leading-snug whitespace-nowrap">
                  {item.title}
                </span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- =====================================================
           RIGHT: FEATURED AREA (~26%)
      ====================================================== -->
      <div
        class="sectors-featured-col w-full lg:w-[240px] xl:w-[260px] shrink-0 flex flex-col lg:pl-8 lg:border-l lg:border-slate-100 justify-between"
      >
        <div class="w-full">
          <div class="mb-4 pb-2.5 border-b border-slate-100 hidden lg:block">
            <span class="sectors-right-heading text-xs font-bold uppercase tracking-wider text-[#5A6874]">
              Sector Expertise
            </span>
          </div>

          <a
            href="/sectors"
            class="sectors-featured-card group block w-full rounded-[16px] overflow-hidden border border-slate-200/80 bg-slate-50 transition-all duration-200 hover:border-[#07572F]/40 hover:shadow-md"
          >
            <div class="w-full aspect-[16/10] overflow-hidden bg-slate-100">
              <img
                src="/images/brand/nav-sectors.webp"
                alt="Sector Expertise"
                class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
                width="260"
                height="162"
              />
            </div>

            <div class="p-3.5 flex items-center justify-between bg-white group-hover:bg-[#F2F8F5] transition-colors">
              <span class="font-sans text-[14px] font-semibold text-[#101E2C] group-hover:text-[#07572F] transition-colors">
                Explore Industries
              </span>
            </div>
          </a>
        </div>
      </div>

    </div>
  </div>
</div>

<style>
  /* =========================================================
     CONTAINER & CARD
  ========================================================= */
  #sectors-dropdown-panel .sectors-dropdown-card {
    width: 100%;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    border-radius: 20px !important;
    box-sizing: border-box;
  }

  /* =========================================================
     TYPOGRAPHY
  ========================================================= */
  #sectors-dropdown-panel .sectors-heading,
  #sectors-dropdown-panel .sectors-right-heading {
    font-family: var(--font-sans) !important;
    letter-spacing: 0.05em;
  }

  #sectors-dropdown-panel .sector-link {
    font-family: var(--font-sans) !important;
    font-size: 15px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.4;
    text-decoration: none;
  }

  /* =========================================================
     ACTIVE / HOVER
  ========================================================= */
  #sectors-dropdown-panel .sector-link.active-sector {
    background-color: #bce6ce;
    color: #0f172a;
  }

  #sectors-dropdown-panel .sector-link:not(.active-sector):hover {
    background-color: #e0f2e7;
    color: #0f172a;
  }

  /* =========================================================
     SCROLL NAV GLASS (EXACT SAME AS SCROLLING NAVBAR)
  ========================================================= */
  #sectors-dropdown-panel .sectors-dropdown-card.scroll-glass-active,
  #sectors-dropdown-card.scroll-glass-active {
    background: rgba(250, 246, 238, 0.60) !important;
    background-color: rgba(250, 246, 238, 0.60) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(0, 0, 0, 0.10) !important;
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.08) !important;
  }

  /* =========================================================
     RESPONSIVE
  ========================================================= */
  @media (max-width: 1024px) {
    #sectors-dropdown-panel .sectors-dropdown-card {
      flex-direction: column;
      gap: 1.5rem;
    }

    #sectors-dropdown-panel .sectors-featured-col {
      border-left: none;
      border-top: 1px solid #f1f5f9;
      padding-left: 0;
      padding-top: 1.5rem;
      width: 100%;
    }
  }
</style>
