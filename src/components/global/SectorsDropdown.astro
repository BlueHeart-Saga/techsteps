---
import { getSectors } from '../../lib/sanity/client';

const sectors = await getSectors();

// Key sector descriptions matching each sector's verified content
const sectorMeta: Record<string, { shortDesc: string }> = {
  'it-technology': {
    shortDesc: 'Hyperscale data centre de-racking, certified NIST 800-88 mass erasure, and enterprise server remarketing.',
  },
  defence: {
    shortDesc: 'JSP 440 aligned security, SC-cleared personnel fleet, and witnessed on-site mobile granulation.',
  },
  'manufacturing-engineering': {
    shortDesc: 'CAD/CAM blueprint protection, industrial control ITAD, defect prototype destruction, and clean plant moves.',
  },
  'legal-professional-services': {
    shortDesc: 'SRA-aligned confidentiality, litigation bundle scanning, deep deed vaulting, and on-site media destruction.',
  },
  finance: {
    shortDesc: 'Strategic lifecycle governance for financial institutions, fintech platforms, and FCA/PRA regulatory compliance.',
  },
  'education-universities': {
    shortDesc: 'Campus-wide IT refreshes, student record sanitisation, and BS 10008 academic archive digitization.',
  },
  nhs: {
    shortDesc: 'Caldicott-aligned records governance, BS 10008 legal scanning, and secure acute clinical IT retirement.',
  },
  'central-government': {
    shortDesc: 'Crown Commercial Service frameworks, Greening Government Commitments, and National Archives compliance.',
  },
};

// 4 distinct sector divisions matching the 4-column Services Mega Menu layout
const sectorColumns = [
  {
    title: 'Technology & Defence',
    slugs: ['it-technology', 'defence'],
  },
  {
    title: 'Corporate & Industrial',
    slugs: ['manufacturing-engineering', 'legal-professional-services'],
  },
  {
    title: 'Public Sector & Health',
    slugs: ['nhs', 'central-government'],
  },
  {
    title: 'Finance & Education',
    slugs: ['finance', 'education-universities'],
  },
];

const columnsData = sectorColumns.map((col) => ({
  title: col.title,
  sectors: col.slugs
    .map((slug) => {
      const sec = sectors.find((s) => s.slug === slug);
      if (!sec) return null;
      return {
        ...sec,
        shortDesc: sectorMeta[slug]?.shortDesc || sec.tagline || sec.summary,
      };
    })
    .filter(Boolean),
}));
---

<!-- Sectors Mega Menu Floating Card (Full-Width 4-Division Layout, Matching Service Dropdown) -->
<div
  id="sectors-dropdown-panel"
  class="hidden fixed inset-x-0 z-50 transition-all duration-200 transform opacity-0 -translate-y-2 pointer-events-none px-4 sm:px-6 lg:px-8 max-h-[calc(100vh-90px)] overflow-y-auto"
  role="region"
  aria-label="Sectors Navigation"
>
  <div class="relative max-w-[1540px] mx-auto bg-white rounded-none shadow-2xl border border-slate-200/90 py-8 sm:py-10 lg:py-12 px-8 sm:px-12 lg:px-16 flex flex-col justify-between overflow-hidden font-sans">
    
    <!-- 4 Sector Columns (Matching Services Mega Menu 4-Column Layout) -->
    <div class="relative z-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-12 w-full flex-1">
      {columnsData.map((col) => (
        <div class="space-y-4">
          <a
            href="/sectors"
            class="block text-[15px] sm:text-base font-bold text-[#0F623A] hover:text-black uppercase tracking-wider transition-colors pb-2.5 border-b border-slate-200"
          >
            {col.title}
          </a>

          <div class="space-y-4">
            {col.sectors.map((sec: any) => (
              <a
                href={`/sectors/${sec.slug}`}
                class="group block space-y-1 hover:translate-x-1 transition-all duration-150 py-0.5"
              >
                <h4 class="text-lg sm:text-[20px] lg:text-[21px] font-bold text-slate-900 group-hover:text-[#0F623A] transition-colors leading-snug">
                  {sec.title}
                </h4>
                <p class="text-xs sm:text-[13px] text-slate-500 leading-relaxed font-normal group-hover:text-slate-700 transition-colors">
                  {sec.shortDesc}
                </p>
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Utility Footer (Matching Services Mega Menu) -->
    <div class="relative z-10 mt-6 sm:mt-8 pt-4 sm:pt-5 border-t border-slate-100 flex flex-wrap items-center justify-between gap-4 text-sm sm:text-base">
      <a
        href="/sustainability"
        class="text-lg sm:text-xl font-bold text-[#0F623A] hover:text-black flex items-center gap-2 transition-colors group py-1"
      >
        <span>Sustainability &amp; ESG</span>
        <span class="transition-transform duration-150 group-hover:translate-x-1">&rarr;</span>
      </a>

      <a
        href="/sectors"
        class="font-bold text-sm sm:text-base text-white bg-[#0F623A] hover:bg-[#0c4e2e] flex items-center gap-2 px-6 py-2.5 rounded-full shadow-sm hover:shadow-md transition-all"
      >
        <span>View Full Sector Directory</span>
        <span>&rarr;</span>
      </a>
    </div>

  </div>
</div>
