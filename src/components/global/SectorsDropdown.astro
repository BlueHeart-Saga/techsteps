---
const column1 = [
  {
    title: 'NHS & Healthcare',
    slug: 'nhs',
    icon: '/icons/NHS%20&%20Healthcare.svg',
    active: true,
  },
  {
    title: 'Defence & Aerospace',
    slug: 'defence',
    icon: '/icons/Defence%20&%20Aerospace.svg',
  },
  {
    title: 'Manufacturing & Engineering',
    slug: 'manufacturing-engineering',
    icon: '/icons/Manufacturing%20&%20Engineering.svg',
  },
];

const column2 = [
  {
    title: 'Financial Services',
    slug: 'finance',
    icon: '/icons/Financial%20Services.svg',
  },
  {
    title: 'Corporate & Legal',
    slug: 'legal-professional-services',
    icon: '/icons/Corporate%20&%20Legal.svg',
  },
  {
    title: 'IT & Technology',
    slug: 'it-technology',
    icon: '/icons/IT%20&%20Technology.svg',
  },
];

const column3 = [
  {
    title: 'Central Government',
    slug: 'central-government',
    icon: '/icons/Central%20Government.svg',
  },
  {
    title: 'Education & Universities',
    slug: 'education-universities',
    icon: '/icons/Education%20&%20Universities.svg',
  },
];
---

<!-- =========================================================
     SECTORS DROPDOWN PANEL
========================================================= -->
<div
  id="sectors-dropdown-panel"
  class="fixed top-[82px] inset-x-0 z-[998] hidden opacity-0 -translate-y-1 transition-[opacity,transform] duration-150 ease-out pointer-events-none before:absolute before:-top-10 before:inset-x-0 before:h-10 before:content-[''] before:pointer-events-auto"
  role="region"
  aria-label="Sectors Menu"
>
  <div
    id="sectors-dropdown-wrapper"
    class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
  >
    <div
      id="sectors-dropdown-card"
      class="sectors-dropdown-card bg-white rounded-[12px] border border-slate-200/80 shadow-[0_16px_48px_rgba(0,0,0,0.08)] pointer-events-auto p-4 sm:p-5 flex items-stretch w-full min-h-[322px] box-border"
    >

      <!-- =====================================================
           LEFT: INDUSTRIES WE SERVE
      ====================================================== -->
      <div
        class="flex-1 flex flex-col pt-6 pb-5 pl-2 sm:pl-3 pr-4 sm:pr-8"
      >
        <h3 class="sectors-heading text-[#5A6874] mb-6">
          Industries We Serve
        </h3>

        <div
          class="grid grid-cols-1 md:grid-cols-3 gap-x-6 xl:gap-x-12 gap-y-2.5"
        >

          <!-- Column 1 -->
          <div class="flex flex-col space-y-2.5">
            {column1.map((item) => (
              <a
                href={`/sectors/${item.slug}`}
                class={`sector-link group flex items-center gap-3.5 px-3.5 py-2.5 rounded-[8px] transition-all duration-150 cursor-pointer ${
                  item.active
                    ? 'active-sector bg-[#BCE6CE] text-[#0F172A]'
                    : 'text-[#1E293B] hover:bg-[#E0F2E7]'
                }`}
              >
                <span class="shrink-0 flex items-center justify-center w-5 h-5">
                  <img
                    src={item.icon}
                    alt=""
                    class="w-5 h-5 object-contain"
                    width="20"
                    height="20"
                  />
                </span>

                <span class="sector-label leading-snug">
                  {item.title}
                </span>
              </a>
            ))}
          </div>

          <!-- Column 2 -->
          <div class="flex flex-col space-y-2.5">
            {column2.map((item) => (
              <a
                href={`/sectors/${item.slug}`}
                class="sector-link group flex items-center gap-3.5 px-3.5 py-2.5 rounded-[8px] transition-all duration-150 cursor-pointer text-[#1E293B] hover:bg-[#E0F2E7]"
              >
                <span class="shrink-0 flex items-center justify-center w-5 h-5">
                  <img
                    src={item.icon}
                    alt=""
                    class="w-5 h-5 object-contain"
                    width="20"
                    height="20"
                  />
                </span>

                <span class="sector-label leading-snug">
                  {item.title}
                </span>
              </a>
            ))}
          </div>

          <!-- Column 3 -->
          <div class="flex flex-col space-y-2.5">
            {column3.map((item) => (
              <a
                href={`/sectors/${item.slug}`}
                class="sector-link group flex items-center gap-3.5 px-3.5 py-2.5 rounded-[8px] transition-all duration-150 cursor-pointer text-[#1E293B] hover:bg-[#E0F2E7]"
              >
                <span class="shrink-0 flex items-center justify-center w-5 h-5">
                  <img
                    src={item.icon}
                    alt=""
                    class="w-5 h-5 object-contain"
                    width="20"
                    height="20"
                  />
                </span>

                <span class="sector-label leading-snug">
                  {item.title}
                </span>
              </a>
            ))}
          </div>

        </div>
      </div>


      <!-- =====================================================
           RIGHT: INVESTORS
      ====================================================== -->
      <div
        class="sectors-right-col w-[280px] shrink-0 pt-6 pb-[13px] pr-8 flex flex-col ml-8 xl:ml-12"
      >
        <h3 class="sectors-right-heading text-[#5A6874] mb-5">
          Investors
        </h3>

        <a href="/investors" class="group block shrink-0">
          <div
            class="rounded-xl overflow-hidden shadow-xs border border-slate-200/60 bg-slate-100"
            style="width: 248px; height: 164.96px;"
          >
            <img
              src="/images/brand/nav-sectors.webp"
              alt="Investors"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
              width="248"
              height="165"
            />
          </div>
        </a>

        <a
          href="/investors"
          class="investors-link mt-[36px] inline-flex items-center gap-1.5 font-sans text-[16px] font-semibold text-[#171717] hover:text-[#07572F] transition-colors group"
        >
          <span>Visit</span>

          <span
            class="font-bold transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          >
            ↗
          </span>
        </a>
      </div>

    </div>
  </div>
</div>


<style>
  /* =========================================================
     CONTAINER
  ========================================================= */

  #sectors-dropdown-panel .sectors-dropdown-card {
    width: 100%;
    height: 322px;
    min-height: 322px;
    max-height: 322px;
    border-radius: 12px;
    box-sizing: border-box;
    padding: 8px;
  }

  #sectors-dropdown-panel .sectors-right-col {
    width: 280px;
    min-width: 280px;
    max-width: 280px;
    padding-right: 32px;
    box-sizing: border-box;
  }


  /* =========================================================
     TYPOGRAPHY
  ========================================================= */

  #sectors-dropdown-panel .sectors-heading,
  #sectors-dropdown-panel .sectors-right-heading {
    font-family: var(--font-sans) !important;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.4;
  }

  #sectors-dropdown-panel .sector-link {
    font-family: var(--font-sans) !important;
    font-size: 16px;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.45;
    text-decoration: none;
  }


  /* =========================================================
     ACTIVE / HOVER
  ========================================================= */

  #sectors-dropdown-panel .sector-link.active-sector {
    background-color: #bce6ce;
    color: #0f172a;
  }

  #sectors-dropdown-panel .sector-link:not(.active-sector):hover {
    background-color: #e0f2e7;
    color: #0f172a;
  }


  /* =========================================================
     VISIT LINK
  ========================================================= */

  #sectors-dropdown-panel .investors-link {
    font-family: var(--font-sans) !important;
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4 !important;
  }


  /* =========================================================
     SCROLL NAV GLASS (EXACT SAME AS SCROLLING NAVBAR)
  ========================================================= */

  #sectors-dropdown-panel .sectors-dropdown-card.scroll-glass-active,
  #sectors-dropdown-card.scroll-glass-active {
    background: rgba(250, 246, 238, 0.60) !important;
    background-color: rgba(250, 246, 238, 0.60) !important;

    -webkit-backdrop-filter:
      blur(12px) !important;

    backdrop-filter:
      blur(12px) !important;

    border:
      1px solid rgba(0, 0, 0, 0.10) !important;

    box-shadow:
      0 16px 40px -10px rgba(0, 0, 0, 0.08) !important;
  }


  /* =========================================================
     RESPONSIVE
  ========================================================= */

  @media (max-width: 1024px) {

    #sectors-dropdown-panel .sectors-dropdown-card {
      height: auto;
      min-height: 0;
      max-height: none;
      flex-direction: column;
    }

    #sectors-dropdown-panel .sectors-right-col {
      margin-left: 0;
      margin-top: 1.5rem;
      padding-top: 1rem;
      border-top: 1px solid #f1f5f9;
      width: 100%;
      min-width: 100%;
      max-width: 100%;
    }

  }
</style>


<script>
  function setupSectorsMegaMenu() {

    const panel =
      document.getElementById(
        'sectors-dropdown-panel'
      );

    if (!panel) return;

    if (
      panel.dataset.navInitialized === 'true'
    ) {
      return;
    }

    panel.dataset.navInitialized = 'true';


    const triggers =
      document.querySelectorAll<HTMLElement>(
        '#sectors-menu-trigger, .sectors-dropdown-toggle'
      );

    if (triggers.length === 0) return;


    let closeTimeout: ReturnType<typeof setTimeout> | null = null;
    let hideTimeout: ReturnType<typeof setTimeout> | null = null;


    const sectorLinks =
      panel.querySelectorAll<HTMLElement>(
        '.sector-link'
      );


    /* =========================================================
       GLASS STATE
    ========================================================= */

    const setScrollGlass = (
      active: boolean
    ) => {

      const card =
        document.getElementById(
          'sectors-dropdown-card'
        );

      if (!card) return;


      if (active) {

        card.classList.add(
          'scroll-glass-active'
        );

        card.style.setProperty(
          'background',
          'rgba(250, 246, 238, 0.60)',
          'important'
        );

        card.style.setProperty(
          'background-color',
          'rgba(250, 246, 238, 0.60)',
          'important'
        );

        card.style.setProperty(
          '-webkit-backdrop-filter',
          'blur(12px)',
          'important'
        );

        card.style.setProperty(
          'backdrop-filter',
          'blur(12px)',
          'important'
        );

        card.style.setProperty(
          'border',
          '1px solid rgba(0, 0, 0, 0.10)',
          'important'
        );

        card.style.setProperty(
          'box-shadow',
          '0 16px 40px -10px rgba(0, 0, 0, 0.08)',
          'important'
        );

      } else {

        card.classList.remove(
          'scroll-glass-active'
        );

        card.style.removeProperty(
          'background'
        );

        card.style.removeProperty(
          'background-color'
        );

        card.style.removeProperty(
          '-webkit-backdrop-filter'
        );

        card.style.removeProperty(
          'backdrop-filter'
        );

        card.style.removeProperty(
          'border'
        );

        card.style.removeProperty(
          'box-shadow'
        );

      }

    };


    /* =========================================================
       POSITION + NAV STATE
    ========================================================= */

    const updatePosition = () => {

      const siteHeader =
        document.getElementById(
          'site-header'
        );

      const heroHeader =
        document.getElementById(
          'hero-header'
        );

      const card =
        document.getElementById(
          'sectors-dropdown-card'
        );

      const wrapper =
        document.getElementById(
          'sectors-dropdown-wrapper'
        );


      const isScrollNavActive =
        !!siteHeader &&
        !siteHeader.classList.contains(
          'opacity-0'
        ) &&
        !siteHeader.classList.contains(
          '-translate-y-full'
        );


      /* =====================================================
         SCROLLING NAVBAR
      ===================================================== */

      if (
        isScrollNavActive &&
        siteHeader
      ) {

        setScrollGlass(true);


        const maxWrap =
          siteHeader.querySelector<HTMLElement>(
            ':scope > div'
          );

        const floatingBar =
          maxWrap?.querySelector<HTMLElement>(
            ':scope > div'
          );

        const ref =
          floatingBar ?? siteHeader;

        const rect =
          ref.getBoundingClientRect();


        panel.style.top =
          `${Math.round(rect.bottom + 8)}px`;

        panel.style.left =
          `${Math.round(rect.left)}px`;

        panel.style.right =
          'auto';

        panel.style.width =
          `${Math.round(rect.width)}px`;


        if (wrapper) {
          wrapper.classList.add(
            'scroll-dropdown-wrapper'
          );
        }


        if (card) {

          card.style.width =
            `${Math.round(rect.width)}px`;

          card.style.maxWidth =
            `${Math.round(rect.width)}px`;

        }

      }


      /* =====================================================
         NORMAL / HERO NAVBAR
      ===================================================== */

      else if (heroHeader) {

        setScrollGlass(false);


        const rect =
          heroHeader.getBoundingClientRect();


        panel.style.top =
          `${Math.round(rect.bottom + 8)}px`;

        panel.style.left =
          '';

        panel.style.right =
          '';

        panel.style.width =
          '';


        if (card) {

          card.style.width =
            '';

          card.style.maxWidth =
            '';

        }


        if (wrapper) {

          wrapper.classList.remove(
            'scroll-dropdown-wrapper'
          );

        }

      }

    };


    /* =========================================================
       BACKDROP
    ========================================================= */

    const updateBackdrop = () => {

      const backdrop =
        document.getElementById(
          'dropdown-backdrop'
        );

      if (!backdrop) return;


      const servicesPanel =
        document.getElementById(
          'services-megamenu-panel'
        );


      const isServicesOpen =
        servicesPanel &&
        !servicesPanel.classList.contains(
          'hidden'
        ) &&
        !servicesPanel.classList.contains(
          'opacity-0'
        );


      const isSectorsOpen =
        !panel.classList.contains(
          'hidden'
        ) &&
        !panel.classList.contains(
          'opacity-0'
        );


      if (
        isServicesOpen ||
        isSectorsOpen
      ) {

        backdrop.classList.add(
          'active'
        );

      } else {

        backdrop.classList.remove(
          'active'
        );

      }

    };


    /* =========================================================
       CANCEL CLOSE
    ========================================================= */

    const cancelClose = () => {

      if (closeTimeout) {

        clearTimeout(
          closeTimeout
        );

        closeTimeout = null;

      }


      if (hideTimeout) {

        clearTimeout(
          hideTimeout
        );

        hideTimeout = null;

      }

    };


    /* =========================================================
       SECTOR HOVER
    ========================================================= */

    sectorLinks.forEach(
      (link) => {

        link.addEventListener(
          'mouseenter',
          () => {

            sectorLinks.forEach(
              (l) => {

                l.classList.remove(
                  'active-sector',
                  'bg-[#BCE6CE]'
                );

              }
            );


            link.classList.add(
              'active-sector',
              'bg-[#BCE6CE]'
            );

          }
        );

      }
    );


    /* =========================================================
       OPEN
    ========================================================= */

    const openMenu = () => {

      cancelClose();


      window.dispatchEvent(
        new CustomEvent(
          'techsteps:close-services',
          {
            detail: {
              immediate: true
            }
          }
        )
      );
      window.dispatchEvent(
  new CustomEvent('techsteps:close-about')
);


      updatePosition();


      panel.classList.remove(
        'hidden'
      );


      void panel.offsetHeight;


      panel.classList.remove(
        'opacity-0',
        '-translate-y-1',
        'pointer-events-none'
      );


      panel.classList.add(
        'opacity-100',
        'translate-y-0',
        'pointer-events-auto'
      );


      triggers.forEach(
        (trigger) => {

          trigger.setAttribute(
            'aria-expanded',
            'true'
          );


          const caret =
            trigger.querySelector(
              '.caret-icon'
            );


          if (caret) {

            caret.classList.add(
              'rotate-180'
            );

          }

        }
      );


      updateBackdrop();

    };


    /* =========================================================
       CLOSE
    ========================================================= */

    const closeMenu = (
      immediate = false
    ) => {

      const doClose = () => {

        panel.classList.remove(
          'opacity-100',
          'translate-y-0',
          'pointer-events-auto'
        );


        panel.classList.add(
          'opacity-0',
          '-translate-y-1',
          'pointer-events-none'
        );


        triggers.forEach(
          (trigger) => {

            trigger.setAttribute(
              'aria-expanded',
              'false'
            );


            const caret =
              trigger.querySelector(
                '.caret-icon'
              );


            if (caret) {

              caret.classList.remove(
                'rotate-180'
              );

            }

          }
        );


        updateBackdrop();


        if (hideTimeout) {

          clearTimeout(
            hideTimeout
          );

        }


        if (immediate) {

          panel.classList.add(
            'hidden'
          );

        } else {

          hideTimeout =
            setTimeout(
              () => {

                if (
                  panel.classList.contains(
                    'opacity-0'
                  )
                ) {

                  panel.classList.add(
                    'hidden'
                  );

                }

                hideTimeout = null;

              },
              160
            );

        }

      };


      cancelClose();


      if (immediate) {

        doClose();

      } else {

        closeTimeout =
          setTimeout(
            doClose,
            280
          );

      }

    };


    /* =========================================================
       TRIGGER EVENTS

       IMPORTANT:
       The parent of the arrow contains BOTH:
       - Sectors text
       - Sectors arrow

       Therefore hovering either one opens the menu.
    ========================================================= */

    triggers.forEach(
      (trigger) => {

        const hoverTarget =
          trigger.parentElement as HTMLElement | null;

        if (!hoverTarget) return;


        /*
         * Hovering Sectors text OR arrow
         * opens the dropdown.
         */
        hoverTarget.addEventListener(
          'mouseenter',
          openMenu
        );


        /*
         * Do NOT close on mouseleave.
         *
         * The menu stays open until:
         * - outside click
         * - arrow click
         * - Escape
         * - another dropdown opens
         */
        trigger.addEventListener(
          'click',
          (event) => {

            event.stopPropagation();
            event.preventDefault();


            const isExpanded =
              trigger.getAttribute(
                'aria-expanded'
              ) === 'true';


            if (isExpanded) {

              closeMenu(true);

            } else {

              openMenu();

            }

          }
        );


        /*
         * Keyboard accessibility.
         */
        trigger.addEventListener(
          'focus',
          openMenu
        );

      }
    );


    /* =========================================================
       PANEL HOVER
    ========================================================= */

    panel.addEventListener(
      'mouseenter',
      cancelClose
    );


    /* =========================================================
       CROSS MENU CLOSE
    ========================================================= */

    window.addEventListener(
      'techsteps:close-sectors',
      (event: Event) => {

        const customEvent =
          event as CustomEvent;

        closeMenu(
          customEvent.detail?.immediate ?? true
        );

      }
    );


    /* =========================================================
       ESCAPE
    ========================================================= */

    document.addEventListener(
      'keydown',
      (event) => {

        if (
          event.key === 'Escape'
        ) {

          closeMenu(true);

        }

      }
    );


    /* =========================================================
       OUTSIDE CLICK
    ========================================================= */

    document.addEventListener(
      'click',
      (event) => {

        const target =
          event.target as Node;


        let insideTrigger =
          false;


        triggers.forEach(
          (trigger) => {

            if (
              trigger.contains(target) ||
              trigger.parentElement?.contains(target)
            ) {

              insideTrigger = true;

            }

          }
        );


        if (
          !panel.contains(target) &&
          !insideTrigger
        ) {

          closeMenu(true);

        }

      }
    );


    /* =========================================================
       BACKDROP CLICK
    ========================================================= */

    const backdrop =
      document.getElementById(
        'dropdown-backdrop'
      );


    backdrop?.addEventListener(
      'click',
      () => closeMenu(true)
    );


    /* =========================================================
       LINK CLICK
    ========================================================= */

    panel
      .querySelectorAll('a')
      .forEach(
        (link) => {

          link.addEventListener(
            'click',
            () => closeMenu(true)
          );

        }
      );


    /* =========================================================
       RESIZE / SCROLL
    ========================================================= */

    window.addEventListener(
      'resize',
      updatePosition,
      {
        passive: true
      }
    );


    window.addEventListener(
      'scroll',
      updatePosition,
      {
        passive: true
      }
    );

  }


  setupSectorsMegaMenu();


  document.addEventListener(
    'astro:page-load',
    () => {

      document
        .getElementById(
          'dropdown-backdrop'
        )
        ?.classList.remove(
          'active'
        );


      setupSectorsMegaMenu();

    }
  );
</script>