---
import { getSectors } from '../../lib/sanity/client';

const sectors = await getSectors();

// 4 Sector Clusters matching requested headings:
// Technology & Defence, Corporate & Industrial, Public Sector & Health, Finance & Education
const sectorTabs = [
  {
    id: 'tech-defence',
    slug: 'it-technology',
    title: 'Technology & Defence',
    iconType: 'tech-defence',
    image: '/images/sectors/defence.jpg',
    subSectors: [
      { title: 'IT & Technology Sector', href: '/sectors/it-technology' },
      { title: 'Defence & Aerospace (MOD)', href: '/sectors/defence' },
      { title: 'Hyperscale Data Centres', href: '/sectors/it-technology' },
      { title: 'Telecoms & Infrastructure Networks', href: '/services/secure-it-disposal' },
      { title: 'Military Base IT Retirement', href: '/sectors/defence' },
      { title: 'Hardware OEMs & Electronics', href: '/services/remarketing-recycling' },
    ],
    badges: [
      { label: 'NIST', color: '#0F623A', text: '800-88' },
      { label: 'JSP', color: '#2563EB', text: '440' },
      { label: 'ADISA', color: '#059669', text: '8.0' },
      { label: 'DIPCOG', color: '#D97706', text: 'MOD' },
    ],
    bottomCardLink: { title: 'Explore technology & defence', href: '/sectors/it-technology' },
  },
  {
    id: 'corp-industrial',
    slug: 'manufacturing-engineering',
    title: 'Corporate & Industrial',
    iconType: 'corp-industrial',
    image: '/images/sectors/corporate.jpg',
    subSectors: [
      { title: 'Manufacturing & Engineering', href: '/sectors/manufacturing-engineering' },
      { title: 'Legal & Professional Services', href: '/sectors/legal-professional-services' },
      { title: 'Industrial Plant & Cleanroom Moves', href: '/services/laboratory-relocations-storage' },
      { title: 'Law Firms & Barristers Chambers', href: '/sectors/legal-professional-services' },
      { title: 'CAD/CAM & Prototype Protection', href: '/sectors/manufacturing-engineering' },
      { title: 'Corporate Headquarters Relocations', href: '/services/business-relocations' },
    ],
    badges: [
      { label: 'ISO', color: '#0F623A', text: '27001' },
      { label: 'SRA', color: '#2563EB', text: 'Compliant' },
      { label: 'BS EN', color: '#059669', text: '15713' },
      { label: 'ISO', color: '#D97706', text: '14001' },
    ],
    bottomCardLink: { title: 'Explore corporate & industrial', href: '/sectors/manufacturing-engineering' },
  },
  {
    id: 'public-health',
    slug: 'nhs',
    title: 'Public Sector & Health',
    iconType: 'public-health',
    image: '/images/sectors/nhs.jpg',
    subSectors: [
      { title: 'Healthcare & NHS Acute Trusts', href: '/sectors/nhs' },
      { title: 'Central Government Departments', href: '/sectors/central-government' },
      { title: 'Hospitals & Regional Health Boards', href: '/sectors/nhs' },
      { title: 'Local Authorities & Blue Light Services', href: '/sectors/central-government' },
      { title: 'Clinical Records & Patient Data', href: '/services/document-storage' },
      { title: 'Crown Commercial Service (CCS) Deployments', href: '/sectors/central-government' },
    ],
    badges: [
      { label: 'NHS', color: '#0F623A', text: 'IG Pass' },
      { label: 'CALDICOTT', color: '#2563EB', text: 'Compliant' },
      { label: 'CCS', color: '#059669', text: 'Framework' },
      { label: 'BS', color: '#D97706', text: '10008' },
    ],
    bottomCardLink: { title: 'Explore public sector & health', href: '/sectors/nhs' },
  },
  {
    id: 'fin-education',
    slug: 'finance',
    title: 'Finance & Education',
    iconType: 'fin-education',
    image: '/images/sectors/finance.jpg',
    subSectors: [
      { title: 'Banking & Financial Services', href: '/sectors/finance' },
      { title: 'Higher Education & Universities', href: '/sectors/education-universities' },
      { title: 'FinTech & Trading Platforms', href: '/sectors/finance' },
      { title: 'Colleges, Schools & Research Institutes', href: '/sectors/education-universities' },
      { title: 'Accountancy & Audit Partnerships', href: '/sectors/legal-professional-services' },
      { title: 'Insurance Underwriters & Actuaries', href: '/services/vault-storage' },
    ],
    badges: [
      { label: 'FCA', color: '#0F623A', text: 'SYSC 8' },
      { label: 'ISO', color: '#2563EB', text: '27001' },
      { label: 'BS', color: '#059669', text: '4971' },
      { label: 'CYBER', color: '#D97706', text: 'Plus' },
    ],
    bottomCardLink: { title: 'Explore finance & education', href: '/sectors/finance' },
  },
];
---

<!-- Sectors Dropdown Floating Card (Sharp edges, matched to Service Dropdown) -->
<div
  id="sectors-dropdown-panel"
  class="hidden fixed inset-x-0 z-50 transition-all duration-200 transform opacity-0 -translate-y-2 pointer-events-none px-4 sm:px-6 lg:px-8 max-h-[calc(100vh-90px)] overflow-y-auto pt-2 before:absolute before:-top-4 before:inset-x-0 before:h-4 before:content-['']"
  role="region"
  aria-label="Sectors Navigation"
>
  <div class="relative max-w-7xl mx-auto bg-white rounded-none shadow-[0_25px_60px_-15px_rgba(15,23,42,0.18)] border border-slate-200/90 overflow-hidden font-sans">
    <div class="flex flex-col lg:flex-row">
      
      <!-- 1. LEFT SIDEBAR (Category Items with High-Level Icons & NO Background) -->
      <div class="w-full lg:w-72 bg-[#F8FAF9] p-4 sm:p-5 flex flex-col border-b lg:border-b-0 lg:border-r border-slate-200/80 shrink-0">
        <div class="space-y-1.5">
          <div class="px-3 py-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">
            Sectors
          </div>

          {sectorTabs.map((tab, idx) => {
            const isFirst = idx === 0;
            return (
              <button
                type="button"
                class={`sectors-tab-btn group w-full flex items-center gap-3 px-3.5 py-3 rounded-xl text-left text-sm transition-all duration-150 cursor-pointer ${
                  isFirst
                    ? 'bg-emerald-500/10 backdrop-blur-sm text-[#0F623A] font-bold shadow-sm active'
                    : 'text-slate-700 hover:text-[#0F623A] hover:bg-emerald-500/10 font-medium'
                }`}
                data-target-tab={`sectors-tab-${tab.id}`}
                data-slug={tab.slug}
              >
                <!-- High-Level Icon WITHOUT Background -->
                <span class={`tab-icon shrink-0 transition-colors ${
                  isFirst ? 'text-[#0F623A]' : 'text-slate-600 group-hover:text-[#0F623A]'
                }`}>
                  {tab.iconType === 'tech-defence' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                    </svg>
                  )}
                  {tab.iconType === 'corp-industrial' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  )}
                  {tab.iconType === 'public-health' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v6m3-3H9m12 0a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  )}
                  {tab.iconType === 'fin-education' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l9-5-9-5-9 5 9 5z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 14l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 14v7" />
                    </svg>
                  )}
                </span>
                <span class="truncate">{tab.title}</span>
              </button>
            );
          })}
        </div>
      </div>

      <!-- 2. RIGHT MAIN CONTENT AREA: CENTER RELATED SECTORS + RIGHT SPOTLIGHT CARD -->
      <div class="flex-1 bg-white p-6 sm:p-8 lg:px-9 lg:pt-8 lg:pb-6 relative">
        {sectorTabs.map((tab, idx) => {
          const isFirst = idx === 0;
          return (
            <div
              id={`sectors-tab-${tab.id}`}
              class={`sectors-tab-panel ${isFirst ? 'block' : 'hidden'} animate-in fade-in duration-150`}
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
                
                <!-- CENTER AREA: Links related to the selected sector heading (Matching left sidebar font style) -->
                <div class="lg:col-span-7 space-y-4">
                  <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 font-sans">
                      {tab.title}
                    </span>
                    <a
                      href={`/sectors/${tab.slug}`}
                      class="text-xs font-bold text-[#0F623A] hover:text-black flex items-center gap-1 transition-colors group/link font-sans"
                    >
                      <span>Sector Overview</span>
                    </a>
                  </div>

                  <!-- 2-Column Responsive Grid of Related Sectors (Font style matched to left sidebar: text-sm font-medium) -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5 pt-1">
                    {tab.subSectors.map((sub) => (
                      <a
                        href={sub.href}
                        class="group flex items-center justify-between py-2 px-3 rounded-lg hover:bg-emerald-500/10 transition-all duration-150"
                      >
                        <span class="text-sm font-medium text-slate-700 group-hover:text-[#0F623A] transition-colors leading-snug font-sans">
                          {sub.title}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>

                <!-- RIGHT COLUMN: Featured Real Image & Directory Link (Enlarged) -->
                <div class="lg:col-span-5 space-y-3 lg:border-l lg:border-slate-100 lg:pl-8 flex flex-col justify-start">
                  <div class="w-full h-56 sm:h-64 lg:h-72 rounded-2xl overflow-hidden shadow-md border border-slate-200/90 bg-slate-100 relative group/img">
                    <img
                      src={tab.image}
                      alt={tab.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover/img:scale-105"
                      loading="lazy"
                    />
                  </div>

                  <!-- Links placed below the image -->
                  <div class="pt-3 flex items-center justify-between gap-3 border-t border-slate-100">
                    <a
                      href="/sectors"
                      class="inline-flex items-center gap-1.5 text-xs sm:text-[13px] font-bold text-[#0F623A] hover:text-black transition-colors group/link"
                    >
                      <span>All Sectors Directory</span>
                      <svg class="w-4 h-4 transition-transform duration-200 group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                      </svg>
                    </a>
                    <a
                      href="/sustainability"
                      class="inline-flex items-center gap-1.5 text-xs sm:text-[13px] font-bold text-[#0F623A] hover:text-black transition-colors group/link"
                    >
                      <span>Sustainability</span>
                      <svg class="w-4 h-4 transition-transform duration-200 group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                      </svg>
                    </a>
                  </div>
                </div>

              </div>
            </div>
          );
        })}
      </div>

    </div>
  </div>
</div>

<script>
  function setupSectorsTabs() {
    const tabBtns = document.querySelectorAll('.sectors-tab-btn');
    const tabPanels = document.querySelectorAll('.sectors-tab-panel');
    if (!tabBtns.length) return;

    tabBtns.forEach((btn) => {
      const activate = () => {
        const targetId = btn.getAttribute('data-target-tab');
        tabBtns.forEach((b) => {
          b.classList.remove(
            'bg-emerald-500/10',
            'backdrop-blur-sm',
            'text-[#0F623A]',
            'font-bold',
            'shadow-xs',
            'shadow-sm',
            'active',
            'border-emerald-400/40',
            'ring-1',
            'ring-emerald-400/20'
          );
          b.classList.add(
            'text-slate-700',
            'hover:text-[#0F623A]',
            'hover:bg-emerald-500/10',
            'font-medium'
          );
          const icon = b.querySelector('.tab-icon');
          if (icon) {
            icon.classList.remove('text-[#0F623A]');
            icon.classList.add('text-slate-600');
          }
        });

        btn.classList.add(
          'bg-emerald-500/10',
          'backdrop-blur-sm',
          'text-[#0F623A]',
          'font-bold',
          'shadow-sm',
          'active'
        );
        btn.classList.remove('text-slate-700');
        const activeIcon = btn.querySelector('.tab-icon');
        if (activeIcon) {
          activeIcon.classList.add('text-[#0F623A]');
          activeIcon.classList.remove('text-slate-600');
        }

        tabPanels.forEach((panel) => {
          if (panel.id === targetId) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.add('hidden');
            panel.classList.remove('block');
          }
        });
      };

      btn.addEventListener('mouseenter', activate);
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug');
        if (btn.classList.contains('active') && slug) {
          window.location.href = `/sectors/${slug}`;
        } else {
          activate();
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupSectorsTabs);
  } else {
    setupSectorsTabs();
  }
  document.addEventListener('astro:page-load', setupSectorsTabs);
</script>

<style>
  #sectors-dropdown-panel,
  #sectors-dropdown-panel * {
    font-family: var(--font-sans) !important;
  }
</style>


