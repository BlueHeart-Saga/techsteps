---
import { insightsApi } from '../../lib/insightsApi';

let siteStructure: any[] = [];
let allPosts: any[] = [];

try {
  const [structureRes, postsRes] = await Promise.all([
    insightsApi.getFullSiteStructure(),
    insightsApi.getAllPosts(8)
  ]);
  siteStructure = structureRes || [];
  allPosts = postsRes || [];
} catch (e) {
  console.error('Failed to load insights for megamenu:', e);
}

// Fallback site structure if CMS is offline/empty
if (!siteStructure || siteStructure.length === 0) {
  siteStructure = [
    {
      name: 'Insights & Knowledge',
      categories: [
        { name: 'Blogs', slug: 'blogs' },
        { name: 'Case Studies', slug: 'case-studies' },
        { name: 'Newsletters', slug: 'newsletters' },
        { name: 'Podcasts', slug: 'podcasts' }
      ]
    },
    {
      name: 'News & Events',
      categories: [
        { name: 'Industry Events', slug: 'industry-events' },
        { name: 'Company Announcements', slug: 'company-announcements' },
        { name: 'Achievements', slug: 'achievements' },
        { name: 'Awards & Milestones', slug: 'awards-milestones' }
      ]
    },
    {
      name: 'Success Stories',
      categories: [
        { name: 'Client Transformations', slug: 'client-transformations' },
        { name: 'Impact Metrics', slug: 'impact-metrics' },
        { name: 'Testimonials', slug: 'testimonials' }
      ]
    },
    {
      name: 'Life at Techsteps',
      categories: [
        { name: 'Celebrations', slug: 'celebrations' },
        { name: 'Team Culture', slug: 'team-culture' },
        { name: 'Posters', slug: 'posters' },
        { name: 'Community', slug: 'community' }
      ]
    }
  ];
}

// Extract real sections directly from CMS site structure
const sections = siteStructure.slice(0, 4);

// Default featured post fallback with rich details & image if CMS empty
const fallbackFeatured = {
  title: 'UK Simpler Recycling Mandate: Complete Business Compliance Guide',
  excerpt: 'Key timelines, legal duties, and practical steps for business leaders preparing for mandatory workplace recycling reforms.',
  readTime: 4,
  author: 'Techsteps Advisory',
  date: 'March 2025',
  category: { slug: 'blogs', name: 'Regulatory Update' },
  seoSlug: 'uk-simpler-recycling-mandate-business-guide',
  coverImage: '/images/services/sustainability-approach.jpg'
};

const activeFeatured = (allPosts && allPosts.length > 0)
  ? (allPosts.find(p => p.featured) || allPosts[0])
  : fallbackFeatured;

const featuredImage = activeFeatured?.coverImage || activeFeatured?.image || '/images/services/sustainability-approach.jpg';
---

<!-- Insights Full-Width Mega Dropdown Panel -->
<div
  id="insights-megamenu-panel"
  class="hidden fixed inset-x-0 z-50 transition-all duration-200 transform opacity-0 -translate-y-2 pointer-events-none px-4 sm:px-6 lg:px-8 max-h-[calc(100vh-90px)] overflow-y-auto"
  role="region"
  aria-label="Insights Navigation"
>
  <div class="relative max-w-[1540px] mx-auto bg-white rounded-none shadow-2xl border border-black/10 py-8 sm:py-10 lg:py-12 px-8 sm:px-12 lg:px-14 flex flex-col justify-between overflow-hidden font-sans">
    
    <!-- Custom Background Collage Graphic for Insights Dropdown (Left side) -->
    <div
      class="absolute left-0 bottom-0 pointer-events-none select-none z-0 opacity-30 sm:opacity-35 lg:opacity-40 max-w-[340px] sm:max-w-[440px] lg:max-w-[520px] -translate-x-4 translate-y-2 mix-blend-multiply"
      aria-hidden="true"
    >
      <img
        src="/images/navabar/insights-collage.png"
        alt="Techsteps Insights & Lifecycle Solutions"
        class="w-full h-auto object-contain"
        loading="eager"
      />
    </div>

    <!-- Top Content Grid: Dynamic Taxonomy Columns + Featured Article Spotlight Card -->
    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 flex-1 items-start">
      
      <!-- Left 8 Cols: Dynamic Sections & Categories -->
      <div class="lg:col-span-8 border-b lg:border-b-0 lg:border-r border-slate-100 pb-6 lg:pb-0 lg:pr-8">
        <!-- 4 Taxonomy Columns -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 sm:gap-7 lg:gap-8">
          {sections.map((section: any) => (
            <div class="space-y-5">
              <div class="flex items-center gap-2 pb-3 border-b border-slate-200">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 shrink-0"></span>
                <h4 class="text-[16px] sm:text-[17px] lg:text-[17.5px] font-bold uppercase tracking-wider text-slate-900 leading-tight">
                  {section.name}
                </h4>
              </div>

              <ul class="space-y-3.5">
                {(section.categories || []).map((category: any) => (
                  <li>
                    <a
                      href={`/insights/${category.slug}`}
                      class="group flex items-center justify-between text-[17px] sm:text-[17.5px] lg:text-[18px] font-semibold text-slate-700 hover:text-emerald-800 transition-colors py-1.5 px-2 rounded-none hover:bg-slate-50/90"
                    >
                      <span class="leading-snug">{category.name}</span>
                      <span class="text-base text-slate-400 group-hover:text-emerald-700 opacity-0 group-hover:opacity-100 transition-opacity ml-1.5 shrink-0">
                        &rarr;
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </div>

      <!-- Right 4 Cols: Featured Insight Spotlight Card with Image -->
      <div class="lg:col-span-4 flex flex-col justify-between bg-slate-50/80 p-5 sm:p-6 rounded-none border border-slate-200/70 hover:border-emerald-300 transition-colors">
        <div>
          <!-- Header Badge & Read Time -->
          <div class="flex items-center justify-between mb-3.5">
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-800 bg-emerald-100/80 px-3 py-1 rounded-none">
              Featured Insight
            </span>
            <span class="text-xs text-slate-500 font-medium">
              {activeFeatured?.readTime || 4} min read
            </span>
          </div>

          <!-- Featured Card Link & Content -->
          <a
            href={activeFeatured?.seoSlug ? `/insights/${activeFeatured.category?.slug || 'blogs'}/${activeFeatured.seoSlug}` : '/insights'}
            class="group/feat block"
          >
            <!-- Image with subtle hover zoom effect -->
            <div class="relative h-36 sm:h-44 rounded-none overflow-hidden mb-3.5 border border-slate-200/80 shadow-xs group-hover/feat:shadow-md transition-all">
              <img
                src={featuredImage}
                alt={activeFeatured?.title || 'Featured Insight'}
                class="w-full h-full object-cover object-center group-hover/feat:scale-105 transition-transform duration-500"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <span class="absolute bottom-2.5 left-2.5 text-[10.5px] font-bold uppercase tracking-wider text-white bg-emerald-800/90 backdrop-blur-xs px-2.5 py-0.5 rounded-none">
                {activeFeatured?.category?.name || 'Compliance & Strategy'}
              </span>
            </div>

            <!-- Headline -->
            <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover/feat:text-emerald-700 transition-colors leading-snug line-clamp-2 mb-2">
              {activeFeatured?.title || 'UK Simpler Recycling Mandate: Complete Business Compliance Guide'}
            </h3>

            <!-- Excerpt -->
            <p class="text-xs sm:text-[13.5px] text-slate-600 leading-relaxed line-clamp-2 mb-3">
              {activeFeatured?.excerpt || 'Key timelines, legal duties, and practical steps for business leaders preparing for mandatory workplace recycling reforms.'}
            </p>
          </a>

          <!-- Meta (Author & Date) -->
          <div class="flex items-center gap-2 pt-2.5 border-t border-slate-200/70 text-xs text-slate-500">
            <span class="font-semibold text-slate-700">{activeFeatured?.author || 'Techsteps Advisory'}</span>
            <span>&bull;</span>
            <span>{activeFeatured?.date || 'March 2025'}</span>
          </div>
        </div>

        <!-- Card Footer -->
        <div class="mt-4 pt-3 border-t border-slate-200 flex items-center justify-between text-xs sm:text-sm">
          <a
            href="/insights"
            class="font-bold text-emerald-700 hover:text-emerald-900 flex items-center gap-1.5 transition-colors group/hub"
          >
            <span>View All Insights Hub</span>
            <span class="inline-block transition-transform duration-150 group-hover/hub:translate-x-1">&rarr;</span>
          </a>
          <span class="text-[11px] text-slate-400 font-mono">Live CMS Data</span>
        </div>
      </div>
    </div>

    <!-- Bottom Utility Footer -->
    <div class="relative z-10 mt-6 pt-4 border-t border-slate-100 flex items-center justify-end text-sm">
      <a
        href="/insights"
        class="font-bold text-white bg-[#0F623A] hover:bg-[#0c4e2e] flex items-center gap-2 px-6 py-2.5 rounded-full shadow-sm hover:shadow-md transition-all shrink-0"
      >
        <span>Explore All Articles &amp; Case Studies</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</div>
