---
import { insightsApi } from '../../lib/insightsApi';

let allPosts: any[] = [];

try {
  const postsRes = await insightsApi.getAllPosts(8);
  allPosts = postsRes || [];
} catch (e) {
  console.error('Failed to load insights for megamenu:', e);
}

// 3 Curated Categories requested: Blogs, Testimonials, Impact
const curatedCategories = [
  {
    name: 'Blogs',
    slug: 'blogs',
    tagline: 'Expert Analysis & Guides',
    description: 'In-depth articles on ITAD standards, NIST 800-88 media sanitisation, and regulatory compliance.',
  },
  {
    name: 'Testimonials',
    slug: 'testimonials',
    tagline: 'Client & Partner Reviews',
    description: 'Verified feedback from UK public sector bodies, NHS trusts, and enterprise corporate partners.',
  },
  {
    name: 'Impact Content',
    slug: 'impact-metrics',
    tagline: 'Sustainability & ESG',
    description: 'Scope 3 emissions reduction data, zero-landfill avoidance statistics, and circular economy metrics.',
  },
];

// Default featured post fallback with rich details & image if CMS empty
const fallbackFeatured = {
  title: 'UK Simpler Recycling Mandate: Complete Business Compliance Guide',
  excerpt: 'Key timelines, legal duties, and practical steps for business leaders preparing for mandatory workplace recycling reforms.',
  readTime: 4,
  author: 'Techsteps Advisory',
  date: 'March 2025',
  category: { slug: 'blogs', name: 'Blogs' },
  seoSlug: 'uk-simpler-recycling-mandate-business-guide',
  coverImage: '/images/services/sustainability-approach.jpg'
};

const activeFeatured = (allPosts && allPosts.length > 0)
  ? (allPosts.find(p => p.featured) || allPosts[0])
  : fallbackFeatured;

const featuredImage = activeFeatured?.coverImage || activeFeatured?.image || '/images/services/sustainability-approach.jpg';
---

<!-- Insights Full-Width Mega Dropdown Panel -->
<div
  id="insights-megamenu-panel"
  class="hidden fixed inset-x-0 z-50 transition-all duration-200 transform opacity-0 -translate-y-2 pointer-events-none px-4 sm:px-6 lg:px-8 max-h-[calc(100vh-90px)] overflow-y-auto"
  role="region"
  aria-label="Insights Navigation"
>
  <div class="relative max-w-[1540px] mx-auto bg-white rounded-none shadow-2xl border border-black/10 py-8 sm:py-10 lg:py-12 px-8 sm:px-12 lg:px-14 flex flex-col justify-between overflow-hidden font-sans">
    <!-- Top Content Grid: 3 Curated Knowledge Pillars + Featured Article Spotlight Card -->
    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 flex-1 items-start">
      
      <!-- Left 8 Cols: 3 Core Categories -->
      <div class="lg:col-span-8 border-b lg:border-b-0 lg:border-r border-slate-100 pb-6 lg:pb-0 lg:pr-8">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-7 lg:gap-8">
          {curatedCategories.map((cat) => (
            <a
              href={`/insights/${cat.slug}`}
              class="group block space-y-3 p-4 rounded-xl hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all duration-200"
            >
              <div class="flex items-center gap-2 pb-2 border-b border-slate-200">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 shrink-0"></span>
                <h4 class="text-[16px] sm:text-[17px] font-bold uppercase tracking-wider text-slate-900 group-hover:text-emerald-700 transition-colors">
                  {cat.name}
                </h4>
              </div>

              <span class="inline-block text-xs font-semibold text-emerald-700 uppercase tracking-wider">
                {cat.tagline}
              </span>

              <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed font-normal group-hover:text-slate-800 transition-colors">
                {cat.description}
              </p>

              <div class="pt-2 flex items-center gap-1 text-xs font-bold text-emerald-700 group-hover:gap-2 transition-all">
                <span>Browse {cat.name}</span>
                <span>&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Right 4 Cols: Featured Insight Spotlight Card with Image -->
      <div class="lg:col-span-4 flex flex-col justify-between bg-slate-50/80 p-5 sm:p-6 rounded-none border border-slate-200/70 hover:border-emerald-300 transition-colors">
        <div>
          <!-- Header Badge & Read Time -->
          <div class="flex items-center justify-between mb-3.5">
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-800 bg-emerald-100/80 px-3 py-1 rounded-none">
              Featured Insight
            </span>
            <span class="text-xs text-slate-500 font-medium">
              {activeFeatured?.readTime || 4} min read
            </span>
          </div>

          <!-- Featured Card Link & Content -->
          <a
            href={activeFeatured?.seoSlug ? `/insights/${activeFeatured.category?.slug || 'blogs'}/${activeFeatured.seoSlug}` : '/insights'}
            class="group/feat block"
          >
            <!-- Image with subtle hover zoom effect -->
            <div class="relative h-36 sm:h-44 rounded-none overflow-hidden mb-3.5 border border-slate-200/80 shadow-xs group-hover/feat:shadow-md transition-all">
              <img
                src={featuredImage}
                alt={activeFeatured?.title || 'Featured Insight'}
                class="w-full h-full object-cover object-center group-hover/feat:scale-105 transition-transform duration-500"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <span class="absolute bottom-2.5 left-2.5 text-[10.5px] font-bold uppercase tracking-wider text-white bg-emerald-800/90 backdrop-blur-xs px-2.5 py-0.5 rounded-none">
                {activeFeatured?.category?.name || 'Blogs'}
              </span>
            </div>

            <!-- Headline -->
            <h3 class="text-base sm:text-lg font-bold text-slate-900 group-hover/feat:text-emerald-700 transition-colors leading-snug line-clamp-2 mb-2">
              {activeFeatured?.title || 'UK Simpler Recycling Mandate: Complete Business Compliance Guide'}
            </h3>

            <!-- Excerpt -->
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed line-clamp-2 font-normal">
              {activeFeatured?.excerpt}
            </p>
          </a>
        </div>

        <!-- Card Footer -->
        <div class="mt-4 pt-3.5 border-t border-slate-200/70 flex items-center justify-between text-xs text-slate-500">
          <span>By {activeFeatured?.author || 'Techsteps Advisory'}</span>
          <a
            href={activeFeatured?.seoSlug ? `/insights/${activeFeatured.category?.slug || 'blogs'}/${activeFeatured.seoSlug}` : '/insights'}
            class="font-bold text-emerald-800 hover:text-emerald-950 inline-flex items-center gap-1 group-hover/feat:gap-1.5 transition-all"
          >
            <span>Read Article</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Utility Footer -->
    <div class="relative z-10 mt-6 sm:mt-7 pt-4 sm:pt-5 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm">
      <div class="flex items-center gap-2 text-slate-500 font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        <span>Independent analysis from certified UK ITAD &amp; information governance consultants.</span>
      </div>

      <div class="flex items-center gap-4 shrink-0">
        <a
          href="/insights"
          class="font-bold text-white bg-emerald-800 hover:bg-emerald-900 flex items-center gap-2 px-5 py-2 rounded-none shadow-xs hover:shadow-sm transition-all"
        >
          <span>Explore All Insights</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</div>
