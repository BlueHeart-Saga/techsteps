---
import { insightsApi, isPublishedPost, type Post } from '../../lib/insightsApi';
import { getCategoryDescription, formatCategoryTitle } from '../../lib/insightsCategories';

let allPosts: Post[] = [];

try {
  const postsRes = await insightsApi.getAllPosts(100);
  allPosts = (postsRes || []).filter(isPublishedPost);
} catch (e) {
  console.error('Failed to load insights for megamenu:', e);
}

// Derive active real categories with published posts dynamically from backend
const categoryCountMap = new Map<string, { name: string; slug: string; count: number }>();
for (const p of allPosts) {
  const slug = p.category?.slug;
  if (slug) {
    if (!categoryCountMap.has(slug)) {
      categoryCountMap.set(slug, {
        name: p.category.name || formatCategoryTitle(p.category.name, slug),
        slug,
        count: 0,
      });
    }
    categoryCountMap.get(slug)!.count++;
  }
}

// Preferred core knowledge pillars that have published posts (excluding case-studies which lives at /case-studies hub)
const pillarOrder = ['blogs', 'impact-metrics', 'company-announcements', 'awards-milestones'];
const realCategories = Array.from(categoryCountMap.values())
  .filter((c) => c.count > 0 && c.slug !== 'case-studies')
  .sort((a, b) => {
    const idxA = pillarOrder.indexOf(a.slug);
    const idxB = pillarOrder.indexOf(b.slug);
    return (idxA !== -1 ? idxA : 99) - (idxB !== -1 ? idxB : 99);
  })
  .slice(0, 3)
  .map((cat) => {
    let tagline = 'Enterprise Intelligence';
    if (cat.slug === 'blogs') tagline = 'Expert Analysis & Guides';
    else if (cat.slug === 'impact-metrics') tagline = 'Sustainability & ESG';
    else if (cat.slug === 'company-announcements') tagline = 'Official Announcements';
    else if (cat.slug === 'awards-milestones') tagline = 'Awards & Milestones';

    return {
      name: cat.name,
      slug: cat.slug,
      tagline,
      description: getCategoryDescription(cat.slug),
    };
  });

// Dynamic featured post directly from backend
const activeFeatured = allPosts.length > 0
  ? (allPosts.find((p) => p.featured) || allPosts[0])
  : null;

const featuredImage = activeFeatured?.image || '/images/services/sustainability-approach.jpg';
const featuredUrl = activeFeatured
  ? `/insights/${activeFeatured.category?.slug || 'blogs'}/${activeFeatured.seoSlug || activeFeatured.id}`
  : '/insights';
---

<!-- Insights Full-Width Mega Dropdown Panel -->
<div
  id="insights-megamenu-panel"
  class="hidden fixed inset-x-0 z-50 transition-all duration-200 transform opacity-0 -translate-y-2 pointer-events-none px-4 sm:px-6 lg:px-8 max-h-[calc(100vh-90px)] overflow-y-auto pt-2 before:absolute before:-top-4 before:inset-x-0 before:h-4 before:content-['']"
  role="region"
  aria-label="Insights Navigation"
>
  <div class="relative max-w-[1540px] mx-auto bg-white rounded-[20px] shadow-2xl border border-black/10 py-8 sm:py-10 lg:py-12 px-8 sm:px-12 lg:px-14 flex flex-col justify-between overflow-hidden font-sans">
    <!-- Top Content Grid: 3 Curated Knowledge Pillars + Featured Article Spotlight Card -->
    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 flex-1 items-start">
      
      <!-- Left 8 Cols: 3 Core Categories -->
      <div class="lg:col-span-8 border-b lg:border-b-0 lg:border-r border-slate-100 pb-6 lg:pb-0 lg:pr-8">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-7 lg:gap-8">
          {realCategories.map((cat) => (
            <a
              href={`/insights/${cat.slug}`}
              class="group block space-y-3 p-4 rounded-[12px] hover:bg-slate-50 border border-transparent hover:border-slate-200 transition-all duration-200"
            >
              <div class="flex items-center gap-2 pb-2 border-b border-slate-200">
                <span class="w-2.5 h-2.5 rounded-full bg-emerald-600 shrink-0"></span>
                <h4 class="text-[16px] sm:text-[17px] font-semibold uppercase tracking-wider text-slate-900 group-hover:text-emerald-700 transition-colors">
                  {cat.name}
                </h4>
              </div>

              <span class="inline-block text-xs font-semibold text-emerald-700 uppercase tracking-wider">
                {cat.tagline}
              </span>

              <p class="text-sm sm:text-sm text-black leading-relaxed font-normal group-hover:text-slate-800 transition-colors">
                {cat.description}
              </p>

              <div class="pt-2 flex items-center gap-1 text-xs font-bold text-emerald-700 group-hover:gap-2 transition-all">
                <span>Browse {cat.name}</span>
                <span>&rarr;</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- Right 4 Cols: Featured Insight Spotlight Card with Image -->
      <div class="lg:col-span-4 flex flex-col justify-between bg-slate-50/80 p-5 sm:p-6 rounded-[16px] border border-slate-200/70 hover:border-emerald-300 transition-colors">
        <div>
          <!-- Header Badge & Read Time -->
          <div class="flex items-center justify-between mb-3.5">
            <span class="text-xs font-bold uppercase tracking-widest text-emerald-800 bg-emerald-100/80 px-3 py-1 rounded-full">
              Featured Insight
            </span>
            <span class="text-xs text-slate-500 font-medium">
              {activeFeatured?.readTime || 4} min read
            </span>
          </div>

          <!-- Featured Card Link & Content -->
          <a
            href={featuredUrl}
            class="group/feat block"
          >
            <!-- Image with subtle hover zoom effect -->
            <div class="relative h-36 sm:h-44 rounded-[12px] overflow-hidden mb-3.5 border border-slate-200/80 shadow-xs group-hover/feat:shadow-md transition-all">
              <img
                src={featuredImage}
                alt={activeFeatured?.title || 'Featured Insight'}
                class="w-full h-full object-cover object-center group-hover/feat:scale-105 transition-transform duration-500"
                loading="eager"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
              <span class="absolute bottom-2.5 left-2.5 text-[10.5px] font-bold uppercase tracking-wider text-white bg-emerald-800/90 backdrop-blur-xs px-2.5 py-0.5 rounded-[8px]">
                {activeFeatured?.category?.name || 'Insights'}
              </span>
            </div>

            <!-- Headline -->
            <h3 class="text-base sm:text-lg font-semibold text-slate-900 group-hover/feat:text-emerald-700 transition-colors leading-snug line-clamp-2 mb-2">
              {activeFeatured?.title || 'Latest Technical Insights & Industry Perspectives'}
            </h3>

            <!-- Excerpt -->
            <p class="text-sm sm:text-base text-black leading-relaxed line-clamp-2 font-normal">
              {activeFeatured?.excerpt}
            </p>
          </a>
        </div>

        <!-- Card Footer -->
        <div class="mt-4 pt-3.5 border-t border-slate-200/70 flex items-center justify-between text-xs text-slate-500">
          <span>By {activeFeatured?.author || 'Techsteps Advisory'}</span>
          <a
            href={featuredUrl}
            class="font-bold text-emerald-800 hover:text-emerald-950 inline-flex items-center gap-1 group-hover/feat:gap-1.5 transition-all"
          >
            <span>Read Article</span>
            <span>&rarr;</span>
          </a>
        </div>
      </div>

    </div>

    <!-- Bottom Utility Footer -->
    <div class="relative z-10 mt-6 sm:mt-7 pt-4 sm:pt-5 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs sm:text-sm">
      <div class="flex items-center gap-2 text-slate-500 font-medium">
        <span class="inline-block w-2 h-2 rounded-full bg-emerald-600 animate-pulse"></span>
        <span>Independent analysis from certified UK ITAD &amp; information governance consultants.</span>
      </div>

      <div class="flex items-center gap-4 shrink-0">
        <a
          href="/insights"
          class="font-bold text-white bg-emerald-800 hover:bg-emerald-900 flex items-center gap-2 px-5 py-2 rounded-[12px] shadow-xs hover:shadow-sm transition-all"
        >
          <span>Explore All Insights</span>
          <span>&rarr;</span>
        </a>
      </div>
    </div>
  </div>
</div>
