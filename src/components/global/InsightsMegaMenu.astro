---
import { insightsApi } from '../../lib/insightsApi';

let siteStructure: any[] = [];
let allPosts: any[] = [];

try {
  const [structureRes, postsRes] = await Promise.all([
    insightsApi.getFullSiteStructure(),
    insightsApi.getAllPosts(8)
  ]);
  siteStructure = structureRes || [];
  allPosts = postsRes || [];
} catch (e) {
  console.error('Failed to load insights for megamenu:', e);
}

// Extract real sections directly from CMS site structure
const sections = siteStructure.slice(0, 4);

const featuredPost = allPosts.find(p => p.featured) || allPosts[0];
---

<!-- Insights Full-Width Mega Dropdown Panel -->
<div
  id="insights-megamenu-panel"
  class="hidden fixed inset-x-0 z-50 transition-all duration-200 transform opacity-0 -translate-y-2 pointer-events-none px-4 sm:px-6 lg:px-8 max-h-[calc(100vh-90px)] overflow-y-auto"
  role="region"
  aria-label="Insights Navigation"
>
  <div class="relative max-w-[1540px] mx-auto bg-white rounded-[28px] sm:rounded-[32px] shadow-2xl border border-black/10 py-8 sm:py-10 lg:py-12 px-8 sm:px-12 lg:px-14 min-h-[460px] flex flex-col justify-between overflow-hidden font-sans">
    
    <!-- Top Content Grid: Dynamic Taxonomy Columns + Featured Article Spotlight Card -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 flex-1">
      
      <!-- Left 8 Cols: Dynamic Sections & Categories -->
      <div class="lg:col-span-8 grid grid-cols-1 sm:grid-cols-3 gap-6 sm:gap-8 border-b sm:border-b-0 sm:border-r border-slate-100 pb-6 sm:pb-0 sm:pr-8">
        {sections.map((section: any) => (
          <div class="space-y-3.5">
            <div class="flex items-center gap-2 pb-2 border-b border-slate-200/80">
              <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
              <h4 class="text-sm sm:text-base font-bold uppercase tracking-wider text-slate-900">
                {section.name}
              </h4>
            </div>

            <ul class="space-y-2">
              {(section.categories || []).map((category: any) => (
                <li>
                  <a
                    href={`/insights/${category.slug}`}
                    class="group flex items-center justify-between text-[15px] font-medium text-slate-600 hover:text-emerald-800 transition-colors py-1 px-1.5 rounded-lg hover:bg-slate-50"
                  >
                    <span>{category.name}</span>
                    <span class="text-sm text-slate-400 group-hover:text-emerald-700 opacity-0 group-hover:opacity-100 transition-opacity">
                      &rarr;
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      <!-- Right 4 Cols: Featured Insight Spotlight Card -->
      <div class="lg:col-span-4 flex flex-col justify-between bg-slate-50/80 p-6 rounded-2xl border border-slate-200/70">
        <div>
          <div class="flex items-center justify-between mb-3">
            <span class="text-[11px] font-bold uppercase tracking-widest text-emerald-700 bg-emerald-100/70 px-2.5 py-1 rounded-full">
              Featured Insight
            </span>
            {featuredPost && (
              <span class="text-sm text-slate-500 font-medium">
                {featuredPost.readTime} min read
              </span>
            )}
          </div>

          {featuredPost ? (
            <div>
              <a
                href={`/insights/${featuredPost.category?.slug || 'blogs'}/${featuredPost.seoSlug || featuredPost.id}`}
                class="group block"
              >
                <h3 class="text-lg sm:text-xl font-bold text-slate-900 group-hover:text-emerald-700 transition-colors leading-snug line-clamp-2 mb-2">
                  {featuredPost.title}
                </h3>
                <p class="text-sm sm:text-[15px] text-slate-600 leading-relaxed line-clamp-3 mb-4">
                  {featuredPost.excerpt}
                </p>
              </a>

              <div class="flex items-center gap-3 pt-3 border-t border-slate-200/80 text-sm text-slate-500">
                <span class="font-semibold text-slate-800">{featuredPost.author}</span>
                <span>&bull;</span>
                <span>{featuredPost.date}</span>
              </div>
            </div>
          ) : (
            <div class="text-[15px] text-slate-500 py-6">
              Browse our technical publications, compliance briefs, and whitepapers.
            </div>
          )}
        </div>

        <div class="mt-6 pt-4 border-t border-slate-200 flex items-center justify-between">
          <a
            href="/insights"
            class="text-sm font-bold text-emerald-700 hover:text-emerald-900 flex items-center gap-1.5 transition-colors"
          >
            <span>View All Insights Hub</span>
            <span>&rarr;</span>
          </a>
          <span class="text-xs text-slate-400 font-mono">Live CMS Data</span>
        </div>
      </div>
    </div>

    <!-- Bottom Utility Footer -->
    <div class="relative z-10 mt-6 pt-4 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm">
      <div class="flex items-center gap-2 bg-slate-50 px-4 py-2 rounded-full border border-slate-200/70">
        <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
        <span class="font-medium text-slate-700">
          ADISA Certified &bull; BS 10008 Legal Admissibility &bull; JSP 440 Security &bull; Zero-Landfill ITAD
        </span>
      </div>
      <a
        href="/insights"
        class="font-bold text-slate-900 hover:text-black flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-100 hover:bg-slate-200/80 border border-slate-200/80 transition-all shadow-xs hover:shadow-md"
      >
        <span>Explore All Articles &amp; Case Studies</span>
        <span>&rarr;</span>
      </a>
    </div>
  </div>
</div>
