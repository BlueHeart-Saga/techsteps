---
import { getSiteSettings } from '../../lib/sanity/client';
import TopBar from './TopBar.astro';

interface Props {
  isHome?: boolean;
  theme?: 'white' | 'transparent';
}

const { isHome, theme } = Astro.props;
const siteSettings = await getSiteSettings();

// Normalise path and handle trailing slashes consistently:
const rawPath = Astro.url.pathname || '';
const cleanPath = (rawPath.length > 1 && rawPath.endsWith('/')) ? rawPath.slice(0, -1) : rawPath;

const isFreeCollectionActive =
  cleanPath.startsWith('/services/collection') ||
  cleanPath.startsWith('/collection') ||
  cleanPath === '/book-pickup' ||
  cleanPath === '/av-media-equipment-collection' ||
  cleanPath === '/computer-collection' ||
  cleanPath === '/laptop-collection' ||
  cleanPath === '/mobile-device-collection' ||
  cleanPath === '/monitor-screen-collection' ||
  cleanPath === '/printer-copier-collection' ||
  cleanPath === '/server-collection';

const isServicesActive =
  (!isFreeCollectionActive && cleanPath.startsWith('/services')) ||
  cleanPath === '/information-management' ||
  cleanPath === '/it-lifecycle-services-destruction' ||
  cleanPath === '/secure-shredding-document-integrity' ||
  cleanPath === '/moving-relocation-services';

const isSectorsActive = cleanPath.startsWith('/sectors');
const isInsightsActive = cleanPath.startsWith('/insights');
const isAboutActive =
  cleanPath === '/about-us' ||
  cleanPath.startsWith('/leadership') ||
  cleanPath.startsWith('/our-commitment') ||
  cleanPath.startsWith('/our-people-culture') ||
  cleanPath.startsWith('/global-presence') ||
  cleanPath.startsWith('/sustainability') ||
  cleanPath.startsWith('/certifications') ||
  cleanPath.startsWith('/partners');
---

<!-- =====================================================
     TOP UTILITY BAR
     Scrolls away naturally as the user scrolls down
====================================================== -->
<TopBar />

<!-- =====================================================
     STATIC TOP NAVIGATION (HERO HEADER)
     Renders at the top with TopBar, scrolls away with hero
====================================================== -->
<header
  id="hero-header"
  class="relative z-[995] w-full bg-white border-b border-slate-200/80 shadow-[0_1px_3px_rgba(0,0,0,0.03)] transition-all duration-150"
>
  <div
    class="w-full max-w-[1240px] mx-auto h-[72px] sm:h-[74px] flex items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- LEFT: LOGO + NAVIGATION -->
    <div class="flex items-center h-full min-w-0 flex-1">

      <!-- LOGO -->
      <a
        href="/"
        class="flex items-center shrink-0 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#07572F] rounded-lg py-1 select-none"
        aria-label="Techsteps UK Home"
      >
        <div class="inline-flex items-center gap-1 sm:gap-1.5 select-none">
          <img
            src="/images/brand/logo.png"
            alt="Techsteps Logo"
            class="h-9 w-9 object-contain shrink-0 relative top-[1.5px]"
            width="36"
            height="36"
            loading="eager"
            decoding="async"
          />

          <div
            class="hero-logo-text select-none leading-none tracking-[-0.015em] relative -top-[1px]"
          >
            <span class="text-[#07572F]">Tech</span><span class="text-[#171717]">steps</span>
          </div>
        </div>
      </a>

      <!-- MAIN NAVIGATION -->
      <nav
        class="hidden lg:flex items-center h-full ml-8 xl:ml-10 gap-6 xl:gap-8 font-sans text-[15px] xl:text-[16px] font-medium tracking-tight text-slate-800"
        aria-label="Main Navigation"
      >

        <!-- FREE COLLECTION -->
        <a
          href="javascript:void(0)"
          id="free-collection-menu-trigger"
          data-route-active={isFreeCollectionActive ? "true" : "false"}
          class={`nav-link free-collection-megamenu-toggle py-2 px-0 transition-colors duration-150 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#07572F] rounded-sm whitespace-nowrap ${
            isFreeCollectionActive ? 'active text-[#07572F]' : 'hover:text-[#07572F]'
          }`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="free-collection-megamenu-panel"
          role="button"
        >
          Free Collection
        </a>

        <!-- SERVICES -->
        <a
          href="javascript:void(0)"
          id="services-menu-trigger"
          data-route-active={isServicesActive ? "true" : "false"}
          class={`nav-link services-megamenu-toggle py-2 px-0 transition-colors duration-150 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#07572F] rounded-sm ${
            isServicesActive ? 'active text-[#07572F]' : 'hover:text-[#07572F]'
          }`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="services-megamenu-panel"
          role="button"
        >
          Services
        </a>

        <!-- SECTORS -->
        <a
          href="javascript:void(0)"
          id="sectors-menu-trigger"
          data-route-active={isSectorsActive ? "true" : "false"}
          class={`nav-link sectors-dropdown-toggle py-2 px-0 transition-colors duration-150 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#07572F] rounded-sm ${
            isSectorsActive ? 'active text-[#07572F]' : 'hover:text-[#07572F]'
          }`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="sectors-dropdown-panel"
          role="button"
        >
          Sectors
        </a>

        <!-- INSIGHTS -->
        <a
          href="/insights"
          class={`nav-link py-2 px-0 transition-colors duration-150 whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-[#07572F] rounded-sm ${
            isInsightsActive ? 'active text-[#07572F]' : 'hover:text-[#07572F]'
          }`}
        >
          Insights
        </a>

        <!-- ABOUT US -->
        <a
          href="javascript:void(0)"
          id="about-menu-trigger"
          data-route-active={isAboutActive ? "true" : "false"}
          class={`nav-link about-megamenu-toggle py-2 px-0 transition-colors duration-150 whitespace-nowrap cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#07572F] rounded-sm ${
            isAboutActive ? 'active text-[#07572F]' : 'hover:text-[#07572F]'
          }`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="about-megamenu-panel"
          role="button"
        >
          About Us
        </a>
      </nav>
    </div>

    <!-- RIGHT SIDE -->
    <div class="flex items-center gap-3 xl:gap-3.5 shrink-0 ml-6">

      <!-- CONTACT BUTTON -->
      <a
        href={siteSettings.headerContactButtonLink || "/contact"}
        class="hidden lg:inline-flex items-center justify-center h-[42px] px-5 rounded-[10px] border border-[#07572F] bg-white hover:bg-[#07572F]/5 text-[#07572F] font-sans text-[15px] font-semibold tracking-tight transition-all duration-150 shadow-2xs whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-[#07572F]"
      >
        {siteSettings.headerContactButtonText || "Contact Us"}
      </a>

      <!-- REQUEST A COLLECTION -->
      <a
        href={siteSettings.headerRequestButtonLink || "/request-a-quote"}
        class="hidden sm:inline-flex items-center justify-center h-[42px] px-6 rounded-[10px] bg-[#07572F] hover:bg-[#054324] text-white font-sans text-[15px] font-semibold tracking-tight transition-all duration-150 shadow-xs hover:shadow-sm whitespace-nowrap focus:outline-none focus-visible:ring-2 focus-visible:ring-[#07572F] focus-visible:ring-offset-2"
      >
        {siteSettings.headerRequestButtonText || "Request a Collection"}
      </a>

      <!-- MOBILE MENU -->
      <button
        type="button"
        class="open-mobile-menu-btn lg:hidden p-2 rounded-[10px] text-slate-700 hover:text-black hover:bg-slate-100 focus:outline-none focus-visible:ring-2 focus-visible:ring-[#07572F] transition-colors"
        aria-label="Open mobile navigation menu"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>

    </div>
  </div>
</header>