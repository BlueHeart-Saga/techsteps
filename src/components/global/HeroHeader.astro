---
interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;
const currentPath = Astro.url.pathname;
---

<!-- NORMAL / TOP HEADER ONLY -->
<header
  id="hero-header"
  data-is-home={isHome ? "true" : "false"}
  class:list={[
    "relative z-[995] w-full",
    isHome
      ? "bg-transparent border-none shadow-none"
      : "bg-white border-b border-slate-100 shadow-[0_1px_3px_rgba(0,0,0,0.03)]"
  ]}
>
  <div
    class="w-full max-w-7xl mx-auto h-[74px] flex items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- LEFT: LOGO + NAVIGATION -->
    <div class="flex items-center h-full min-w-0 flex-1">

      <!-- LOGO -->
      <a
        href="/"
        class="flex items-center shrink-0 focus:outline-none focus:ring-2 focus:ring-[#07572F] rounded-lg py-1 select-none"
        aria-label="Techsteps UK Home"
      >
        <div class="inline-flex items-center gap-1 sm:gap-1.5 select-none">
          <img
            src="/images/brand/logo.png"
            alt="Techsteps Logo"
            class="h-9 w-9 object-contain shrink-0 relative -top-[2px]"
            width="36"
            height="36"
            loading="eager"
            decoding="async"
          />

          <div
            class="hero-logo-text select-none leading-none tracking-[-0.015em]"
          >
            <span class="text-[#07572F]">Tech</span><span class="text-[#171717]">steps</span>
          </div>
        </div>
      </a>

      <!-- MAIN NAVIGATION -->
      <nav
        class="hidden lg:flex items-center h-full ml-8 xl:ml-10 gap-6 xl:gap-7 font-sans text-[18px] font-medium tracking-[-0.01em]"
        aria-label="Main Navigation"
      >

        <!-- SERVICES -->
        <div class="relative flex items-center h-full nav-menu-trigger-wrap">
          <button
            type="button"
            id="services-menu-trigger"
            class="services-megamenu-toggle inline-flex items-center gap-1.5 py-2 px-0 text-[#171717] hover:text-[#07572F] transition-colors duration-150 cursor-pointer focus:outline-none"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="services-megamenu-panel"
          >
            <span>Services</span>

            <svg
              class="h-3.5 w-3.5 text-[#171717] transition-transform duration-200 caret-icon shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </button>
        </div>

        <!-- SECTORS -->
        <div class="relative flex items-center h-full nav-menu-trigger-wrap">
          <button
            type="button"
            id="sectors-menu-trigger"
            class="sectors-dropdown-toggle inline-flex items-center gap-1.5 py-2 px-0 text-[#171717] hover:text-[#07572F] transition-colors duration-150 cursor-pointer focus:outline-none"
            aria-expanded="false"
            aria-haspopup="true"
            aria-controls="sectors-dropdown-panel"
          >
            <span>Sectors</span>

            <svg
              class="h-3.5 w-3.5 text-[#171717] transition-transform duration-200 caret-icon shrink-0"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19 9l-7 7-7-7"
              />
            </svg>
          </button>
        </div>

        <!-- INSIGHTS -->
        <a
          href="/insights"
          class="py-2 px-0 text-[#171717] hover:text-[#07572F] transition-colors duration-150 whitespace-nowrap"
        >
          Insights
        </a>

        <!-- ABOUT US -->
        <a
          href="/about-us"
          class="py-2 px-0 text-[#171717] hover:text-[#07572F] transition-colors duration-150 whitespace-nowrap"
        >
          About Us
        </a>
      </nav>
    </div>

    <!-- RIGHT SIDE -->
    <div class="flex items-center gap-3 xl:gap-4 shrink-0 ml-6">

      <!-- CONTACT BUTTON -->
      <a
        href="/contact"
        class={isHome
          ? "hidden lg:inline-flex items-center justify-center h-[44px] px-5 xl:px-6 rounded-full border border-white/70 hover:border-white hover:bg-white/10 bg-transparent text-white font-sans text-[16px] font-semibold tracking-[-0.01em] transition-all duration-150 whitespace-nowrap focus:outline-none"
          : "hidden lg:inline-flex items-center justify-center h-[44px] px-5 xl:px-6 rounded-full border border-[#07572F] bg-white text-[#07572F] font-sans text-[16px] font-semibold tracking-[-0.01em] whitespace-nowrap"
        }
      >
        Contact Us
      </a>

      <!-- REQUEST A COLLECTION -->
      <a
        href="/request-a-quote"
        class={isHome
          ? "hidden sm:inline-flex items-center justify-center h-[44px] px-6 xl:px-7 rounded-full bg-white hover:bg-white/90 text-[#07572F] font-sans text-[16px] font-semibold tracking-[-0.01em] transition-all duration-150 shadow-sm whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-white"
          : "hidden sm:inline-flex items-center justify-center h-[44px] px-6 xl:px-7 rounded-full bg-[#07572F] hover:bg-[#054324] text-white font-sans text-[16px] font-semibold tracking-[-0.01em] transition-colors duration-150 focus:outline-none focus:ring-2 focus:ring-[#07572F] focus:ring-offset-2 whitespace-nowrap"
        }
      >
        Request a Collection
      </a>

      <!-- MOBILE MENU -->
      <button
        type="button"
        class:list={[
          "open-mobile-menu-btn lg:hidden p-2 rounded-lg focus:outline-none focus:ring-2 transition-colors",
          isHome
            ? "text-white hover:text-white hover:bg-white/10 focus:ring-white"
            : "text-slate-700 hover:text-black hover:bg-slate-100 focus:ring-emerald-400"
        ]}
        aria-label="Open mobile navigation menu"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>

    </div>
  </div>
</header>