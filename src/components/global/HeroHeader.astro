---
import { getSiteSettings } from '../../lib/sanity/client';

interface Props {
  isHome?: boolean;
  theme?: 'white' | 'transparent';
}

const { isHome, theme } = Astro.props;
const siteSettings = await getSiteSettings();

// Normalise path and handle trailing slashes consistently:
const rawPath = Astro.url.pathname || '';
const cleanPath = (rawPath.length > 1 && rawPath.endsWith('/')) ? rawPath.slice(0, -1) : rawPath;

// The exact routes that remain transparent:
// 1. Home: '/' or ''
// 2. Main Services: '/services'
// 3. Main Insights: '/insights'
// Note: /about-us (or /about) is white (the design reference).
const transparentExactRoutes = new Set(['', '/', '/insights']);

// Exact matching: only these exact paths are transparent; all others are white!
const isTransparent = theme
  ? theme === 'transparent'
  : transparentExactRoutes.has(cleanPath);

const isServicesActive =
  cleanPath.startsWith('/services') ||
  cleanPath === '/information-management' ||
  cleanPath === '/it-lifecycle-services-destruction' ||
  cleanPath === '/secure-shredding-document-integrity' ||
  cleanPath === '/moving-relocation-services';

const isSectorsActive = cleanPath.startsWith('/sectors');
const isInsightsActive = cleanPath.startsWith('/insights');
const isAboutActive =
  cleanPath === '/about-us' ||
  cleanPath.startsWith('/leadership') ||
  cleanPath.startsWith('/our-people-culture') ||
  cleanPath.startsWith('/global-presence') ||
  cleanPath.startsWith('/sustainability') ||
  cleanPath.startsWith('/certifications') ||
  cleanPath.startsWith('/partners');
---

<!-- NORMAL / TOP HEADER ONLY -->
<header
  id="hero-header"
  data-is-home={isTransparent ? "true" : "false"}
  class:list={[
    "relative z-[995] w-full transition-colors duration-200",
    isTransparent
      ? "bg-transparent border-none shadow-none"
      : "bg-white border-b border-slate-100 shadow-[0_1px_3px_rgba(0,0,0,0.03)]"
  ]}
>
  <div
    class="w-full max-w-7xl mx-auto h-[74px] flex items-center justify-between px-4 sm:px-6 lg:px-8"
  >
    <!-- LEFT: LOGO + NAVIGATION -->
    <div class="flex items-center h-full min-w-0 flex-1">

      <!-- LOGO -->
      <a
        href="/"
        class="flex items-center shrink-0 focus:outline-none focus:ring-2 focus:ring-[#07572F] rounded-lg py-1 select-none"
        aria-label="Techsteps UK Home"
      >
        <div class="inline-flex items-center gap-1 sm:gap-1.5 select-none">
          <img
            src="/images/brand/logo.png"
            alt="Techsteps Logo"
            class="h-9 w-9 object-contain shrink-0 relative top-[1.5px]"
            width="36"
            height="36"
            loading="eager"
            decoding="async"
          />

          <div
            class="hero-logo-text select-none leading-none tracking-[-0.015em] relative -top-[1px]"
          >
            <span class="text-[#07572F]">Tech</span><span class="text-[#171717]">steps</span>
          </div>
        </div>
      </a>

      <!-- MAIN NAVIGATION -->
      <nav
        class="hidden lg:flex items-center h-full ml-8 xl:ml-10 gap-6 xl:gap-7 font-sans text-[18px] font-medium tracking-[-0.01em]"
        aria-label="Main Navigation"
      >

        <!-- SERVICES -->
        <a
          href="javascript:void(0)"
          id="services-menu-trigger"
          data-route-active={isServicesActive ? "true" : "false"}
          class={`nav-link services-megamenu-toggle py-2 px-0 transition-colors duration-150 cursor-pointer focus:outline-none ${
            isServicesActive ? 'active' : ''
          }`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="services-megamenu-panel"
          role="button"
        >
          Services
        </a>

        <!-- SECTORS -->
        <a
          href="javascript:void(0)"
          id="sectors-menu-trigger"
          data-route-active={isSectorsActive ? "true" : "false"}
          class={`nav-link sectors-dropdown-toggle py-2 px-0 transition-colors duration-150 cursor-pointer focus:outline-none ${
            isSectorsActive ? 'active' : ''
          }`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="sectors-dropdown-panel"
          role="button"
        >
          Sectors
        </a>

        <!-- INSIGHTS -->
        <a
          href="/insights"
          class={`nav-link py-2 px-0 transition-colors duration-150 whitespace-nowrap focus:outline-none ${
            isInsightsActive ? 'active' : ''
          }`}
        >
          Insights
        </a>

        <!-- ABOUT US -->
        <a
          href="javascript:void(0)"
          id="about-menu-trigger"
          data-route-active={isAboutActive ? "true" : "false"}
          class={`nav-link about-megamenu-toggle py-2 px-0 transition-colors duration-150 whitespace-nowrap cursor-pointer focus:outline-none ${
            isAboutActive ? 'active' : ''
          }`}
          aria-expanded="false"
          aria-haspopup="true"
          aria-controls="about-megamenu-panel"
          role="button"
        >
          About Us
        </a>
      </nav>
    </div>

    <!-- RIGHT SIDE -->
    <div class="flex items-center gap-3 xl:gap-4 shrink-0 ml-6">

      <!-- CONTACT BUTTON -->
      <a
        href={siteSettings.headerContactButtonLink || "/contact"}
        class="hidden lg:inline-flex items-center justify-center h-[44px] px-5 xl:px-6 rounded-[12px] border border-[#07572F] bg-white hover:bg-slate-50 text-[#07572F] font-sans text-[16px] font-semibold tracking-[-0.01em] transition-all duration-150 shadow-xs whitespace-nowrap focus:outline-none"
      >
        {siteSettings.headerContactButtonText || "Contact Us"}
      </a>

      <!-- REQUEST A COLLECTION -->
      <a
        href={siteSettings.headerRequestButtonLink || "/request-a-quote"}
        class="hidden sm:inline-flex items-center justify-center h-[44px] px-6 xl:px-7 rounded-[12px] bg-[#07572F] hover:bg-[#054324] text-white font-sans text-[16px] font-semibold tracking-[-0.01em] transition-all duration-150 shadow-sm whitespace-nowrap focus:outline-none focus:ring-2 focus:ring-[#07572F] focus:ring-offset-2"
      >
        {siteSettings.headerRequestButtonText || "Request a Collection"}
      </a>

      <!-- MOBILE MENU -->
      <button
        type="button"
        class="open-mobile-menu-btn lg:hidden p-2 rounded-[12px] text-slate-700 hover:text-black hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-[#07572F] transition-colors"
        aria-label="Open mobile navigation menu"
      >
        <svg
          class="h-6 w-6"
          fill="none"
          viewBox="0 0 24 24"
          stroke="currentColor"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M4 6h16M4 12h16M4 18h16"
          />
        </svg>
      </button>

    </div>
  </div>
</header>