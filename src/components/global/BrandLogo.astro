---
interface Props {
  variant?: 'dark' | 'light';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  showTagline?: boolean;
  class?: string;
}

const {
  variant = 'dark',
  size = 'md',
  showTagline = false,
  class: className = '',
} = Astro.props;

const imageSizeMap = {
  sm: 'h-9 w-9',
  md: 'h-9 w-9',
  lg: 'h-10 w-10',
  xl: 'h-10 w-10',
};

const brandTextMap = {
  sm: 'text-[24px]',
  md: 'text-[24px]',
  lg: 'text-[26px]',
  xl: 'text-[28px]',
};
---

<div
  class:list={[
    'inline-flex items-center gap-1 sm:gap-1.5 select-none',
    className,
  ]}
>
  <img
    src="/images/brand/logo.png"
    alt="Techsteps Logo"
    class:list={[
      imageSizeMap[size],
      'object-contain shrink-0 relative -top-[2px]',
    ]}
    width="36"
    height="36"
    loading="eager"
    decoding="async"
  />

  <div class:list={[
    brandTextMap[size],
    'brand-logo-title leading-none tracking-[-0.025em] font-semibold font-sans',
  ]}>
    <span class={variant === 'light' ? 'text-white' : 'text-[#07572F]'}>Tech</span><span class={variant === 'light' ? 'text-white' : 'text-[#171717]'}>steps</span>
  </div>

  {showTagline && (
    <span class="sr-only">
      Secure Lifecycle Solutions
    </span>
  )}
</div>