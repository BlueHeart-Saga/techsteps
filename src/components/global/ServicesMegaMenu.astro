---
const servicePillars = [
  {
    id: 'information-management',
    title: 'Information Management',
    slug: 'information-management',
    subLinks: [
      { name: 'Digital Mailroom', slug: 'digital-mailroom' },
      { name: 'Document Management', slug: 'document-management' },
      { name: 'Document Scanning', slug: 'document-scanning' },
      { name: 'Document Storage', slug: 'document-storage' },
      { name: 'Heritage Storage', slug: 'heritage-storage' },
      { name: 'Tape & Media Storage', slug: 'tape-media-storage' },
      { name: 'Vault Storage', slug: 'vault-storage' },
    ],
  },
  {
    id: 'it-lifecycle',
    title: 'IT Lifecycle & Destruction',
    slug: 'it-lifecycle-services-destruction',
    subLinks: [
      { name: 'IT Asset Disposition Services (ITAD)', slug: 'it-asset-disposition-services' },
      { name: 'IT Asset Management Services (ITAM)', slug: 'it-asset-management-services' },
      { name: 'Remarketing & Recycling', slug: 'remarketing-recycling' },
      { name: 'Secure Collection Services', slug: 'secure-collection-services' },
      { name: 'Secure IT Disposal', slug: 'secure-it-disposal' },
      { name: 'Ultra Secure Hard Drive Destruction', slug: 'ultra-secure-hard-drive-destruction' },
    ],
  },
  {
    id: 'secure-shredding',
    title: 'Secure Shredding & Integrity',
    slug: 'secure-shredding-document-integrity',
    subLinks: [
      { name: 'Cardboard Recycling', slug: 'cardboard-recycling' },
      { name: 'Disposal Services', slug: 'disposal-services' },
      { name: 'Dry Mixed Recycling (DMR)', slug: 'dry-mixed-recycling' },
      { name: 'Home Shredding', slug: 'home-shredding' },
      { name: 'Off-Site Shredding', slug: 'off-site-shredding' },
      { name: 'On-Site Shredding', slug: 'on-site-shredding' },
      { name: 'Product Shredding', slug: 'product-shredding' },
      { name: 'Simpler Recycling Services', slug: 'simpler-recycling-services' },
    ],
  },
  {
    id: 'moving-relocation',
    title: 'Moving & Relocation Services',
    slug: 'moving-relocation-services',
    subLinks: [
      { name: 'Business Relocations', slug: 'business-relocations' },
      { name: 'Europe & International Domestic Moves', slug: 'europe-international-domestic-moves' },
      { name: 'Heritage Relocations & Storage', slug: 'heritage-relocations-storage' },
      { name: 'IT Relocations Specialist', slug: 'it-relocations-specialist' },
      { name: 'Laboratory Relocations & Storage', slug: 'laboratory-relocations-storage' },
      { name: 'Project Management', slug: 'project-management' },
    ],
  },
];
---

<!-- Services Mega Menu Panel -->
<div
  id="services-megamenu-panel"
  class="fixed top-[88px] sm:top-[96px] inset-x-0 z-[998] hidden opacity-0 -translate-y-2 transition-all duration-200 pointer-events-none before:absolute before:-top-6 before:inset-x-0 before:h-6 before:content-['']"
  role="region"
  aria-label="Services Mega Menu"
>
  <div class="max-w-[1300px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white/90 backdrop-blur-2xl rounded-2xl border border-slate-200/70 shadow-[0_28px_72px_-12px_rgba(15,23,42,0.16)] pointer-events-auto overflow-hidden">

      <div class="flex h-[360px] sm:h-[370px]">

        <!-- LEFT: Service tab buttons (Clean width, clean icons, bold text, clickable links) -->
        <div class="w-[340px] shrink-0 border-r border-slate-100 py-5 px-3.5 flex flex-col gap-1.5">
          {servicePillars.map((pillar, idx) => (
            <a
              href={`/${pillar.slug}`}
              data-service-tab={pillar.id}
              class={`service-tab-btn group w-full text-left flex items-center justify-between px-3 py-2.5 rounded-xl transition-all duration-150 cursor-pointer ${
                idx === 0
                  ? 'active-tab bg-slate-100/90 text-slate-950 font-bold'
                  : 'text-slate-600 hover:text-slate-950 hover:bg-slate-50'
              }`}
            >
              <div class="flex items-center gap-2.5 min-w-0">
                <!-- Icon: w-5 h-5 -->
                <span class={`shrink-0 transition-colors ${idx === 0 ? 'text-[#0F623A]' : 'text-slate-400 group-hover:text-[#0F623A]'}`}>
                  {pillar.id === 'it-lifecycle' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                    </svg>
                  )}
                  {pillar.id === 'information-management' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                    </svg>
                  )}
                  {pillar.id === 'secure-shredding' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 17v3m3-3v3m3-3v3" />
                    </svg>
                  )}
                  {pillar.id === 'moving-relocation' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" />
                    </svg>
                  )}
                </span>
                <!-- Pillar Name -->
                <span class="font-display text-[18px] sm:text-[19px] font-bold leading-snug tracking-tight">{pillar.title}</span>
              </div>
              <span class="text-slate-400 group-hover:text-[#0F623A] transition-all text-sm font-semibold opacity-0 group-hover:opacity-100 group-hover:translate-x-0.5">→</span>
            </a>
          ))}
          <div class="mt-auto pt-3 px-3">
            <a href="/services" class="text-[16px] sm:text-[17px] font-bold font-display tracking-wide text-[#0F623A] hover:underline underline-offset-4">
              All services overview →
            </a>
          </div>
        </div>

        <!-- MIDDLE: Sub-links per tab aligned to top without empty top gaps -->
        <div class="flex-1 relative">
          {servicePillars.map((pillar, idx) => (
            <div
              id={`tab-panel-${pillar.id}`}
              class={`service-tab-panel absolute inset-0 transition-all duration-200 ${
                idx === 0 ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'
              }`}
            >
              <div class="h-full pt-5 pb-5 px-7 sm:px-9 flex flex-col justify-start">
                <p class="text-[11px] font-mono tracking-widest uppercase text-slate-400 mb-2">{pillar.title}</p>
                <div class="grid grid-cols-2 gap-x-6 lg:gap-x-10 gap-y-1.5 sm:gap-y-2">
                  {pillar.subLinks.map((link) => (
                    <a
                      href={`/services/${link.slug}`}
                      class="group flex items-center justify-between py-1.5 px-2.5 rounded-lg hover:bg-slate-50/90 font-display text-[18px] sm:text-[19px] xl:text-[20px] font-bold text-slate-800 hover:text-[#0F623A] tracking-tight leading-tight transition-all duration-150"
                    >
                      <span class="pr-2">{link.name}</span>
                      <span class="opacity-0 group-hover:opacity-80 group-hover:translate-x-1 transition-all text-slate-400 group-hover:text-[#0F623A] text-sm font-semibold shrink-0">→</span>
                    </a>
                  ))}
                </div>
              </div>
            </div>
          ))}
        </div>

        <!-- RIGHT: Third Column (Sustainability Card) -->
        <div class="w-[290px] xl:w-[320px] shrink-0 hidden lg:flex flex-col p-4 border-l border-slate-100/80 bg-slate-50/50 rounded-r-2xl">
          <a
            href="/sustainability"
            class="group flex flex-col h-full justify-between"
          >
            <!-- Image (wider, reduced height) -->
            <div class="w-full flex-1 rounded-xl overflow-hidden bg-slate-100 shadow-sm border border-slate-200/60">
              <img
                src="/images/brand/story-sustainability.jpg"
                alt="Sustainability"
                class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105"
                loading="lazy"
              />
            </div>

            <!-- Link below image (only the link) -->
            <div class="pt-3 px-1 flex items-center justify-between">
              <span class="font-display text-[19px] sm:text-[20px] font-bold text-slate-800 group-hover:text-[#0F623A] transition-colors">
                Sustainability
              </span>
              <span class="text-slate-400 group-hover:text-[#0F623A] group-hover:translate-x-1 transition-all text-base font-bold">
                →
              </span>
            </div>
          </a>
        </div>

      </div>
    </div>
  </div>
</div>

<script>
  function setupServicesMegaMenu() {
    const triggers = document.querySelectorAll('#services-menu-trigger, .services-megamenu-toggle');
    const panel = document.getElementById('services-megamenu-panel');
    if (!panel || triggers.length === 0) return;

    let timeoutId: any = null;

    const tabBtns = panel.querySelectorAll<HTMLElement>('.service-tab-btn');
    const tabPanels = panel.querySelectorAll<HTMLElement>('.service-tab-panel');

    const switchTab = (tabId: string) => {
      tabBtns.forEach((btn) => {
        const iconSpan = btn.querySelector<HTMLElement>('span.shrink-0');
        const isTarget = btn.getAttribute('data-service-tab') === tabId;
        if (isTarget) {
          btn.classList.add('active-tab', 'bg-slate-100/90', 'text-slate-950', 'font-bold');
          btn.classList.remove('text-slate-600', 'hover:text-slate-950', 'hover:bg-slate-50');
          if (iconSpan) { iconSpan.classList.add('text-[#0F623A]'); iconSpan.classList.remove('text-slate-400'); }
        } else {
          btn.classList.remove('active-tab', 'bg-slate-100/90', 'text-slate-950', 'font-bold');
          btn.classList.add('text-slate-600', 'hover:text-slate-950', 'hover:bg-slate-50');
          if (iconSpan) { iconSpan.classList.remove('text-[#0F623A]'); iconSpan.classList.add('text-slate-400'); }
        }
      });
      tabPanels.forEach((p) => {
        if (p.id === `tab-panel-${tabId}`) {
          p.classList.remove('opacity-0', 'pointer-events-none');
          p.classList.add('opacity-100', 'pointer-events-auto');
        } else {
          p.classList.add('opacity-0', 'pointer-events-none');
          p.classList.remove('opacity-100', 'pointer-events-auto');
        }
      });
    };

    tabBtns.forEach((btn) => {
      const tabId = btn.getAttribute('data-service-tab');
      if (!tabId) return;
      btn.addEventListener('mouseenter', () => switchTab(tabId));
      btn.addEventListener('focus', () => switchTab(tabId));
    });

    const openMenu = () => {
      clearTimeout(timeoutId);
      const sectorsPanel = document.getElementById('sectors-dropdown-panel');
      const sectorsTriggers = document.querySelectorAll('#sectors-menu-trigger, .sectors-dropdown-toggle');
      if (sectorsPanel) {
        sectorsPanel.classList.add('hidden', 'opacity-0', '-translate-y-2', 'pointer-events-none');
        sectorsPanel.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
      }
      sectorsTriggers.forEach((t) => {
        t.setAttribute('aria-expanded', 'false');
        const caret = t.querySelector('.caret-icon');
        if (caret) caret.classList.remove('rotate-180');
      });
      panel.classList.remove('hidden');
      requestAnimationFrame(() => {
        panel.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
        panel.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        triggers.forEach((t) => {
          t.setAttribute('aria-expanded', 'true');
          const caret = t.querySelector('.caret-icon');
          if (caret) caret.classList.add('rotate-180');
        });
      });
    };

    const closeMenu = () => {
      timeoutId = setTimeout(() => {
        panel.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        panel.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
        triggers.forEach((t) => {
          t.setAttribute('aria-expanded', 'false');
          const caret = t.querySelector('.caret-icon');
          if (caret) caret.classList.remove('rotate-180');
        });
        setTimeout(() => { if (panel.classList.contains('opacity-0')) panel.classList.add('hidden'); }, 200);
      }, 200);
    };

    triggers.forEach((t) => {
      t.addEventListener('click', (e) => {
        e.stopPropagation(); e.preventDefault();
        const isExpanded = t.getAttribute('aria-expanded') === 'true';
        if (isExpanded) closeMenu(); else openMenu();
      });
      t.addEventListener('mouseenter', openMenu);
      t.addEventListener('mouseleave', closeMenu);
    });

    panel.addEventListener('mouseenter', () => clearTimeout(timeoutId));
    panel.addEventListener('mouseleave', closeMenu);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
    document.addEventListener('click', (e) => {
      let inside = false;
      triggers.forEach((t) => { if (t.contains(e.target as Node)) inside = true; });
      if (!panel.contains(e.target as Node) && !inside) closeMenu();
    });
  }

  setupServicesMegaMenu();
  document.addEventListener('astro:page-load', setupServicesMegaMenu);
</script>
