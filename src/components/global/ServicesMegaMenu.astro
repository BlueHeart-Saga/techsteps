  /* =========================================================
     RESPONSIVE
  ========================================================= */

  @media (max-width: 1024px) {

    #services-megamenu-panel
      .services-dropdown-card {

      height:
        auto;

      min-height:
        0;

      max-height:
        none;

      flex-direction:
        column;

    }


    #services-megamenu-panel
      .services-left-col {

      width:
        100%;

      margin-right:
        0;

      margin-bottom:
        1.5rem;

    }


    #services-megamenu-panel
      .services-right-col {

      margin-left:
        0;

      margin-top:
        1.5rem;

      padding-top:
        1rem;

      border-top:
        1px solid #f1f5f9;

      width:
        100%;

      min-width:
        100%;

      max-width:
        100%;

    }

  }

</style>


<script>

  function setupServicesMegaMenu() {

    const panel =
      document.getElementById(
        'services-megamenu-panel'
      );

    if (!panel) return;


    if (
      panel.dataset.navInitialized === 'true'
    ) {
      return;
    }


    panel.dataset.navInitialized =
      'true';


    const triggers =
      document.querySelectorAll<HTMLElement>(
        '#services-menu-trigger, .services-megamenu-toggle'
      );


    if (
      triggers.length === 0
    ) {
      return;
    }


    let closeTimeout:
      ReturnType<typeof setTimeout> | null =
        null;

    let hideTimeout:
      ReturnType<typeof setTimeout> | null =
        null;


    const tabBtns =
      panel.querySelectorAll<HTMLElement>(
        '.service-tab-btn'
      );


    const tabPanels =
      panel.querySelectorAll<HTMLElement>(
        '.service-tab-panel'
      );


    const activeTitle =
      panel.querySelector<HTMLElement>(
        '#active-pillar-title'
      );


    /* =========================================================
       POSITION + SCROLL NAV GLASS
    ========================================================= */

    const updatePosition = () => {

      const siteHeader =
        document.getElementById(
          'site-header'
        );


      const heroHeader =
        document.getElementById(
          'hero-header'
        );


      const card =
        document.getElementById(
          'services-megamenu-card'
        );


      const wrapper =
        document.getElementById(
          'services-megamenu-wrapper'
        );


      const isScrollNavActive =
        !!siteHeader &&
        !siteHeader.classList.contains(
          'opacity-0'
        ) &&
        !siteHeader.classList.contains(
          '-translate-y-full'
        );


      /* =====================================================
         SCROLL NAVBAR
      ===================================================== */

      if (
        isScrollNavActive &&
        siteHeader
      ) {

        if (card) {

          card.classList.add(
            'scroll-glass-active'
          );

          card.style.setProperty(
            'background',
            'rgba(250, 246, 238, 0.60)',
            'important'
          );

          card.style.setProperty(
            'background-color',
            'rgba(250, 246, 238, 0.60)',
            'important'
          );

          card.style.setProperty(
            '-webkit-backdrop-filter',
            'blur(12px)',
            'important'
          );

          card.style.setProperty(
            'backdrop-filter',
            'blur(12px)',
            'important'
          );

          card.style.setProperty(
            'border',
            '1px solid rgba(0, 0, 0, 0.10)',
            'important'
          );

          card.style.setProperty(
            'box-shadow',
            '0 16px 40px -10px rgba(0, 0, 0, 0.08)',
            'important'
          );

        }


        if (wrapper) {

          wrapper.classList.add(
            'scroll-dropdown-wrapper'
          );

        }


        const maxWrap =
          siteHeader.querySelector<HTMLElement>(
            ':scope > div'
          );


        const floatingBar =
          maxWrap?.querySelector<HTMLElement>(
            ':scope > div'
          );


        const ref =
          floatingBar ??
          siteHeader;


        const rect =
          ref.getBoundingClientRect();


        panel.style.top =
          `${Math.round(
            rect.bottom + 8
          )}px`;


        panel.style.left =
          `${Math.round(
            rect.left
          )}px`;


        panel.style.right =
          'auto';


        panel.style.width =
          `${Math.round(
            rect.width
          )}px`;


        if (card) {

          card.style.width =
            `${Math.round(
              rect.width
            )}px`;

          card.style.maxWidth =
            `${Math.round(
              rect.width
            )}px`;

        }

      }


      /* =====================================================
         NORMAL / HERO NAVBAR
      ===================================================== */

      else if (heroHeader) {

        if (card) {

          card.classList.remove(
            'scroll-glass-active'
          );

          card.style.removeProperty(
            'background'
          );

          card.style.removeProperty(
            'background-color'
          );

          card.style.removeProperty(
            '-webkit-backdrop-filter'
          );

          card.style.removeProperty(
            'backdrop-filter'
          );

          card.style.removeProperty(
            'border'
          );

          card.style.removeProperty(
            'box-shadow'
          );

        }


        if (wrapper) {

          wrapper.classList.remove(
            'scroll-dropdown-wrapper'
          );

        }


        const rect =
          heroHeader.getBoundingClientRect();


        panel.style.top =
          `${Math.round(
            rect.bottom + 8
          )}px`;


        panel.style.left =
          '';


        panel.style.right =
          '';


        panel.style.width =
          '';


        if (card) {

          card.style.width =
            '';

          card.style.maxWidth =
            '';

        }

      }

    };


    /* =========================================================
       BACKDROP
    ========================================================= */

    const updateBackdrop = () => {

      const backdrop =
        document.getElementById(
          'dropdown-backdrop'
        );


      if (!backdrop) return;


      const sectorsPanel =
        document.getElementById(
          'sectors-dropdown-panel'
        );


      const isServicesOpen =
        !panel.classList.contains(
          'hidden'
        ) &&
        !panel.classList.contains(
          'opacity-0'
        );


      const isSectorsOpen =
        sectorsPanel &&
        !sectorsPanel.classList.contains(
          'hidden'
        ) &&
        !sectorsPanel.classList.contains(
          'opacity-0'
        );


      if (
        isServicesOpen ||
        isSectorsOpen
      ) {

        backdrop.classList.add(
          'active'
        );

      } else {

        backdrop.classList.remove(
          'active'
        );

      }

    };


    /* =========================================================
       CANCEL CLOSE
    ========================================================= */

    const cancelClose = () => {

      if (closeTimeout) {

        clearTimeout(
          closeTimeout
        );

        closeTimeout =
          null;

      }


      if (hideTimeout) {

        clearTimeout(
          hideTimeout
        );

        hideTimeout =
          null;

      }

    };


    /* =========================================================
       SWITCH SERVICE TAB
    ========================================================= */

    const switchTab = (
      tabId: string,
      pillarTitle?: string
    ) => {

      tabBtns.forEach(
        (btn) => {

          const isTarget =
            btn.getAttribute(
              'data-service-tab'
            ) === tabId;


          if (isTarget) {

            btn.classList.add(
              'active-tab',
              'bg-[#BCE6CE]',
              'text-[#0F172A]'
            );


            btn.classList.remove(
              'text-[#1E293B]',
              'hover:bg-[#E0F2E7]'
            );

          } else {

            btn.classList.remove(
              'active-tab',
              'bg-[#BCE6CE]',
              'text-[#0F172A]'
            );


            btn.classList.add(
              'text-[#1E293B]',
              'hover:bg-[#E0F2E7]'
            );

          }

        }
      );


      if (
        activeTitle &&
        pillarTitle
      ) {

        activeTitle.textContent =
          pillarTitle;

      }


      tabPanels.forEach(
        (panelItem) => {

          if (
            panelItem.id ===
            `tab-panel-${tabId}`
          ) {

            panelItem.classList.remove(
              'opacity-0',
              'pointer-events-none'
            );


            panelItem.classList.add(
              'opacity-100',
              'pointer-events-auto'
            );

          } else {

            panelItem.classList.add(
              'opacity-0',
              'pointer-events-none'
            );


            panelItem.classList.remove(
              'opacity-100',
              'pointer-events-auto'
            );

          }

        }
      );

    };


    /* =========================================================
       TAB EVENTS
    ========================================================= */

    tabBtns.forEach(
      (btn) => {

        const tabId =
          btn.getAttribute(
            'data-service-tab'
          );


        const title =
          btn.getAttribute(
            'data-pillar-title'
          ) || '';


        if (!tabId) return;


        btn.addEventListener(
          'mouseenter',
          () =>
            switchTab(
              tabId,
              title
            )
        );


        btn.addEventListener(
          'focus',
          () =>
            switchTab(
              tabId,
              title
            )
        );

      }
    );


    /* =========================================================
       OPEN MENU
    ========================================================= */

    const openMenu = () => {

      cancelClose();


      window.dispatchEvent(
        new CustomEvent(
          'techsteps:close-sectors',
          {
            detail: {
              immediate: true
            }
          }
        )
      );
window.dispatchEvent(
  new CustomEvent('techsteps:close-about')
);

      updatePosition();


      panel.classList.remove(
        'hidden'
      );


      void panel.offsetHeight;


      panel.classList.remove(
        'opacity-0',
        '-translate-y-1',
        'pointer-events-none'
      );


      panel.classList.add(
        'opacity-100',
        'translate-y-0',
        'pointer-events-auto'
      );


      triggers.forEach(
        (trigger) => {

          trigger.setAttribute(
            'aria-expanded',
            'true'
          );


          const caret =
            trigger.querySelector(
              '.caret-icon'
            );


          if (caret) {

            caret.classList.add(
              'rotate-180'
            );

          }

        }
      );


      updateBackdrop();

    };


    /* =========================================================
       CLOSE MENU
    ========================================================= */

    const closeMenu = (
      immediate = false
    ) => {

      const doClose = () => {

        panel.classList.remove(
          'opacity-100',
          'translate-y-0',
          'pointer-events-auto'
        );


        panel.classList.add(
          'opacity-0',
          '-translate-y-1',
          'pointer-events-none'
        );


        triggers.forEach(
          (trigger) => {

            trigger.setAttribute(
              'aria-expanded',
              'false'
            );


            const caret =
              trigger.querySelector(
                '.caret-icon'
              );


            if (caret) {

              caret.classList.remove(
                'rotate-180'
              );

            }

          }
        );


        updateBackdrop();


        if (hideTimeout) {

          clearTimeout(
            hideTimeout
          );

        }


        if (immediate) {

          panel.classList.add(
            'hidden'
          );

        } else {

          hideTimeout =
            setTimeout(
              () => {

                if (
                  panel.classList.contains(
                    'opacity-0'
                  )
                ) {

                  panel.classList.add(
                    'hidden'
                  );

                }


                hideTimeout =
                  null;

              },
              160
            );

        }

      };


      cancelClose();


      if (immediate) {

        doClose();

      } else {

        closeTimeout =
          setTimeout(
            doClose,
            280
          );

      }

    };


    /* =========================================================
       TRIGGER EVENTS

       IMPORTANT:
       The parent contains BOTH:
       - Services text
       - Services arrow

       So hovering either one opens
       the dropdown.
    ========================================================= */

    triggers.forEach(
      (trigger) => {

        const hoverTarget =
          trigger.parentElement as HTMLElement | null;


        if (!hoverTarget) return;


        /*
         * Hover Services text OR arrow.
         */
        hoverTarget.addEventListener(
          'mouseenter',
          openMenu
        );


        /*
         * No mouseleave close.
         *
         * Dropdown remains open until:
         * - outside click
         * - arrow click
         * - Escape
         * - Sectors opens
         */
        trigger.addEventListener(
          'click',
          (event) => {

            event.stopPropagation();
            event.preventDefault();


            const isExpanded =
              trigger.getAttribute(
                'aria-expanded'
              ) === 'true';


            if (isExpanded) {

              closeMenu(true);

            } else {

              openMenu();

            }

          }
        );


        /*
         * Keyboard accessibility.
         */
        trigger.addEventListener(
          'focus',
          openMenu
        );

      }
    );


    /* =========================================================
       PANEL HOVER
    ========================================================= */

    panel.addEventListener(
      'mouseenter',
      cancelClose
    );


    /* =========================================================
       CLOSE SERVICES EVENT
    ========================================================= */

    window.addEventListener(
      'techsteps:close-services',
      (event: Event) => {

        const customEvent =
          event as CustomEvent;


        closeMenu(
          customEvent.detail?.immediate ??
          true
        );

      }
    );


    /* =========================================================
       ESCAPE
    ========================================================= */

    document.addEventListener(
      'keydown',
      (event) => {

        if (
          event.key === 'Escape'
        ) {

          closeMenu(true);

        }

      }
    );


    /* =========================================================
       OUTSIDE CLICK
    ========================================================= */

    document.addEventListener(
      'click',
      (event) => {

        const target =
          event.target as Node;


        let insideTrigger =
          false;


        triggers.forEach(
          (trigger) => {

            if (
              trigger.contains(target) ||
              trigger.parentElement?.contains(target)
            ) {

              insideTrigger =
                true;

            }

          }
        );


        if (
          !panel.contains(target) &&
          !insideTrigger
        ) {

          closeMenu(true);

        }

      }
    );


    /* =========================================================
       BACKDROP CLICK
    ========================================================= */

    const backdrop =
      document.getElementById(
        'dropdown-backdrop'
      );


    backdrop?.addEventListener(
      'click',
      () =>
        closeMenu(true)
    );


    /* =========================================================
       LINK CLICK
    ========================================================= */

    panel
      .querySelectorAll('a')
      .forEach(
        (link) => {

          link.addEventListener(
            'click',
            () =>
              closeMenu(true)
          );

        }
      );


    /* =========================================================
       RESIZE + SCROLL
    ========================================================= */

    window.addEventListener(
      'resize',
      updatePosition,
      {
        passive: true
      }
    );


    window.addEventListener(
      'scroll',
      updatePosition,
      {
        passive: true
      }
    );

  }


  /* =========================================================
     INITIALIZE
  ========================================================= */

  setupServicesMegaMenu();


  document.addEventListener(
    'astro:page-load',
    () => {

      document
        .getElementById(
          'dropdown-backdrop'
        )
        ?.classList.remove(
          'active'
        );


      setupServicesMegaMenu();

    }
  );

</script>