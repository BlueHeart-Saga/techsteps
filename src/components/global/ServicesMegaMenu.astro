---

<!-- Services Mega Menu Floating Card (Sharp Box Edges, Clean Sub-Services Grid) -->
<div
  id="services-megamenu-panel"
  class="hidden fixed inset-x-0 z-50 transition-all duration-200 transform opacity-0 -translate-y-2 pointer-events-none px-4 sm:px-6 lg:px-8 max-h-[calc(100vh-90px)] overflow-y-auto pt-2 before:absolute before:-top-4 before:inset-x-0 before:h-4 before:content-['']"
  role="region"
  aria-label="Services Mega Navigation"
>
  <div class="relative max-w-7xl mx-auto bg-white rounded-none shadow-[0_25px_60px_-15px_rgba(15,23,42,0.18)] border border-slate-200/90 overflow-hidden font-sans">
    <div class="flex flex-col lg:flex-row">
      
      <!-- 1. LEFT SIDEBAR (Category Items with High-Level Icons & NO Background) -->
      <div class="w-full lg:w-72 bg-[#F8FAF9] p-4 sm:p-5 flex flex-col border-b lg:border-b-0 lg:border-r border-slate-200/80 shrink-0">
        <div class="space-y-1.5">
          <div class="px-3 py-2 text-[11px] font-bold uppercase tracking-wider text-slate-400">
            Divisions
          </div>

          {tabs.map((tab, idx) => {
            const isFirst = idx === 0;
            return (
              <button
                type="button"
                class={`services-tab-btn group w-full flex items-center gap-3 px-3.5 py-3 rounded-xl text-left text-sm transition-all duration-150 cursor-pointer ${
                  isFirst
                    ? 'bg-emerald-500/10 backdrop-blur-sm text-[#0F623A] font-bold shadow-sm active'
                    : 'text-slate-700 hover:text-[#0F623A] hover:bg-emerald-500/10 font-medium'
                }`}
                data-target-tab={`services-tab-${tab.id}`}
                data-slug={tab.slug}
              >
                <!-- High-Level Icon WITHOUT Background -->
                <span class={`tab-icon shrink-0 transition-colors ${
                  isFirst ? 'text-[#0F623A]' : 'text-slate-600 group-hover:text-[#0F623A]'
                }`}>
                  {tab.iconType === 'chip' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <rect x="4" y="4" width="16" height="16" rx="2" stroke-linecap="round" stroke-linejoin="round" />
                      <rect x="9" y="9" width="6" height="6" stroke-linecap="round" stroke-linejoin="round" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 1v3M15 1v3M9 20v3M15 20v3M20 9h3M20 15h3M1 9h3M1 15h3" />
                    </svg>
                  )}
                  {tab.iconType === 'database' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <ellipse cx="12" cy="5" rx="9" ry="3" stroke-linecap="round" stroke-linejoin="round" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                    </svg>
                  )}
                  {tab.iconType === 'shield' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
                    </svg>
                  )}
                  {tab.iconType === 'truck' && (
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                      <rect x="1" y="3" width="15" height="13" rx="1" stroke-linecap="round" stroke-linejoin="round" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M16 8h4l3 3v5h-7V8z" />
                      <circle cx="5.5" cy="18.5" r="2.5" />
                      <circle cx="18.5" cy="18.5" r="2.5" />
                    </svg>
                  )}
                </span>
                <span class="truncate">{tab.title}</span>
              </button>
            );
          })}
        </div>
      </div>

      <!-- 2. RIGHT MAIN CONTENT AREA: CENTER SUB-SERVICES + RIGHT SPOTLIGHT CARD -->
      <div class="flex-1 bg-white p-6 sm:p-8 lg:px-9 lg:pt-8 lg:pb-6 relative">
        {tabs.map((tab, idx) => {
          const isFirst = idx === 0;
          return (
            <div
              id={`services-tab-${tab.id}`}
              class={`services-tab-panel ${isFirst ? 'block' : 'hidden'} animate-in fade-in duration-150`}
            >
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start">
                
                <!-- CENTER AREA: Links related to the selected service's sub-services (Matching left sidebar font style) -->
                <div class="lg:col-span-7 space-y-4">
                  <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                    <span class="text-[11px] font-bold uppercase tracking-wider text-slate-400 font-sans">
                      {tab.title}
                    </span>
                    <a
                      href={`/${tab.slug}`}
                      class="text-xs font-bold text-[#0F623A] hover:text-black flex items-center gap-1 transition-colors group/link font-sans"
                    >
                      <span>Division Overview</span>
                    </a>
                  </div>

                  <!-- 2-Column Responsive Grid of Sub-Services (Font style matched to left sidebar: text-sm font-medium) -->
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-1.5 pt-1">
                    {tab.subServices.map((sub) => (
                      <a
                        href={`/services/${sub.slug}`}
                        class="group flex items-center justify-between py-2 px-3 rounded-lg hover:bg-emerald-500/10 transition-all duration-150"
                      >
                        <span class="text-sm font-medium text-slate-700 group-hover:text-[#0F623A] transition-colors leading-snug font-sans">
                          {sub.title}
                        </span>
                      </a>
                    ))}
                  </div>
                </div>

                <!-- RIGHT COLUMN: Featured Real Image & Directory Link (Enlarged) -->
                <div class="lg:col-span-5 space-y-3 lg:border-l lg:border-slate-100 lg:pl-8 flex flex-col justify-start">
                  <div class="w-full h-56 sm:h-64 lg:h-72 rounded-2xl overflow-hidden shadow-md border border-slate-200/90 bg-slate-100 relative group/img">
                    <img
                      src={tab.image}
                      alt={tab.title}
                      class="w-full h-full object-cover transition-transform duration-300 group-hover/img:scale-105"
                      loading="lazy"
                    />
                  </div>

                  <!-- Links placed below the image -->
                  <div class="pt-3 flex items-center justify-between gap-3 border-t border-slate-100">
                    <a
                      href="/services"
                      class="inline-flex items-center gap-1.5 text-xs sm:text-[13px] font-bold text-[#0F623A] hover:text-black transition-colors group/link"
                    >
                      <span>All 27 Services Directory</span>
                      <svg class="w-4 h-4 transition-transform duration-200 group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                      </svg>
                    </a>
                    <a
                      href="/investors"
                      class="inline-flex items-center gap-1.5 text-xs sm:text-[13px] font-bold text-[#0F623A] hover:text-black transition-colors group/link"
                    >
                      <span>Investors</span>
                      <svg class="w-4 h-4 transition-transform duration-200 group-hover/link:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 4.5L21 12m0 0l-7.5 7.5M21 12H3" />
                      </svg>
                    </a>
                  </div>
                </div>

              </div>
            </div>
          );
        })}
      </div>

    </div>
  </div>
</div>

<!-- Transparent Click-Outside Backdrop (No visual dimming to eliminate site blinking) -->
<div
  id="services-megamenu-backdrop"
  class="hidden fixed inset-0 z-40 bg-transparent transition-opacity duration-200 opacity-0 pointer-events-none"
  aria-hidden="true"
></div>

<script>
  function setupNavDropdowns() {
    const servicesPanel = document.getElementById('services-megamenu-panel');
    const sectorsPanel = document.getElementById('sectors-dropdown-panel');
    const insightsPanel = document.getElementById('insights-megamenu-panel');
    const backdrop = document.getElementById('services-megamenu-backdrop');
    const servicesToggles = document.querySelectorAll('.services-megamenu-toggle');
    const sectorsToggles = document.querySelectorAll('.sectors-dropdown-toggle');
    const insightsToggles = document.querySelectorAll('.insights-megamenu-toggle');

    if (!servicesPanel || !backdrop) return;

    let openMenu = null; // null | 'services' | 'sectors' | 'insights'
    let closeTimer = null;
    const GRACE_DELAY = 180;

    function updateDropdownPositions() {
      const stickyHeader = document.getElementById('site-header');
      const heroHeader = document.getElementById('hero-header');
      const isStickyVisible = stickyHeader && !stickyHeader.classList.contains('-translate-y-full') && stickyHeader.getBoundingClientRect().height > 0 && stickyHeader.getBoundingClientRect().top >= 0;
      
      let topOffset = 80;
      if (isStickyVisible) {
        topOffset = stickyHeader.getBoundingClientRect().bottom;
      } else if (heroHeader) {
        topOffset = heroHeader.getBoundingClientRect().bottom;
      } else if (stickyHeader) {
        topOffset = stickyHeader.getBoundingClientRect().bottom;
      }
      const topPx = `${Math.max(topOffset, 72)}px`;
      if (servicesPanel) servicesPanel.style.top = topPx;
      if (sectorsPanel) sectorsPanel.style.top = topPx;
      if (insightsPanel) insightsPanel.style.top = topPx;
    }

    function openServices() {
      if (openMenu === 'sectors') closeSectors(true);
      if (openMenu === 'insights') closeInsights(true);
      clearTimeout(closeTimer);
      openMenu = 'services';
      updateDropdownPositions();

      servicesPanel.classList.remove('hidden');
      backdrop.classList.remove('hidden');

      requestAnimationFrame(() => {
        servicesPanel.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
        servicesPanel.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
      });

      servicesToggles.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'true');
        btn.classList.add('border-slate-900', 'text-black');
        btn.classList.remove('border-transparent');
        const caret = btn.querySelector('.caret-icon');
        if (caret) {
          caret.classList.add('rotate-180', 'text-black');
          caret.classList.remove('text-slate-500');
        }
      });
    }

    function closeServices(immediate = false) {
      if (openMenu === 'services') openMenu = null;

      servicesPanel.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
      servicesPanel.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');

      if (openMenu !== 'sectors' && openMenu !== 'insights') {
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      }

      servicesToggles.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        if (btn.dataset.isActiveRoute !== 'true') {
          btn.classList.remove('border-slate-900', 'text-black');
          btn.classList.add('border-transparent');
        }
        const caret = btn.querySelector('.caret-icon');
        if (caret) {
          caret.classList.remove('rotate-180', 'text-black');
          caret.classList.add('text-slate-500');
        }
      });

      if (immediate) {
        servicesPanel.classList.add('hidden');
        if (openMenu !== 'sectors' && openMenu !== 'insights') backdrop.classList.add('hidden');
      } else {
        setTimeout(() => {
          if (openMenu !== 'services') {
            servicesPanel.classList.add('hidden');
            if (openMenu !== 'sectors' && openMenu !== 'insights') backdrop.classList.add('hidden');
          }
        }, 200);
      }
    }

    function openSectors() {
      if (!sectorsPanel) return;
      if (openMenu === 'services') closeServices(true);
      if (openMenu === 'insights') closeInsights(true);
      clearTimeout(closeTimer);
      openMenu = 'sectors';
      updateDropdownPositions();

      sectorsPanel.classList.remove('hidden');
      backdrop.classList.remove('hidden');

      requestAnimationFrame(() => {
        sectorsPanel.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
        sectorsPanel.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
      });

      sectorsToggles.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'true');
        btn.classList.add('border-slate-900', 'text-black');
        btn.classList.remove('border-transparent');
        const caret = btn.querySelector('.caret-icon');
        if (caret) {
          caret.classList.add('rotate-180', 'text-black');
          caret.classList.remove('text-slate-500');
        }
      });
    }

    function closeSectors(immediate = false) {
      if (!sectorsPanel) return;
      if (openMenu === 'sectors') openMenu = null;

      sectorsPanel.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
      sectorsPanel.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');

      if (openMenu !== 'services' && openMenu !== 'insights') {
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      }

      sectorsToggles.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        if (btn.dataset.isActiveRoute !== 'true') {
          btn.classList.remove('border-slate-900', 'text-black');
          btn.classList.add('border-transparent');
        }
        const caret = btn.querySelector('.caret-icon');
        if (caret) {
          caret.classList.remove('rotate-180', 'text-black');
          caret.classList.add('text-slate-500');
        }
      });

      if (immediate) {
        sectorsPanel.classList.add('hidden');
        if (openMenu !== 'services' && openMenu !== 'insights') backdrop.classList.add('hidden');
      } else {
        setTimeout(() => {
          if (openMenu !== 'sectors') {
            sectorsPanel.classList.add('hidden');
            if (openMenu !== 'services' && openMenu !== 'insights') backdrop.classList.add('hidden');
          }
        }, 200);
      }
    }

    function openInsights() {
      if (!insightsPanel) return;
      if (openMenu === 'services') closeServices(true);
      if (openMenu === 'sectors') closeSectors(true);
      clearTimeout(closeTimer);
      openMenu = 'insights';
      updateDropdownPositions();

      insightsPanel.classList.remove('hidden');
      backdrop.classList.remove('hidden');

      requestAnimationFrame(() => {
        insightsPanel.classList.remove('opacity-0', '-translate-y-2', 'pointer-events-none');
        insightsPanel.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');
        backdrop.classList.remove('opacity-0', 'pointer-events-none');
        backdrop.classList.add('opacity-100', 'pointer-events-auto');
      });

      insightsToggles.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'true');
        btn.classList.add('border-slate-900', 'text-black');
        btn.classList.remove('border-transparent');
        const caret = btn.querySelector('.caret-icon');
        if (caret) {
          caret.classList.add('rotate-180', 'text-black');
          caret.classList.remove('text-slate-500');
        }
      });
    }

    function closeInsights(immediate = false) {
      if (!insightsPanel) return;
      if (openMenu === 'insights') openMenu = null;

      insightsPanel.classList.add('opacity-0', '-translate-y-2', 'pointer-events-none');
      insightsPanel.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');

      if (openMenu !== 'services' && openMenu !== 'sectors') {
        backdrop.classList.add('opacity-0', 'pointer-events-none');
        backdrop.classList.remove('opacity-100', 'pointer-events-auto');
      }

      insightsToggles.forEach((btn) => {
        btn.setAttribute('aria-expanded', 'false');
        if (btn.dataset.isActiveRoute !== 'true') {
          btn.classList.remove('border-slate-900', 'text-black');
          btn.classList.add('border-transparent');
        }
        const caret = btn.querySelector('.caret-icon');
        if (caret) {
          caret.classList.remove('rotate-180', 'text-black');
          caret.classList.add('text-slate-500');
        }
      });

      if (immediate) {
        insightsPanel.classList.add('hidden');
        if (openMenu !== 'services' && openMenu !== 'sectors') backdrop.classList.add('hidden');
      } else {
        setTimeout(() => {
          if (openMenu !== 'insights') {
            insightsPanel.classList.add('hidden');
            if (openMenu !== 'services' && openMenu !== 'sectors') backdrop.classList.add('hidden');
          }
        }, 200);
      }
    }

    function closeAll(immediate = false) {
      clearTimeout(closeTimer);
      closeServices(immediate);
      closeSectors(immediate);
      closeInsights(immediate);
    }

    // Services trigger listeners
    servicesToggles.forEach((btn) => {
      btn.addEventListener('mouseenter', () => {
        clearTimeout(closeTimer);
        if (openMenu !== 'services') {
          openServices();
        }
      });

      btn.addEventListener('mouseleave', () => {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => {
          if (openMenu === 'services') closeServices();
        }, GRACE_DELAY);
      });

      btn.addEventListener('click', () => {
        closeAll(true);
      });
    });

    servicesPanel.addEventListener('mouseenter', () => {
      clearTimeout(closeTimer);
    });

    servicesPanel.addEventListener('mouseleave', () => {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        if (openMenu === 'services') closeServices();
      }, GRACE_DELAY);
    });

    // Sectors trigger listeners
    sectorsToggles.forEach((btn) => {
      btn.addEventListener('mouseenter', () => {
        clearTimeout(closeTimer);
        if (openMenu !== 'sectors') {
          openSectors();
        }
      });

      btn.addEventListener('mouseleave', () => {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => {
          if (openMenu === 'sectors') closeSectors();
        }, GRACE_DELAY);
      });

      btn.addEventListener('click', () => {
        closeAll(true);
      });
    });

    if (sectorsPanel) {
      sectorsPanel.addEventListener('mouseenter', () => {
        clearTimeout(closeTimer);
      });

      sectorsPanel.addEventListener('mouseleave', () => {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => {
          if (openMenu === 'sectors') closeSectors();
        }, GRACE_DELAY);
      });
    }

    // Insights trigger listeners
    insightsToggles.forEach((btn) => {
      btn.addEventListener('mouseenter', () => {
        clearTimeout(closeTimer);
        if (openMenu !== 'insights') {
          openInsights();
        }
      });

      btn.addEventListener('mouseleave', () => {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => {
          if (openMenu === 'insights') closeInsights();
        }, GRACE_DELAY);
      });

      btn.addEventListener('click', () => {
        closeAll(true);
      });
    });

    if (insightsPanel) {
      insightsPanel.addEventListener('mouseenter', () => {
        clearTimeout(closeTimer);
      });

      insightsPanel.addEventListener('mouseleave', () => {
        clearTimeout(closeTimer);
        closeTimer = setTimeout(() => {
          if (openMenu === 'insights') closeInsights();
        }, GRACE_DELAY);
      });
    }

    backdrop.addEventListener('click', () => {
      closeAll(true);
    });

    backdrop.addEventListener('mouseenter', () => {
      clearTimeout(closeTimer);
      closeTimer = setTimeout(() => {
        closeAll();
      }, GRACE_DELAY);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeAll(true);
    });

    window.addEventListener('resize', updateDropdownPositions);
    window.addEventListener('scroll', updateDropdownPositions, { passive: true });
  }

  // Interactive Tab Switcher for Services Mega Menu
  function setupServicesTabs() {
    const tabBtns = document.querySelectorAll('.services-tab-btn');
    const tabPanels = document.querySelectorAll('.services-tab-panel');
    if (!tabBtns.length) return;

    tabBtns.forEach((btn) => {
      const activate = () => {
        const targetId = btn.getAttribute('data-target-tab');
        tabBtns.forEach((b) => {
          b.classList.remove(
            'bg-emerald-500/10',
            'backdrop-blur-sm',
            'text-[#0F623A]',
            'font-bold',
            'shadow-xs',
            'shadow-sm',
            'active',
            'border-emerald-400/40',
            'ring-1',
            'ring-emerald-400/20'
          );
          b.classList.add(
            'text-slate-700',
            'hover:text-[#0F623A]',
            'hover:bg-emerald-500/10',
            'font-medium'
          );
          const icon = b.querySelector('.tab-icon');
          if (icon) {
            icon.classList.remove('text-[#0F623A]');
            icon.classList.add('text-slate-600');
          }
        });

        btn.classList.add(
          'bg-emerald-500/10',
          'backdrop-blur-sm',
          'text-[#0F623A]',
          'font-bold',
          'shadow-sm',
          'active'
        );
        btn.classList.remove('text-slate-700');
        const activeIcon = btn.querySelector('.tab-icon');
        if (activeIcon) {
          activeIcon.classList.add('text-[#0F623A]');
          activeIcon.classList.remove('text-slate-600');
        }

        tabPanels.forEach((panel) => {
          if (panel.id === targetId) {
            panel.classList.remove('hidden');
            panel.classList.add('block');
          } else {
            panel.classList.add('hidden');
            panel.classList.remove('block');
          }
        });
      };

      btn.addEventListener('mouseenter', activate);
      btn.addEventListener('click', () => {
        const slug = btn.getAttribute('data-slug');
        if (btn.classList.contains('active') && slug) {
          window.location.href = `/${slug}`;
        } else {
          activate();
        }
      });
    });
  }

  function init() {
    setupNavDropdowns();
    setupServicesTabs();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  #services-megamenu-panel,
  #services-megamenu-panel * {
    font-family: var(--font-sans) !important;
  }
</style>


