    /* =========================================================
   TRIGGER EVENTS
   ========================================================= */

triggers.forEach((t) => {

  const parentWrap =
    t.closest(
      '.nav-menu-trigger-wrap'
    ) as HTMLElement | null;

  const hoverTarget =
    parentWrap || t;


  /*
   * Hovering the Services text OR arrow
   * opens the dropdown.
   *
   * IMPORTANT:
   * We intentionally do NOT close the menu
   * when the mouse leaves the navbar item.
   */
  hoverTarget.addEventListener(
    'mouseenter',
    openMenu
  );


  /*
   * Arrow click:
   * toggle the dropdown.
   *
   * The Services text is now a normal <a>
   * and will navigate to /services.
   */
  t.addEventListener(
    'click',
    (e) => {

      e.stopPropagation();
      e.preventDefault();

      const isExpanded =
        t.getAttribute(
          'aria-expanded'
        ) === 'true';

      if (isExpanded) {
        closeMenu(true);
      } else {
        openMenu();
      }
    }
  );


  /*
   * Keyboard accessibility
   */
  t.addEventListener(
    'focus',
    openMenu
  );
});


    /* =========================================================
       PANEL HOVER
       ========================================================= */

    {/*panel.addEventListener(
      'mouseenter',
      cancelClose
    );

    panel.addEventListener(
      'mouseleave',
      () => closeMenu(false)
    );*/}
    /* =========================================================
   PANEL HOVER
   ========================================================= */

/*
 * Keep the dropdown open while the mouse
 * is anywhere inside the dropdown.
 *
 * We intentionally do NOT close it on mouseleave.
 */
panel.addEventListener(
  'mouseenter',
  cancelClose
);


    /* =========================================================
       CLOSE SERVICES EVENT
       ========================================================= */

    window.addEventListener(
      'techsteps:close-services',
      (e: any) => {
        closeMenu(
          e.detail?.immediate ?? true
        );
      }
    );


    /* =========================================================
       ESCAPE
       ========================================================= */

    document.addEventListener(
      'keydown',
      (e) => {

        if (e.key === 'Escape') {
          closeMenu(true);
        }
      }
    );


    /* =========================================================
       OUTSIDE CLICK
       ========================================================= */

    document.addEventListener(
      'click',
      (e) => {

        let inside = false;

        triggers.forEach((t) => {

          if (
            t.contains(
              e.target as Node
            )
          ) {
            inside = true;
          }
        });


        if (
          !panel.contains(
            e.target as Node
          ) &&
          !inside
        ) {
          closeMenu(true);
        }
      }
    );


    /* =========================================================
       BACKDROP CLICK
       ========================================================= */

    const backdrop =
      document.getElementById(
        'dropdown-backdrop'
      );

    backdrop?.addEventListener(
      'click',
      () => closeMenu(true)
    );


    /* =========================================================
       LINK CLICK
       ========================================================= */

    panel.querySelectorAll('a').forEach(
      (link) => {

        link.addEventListener(
          'click',
          () => closeMenu(true)
        );
      }
    );


    /* =========================================================
       RESIZE + SCROLL
       ========================================================= */

    window.addEventListener(
      'resize',
      updatePosition,
      { passive: true }
    );

    window.addEventListener(
      'scroll',
      updatePosition,
      { passive: true }
    );
  }


  /* =========================================================
     INITIALIZE
     ========================================================= */

  setupServicesMegaMenu();


  document.addEventListener(
    'astro:page-load',
    () => {

      document
        .getElementById(
          'dropdown-backdrop'
        )
        ?.classList.remove('active');

      setupServicesMegaMenu();
    }
  );
</script>