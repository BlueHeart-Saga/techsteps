---
import {
  getDivisions,
  getServices
} from '../../lib/sanity/client';

const [
  divisionsData,
  servicesData
] = await Promise.all([
  getDivisions(),
  getServices(),
]);

const defaultPillars = [
  {
    id: 'information-management',
    title: 'Information Management',
    slug: 'information-management',
    icon: '/icons/Information%20Management.svg',
    subLinks: [
      {
        name: 'Digital Mailroom',
        slug: 'digital-mailroom'
      },
      {
        name: 'Document Management',
        slug: 'document-management'
      },
      {
        name: 'Document Scanning',
        slug: 'document-scanning'
      },
      {
        name: 'Document Storage',
        slug: 'document-storage'
      },
      {
        name: 'Heritage Storage',
        slug: 'heritage-storage'
      },
      {
        name: 'Tape & Media Storage',
        slug: 'tape-media-storage'
      },
      {
        name: 'Vault Storage',
        slug: 'vault-storage'
      },
    ],
  },

  {
    id: 'it-lifecycle',
    title: 'IT Lifecycle & Destruction',
    slug: 'it-lifecycle-services-destruction',
    icon: '/icons/IT%20Lifecycle%20&%20Destruction.svg',
    subLinks: [
      {
        name: 'IT Asset Disposition Services (ITAD)',
        slug: 'it-asset-disposition-services'
      },
      {
        name: 'IT Asset Management Services (ITAM)',
        slug: 'it-asset-management-services'
      },
      {
        name: 'Remarketing & Recycling',
        slug: 'remarketing-recycling'
      },
      {
        name: 'Secure Collection Services',
        slug: 'secure-collection-services'
      },
      {
        name: 'Secure IT Disposal',
        slug: 'secure-it-disposal'
      },
      {
        name: 'Ultra Secure Hard Drive Destruction',
        slug: 'ultra-secure-hard-drive-destruction'
      },
    ],
  },

  {
    id: 'secure-shredding',
    title: 'Secure Shredding & Integrity',
    slug: 'secure-shredding-document-integrity',
    icon: '/icons/Secure%20Shredding%20&%20Integrity.svg',
    subLinks: [
      {
        name: 'Cardboard Recycling',
        slug: 'cardboard-recycling'
      },
      {
        name: 'Disposal Services',
        slug: 'disposal-services'
      },
      {
        name: 'Dry Mixed Recycling (DMR)',
        slug: 'dry-mixed-recycling'
      },
      {
        name: 'Home Shredding',
        slug: 'home-shredding'
      },
      {
        name: 'Off-Site Shredding',
        slug: 'off-site-shredding'
      },
      {
        name: 'On-Site Shredding',
        slug: 'on-site-shredding'
      },
      {
        name: 'Product Shredding',
        slug: 'product-shredding'
      },
      {
        name: 'Simpler Recycling Services',
        slug: 'simpler-recycling-services'
      },
    ],
  },

  {
    id: 'moving-relocation',
    title: 'Moving & Relocation Services',
    slug: 'moving-relocation-services',
    icon: '/icons/Moving%20&%20Relocation%20Services.svg',
    subLinks: [
      {
        name: 'Business Relocations',
        slug: 'business-relocations'
      },
      {
        name: 'Europe & International Domestic Moves',
        slug: 'europe-international-domestic-moves'
      },
      {
        name: 'Heritage Relocations & Storage',
        slug: 'heritage-relocations-storage'
      },
      {
        name: 'IT Relocations Specialist',
        slug: 'it-relocations-specialist'
      },
      {
        name: 'Laboratory Relocations & Storage',
        slug: 'laboratory-relocations-storage'
      },
      {
        name: 'Project Management',
        slug: 'project-management'
      },
    ],
  },
];


/* =========================================================
   COMBINE SANITY DATA WITH FALLBACK STRUCTURE
========================================================= */

const servicePillars =
  defaultPillars.map((pillar) => {

    if (
      servicesData &&
      servicesData.length > 0
    ) {

      const matching =
        servicesData.filter(
          (service: any) =>
            service.divisionSlug ===
              pillar.slug ||
            service.divisionSlug ===
              pillar.id ||
            service.divisionTitle
              ?.toLowerCase() ===
              pillar.title.toLowerCase()
        );


      if (matching.length > 0) {

        const sorted =
          [...matching].sort(
            (a: any, b: any) =>
              (
                a.title ||
                a.name ||
                ''
              ).localeCompare(
                b.title ||
                b.name ||
                ''
              )
          );


        return {
          ...pillar,

          subLinks:
            sorted.map(
              (service: any) => ({
                name:
                  service.title ||
                  service.name,

                slug:
                  service.slug,
              })
            ),
        };

      }

    }


    return pillar;

  });
---


<!-- =========================================================
     SERVICES MEGA MENU PANEL
========================================================= -->

<div
  id="services-megamenu-panel"
  class="fixed top-[82px] inset-x-0 z-[998] hidden opacity-0 -translate-y-1 transition-[opacity,transform] duration-150 ease-out pointer-events-none before:absolute before:-top-10 before:inset-x-0 before:h-10 before:content-[''] before:pointer-events-auto"
  role="region"
  aria-label="Services Mega Menu"
>

  <div
    id="services-megamenu-wrapper"
    class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
  >

    <div
      id="services-megamenu-card"
      class="services-dropdown-card bg-white rounded-[12px] border border-slate-200/80 shadow-[0_16px_48px_rgba(0,0,0,0.08)] pointer-events-auto p-4 sm:p-5 flex items-stretch w-full min-h-[322px] box-border"
    >

      <!-- =====================================================
           LEFT: SERVICES
      ====================================================== -->

      <div
        class="services-left-col w-[350px] xl:w-[370px] mr-12 xl:mr-16 shrink-0 rounded-[12px] px-5 pb-5 pt-6 flex flex-col justify-between box-border"
      >

        <div>

          <h3 class="text-[#5A6874] mb-3.5 px-2">
            Services
          </h3>


          <div class="space-y-1.5">

            {servicePillars.map(
              (pillar, idx) => (

                <a
                  href={`/${pillar.slug}`}
                  data-service-tab={pillar.id}
                  data-pillar-title={pillar.title}
                  class={`service-tab-btn group w-full text-left flex items-center gap-3.5 px-3.5 py-2.5 rounded-[8px] transition-all duration-150 cursor-pointer ${
                    idx === 0
                      ? 'active-tab bg-[#BCE6CE] text-[#0F172A]'
                      : 'text-[#1E293B] hover:bg-[#E0F2E7]'
                  }`}
                >

                  <span
                    class="shrink-0 flex items-center justify-center w-5 h-5"
                  >
                    <img
                      src={pillar.icon}
                      alt=""
                      class="w-5 h-5 object-contain"
                      width="20"
                      height="20"
                    />
                  </span>


                  <span class="pillar-label leading-snug">
                    {pillar.title}
                  </span>

                </a>

              )
            )}

          </div>

        </div>


        <!-- ALL SERVICES -->

        <a
          href="/services"
          class="all-services-link mt-auto pt-6 px-2 inline-flex items-center gap-1.5 text-[#171717] hover:text-[#07572F] transition-colors group"
        >

          <span>
            All services overview
          </span>

          <span
            class="text-sm font-bold transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          >
            ↗
          </span>

        </a>

      </div>


      <!-- =====================================================
           MIDDLE: DYNAMIC SERVICES
      ====================================================== -->

      <div
        class="services-middle-col flex-1 pt-6 flex flex-col justify-start relative"
      >

        <h3
          id="active-pillar-title"
          class="services-middle-heading text-[#5A6874] mb-3.5 transition-colors"
        >
          {servicePillars[0].title}
        </h3>


        {servicePillars.map(
          (pillar, idx) => {

            const col1 =
              pillar.subLinks.filter(
                (_, i) =>
                  i % 2 === 0
              );

            const col2 =
              pillar.subLinks.filter(
                (_, i) =>
                  i % 2 === 1
              );


            return (

              <div
                id={`tab-panel-${pillar.id}`}
                class={`service-tab-panel absolute top-[62px] inset-x-0 transition-opacity duration-150 ${
                  idx === 0
                    ? 'opacity-100 pointer-events-auto'
                    : 'opacity-0 pointer-events-none'
                }`}
              >

                <div
                  class="grid grid-cols-2 gap-x-16 xl:gap-x-24 gap-y-4 pt-0.5"
                >

                  <div class="space-y-4">

                    {col1.map(
                      (link) => (

                        <a
                          href={`/services/${link.slug}`}
                          class="block text-[#171717] hover:text-[#07572F] transition-colors leading-[1.45]"
                        >
                          {link.name}
                        </a>

                      )
                    )}

                  </div>


                  <div class="space-y-4">

                    {col2.map(
                      (link) => (

                        <a
                          href={`/services/${link.slug}`}
                          class="block text-[#171717] hover:text-[#07572F] transition-colors leading-[1.45]"
                        >
                          {link.name}
                        </a>

                      )
                    )}

                  </div>

                </div>

              </div>

            );

          }
        )}

      </div>


      <!-- =====================================================
           RIGHT: SUSTAINABILITY
      ====================================================== -->

      <div
        class="services-right-col w-[280px] shrink-0 pt-6 pb-[13px] pr-8 flex flex-col ml-8 xl:ml-12"
      >

        <h3
          class="services-right-heading text-[#5A6874] mb-5"
        >
          Sustainability
        </h3>


        <a
          href="/sustainability"
          class="group block shrink-0"
        >

          <div
            class="rounded-xl overflow-hidden shadow-xs border border-slate-200/60 bg-slate-100"
            style="width: 248px; height: 164.96px;"
          >

            <img
              src="/images/brand/sustainability.webp"
              alt="Sustainability"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
              width="248"
              height="165"
            />

          </div>

        </a>


        <a
          href="/sustainability"
          class="sustainability-link mt-[36px] inline-flex items-center gap-1.5 font-sans text-[16px] font-semibold text-[#171717] hover:text-[#07572F] transition-colors group"
        >

          <span>
            Visit
          </span>

          <span
            class="font-bold transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          >
            ↗
          </span>

        </a>

      </div>

    </div>

  </div>

</div>


<style>

  /* =========================================================
     BASE DROPDOWN
  ========================================================= */

  #services-megamenu-panel
    .services-dropdown-card {

    width: 100%;
    min-height: 322px;
    box-sizing: border-box;

    background:
      rgba(255, 255, 255, 0.98);

    border-radius: 12px;

    transition:
      background 220ms ease,
      backdrop-filter 220ms ease,
      -webkit-backdrop-filter 220ms ease,
      box-shadow 220ms ease,
      border-color 220ms ease;

  }


  /* =========================================================
     LEFT SERVICES PANEL
  ========================================================= */

  #services-megamenu-panel
    .services-left-col {

    background:
      #EEF7F2;

    border:
      1px solid transparent;

    transition:
      background 220ms ease,
      backdrop-filter 220ms ease,
      -webkit-backdrop-filter 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;

  }


  /* =========================================================
     SCROLL NAVBAR GLASS (EXACT SAME AS SCROLLING NAVBAR)
  ========================================================= */

  #services-megamenu-wrapper
    .services-dropdown-card.scroll-glass-active,
  #services-megamenu-card.scroll-glass-active {

    background:
      rgba(250, 246, 238, 0.60) !important;

    background-color:
      rgba(250, 246, 238, 0.60) !important;

    -webkit-backdrop-filter:
      blur(12px) !important;

    backdrop-filter:
      blur(12px) !important;

    border:
      1px solid rgba(0, 0, 0, 0.10) !important;

    box-shadow:
      0 16px 40px -10px rgba(0, 0, 0, 0.08) !important;

  }


  /* =========================================================
     SCROLL NAVBAR LEFT GREEN GLASS
  ========================================================= */

  #services-megamenu-wrapper
    .services-left-col {

    transition:
      background 220ms ease,
      backdrop-filter 220ms ease,
      -webkit-backdrop-filter 220ms ease,
      border-color 220ms ease,
      box-shadow 220ms ease;

  }


  #services-megamenu-wrapper.scroll-dropdown-wrapper
    .services-left-col {

    background:
      linear-gradient(
        135deg,
        rgba(238, 247, 242, 0.65),
        rgba(215, 240, 226, 0.50)
      ) !important;

    -webkit-backdrop-filter:
      blur(12px) !important;

    backdrop-filter:
      blur(12px) !important;

    border:
      1px solid rgba(188, 230, 206, 0.50) !important;

    box-shadow:
      inset 0 1px 0
      rgba(255, 255, 255, 0.50),

      inset 0 -1px 0
      rgba(15, 98, 58, 0.04),

      inset 0 0 35px
      rgba(188, 230, 206, 0.10),

      0 8px 24px
      rgba(15, 98, 58, 0.04);

  }


  /* =========================================================
     ACTIVE SERVICE
  ========================================================= */

  #services-megamenu-panel
    .service-tab-btn.active-tab {

    background-color:
      #BCE6CE !important;

    color:
      #0F172A !important;

  }


  /* =========================================================
     SCROLL NAV ACTIVE SERVICE
  ========================================================= */

  #services-megamenu-wrapper.scroll-dropdown-wrapper
    .service-tab-btn.active-tab {

    background:
      rgba(188, 230, 206, 0.90) !important;

    box-shadow:
      inset 0 1px 0
      rgba(255, 255, 255, 0.35);

  }


  /* =========================================================
     HOVER SERVICE
  ========================================================= */

  #services-megamenu-panel
    .service-tab-btn:not(.active-tab):hover {

    background-color:
      #E0F2E7;

    color:
      #0F172A;

  }


  #services-megamenu-wrapper.scroll-dropdown-wrapper
    .service-tab-btn:not(.active-tab):hover {

    background:
      rgba(224, 242, 231, 0.78) !important;

  }


  /* =========================================================
     TYPOGRAPHY
  ========================================================= */

  #services-megamenu-panel
    .services-left-col h3,

  #services-megamenu-panel
    .services-middle-heading,

  #services-megamenu-panel
    .services-right-heading {

    font-family:
      var(--font-sans) !important;

    font-size:
      16px;

    font-weight:
      500;

    letter-spacing:
