---
import { getDivisions, getServices } from '../../lib/sanity/client';

const [divisionsData, servicesData] = await Promise.all([
  getDivisions(),
  getServices(),
]);

const defaultPillars = [
  {
    id: 'information-management',
    title: 'Information Management',
    slug: 'information-management',
    icon: '/icons/Information%20Management.svg',
    subLinks: [
      { name: 'Digital Mailroom', slug: 'digital-mailroom' },
      { name: 'Document Management', slug: 'document-management' },
      { name: 'Document Scanning', slug: 'document-scanning' },
      { name: 'Document Storage', slug: 'document-storage' },
      { name: 'Heritage Storage', slug: 'heritage-storage' },
      { name: 'Tape & Media Storage', slug: 'tape-media-storage' },
      { name: 'Vault Storage', slug: 'vault-storage' },
    ],
  },
  {
    id: 'it-lifecycle',
    title: 'IT Lifecycle & Destruction',
    slug: 'it-lifecycle-services-destruction',
    icon: '/icons/IT%20Lifecycle%20&%20Destruction.svg',
    subLinks: [
      { name: 'IT Asset Disposition Services (ITAD)', slug: 'it-asset-disposition-services' },
      { name: 'IT Asset Management Services (ITAM)', slug: 'it-asset-management-services' },
      { name: 'Remarketing & Recycling', slug: 'remarketing-recycling' },
      { name: 'Secure Collection Services', slug: 'secure-collection-services' },
      { name: 'Secure IT Disposal', slug: 'secure-it-disposal' },
      { name: 'Ultra Secure Hard Drive Destruction', slug: 'ultra-secure-hard-drive-destruction' },
    ],
  },
  {
    id: 'secure-shredding',
    title: 'Secure Shredding & Integrity',
    slug: 'secure-shredding-document-integrity',
    icon: '/icons/Secure%20Shredding%20&%20Integrity.svg',
    subLinks: [
      { name: 'Cardboard Recycling', slug: 'cardboard-recycling' },
      { name: 'Disposal Services', slug: 'disposal-services' },
      { name: 'Dry Mixed Recycling (DMR)', slug: 'dry-mixed-recycling' },
      { name: 'Home Shredding', slug: 'home-shredding' },
      { name: 'Off-Site Shredding', slug: 'off-site-shredding' },
      { name: 'On-Site Shredding', slug: 'on-site-shredding' },
      { name: 'Product Shredding', slug: 'product-shredding' },
      { name: 'Simpler Recycling Services', slug: 'simpler-recycling-services' },
    ],
  },
  {
    id: 'moving-relocation',
    title: 'Moving & Relocation Services',
    slug: 'moving-relocation-services',
    icon: '/icons/Moving%20&%20Relocation%20Services.svg',
    subLinks: [
      { name: 'Business Relocations', slug: 'business-relocations' },
      { name: 'Europe & International Domestic Moves', slug: 'europe-international-domestic-moves' },
      { name: 'Heritage Relocations & Storage', slug: 'heritage-relocations-storage' },
      { name: 'IT Relocations Specialist', slug: 'it-relocations-specialist' },
      { name: 'Laboratory Relocations & Storage', slug: 'laboratory-relocations-storage' },
      { name: 'Project Management', slug: 'project-management' },
    ],
  },
];

// Combine dynamic Sanity data with fallback structure
const servicePillars = defaultPillars.map((pillar) => {
  if (servicesData && servicesData.length > 0) {
    const matching = servicesData.filter((s: any) =>
      s.divisionSlug === pillar.slug ||
      s.divisionSlug === pillar.id ||
      s.divisionTitle?.toLowerCase() === pillar.title.toLowerCase()
    );
    if (matching.length > 0) {
      const sorted = [...matching].sort((a: any, b: any) =>
        (a.title || a.name || '').localeCompare(b.title || b.name || '')
      );
      return {
        ...pillar,
        subLinks: sorted.map((s: any) => ({
          name: s.title || s.name,
          slug: s.slug,
        })),
      };
    }
  }
  return pillar;
});
---

<!-- Services Mega Menu Panel -->
<div
  id="services-megamenu-panel"
  class="fixed top-[82px] inset-x-0 z-[998] hidden opacity-0 -translate-y-1 transition-[opacity,transform] duration-150 ease-out pointer-events-none before:absolute before:-top-10 before:inset-x-0 before:h-10 before:content-[''] before:pointer-events-auto"
  role="region"
  aria-label="Services Mega Menu"
>
  <div id="services-megamenu-wrapper" class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div
      id="services-megamenu-card"
      class="services-dropdown-card bg-white rounded-[12px] border border-slate-200/80 shadow-[0_16px_48px_rgba(0,0,0,0.08)] pointer-events-auto p-4 sm:p-5 flex items-stretch w-full min-h-[322px] box-border"
    >

      <!-- LEFT: Products Column (Light mint background container) -->
      <div class="services-left-col w-[350px] xl:w-[370px] mr-12 xl:mr-16 shrink-0 bg-[#EEF7F2] rounded-[12px] px-5 pb-5 pt-6 flex flex-col justify-between box-border">
        <div>
          <h3 class="text-[#5A6874] mb-3.5 px-2">Services</h3>
          <div class="space-y-1.5">
            {servicePillars.map((pillar, idx) => (
              <a
                href={`/${pillar.slug}`}
                data-service-tab={pillar.id}
                data-pillar-title={pillar.title}
                class={`service-tab-btn group w-full text-left flex items-center gap-3.5 px-3.5 py-2.5 rounded-[8px] transition-all duration-150 cursor-pointer ${
                  idx === 0
                    ? 'active-tab bg-[#BCE6CE] text-[#0F172A]'
                    : 'text-[#1E293B] hover:bg-[#E0F2E7]'
                }`}
              >
                <!-- Left Icon matching reference -->
                <span class="shrink-0 flex items-center justify-center w-5 h-5">
                  <img
                    src={pillar.icon}
                    alt=""
                    class="w-5 h-5 object-contain"
                    width="20"
                    height="20"
                  />
                </span>
                <!-- Pillar Title -->
                <span class="pillar-label leading-snug">{pillar.title}</span>
              </a>
            ))}
          </div>
        </div>

        <!-- All services overview link matching reference image -->
        <a
          href="/services"
          class="all-services-link mt-auto pt-6 px-2 inline-flex items-center gap-1.5 text-[#171717] hover:text-[#07572F] transition-colors group"
        >
          <span>All services overview</span>
          <span class="text-sm font-bold transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
        </a>
      </div>

      <!-- MIDDLE: Dynamic Services Sublinks in 2 Clean Columns -->
      <div class="services-middle-col flex-1 pt-6 flex flex-col justify-start relative">
        <h3 id="active-pillar-title" class="services-middle-heading text-[#5A6874] mb-3.5 transition-colors">
          {servicePillars[0].title}
        </h3>

        {servicePillars.map((pillar, idx) => {
          const col1 = pillar.subLinks.filter((_, i) => i % 2 === 0);
          const col2 = pillar.subLinks.filter((_, i) => i % 2 === 1);

          return (
            <div
              id={`tab-panel-${pillar.id}`}
              class={`service-tab-panel absolute top-[62px] inset-x-0 transition-opacity duration-150 ${
                idx === 0 ? 'opacity-100 pointer-events-auto' : 'opacity-0 pointer-events-none'
              }`}
            >
              <div class="grid grid-cols-2 gap-x-16 xl:gap-x-24 gap-y-4 pt-0.5">
                <div class="space-y-4">
                  {col1.map((link) => (
                    <a
                      href={`/services/${link.slug}`}
                      class="block text-[#171717] hover:text-[#07572F] transition-colors leading-[1.45]"
                    >
                      {link.name}
                    </a>
                  ))}
                </div>
                <div class="space-y-4">
                  {col2.map((link) => (
                    <a
                      href={`/services/${link.slug}`}
                      class="block text-[#171717] hover:text-[#07572F] transition-colors leading-[1.45]"
                    >
                      {link.name}
                    </a>
                  ))}
                </div>
              </div>
            </div>
          );
        })}
      </div>

      <!-- RIGHT: Sustainability Column matching reference image -->
      <div class="services-right-col w-[280px] shrink-0 pt-6 pb-[13px] pr-8 flex flex-col ml-8 xl:ml-12">
        <h3 class="services-right-heading text-[#5A6874] mb-5">Sustainability</h3>
        <!-- Image link (image only, no Visit here) -->
        <a href="/sustainability" class="group block shrink-0">
          <div
            class="rounded-xl overflow-hidden shadow-xs border border-slate-200/60 bg-slate-100"
            style="width: 248px; height: 164.96px;"
          >
            <img
              src="/images/brand/sustainability.webp"
              alt="Sustainability"
              class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
              width="248"
              height="165"
            />
          </div>
        </a>
        <!-- Visit ↗ — mt-[36px] gives exactly 36px gap from image bottom -->
        <a
          href="/sustainability"
          class="sustainability-link mt-[36px] inline-flex items-center gap-1.5 font-['Inter',sans-serif] text-[16px] font-semibold text-[#171717] hover:text-[#07572F] transition-colors group"
        >
          <span>Visit</span>
          <span class="font-bold transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
        </a>
      </div>

    </div>
  </div>
</div>

<script>
  function setupServicesMegaMenu() {
    const panel = document.getElementById('services-megamenu-panel');
    if (!panel) return;

    if (panel.dataset.navInitialized === 'true') return;
    panel.dataset.navInitialized = 'true';

    const triggers = document.querySelectorAll<HTMLElement>('#services-menu-trigger, .services-megamenu-toggle');
    if (triggers.length === 0) return;

    let closeTimeout: any = null;
    let hideTimeout: any = null;

    const tabBtns = panel.querySelectorAll<HTMLElement>('.service-tab-btn');
    const tabPanels = panel.querySelectorAll<HTMLElement>('.service-tab-panel');
    const activeTitle = panel.querySelector<HTMLElement>('#active-pillar-title');

    const updatePosition = () => {
      const siteHeader = document.getElementById('site-header');
      const heroHeader = document.getElementById('hero-header');
      const card = document.getElementById('services-megamenu-card');
      const wrapper = document.getElementById('services-megamenu-wrapper');

      const isScrollNavActive =
        siteHeader &&
        !siteHeader.classList.contains('opacity-0') &&
        !siteHeader.classList.contains('-translate-y-full');

      if (isScrollNavActive && siteHeader) {
        const maxWrap = siteHeader.querySelector<HTMLElement>(':scope > div');
        const floatingBar = maxWrap?.querySelector<HTMLElement>(':scope > div');
        const ref = floatingBar ?? siteHeader;
        const rect = ref.getBoundingClientRect();

        panel.style.top = `${Math.round(rect.bottom + 8)}px`;
        panel.style.left = `${Math.round(rect.left)}px`;
        panel.style.right = 'auto';
        panel.style.width = `${Math.round(rect.width)}px`;

        if (wrapper) wrapper.classList.add('scroll-dropdown-wrapper');
        if (card) {
          card.style.width = `${Math.round(rect.width)}px`;
          card.style.maxWidth = `${Math.round(rect.width)}px`;
        }
      } else if (heroHeader) {
        const rect = heroHeader.getBoundingClientRect();

        panel.style.top = `${Math.round(rect.bottom + 8)}px`;
        panel.style.left = '';
        panel.style.right = '';
        panel.style.width = '';

        if (card) {
          card.style.width = '';
          card.style.maxWidth = '';
        }
        if (wrapper) wrapper.classList.remove('scroll-dropdown-wrapper');
      }
    };

    const updateBackdrop = () => {
      const backdrop = document.getElementById('dropdown-backdrop');
      if (!backdrop) return;
      const sectorsPanel = document.getElementById('sectors-dropdown-panel');
      const isServicesOpen = !panel.classList.contains('hidden') && !panel.classList.contains('opacity-0');
      const isSectorsOpen = sectorsPanel && !sectorsPanel.classList.contains('hidden') && !sectorsPanel.classList.contains('opacity-0');

      if (isServicesOpen || isSectorsOpen) {
        backdrop.classList.add('active');
      } else {
        backdrop.classList.remove('active');
      }
    };

    const cancelClose = () => {
      if (closeTimeout) {
        clearTimeout(closeTimeout);
        closeTimeout = null;
      }
      if (hideTimeout) {
        clearTimeout(hideTimeout);
        hideTimeout = null;
      }
    };

    const switchTab = (tabId: string, pillarTitle?: string) => {
      tabBtns.forEach((btn) => {
        const isTarget = btn.getAttribute('data-service-tab') === tabId;
        if (isTarget) {
          btn.classList.add('active-tab', 'bg-[#BCE6CE]', 'text-[#0F172A]');
          btn.classList.remove('text-[#1E293B]', 'hover:bg-[#E0F2E7]');
        } else {
          btn.classList.remove('active-tab', 'bg-[#BCE6CE]', 'text-[#0F172A]');
          btn.classList.add('text-[#1E293B]', 'hover:bg-[#E0F2E7]');
        }
      });

      if (activeTitle && pillarTitle) {
        activeTitle.textContent = pillarTitle;
      }

      tabPanels.forEach((p) => {
        if (p.id === `tab-panel-${tabId}`) {
          p.classList.remove('opacity-0', 'pointer-events-none');
          p.classList.add('opacity-100', 'pointer-events-auto');
        } else {
          p.classList.add('opacity-0', 'pointer-events-none');
          p.classList.remove('opacity-100', 'pointer-events-auto');
        }
      });
    };

    tabBtns.forEach((btn) => {
      const tabId = btn.getAttribute('data-service-tab');
      const title = btn.getAttribute('data-pillar-title') || '';
      if (!tabId) return;
      btn.addEventListener('mouseenter', () => switchTab(tabId, title));
      btn.addEventListener('focus', () => switchTab(tabId, title));
    });

    const openMenu = () => {
      cancelClose();

      // Close Sectors dropdown immediately with zero waiting
      window.dispatchEvent(new CustomEvent('techsteps:close-sectors', { detail: { immediate: true } }));

      updatePosition();

      panel.classList.remove('hidden');
      // Synchronous reflow to commit display:block before adding opacity
      void panel.offsetHeight;

      panel.classList.remove('opacity-0', '-translate-y-1', 'pointer-events-none');
      panel.classList.add('opacity-100', 'translate-y-0', 'pointer-events-auto');

      triggers.forEach((t) => {
        t.setAttribute('aria-expanded', 'true');
        const caret = t.querySelector('.caret-icon');
        if (caret) caret.classList.add('rotate-180');
      });

      updateBackdrop();
    };

    const closeMenu = (immediate = false) => {
      const doClose = () => {
        panel.classList.remove('opacity-100', 'translate-y-0', 'pointer-events-auto');
        panel.classList.add('opacity-0', '-translate-y-1', 'pointer-events-none');

        triggers.forEach((t) => {
          t.setAttribute('aria-expanded', 'false');
          const caret = t.querySelector('.caret-icon');
          if (caret) caret.classList.remove('rotate-180');
        });

        updateBackdrop();

        if (hideTimeout) clearTimeout(hideTimeout);
        if (immediate) {
          if (panel.classList.contains('opacity-0')) panel.classList.add('hidden');
        } else {
          hideTimeout = setTimeout(() => {
            if (panel.classList.contains('opacity-0')) panel.classList.add('hidden');
            hideTimeout = null;
          }, 160);
        }
      };

      cancelClose();
      if (immediate) {
        doClose();
      } else {
        closeTimeout = setTimeout(doClose, 280);
      }
    };

    // Attach hover listeners to triggers and their immediate navigation wrappers
    triggers.forEach((t) => {
      const parentWrap = t.closest('.nav-menu-trigger-wrap') as HTMLElement | null;
      const hoverTarget = parentWrap || t;

      hoverTarget.addEventListener('mouseenter', openMenu);
      hoverTarget.addEventListener('mouseleave', () => closeMenu(false));

      t.addEventListener('click', (e) => {
        e.stopPropagation();
        e.preventDefault();
        const isExpanded = t.getAttribute('aria-expanded') === 'true';
        if (isExpanded) closeMenu(true);
        else openMenu();
      });
      t.addEventListener('focus', openMenu);
    });

    panel.addEventListener('mouseenter', cancelClose);
    panel.addEventListener('mouseleave', () => closeMenu(false));

    window.addEventListener('techsteps:close-services', (e: any) => {
      closeMenu(e.detail?.immediate ?? true);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeMenu(true);
    });

    document.addEventListener('click', (e) => {
      let inside = false;
      triggers.forEach((t) => {
        if (t.contains(e.target as Node)) inside = true;
      });
      if (!panel.contains(e.target as Node) && !inside) closeMenu(true);
    });

    const backdrop = document.getElementById('dropdown-backdrop');
    backdrop?.addEventListener('click', () => closeMenu(true));

    panel.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => closeMenu(true));
    });

    window.addEventListener('resize', updatePosition, { passive: true });
    window.addEventListener('scroll', updatePosition, { passive: true });
  }

  setupServicesMegaMenu();
  document.addEventListener('astro:page-load', () => {
    document.getElementById('dropdown-backdrop')?.classList.remove('active');
    setupServicesMegaMenu();
  });
</script>
