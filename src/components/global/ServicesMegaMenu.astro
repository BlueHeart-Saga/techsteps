---
/**
 * ServicesMegaMenu.astro
 * Premium compact 3-column mega-menu for "Services" matching reference style
 * - Reduced padding and gaps for a snug, premium enterprise feel
 * - Left: Soft-green panel with service categories (~250-265px)
 * - Middle: Clean 2-column subservice links with compact row spacing
 * - Right: Borderless sustainability feature panel showing the full image (496x330)
 *
 * Radius System:
 * - Outer dropdown: 20px
 * - Left inner panel: 16px
 * - Active service item: 10px - 12px
 * - Feature image: 12px - 14px
 */

import { getDivisions, getServices } from '../../lib/sanity/client';
import { getServiceCanonicalSlug } from '../../lib/routeHelpers';

const [divisionsData, servicesData] = await Promise.all([
  getDivisions().catch(() => []),
  getServices().catch(() => []),
]);


const defaultPillars = [
  {
    id: 'information-management',
    title: 'Information Management',
    slug: 'information-management',
    icon: '/icons/Information%20Management.svg',
    subLinks: [
      { name: 'Digital Mailroom', slug: 'digital-mailroom-services' },
      { name: 'Document Management', slug: 'document-management-services' },
      { name: 'Document Scanning', slug: 'document-scanning-services' },
      { name: 'Document Storage', slug: 'document-storage-services' },
      { name: 'Heritage Storage', slug: 'heritage-storage-services' },
      { name: 'Tape & Media Storage', slug: 'tape-media-storage-services' },
      { name: 'Vault Storage', slug: 'vault-storage-services' },
    ],
  },
  {
    id: 'it-lifecycle',
    title: 'IT Lifecycle & Destruction',
    slug: 'it-lifecycle-services-destruction',
    icon: '/icons/IT%20Lifecycle%20&%20Destruction.svg',
    subLinks: [
      { name: 'IT Asset Disposition (ITAD)', slug: 'it-asset-disposition-services' },
      { name: 'IT Asset Tracking (ITAM)', slug: 'it-asset-tracking-services' },
      { name: 'Remarketing & Recycling', slug: 'remarketing-recycling-services' },
      { name: 'Secure Collection Services', slug: 'secure-collection-services' },
      { name: 'Secure IT Disposal', slug: 'secure-it-disposal-services' },
      { name: 'Ultra Secure Hard Drive Destruction', slug: 'ultra-secure-hard-drive-destruction-services' },
    ],
  },
  {
    id: 'secure-shredding',
    title: 'Secure Shredding & Integrity',
    slug: 'secure-shredding-document-integrity',
    icon: '/icons/Secure%20Shredding%20&%20Integrity.svg',
    subLinks: [
      { name: 'Cardboard Recycling', slug: 'cardboard-recycling-services' },
      { name: 'Disposal Services', slug: 'disposal-services' },
      { name: 'Dry Mixed Recycling (DMR)', slug: 'dry-mixed-recycling-services' },
      { name: 'Home Shredding', slug: 'home-shredding-services' },
      { name: 'Off-Site Shredding Services', slug: 'off-site-shredding-services' },
      { name: 'On-Site Shredding', slug: 'on-site-shredding-services' },
      { name: 'Product Shredding', slug: 'product-shredding-services' },
      { name: 'Simpler Recycling Services', slug: 'simpler-recycling-services' },
    ],
  },
  {
    id: 'moving-relocation',
    title: 'Moving & Relocation Services',
    slug: 'moving-relocation-services',
    icon: '/icons/Moving%20&%20Relocation%20Services.svg',
    subLinks: [
      { name: 'Business Relocations', slug: 'business-relocations-services' },
      { name: 'Europe & International Domestic Moves', slug: 'europe-international-domestic-moves-services' },
      { name: 'Heritage Relocations & Storage', slug: 'heritage-relocations-storage-services' },
      { name: 'IT Relocations Specialist', slug: 'it-relocations-specialist-services' },
      { name: 'Laboratory Relocations & Storage', slug: 'laboratory-relocations-storage-services' },
      { name: 'Project Management', slug: 'project-management-services' },
    ],
  },
];

const servicePillars = defaultPillars.map((pillar) => {
  const matchedDiv = divisionsData.find(
    (d: any) => d.slug === pillar.slug || d.slug?.includes(pillar.id)
  );
  const divServices = servicesData.filter(
    (s: any) => s.divisionSlug === (matchedDiv?.slug || pillar.slug)
  );
  const subLinks = (divServices && divServices.length > 0)
    ? divServices.map((s: any) => ({
        name: s.title,
        slug: getServiceCanonicalSlug(s.slug),
      }))
    : pillar.subLinks.map((s: any) => ({
        name: s.name,
        slug: getServiceCanonicalSlug(s.slug),
      }));

  // Keep equipment collection URLs exclusively in FreeCollectionMegaMenu.astro.
  // The IT Lifecycle submenu intentionally uses its six approved service links,
  // even if Sanity returns additional collection entries for this division.
  const menuSubLinks = pillar.id === 'it-lifecycle'
    ? pillar.subLinks.map((s) => ({
        name: s.name,
        slug: getServiceCanonicalSlug(s.slug),
      }))
    : subLinks;

  return {
    ...pillar,
    title: matchedDiv?.title || pillar.title,
    subLinks: menuSubLinks,
  };
});
const defaultActiveId = 'it-lifecycle';
const defaultPillar = servicePillars.find(p => p.id === defaultActiveId) || servicePillars[0];
---

<!-- =========================================================
     SERVICES MEGA MENU PANEL
========================================================= -->
<div
  id="services-megamenu-panel"
  class="fixed top-[80px] inset-x-0 z-[998] hidden opacity-0 -translate-y-1 transition-[opacity,transform] duration-150 ease-out pointer-events-none before:absolute before:-top-10 before:inset-x-0 before:h-10 before:content-['']"
  role="region"
  aria-label="Services Mega Menu"
>
  <div
    id="services-megamenu-wrapper"
    class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8"
  >
    <div
      id="services-megamenu-card"
      class="services-dropdown-card bg-white rounded-[20px] border border-slate-200/80 shadow-[0_16px_40px_rgba(0,0,0,0.07)] pointer-events-auto p-4 sm:p-5 lg:p-5.5 flex flex-col lg:flex-row items-start justify-between gap-5 lg:gap-7 xl:gap-8 w-full box-border"
    >

      <!-- =====================================================
           LEFT: SERVICE CATEGORIES PANEL (SOFT GREEN, 16px RADIUS)
      ====================================================== -->
      <div
        class="services-left-col w-full lg:w-[315px] xl:w-[330px] shrink-0 rounded-[16px] p-3.5 sm:p-4 flex flex-col justify-between box-border bg-[#F3F7F5]"
      >
        <div>
          <h3 class="services-left-heading text-xs font-bold uppercase tracking-wider text-[#5A6874] mb-2.5">
            OUR SERVICES
          </h3>

          <div class="space-y-1">
            {servicePillars.map((pillar) => {
              const isActive = pillar.id === defaultActiveId;
              return (
                <a
                  href={`/${pillar.slug}`}
                  data-service-tab={pillar.id}
                  data-pillar-title={pillar.title}
                  class={`service-tab-btn group w-full text-left flex items-center gap-2.5 px-3 py-2 rounded-[10px] transition-all duration-150 cursor-pointer min-h-[40px] ${
                    isActive
                      ? 'active-tab bg-[#C3E8D5] text-[#0F172A] font-semibold'
                      : 'text-[#1E293B] hover:bg-[#E4EFE9]'
                  }`}
                >
                  <span class="shrink-0 flex items-center justify-center w-5 h-5">
                    <img
                      src={pillar.icon}
                      alt=""
                      class="w-5 h-5 object-contain"
                      width="20"
                      height="20"
                    />
                  </span>

                  <span class="pillar-label text-[14px] xl:text-[14.5px] font-medium leading-snug whitespace-nowrap">
                    {pillar.title}
                  </span>
                </a>
              );
            })}
          </div>
        </div>

        <!-- ALL SERVICES OVERVIEW LINK -->
        <div class="mt-4 pt-1">
          <a
            href="/services"
            class="all-services-link group inline-flex items-center gap-1.5 px-3 py-1.5 rounded-[10px] text-[#0F623A] hover:text-[#0A331E] transition-colors font-semibold text-[13.5px]"
          >
            <span>All Services Overview</span>
            <span class="text-xs transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
          </a>
        </div>
      </div>

      <!-- =====================================================
           MIDDLE: DYNAMIC SUBSERVICE LINKS (COMPACT 2-COLUMN GRID)
      ====================================================== -->
      <div
        class="services-middle-col flex-1 min-w-0 flex flex-col justify-start pt-4"
      >
        <div class="mb-3.5 flex items-center justify-between">
          <h3
            id="active-pillar-title"
            class="services-middle-heading text-xs font-bold uppercase tracking-wider text-[#5A6874] transition-colors"
          >
            {defaultPillar.title.toUpperCase()}
          </h3>
        </div>

        <!-- DYNAMIC PANELS CONTAINER -->
        <div class="services-panels-container relative flex-1">
          {servicePillars.map((pillar) => {
            const isActive = pillar.id === defaultActiveId;
            return (
              <div
                id={`tab-panel-${pillar.id}`}
                class={`service-tab-panel transition-opacity duration-150 ${
                  isActive ? 'block opacity-100' : 'hidden opacity-0'
                }`}
              >
                <div class="services-submenu grid grid-cols-1 md:grid-cols-2 gap-x-6 lg:gap-x-8 xl:gap-x-10 gap-y-3 lg:gap-y-3.5">
                  {pillar.subLinks.map((link) => {
                    const subSlug = getServiceCanonicalSlug(link.slug);
                    return (
                      <a
                        href={`/services/${subSlug}`}
                        class="service-link group flex flex-col justify-start py-0.5 text-[#1E293B] hover:text-[#0F623A] transition-colors duration-150 cursor-pointer"
                      >

                        <span class="text-[14.5px] lg:text-[15px] font-medium leading-normal whitespace-nowrap group-hover:text-[#0F623A] transition-colors">
                          {link.name}
                        </span>
                      </a>
                    );
                  })}
                </div>
              </div>
            );
          })}
        </div>
      </div>

      <!-- =====================================================
           RIGHT: SUSTAINABILITY FEATURED PANEL (BORDERLESS, FULL IMAGE)
      ====================================================== -->
      <div
        class="services-right-col w-full lg:w-[220px] xl:w-[240px] shrink-0 flex flex-col justify-start pt-4"
      >
        <div class="mb-3.5 flex items-center justify-between">
          <h3 class="services-right-heading text-xs font-bold uppercase tracking-wider text-[#5A6874]">
            SUSTAINABILITY
          </h3>
        </div>

        <a
          href="/sustainability"
          class="services-featured-card group block w-full bg-transparent transition-all duration-200"
        >
          <!-- FULL IMAGE CONTAINER (EXACT 496:330 NATURAL PROPORTIONS, NO BORDERLINE) -->
          <div class="w-full aspect-[496/330] overflow-hidden rounded-[12px] bg-slate-50">
            <img
              src="/images/brand/sustainability.webp"
              alt="Responsible Technology. Sustainable Future."
              class="w-full h-full object-contain transition-transform duration-300 group-hover:scale-105"
              loading="lazy"
              width="496"
              height="330"
            />
          </div>

          <div class="pt-2.5 pb-0 px-0 flex flex-col gap-1">
            <p class="font-sans text-[13px] font-semibold text-[#0F172A] leading-snug">
              Responsible Technology.
            </p>
            <span class="inline-flex items-center gap-1 text-[#0F623A] group-hover:text-[#0A331E] font-bold text-[13px] mt-0.5 transition-colors">
              <span>Explore Sustainability</span>
              <span class="text-xs transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
            </span>
          </div>
        </a>
      </div>

    </div>
  </div>
</div>

<style>
  /* =========================================================
     CONTAINER & CARD
  ========================================================= */
  #services-megamenu-panel .services-dropdown-card {
    width: 100%;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    border-radius: 20px !important;
    box-sizing: border-box;
  }

  /* =========================================================
     LEFT SERVICES PANEL (16px RADIUS, SOFT GREEN BG)
  ========================================================= */
  #services-megamenu-panel .services-left-col {
    background-color: #F3F7F5 !important;
    border-radius: 16px !important;
    border: none !important;
    box-shadow: none !important;
    transition: background 220ms ease;
  }

  /* =========================================================
     TYPOGRAPHY & HEADINGS
  ========================================================= */
  #services-megamenu-panel .services-left-heading,
  #services-megamenu-panel .services-middle-heading,
  #services-megamenu-panel .services-right-heading {
    font-family: var(--font-sans) !important;
    font-size: 11.5px !important;
    font-weight: 700 !important;
    letter-spacing: 0.06em !important;
    text-transform: uppercase !important;
    color: #5A6874 !important;
  }

  #services-megamenu-panel .service-tab-btn {
    font-family: var(--font-sans) !important;
    font-size: 14.5px !important;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.35;
    border-radius: 10px !important;
  }

  #services-megamenu-panel .pillar-label {
    white-space: nowrap !important;
  }

  #services-megamenu-panel .service-link {
    font-family: var(--font-sans) !important;
    font-size: 15px !important;
    font-weight: 500 !important;
    letter-spacing: -0.01em !important;
    line-height: 1.4 !important;
    text-decoration: none !important;
    color: #1E293B !important;
    white-space: nowrap !important;
  }

  #services-megamenu-panel .service-link:hover {
    color: #0F623A !important;
  }

  #services-megamenu-panel .all-services-link {
    font-family: var(--font-sans) !important;
    font-size: 13.5px !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    color: #0F623A !important;
  }

  #services-megamenu-panel .all-services-link:hover {
    color: #0A331E !important;
  }

  /* =========================================================
     ACTIVE / HOVER PILLS (10px RADIUS)
  ========================================================= */
  #services-megamenu-panel .service-tab-btn.active-tab {
    background-color: #C3E8D5 !important;
    color: #0F172A !important;
    font-weight: 600 !important;
  }

  #services-megamenu-panel .service-tab-btn:not(.active-tab):hover {
    background-color: #E4EFE9 !important;
    color: #0F172A !important;
  }

  /* =========================================================
     SUSTAINABILITY CARD (BORDERLESS, NO BORDERLINE)
  ========================================================= */
  #services-megamenu-panel .services-featured-card {
    border: none !important;
    border-radius: 12px !important;
    box-shadow: none !important;
  }

  /* =========================================================
     SCROLL NAV GLASS (MATCHING FLOATING NAVBAR)
  ========================================================= */
  #services-megamenu-wrapper .services-dropdown-card.scroll-glass-active,
  #services-megamenu-card.scroll-glass-active {
    background: rgba(250, 246, 238, 0.60) !important;
    background-color: rgba(250, 246, 238, 0.60) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    backdrop-filter: blur(12px) !important;
    border: 1px solid rgba(0, 0, 0, 0.10) !important;
    box-shadow: 0 16px 40px -10px rgba(0, 0, 0, 0.08) !important;
  }

  #services-megamenu-wrapper.scroll-dropdown-wrapper .services-left-col {
    background: rgba(243, 247, 245, 0.75) !important;
    -webkit-backdrop-filter: blur(12px) !important;
    backdrop-filter: blur(12px) !important;
    border: none !important;
  }

  /* =========================================================
     RESPONSIVE
  ========================================================= */
  @media (max-width: 1024px) {
    #services-megamenu-panel .services-dropdown-card {
      flex-direction: column;
      gap: 1.25rem;
    }

    #services-megamenu-panel .services-middle-col,
    #services-megamenu-panel .services-right-col {
      padding-top: 0;
      width: 100%;
    }
  }
</style>
