---
/**
 * FAQSection.astro
 * Unified, responsive FAQ accordion component matching TechSteps design standard.
 *
 * Requirements:
 * - Collapsed cards display ONLY question and plus (+) icon (no partial text, borders or blank space)
 * - Collapsed cards have consistent minimum height ~64-68px
 * - Expanded cards automatically fit answer content with smooth 200-250ms animation
 * - Single-open accordion behaviour (first item open by default)
 * - Accessible keyboard interaction (Enter / Space) & ARIA attributes
 */

export interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  eyebrow?: string;
  heading?: string;
  title?: string;
  intro?: string;
  subtitle?: string;
  faqs: FAQItem[];
  sectionId?: string;
  className?: string;
}

const {
  eyebrow = Astro.props.eyebrow || 'HERE TO HELP',
  heading = Astro.props.heading || Astro.props.title || 'Frequently Asked Questions',
  intro = Astro.props.intro || Astro.props.subtitle,
  faqs = [],
  sectionId = 'faq',
  className = '',
} = Astro.props;

// Only render if we have FAQs
if (!faqs || faqs.length === 0) {
  return null;
}
---

<section
  id={sectionId}
  class={`py-16 sm:py-20 lg:py-24 bg-[#F8FAF9] border-b border-slate-200/80 transition-colors ${className}`}
  aria-labelledby={`${sectionId}-heading`}
>
  <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Heading (Centered) -->
    <div class="text-center max-w-2xl mx-auto">
      {eyebrow && (
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#146B5C] mb-2.5 font-mono">
          {eyebrow}
        </span>
      )}
      <h2
        id={`${sectionId}-heading`}
        class="text-3xl sm:text-4xl lg:text-[40px] font-semibold text-[#101E2C] tracking-tight font-display leading-[1.15]"
      >
        {heading}
      </h2>
      {intro && (
        <p class="mt-3 text-sm sm:text-base text-slate-600 max-w-xl mx-auto font-sans leading-relaxed">
          {intro}
        </p>
      )}
    </div>

    <!-- Centered FAQ Accordion Stack (620px - 650px max width) -->
    <div
      class="max-w-[640px] mx-auto mt-10 sm:mt-12 space-y-2.5 sm:space-y-3 faq-accordion-container"
      data-faq-container
    >
      {faqs.map((faq, index) => {
        const isOpen = index === 0;
        const itemId = `${sectionId}-item-${index}`;
        const contentId = `${sectionId}-panel-${index}`;

        return (
          <div
            class:list={[
              'faq-card rounded-[18px] sm:rounded-[20px] transition-all duration-200 overflow-hidden',
              isOpen ? 'is-open' : ''
            ]}
            data-faq-card
          >
            <!-- Question Toggle Row (Strictly 64-68px consistent height) -->
            <button
              type="button"
              id={itemId}
              aria-expanded={isOpen ? 'true' : 'false'}
              aria-controls={contentId}
              class="faq-toggle w-full text-left px-5 sm:px-6 py-4 min-h-[64px] sm:min-h-[66px] flex items-center justify-between gap-4 cursor-pointer focus:outline-none focus-visible:ring-2 focus-visible:ring-[#146B5C] rounded-[18px] sm:rounded-[20px]"
            >
              <span class="faq-question text-[14.5px] sm:text-[15px] font-medium text-[#101E2C] leading-snug flex-1">
                {faq.question}
              </span>

              <!-- Circular Icon Badge (34px - 36px) -->
              <span
                class="faq-icon-badge w-[35px] h-[35px] min-w-[35px] min-h-[35px] rounded-full flex items-center justify-center shrink-0 transition-colors duration-200"
                aria-hidden="true"
              >
                <!-- Plus Icon (Closed) -->
                <svg
                  class="faq-icon-plus w-[15px] h-[15px] transition-transform duration-200"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.3"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 5v14m7-7H5" />
                </svg>

                <!-- Minus Icon (Open) -->
                <svg
                  class="faq-icon-minus w-[15px] h-[15px] transition-transform duration-200"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2.3"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M19 12H5" />
                </svg>
              </span>
            </button>

            <!-- Collapsible Answer Container -->
            <div
              id={contentId}
              role="region"
              aria-labelledby={itemId}
              class="faq-collapse"
            >
              <div class="faq-collapse-inner">
                <div class="faq-answer px-5 sm:px-6 pb-5 sm:pb-5.5 text-[13.5px] sm:text-[14px] text-slate-600 leading-relaxed font-sans font-normal">
                  {faq.answer}
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>

<style>
  /* =========================================================
     FAQ CARD STYLES
  ========================================================= */
  .faq-card {
    background-color: #EAF2EE;
    border: 1px solid transparent;
    transition: background-color 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }

  .faq-card.is-open {
    background-color: #FFFFFF;
    border-color: #D1E2D9;
    box-shadow: 0 4px 20px -2px rgba(15, 23, 42, 0.05);
  }

  /* Question Toggle Button */
  .faq-toggle {
    background: transparent;
    border: none;
    user-select: none;
    -webkit-user-select: none;
  }

  /* Circular Icon Badge (34-36px) */
  .faq-card .faq-icon-badge {
    background-color: #FFFFFF;
    color: #146B5C;
    box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  }

  .faq-card.is-open .faq-icon-badge {
    background-color: #E2EFE8;
    color: #146B5C;
    box-shadow: none;
  }

  .faq-card .faq-icon-plus {
    display: block;
  }

  .faq-card .faq-icon-minus {
    display: none;
  }

  .faq-card.is-open .faq-icon-plus {
    display: none;
  }

  .faq-card.is-open .faq-icon-minus {
    display: block;
  }

  /* =========================================================
     COLLAPSE / EXPAND CSS GRID ENGINE (ZERO-SHIFT & NO BLEED)
  ========================================================= */
  /* Collapsed state: strictly 0fr height, overflow hidden, invisible */
  .faq-collapse {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    visibility: hidden;
    transition: grid-template-rows 220ms cubic-bezier(0.4, 0, 0.2, 1),
                visibility 220ms step-end;
  }

  /* Expanded state: auto height to fit any answer length without cutoff */
  .faq-card.is-open .faq-collapse {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows 220ms cubic-bezier(0.4, 0, 0.2, 1),
                visibility 0s step-start;
  }

  /* Inner wrapper: min-height 0 is mandatory for grid row to collapse to 0 */
  .faq-collapse-inner {
    min-height: 0;
    overflow: hidden;
    opacity: 0;
    transition: opacity 160ms ease-out;
  }

  .faq-card.is-open .faq-collapse-inner {
    opacity: 1;
    transition: opacity 220ms ease-in 50ms;
  }

  /* Answer text formatting */
  .faq-answer {
    padding-top: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .faq-card,
    .faq-collapse,
    .faq-collapse-inner,
    .faq-icon-badge {
      transition: none !important;
    }
  }
</style>

<script>
  function initFAQAccordions() {
    const containers = document.querySelectorAll<HTMLElement>('[data-faq-container]');
    
    containers.forEach((container) => {
      // Guard against multiple initializations
      if (container.dataset.faqInitialized === 'true') return;
      container.dataset.faqInitialized = 'true';

      const cards = container.querySelectorAll<HTMLElement>('[data-faq-card]');

      cards.forEach((card) => {
        const toggle = card.querySelector<HTMLButtonElement>('.faq-toggle');
        if (!toggle) return;

        toggle.addEventListener('click', () => {
          const isCurrentlyOpen = card.classList.contains('is-open');

          // Single-open accordion: close other cards in this container
          cards.forEach((otherCard) => {
            if (otherCard !== card) {
              otherCard.classList.remove('is-open');
              const otherToggle = otherCard.querySelector<HTMLButtonElement>('.faq-toggle');
              if (otherToggle) {
                otherToggle.setAttribute('aria-expanded', 'false');
              }
            }
          });

          // Toggle clicked card
          if (isCurrentlyOpen) {
            card.classList.remove('is-open');
            toggle.setAttribute('aria-expanded', 'false');
          } else {
            card.classList.add('is-open');
            toggle.setAttribute('aria-expanded', 'true');
          }
        });
      });
    });
  }

  // Ensure execution on initial load and View Transitions
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initFAQAccordions);
  } else {
    initFAQAccordions();
  }
  document.addEventListener('astro:page-load', initFAQAccordions);
</script>
