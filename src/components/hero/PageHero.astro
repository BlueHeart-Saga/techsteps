---
import BrandLogo from '../global/BrandLogo.astro';
import Breadcrumbs from '../seo/Breadcrumbs.astro';
import TornPaperDivider from '../layout/TornPaperDivider.astro';

interface BreadcrumbItem {
  name: string;
  url?: string;
}

interface Props {
  title?: string;
  breadcrumbs?: BreadcrumbItem[];
  dividerColor?: string;
  showDivider?: boolean;
  minHeight?: string;
  eyebrow?: string;
  subheading?: string;
  bgImage?: string;
  layout?: 'default' | 'split' | 'custom';
}

const {
  title = '',
  breadcrumbs = [],
  dividerColor = '#ffffff',
  showDivider = true,
  minHeight = 'min-h-[440px] sm:min-h-[480px] lg:min-h-[520px]',
  eyebrow,
  subheading,
  bgImage = '/images/brand/hero-bg.jpg',
  layout = 'default',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<section class={`relative w-full overflow-hidden bg-slate-950 ${minHeight} flex flex-col justify-between select-none`}>
  <!-- Background Image: Cinematic Stone Cavern Vista (Full-Bleed, Exact match with home hero) -->
  <img
    src={bgImage}
    alt="TechSteps UK background landscape"
    class="absolute inset-0 w-full h-full object-cover object-center scale-105 select-none pointer-events-none"
    loading="eager"
    decoding="async"
  />

  <!-- Multi-layered Atmospheric Vignettes for Contrast & Soft Lighting -->
  <div class="absolute inset-0 bg-radial-[ellipse_at_center] from-black/10 via-black/25 to-black/60 pointer-events-none"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/15 to-black/35 pointer-events-none"></div>
  <div class="absolute inset-x-0 top-0 h-36 bg-gradient-to-b from-black/35 via-black/10 to-transparent pointer-events-none"></div>

  <!-- 1. Integrated Navbar at Top of Hero (Full width, \ curve leading edge) -->
  <header id="hero-header" class="relative z-50 w-full flex items-center justify-between h-20 sm:h-22">
    <!-- Left: Transparent Brand Area (Cavern Vista visible behind logo, enlarged logo size) -->
    <div class="flex items-center h-full pl-6 sm:pl-10 lg:pl-12 pr-2 sm:pr-4 bg-transparent shrink-0">
      <a
        href="/"
        class="flex items-center focus:outline-none focus:ring-2 focus:ring-emerald-400 rounded-lg py-1.5"
        aria-label="TechSteps UK Home"
      >
        <BrandLogo size="xl" variant="light" showTagline={false} />
      </a>
    </div>

    <!-- Right / Other Area: White Bar with \ Smooth Curved Leading Edge -->
    <div class="h-full flex-1 flex items-center justify-end min-w-0">
      <!-- SVG Curved Leading Edge (\ slope with G1 smooth bezier rounding) -->
      <svg
        viewBox="0 0 64 88"
        preserveAspectRatio="none"
        class="h-full w-10 sm:w-14 lg:w-16 shrink-0 -mr-[1px] pointer-events-none select-none drop-shadow-xs"
        aria-hidden="true"
      >
        <!-- White Filled Wedge with \ slope -->
        <path
          d="M 0,0 Q 14,0 24,20 L 44,66 Q 52,88 64,88 L 64,0 Z"
          fill="#FFFFFF"
        />
      </svg>

      <!-- Solid White Navigation Container (No Bottom Border) -->
      <div class="h-full flex-1 flex items-center justify-end bg-white shadow-md pl-2 sm:pl-4 pr-6 sm:pr-10 lg:pr-12">
        <nav class="hidden lg:flex items-center space-x-6 xl:space-x-8 text-[16px] xl:text-[17px] font-sans tracking-normal" aria-label="Main Navigation">
          <a
            href="/about-us"
            class={`py-1.5 px-1 border-b-2 bg-transparent transition-all duration-150 ${
              currentPath === '/about-us'
                ? 'border-slate-900 text-slate-950 font-bold'
                : 'border-transparent text-slate-600 hover:text-slate-950 hover:border-slate-800 font-medium'
            }`}
          >
            About Us
          </a>

          <!-- Services Mega Menu Link (Direct Click to /services, Hover Opens Mega Menu) -->
          <div class="relative flex items-center group">
            <a
              href="/services"
              class={`services-megamenu-toggle inline-flex items-center gap-1.5 py-1.5 px-1 border-b-2 bg-transparent transition-all duration-150 cursor-pointer focus:outline-none ${
                currentPath.startsWith('/services') || currentPath === '/information-management' || currentPath === '/it-lifecycle-services-destruction' || currentPath === '/secure-shredding-document-integrity' || currentPath === '/moving-relocation-services'
                  ? 'border-slate-900 text-slate-950 font-bold'
                  : 'border-transparent text-slate-600 hover:text-slate-950 hover:border-slate-800 font-medium'
              }`}
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="services-megamenu-panel"
              data-is-active-route={currentPath.startsWith('/services') ? 'true' : 'false'}
            >
              <span>Services</span>
              <svg class="h-3.5 w-3.5 text-slate-400 group-hover:text-slate-700 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>

          <!-- Sectors Dropdown Link (Direct Click to /sectors, Hover Opens Dropdown) -->
          <div class="relative sectors-trigger-wrap flex items-center group">
            <a
              href="/sectors"
              class={`sectors-dropdown-toggle inline-flex items-center gap-1.5 py-1.5 px-1 border-b-2 bg-transparent transition-all duration-150 cursor-pointer focus:outline-none ${
                currentPath.startsWith('/sectors')
                  ? 'border-slate-900 text-slate-950 font-bold'
                  : 'border-transparent text-slate-600 hover:text-slate-950 hover:border-slate-800 font-medium'
              }`}
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="sectors-dropdown-panel"
              data-is-active-route={currentPath.startsWith('/sectors') ? 'true' : 'false'}
            >
              <span>Sectors</span>
              <svg class="h-3.5 w-3.5 text-slate-400 group-hover:text-slate-700 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>

          <a
            href="/insights"
            class={`py-1.5 px-1 border-b-2 bg-transparent transition-all duration-150 ${
              currentPath.startsWith('/insights')
                ? 'border-slate-900 text-slate-950 font-bold'
                : 'border-transparent text-slate-600 hover:text-slate-950 hover:border-slate-800 font-medium'
            }`}
          >
            Insights
          </a>

          <a
            href="/contact"
            class={`py-1.5 px-1 border-b-2 bg-transparent transition-all duration-150 ${
              currentPath === '/contact'
                ? 'border-slate-900 text-slate-950 font-bold'
                : 'border-transparent text-slate-600 hover:text-slate-950 hover:border-slate-800 font-medium'
            }`}
          >
            Contact
          </a>
        </nav>

        <!-- CTA Pill Button & Mobile Trigger in White Area -->
        <div class="flex items-center gap-3 ml-6 sm:ml-8">
          <a
            href="/request-a-quote"
            class="hidden sm:inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-[#E58A3C] hover:bg-[#d97d2e] text-white text-[15px] font-sans font-bold shadow-md transition-all duration-150 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#E58A3C]"
          >
            Request a Collection
          </a>

          <!-- Mobile Hamburger Button -->
          <button
            type="button"
            class="open-mobile-menu-btn lg:hidden p-2 rounded-lg text-slate-700 hover:text-black hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-400"
            aria-label="Open mobile navigation menu"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- 2. Breadcrumbs: Positioned cleanly below the header -->
  {breadcrumbs && breadcrumbs.length > 0 && (
    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 pt-3 sm:pt-4">
      <Breadcrumbs items={breadcrumbs} theme="dark" />
    </div>
  )}

<!-- 3. Hero Content -->
{layout === 'split' && (
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 py-10 lg:py-14">
    <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">

      <!-- LEFT CONTENT -->
      <div class="max-w-2xl">

        {eyebrow && (
          <span class="inline-block text-xs sm:text-sm font-mono font-bold uppercase tracking-[0.2em] text-[#0F623A] mb-4">
            {eyebrow}
          </span>
        )}

        <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black text-white tracking-tight uppercase leading-[1.05] drop-shadow-2xl">
          {title}
        </h1>

        {subheading && (
          <p class="mt-5 text-base sm:text-lg text-slate-200/90 max-w-xl leading-relaxed">
            {subheading}
          </p>
        )}

        <!-- CTA BUTTONS -->
        <div class="mt-7 flex flex-col sm:flex-row gap-3">

          <a
            href="/request-a-quote"
            class="inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm font-bold shadow-lg transition-all duration-200"
          >
            Get a Collection
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>

          <a
            href="/contact"
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 border border-white/30 text-white text-sm font-bold transition-all duration-200"
          >
            Speak to an Expert
          </a>

        </div>

        <!-- TRUST INDICATORS -->
        {/*<div class="mt-7 flex flex-wrap items-center gap-x-6 gap-y-3 text-sm text-white/80">

          <div class="flex items-center gap-2">
            <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#3FB33D]/20 text-[#3FB33D]">
              ✓
            </span>
            Secure & Certified
          </div>

          <div class="flex items-center gap-2">
            <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#3FB33D]/20 text-[#3FB33D]">
              ✓
            </span>
            UK Wide
          </div>

          <div class="flex items-center gap-2">
            <span class="flex h-5 w-5 items-center justify-center rounded-full bg-[#3FB33D]/20 text-[#3FB33D]">
              ✓
            </span>
            Responsible Processing
          </div>

        </div>*/}
      </div>

      <!-- RIGHT IMAGE -->
      <div class="relative">
        <div class="relative overflow-hidden rounded-3xl border border-white/20 shadow-2xl">
          <img
            src={bgImage}
            alt="Techsteps professional IT services"
            class="w-full h-[300px] sm:h-[360px] lg:h-[430px] object-cover"
            loading="eager"
            decoding="async"
          />

          <div class="absolute inset-0 bg-gradient-to-t from-black/35 via-transparent to-transparent"></div>
        </div>
      </div>

    </div>
  </div>
)}

{layout === 'custom' && (
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 py-6 sm:py-10 lg:py-14 my-auto">
    <slot />
  </div>
)}

{layout === 'default' && (
  <div class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-8 text-center flex flex-col items-center justify-center my-auto">

    {eyebrow && (
      <span class="inline-block text-xs sm:text-sm font-mono font-bold uppercase tracking-widest text-emerald-400 mb-3 drop-shadow-sm">
        {eyebrow}
      </span>
    )}

    {title && (
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-white tracking-tight uppercase leading-[1.05] drop-shadow-2xl select-none max-w-4xl">
        {title}
      </h1>
    )}

    {subheading && (
      <p class="mt-3 text-sm sm:text-base lg:text-lg text-slate-200/90 max-w-2xl leading-relaxed font-normal drop-shadow-sm">
        {subheading}
      </p>
    )}

    <slot />

  </div>
)}

  <!-- 4. Bottom Balancing Spacer -->
  <div class="h-2 sm:h-4 w-full pointer-events-none" aria-hidden="true"></div>

  <!-- 5. Torn Paper Edge Transition -->
  {showDivider && <TornPaperDivider color={dividerColor} />}
</section>
