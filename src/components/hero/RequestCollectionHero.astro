---
import HeroHeader from '../global/HeroHeader.astro';
import { getRequestCollectionPage } from '../../lib/sanity/client';

const pageData = await getRequestCollectionPage();
const hero = pageData?.hero;

const imageSrc =
  hero?.topImageUrl && hero.topImageUrl !== '/images/hero/Request a collection.webp'
    ? hero.topImageUrl
    : '/images/hero/request-collection-van.webp';

const imageAlt = hero?.topImageAlt || 'TechSteps IT asset collection vehicle and technician';
---

<section
  id="request-collection-hero"
  class="relative w-full bg-white overflow-x-clip overflow-y-visible"
>
  <!-- ========================================================
       HERO DECORATIVE BACKGROUND SYSTEM
       - Left: Reduced-size teal outline circle at mid position (half in Hero, half in Section)
       - Right: Soft mint bubble + floating dots + glow
       ======================================================== -->
  <div class="pointer-events-none select-none absolute inset-0 w-full h-full overflow-x-clip overflow-y-visible z-0" aria-hidden="true">
    
    <!-- Left-Side Mid-Position: Reduced Teal Outline Circle Arc (#146B5C)
         Positioned at bottom-0 translate-y-1/2 (half in Hero section, half in following section) -->
    <div class="absolute bottom-0 translate-y-1/2 -left-[clamp(45px,6vw,80px)] w-[clamp(190px,20vw,270px)] aspect-square pointer-events-none z-10">
      <!-- Outer concentric thin arc -->
      <div class="absolute inset-0 rounded-full border-[1.2px] border-[#008F83]/45"></div>
      <!-- Main thick teal circle arc (#146B5C) with refined thickness -->
      <div class="absolute inset-[10px] sm:inset-[13px] rounded-full border-[7px] sm:border-[9px] border-[#146B5C]"></div>
      <!-- Inner concentric thin arc -->
      <div class="absolute inset-[26px] sm:inset-[32px] rounded-full border border-[#008F83]/30"></div>
      <!-- Accent teal dot on perimeter -->
      <div class="absolute top-[48%] -right-1 w-2.5 h-2.5 rounded-full bg-[#146B5C]"></div>
    </div>

    <!-- Top-Right: Soft Mint Bubble (#D1F3EC) + Concentric Ring + Floating Dots -->
    <div class="absolute -top-12 sm:-top-20 -right-16 sm:-right-24 w-[300px] sm:w-[400px] lg:w-[480px] aspect-square">
      <!-- Outer concentric thin arc -->
      <div class="absolute -inset-[18px] sm:-inset-[28px] rounded-full border-[1.5px] border-[#008F83]/45"></div>
      <!-- Main soft mint-green filled bubble (#D1F3EC) -->
      <div class="w-full h-full rounded-full bg-[#D1F3EC]"></div>
      <!-- Inner soft highlight -->
      <div class="absolute inset-[30px] sm:inset-[45px] rounded-full bg-[#DDF7F1]/60"></div>
      <!-- Floating solid teal dot (#008F83) -->
      <div class="absolute top-[32%] -left-6 sm:-left-10 w-3 h-3 rounded-full bg-[#008F83]"></div>
      <!-- Floating small mint dot (#A8E6D9) -->
      <div class="absolute top-[20%] -left-1 sm:-left-3 w-2 h-2 rounded-full bg-[#A8E6D9]"></div>
    </div>

    <!-- Ambient mint glow radiating behind the illustration on the right (Ref: Home hero depth) -->
    <div class="absolute right-0 sm:right-10 top-1/2 -translate-y-1/2 w-[340px] sm:w-[480px] h-[340px] sm:h-[480px] bg-[#D1F3EC]/50 rounded-full blur-3xl pointer-events-none"></div>
  </div>

  <!-- Global Top Header with Navigation -->
  <div class="relative z-20">
    <HeroHeader isHome={true} />
  </div>

  <!-- Hero Main Content (Aligned with Navbar Max Width: 1240px, Ref: Home Hero Layout) -->
  <div class="relative z-10 w-full max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 lg:py-14 xl:py-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-12 items-center">
      
      <!-- LEFT COLUMN: SIMPLE HEADING ONLY (Feel-good quote with refined typography) -->
      <div class="lg:col-span-7 xl:col-span-7 flex flex-col justify-center text-center lg:text-left">
        <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[42px] xl:text-[46px] font-semibold text-slate-900 tracking-tight leading-[1.22] sm:leading-[1.18] lg:leading-[1.14] max-w-2xl mx-auto lg:mx-0">
          “Giving your tech a <span class="text-[#0F623A]">second life</span><br class="hidden sm:inline" />
          doing good for your business.”
        </h1>
      </div>

      <!-- RIGHT COLUMN: IMAGE (Ref: Home hero image positioning & drop shadow) -->
      <div class="lg:col-span-5 xl:col-span-5 flex justify-center lg:justify-end items-center w-full mt-2 lg:mt-0">
        <div class="relative w-full max-w-[340px] sm:max-w-[420px] md:max-w-[480px] lg:max-w-none flex justify-center lg:justify-end items-center">
          <img
            src={imageSrc}
            alt={imageAlt}
            class="w-full h-auto max-h-[320px] sm:max-h-[380px] md:max-h-[420px] lg:max-h-[460px] xl:max-h-[500px] object-contain object-center lg:object-right select-none mx-auto lg:ml-auto block drop-shadow-md transition-all duration-300"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
            width="1024"
            height="873"
          />
        </div>
      </div>

    </div>
  </div>
</section>
