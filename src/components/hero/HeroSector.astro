---
import PageHero from './PageHero.astro';
import type { Sector } from '../../lib/sanity/types';

interface Props {
  sector: Sector;
}

const { sector } = Astro.props;

const breadcrumbs = [
  { name: 'Sectors', url: '/sectors' },
  { name: sector.title, url: `/sectors/${sector.slug}` },
];

const sectorBgImages: Record<string, string> = {
  defence: '/images/sectors/defence.jpg',
  nhs: '/images/sectors/healthcare.jpg',
  finance: '/images/sectors/financial.jpg',
  'central-government': '/images/sectors/government.jpg',
};

const bgImage = sectorBgImages[sector.slug] || '/images/brand/hero-bg.jpg';
---

<PageHero
  eyebrow="SECTOR EXPERTISE"
  title={sector.title}
  subheading={sector.tagline || sector.summary}
  bgImage={bgImage}
  breadcrumbs={breadcrumbs}
  dividerColor="#ffffff"
>
  <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
    <a
      href={`/request-a-quote?sector=${encodeURIComponent(sector.slug)}`}
      class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#2D6A4F] hover:bg-[#245a41] text-white text-sm font-bold shadow-lg transition-all duration-200"
    >
      Request {sector.title} Briefing
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
      </svg>
    </a>
    <a
      href="#relevant-services"
      class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-sm font-bold border border-white/20 transition-all duration-200"
    >
      Explore Services
    </a>
  </div>
</PageHero>
