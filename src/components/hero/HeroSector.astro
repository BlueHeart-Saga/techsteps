---
import PageHero from './PageHero.astro';
import type { Sector } from '../../lib/sanity/types';

interface Props {
  sector: Sector;
}

const { sector } = Astro.props;

const breadcrumbs = [
  { name: 'Sectors', url: '/sectors' },
  { name: sector.title, url: `/sectors/${sector.slug}` },
];

const sectorBgImages: Record<string, string> = {
  defence: '/images/sectors/defence.jpg',
  nhs: '/images/sectors/nhs.jpg',
  finance: '/images/sectors/finance.jpg',
  'central-government': '/images/sectors/government.jpg',
  'it-technology': '/images/sectors/technology.jpg',
  'manufacturing-engineering': '/images/sectors/manufacturing.jpg',
  'education-universities': '/images/sectors/education.jpg',
  'legal-professional-services': '/images/sectors/legal.jpg',
};

const bgImage = sectorBgImages[sector.slug] || '/images/brand/hero-bg.jpg';
---

<PageHero
  bgImage={bgImage}
  breadcrumbs={breadcrumbs}
  showDivider={false}
  layout="custom"
  minHeight="min-h-[440px] sm:min-h-[480px] lg:min-h-[520px]"
>
  <div class="w-full max-w-[1240px] mx-auto text-left space-y-4 sm:space-y-5 pt-2 sm:pt-4 pb-6 sm:pb-8">
    
    <!-- Eyebrow with pill line indicator -->
    <!--<div class="inline-flex items-center gap-2">
      <span class="text-xs sm:text-sm font-sans font-bold uppercase tracking-[0.16em] text-emerald-400">
        SECTOR EXPERTISE
      </span>
      <span class="w-8 h-px bg-emerald-400/60" aria-hidden="true"></span>
    </div>-->

    <!-- Main Sector Title -->
    <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[54px] xl:text-[60px] font-semibold text-white tracking-tight leading-[1.1] max-w-3xl drop-shadow-md">
      {sector.title}
    </h1>

    <!-- Sector Subheading / Description -->
    <p class="text-base sm:text-lg text-slate-200/95 leading-relaxed max-w-2xl font-normal drop-shadow-xs">
      {sector.tagline || sector.summary}
    </p>

    <!-- Call to Action Buttons -->
    <div class="flex flex-wrap items-center gap-3.5 pt-3 sm:pt-4">
      <a
        href={`/request-a-quote?sector=${encodeURIComponent(sector.slug)}`}
        class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 rounded-lg bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm sm:text-base font-bold shadow-md hover:shadow-lg transition-all duration-200"
      >
        <span>Request a Collection</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>

      <a
        href="/services"
        class="inline-flex items-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 rounded-lg bg-white/10 hover:bg-white/20 text-white text-sm sm:text-base font-bold border border-white/25 hover:border-white transition-all duration-200 backdrop-blur-xs"
      >
        <span>Explore Services</span>
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

  </div>
</PageHero>
