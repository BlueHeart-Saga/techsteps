---
import PageHero from './PageHero.astro';
import type { Sector } from '../../lib/sanity/types';

interface Props {
  sector: Sector;
}

const { sector } = Astro.props;

// Dedicated transparent cutout hero images for sector sub-pages (from public/images/sectors/sub-pages-hero)
const sectorHeroImages: Record<string, string> = {
  // Defence & Aerospace
  defence: '/images/sectors/sub-pages-hero/defence.webp',
  'defence-aerospace': '/images/sectors/sub-pages-hero/defence.webp',

  // NHS & Healthcare Trusts
  nhs: '/images/sectors/sub-pages-hero/healthcare.webp',
  healthcare: '/images/sectors/sub-pages-hero/healthcare.webp',

  // Central Government & Public Sector
  'central-government': '/images/sectors/sub-pages-hero/centeal.webp',
  government: '/images/sectors/sub-pages-hero/centeal.webp',

  // Education & Universities
  'education-universities': '/images/sectors/sub-pages-hero/Education and univercities.webp',
  education: '/images/sectors/sub-pages-hero/Education and univercities.webp',

  // Corporate & Legal
  'legal-professional-services': '/images/sectors/sub-pages-hero/corparate and legal.webp',
  'corporate-legal': '/images/sectors/sub-pages-hero/corparate and legal.webp',
  legal: '/images/sectors/sub-pages-hero/corparate and legal.webp',
  corporate: '/images/sectors/sub-pages-hero/corparate and legal.webp',

  // Manufacturing & Engineering
  'manufacturing-engineering': '/images/sectors/sub-pages-hero/manufacturing and engineering.webp',
  manufacturing: '/images/sectors/sub-pages-hero/manufacturing and engineering.webp',

  // IT & Technology
  'it-technology': '/images/sectors/sub-pages-hero/IT and technolog.webp',
  technology: '/images/sectors/sub-pages-hero/IT and technolog.webp',

  // Financial & Banking Institutions
  finance: '/images/sectors/sub-pages-hero/collection services.webp',
  'financial-services': '/images/sectors/sub-pages-hero/collection services.webp',
};

const heroImage = sectorHeroImages[sector.slug] || '/images/sectors/sub-pages-hero/collection services.webp';
---

<!-- =========================
     SECTOR SUB-PAGE HERO SECTION
     Ref: services sub pages heros (Left content, right cutout image, clean white background)
========================= -->
<div class="relative bg-white">
  <PageHero
    breadcrumbs={[]}
    layout="custom"
    showDivider={true}
    dividerColor="#ffffff"
    minHeight="min-h-[400px] sm:min-h-[450px] lg:min-h-[500px]"
    noOverlay={true}
    theme="light"
    contained={true}
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- HERO CONTENT (Left) -->
      <div class="lg:col-span-6 xl:col-span-6 max-w-2xl lg:max-w-none pt-0 z-10">

        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-semibold text-slate-600 mb-3 sm:mb-4">
          <a href="/sectors" class="text-slate-700 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
            Sectors UK
          </a>
          <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
          <span class="text-slate-900 font-bold">{sector.title}</span>
        </nav>

        <!-- Main Sector Title -->
        <h1
          class="font-display
                 text-3xl sm:text-4xl md:text-5xl lg:text-[50px] xl:text-[54px]
                 font-semibold
                 text-slate-900
                 tracking-normal
                 leading-[1.12] sm:leading-[1.1]
                 max-w-xl"
        >
          {sector.title}
        </h1>

        <!-- Sector Tagline / Description -->
        <p
          class="mt-4 sm:mt-5
                 text-base sm:text-lg lg:text-[19px]
                 text-black
                 max-w-xl
                 leading-relaxed
                 font-sans font-normal"
        >
          {sector.tagline || sector.summary}
        </p>

        <!-- Primary CTA Buttons (Ref: Services Sub-Page Hero) -->
        <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-4">
          <a
            href={`/request-a-collection?sector=${encodeURIComponent(sector.slug)}`}
            class="inline-flex items-center justify-center
                   gap-2.5
                   px-7 sm:px-8
                   py-3.5 sm:py-4
                   rounded-[12px]
                   bg-[#0F623A] hover:bg-[#0c4e2e]
                   text-white
                   text-base sm:text-lg
                   font-bold
                   shadow-md hover:shadow-lg
                   transition-all duration-200
                   hover:scale-[1.01]
                   focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
          >
            <span>Request a Collection</span>
            <svg
              class="w-5 h-5 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>

          <a
            href="/services"
            class="inline-flex items-center justify-center
                   px-6 py-3.5
                   rounded-[12px]
                   bg-white hover:bg-slate-50
                   border border-slate-300
                   text-slate-800 hover:text-black
                   text-base
                   font-semibold
                   transition-colors duration-200"
          >
            Explore Services
          </a>
        </div>

        <!-- Compliance & Standards Badges -->
        {sector.complianceStandards && sector.complianceStandards.length > 0 && (
          <div class="mt-8 pt-6 border-t border-slate-200/80 flex flex-wrap items-center gap-2 sm:gap-2.5">
            <span class="text-xs font-bold uppercase tracking-wider text-slate-500 mr-1">Standards:</span>
            {sector.complianceStandards.slice(0, 4).map((std: string) => (
              <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-[#0F623A] border border-emerald-200/70">
                <svg class="w-3.5 h-3.5 text-[#0F623A]" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
                {std}
              </span>
            ))}
          </div>
        )}
      </div>

      <!-- HERO IMAGE (Right on Desktop, Below on Mobile) -->
      <div class="flex lg:col-span-6 xl:col-span-6 items-center justify-center lg:justify-end relative z-0 mt-8 lg:mt-0">
        <img
          src={heroImage}
          alt={sector.heroAlt || `TechSteps ${sector.title} specialist operations`}
          class="w-full max-w-[540px] sm:max-w-[580px] lg:max-w-[620px] xl:max-w-[660px] max-h-[500px] lg:max-h-[540px] object-contain select-none pointer-events-none drop-shadow-sm"
          loading="eager"
          fetchpriority="high"
          decoding="sync"
        />
      </div>
    </div>
  </PageHero>
</div>
