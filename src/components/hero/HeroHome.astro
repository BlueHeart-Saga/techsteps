---
import BrandLogo from '../global/BrandLogo.astro';
import TornPaperDivider from '../layout/TornPaperDivider.astro';
import { getHomePage } from '../../lib/sanity/client';

const homePage = await getHomePage();
const hero = homePage?.hero;

---

<section class="relative w-full overflow-hidden bg-slate-950 min-h-[640px] sm:min-h-[700px] lg:min-h-[760px] flex flex-col justify-between select-none">
  <!-- Background Image: Hardware Recycling Technician (Panoramic Full-Bleed with Built-in Left Gradient) -->
<img
  src={hero?.imageUrl || '/images/brand/hero-technician-hardware.png?v=5'}
  alt={hero?.imageAlt || 'IT recycling technician inspecting motherboards and electronic components'}
  class="absolute inset-0 w-full h-full object-cover object-[75%_center] lg:object-right select-none pointer-events-none"
  loading="eager"
  decoding="async"
/>

  <!-- Partial Soft Overlay in the text space (smooth gradient fading out before the hardware subject) -->
  <div class="absolute inset-y-0 left-0 w-full sm:w-[65%] md:w-[56%] lg:w-[48%] xl:w-[44%] bg-gradient-to-r from-black/65 via-black/40 via-[60%] via-black/15 via-[85%] to-transparent pointer-events-none z-[1]"></div>
  <!-- Mobile ambient gradient to keep text readable on small screens -->
  <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/20 to-transparent sm:hidden pointer-events-none z-[1]"></div>
  <header id="hero-header" class="relative z-50 w-full flex items-center justify-between h-20 sm:h-22 bg-white shadow-md px-6 sm:px-10 lg:px-12">
    <!-- Left: Brand Logo -->
    <div class="flex items-center h-full shrink-0">
      <a
        href="/"
        class="flex items-center focus:outline-none focus:ring-2 focus:ring-emerald-400 rounded-lg py-1.5"
        aria-label="TechSteps UK Home"
      >
        <BrandLogo size="lg" variant="dark" showTagline={false} />
      </a>
    </div>

    <!-- Right: Navigation Container -->
    <div class="h-full flex items-center justify-end">
      <nav class="hidden lg:flex items-center space-x-6 xl:space-x-8 text-[16px] xl:text-[17px] font-sans font-medium tracking-[-0.01em]" aria-label="Main Navigation">
        <!-- Services Mega Menu Link (Direct Click to /services, Hover Opens Mega Menu) -->
        <div class="relative flex items-center group">
          <a
              href="/services"
              class="services-megamenu-toggle text-slate-700 hover:text-slate-950 transition-all duration-150 inline-flex items-center gap-1.5 py-1.5 px-1 border-b-2 border-transparent hover:border-slate-800 font-medium cursor-pointer focus:outline-none bg-transparent"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="services-megamenu-panel"
              data-is-active-route="false"
            >
              <span>Services</span>
              <svg class="h-3.5 w-3.5 text-slate-500 group-hover:text-slate-800 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>

          <!-- Sectors Dropdown Link (Direct Click to /sectors, Hover Opens Dropdown) -->
          <div class="relative sectors-trigger-wrap flex items-center group">
            <a
              href="/sectors"
              class="sectors-dropdown-toggle inline-flex items-center gap-1.5 py-1.5 px-1 border-b-2 border-transparent text-slate-700 hover:text-slate-950 hover:border-slate-800 font-medium transition-all duration-150 cursor-pointer focus:outline-none bg-transparent"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="sectors-dropdown-panel"
              data-is-active-route="false"
            >
              <span>Sectors</span>
              <svg class="h-3.5 w-3.5 text-slate-500 group-hover:text-slate-800 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>

          <a
            href="/insights"
            class="py-1.5 px-1 border-b-2 border-transparent bg-transparent text-slate-700 hover:text-slate-950 hover:border-slate-800 font-medium transition-all duration-150"
          >
            Insights
          </a>

          <a
            href="/about-us"
            class="py-1.5 px-1 border-b-2 border-transparent bg-transparent text-slate-700 hover:text-slate-950 hover:border-slate-800 font-medium transition-all duration-150"
          >
            About Us
          </a>

          <a
            href="/contact"
            class="py-1.5 px-1 border-b-2 border-transparent bg-transparent text-slate-700 hover:text-slate-950 hover:border-slate-800 font-medium transition-all duration-150"
          >
            Contact
          </a>
        </nav>

        <!-- CTA Pill Button & Mobile Trigger in White Area -->
        <div class="flex items-center gap-3 ml-6 sm:ml-8">
          <a
            href="/request-a-quote"
            class="hidden sm:inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-[#E58A3C] hover:bg-[#d97d2e] text-white text-[15.5px] sm:text-[16px] font-sans font-medium tracking-tight shadow-md transition-all duration-150 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#E58A3C]"
          >
            Request a Collection
          </a>

          <!-- Mobile Hamburger Button -->
          <button
            type="button"
            class="open-mobile-menu-btn lg:hidden p-2 rounded-lg text-slate-700 hover:text-black hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-400"
            aria-label="Open mobile navigation menu"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
  </header>

  <!-- 2. Hero Content (Left Narrative aligned straight to the logo) -->
  <div class="relative z-10 w-full px-6 sm:px-10 lg:px-12 py-8 sm:py-12 lg:py-16 my-auto">
    <div class="max-w-2xl lg:max-w-3xl">
      <span class="inline-block text-sm sm:text-base font-sans font-bold uppercase tracking-wider text-[#0F623A] mb-3 sm:mb-4">
        {hero?.eyebrow || 'SUSTAINABLE IT RECYCLING'}
      </span>

      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-white tracking-tight uppercase leading-[1.12] drop-shadow-2xl">
        {hero?.heading || 'GIVING TECHNOLOGY A SECOND LIFE'}
      </h1>

      <p class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-200 max-w-xl leading-relaxed font-sans font-normal font-[400]">
        {hero?.description || 'Audited IT lifecycle solutions from accredited facilities across the UK. Zero-landfill guaranteed e-waste recycling, secure ADISA-certified data destruction, and compliant asset disposition.'}
      </p>

      <!-- Hero CTA Buttons: Service & Contact -->
      <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-3.5 sm:gap-4">
        <a
          href="/services"
          class="inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 rounded-md bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm sm:text-base font-bold shadow-lg transition-all duration-200 hover:scale-[1.02]"
        >
          Explore Services
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <a
          href="/contact"
          class="inline-flex items-center justify-center px-6 sm:px-7 py-3 sm:py-3.5 rounded-md bg-white/20 hover:bg-white/30 backdrop-blur-sm border border-white/40 text-white text-sm sm:text-base font-bold transition-all duration-200 hover:scale-[1.02] shadow-sm"
        >
          Contact Us
        </a>
      </div>
    </div>
  </div>

  <!-- 3. Bottom Balancing Spacer -->
  <div class="h-2 sm:h-4 w-full pointer-events-none" aria-hidden="true"></div>

  <!-- 4. Torn Paper Edge Transition -->
  <TornPaperDivider color="#f1f4ef" />
</section>
