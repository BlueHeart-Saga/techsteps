          >
            Contact Us
          </a>
        </div>*/}
      </div>

      <!-- =========================
           HERO IMAGE (Right)
      ========================= -->
      <div class="lg:col-span-5 xl:col-span-5 flex items-end justify-center lg:justify-end relative self-end">
        <div class="relative flex items-end justify-end w-full max-w-[480px] lg:max-w-none">
          <img
            src="/images/brand/hero_person_box.webp"
            alt={
              hero?.imageAlt ||
              'Techsteps sustainable IT recycling technician holding box of electronics'
            }
            class="hero-person-img w-full h-auto max-h-[380px] sm:max-h-[440px] lg:max-h-[500px] xl:max-h-[540px] object-contain pointer-events-none select-none block"
            width="2738"
            height="2654"
            loading="eager"
            decoding="sync"
            fetchpriority="high"
          />
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .hero-person-img {
    image-rendering: -webkit-optimize-contrast;
    image-rendering: high-quality;
    transform: translateZ(0);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
</style>
