---
import BrandLogo from '../global/BrandLogo.astro';
import TornPaperDivider from '../layout/TornPaperDivider.astro';
---

<section class="relative w-full overflow-hidden bg-slate-950 min-h-[640px] sm:min-h-[700px] lg:min-h-[760px] flex flex-col justify-between select-none">
  <!-- Background Image: Hardware Recycling Technician (Full-Bleed) -->
  <img
    src="/images/brand/hero-technician-hardware.jpg?v=2"
    alt="IT recycling technician inspecting motherboards and electronic components"
    class="absolute inset-0 w-full h-full object-cover object-[75%_center] lg:object-right select-none pointer-events-none"
    loading="eager"
    decoding="async"
  />

  <!-- Multi-layered Atmospheric Vignettes & Dedicated Left-Side Black Scrim for High Text Visibility -->
  <div class="absolute inset-0 bg-gradient-to-r from-black/95 via-black/80 via-48% to-transparent pointer-events-none z-[1]"></div>
  <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-transparent to-black/40 pointer-events-none z-[1]"></div>
  <div class="absolute inset-x-0 top-0 h-28 bg-gradient-to-b from-black/50 to-transparent pointer-events-none z-[1]"></div>

  <!-- 1. Integrated Navbar at Top of Hero (Full width, \ curve leading edge) -->
  <header id="hero-header" class="relative z-50 w-full flex items-center justify-between h-20 sm:h-22">
    <!-- Left: Transparent Brand Area (Cavern Vista visible behind logo, enlarged logo size) -->
    <div class="flex items-center h-full pl-6 sm:pl-10 lg:pl-12 pr-2 sm:pr-4 bg-transparent shrink-0">
      <a
        href="/"
        class="flex items-center focus:outline-none focus:ring-2 focus:ring-emerald-400 rounded-lg py-1.5"
        aria-label="TechSteps UK Home"
      >
        <BrandLogo size="xl" variant="light" showTagline={false} />
      </a>
    </div>

    <!-- Right / Other Area: White Bar with \ Smooth Curved Leading Edge -->
    <div class="h-full flex-1 flex items-center justify-end min-w-0">
      <!-- SVG Curved Leading Edge (\ slope with G1 smooth bezier rounding) -->
      <svg
        viewBox="0 0 64 88"
        preserveAspectRatio="none"
        class="h-full w-10 sm:w-14 lg:w-16 shrink-0 -mr-[1px] pointer-events-none select-none drop-shadow-xs"
        aria-hidden="true"
      >
        <!-- White Filled Wedge with \ slope -->
        <path
          d="M 0,0 Q 14,0 24,20 L 44,66 Q 52,88 64,88 L 64,0 Z"
          fill="#FFFFFF"
        />
      </svg>

      <!-- Solid White Navigation Container (No Bottom Border) -->
      <div class="h-full flex-1 flex items-center justify-end bg-white shadow-md pl-2 sm:pl-4 pr-6 sm:pr-10 lg:pr-12">
        <nav class="hidden lg:flex items-center space-x-6 xl:space-x-8 text-[16px] xl:text-[17px] font-sans tracking-normal" aria-label="Main Navigation">
          <a
            href="/about-us"
            class="py-1.5 px-1 border-b-2 border-transparent bg-transparent text-slate-600 hover:text-slate-950 hover:border-slate-800 font-medium transition-all duration-150"
          >
            About Us
          </a>

          <!-- Services Mega Menu Link (Direct Click to /services, Hover Opens Mega Menu) -->
          <div class="relative flex items-center group">
            <a
              href="/services"
              class="services-megamenu-toggle text-slate-600 hover:text-slate-950 transition-all duration-150 inline-flex items-center gap-1.5 py-1.5 px-1 border-b-2 border-transparent hover:border-slate-800 font-medium cursor-pointer focus:outline-none bg-transparent"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="services-megamenu-panel"
              data-is-active-route="false"
            >
              <span>Services</span>
              <svg class="h-3.5 w-3.5 text-slate-400 group-hover:text-slate-700 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>

          <!-- Sectors Dropdown Link (Direct Click to /sectors, Hover Opens Dropdown) -->
          <div class="relative sectors-trigger-wrap flex items-center group">
            <a
              href="/sectors"
              class="sectors-dropdown-toggle inline-flex items-center gap-1.5 py-1.5 px-1 border-b-2 border-transparent text-slate-600 hover:text-slate-950 hover:border-slate-800 transition-all duration-150 font-medium cursor-pointer focus:outline-none bg-transparent"
              aria-expanded="false"
              aria-haspopup="true"
              aria-controls="sectors-dropdown-panel"
              data-is-active-route="false"
            >
              <span>Sectors</span>
              <svg class="h-3.5 w-3.5 text-slate-400 group-hover:text-slate-700 transition-transform duration-200 caret-icon shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
              </svg>
            </a>
          </div>

          <a
            href="/sustainability"
            class="py-1.5 px-1 border-b-2 border-transparent bg-transparent text-slate-600 hover:text-slate-950 hover:border-slate-800 font-medium transition-all duration-150"
          >
            Sustainability
          </a>

          <a
            href="/insights"
            class="py-1.5 px-1 border-b-2 border-transparent bg-transparent text-slate-600 hover:text-slate-950 hover:border-slate-800 font-medium transition-all duration-150"
          >
            Insights
          </a>

          <a
            href="/contact"
            class="py-1.5 px-1 border-b-2 border-transparent bg-transparent text-slate-600 hover:text-slate-950 hover:border-slate-800 font-medium transition-all duration-150"
          >
            Contact
          </a>
        </nav>

        <!-- CTA Pill Button & Mobile Trigger in White Area -->
        <div class="flex items-center gap-3 ml-6 sm:ml-8">
          <a
            href="/request-a-quote"
            class="hidden sm:inline-flex items-center justify-center px-6 py-2.5 rounded-full bg-[#009b3a] hover:bg-[#146B5C] text-white text-[15px] font-sans font-bold shadow-md hover:shadow-lg transition-all duration-150 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#009b3a]"
          >
            Request a Collection
          </a>

          <!-- Mobile Hamburger Button -->
          <button
            type="button"
            class="open-mobile-menu-btn lg:hidden p-2 rounded-lg text-slate-700 hover:text-black hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-emerald-400"
            aria-label="Open mobile navigation menu"
          >
            <svg class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
      </div>
    </div>
  </header>

  <!-- 2. Hero Content (Left Narrative with background technician visible on the right) -->
  <div class="relative z-10 w-full max-w-7xl mx-auto px-6 sm:px-10 lg:px-12 py-14 sm:py-20 lg:py-28 my-auto">
    <div class="max-w-2xl lg:max-w-3xl">
      <span class="inline-block text-sm sm:text-base font-sans font-bold uppercase tracking-wider text-[#2EC458] mb-4">
        SUSTAINABLE IT RECYCLING
      </span>

      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-white tracking-tight uppercase leading-[1.12] drop-shadow-2xl">
        GIVING TECHNOLOGY A SECOND LIFE
      </h1>

      <p class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-200 max-w-xl leading-relaxed font-sans font-normal font-[400]">
        We responsibly recycle and remarket retired IT equipment, ensuring zero landfill and maximum value recovery.
      </p>
    </div>
  </div>

  <!-- 3. Bottom Balancing Spacer -->
  <div class="h-2 sm:h-4 w-full pointer-events-none" aria-hidden="true"></div>

  <!-- 4. Torn Paper Edge Transition -->
  <TornPaperDivider color="#f1f4ef" />
</section>
