---
import Container from '../layout/Container.astro';
import HeroHeader from '../global/HeroHeader.astro';
import SectionBackground from '../SectionBackground.astro';
import { getHomePage } from '../../lib/sanity/client';

const homePage = await getHomePage();
const hero = homePage?.hero;
---

<!-- =========================
     HOME HERO SECTION
========================= -->
<section
  id="hero"
  class="relative w-full bg-transparent overflow-hidden flex flex-col justify-between lg:min-h-[100dvh]"
>
  <!-- Ambient Mint Glow and Floating Bubbles -->
  <SectionBackground
    variant="glow"
    glow={true}
    glowPosition="right"
    showBubbles={true}
    bubbleCount={3}
  />

  <!-- Top Hero Header -->
  <HeroHeader isHome={true} />

  <!-- Hero Content -->
  <Container className="flex-1 flex flex-col justify-center w-full">
    <div class="relative w-full py-8 sm:py-10 lg:py-4 xl:py-6 2xl:py-8 flex-1 flex flex-col justify-center">

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 xl:gap-10 2xl:gap-12 items-center">

        <!-- =========================
             HERO CONTENT (Left on Desktop, Top on Mobile)
        ========================= -->
        <div class="lg:col-span-6 xl:col-span-6 max-w-2xl lg:max-w-none pt-2 sm:pt-4 z-10 flex flex-col justify-center">

          <!-- Eyebrow Badge -->
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0F623A]/10 text-[#0F623A] text-xs sm:text-sm font-sans font-bold uppercase tracking-[0.18em] mb-3 sm:mb-4 w-fit">
            <span>{hero?.eyebrow || 'SUSTAINABLE IT RECYCLING'}</span>
          </div>

          <!-- Heading -->
          <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[42px] xl:text-[50px] 2xl:text-[56px] font-semibold text-slate-900 tracking-normal leading-[1.14] sm:leading-[1.12] lg:leading-[1.1] max-w-xl">
            {hero?.heading ? (
              hero.heading === 'Creating Value From Each Device' ? (
                <>Creating Value<br class="hidden sm:inline" /> From Each Device</>
              ) : (
                hero.heading
              )
            ) : (
              <>Creating Value<br class="hidden sm:inline" /> From Each Device</>
            )}
          </h1>

          <!-- Description -->
          <p class="mt-3.5 sm:mt-4 lg:mt-4 xl:mt-5 text-base sm:text-lg lg:text-[16px] xl:text-[18px] text-slate-700 max-w-lg leading-relaxed font-sans font-normal">
            {hero?.description || 'Techsteps securely reuse and recycle retired IT assets, reducing waste while recovering maximum value responsibly.'}
          </p>

          <!-- CTA Buttons -->
          <div class="mt-6 sm:mt-7 lg:mt-6 xl:mt-8 flex flex-wrap items-center gap-3.5 sm:gap-4">
            <a
              href={hero?.buttonLink || "/services"}
              class="inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3 sm:py-3.5 rounded-[12px] bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm sm:text-base font-bold shadow-md hover:shadow-lg transition-all duration-200 hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
            >
              <span>{hero?.buttonText || "Explore Services"}</span>
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>

            <a
              href={hero?.secondaryButtonLink || "/contact"}
              class="inline-flex items-center justify-center px-6 sm:px-7 py-3 sm:py-3.5 rounded-[12px] bg-white hover:bg-slate-50 border-2 border-[#0F623A] hover:border-[#0c4e2e] text-[#0F623A] hover:text-[#0c4e2e] text-sm sm:text-base font-bold transition-all duration-200 hover:scale-[1.02] shadow-xs focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
            >
              {hero?.secondaryButtonText || "Contact Us"}
            </a>
          </div>
        </div>

        <!-- =========================
             HERO IMAGE (Single Image for all screen sizes)
             - On Mobile: Centered below text in natural flow
             - On Desktop: Right column filling initial screen
        ========================= -->
        <div class="lg:col-span-6 xl:col-span-6 flex justify-center lg:justify-end items-center w-full z-0 mt-6 lg:mt-0">
          <div class="relative w-full max-w-[340px] sm:max-w-[420px] md:max-w-[460px] lg:max-w-none flex justify-center lg:justify-end items-center">
            <img
              src="/images/brand/home-hero.png"
              alt={hero?.imageAlt || 'Techsteps sustainable IT recycling technician'}
              class="w-full h-auto max-h-[360px] sm:max-h-[440px] md:max-h-[480px] lg:max-h-[min(540px,calc(100dvh-170px))] xl:max-h-[min(620px,calc(100dvh-180px))] 2xl:max-h-[min(700px,calc(100dvh-200px))] object-contain object-center lg:object-right select-none mx-auto lg:ml-auto block drop-shadow-sm"
              loading="eager"
              fetchpriority="high"
              decoding="sync"
              width="1254"
              height="1254"
            />
          </div>
        </div>

      </div>
    </div>
  </Container>

  <!-- =========================
       TORN PAPER DIVIDER (Bottom)
  ========================= -->
</section>

<style>
  #hero {
    background: #FFFFFF;
  }
</style>