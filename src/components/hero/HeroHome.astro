---
import HeroHeader from '../global/HeroHeader.astro';
import { getHomePage } from '../../lib/sanity/client';

const homePage = await getHomePage();
const hero = homePage?.hero;
---

<!-- =========================
     HOME HERO SECTION
========================= -->
<section
  id="hero"
  class="relative w-full overflow-hidden bg-[#07572F] select-none"
>
  <!-- Background Image with smooth organic white-to-green transition -->
  <img
    src="/images/brand/hero_banner_background.webp"
    alt=""
    aria-hidden="true"
    class="absolute inset-0 w-full h-full object-fill pointer-events-none select-none z-0"
    loading="eager"
    fetchpriority="high"
    decoding="sync"
  />

  <!-- Top Hero Header (Transparent on home, integrated with hero background) -->
  <HeroHeader isHome={true} />

  <!-- Main Hero Grid Container -->
  <div
    class="relative z-10 w-full max-w-7xl mx-auto
           px-4 sm:px-6 lg:px-8
           pt-4 sm:pt-6 lg:pt-8 xl:pt-10
           pb-0"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-10 items-center">

      <!-- =========================
           HERO CONTENT (Left)
      ========================= -->
      <div class="lg:col-span-7 xl:col-span-7 max-w-2xl lg:max-w-none pt-2 sm:pt-4 lg:pt-6 pb-8 sm:pb-12 lg:pb-16 z-10">

        <!-- Eyebrow -->
        <span
          class="inline-block
                 text-xs sm:text-sm
                 font-sans font-bold
                 uppercase
                 tracking-[0.2em]
                 text-white/90
                 mb-3 sm:mb-4"
        >
          {hero?.eyebrow || 'SUSTAINABLE IT RECYCLING'}
        </span>

        <!-- Heading: Serif font matching reference with 2-line break -->
        <h1
          class="font-display font-serif
                 text-3xl sm:text-4xl md:text-5xl lg:text-[54px] xl:text-[60px]
                 font-normal
                 text-white
                 tracking-tight
                 leading-[1.12] sm:leading-[1.08]
                 max-w-2xl"
          style="font-family: 'Lora', Georgia, serif;"
        >
          Creating Value<br />From Each Device
        </h1>

        <!-- Description -->
        <p
          class="mt-4 sm:mt-5
                 text-sm sm:text-base lg:text-[17px]
                 text-white/90
                 max-w-xl
                 leading-relaxed
                 font-sans font-normal"
        >
          {
            hero?.description ||
            'Techsteps securely reuse and recycle retired IT assets, reducing waste while recovering maximum value responsibly.'
          }
        </p>

        <!-- CTA Buttons -->
        {/*<div
          class="mt-6 sm:mt-8
                 flex flex-wrap
                 items-center
                 gap-3.5 sm:gap-4"
        >
          <!-- Explore Services Button -->
          <a
            href="/services"
            class="inline-flex items-center justify-center
                   gap-2.5
                   px-6 sm:px-7
                   py-3 sm:py-3.5
                   rounded-full
                   bg-white hover:bg-white/90
                   text-[#07572F]
                   text-sm sm:text-base
                   font-semibold
                   shadow-md
                   transition-all duration-200
                   hover:scale-[1.02]
                   focus:outline-none focus:ring-2 focus:ring-white"
          >
            <span>Explore Services</span>
            <svg
              class="w-4 h-4 text-[#07572F]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>

          <!-- Contact Us Button -->
          <a
            href="/contact"
            class="inline-flex items-center justify-center
                   px-6 sm:px-7
                   py-3 sm:py-3.5
                   rounded-full
                   bg-transparent hover:bg-white/10
                   border border-white/60 hover:border-white
