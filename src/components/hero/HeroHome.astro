---
import HeroHeader from '../global/HeroHeader.astro';
import TornPaperDivider from '../layout/TornPaperDivider.astro';
import { getHomePage } from '../../lib/sanity/client';

const homePage = await getHomePage();
const hero = homePage?.hero;
---

<!-- =========================
     HERO NAVBAR
========================= -->
<HeroHeader />

<!-- =========================
     HERO SECTION
========================= -->
<section
  class="relative w-full overflow-hidden bg-white select-none"
  style="background-color: #ffffff !important;"
>

  <!-- Main Hero Grid Container -->
  <div
    class="relative z-10 w-full max-w-[1920px] mx-auto
           px-6 sm:px-10 lg:px-12 xl:px-16
           pt-4 sm:pt-6 lg:pt-6 xl:pt-8
           pb-0"
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-10 items-end">

      <!-- =========================
           HERO CONTENT (Left)
      ========================= -->
      <div class="lg:col-span-7 xl:col-span-6 max-w-2xl lg:max-w-3xl pt-2 sm:pt-4 lg:pt-6 pb-6 sm:pb-8 lg:pb-12 z-10">

        <!-- Eyebrow -->
        <span
          class="inline-block
                 text-sm sm:text-base
                 font-sans font-bold
                 uppercase
                 tracking-[0.18em]
                 text-[#07572F]
                 mb-3 sm:mb-4"
        >
          {hero?.eyebrow || 'SUSTAINABLE IT RECYCLING'}
        </span>

        <!-- Heading -->
        <h1
          class="font-display
                 text-4xl sm:text-5xl
                 lg:text-6xl xl:text-7xl
                 font-extrabold
                 text-[#171717]
                 tracking-tight
                 uppercase
                 leading-[1.08]
                 max-w-3xl"
        >
          {hero?.heading || 'CREATING VALUE FROM EACH DEVICE'}
        </h1>

        <!-- Description -->
        <p
          class="mt-5 sm:mt-6
                 text-base sm:text-lg
                 text-slate-700
                 max-w-xl
                 leading-relaxed
                 font-sans font-normal"
        >
          {
            hero?.description ||
            'Techsteps securely reuse and recycle retired IT assets, reducing waste while recovering maximum value responsibly.'
          }
        </p>

        <!-- CTA Buttons -->
        <div
          class="mt-7 sm:mt-8
                 flex flex-wrap
                 items-center
                 gap-3.5 sm:gap-4"
        >
          <!-- Explore Services -->
          <a
            href="/services"
            class="inline-flex items-center justify-center
                   gap-2
                   px-6 sm:px-7
                   py-3 sm:py-3.5
                   rounded-md
                   bg-[#07572F] hover:bg-[#054424]
                   text-white
                   text-sm sm:text-base
                   font-bold
                   shadow-md
                   transition-all duration-200
                   hover:scale-[1.02]"
          >
            Explore Services
            <svg
              class="w-4 h-4"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>

          <!-- Contact Us -->
          <a
            href="/contact"
            class="inline-flex items-center justify-center
                   px-6 sm:px-7
                   py-3 sm:py-3.5
                   rounded-md
                   bg-white hover:bg-slate-50
                   border border-slate-300
                   text-[#171717]
                   text-sm sm:text-base
                   font-bold
                   transition-all duration-200
                   hover:scale-[1.02]
                   shadow-xs"
          >
            Contact Us
          </a>
        </div>

      </div>

      <!-- =========================
           HERO IMAGE (Right)
      ========================= -->
      <div class="lg:col-span-5 xl:col-span-6 flex items-end justify-center lg:justify-end relative lg:pr-4 xl:pr-10">
        <div class="relative flex items-end justify-end">
          <img
            src="/images/brand/hero-man-ssd.png"
            alt={
              hero?.imageAlt ||
              'Techsteps sustainable IT lifecycle, secure erase, and certified IT recycling'
            }
            class="w-auto h-auto max-h-[380px] sm:max-h-[440px] lg:max-h-[480px] xl:max-h-[520px] 2xl:max-h-[580px] max-w-full lg:max-w-none pointer-events-none select-none [filter:contrast(101.5%)_brightness(101%)] block"
            loading="eager"
            decoding="async"
          />
        </div>
      </div>

    </div>
  </div>

  <!-- =========================
       TORN PAPER DIVIDER
  ========================= -->
  <div class="relative w-full z-20">
    <TornPaperDivider color="#f1f4ef" />
  </div>

</section>

