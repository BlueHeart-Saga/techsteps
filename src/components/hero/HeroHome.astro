---
import HeroHeader from '../global/HeroHeader.astro';
import TornPaperDivider from '../layout/TornPaperDivider.astro';
import { getHomePage } from '../../lib/sanity/client';

const homePage = await getHomePage();
const hero = homePage?.hero;

---

<!-- Hero Header sits at the very top (above the hero section) -->
<HeroHeader />

<!-- Hero Section below the header -->
<section class="relative w-full overflow-hidden bg-white min-h-[580px] sm:min-h-[640px] lg:min-h-[720px] flex flex-col justify-between select-none">
  <!-- Hero Background Image (No overlay) -->
  <img
    src="/images/brand/hero-process-lifecycle.png"
    alt={hero?.imageAlt || 'Techsteps sustainable IT lifecycle, secure erase, and certified IT recycling'}
    class="absolute inset-0 w-full h-full object-cover object-[78%_center] lg:object-right select-none pointer-events-none"
    loading="eager"
    decoding="async"
  />

  <!-- Hero Content (Left narrative aligned below header) -->
  <div class="relative z-10 w-full px-6 sm:px-10 lg:px-12 py-10 sm:py-16 lg:py-20 my-auto">
    <div class="max-w-2xl lg:max-w-3xl">
      <span class="inline-block text-sm sm:text-base font-sans font-bold uppercase tracking-wider text-[#07572F] mb-3 sm:mb-4">
        {hero?.eyebrow || 'SUSTAINABLE IT RECYCLING'}
      </span>

      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-extrabold text-[#171717] tracking-tight uppercase leading-[1.12]">
        {hero?.heading || 'GIVING TECHNOLOGY A SECOND LIFE'}
      </h1>

      <p class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-700 max-w-xl leading-relaxed font-sans font-normal font-[400]">
        {hero?.description || 'Audited IT lifecycle solutions from accredited facilities across the UK. Zero-landfill guaranteed e-waste recycling, secure ADISA-certified data destruction, and compliant asset disposition.'}
      </p>

      <!-- Hero CTA Buttons: Service & Contact -->
      <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-3.5 sm:gap-4">
        <a
          href="/services"
          class="inline-flex items-center justify-center gap-2 px-6 sm:px-7 py-3 sm:py-3.5 rounded-md bg-[#07572F] hover:bg-[#054424] text-white text-sm sm:text-base font-bold shadow-md transition-all duration-200 hover:scale-[1.02]"
        >
          Explore Services
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>

        <a
          href="/contact"
          class="inline-flex items-center justify-center px-6 sm:px-7 py-3 sm:py-3.5 rounded-md bg-white hover:bg-slate-50 border border-slate-300 text-[#171717] text-sm sm:text-base font-bold transition-all duration-200 hover:scale-[1.02] shadow-xs"
        >
          Contact Us
        </a>
      </div>
    </div>
  </div>

  <!-- Bottom Balancing Spacer -->
  <div class="h-2 sm:h-4 w-full pointer-events-none" aria-hidden="true"></div>

  <!-- Torn Paper Edge Transition into page content -->
  <TornPaperDivider color="#f1f4ef" />
</section>
