---
import type { FAQItem } from '../../lib/sanity/types';

interface Props {
  faqs: FAQItem[];
  title?: string;
  subtitle?: string;
}

const {
  faqs,
  title = 'Frequently Asked Questions',
  subtitle = 'Clear answers regarding our security protocols, regulatory compliance, and UK operations.',
} = Astro.props;
---

<div class="space-y-8 max-w-4xl mx-auto">
  <div class="text-center space-y-3">
    <h2 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-brand-navy tracking-tight">
      {title}
    </h2>
    {subtitle && (
      <p class="text-sm sm:text-base text-slate-600">
        {subtitle}
      </p>
    )}
  </div>

  <div class="space-y-4">
    {faqs.map((faq, index) => (
      <details class="group bg-white rounded-xl border border-slate-200/90 shadow-xs open:shadow-md transition-all overflow-hidden">
        <summary class="flex items-center justify-between p-5 text-left text-base sm:text-lg font-bold text-brand-navy cursor-pointer list-none select-none hover:text-brand-accent focus:outline-none focus:ring-2 focus:ring-brand-accent">
          <span>{faq.question}</span>
          <span class="ml-4 flex-shrink-0 text-slate-400 group-hover:text-brand-accent transition-transform duration-200 group-open:rotate-180">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
            </svg>
          </span>
        </summary>
        <div class="px-5 pb-5 pt-1 text-sm sm:text-base text-slate-600 leading-relaxed border-t border-slate-100">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</div>
