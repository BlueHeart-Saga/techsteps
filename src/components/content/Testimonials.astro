---
import { getTestimonials } from '../../lib/sanity/client';
import type { TestimonialItem } from '../../lib/sanity/types';

interface Props {
  eyebrow?: string;
  heading?: string;
  description?: string;
  testimonials?: TestimonialItem[];
}

const {
  eyebrow: customEyebrow,
  heading: customHeading,
  description: customDescription,
  testimonials: customTestimonials,
} = Astro.props;

const sanityTestimonials = await getTestimonials();

const fallbackTestimonials: TestimonialItem[] = [
  {
    id: 't1',
    quote: 'Impressed by the security rigor, speed, and attention to detail from day one. TechSteps transformed our lifecycle compliance.',
    author: 'David Miller',
    role: 'Head of Infrastructure Security',
    company: 'Defence Prime Contractor',
    industry: 'Defence',
    rating: 5,
    avatar: '/images/testimonials/avatar-1.jpg',
  },
  {
    id: 't2',
    quote: 'A seamless experience from start to finish. Freed 4,000 sq ft of hospital ward space with zero data risk and verified audit trails.',
    author: 'Sarah Jenkins',
    role: 'Director of Health Records',
    company: 'NHS Foundation Trust',
    industry: 'Healthcare',
    rating: 5,
    avatar: '/images/testimonials/avatar-2.jpg',
  },
  {
    id: 't3',
    quote: 'Reliable and trustworthy. Handled our weekend trading floor relocation and server migration with complete security and zero downtime.',
    author: 'James Roberts',
    role: 'Chief Technology Officer',
    company: 'Tier 1 Investment Bank',
    industry: 'Financial Services',
    rating: 5,
    avatar: '/images/testimonials/avatar-3.jpg',
  },
  {
    id: 't4',
    quote: 'Exceeded all GGC zero-landfill mandates while delivering defensible Scope 3 carbon compliance and certified destruction.',
    author: 'Eleanor Vance',
    role: 'Governance & Information Director',
    company: 'Central Government Agency',
    industry: 'Central Government',
    rating: 5,
    avatar: '/images/testimonials/avatar-4.jpg',
  },
  {
    id: 't5',
    quote: 'Digitized 80 years of irreplaceable historical research archives with 100% precision, full indexation, and BS 10008 legal admissibility.',
    author: 'Prof. Marcus Thorne',
    role: 'Dean of Research Operations',
    company: 'Russell Group University',
    industry: 'Education & Research',
    rating: 5,
    avatar: '/images/testimonials/avatar-5.jpg',
  },
  {
    id: 't6',
    quote: 'Unlocked substantial rebate value from our retired enterprise server fleet with certified NIST 800-88 erasure and chain of custody.',
    author: 'Rachel Adams',
    role: 'Global Head of ESG & Sustainability',
    company: 'Enterprise Technology Corp',
    industry: 'Technology',
    rating: 5,
    avatar: '/images/testimonials/avatar-6.jpg',
  },
];

const sourceList: TestimonialItem[] = (customTestimonials && customTestimonials.length > 0)
  ? customTestimonials
  : (sanityTestimonials && sanityTestimonials.length > 0)
    ? sanityTestimonials
    : fallbackTestimonials;

const sectionEyebrow = customEyebrow || 'Client testimonials';
const sectionHeading = customHeading || 'What our clients say';
const sectionDescription = customDescription || 'Discover how UK enterprises trust Techsteps for secure IT asset disposition, compliant records management, and certified data sanitisation.';

function getInitials(name: string): string {
  if (!name) return 'TS';
  const parts = name.trim().split(/\s+/);
  if (parts.length >= 2) {
    return `${parts[0][0]}${parts[parts.length - 1][0]}`.toUpperCase();
  }
  return name.slice(0, 2).toUpperCase();
}

// Since sourceList has 6 testimonials (< 8), repeat twice in each half
// Half 1: 12 cards, Half 2: 12 cards -> Total: 24 cards
// Both halves contain the exact same number of cards (12 cards each)
const halfOne = [...sourceList, ...sourceList];
const halfTwo = [...sourceList, ...sourceList];
const allCards = [...halfOne, ...halfTwo];
const uniqueCount = sourceList.length;
---

<section
  id="client-testimonials-section"
  class="testimonials-marquee-section relative bg-[#F1F4EF] py-[68px] lg:pt-[104px] lg:pb-[96px] overflow-hidden text-slate-900 border-t border-slate-200/80 select-none"
  aria-labelledby="testimonials-heading"
>
  <!-- Ambient Soft Eco Glow Background Accents -->
  <div class="absolute inset-0 pointer-events-none select-none overflow-hidden" aria-hidden="true">
    <div class="absolute top-0 right-1/4 w-[500px] h-[500px] rounded-full bg-emerald-100/25 blur-[130px]"></div>
    <div class="absolute bottom-0 left-1/4 w-[450px] h-[450px] rounded-full bg-[#EEF7F2]/60 blur-[130px]"></div>
  </div>

  <!-- Centred Section Header -->
  <div class="relative z-10 max-w-3xl mx-auto mb-10 sm:mb-14 lg:mb-16 px-4 text-center">
    <!-- Faint oversized decorative quote mark behind heading (rgba(15,98,58,.05)) -->
    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none select-none -z-10" aria-hidden="true">
      <svg class="w-44 h-44 sm:w-60 sm:h-60 text-[#0F623A]/[0.05]" fill="currentColor" viewBox="0 0 24 24">
        <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
      </svg>
    </div>

    <!-- Eyebrow: Small uppercase green eyebrow with short lines either side -->
    <div class="inline-flex items-center justify-center gap-3 mb-3">
      <span class="w-7 sm:w-10 h-[1.5px] bg-[#0F623A]/40" aria-hidden="true"></span>
      <span class="text-xs sm:text-[13px] font-mono font-bold tracking-[0.22em] text-[#0F623A] uppercase">
        {sectionEyebrow}
      </span>
      <span class="w-7 sm:w-10 h-[1.5px] bg-[#0F623A]/40" aria-hidden="true"></span>
    </div>

    <!-- Heading: Sentence-case, existing heading text -->
    <h2
      id="testimonials-heading"
      class="text-3xl sm:text-4xl lg:text-[44px] font-extrabold font-display text-slate-900 tracking-tight leading-[1.14] mb-3 sm:mb-4 text-balance"
    >
      {sectionHeading}
    </h2>

    <!-- Supporting description -->
    {sectionDescription && (
      <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal max-w-2xl mx-auto">
        {sectionDescription}
      </p>
    )}
  </div>

  <!-- ONE Horizontal Row of Cards inside Full-Width Container with Edge-Fade Masks -->
  <div class="testimonial-marquee-wrapper relative w-full overflow-hidden">
    <!-- Flex Marquee Track -->
    <div
      class="testimonial-track track"
      id="testimonial-track"
      role="region"
      aria-label="Client review carousel"
    >
      {allCards.map((item, index) => {
        // First `uniqueCount` items are read by screen readers; subsequent duplicate repetitions have aria-hidden="true"
        const isDuplicate = index >= uniqueCount;
        // Alternating card variant: every second card is dark variant (#0F623A to #083d24)
        const isDark = (index % 2 === 1);

        return (
          <article
            class={`testimonial-card ${isDark ? 'testimonial-card-dark' : 'testimonial-card-light'}`}
            aria-hidden={isDuplicate ? 'true' : undefined}
          >
            <!-- Top: 44px rounded-square (12px radius) tile with green gradient & white quote-mark glyph -->
            <div
              class={`w-[44px] h-[44px] rounded-[12px] flex items-center justify-center shrink-0 shadow-xs ${
                isDark
                  ? 'bg-[#3FB33D] text-[#083d24]'
                  : 'bg-gradient-to-br from-[#0F623A] to-[#083d24] text-white'
              }`}
              aria-hidden="true"
            >
              <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
              </svg>
            </div>

            <!-- Middle: Quote Text (19px, weight 500, line-height 1.5, 17px on mobile, never truncated) -->
            <blockquote
              class={`m-0 p-0 text-[17px] sm:text-[19px] font-medium leading-[1.5] flex-1 ${
                isDark ? 'text-white' : 'text-slate-800'
              }`}
            >
              "{item.quote}"
            </blockquote>

            <!-- Bottom: 1px divider + Avatar, Name, Role & Company -->
            <div class="mt-auto space-y-[22px]">
              <div
                class={`h-[1px] w-full ${isDark ? 'bg-white/15' : 'bg-[#dbe7df]'}`}
                aria-hidden="true"
              ></div>

              <div class="flex items-center gap-3.5">
                <!-- Avatar: 46px circle with 2px #3FB33D ring -->
                <div
                  class={`relative shrink-0 w-[46px] h-[46px] rounded-full overflow-hidden ring-2 ring-[#3FB33D] ${
                    isDark ? 'bg-white/10' : 'bg-[#EEF7F2]'
                  }`}
                >
                  {item.avatar ? (
                    <img
                      src={item.avatar}
                      alt={isDuplicate ? '' : `${item.author} avatar`}
                      class="w-full h-full object-cover"
                      width="46"
                      height="46"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div
                      class={`w-full h-full flex items-center justify-center font-bold text-sm ${
                        isDark ? 'text-white' : 'text-[#0F623A]'
                      }`}
                      aria-hidden="true"
                    >
                      {getInitials(item.author)}
                    </div>
                  )}
                </div>

                <!-- Name, Role and Company (No truncation, allowed to wrap naturally onto multiple lines) -->
                <div class="min-w-0 flex-1">
                  <h3
                    class={`text-base font-bold leading-snug tracking-tight ${
                      isDark ? 'text-white' : 'text-[#0F623A]'
                    }`}
                  >
                    {item.author}
                  </h3>
                  <p
                    class={`text-[13px] leading-snug mt-0.5 ${
                      isDark ? 'text-emerald-100/85' : 'text-slate-600'
                    }`}
                  >
                    {item.role}{item.company ? ` • ${item.company}` : ''}
                  </p>
                </div>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </div>

</section>

<style>
  /* ---------------------------------------------------- */
  /* EDGE-FADE GRADIENT MASKS ON FULL-WIDTH TRACK WRAPPER */
  /* ---------------------------------------------------- */
  .testimonial-marquee-wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent 0%, #000 9%, #000 91%, transparent 100%);
    -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 9%, #000 91%, transparent 100%);
    padding: 12px 0 18px;
  }

  /* ---------------------------------------------------- */
  /* MARQUEE TRACK ANIMATION (PURE CSS)                   */
  /* ---------------------------------------------------- */
  .testimonial-track {
    display: flex;
    gap: 22px;
    width: max-content;
    animation: run 72s linear infinite;
    will-change: transform;
  }

  /* Seamless loop: exactly -50% - 11px (half of 22px gap) */
  @keyframes run {
    to {
      transform: translateX(calc(-50% - 11px));
    }
  }

  /* Pause on hover, on focus-within, and via pause button toggle */
  .testimonial-track:hover,
  .testimonial-track:focus-within,
  .testimonial-track.is-paused {
    animation-play-state: paused;
  }

  /* ---------------------------------------------------- */
  /* CARD STYLES                                          */
  /* ---------------------------------------------------- */
  .testimonial-card {
    width: 290px;
    padding: 24px 20px 20px;
    border-radius: 22px;
    display: flex;
    flex-direction: column;
    gap: 22px;
    flex-shrink: 0;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  @media (min-width: 640px) {
    .testimonial-card {
      width: 400px;
      padding: 32px 30px 26px;
    }
  }

  /* Light card variant */
  .testimonial-card-light {
    background-color: #ffffff;
    border: 1px solid #dbe7df;
    box-shadow: 0 10px 30px -5px rgba(15, 98, 58, 0.08);
  }

  .testimonial-card-light:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px -6px rgba(15, 98, 58, 0.16);
  }

  /* Dark card variant (every second card) */
  .testimonial-card-dark {
    background: linear-gradient(145deg, #0F623A 0%, #083d24 100%);
    border: 1px solid rgba(63, 179, 61, 0.25);
    box-shadow: 0 10px 30px -5px rgba(0, 0, 0, 0.22);
  }

  .testimonial-card-dark:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px -6px rgba(0, 0, 0, 0.38);
  }

  /* ---------------------------------------------------- */
  /* REDUCED MOTION PREFERENCE (ACCESSIBILITY)            */
  /* ---------------------------------------------------- */
  @media (prefers-reduced-motion: reduce) {
    .testimonial-marquee-wrapper {
      mask-image: none !important;
      -webkit-mask-image: none !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      -webkit-overflow-scrolling: touch;
      padding-left: 1.5rem;
      padding-right: 1.5rem;
    }

    .testimonial-track {
      animation: none !important;
      width: auto !important;
    }

    .testimonial-card {
      scroll-snap-align: center;
    }

    .testimonial-card[aria-hidden="true"] {
      display: none !important;
    }

    .testimonial-card:hover {
      transform: none !important;
    }

    .pause-control-wrapper {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const initPauseControl = () => {
      const btn = document.getElementById('testimonial-pause-toggle');
      const track = document.getElementById('testimonial-track');
      const pauseIcon = document.getElementById('pause-icon');
      const playIcon = document.getElementById('play-icon');
      const btnText = document.getElementById('pause-btn-text');

      if (!btn || !track) return;

      let isPaused = false;

      btn.addEventListener('click', () => {
        isPaused = !isPaused;
        if (isPaused) {
          track.classList.add('is-paused');
          btn.setAttribute('aria-pressed', 'true');
          btn.setAttribute('aria-label', 'Resume testimonial marquee animation');
          if (pauseIcon) pauseIcon.classList.add('hidden');
          if (playIcon) playIcon.classList.remove('hidden');
          if (btnText) btnText.textContent = 'Resume animation';
        } else {
          track.classList.remove('is-paused');
          btn.setAttribute('aria-pressed', 'false');
          btn.setAttribute('aria-label', 'Pause testimonial marquee animation');
          if (pauseIcon) pauseIcon.classList.remove('hidden');
          if (playIcon) playIcon.classList.add('hidden');
          if (btnText) btnText.textContent = 'Pause animation';
        }
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPauseControl);
    } else {
      initPauseControl();
    }

    document.addEventListener('astro:page-load', initPauseControl);
  })();
</script>
