---
interface Props {
  className?: string;
  theme?: 'light' | 'dark';
}

const { className = '', theme = 'light' } = Astro.props;

const badges = [
  { name: 'ADISA Standard 8.0', detail: 'IT Asset Disposal Certification' },
  { name: 'ISO 27001', detail: 'Information Security Management' },
  { name: 'ISO 14001', detail: 'Environmental Management' },
  { name: 'ISO 9001', detail: 'Quality Management System' },
  { name: 'BS EN 15713', detail: 'Secure Destruction of Material' },
  { name: 'BS 7858', detail: 'Security Vetted Personnel' },
  { name: 'Cyber Essentials Plus', detail: 'National Cyber Security Centre' },
  { name: 'Environment Agency', detail: 'AATF Licensed Waste Partner' },
];

const cardBg = theme === 'dark' ? 'bg-white/5 border-white/10 text-white' : 'bg-white border-slate-200/90 text-slate-800 shadow-xs';
const detailColor = theme === 'dark' ? 'text-slate-400' : 'text-slate-500';
---

<div class={`space-y-6 ${className}`}>
  <div class="text-center space-y-2">
    <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Enterprise Accreditations</span>
    <h3 class={`text-xl sm:text-2xl font-bold ${theme === 'dark' ? 'text-white' : 'text-brand-navy'}`}>
      Audited to the Highest Industry Standards
    </h3>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    {badges.map((b) => (
      <div class={`p-4 rounded-xl border text-center flex flex-col justify-center space-y-1 ${cardBg}`}>
        <span class="text-sm font-bold">{b.name}</span>
        <span class={`text-[11px] ${detailColor}`}>{b.detail}</span>
      </div>
    ))}
  </div>
</div>
