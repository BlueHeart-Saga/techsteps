---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/layout/Container.astro';
import HeroHeader from '../../../components/global/HeroHeader.astro';
import CTA from '../../../components/global/cta.astro';
import { allCollectionServicesList } from '../../../data/collectionServices';
import FAQSection from '../../../components/FAQSection.astro';
import { getPageFaqs } from '../../../data/pageFaqs';

const canonicalUrl = 'https://techsteps.co.uk/services/collection';

// Breadcrumb Schema
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: 'https://techsteps.co.uk/',
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Services',
      item: 'https://techsteps.co.uk/services',
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: 'IT Equipment Collection',
      item: canonicalUrl,
    },
  ],
};

// Service Schema
const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'IT Equipment Collection Services UK',
  serviceType: 'IT Asset Disposition & Hardware Collection',
  provider: {
    '@type': 'Organization',
    name: 'TechSteps UK',
    url: 'https://techsteps.co.uk',
    telephone: '+44 1784 640216',
    email: 'collection@techsteps.co.uk',
  },
  areaServed: {
    '@type': 'Country',
    name: 'United Kingdom',
  },
  description:
    'Certified nationwide collection for corporate computers, laptops, servers, mobile devices, monitors, printers, and AV equipment with chain of custody and WEEE compliance.',
  url: canonicalUrl,
};

const faqConfig = getPageFaqs('collection-overview');
const faqs = faqConfig?.faqs || [];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((faq) => ({
    '@type': 'Question',
    name: faq.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: faq.answer,
    },
  })),
};
---

<BaseLayout
  title="IT Equipment Collection Services UK | Audited Corporate IT Disposal | TechSteps"
  description="Certified nationwide collection for corporate computers, laptops, servers, mobile devices, monitors, printers, and AV equipment with chain of custody and WEEE compliance."
  canonicalUrl={canonicalUrl}
  jsonLd={[breadcrumbSchema, serviceSchema, faqSchema]}
  hasHeroHeader={true}
>
  <!-- Sticky Header -->
  <HeroHeader isHome={false} />

  <!-- =====================================================
       1. HERO SECTION
       ===================================================== -->
  <section class="relative bg-white pt-6 sm:pt-8 lg:pt-10 pb-12 sm:pb-16 lg:pb-20 border-b border-slate-200/80 overflow-hidden">
    <Container size="normal">
      
      <!-- BREADCRUMB NAVIGATION -->
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-medium text-slate-500 mb-6 sm:mb-8">
        <a href="/" class="text-slate-600 hover:text-[#07572F] transition-colors">Home</a>
        <span class="text-slate-400" aria-hidden="true">&rsaquo;</span>
        <a href="/services" class="text-slate-600 hover:text-[#07572F] transition-colors">Services</a>
        <span class="text-slate-400" aria-hidden="true">&rsaquo;</span>
        <span class="text-[#07572F] font-semibold" aria-current="page">IT Equipment Collection</span>
      </nav>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 xl:gap-16 items-center">
        
        <!-- Left: Text content -->
        <div class="lg:col-span-7 space-y-5 sm:space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#07572F]/10 border border-[#07572F]/20 text-[#07572F] text-xs font-bold uppercase tracking-wider">
            <span class="w-2 h-2 rounded-full bg-[#07572F] animate-pulse"></span>
            <span>IT Lifecycle Services &amp; Hardware Recovery</span>
          </div>

          <h1 class="text-3xl sm:text-4xl lg:text-[46px] xl:text-[52px] font-semibold text-slate-900 tracking-tight leading-[1.12] font-display">
            Enterprise IT Equipment Collection Services UK
          </h1>

          <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-normal max-w-2xl">
            Scheduled nationwide collection for redundant workplace technology. Security-vetted logistics, certified data sanitisation, and complete chain-of-custody documentation across corporate, public sector, and healthcare estates.
          </p>

          <!-- Primary & Secondary CTAs -->
          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href="/request-a-collection"
              class="inline-flex items-center justify-center gap-2.5 px-7 py-3.5 rounded-[12px] bg-[#07572F] hover:bg-[#054324] text-white text-base font-semibold shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#07572F]"
            >
              <span>Request a Collection</span>
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
              </svg>
            </a>

            <a
              href="/contact"
              class="inline-flex items-center justify-center px-6 py-3.5 rounded-[12px] bg-slate-50 hover:bg-slate-100 border border-slate-300 text-slate-800 text-base font-semibold transition-colors duration-200 focus:outline-none focus:ring-2 focus:ring-slate-400"
            >
              Contact Logistics Team
            </a>
          </div>

          <!-- Quick Trust Metrics -->
          <div class="pt-4 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs sm:text-sm text-slate-600 font-medium">
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#07572F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Nationwide Logistics Coverage</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#07572F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>Serialised Audit Manifests</span>
            </div>
            <div class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-[#07572F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span>WEEE &amp; GDPR Compliant</span>
            </div>
          </div>
        </div>

        <!-- Right: Overview Hero Image -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-[20px] overflow-hidden border border-slate-200/80 shadow-[0_20px_50px_rgba(0,0,0,0.08)] bg-slate-100">
            <img
              src="/images/collection/collection-overview-hero.jpg"
              alt="TechSteps professional IT equipment collection team handling enterprise computer roll cages"
              width="800"
              height="600"
              class="w-full h-auto object-cover object-center aspect-[4/3] select-none"
              loading="eager"
              decoding="async"
            />
          </div>
        </div>

      </div>
    </Container>
  </section>


  <!-- =====================================================
       2. SEVEN EQUIPMENT-SPECIFIC COLLECTION SERVICES GRID
       ===================================================== -->
  <section class="py-12 sm:py-16 lg:py-20 bg-[#FBFDFB] border-b border-slate-200/80">
    <Container size="normal">
      <div class="max-w-3xl mb-10 sm:mb-14">
        <span class="text-xs font-bold uppercase tracking-widest text-[#07572F] font-mono">
          EQUIPMENT-SPECIFIC DISCIPLINES
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-semibold text-slate-900 tracking-tight font-display mt-2 leading-[1.15]">
          Dedicated Hardware Collection Services
        </h2>
        <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal mt-3">
          Every category of technology hardware presents distinct data sanitisation, protective transit, and recycling requirements. Explore our tailored collection disciplines below.
        </p>
      </div>

      <!-- 7 Service Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        {allCollectionServicesList.map((service, idx) => (
          <a
            href={service.route}
            class={`group bg-white rounded-[18px] p-6 sm:p-7 border border-slate-200/90 shadow-xs hover:border-[#07572F]/50 hover:shadow-lg transition-all duration-200 flex flex-col justify-between ${
              idx === 6 ? 'md:col-span-2 lg:col-span-1' : ''
            }`}
          >
            <div>
              <div class="w-full h-44 rounded-[12px] overflow-hidden mb-5 bg-slate-100 border border-slate-100">
                <img
                  src={service.heroImage}
                  alt={service.heroImageAlt}
                  width="400"
                  height="260"
                  class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                />
              </div>

              <span class="text-xs font-bold uppercase tracking-wider text-[#07572F] block mb-2 font-mono">
                {service.heroBadge}
              </span>

              <h3 class="text-xl font-semibold text-slate-900 group-hover:text-[#07572F] transition-colors font-display mb-2.5">
                {service.title}
              </h3>

              <p class="text-sm text-slate-600 leading-relaxed line-clamp-3">
                {service.valueProposition}
              </p>
            </div>

            <div class="pt-5 mt-5 border-t border-slate-100 flex items-center justify-between text-sm font-semibold text-[#07572F]">
              <span>Explore Collection Service</span>
              <span class="group-hover:translate-x-1.5 transition-transform" aria-hidden="true">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>


  <!-- =====================================================
       3. END-TO-END COLLECTION METHODOLOGY
       ===================================================== -->
  <section id="collection-process" class="py-12 sm:py-16 lg:py-20 bg-white border-b border-slate-200/80">
    <Container size="normal">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#07572F] font-mono">
          PROVEN PROCESS FLOW
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-semibold text-slate-900 tracking-tight font-display mt-2 leading-[1.15]">
          How Our Collection Operation Works
        </h2>
        <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal mt-3">
          From initial inventory scoping through to certified facility intake and asset disposition, our structured workflow protects your chain of custody at every transition point.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-5">
        <div class="bg-slate-50 rounded-[16px] p-5 sm:p-6 border border-slate-200/80 flex flex-col justify-between">
          <div>
            <span class="inline-block text-xl font-bold font-mono text-[#07572F] bg-[#07572F]/10 px-2.5 py-1 rounded-md mb-4">
              01
            </span>
            <h3 class="text-base sm:text-[17px] font-semibold text-slate-900 mb-2 font-display">
              Scope &amp; Scheduling
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              We review asset types, volumes, building loading access, and compliance criteria, scheduling dedicated arrival times.
            </p>
          </div>
        </div>

        <div class="bg-slate-50 rounded-[16px] p-5 sm:p-6 border border-slate-200/80 flex flex-col justify-between">
          <div>
            <span class="inline-block text-xl font-bold font-mono text-[#07572F] bg-[#07572F]/10 px-2.5 py-1 rounded-md mb-4">
              02
            </span>
            <h3 class="text-base sm:text-[17px] font-semibold text-slate-900 mb-2 font-display">
              Vetted On-Site Packing
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Our security-vetted personnel load hardware into specialised roll cages, flight cases, and padded screen enclosures.
            </p>
          </div>
        </div>

        <div class="bg-slate-50 rounded-[16px] p-5 sm:p-6 border border-slate-200/80 flex flex-col justify-between">
          <div>
            <span class="inline-block text-xl font-bold font-mono text-[#07572F] bg-[#07572F]/10 px-2.5 py-1 rounded-md mb-4">
              03
            </span>
            <h3 class="text-base sm:text-[17px] font-semibold text-slate-900 mb-2 font-display">
              Tracked Fleet Transit
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Consignments depart under signed Waste Transfer Notes in satellite-tracked, locked commercial vehicles.
            </p>
          </div>
        </div>

        <div class="bg-slate-50 rounded-[16px] p-5 sm:p-6 border border-slate-200/80 flex flex-col justify-between">
          <div>
            <span class="inline-block text-xl font-bold font-mono text-[#07572F] bg-[#07572F]/10 px-2.5 py-1 rounded-md mb-4">
              04
            </span>
            <h3 class="text-base sm:text-[17px] font-semibold text-slate-900 mb-2 font-display">
              Intake &amp; Sanitisation
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Hardware is barcoded and logged. Storage media undergoes certified multipass data wiping or physical destruction.
            </p>
          </div>
        </div>

        <div class="bg-slate-50 rounded-[16px] p-5 sm:p-6 border border-slate-200/80 flex flex-col justify-between">
          <div>
            <span class="inline-block text-xl font-bold font-mono text-[#07572F] bg-[#07572F]/10 px-2.5 py-1 rounded-md mb-4">
              05
            </span>
            <h3 class="text-base sm:text-[17px] font-semibold text-slate-900 mb-2 font-display">
              Audit Handover
            </h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
              Receive complete itemised serial registers, destruction certificates, and environmental recycling documentation.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>


  <!-- =====================================================
       4. SECURITY & COMPLIANCE ASSURANCE
       ===================================================== -->
  <section class="py-12 sm:py-16 lg:py-20 bg-[#F4F8F5] border-b border-slate-200/80">
    <Container size="normal">
      <div class="max-w-3xl mb-10 sm:mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#07572F] font-mono">
          GOVERNANCE &amp; ACCREDITATIONS
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-[40px] font-semibold text-slate-900 tracking-tight font-display mt-2 leading-[1.15]">
          Compliance-First Asset Retirement
        </h2>
        <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal mt-3">
          Our processes are engineered around UK environmental and data protection legislation to insulate your organization from regulatory liabilities.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        <div class="bg-white rounded-[16px] p-6 sm:p-7 border border-slate-200/80 shadow-xs flex flex-col justify-start">
          <div class="w-10 h-10 rounded-[12px] bg-[#07572F]/10 text-[#07572F] flex items-center justify-center shrink-0 mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-semibold text-slate-900 mb-2.5 font-display">
            GDPR &amp; Data Protection Act 2018
          </h3>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            Every device housing magnetic, flash, or solid-state media is sanitized to verified international standards, preventing data breaches and protecting customer and employee records.
          </p>
        </div>

        <div class="bg-white rounded-[16px] p-6 sm:p-7 border border-slate-200/80 shadow-xs flex flex-col justify-start">
          <div class="w-10 h-10 rounded-[12px] bg-[#07572F]/10 text-[#07572F] flex items-center justify-center shrink-0 mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-semibold text-slate-900 mb-2.5 font-display">
            WEEE Directive &amp; Duty of Care
          </h3>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            All collections are fulfilled under licensed upper-tier waste carrier authorisations, accompanied by counter-signed Waste Transfer Notes complying with UK Environment Agency mandates.
          </p>
        </div>

        <div class="bg-white rounded-[16px] p-6 sm:p-7 border border-slate-200/80 shadow-xs flex flex-col justify-start">
          <div class="w-10 h-10 rounded-[12px] bg-[#07572F]/10 text-[#07572F] flex items-center justify-center shrink-0 mb-4">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h3 class="text-lg sm:text-xl font-semibold text-slate-900 mb-2.5 font-display">
            Circular Value Recovery
          </h3>
          <p class="text-sm sm:text-base text-slate-600 leading-relaxed">
            We prioritize refurbishing and testing viable business hardware for secondary commercial use, generating economic offsets and supporting corporate sustainability targets.
          </p>
        </div>
      </div>
    </Container>
  </section>


  <!-- =====================================================
       5. FREQUENTLY ASKED QUESTIONS
       ===================================================== -->
  <FAQSection
    eyebrow={faqConfig?.eyebrow || "COMMON QUESTIONS"}
    title={faqConfig?.title || "Frequently Asked Questions"}
    subtitle={faqConfig?.subtitle || "Everything you need to know about our corporate IT collection services."}
    faqs={faqs}
    sectionId="faqs"
  />

  <!-- =====================================================
       6. FINAL CTA
       ===================================================== -->
  <CTA />

</BaseLayout>
