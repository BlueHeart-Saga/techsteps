      { title: 'Comprehensive Service Inventory Log', description: 'Itemised tracking of all managed assets, serial numbers, and container identifiers.' },
      { title: 'Duty of Care & Chain-of-Custody Manifest', description: 'Official transfer records documenting secure handling and transport.' },
      { title: 'Certified Service Completion Documentation', description: 'Formal verification confirming operational execution to accredited standards.' },
    ]);

// 07 / INDUSTRIES / SECTORS: Map and filter relevant sectors
const sectorIconMap: Record<string, string> = {
  legal: 'legal',
  'legal-professional-services': 'legal',
  health: 'health',
  healthcare: 'health',
  nhs: 'health',
  finance: 'finance',
  banking: 'finance',
  corporate: 'corporate',
  public: 'public',
  government: 'public',
  'central-government': 'public',
  business: 'business',
  tech: 'business',
  'it-technology': 'business',
  defence: 'security',
  manufacturing: 'corporate',
  'manufacturing-engineering': 'corporate',
  education: 'public',
  'education-universities': 'public',
};

const filteredSectorCards = (service.relatedSectors && service.relatedSectors.length > 0)
  ? (detail.businessNeedsCards || []).filter((c) => {
      return service.relatedSectors?.some((rs) => {
        const mappedIcon = sectorIconMap[rs.toLowerCase()] || rs.toLowerCase();
        return c.icon === mappedIcon || c.title.toLowerCase().includes(rs.toLowerCase());
      });
    })
  : detail.businessNeedsCards;

const finalSectorCards = (filteredSectorCards && filteredSectorCards.length >= 3)
  ? filteredSectorCards
  : (detail.businessNeedsCards || []);

// 09 / SUCCESS STORY: Strictly related case study
const matchingCaseStudy = (allCaseStudies || []).find((cs) => {
  if (!cs.servicesUsed || !Array.isArray(cs.servicesUsed)) return false;
  const targets = [
    service.id?.toLowerCase(),
    (service as any)._id?.toLowerCase(),
    service.slug?.toLowerCase(),
    cleanSlug,
  ].filter(Boolean) as string[];

  return cs.servicesUsed.some((u: any) => {
    if (!u) return false;
    const strValues: string[] = [];
    if (typeof u === 'string') {
      strValues.push(u.toLowerCase());
    } else if (typeof u === 'object') {
      if (u._ref) strValues.push(String(u._ref).toLowerCase());
      if (u.id) strValues.push(String(u.id).toLowerCase());
      if (u._id) strValues.push(String(u._id).toLowerCase());
      if (u.slug) {
        if (typeof u.slug === 'string') strValues.push(u.slug.toLowerCase());
        else if (u.slug.current) strValues.push(String(u.slug.current).toLowerCase());
      }
    }
    return strValues.some((sv) => targets.some((t) => sv === t || sv.replace(/-services|-uk/g, '') === t.replace(/-services|-uk/g, '')));
  });
});

// 10 / RELATED SERVICES: Resolve related services
const resolvedRelatedServices = (service.relatedServices || [])
  .map((rSlug) => {
    const clean = rSlug.toLowerCase().replace(/-(uk|services|services-uk)$/, '');
    return allServices.find((s) => {
      const sClean = s.slug?.toLowerCase().replace(/-(uk|services|services-uk)$/, '');
      return s.slug?.toLowerCase() === rSlug.toLowerCase() || sClean === clean;
    });
  })
  .filter(Boolean) as Service[];

const relatedServices = resolvedRelatedServices.length >= 2
  ? resolvedRelatedServices.slice(0, 3)
  : [
      ...resolvedRelatedServices,
      ...allServices.filter((s) => s.divisionSlug === service.divisionSlug && s.slug !== service.slug && !resolvedRelatedServices.some((r) => r.slug === s.slug)),
    ].slice(0, 3);

// 11 / FREQUENTLY ASKED QUESTIONS: Exactly 6 when available
const displayedFaqs = (detail.faqs && detail.faqs.length > 0) ? detail.faqs.slice(0, 6) : [];
