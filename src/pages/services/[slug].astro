<style>
  .needs-row {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

.needs-panel {
  position: relative;
  isolation: isolate;
  overflow: hidden;
  border-radius: 1.5rem;
  background: #000;
  color: #fff;
  text-align: left;
  cursor: pointer;
  height: 88px;
  transition: height 0.6s cubic-bezier(0.4, 0, 0.2, 1),
              flex-grow 0.7s cubic-bezier(0.4, 0, 0.2, 1);
}
  .needs-panel.is-active {
    height: 290px;
  }

.np-img {
  position: absolute;
  inset: 0;
  z-index: -2;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transform: scale(1.12);
  transition: transform 0.9s cubic-bezier(0.4, 0, 0.2, 1);
}
.needs-panel.is-active .np-img {
  transform: scale(1);
}

/* Folded strips: dark layer so the vertical title is readable */
.np-dim {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: rgba(0, 0, 0, 0.5);
  transition: opacity 0.5s ease;
}
.needs-panel.is-active .np-dim {
  opacity: 0;
}

/* Open panel: dark fade behind the text only */
.np-fade {
  position: absolute;
  inset: 0;
  z-index: -1;
  background: linear-gradient(
    to top,
    rgba(0, 0, 0, 0.92) 0%,
    rgba(0, 0, 0, 0.72) 35%,
    rgba(0, 0, 0, 0) 75%
  );
  opacity: 0;
  transition: opacity 0.5s ease;
}
.needs-panel.is-active .np-fade {
  opacity: 1;
}

  .np-icon {
    position: absolute;
    top: 22px;
    left: 20px;
    width: 44px;
    height: 44px;
    border-radius: 0.875rem;
    background: rgba(255, 255, 255, 0.2);
    border: 1px solid rgba(255, 255, 255, 0.4);
    backdrop-filter: blur(4px);
    display: flex;
    align-items: center;
    justify-content: center;
    transition: left 0.5s cubic-bezier(0.4, 0, 0.2, 1), transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* No overlay: a soft text shadow keeps the words readable on the photo */
  .np-vt,
  .np-title,
  .np-desc {
    text-shadow: 0 1px 3px rgba(0, 0, 0, 0.55), 0 2px 14px rgba(0, 0, 0, 0.45);
  }

  .np-vt {
    position: absolute;
    top: 32px;
    left: 80px;
    right: 20px;
    font-size: 1.125rem;
    line-height: 1.2;
  }

  .np-body {
    position: absolute;
    left: 20px;
    right: 20px;
    top: 96px;
    display: block;
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
    transition: opacity 0.35s ease, transform 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }
  .needs-panel.is-active .np-body {
    opacity: 1;
    transform: none;
    transition-delay: 0.2s;
  }
  .np-title {
    display: none;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.15;
    margin-bottom: 0.625rem;
  }
  .np-desc {
    display: block;
    font-size: 0.875rem;
    line-height: 1.65;
    color: #fff;
  }

  @media (min-width: 1024px) {
    .needs-row {
      flex-direction: row;
      height: 460px;
    }

    .needs-panel {
      height: auto;
      flex: 1 1 0%;
      min-width: 0;
      transition: flex-grow 0.7s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .needs-panel.is-active {
      height: auto;
      flex-grow: 5;
    }

    .np-icon {
      top: 22px;
      left: 50%;
      transform: translateX(-50%);
    }
    .needs-panel.is-active .np-icon {
      left: 24px;
      transform: translateX(0);
    }

.np-vt {
  position: absolute;
  top: 88px;
  left: 50%;
  right: auto;

  display: flex;
  justify-content: center;
  align-items: center;

  writing-mode: vertical-rl;
  white-space: nowrap;

  transform: translateX(-50%);

  font-size: 1.25rem;
  font-weight: 700;
  line-height: 1.2;

  transition: opacity 0.25s ease;
}

.needs-panel.is-active .np-vt {
  opacity: 0;
  pointer-events: none;
}

    .np-body {
      top: auto;
      bottom: 28px;
      left: 24px;
      right: auto;
      width: 380px;
      max-width: calc(100% - 48px);
    }
    .np-title {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .needs-panel,
    .np-img,
    .np-icon,
    .np-vt,
    .np-body {
      transition: none !important;
    }
  }
  .storage-process {
  padding: 48px 24px 60px;
  background: #f8faf8;
  overflow: hidden;
}

.process-container {
  max-width: 1440px;
  width: 100%;
  margin: 0 auto;
}

/* =========================
   HEADING — NAVBAR WIDTH
========================= */

.process-heading {
  width: 100%;
  max-width: none;
  margin: 0 auto 38px;
  text-align: center;
}

.process-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 12px;
  color: #0f623a;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 3px;
}

.process-eyebrow span {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #3fb33d;
}

.process-heading h2 {
  margin: 0;
  color: #123d2b;
  font-family: Georgia, serif;
  font-size: clamp(32px, 3.5vw, 48px);
  font-weight: 500;
  line-height: 1.12;
}

.process-heading > p {
  max-width: 900px;
  margin: 12px auto 0;
  color: #68766f;
  font-size: 15px;
  line-height: 1.7;
}

/* =========================
   PROCESS GRID
========================= */

.process-timeline {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 20px;
  align-items: stretch;
}

/* =========================
   PROCESS CARD
========================= */

.process-step {
  position: relative;
  min-width: 0;
  min-height: 275px;
  padding: 30px 36px 26px;
  background: #fff;
  border: 1px solid #d5e8dc;
  border-radius: 4px;
  box-shadow: 0 6px 22px rgb(18 61 43 / 4%);
  transition: transform 0.3s ease, box-shadow 0.3s ease;
}

/* Green corner accent */

.process-step::before {
  position: absolute;
  content: '';
  left: -1px;
  bottom: -1px;
  width: 68%;
  height: 5px;
  background: #0f623a;
  border-radius: 0 4px 0 4px;
}

.process-step::after {
  position: absolute;
  content: '';
  left: -1px;
  bottom: -1px;
  width: 5px;
  height: 48%;
  background: #0f623a;
  border-radius: 4px 0 0 4px;
}

/* =========================
   ICON — TOP RIGHT CORNER
========================= */

.process-icon {
  position: absolute;
  top: 0;
  right: 0;
  width: 82px;
  height: 76px;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  background: #0f623a;
  border-radius: 0 3px 0 28px;
}

.process-icon svg {
  width: 28px;
  height: 28px;
}

.process-step:nth-child(even) .process-icon {
  background: #167344;
}

.process-step:nth-child(3) .process-icon {
  background: #167344;
  color:  #fff;
}

/* =========================
   STEP LABEL
========================= */

.step-small {
  display: block;
  margin-bottom: 8px;
  color: #16804a;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 2px;
}

/* =========================
   TITLE
========================= */

.process-step h3 {
  max-width: 260px;
  margin: 30px 0 18px;
  color: #123d2b;
  font-family: Georgia, serif;
  font-size: clamp(21px, 1.8vw, 25px);
  font-weight: 500;
  line-height: 1.2;
}

/* =========================
   DESCRIPTION
========================= */

.process-step p {
  max-width: 100%;
  margin: 0;
  color: #68766f;
  font-size: 14px;
  line-height: 1.7;
}

/* =========================
   HOVER
========================= */

.process-step:hover {
  transform: translateY(-4px);
  box-shadow: 0 14px 30px rgb(18 61 43 / 9%);
  border-color: #a9ceb9;
}

/* =========================
   TABLET
========================= */

@media (max-width: 1000px) {
  .storage-process {
    padding: 42px 24px 50px;
  }

  .process-timeline {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .process-step {
    min-height: 240px;
  }

  .process-heading {
    margin-bottom: 30px;
  }

  .process-heading > p {
    max-width: 760px;
  }
}

/* =========================
   MOBILE
========================= */

@media (max-width: 620px) {
  .storage-process {
    padding: 36px 18px 42px;
