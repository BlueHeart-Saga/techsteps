---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import PageHero from '../../components/hero/PageHero.astro';
import { getServices, getSectors, getSiteSettings } from '../../lib/sanity/client';
import { services as fallbackServices } from '../../lib/sanity/data';
import { generateServiceSchema, generateBreadcrumbSchema } from '../../lib/seo/jsonld';
import { getServiceDetailContent } from '../../data/serviceDetails';
import type { Service } from '../../lib/sanity/types';

export async function getStaticPaths() {
  const allServices = await getServices();
  const paths: { params: { slug: string }; props: { service: Service } }[] = [];
  const registeredSlugs = new Set<string>();

  const register = (slug: string | undefined, service: Service) => {
    if (!slug) return;
    const cleanSlug = slug.trim().toLowerCase();
    if (!cleanSlug || registeredSlugs.has(cleanSlug)) return;
    registeredSlugs.add(cleanSlug);
    paths.push({
      params: { slug: cleanSlug },
      props: { service },
    });
  };

  for (const service of allServices) {
    if (!service.slug) continue;

    // Primary route
    register(service.slug, service);

    // Variations: -uk, -services, -services-uk
    const withoutUk = service.slug.endsWith('-uk') ? service.slug.replace(/-uk$/, '') : service.slug;
    const withoutServices = withoutUk.replace(/-services$/, '');

    register(withoutUk, service);
    register(`${withoutUk}-uk`, service);
    register(withoutServices, service);
    register(`${withoutServices}-services`, service);
    register(`${withoutServices}-services-uk`, service);
    register(`${withoutServices}-uk`, service);

    // Match against fallback services to ensure menu slugs (e.g. digital-mailroom, document-management, secure-it-disposal) resolve
    const fallbackMatch = fallbackServices.find(
      (f) =>
        f.id === service.id ||
        f.id === (service as any)._id ||
        (f.title && service.title && f.title.toLowerCase() === service.title.toLowerCase())
    );
    if (fallbackMatch?.slug) {
      register(fallbackMatch.slug, service);
      register(fallbackMatch.slug.replace(/-uk$/, ''), service);
      register(`${fallbackMatch.slug}-uk`, service);
      register(`${fallbackMatch.slug}-services`, service);
    }
  }

  // Ensure any fallback service not present in Sanity is also reachable
  for (const fallback of fallbackServices) {
    if (fallback.slug) {
      register(fallback.slug, fallback);
      register(fallback.slug.replace(/-uk$/, ''), fallback);
      register(`${fallback.slug}-uk`, fallback);
    }
  }

  return paths;
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const [siteSettings] = await Promise.all([
  getSiteSettings(),
]);

// Division accent colour map — consistent with hub pages and site theme
const divisionAccent: Record<string, { accent: string; dark: string; light: string; pill: string }> = {
  'it-lifecycle-services-destruction': {
    accent: '#0F623A',
    dark: '#0A331E',
    light: '#F2F8F5',
    pill: '#0F623A15',
  },
  'information-management': {
    accent: '#0F623A',
    dark: '#0A331E',
    light: '#F2F8F5',
    pill: '#0F623A15',
  },
  'secure-shredding-document-integrity': {
    accent: '#0F623A',
    dark: '#0A331E',
    light: '#F2F8F5',
    pill: '#0F623A15',
  },
  'moving-relocation-services': {
    accent: '#0F623A',
    dark: '#0A331E',
    light: '#F2F8F5',
    pill: '#0F623A15',
  },
};

const clr = divisionAccent[service.divisionSlug] ?? {
  accent: '#0F623A', dark: '#0A331E', light: '#F2F8F5', pill: '#0F623A15',
};

// Division label for breadcrumb/link
const divisionPageSlug = service.divisionSlug;

// Tailored service detail content with direct Sanity CMS precedence
const fallbackDetail = getServiceDetailContent(service.slug, service);
const detail = {
  heroTag: service.heroTag || fallbackDetail.heroTag,
  heroTitle: service.heroTitle || fallbackDetail.heroTitle,
  heroDescription: service.heroDescription || fallbackDetail.heroDescription,
  aboutBadge: service.aboutBadge || fallbackDetail.aboutBadge,
  aboutTitle: service.aboutTitle || fallbackDetail.aboutTitle,
  aboutImage: service.aboutImage || fallbackDetail.aboutImage,
  aboutImageAlt: service.aboutImageAlt || fallbackDetail.aboutImageAlt,
  aboutParagraphs: (service.aboutParagraphs && service.aboutParagraphs.length > 0) ? service.aboutParagraphs : fallbackDetail.aboutParagraphs,
  aboutBullets: (service.aboutBullets && service.aboutBullets.length > 0) ? service.aboutBullets : fallbackDetail.aboutBullets,
  whyTitle: service.whyTitle || fallbackDetail.whyTitle,
  whySubtitle: service.whySubtitle || fallbackDetail.whySubtitle,
  whyPoints: (service.whyPoints && service.whyPoints.length > 0) ? service.whyPoints : fallbackDetail.whyPoints,
  processBadge: service.processBadge || fallbackDetail.processBadge,
  processTitle: service.processTitle || fallbackDetail.processTitle,
  processSubtitle: service.processSubtitle || fallbackDetail.processSubtitle,
  processSteps: (service.processSteps && service.processSteps.length > 0) ? service.processSteps : fallbackDetail.processSteps,
  businessNeedsTitle: service.businessNeedsTitle || fallbackDetail.businessNeedsTitle,
  businessNeedsSubtitle: service.businessNeedsSubtitle || fallbackDetail.businessNeedsSubtitle,
  businessNeedsCards: (service.businessNeedsCards && service.businessNeedsCards.length > 0) ? service.businessNeedsCards : fallbackDetail.businessNeedsCards,
  faqBadge: service.faqBadge || fallbackDetail.faqBadge,
  faqTitle: service.faqTitle || fallbackDetail.faqTitle,
  faqSubtitle: service.faqSubtitle || fallbackDetail.faqSubtitle,
  faqs: (service.faqs && service.faqs.length > 0) ? service.faqs : fallbackDetail.faqs,
};

// JSON-LD
const serviceSchema = generateServiceSchema(service, siteSettings, Astro.site?.origin || 'https://techsteps.co.uk');
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Services', url: '/services' },
  { name: service.divisionTitle, url: `/${divisionPageSlug}` },
  { name: service.title, url: `/services/${service.slug}` },
], Astro.site?.origin || 'https://techsteps.co.uk');
// Identify light-background hero pages (Information Management & IT Lifecycle Services matching Home Hero style)
const cleanSlug = service.slug ? service.slug.toLowerCase().replace(/-(uk|services|services-uk)$/, '') : '';
const isDigitalMailroom = cleanSlug === 'digital-mailroom' || service.slug?.toLowerCase().includes('digital-mailroom') || service.title?.toLowerCase().includes('mailroom');
const isDocumentScanning = cleanSlug === 'document-scanning' || service.slug?.toLowerCase().includes('document-scanning') || service.title?.toLowerCase().includes('scanning');
const isDocumentManagement = cleanSlug === 'document-management' || service.slug?.toLowerCase().includes('document-management') || service.title?.toLowerCase().includes('document management');
const isDocumentStorage = cleanSlug === 'document-storage' || service.slug?.toLowerCase().includes('document-storage') || service.title?.toLowerCase().includes('document storage');
const isTapeStorage = cleanSlug === 'tape-media-storage' || cleanSlug === 'tape-storage' || service.slug?.toLowerCase().includes('tape') || service.title?.toLowerCase().includes('tape');
const isHeritageStorage = cleanSlug === 'heritage-storage' || service.slug?.toLowerCase().includes('heritage') || service.title?.toLowerCase().includes('heritage');
const isVaultStorage = cleanSlug === 'vault-storage' || service.slug?.toLowerCase().includes('vault') || service.title?.toLowerCase().includes('vault');

// IT Lifecycle services
const isSecureItDisposal = cleanSlug === 'secure-it-disposal' || service.slug?.toLowerCase().includes('secure-it-disposal') || service.title?.toLowerCase().includes('secure it disposal');
const isSecureCollection = cleanSlug === 'secure-collection-services' || cleanSlug === 'secure-collection' || service.slug?.toLowerCase().includes('secure-collection') || service.title?.toLowerCase().includes('secure collection');
const isItad = cleanSlug === 'it-asset-disposition-services' || cleanSlug === 'it-asset-disposition' || cleanSlug === 'itad' || service.slug?.toLowerCase().includes('itad') || service.title?.toLowerCase().includes('disposition');
const isItam = cleanSlug === 'it-asset-tracking-services' || cleanSlug === 'it-asset-tracking' || cleanSlug === 'itat' || service.slug?.toLowerCase().includes('itat') || service.title?.toLowerCase().includes('asset tracking');
const isRemarketingRecycling = cleanSlug === 'remarketing-recycling' || cleanSlug === 'remarketing' || service.slug?.toLowerCase().includes('remarketing') || service.title?.toLowerCase().includes('remarketing');
const isHardDriveDestruction = cleanSlug === 'ultra-secure-hard-drive-destruction' || cleanSlug === 'hard-drive-destruction' || service.slug?.toLowerCase().includes('hard-drive-destruction') || service.title?.toLowerCase().includes('hard drive destruction');

const isLightHero = isDigitalMailroom || isDocumentScanning || isDocumentManagement || isDocumentStorage || isTapeStorage || isHeritageStorage || isVaultStorage ||
  isSecureItDisposal || isSecureCollection || isItad || isItam || isRemarketingRecycling || isHardDriveDestruction ||
  (typeof service.heroImage === 'string' && (
    service.heroImage.includes('digital mail room') ||
    service.heroImage.includes('document scaning') ||
    service.heroImage.includes('document management') ||
    service.heroImage.includes('secure document storage') ||
    service.heroImage.includes('Tape and Media Storage') ||
    service.heroImage.includes('heritage storage') ||
    service.heroImage.includes('Valut storage') ||
    service.heroImage.includes('IT Asset Disposition') ||
    service.heroImage.includes('IT Asset Tracking') ||
    service.heroImage.includes('Remarketing & Recycling') ||
    service.heroImage.includes('Secure Collection') ||
    service.heroImage.includes('Secure IT Disposal') ||
    service.heroImage.includes('Hard Drive Destruction')
  ));

const heroBgImage = isDigitalMailroom
  ? '/images/hero/digital mail room services.webp'
  : isDocumentScanning
  ? '/images/hero/document scaning services.webp'
  : isDocumentManagement
  ? '/images/hero/document management.webp'
  : isDocumentStorage
  ? '/images/hero/secure document storage.webp'
  : isTapeStorage
  ? '/images/hero/Tape and Media Storage.webp'
  : isHeritageStorage
  ? '/images/hero/heritage storage.webp'
  : isVaultStorage
  ? '/images/hero/Valut storage.webp'
  : isSecureItDisposal
  ? '/images/hero/Secure IT Disposal.webp'
  : isSecureCollection
  ? '/images/hero/Secure Collection Services.webp'
  : isItad
  ? '/images/hero/IT Asset Disposition Services (ITAD).webp'
  : isItam
  ? '/images/hero/IT Asset Tracking Services.webp'
  : isRemarketingRecycling
  ? '/images/hero/Remarketing & Recycling.webp'
  : isHardDriveDestruction
  ? '/images/hero/Ultra Secure Hard Drive Destruction.webp'
  : (service.heroImage || '/images/hero/secure document storage.webp');
---

<BaseLayout
  title={service.metaTitle || `${service.title} | Techsteps UK`}
  description={service.metaDescription || service.summary}
  jsonLd={[serviceSchema, breadcrumbSchema]}
  hasHeroHeader={true}
>

  <!-- ===== 1. SERVICE HERO ===== -->
  <PageHero
    bgImage={heroBgImage}
    breadcrumbs={[]}
    layout="custom"
    showDivider={true}
    dividerColor="#ffffff"
    minHeight="min-h-[540px] sm:min-h-[580px] lg:min-h-[640px]"
    noOverlay={isLightHero}
    theme={isLightHero ? "light" : "dark"}
  >
    {isLightHero ? (
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-10 items-center">
        <!-- =========================
             HERO CONTENT (Left) - Exact Home Hero Sizing
        ========================= -->
        <div class="lg:col-span-6 xl:col-span-6 max-w-2xl lg:max-w-none pt-2 sm:pt-4 z-10">

          <!-- Breadcrumb Navigation -->
          <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-semibold text-slate-600 mb-3 sm:mb-4">
            <a href={`/services/${divisionPageSlug}`} class="text-slate-700 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
              {service.divisionTitle} Services UK
            </a>
            <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
            <span class="text-slate-900 font-bold">{service.title}</span>
          </nav>

          <!-- Heading: Serif font matching Home page hero -->
          <h1
            class="font-display font-serif
                   text-3xl sm:text-4xl md:text-5xl lg:text-[50px] xl:text-[56px]
                   font-extrabold
                   text-slate-900
                   tracking-tight
                   leading-[1.1] sm:leading-[1.08]
                   max-w-xl"
            style="font-family: 'Lora', Georgia, serif;"
          >
            {detail.heroTitle}
          </h1>

          <!-- Description: Exact Home Hero size & font -->
          <p
            class="mt-4 sm:mt-5
                   text-base sm:text-lg lg:text-[17px]
                   text-slate-600
                   max-w-lg
                   leading-relaxed
                   font-sans font-normal"
          >
            {detail.heroDescription}
          </p>

          <!-- CTA Buttons: Exact Home Hero shape, buttons and size -->
          <div
            class="mt-6 sm:mt-8
                   flex flex-wrap
                   items-center
                   gap-3.5 sm:gap-4"
          >
            <!-- Request a Collection Button -->
            <a
              href={`/request-a-collection?service=${encodeURIComponent(service.slug)}`}
              class="inline-flex items-center justify-center
                     gap-2.5
                     px-6 sm:px-7
                     py-3 sm:py-3.5
                     rounded-none
                     bg-[#0F623A] hover:bg-[#0c4e2e]
                     text-white
                     text-sm sm:text-base
                     font-bold
                     shadow-md hover:shadow-lg
                     transition-all duration-200
                     hover:scale-[1.02]
                     focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
            >
              <span>Request a Collection</span>
              <svg
                class="w-4 h-4 text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M17 8l4 4m0 0l-4 4m4-4H3"
                />
              </svg>
            </a>

            <!-- Contact Us / Talk to Our Team Button -->
            {/*<a
              href={`/contact?service=${encodeURIComponent(service.slug)}`}
              class="inline-flex items-center justify-center
                     px-6 sm:px-7
                     py-3 sm:py-3.5
                     rounded-none
                     bg-white hover:bg-slate-50
                     border-2 border-[#0F623A] hover:border-[#0c4e2e]
                     text-[#0F623A] hover:text-[#0c4e2e]
                     text-sm sm:text-base
                     font-bold
                     transition-all duration-200
                     hover:scale-[1.02]
                     shadow-xs
                     focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
            >
              Talk to Our Team
            </a>*/}
          </div>

        </div>

        <!-- =========================
             HERO SPACER (Right on Desktop)
        ========================= -->
        <div class="hidden lg:flex lg:col-span-6 xl:col-span-6 items-center justify-end min-h-[420px] lg:min-h-[480px] xl:min-h-[520px] pointer-events-none" aria-hidden="true">
        </div>
      </div>
    ) : (
      <div class="max-w-4xl py-6 sm:py-10 text-left space-y-5 sm:space-y-6">
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-mono font-medium text-slate-300">
          <a href={`/services/${divisionPageSlug}`} class="hover:text-white transition-colors underline-offset-4 hover:underline">
            {service.divisionTitle} Services UK
          </a>
          <span class="text-emerald-400 font-bold" aria-hidden="true">›</span>
          <span class="text-white font-semibold">{service.title}</span>
        </nav>

        <h1
          class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black text-white tracking-tight leading-[1.08] drop-shadow-2xl max-w-2xl"
          style="min-height: calc(2 * 1.08em);"
        >
          {detail.heroTitle}
        </h1>

        <p class="text-base sm:text-lg lg:text-xl text-slate-200/90 leading-relaxed max-w-2xl font-normal drop-shadow-sm min-h-[2lh] min-h-[3.25em]">
          {detail.heroDescription}
        </p>

        <div class="flex flex-wrap items-center gap-3.5 pt-2">
          <a
            href={`/request-a-collection?service=${encodeURIComponent(service.slug)}`}
            class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white font-bold text-sm sm:text-base shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5 border border-emerald-400/30"
          >
            Request a Collection
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
          {/*<a
            href={`/contact?service=${encodeURIComponent(service.slug)}`}
            class="inline-flex items-center justify-center px-7 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-sm sm:text-base border border-white/25 hover:border-white transition-all duration-200 backdrop-blur-xs transform hover:-translate-y-0.5"
          >
            Talk to Our Team
          </a>*/}
        </div>
      </div>
    )}
  </PageHero>

  <!-- ===== 2. ABOUT THE SERVICE ===== -->
  <section class="bg-white py-8 lg:py-12 border-b border-slate-200/80 relative">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
        {/* Left Side: Photo */}
        <div class="lg:col-span-6 relative lg:sticky lg:top-28 self-start">
          <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-xl border-2 border-[#0F623A]/20 bg-white p-2 sm:p-3 transition-all duration-300 hover:shadow-2xl hover:border-[#0F623A]/40 group">
            <div class="rounded-xl sm:rounded-2xl overflow-hidden bg-slate-900 relative h-[620px]">
              <img
                src={detail.aboutImage}
                alt={detail.aboutImageAlt}
                class="w-full h-full object-cover transform group-hover:scale-[1.02] transition-transform duration-500"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        {/* Right Side: Service Content */}
        <div class="lg:col-span-6 space-y-8">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
            {detail.aboutBadge}
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-display leading-[1.12] min-h-[2lh] min-h-[2.24em]">
            {detail.aboutTitle}
          </h2>

          <div class="space-y-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
            {detail.aboutParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {/* Bullet Checklist with Circular Green Checkmarks */}
          <div class="pt-2 space-y-3.5">
            {detail.aboutBullets.map((bullet) => (
              <div class="flex items-center gap-3.5">
                <svg class="w-6 h-6 text-[#0F623A] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <circle cx="12" cy="12" r="9" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 12.5l2.5 2.5 5-5" />
                </svg>
                <span class="text-base sm:text-lg font-semibold text-slate-900">
                  {bullet}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 3. WHY BUSINESSES CHOOSE THIS SERVICE ===== -->
  <section class="py-8 lg:py-12 bg-[#0A331E] relative overflow-hidden border-b border-emerald-950">
    <Container>
      <div class="max-w-5xl mx-auto">
        {/* Section Heading */}
        <div class="mb-10 lg:mb-12 border-b border-emerald-500/30 pb-8">
          <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-400/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold uppercase tracking-widest font-mono mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-300"></span>
            Key Advantages
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-display leading-[1.12] max-w-3xl">
            {detail.whyTitle}
          </h2>
          <p class="mt-4 text-base sm:text-lg text-emerald-100/85 leading-relaxed font-sans max-w-3xl font-normal">
            {detail.whySubtitle}
          </p>
        </div>

        {/* 4 Rows with Numbers, Titles, and Descriptions */}
        <div class="divide-y divide-emerald-500/20">
          {detail.whyPoints.map((pt) => (
            <div class="py-7 sm:py-8 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-center group">
              <div class="md:col-span-5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-emerald-300 shrink-0 group-hover:bg-[#0F623A] group-hover:text-white transition-all duration-300 font-mono font-bold text-sm">
                  {pt.number}
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-white font-display">
                  {pt.title}
                </h3>
              </div>
              <div class="md:col-span-7">
                <p class="text-sm sm:text-base text-emerald-100/85 leading-relaxed font-sans font-normal">
                  {pt.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 4. OUR PROCESS (HOW IT WORKS) ===== -->
  <section class="py-8 lg:py-12 bg-white relative overflow-hidden border-b border-slate-200/80">
    <Container>
      <div class="max-w-3xl mb-12 lg:mb-16">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          {detail.processBadge}
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-display">
          {detail.processTitle}
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans">
          {detail.processSubtitle}
        </p>
      </div>

      {/* 4 Stepped Process Cards (Uniform Light Mint Card Background with Large Green Icons) */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 items-end">
        {/* Card 01: Collect / Intake */}
        <div class="rounded-2xl p-6 lg:p-7 bg-[#E8F8F0] text-slate-900 shadow-md hover:shadow-xl border border-[#A3E5C3] min-h-[220px] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 group">
          <div>
            <div class="mb-5 text-[#0F623A] transition-transform duration-300 group-hover:scale-110">
              <svg class="w-10 h-10 sm:w-11 sm:h-11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 font-display min-h-[2lh] min-h-[3.25rem] flex items-end">{detail.processSteps[0]?.title}</h3>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed font-sans min-h-[2.5lh] min-h-[3.5rem]">
            {detail.processSteps[0]?.description}
          </p>
        </div>

        {/* Card 02: Catalogue / Process */}
        <div class="rounded-2xl p-6 lg:p-7 bg-[#E8F8F0] text-slate-900 shadow-md hover:shadow-xl border border-[#A3E5C3] min-h-[260px] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 group">
          <div>
            <div class="mb-5 text-[#0F623A] transition-transform duration-300 group-hover:scale-110">
              <svg class="w-10 h-10 sm:w-11 sm:h-11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 font-display min-h-[2lh] min-h-[3.25rem] flex items-end">{detail.processSteps[1]?.title}</h3>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed font-sans min-h-[2.5lh] min-h-[3.5rem]">
            {detail.processSteps[1]?.description}
          </p>
        </div>

        {/* Card 03: Secure Storage / Processing */}
        <div class="rounded-2xl p-6 lg:p-7 bg-[#E8F8F0] text-slate-900 shadow-md hover:shadow-xl border border-[#A3E5C3] min-h-[300px] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 group">
          <div>
            <div class="mb-5 text-[#0F623A] transition-transform duration-300 group-hover:scale-110">
              <svg class="w-10 h-10 sm:w-11 sm:h-11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 font-display min-h-[2lh] min-h-[3.25rem] flex items-end">{detail.processSteps[2]?.title}</h3>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed font-sans min-h-[2.5lh] min-h-[3.5rem]">
            {detail.processSteps[2]?.description}
          </p>
        </div>

        {/* Card 04: Completion / Certificate */}
        <div class="rounded-2xl p-6 lg:p-7 bg-[#E8F8F0] text-slate-900 shadow-md hover:shadow-xl border border-[#A3E5C3] min-h-[340px] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 group">
          <div>
            <div class="mb-5 text-[#0F623A] transition-transform duration-300 group-hover:scale-110">
              <svg class="w-10 h-10 sm:w-11 sm:h-11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 font-display min-h-[2lh] min-h-[3.25rem] flex items-end">{detail.processSteps[3]?.title}</h3>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed font-sans min-h-[2.5lh] min-h-[3.5rem]">
            {detail.processSteps[3]?.description}
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 5. DIFFERENT BUSINESS NEEDS (WHITE BOX WITH GREEN LID) ===== -->
  <section class="py-8 lg:py-12 bg-white relative overflow-hidden border-b border-slate-200/80">
    <Container>
      {/* Section Header: Title Left, Description Right */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-12 lg:mb-16">
        <div class="lg:col-span-7">
          <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
            Sector Applications
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-display leading-[1.12]">
            {detail.businessNeedsTitle}
          </h2>
        </div>
        <div class="lg:col-span-5">
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
            {detail.businessNeedsSubtitle}
          </p>
        </div>
      </div>

      {/* 6 Archive Box Cards Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
        {detail.businessNeedsCards.map((card) => (
          <div class="rounded-2xl overflow-hidden bg-white border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-[#0F623A]/40 transition-all duration-300 hover:-translate-y-1.5 group flex flex-col">
            {/* Top Box Lid Tab (Green) */}
            <div class="h-7 sm:h-8 bg-[#0F623A] border-b border-emerald-800/40 flex items-center justify-center px-4 group-hover:bg-[#0c4e2e] transition-colors">
              <div class="w-12 sm:w-14 h-2 rounded-full bg-[#0A331E]/80 border border-emerald-400/30"></div>
            </div>
            {/* Card Content (White Box Body) */}
            <div class="p-6 sm:p-7 space-y-4 flex-1 flex flex-col justify-between bg-white">
              <div class="space-y-4">
                <div class="w-11 h-11 rounded-xl bg-[#0F623A]/10 border border-[#0F623A]/20 flex items-center justify-center text-[#0F623A] group-hover:bg-[#0F623A] group-hover:text-white transition-all duration-300">
                  {card.icon === 'legal' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                    </svg>
                  )}
                  {card.icon === 'health' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="4" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v8m-4-4h8" />
                    </svg>
                  )}
                  {card.icon === 'finance' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="9" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 9.5a2.5 2.5 0 00-4 2 2.5 2.5 0 01-1.5 2.2V15h5M9 13.5h4" />
                    </svg>
                  )}
                  {card.icon === 'corporate' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  )}
                  {card.icon === 'public' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M3 10h18M5 10v8m4-8v8m6-8v8m4-8v8M12 3l9 7H3l9-7z" />
                    </svg>
                  )}
                  {(card.icon === 'business' || !['legal', 'health', 'finance', 'corporate', 'public'].includes(card.icon)) && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                  )}
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-slate-900 font-display tracking-tight group-hover:text-[#0F623A] transition-colors min-h-[2lh] min-h-[3.5rem] flex items-start">
                  {card.title}
                </h3>
              </div>
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans font-normal min-h-[3lh] min-h-[4.5rem]">
                {card.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== 6. FREQUENTLY ASKED QUESTIONS ===== -->
  <section class="py-8 lg:py-12 bg-[#FAF8F5] relative overflow-hidden border-b border-slate-200/80">
    <Container>
      <div class="max-w-4xl mx-auto mb-10 lg:mb-14 text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          {detail.faqBadge}
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-display leading-[1.12] min-h-[2lh] min-h-[2.24em] flex items-center justify-center">
          {detail.faqTitle}
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans max-w-2xl mx-auto">
          {detail.faqSubtitle}
        </p>
      </div>

      {/* Vertical Stack of FAQ Cards (Matching Reference Layout, Permanently Visible) */}
      <div class="max-w-4xl mx-auto space-y-4 sm:space-y-5">
        {detail.faqs.map((faq) => (
          <div class="rounded-2xl sm:rounded-3xl bg-white border border-slate-200/90 shadow-xs overflow-hidden">
            <div class="p-6 sm:p-7 border-b border-slate-100">
              <h3 class="text-base sm:text-lg lg:text-xl font-bold text-slate-900 leading-snug">
                {faq.question}
              </h3>
            </div>
            <div class="px-6 py-5 sm:px-7 sm:py-6">
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
                {faq.answer}
              </p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== 7. FINAL CTA (Clean Open Layout - No Background Box) ===== -->
  <section class="relative z-10 py-8 lg:py-12 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full blur-3xl pointer-events-none opacity-15" style={`background: ${clr.accent};`}></div>
    <Container className="relative z-10">
      <div class="w-full max-w-[1240px] mx-auto text-center">
        <span class="inline-block text-xs sm:text-sm font-bold tracking-[0.2em] uppercase mb-4" style={`color: ${clr.accent};`}>Ready to Start?</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 mb-5 leading-tight tracking-tight">
          Need {service.title}<br />for Your Organisation?
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-10 max-w-xl mx-auto font-medium">
          Speak with our team to arrange a collection, request an on-site audit or obtain a formal proposal.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`/request-a-collection?service=${encodeURIComponent(service.slug)}`}
            class="px-8 py-4 rounded-xl font-bold text-sm uppercase tracking-wider text-white shadow-lg hover:shadow-xl transition-all duration-200 hover:brightness-110 transform hover:-translate-y-0.5"
            style={`background: ${clr.accent};`}
          >
            Request a Collection →
          </a>
          <a
            href="/contact"
            class="px-8 py-4 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-900 font-bold text-sm uppercase tracking-wider transition-all duration-200 shadow-xs hover:shadow-md transform hover:-translate-y-0.5"
          >
            Contact Techsteps
          </a>
        </div>
      </div>
    </Container>
  </section>

</BaseLayout>
