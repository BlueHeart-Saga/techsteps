  // ===== FRONTMATTER =====

// PROCESS section (solid green bento cards, no images)
const processFallback = {
  badge: 'OUR PROCESS',
  title: 'Our Secure Document Storage Process',
  subtitle:
    'Four simple steps to keep your documents secure, organised and accessible whenever you need them.',
