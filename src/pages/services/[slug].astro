const isRemarketingRecycling = cleanSlug === 'remarketing-recycling' || cleanSlug === 'remarketing' || service.slug?.toLowerCase().includes('remarketing') || service.title?.toLowerCase().includes('remarketing');
const isHardDriveDestruction = cleanSlug === 'ultra-secure-hard-drive-destruction' || cleanSlug === 'hard-drive-destruction' || service.slug?.toLowerCase().includes('hard-drive-destruction') || service.title?.toLowerCase().includes('hard drive destruction');

// Secure Shredding & Document Integrity / Recycling services
