    service.heroImage.includes('home shredding') ||
    service.heroImage.includes('offsite shredding') ||
    service.heroImage.includes('onsite shredding') ||
    service.heroImage.includes('product shredding') ||
    service.heroImage.includes('simpler recycling') ||
    service.heroImage.includes('Business Relocations') ||
