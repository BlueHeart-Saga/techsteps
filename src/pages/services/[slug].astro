        </div>
        <div class="lg:col-span-5">
          <p class="text-lg sm:text-xl text-black leading-relaxed font-sans font-normal">
            {detail.businessNeedsSubtitle || "Tailored operational and compliance protocols designed for regulated UK sectors."}
          </p>
        </div>
      </div>

      <div class="needs-row">
        {finalSectorCards.map((card, i) => (
          <button
            type="button"
            data-needs-panel
            aria-expanded={i === 0 ? 'true' : 'false'}
            class:list={['needs-panel', 'focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[#0F623A]', { 'is-active': i === 0 }]}
          >
            <img
              src={card.image ?? sectorImages[card.icon] ?? sectorImages.business}
              alt=""
              loading="lazy"
              class="np-img"
            />
            <span class="np-dim"></span>
            <span class="np-fade"></span>

            <span class="np-icon">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d={needsIconPaths[card.icon] ?? needsIconPaths.business} />
              </svg>
            </span>

            <span class="np-vt font-display">{card.title}</span>

            <span class="np-body">
              <span class="np-title font-display">{card.title}</span>
              <span class="np-desc font-sans">{card.description}</span>
            </span>
          </button>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===================================================== -->
  <!-- 7. CUSTOMER SUCCESS & FAQS                            -->
  <!-- ===================================================== -->
  <section class="py-16 lg:py-20 bg-white border-b border-slate-200/80">
    <Container>
      <!-- Optional Single Genuine Case Study -->
      {matchingCaseStudy && (
        <div class="mb-16">
          <div class="rounded-2xl border border-slate-200 bg-[#F8FAF9] p-8 sm:p-10 lg:p-12">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
              <div class="lg:col-span-7 space-y-5">
                <span class="inline-block text-xs font-mono font-bold uppercase tracking-wider text-[#0F623A] px-3 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/20">
                  {matchingCaseStudy.clientIndustry || "Customer Success"}
                </span>
                <h3 class="text-2xl sm:text-3xl font-semibold text-slate-900 font-display leading-tight">
                  {matchingCaseStudy.title}
                </h3>
                <div class="space-y-3 text-black font-sans leading-relaxed text-base sm:text-lg text-justify">
                  <p><strong class="text-slate-900">Challenge:</strong> {matchingCaseStudy.challenge}</p>
                  <p><strong class="text-slate-900">Solution:</strong> {matchingCaseStudy.solution}</p>
                </div>
                <div class="pt-2">
                  <a
                    href={`/case-studies/${matchingCaseStudy.slug}`}
                    class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-[#0F623A] hover:text-[#0c4e2e] transition-colors"
                  >
                    Read Full Case Study →
                  </a>
                </div>
              </div>

              <div class="lg:col-span-5 bg-white rounded-xl border border-slate-200/90 p-6 sm:p-7 space-y-3.5 shadow-xs">
                <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-[#0F623A]">
                  Verified Project Results
                </h4>
                <ul class="space-y-3">
                  {matchingCaseStudy.results?.map((result: string) => (
                    <li class="flex items-start gap-3 text-sm sm:text-base text-slate-800 font-sans text-justify">
                      <svg class="w-5 h-5 text-[#0F623A] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      </svg>
                      <span>{result}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        </div>
      )}

      <!-- Frequently Asked Questions (4 to 6 concise questions) -->
      {displayedFaqs.length > 0 && (
        <div class="max-w-4xl mx-auto">
          <div class="mb-10 text-center">
            {/*<span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-3">
              COMMON QUESTIONS
            </span>*/}
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
              {detail.faqTitle || "Frequently Asked Questions"}
            </h2>
            <p class="mt-3 text-base sm:text-lg lg:text-[19px] text-black leading-relaxed font-normal">
              {detail.faqSubtitle || "Clear answers about operational standards, accreditations, and UK delivery."}
            </p>
          </div>

          <!-- Editorial FAQ List -->
          <div class="divide-y divide-slate-200/90 border-t border-b border-slate-200/90">
            {displayedFaqs.map((faq: { question: string; answer: string }, idx: number) => {
              const num = String(idx + 1).padStart(2, '0');
              return (
                <div class="py-7 sm:py-8 group transition-colors duration-200 hover:bg-[#F8FAF9] px-4 sm:px-6 -mx-4 sm:-mx-6 rounded-lg">
                  <div class="flex items-baseline gap-3.5 mb-2">
                    <span class="font-mono font-bold text-sm sm:text-base text-[#0F623A] shrink-0">
                      {num}
                    </span>
                    <h3 class="text-lg sm:text-xl font-semibold text-slate-900 font-display group-hover:text-[#0F623A] transition-colors leading-snug">
                      {faq.question}
                    </h3>
                  </div>
                  <div class="pl-7 sm:pl-8">
                    <p class="text-base sm:text-lg text-black leading-relaxed font-sans">
                      {faq.answer}
                    </p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>
      )}

      <!-- Compact Row of Related Services -->
      {relatedServices.length > 0 && (
        <div class="mt-14 pt-10 border-t border-slate-200 max-w-4xl mx-auto">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
            <span class="text-xs font-mono font-bold uppercase tracking-widest text-slate-500">
              Related Services:
            </span>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
            {relatedServices.map((rel) => (
              <a
                href={`/services/${rel.slug}`}
                class="p-4 rounded-xl border border-slate-200/80 bg-[#F8FAF9] hover:bg-white hover:border-[#0F623A]/40 hover:shadow-sm transition-all text-left group"
              >
                <h4 class="text-sm font-bold font-display text-slate-900 group-hover:text-[#0F623A] transition-colors line-clamp-1">
                  {rel.title}
                </h4>
                <p class="text-xs text-slate-600 line-clamp-1 mt-1">
                  {rel.summary || `Specialist ${rel.title.toLowerCase()} service.`}
                </p>
              </a>
            ))}
          </div>
        </div>
      )}
    </Container>
    <br />
    <br />
  </section>

  <!-- ===================================================== -->
  <!-- 8. FINAL CTA: Preserved Completely Unchanged           -->
  <!-- ===================================================== -->
  <CTA
    title={`Need ${service.title} for Your Organisation?`}
    description={`Speak with our specialist team to arrange a secure collection, request an on-site audit, or receive a formal proposal for ${service.title.toLowerCase()}.`}
    primaryText="Request a Collection"
    primaryHref={`/request-a-collection?service=${encodeURIComponent(service.slug)}`}
    secondaryText="Contact Our Team"
    secondaryHref="/contact"
  />

</BaseLayout>

