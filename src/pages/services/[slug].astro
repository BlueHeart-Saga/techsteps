  'laboratory-relocations': '/images/services/laboratory-relocations-storage.webp',
  'heritage-relocations-storage': '/images/services/heritage-relocations-storage.webp',
  'heritage-relocations': '/images/services/heritage-relocations-storage.webp',
  'europe-international-domestic-moves': '/images/services/europe-international-domestic-moves.webp',
  'international-moves': '/images/services/europe-international-domestic-moves.webp',
  'it-relocations-specialist': '/images/services/it-relocations-specialist.webp',
  'it-relocations': '/images/services/it-relocations-specialist.webp',
  'project-management': '/images/services/project-management.webp',
};

// Normalize service slug before matching
const normalizedServiceSlug = (service.slug || '')
  .toLowerCase()
  .replace(/-(uk|services|services-uk)$/, '');

// Resolve verified local webp about image with full alias fallback support
const serviceAboutImage =
  serviceAboutImages[cleanSlug] ||
  serviceAboutImages[normalizedServiceSlug] ||
  serviceAboutImages[service.slug?.toLowerCase() || ''] ||
  (isSecureItDisposal ? '/images/services/secure-it-disposal.webp' : '') ||
  (isSecureCollection ? '/images/services/secure-collection-services(!).webp' : '') ||
  (isItad ? '/images/services/it-asset-disposition-services(1).webp' : '') ||
  (isItam ? '/images/services/it-asset-tracking-services(1).webp' : '') ||
  (isRemarketingRecycling ? '/images/services/remarketing-recycling.webp' : '') ||
  (isHardDriveDestruction ? '/images/services/ultra-secure-hard-drive-destruction.webp' : '') ||
  (isHomeShredding ? '/images/services/home-shredding.webp' : '') ||
  (isOnsiteShredding ? '/images/services/on-site-shredding.webp' : '') ||
  (isOffsiteShredding ? '/images/services/off-site-shredding.webp' : '') ||
  (isProductShredding ? '/images/services/product-shredding.webp' : '') ||
  (isSimplerRecycling ? '/images/services/simpler-recycling.webp' : '') ||
  (isDisposalServices ? '/images/services/disposal-services.webp' : '') ||
  (isCardboardRecycling ? '/images/services/cardboard-recycling.webp' : '') ||
  (isDryMixedRecycling ? '/images/services/dry-mixed-recycling.webp' : '') ||
  service.aboutImage ||
  detail.aboutImage;

---

<BaseLayout
  title={service.metaTitle || `${service.title} | Techsteps UK`}
  description={service.metaDescription || service.summary}
  canonicalUrl={`https://techsteps.co.uk/services/${service.slug}`}
  jsonLd={[serviceSchema, breadcrumbSchema]}
  hasHeroHeader={true}
>

  <!-- ===================================================== -->
  <!-- 1. HERO SECTION: Improved visual balance & spacing    -->
  <!-- ===================================================== -->
  <PageHero
    bgImage={heroBgImage}
    breadcrumbs={[]}
    layout="custom"
    showDivider={true}
    dividerColor="#ffffff"
    minHeight="min-h-[520px] sm:min-h-[560px] lg:min-h-[620px]"
    noOverlay={true}
    theme="light"
    contained={true}
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">
      <!-- HERO CONTENT (Left) -->
      <div class="lg:col-span-7 xl:col-span-7 max-w-2xl lg:max-w-none pt-2 sm:pt-4 z-10">

        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-semibold text-slate-600 mb-3 sm:mb-4">
          <a href={`/services/${divisionPageSlug}`} class="text-slate-700 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
            {service.divisionTitle} Services UK
          </a>
          <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
          <span class="text-slate-900 font-bold">{service.title}</span>
        </nav>

        <!-- Heading -->
        <h1
          class="font-display
                 text-3xl sm:text-4xl md:text-5xl lg:text-[50px] xl:text-[54px]
                 font-semibold
                 text-slate-900
                 tracking-normal
                 leading-[1.12] sm:leading-[1.1]
                 max-w-xl"
        >
          {detail.heroTitle}
        </h1>

        <!-- Short Description -->
        <p
          class="mt-4 sm:mt-5
                 text-base sm:text-lg lg:text-[19px]
                 text-black
                 max-w-xl
                 leading-relaxed
                 font-sans font-normal"
        >
          {detail.heroDescription}
        </p>

        <!-- Primary CTA -->
        <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-4">
          <a
            href={`/request-a-collection?service=${encodeURIComponent(service.slug)}`}
            class="inline-flex items-center justify-center
                   gap-2.5
                   px-7 sm:px-8
                   py-3.5 sm:py-4
                   bg-[#0F623A] hover:bg-[#0c4e2e]
                   text-white
                   text-base sm:text-lg
                   font-bold
                   shadow-md hover:shadow-lg
                   transition-all duration-200
                   hover:scale-[1.01]
                   focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
          >
            <span>Request a Collection</span>
            <svg
              class="w-5 h-5 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>

          <a
            href="/contact"
            class="inline-flex items-center justify-center
                   px-6 py-3.5
                   bg-white hover:bg-slate-50
                   border border-slate-300
                   text-slate-800 hover:text-black
                   text-base
                   font-semibold
                   transition-colors duration-200"
          >
            Contact Specialist
          </a>
        </div>
      </div>

      <!-- HERO SPACER (Right on Desktop) -->
      <div class="hidden lg:flex lg:col-span-5 xl:col-span-5 items-center justify-end min-h-[420px] pointer-events-none" aria-hidden="true">
      </div>
    </div>
  </PageHero>

  <!-- ===================================================== -->
  <!-- 2. INTRODUCTION SECTION: Split Image & Text Layout    -->
  <!-- ===================================================== -->
  <section class="bg-white py-16 lg:py-20 border-b border-slate-200/80">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <!-- Left Side: Service Photo -->
<!-- Left Side: Service Image -->
<div class="lg:col-span-5">
  <img
    src={serviceAboutImage}
    alt={detail.aboutImageAlt}
    class="w-full h-[380px] sm:h-[440px] lg:h-[480px] object-cover object-center"
    loading="eager"
  />
</div>

        <!-- Right Side: Editorial Content with 3 Key Benefits -->
        <div class="lg:col-span-7 space-y-6">
          {/*<div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono">
            SERVICE OVERVIEW
          </div>*/}

          <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-semibold text-slate-900 tracking-tight font-display leading-[1.14]">
            {detail.aboutTitle}
          </h2>

          <p class="text-base sm:text-lg lg:text-[19px] text-black leading-relaxed font-normal text-justify">
            {detail.aboutParagraphs[0] || "We deliver tailored, security-cleared operational solutions ensuring compliance, continuous data protection, and complete chain of custody across the UK."}
          </p>

          <!-- 3 Key Benefits with Circular Green Checkmarks -->
          <div class="pt-3 space-y-3.5 border-t border-slate-100  text-justify">
            {detail.aboutBullets.slice(0, 3).map((bullet) => (
              <div class="flex items-start gap-3.5">
                <div class="w-6 h-6 rounded-full bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center shrink-0 mt-0.5">
                  <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.8">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <span class="text-base sm:text-lg font-medium text-slate-900 leading-snug">
                  {bullet}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===================================================== -->
  <!-- 3. BENEFITS SECTION: Consolidated 3 Visual Cards      -->
  <!-- ===================================================== -->
  <section class="py-16 lg:py-20 bg-[#F8FAF9] border-b border-slate-200/80">
    <Container>
      <div class="max-w-3xl mb-10 sm:mb-12">
        {/*<span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-3">
          KEY ADVANTAGES
        </span>*/}
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
          What the Service Delivers for Your Business
        </h2>
        <p class="mt-3 text-base sm:text-lg lg:text-[19px] text-black leading-relaxed font-normal">
          Consolidated risk reduction, streamlined operations, and certified documentation for total peace of mind.
        </p>
      </div>

      <!-- 3-Column Visual Benefit Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {consolidatedBenefits.map((benefit, idx) => (
          <div class="bg-white rounded-2xl border border-slate-200/90 p-7 sm:p-8 shadow-xs hover:border-[#0F623A]/40 hover:shadow-md transition-all duration-300 flex flex-col justify-between">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#0F623A] px-3 py-1 rounded-full bg-[#0F623A]/10">
                  {benefit.tag}
                </span>
                <span class="text-2xl font-mono font-bold text-slate-300">
                  0{idx + 1}
                </span>
              </div>

              <h3 class="text-xl sm:text-2xl font-bold font-display text-slate-900 leading-snug">
                {benefit.title}
              </h3>

              <p class="text-sm sm:text-base text-slate-700 leading-relaxed font-sans">
                {benefit.description}
              </p>
            </div>

            <!-- Proof / Deliverable Note at bottom of card -->
            <div class="mt-6 pt-4 border-t border-slate-100 flex items-start gap-2.5">
              <svg class="w-4 h-4 text-[#0F623A] shrink-0 mt-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
              </svg>
              <span class="text-xs font-medium text-slate-600 leading-snug">
                {benefit.deliverable}
              </span>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===================================================== -->
  <!-- 4. PROCESS SECTION: 4-Step Process with Clean Spacing -->
  <!-- ===================================================== -->
  <section class="py-16 lg:py-20 bg-white border-b border-slate-200/80">
    <Container>
      <div class="max-w-3xl mb-10 sm:mb-12">
        {/*<span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-3">
          HOW IT WORKS
        </span>*/}
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
          {processTitle}
        </h2>
        <p class="mt-3 text-base sm:text-lg lg:text-[19px] text-black leading-relaxed font-normal">
          {processSubtitle}
        </p>
      </div>

      <!-- 4 Connected Process Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {processSteps.map((step, i) => {
          const stepNum = String(i + 1).padStart(2, '0');
          return (
            <article class="rounded-2xl border border-slate-200/90 bg-[#F8FAF9] p-6 sm:p-7 hover:border-[#0F623A]/40 hover:bg-white hover:shadow-md transition-all duration-300 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-5">
                  <div class="w-10 h-10 rounded-xl bg-[#0F623A] text-white flex items-center justify-center font-mono font-bold text-sm shadow-xs">
                    {stepNum}
                  </div>
                  <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#0F623A]">
                    PHASE {stepNum}
                  </span>
                </div>

                <h3 class="text-xl font-semibold text-slate-900 font-display mb-2.5 leading-snug">
                  {step.title}
                </h3>

                <p class="text-sm sm:text-base text-slate-700 font-sans leading-relaxed">
                  {step.description}
                </p>
              </div>

              <div class="mt-6 pt-3.5 border-t border-slate-200/70 flex items-center justify-between">
                <span class="text-[11px] font-mono uppercase tracking-wider text-slate-400">Step {i + 1} of 4</span>
                <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
              </div>
            </article>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- ===================================================== -->
  <!-- 5. TRUST & SECURITY: Premium Dark-Green Section       -->
  <!-- ===================================================== -->
  <section class="py-16 lg:py-20 bg-[#0A331E] relative overflow-hidden border-b border-emerald-950 text-white">
    <Container>
      <div class="max-w-3xl mb-10 sm:mb-12">
        {/*<span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-400/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold uppercase tracking-widest font-mono mb-3">
          SECURITY & TRUST
        </span>*/}
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white tracking-tight font-display leading-[1.12]">
          Enterprise Security Built into Every Step
        </h2>
        <p class="mt-3 text-base sm:text-lg text-emerald-100/90 leading-relaxed font-sans font-normal max-w-2xl">
          Rigorous vetting, certified information governance, and unbroken chain of custody protecting your assets nationwide.
        </p>
      </div>

      <!-- 4 Trust & Security Pillars -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-12">
        <div class="p-6 rounded-2xl bg-white/[0.06] border border-white/10 hover:border-emerald-400/40 transition-colors space-y-3">
          <div class="w-9 h-9 rounded-lg bg-emerald-400/20 text-emerald-300 flex items-center justify-center font-bold font-mono text-sm">
            01
          </div>
          <h3 class="text-lg font-semibold text-white font-display">
            Vetted Logistics & Fleet
          </h3>
          <p class="text-sm text-emerald-100/80 leading-relaxed font-sans">
            BS 7858 security-vetted drivers, dedicated GPS-tracked vehicles, panic alarms, and numbered tamper-evident seals.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white/[0.06] border border-white/10 hover:border-emerald-400/40 transition-colors space-y-3">
          <div class="w-9 h-9 rounded-lg bg-emerald-400/20 text-emerald-300 flex items-center justify-center font-bold font-mono text-sm">
            02
          </div>
          <h3 class="text-lg font-semibold text-white font-display">
            ISO 27001 & UK GDPR
          </h3>
          <p class="text-sm text-emerald-100/80 leading-relaxed font-sans">
            Certified data handling controls, strict confidentiality agreements, and statutory compliance with UK data protection laws.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white/[0.06] border border-white/10 hover:border-emerald-400/40 transition-colors space-y-3">
          <div class="w-9 h-9 rounded-lg bg-emerald-400/20 text-emerald-300 flex items-center justify-center font-bold font-mono text-sm">
            03
          </div>
          <h3 class="text-lg font-semibold text-white font-display">
            Traceable Chain of Custody
          </h3>
          <p class="text-sm text-emerald-100/80 leading-relaxed font-sans">
            Barcoded inventory intake, real-time tracking, and Blancco-sanitised / DIN 66399 particle destruction verification.
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white/[0.06] border border-white/10 hover:border-emerald-400/40 transition-colors space-y-3">
          <div class="w-9 h-9 rounded-lg bg-emerald-400/20 text-emerald-300 flex items-center justify-center font-bold font-mono text-sm">
            04
          </div>
          <h3 class="text-lg font-semibold text-white font-display">
            Zero-Landfill ESG Defence
          </h3>
          <p class="text-sm text-emerald-100/80 leading-relaxed font-sans">
            100% circular diversion pathways, Environment Agency AATF carrier licences, and full statutory waste transfer notes.
          </p>
        </div>
      </div>

      <!-- Governing Accreditations Strip -->
      <div class="pt-8 border-t border-emerald-500/20 flex flex-wrap items-center justify-between gap-4">
        <span class="text-xs font-mono font-bold uppercase tracking-widest text-emerald-300">
          Governing Accreditations:
        </span>
        <div class="flex flex-wrap gap-2.5">
          {['ISO 27001', 'ISO 9001', 'ISO 14001', 'BS 7858 Vetted', 'Cyber Essentials Plus', 'Crown Commercial Service'].map((std) => (
            <span class="inline-flex items-center px-3 py-1 rounded-lg bg-white/10 border border-white/15 text-emerald-200 text-xs font-mono font-semibold">
              {std}
            </span>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 07 / INDUSTRIES / SECTORS ===== -->
  <section class="py-16 lg:py-24 bg-white relative overflow-hidden border-b border-slate-200/80">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-12 lg:mb-16">
        <div class="lg:col-span-7">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
            {detail.businessNeedsTitle || "Industries We Support"}
