---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import PageHero from '../../components/hero/PageHero.astro';
import AccordionFaq from '../../components/content/AccordionFaq.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import SectorCard from '../../components/sectors/SectorCard.astro';
import { getServices, getSectors, getSiteSettings } from '../../lib/sanity/client';
import { generateServiceSchema, generateBreadcrumbSchema } from '../../lib/seo/jsonld';
import type { Service } from '../../lib/sanity/types';

export async function getStaticPaths() {
  const allServices = await getServices();
  return allServices.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const [allServices, sectors, siteSettings] = await Promise.all([
  getServices(),
  getSectors(),
  getSiteSettings(),
]);

// Division accent colour map — consistent with hub pages
const divisionAccent: Record<string, { accent: string; dark: string; light: string; pill: string }> = {
  'it-lifecycle-services-destruction': {
    accent: '#1B3A5C',
    dark: '#0f2238',
    light: '#EFF4FA',
    pill: '#1B3A5C15',
  },
  'information-management': {
    accent: '#5D4037',
    dark: '#3E2723',
    light: '#FBF8F6',
    pill: '#5D403715',
  },
  'secure-shredding-document-integrity': {
    accent: '#2D6A4F',
    dark: '#1a2e1f',
    light: '#F2F8F5',
    pill: '#2D6A4F15',
  },
  'moving-relocation-services': {
    accent: '#374151',
    dark: '#1a1f2e',
    light: '#F8F9FA',
    pill: '#37415115',
  },
};

const clr = divisionAccent[service.divisionSlug] ?? {
  accent: '#1B3A5C', dark: '#0f2238', light: '#EFF4FA', pill: '#1B3A5C15',
};

// Related services calculation
const relatedServiceList = allServices
  .filter((s) => s.slug !== service.slug && (service.relatedServices?.includes(s.slug) || s.divisionSlug === service.divisionSlug))
  .slice(0, 3);

// Relevant sectors
const relevantSectorList = sectors.filter((sec) => service.relatedSectors?.includes(sec.slug));

// Division label for breadcrumb/link
const divisionPageSlug = service.divisionSlug;

// JSON-LD
const serviceSchema = generateServiceSchema(service, siteSettings, Astro.site?.origin || 'https://techsteps.co.uk');
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Services', url: '/services' },
  { name: service.divisionTitle, url: `/${divisionPageSlug}` },
  { name: service.title, url: `/services/${service.slug}` },
], Astro.site?.origin || 'https://techsteps.co.uk');
---

<BaseLayout
  title={service.metaTitle || `${service.title} | Techsteps UK`}
  description={service.metaDescription || service.summary}
  jsonLd={[serviceSchema, breadcrumbSchema]}
  hasHeroHeader={true}
>

  <!-- ===== 1. SERVICE HERO (Simple & Clean, ref: /sustainability) ===== -->
  <PageHero
    eyebrow={service.divisionTitle.toUpperCase()}
    title={service.title}
    subheading={service.summary}
    bgImage={service.heroImage || '/images/services/data-centre-hardware.jpg'}
    breadcrumbs={[
      { name: 'Services', url: '/services' },
      { name: service.divisionTitle, url: `/${divisionPageSlug}` },
      { name: service.title, url: `/services/${service.slug}` },
    ]}
    dividerColor="#ffffff"
  >
    <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
      <a
        href={`/request-a-quote?service=${encodeURIComponent(service.slug)}`}
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl text-white text-sm font-bold shadow-lg transition-all duration-200 hover:brightness-110"
        style={`background: ${clr.accent};`}
      >
        Request a Quote
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <a
        href="/contact"
        class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-sm font-bold border border-white/20 transition-all duration-200"
      >
        Speak to a Specialist
      </a>
    </div>
  </PageHero>

  <!-- ===== CHALLENGE / SOLUTION ===== -->
  <section class="bg-white py-14 lg:py-16 border-b border-slate-100">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 lg:gap-6">
        <!-- Challenge -->
        <div class="rounded-2xl border border-slate-200 bg-[#fafafa] p-7 lg:p-8">
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-red-50 border border-red-200 text-red-700 text-[10px] font-bold uppercase tracking-widest mb-5">
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m-9.303 3.376c-.866 1.5.217 3.374 1.948 3.374h14.71c1.73 0 2.813-1.874 1.948-3.374L13.949 3.378c-.866-1.5-3.032-1.5-3.898 0L2.697 16.126zM12 15.75h.007v.008H12v-.008z"/></svg>
            The Challenge
          </div>
          <h2 class="text-xl font-bold text-slate-900 mb-3">Why Standard Approaches Fall Short</h2>
          <p class="text-sm text-slate-600 leading-relaxed">{service.customerProblem}</p>
        </div>

        <!-- Solution -->
        <div class="rounded-2xl p-7 lg:p-8 text-white" style={`background: ${clr.dark};`}>
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-[10px] font-bold uppercase tracking-widest mb-5 border" style={`background: ${clr.accent}20; border-color: ${clr.accent}40; color: ${clr.accent === '#1B3A5C' ? '#93c5fd' : '#6ee7b7'};`}>
            <svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            The Techsteps Solution
          </div>
          <h2 class="text-xl font-bold text-white mb-3">Certified & Controlled</h2>
          <p class="text-sm text-white/75 leading-relaxed">{service.solution}</p>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== KEY BENEFITS ===== -->
  <section class="py-14 lg:py-20" style={`background: ${clr.light};`}>
    <Container>
      <div class="text-center mb-10">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase mb-4 border px-3 py-1.5 rounded-full" style={`color: ${clr.accent}; border-color: ${clr.accent}30; background: ${clr.accent}08;`}>Key Benefits</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">Why {service.title}?</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-2 gap-4 max-w-4xl mx-auto">
        {service.keyBenefits.map((benefit, i) => (
          <div class="group flex items-start gap-5 bg-white rounded-2xl p-5 border border-slate-200 hover:border-transparent hover:shadow-lg transition-all duration-300">
            <div class="h-9 w-9 rounded-xl flex items-center justify-center shrink-0 text-xs font-extrabold text-white mt-0.5" style={`background: ${clr.accent};`}>
              {String(i + 1).padStart(2, '0')}
            </div>
            <p class="text-sm text-slate-700 leading-relaxed pt-1">{benefit}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== PROCESS ===== -->
  {service.process && service.process.length > 0 && (
    <section class="py-14 lg:py-20 border-t border-slate-100 bg-white">
      <Container>
        <div class="text-center mb-12">
          <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase mb-4 border px-3 py-1.5 rounded-full" style={`color: ${clr.accent}; border-color: ${clr.accent}30; background: ${clr.accent}08;`}>Our Process</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-2">The {service.title} Process</h2>
          <p class="text-sm text-slate-500 max-w-lg mx-auto">A disciplined, step-by-step process with complete audit visibility at every stage.</p>
        </div>

        <div class="relative max-w-4xl mx-auto">
          <!-- Vertical connector for mobile, horizontal for desktop -->
          <div class="space-y-4 lg:space-y-0 lg:grid gap-4" style={`grid-template-columns: repeat(${Math.min(service.process.length, 4)}, 1fr);`}>
            {service.process.map((step, i) => (
              <div class="relative group">
                <!-- connector line -->
                {i < service.process.length - 1 && (
                  <div class="hidden lg:block absolute top-5 left-full w-full h-px pointer-events-none -translate-x-4 z-0" style={`background: linear-gradient(to right, ${clr.accent}40, transparent);`}></div>
                )}
                <div class="relative z-10 bg-white border border-slate-200 rounded-2xl p-5 hover:border-transparent hover:shadow-md transition-all duration-300 group-hover:translate-y-[-2px]">
                  <div class="flex items-center gap-3 mb-3">
                    <div class="h-8 w-8 rounded-lg flex items-center justify-center text-[10px] font-extrabold text-white shrink-0" style={`background: ${clr.accent};`}>
                      {String(step.stepNumber).padStart(2, '0')}
                    </div>
                    <h3 class="text-sm font-bold text-slate-900 leading-tight">{step.title}</h3>
                  </div>
                  <p class="text-xs text-slate-500 leading-relaxed">{step.description}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )}

  <!-- ===== CAPABILITIES ===== -->
  {service.capabilities && service.capabilities.length > 0 && (
    <section class="py-14 lg:py-20" style={`background: ${clr.dark};`}>
      <Container>
        <div class="max-w-4xl mx-auto">
          <div class="text-center mb-10">
            <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-white/40 mb-4">Accreditations & Standards</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Technical Capabilities & Standards</h2>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            {service.capabilities.map((cap) => (
              <div class="flex items-center gap-3 px-5 py-4 rounded-xl bg-white/[0.06] border border-white/10 hover:bg-white/10 transition-colors duration-200">
                <span class="h-2 w-2 rounded-full shrink-0" style={`background: ${clr.accent === '#1B3A5C' ? '#60a5fa' : '#34d399'};`}></span>
                <span class="text-xs text-white/80 font-medium leading-snug">{cap}</span>
              </div>
            ))}
          </div>
        </div>
      </Container>
    </section>
  )}

  <!-- ===== RELEVANT SECTORS ===== -->
  {relevantSectorList.length > 0 && (
    <section class="bg-white py-14 lg:py-16 border-t border-slate-100">
      <Container>
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase mb-4 border px-3 py-1.5 rounded-full" style={`color: ${clr.accent}; border-color: ${clr.accent}30; background: ${clr.accent}08;`}>Sectors Served</span>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight">
            Organisations Deploying This Service
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {relevantSectorList.map((sec) => (
            <SectorCard sector={sec} />
          ))}
        </div>
      </Container>
    </section>
  )}

  <!-- ===== FAQs ===== -->
  {service.faqs && service.faqs.length > 0 && (
    <section class="py-14 lg:py-16 border-t border-slate-200" style={`background: ${clr.light};`}>
      <Container>
        <AccordionFaq
          faqs={service.faqs}
          title={`${service.title} — Frequently Asked Questions`}
          subtitle="Practical answers about this service and how it operates."
        />
      </Container>
    </section>
  )}

  <!-- ===== RELATED SERVICES ===== -->
  {relatedServiceList.length > 0 && (
    <section class="bg-white py-14 lg:py-16 border-t border-slate-100">
      <Container>
        <div class="flex items-center justify-between mb-8 border-b border-slate-200 pb-4">
          <h2 class="text-xl font-bold text-slate-900">Related Services</h2>
          <a href={`/${divisionPageSlug}`} class="text-xs font-bold uppercase tracking-wider hover:underline" style={`color: ${clr.accent};`}>
            View all {service.divisionTitle} →
          </a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {relatedServiceList.map((rel) => (
            <a
              href={`/services/${rel.slug}`}
              class="group bg-white rounded-2xl p-5 border border-slate-200 hover:border-transparent hover:shadow-lg transition-all duration-300 flex flex-col overflow-hidden relative"
            >
              <div class="absolute top-0 left-0 right-0 h-0.5 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-t-2xl" style={`background: ${clr.accent};`}></div>
              <h3 class="text-sm font-bold text-slate-900 group-hover:underline leading-snug mb-2">{rel.title}</h3>
              <p class="text-xs text-slate-500 leading-relaxed line-clamp-3 flex-1">{rel.summary}</p>
              <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-end">
                <span class="text-xs font-bold flex items-center gap-1 group-hover:gap-2 transition-all" style={`color: ${clr.accent};`}>
                  Explore
                  <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      </Container>
    </section>
  )}

  <!-- ===== FINAL CTA (Clean Open Layout - No Background Box) ===== -->
  <section class="relative z-10 py-16 lg:py-24 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full blur-3xl pointer-events-none opacity-15" style={`background: ${clr.accent};`}></div>
    <Container className="relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-xs sm:text-sm font-bold tracking-[0.2em] uppercase mb-4" style={`color: ${clr.accent};`}>Ready to Start?</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 mb-5 leading-tight tracking-tight">
          Need {service.title}<br />for Your Organisation?
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-10 max-w-xl mx-auto font-medium">
          Speak with our team to arrange a collection, request an on-site audit or obtain a formal proposal.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`/request-a-quote?service=${encodeURIComponent(service.slug)}`}
            class="px-8 py-4 rounded-xl font-bold text-sm uppercase tracking-wider text-white shadow-lg hover:shadow-xl transition-all duration-200 hover:brightness-110 transform hover:-translate-y-0.5"
            style={`background: ${clr.accent};`}
          >
            Request a Quote →
          </a>
          <a
            href="/contact"
            class="px-8 py-4 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-900 font-bold text-sm uppercase tracking-wider transition-all duration-200 shadow-xs hover:shadow-md transform hover:-translate-y-0.5"
          >
            Contact Techsteps
          </a>
        </div>
      </div>
    </Container>
  </section>

</BaseLayout>
