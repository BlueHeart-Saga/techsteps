<script>
  function initNeedsPanels() {
    const needsPanels =
      document.querySelectorAll<HTMLElement>('[data-needs-panel]');

    if (!needsPanels.length) return;

    function activateNeeds(target: HTMLElement) {
      needsPanels.forEach((panel) => {
        const isActive = panel === target;

        panel.classList.toggle('is-active', isActive);
        panel.setAttribute('aria-expanded', String(isActive));
      });
    }

    needsPanels.forEach((panel) => {
      // Prevent duplicate event listeners
      if (panel.dataset.needsInitialized === 'true') return;
      panel.dataset.needsInitialized = 'true';

      panel.addEventListener('mouseenter', () => {
        activateNeeds(panel);
      });

      panel.addEventListener('focus', () => {
        activateNeeds(panel);
      });

      panel.addEventListener('click', () => {
        activateNeeds(panel);
      });
    });
  }

  // Initial page load
  initNeedsPanels();

  // Astro client-side navigation
  document.addEventListener('astro:page-load', initNeedsPanels);
</script>
