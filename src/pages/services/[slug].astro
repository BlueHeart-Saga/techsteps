const processBadge =
  detail?.processBadge?.trim() || processFallback.badge;

const processTitle =
  detail?.processTitle?.trim() || processFallback.title;

const processSubtitle =
  detail?.processSubtitle?.trim() || processFallback.subtitle;

const processIconPaths = [
  'M12 3L19 7V12C19 16.5 16 19.5 12 21C8 19.5 5 16.5 5 12V7L12 3ZM9 12L11 14L15 10',
