---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import PageHero from '../../components/hero/PageHero.astro';
import { getServices, getSectors, getSiteSettings } from '../../lib/sanity/client';
import { generateServiceSchema, generateBreadcrumbSchema } from '../../lib/seo/jsonld';
import { getServiceDetailContent } from '../../data/serviceDetails';
import type { Service } from '../../lib/sanity/types';

export async function getStaticPaths() {
  const allServices = await getServices();
  return allServices.map((service) => ({
    params: { slug: service.slug },
    props: { service },
  }));
}

interface Props {
  service: Service;
}

const { service } = Astro.props;
const [siteSettings] = await Promise.all([
  getSiteSettings(),
]);

// Division accent colour map — consistent with hub pages and site theme
const divisionAccent: Record<string, { accent: string; dark: string; light: string; pill: string }> = {
  'it-lifecycle-services-destruction': {
    accent: '#0F623A',
    dark: '#0A331E',
    light: '#F2F8F5',
    pill: '#0F623A15',
  },
  'information-management': {
    accent: '#0F623A',
    dark: '#0A331E',
    light: '#F2F8F5',
    pill: '#0F623A15',
  },
  'secure-shredding-document-integrity': {
    accent: '#0F623A',
    dark: '#0A331E',
    light: '#F2F8F5',
    pill: '#0F623A15',
  },
  'moving-relocation-services': {
    accent: '#0F623A',
    dark: '#0A331E',
    light: '#F2F8F5',
    pill: '#0F623A15',
  },
};

const clr = divisionAccent[service.divisionSlug] ?? {
  accent: '#0F623A', dark: '#0A331E', light: '#F2F8F5', pill: '#0F623A15',
};

// Division label for breadcrumb/link
const divisionPageSlug = service.divisionSlug;

// Tailored service detail content
const detail = getServiceDetailContent(service.slug, service);

// JSON-LD
const serviceSchema = generateServiceSchema(service, siteSettings, Astro.site?.origin || 'https://techsteps.co.uk');
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Services', url: '/services' },
  { name: service.divisionTitle, url: `/${divisionPageSlug}` },
  { name: service.title, url: `/services/${service.slug}` },
], Astro.site?.origin || 'https://techsteps.co.uk');
---

<BaseLayout
  title={service.metaTitle || `${service.title} | Techsteps UK`}
  description={service.metaDescription || service.summary}
  jsonLd={[serviceSchema, breadcrumbSchema]}
  hasHeroHeader={true}
>

  <!-- ===== 1. SERVICE HERO ===== -->
  <PageHero
    bgImage={service.heroImage || '/images/services/document-storage.jpg'}
    breadcrumbs={[]}
    layout="custom"
    showDivider={true}
    dividerColor="#ffffff"
    minHeight="min-h-[540px] sm:min-h-[580px] lg:min-h-[640px]"
  >
    <div class="max-w-4xl py-6 sm:py-10 text-left space-y-5 sm:space-y-6">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-mono font-medium text-slate-300">
        <a href={`/services/${divisionPageSlug}`} class="hover:text-white transition-colors underline-offset-4 hover:underline">
          {service.divisionTitle} Services UK
        </a>
        <span class="text-emerald-400 font-bold" aria-hidden="true">›</span>
        <span class="text-white font-semibold">{service.title}</span>
      </nav>

      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black text-white tracking-tight leading-[1.08] drop-shadow-2xl">
        {detail.heroTitle}
      </h1>

      <p class="text-base sm:text-lg lg:text-xl text-slate-200/90 leading-relaxed max-w-2xl font-normal drop-shadow-sm">
        {detail.heroDescription}
      </p>

      <div class="flex flex-wrap items-center gap-3.5 pt-2">
        <a
          href={`/request-a-collection?service=${encodeURIComponent(service.slug)}`}
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white font-bold text-sm sm:text-base shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5 border border-emerald-400/30"
        >
          Request a Collection / Quote
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
        <a
          href={`/contact?service=${encodeURIComponent(service.slug)}`}
          class="inline-flex items-center justify-center px-7 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-sm sm:text-base border border-white/25 hover:border-white transition-all duration-200 backdrop-blur-xs transform hover:-translate-y-0.5"
        >
          Talk to Our Team
        </a>
      </div>
    </div>
  </PageHero>

  <!-- ===== 2. ABOUT THE SERVICE ===== -->
  <section class="bg-white py-16 lg:py-24 border-b border-slate-200/80 relative overflow-hidden">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        {/* Left Side: Photo */}
        <div class="lg:col-span-6 relative">
          <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-xl border-2 border-[#0F623A]/20 bg-white p-2 sm:p-3 transition-all duration-300 hover:shadow-2xl hover:border-[#0F623A]/40 group">
            <div class="rounded-xl sm:rounded-2xl overflow-hidden bg-slate-900 relative aspect-[4/3.2] sm:aspect-[4/3]">
              <img
                src={detail.aboutImage}
                alt={detail.aboutImageAlt}
                class="w-full h-full object-cover transform group-hover:scale-[1.02] transition-transform duration-500"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        {/* Right Side: Service Content */}
        <div class="lg:col-span-6 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
            {detail.aboutBadge}
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-display leading-[1.12]">
            {detail.aboutTitle}
          </h2>

          <div class="space-y-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
            {detail.aboutParagraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>

          {/* Bullet Checklist with Circular Green Checkmarks */}
          <div class="pt-2 space-y-3.5">
            {detail.aboutBullets.map((bullet) => (
              <div class="flex items-center gap-3.5">
                <svg class="w-6 h-6 text-[#0F623A] shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
                  <circle cx="12" cy="12" r="9" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.5 12.5l2.5 2.5 5-5" />
                </svg>
                <span class="text-base sm:text-lg font-semibold text-slate-900">
                  {bullet}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 3. WHY BUSINESSES CHOOSE THIS SERVICE ===== -->
  <section class="py-16 lg:py-24 bg-[#0A331E] relative overflow-hidden border-b border-emerald-950">
    <Container>
      <div class="max-w-5xl mx-auto">
        {/* Section Heading */}
        <div class="mb-10 lg:mb-12 border-b border-emerald-500/30 pb-8">
          <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-400/20 border border-emerald-400/30 text-emerald-300 text-xs font-bold uppercase tracking-widest font-mono mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-300"></span>
            Key Advantages
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight font-display leading-[1.12] max-w-3xl">
            {detail.whyTitle}
          </h2>
          <p class="mt-4 text-base sm:text-lg text-emerald-100/85 leading-relaxed font-sans max-w-3xl font-normal">
            {detail.whySubtitle}
          </p>
        </div>

        {/* 4 Rows with Numbers, Titles, and Descriptions */}
        <div class="divide-y divide-emerald-500/20">
          {detail.whyPoints.map((pt) => (
            <div class="py-7 sm:py-8 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-center group">
              <div class="md:col-span-5 flex items-center gap-4">
                <div class="w-12 h-12 rounded-xl bg-white/10 border border-white/20 flex items-center justify-center text-emerald-300 shrink-0 group-hover:bg-[#0F623A] group-hover:text-white transition-all duration-300 font-mono font-bold text-sm">
                  {pt.number}
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-white font-display">
                  {pt.title}
                </h3>
              </div>
              <div class="md:col-span-7">
                <p class="text-sm sm:text-base text-emerald-100/85 leading-relaxed font-sans font-normal">
                  {pt.description}
                </p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 4. OUR PROCESS (HOW IT WORKS) ===== -->
  <section class="py-16 lg:py-24 bg-white relative overflow-hidden border-b border-slate-200/80">
    <Container>
      <div class="max-w-3xl mb-12 lg:mb-16">
        <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          {detail.processBadge}
        </span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-display">
          {detail.processTitle}
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans">
          {detail.processSubtitle}
        </p>
      </div>

      {/* 4 Stepped Process Cards (Uniform Light Mint Card Background with Large Green Icons) */}
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6 items-end">
        {/* Card 01: Collect / Intake */}
        <div class="rounded-2xl p-6 lg:p-7 bg-[#E8F8F0] text-slate-900 shadow-md hover:shadow-xl border border-[#A3E5C3] min-h-[220px] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 group">
          <div>
            <div class="mb-5 text-[#0F623A] transition-transform duration-300 group-hover:scale-110">
              <svg class="w-10 h-10 sm:w-11 sm:h-11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 font-display">{detail.processSteps[0]?.title}</h3>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed font-sans">
            {detail.processSteps[0]?.description}
          </p>
        </div>

        {/* Card 02: Catalogue / Process */}
        <div class="rounded-2xl p-6 lg:p-7 bg-[#E8F8F0] text-slate-900 shadow-md hover:shadow-xl border border-[#A3E5C3] min-h-[260px] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 group">
          <div>
            <div class="mb-5 text-[#0F623A] transition-transform duration-300 group-hover:scale-110">
              <svg class="w-10 h-10 sm:w-11 sm:h-11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 font-display">{detail.processSteps[1]?.title}</h3>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed font-sans">
            {detail.processSteps[1]?.description}
          </p>
        </div>

        {/* Card 03: Secure Storage / Processing */}
        <div class="rounded-2xl p-6 lg:p-7 bg-[#E8F8F0] text-slate-900 shadow-md hover:shadow-xl border border-[#A3E5C3] min-h-[300px] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 group">
          <div>
            <div class="mb-5 text-[#0F623A] transition-transform duration-300 group-hover:scale-110">
              <svg class="w-10 h-10 sm:w-11 sm:h-11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 font-display">{detail.processSteps[2]?.title}</h3>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed font-sans">
            {detail.processSteps[2]?.description}
          </p>
        </div>

        {/* Card 04: Completion / Certificate */}
        <div class="rounded-2xl p-6 lg:p-7 bg-[#E8F8F0] text-slate-900 shadow-md hover:shadow-xl border border-[#A3E5C3] min-h-[340px] flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 group">
          <div>
            <div class="mb-5 text-[#0F623A] transition-transform duration-300 group-hover:scale-110">
              <svg class="w-10 h-10 sm:w-11 sm:h-11" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="text-xl font-bold text-slate-900 mb-2 font-display">{detail.processSteps[3]?.title}</h3>
          </div>
          <p class="text-sm text-slate-600 leading-relaxed font-sans">
            {detail.processSteps[3]?.description}
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 5. DIFFERENT BUSINESS NEEDS (WHITE BOX WITH GREEN LID) ===== -->
  <section class="py-16 lg:py-24 bg-white relative overflow-hidden border-b border-slate-200/80">
    <Container>
      {/* Section Header: Title Left, Description Right */}
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-12 items-end mb-12 lg:mb-16">
        <div class="lg:col-span-7">
          <span class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
            Sector Applications
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-display leading-[1.12]">
            {detail.businessNeedsTitle}
          </h2>
        </div>
        <div class="lg:col-span-5">
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
            {detail.businessNeedsSubtitle}
          </p>
        </div>
      </div>

      {/* 6 Archive Box Cards Grid */}
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-7">
        {detail.businessNeedsCards.map((card) => (
          <div class="rounded-2xl overflow-hidden bg-white border border-slate-200/90 shadow-sm hover:shadow-xl hover:border-[#0F623A]/40 transition-all duration-300 hover:-translate-y-1.5 group flex flex-col">
            {/* Top Box Lid Tab (Green) */}
            <div class="h-7 sm:h-8 bg-[#0F623A] border-b border-emerald-800/40 flex items-center justify-center px-4 group-hover:bg-[#0c4e2e] transition-colors">
              <div class="w-12 sm:w-14 h-2 rounded-full bg-[#0A331E]/80 border border-emerald-400/30"></div>
            </div>
            {/* Card Content (White Box Body) */}
            <div class="p-6 sm:p-7 space-y-4 flex-1 flex flex-col justify-between bg-white">
              <div class="space-y-4">
                <div class="w-11 h-11 rounded-xl bg-[#0F623A]/10 border border-[#0F623A]/20 flex items-center justify-center text-[#0F623A] group-hover:bg-[#0F623A] group-hover:text-white transition-all duration-300">
                  {card.icon === 'legal' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2m0-2v2m0 16V5m0 16H9m3 0h3" />
                    </svg>
                  )}
                  {card.icon === 'health' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <rect x="3" y="3" width="18" height="18" rx="4" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v8m-4-4h8" />
                    </svg>
                  )}
                  {card.icon === 'finance' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <circle cx="12" cy="12" r="9" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M15 9.5a2.5 2.5 0 00-4 2 2.5 2.5 0 01-1.5 2.2V15h5M9 13.5h4" />
                    </svg>
                  )}
                  {card.icon === 'corporate' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  )}
                  {card.icon === 'public' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3 21h18M3 10h18M5 10v8m4-8v8m6-8v8m4-8v8M12 3l9 7H3l9-7z" />
                    </svg>
                  )}
                  {(card.icon === 'business' || !['legal', 'health', 'finance', 'corporate', 'public'].includes(card.icon)) && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                    </svg>
                  )}
                </div>
                <h3 class="text-xl sm:text-2xl font-bold text-slate-900 font-display tracking-tight group-hover:text-[#0F623A] transition-colors">
                  {card.title}
                </h3>
              </div>
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans font-normal">
                {card.description}
              </p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== 6. FREQUENTLY ASKED QUESTIONS ===== -->
  <section class="py-16 lg:py-24 bg-[#FAF8F5] relative overflow-hidden border-b border-slate-200/80">
    <Container>
      <div class="max-w-4xl mx-auto mb-10 lg:mb-14 text-center">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          {detail.faqBadge}
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-display leading-[1.12]">
          {detail.faqTitle}
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans max-w-2xl mx-auto">
          {detail.faqSubtitle}
        </p>
      </div>

      {/* Vertical Stack of FAQ Cards (Matching Reference Layout, Permanently Visible) */}
      <div class="max-w-4xl mx-auto space-y-4 sm:space-y-5">
        {detail.faqs.map((faq) => (
          <div class="rounded-2xl sm:rounded-3xl bg-white border border-slate-200/90 shadow-xs overflow-hidden">
            <div class="p-6 sm:p-7 border-b border-slate-100">
              <h3 class="text-base sm:text-lg lg:text-xl font-bold text-slate-900 leading-snug">
                {faq.question}
              </h3>
            </div>
            <div class="px-6 py-5 sm:px-7 sm:py-6">
              <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
                {faq.answer}
              </p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== 7. FINAL CTA (Clean Open Layout - No Background Box) ===== -->
  <section class="relative z-10 py-16 lg:py-24 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full blur-3xl pointer-events-none opacity-15" style={`background: ${clr.accent};`}></div>
    <Container className="relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-xs sm:text-sm font-bold tracking-[0.2em] uppercase mb-4" style={`color: ${clr.accent};`}>Ready to Start?</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 mb-5 leading-tight tracking-tight">
