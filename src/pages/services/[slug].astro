  const targets = [
    service.id?.toLowerCase(),
    (service as any)._id?.toLowerCase(),
    service.slug?.toLowerCase(),
    cleanSlug,
  ].filter(Boolean) as string[];

  return cs.servicesUsed.some((u: any) => {
    if (!u) return false;
    const strValues: string[] = [];
    if (typeof u === 'string') {
      strValues.push(u.toLowerCase());
    } else if (typeof u === 'object') {
      if (u._ref) strValues.push(String(u._ref).toLowerCase());
      if (u.id) strValues.push(String(u.id).toLowerCase());
      if (u._id) strValues.push(String(u._id).toLowerCase());
      if (u.slug) {
        if (typeof u.slug === 'string') strValues.push(u.slug.toLowerCase());
        else if (u.slug.current) strValues.push(String(u.slug.current).toLowerCase());
      }
    }
    return strValues.some((sv) => targets.some((t) => sv === t || sv.replace(/-services|-uk/g, '') === t.replace(/-services|-uk/g, '')));
  });
});

