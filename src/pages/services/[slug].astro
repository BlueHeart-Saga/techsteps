  : isLabRelocations
  ? '/images/hero/Laboratory Relocations & Storage.webp'
  : isHeritageRelocations
  ? '/images/hero/Heritage Relocations & Storage.webp'
  : isInternationalMoves
  ? '/images/hero/Europe & International Domestic Moves.webp'
