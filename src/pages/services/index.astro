---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import PageHero from '../../components/hero/PageHero.astro';
import { getDivisions, getServices } from '../../lib/sanity/client';

const breadcrumbs = [
  { name: 'Services', url: '/services' },
];

const [divisions, services] = await Promise.all([
  getDivisions(),
  getServices(),
]);

// Ordered divisions for display
const orderedDivisions = [...divisions].sort((a, b) => a.order - b.order);

// Division config — featured service slugs + display metadata
const divisionConfig: Record<string, {
  number: string;
  accent: string;
  bg: string;
  featuredSlugs: string[];
  tagline: string;
  icon: string;
}> = {
  'it-lifecycle-services-destruction': {
    number: '02',
    accent: '#0F623A',
    bg: '#F2F8F5',
    tagline: 'Securely manage IT assets from collection and data sanitisation through reuse, remarketing, destruction and recycling.',
    featuredSlugs: ['secure-it-disposal', 'it-asset-disposition-services', 'ultra-secure-hard-drive-destruction', 'remarketing-recycling', 'it-asset-management-services'],
    icon: 'cpu',
  },
  'information-management': {
    number: '01',
    accent: '#0F623A',
    bg: '#F2F8F5',
    tagline: 'Securely manage business information through physical storage, high-speed scanning and full records lifecycle governance.',
    featuredSlugs: ['document-storage', 'document-scanning', 'digital-mailroom', 'document-management'],
    icon: 'folder',
  },
  'secure-shredding-document-integrity': {
    number: '03',
    accent: '#0F623A',
    bg: '#F2F8F5',
    tagline: 'Protect sensitive information through certified on-site and off-site destruction for documents, media and hard drives.',
    featuredSlugs: ['on-site-shredding', 'off-site-shredding', 'ultra-secure-hard-drive-destruction', 'product-shredding'],
    icon: 'shield',
  },
  'moving-relocation-services': {
    number: '04',
    accent: '#0F623A',
    bg: '#F2F8F5',
    tagline: 'Specialist technology relocation services for IT equipment, data centres, laboratories and mission-critical environments.',
    featuredSlugs: ['it-relocations-specialist', 'business-relocations', 'laboratory-relocations-storage', 'heritage-relocations-storage'],
    icon: 'truck',
  },
};

// Lifecycle steps
const lifecycleSteps = [
  { step: 'Collect', number: '01', desc: 'Secure GPS-tracked collection by BS 7858 vetted personnel.', image: '/images/services/process-step-1-collect.jpg' },
  { step: 'Secure', number: '02', desc: 'Controlled handling, high-security chain of custody.', image: '/images/services/process-step-2-secure.jpg' },
  { step: 'Sanitise', number: '03', desc: 'ADISA-certified erasure, degaussing or shredding.', image: '/images/services/process-step-3-sanitise.jpg' },
  { step: 'Reuse', number: '04', desc: 'Refurbishment and remarketing to maximise residual value.', image: '/images/services/process-step-4-reuse.jpg' },
  { step: 'Recycle', number: '05', desc: 'Zero-landfill, WEEE-compliant responsible recycling.', image: '/images/services/process-step-5-recycle.jpg' },
  { step: 'Report', number: '06', desc: 'Certificates, audit trails and ESG reporting.', image: '/images/services/process-step-6-report.jpg' },
];

// Why Techsteps pillars
const pillars = [
  {
    title: 'Security',
    desc: 'Protecting information and assets with uncompromising standards throughout the lifecycle.',
    icon: 'lock',
  },
  {
    title: 'Expertise',
    desc: 'Specialist lifecycle and operational knowledge across every service discipline.',
    icon: 'star',
  },
  {
    title: 'Responsibility',
    desc: 'Making better choices for technology and the environment at every stage.',
    icon: 'leaf',
  },
  {
    title: 'Accountability',
    desc: 'Clear processes, serialised tracking and complete visibility throughout the lifecycle.',
    icon: 'check',
  },
];

// Sectors for cross-link band
const sectors = [
  { title: 'Defence', slug: 'defence' },
  { title: 'NHS & Healthcare', slug: 'nhs' },
  { title: 'Financial Services', slug: 'finance' },
  { title: 'Central Government', slug: 'central-government' },
];

// 4 Division Cards for the catalogue showcase
const divisionCards = [
  {
    division: 'DIVISION 01',
    slug: 'information-management',
    title: 'Information Management',
    desc: 'Secure, compliant storage, scanning and management of physical and digital information, designed to protect valuable records throughout their lifecycle.',
    cta: 'EXPLORE INFORMATION MANAGEMENT',
    href: '/services/information-management',
    bgImage: '/images/services/image1.png',
    icon: 'doc-shield',
  },
  {
    division: 'DIVISION 02',
    slug: 'it-lifecycle-services-destruction',
    title: 'IT Lifecycle Services & Destruction',
    desc: 'End-to-end IT asset disposition, secure collection, data sanitisation, hardware refurbishment and responsible electronic recycling.',
    cta: 'EXPLORE IT LIFECYCLE',
    href: '/services/it-lifecycle',
    bgImage: '/images/services/image2.jpg',
    icon: 'laptop-recycle',
  },
  {
    division: 'DIVISION 03',
    slug: 'secure-shredding-document-integrity',
    title: 'Secure Shredding & Document Integrity',
    desc: 'Secure destruction of confidential documents, media and products through compliant shredding, collection and responsible recycling services.',
    cta: 'EXPLORE SECURE SHREDDING',
    href: '/services/secure-destruction',
    bgImage: '/images/services/image3.jpg',
    icon: 'shredder',
  },
  {
    division: 'DIVISION 04',
    slug: 'moving-relocation-services',
    title: 'Moving & Relocation Services',
    desc: 'Specialist IT relocation, laboratory moves, museum and archive transportation, commercial office moves and turnkey logistics management.',
    cta: 'EXPLORE RELOCATION',
    href: '/services/relocation',
    bgImage: '/images/services/image4.jpg',
    icon: 'truck',
  },
];
---

<BaseLayout
  title="Our Services | IT Lifecycle, Information Management & Secure Destruction | Techsteps"
  description="Techsteps delivers certified IT asset disposition, secure document and media destruction, information management and specialist relocation services across the UK."
  hasHeroHeader={true}
>
  <!-- ===== 1. SERVICES HERO (Simple & Clean, ref: /sustainability) ===== -->
<PageHero
  layout="split"
  eyebrow="OUR SERVICES"
  title="Solutions Across the Tecnology Lifecycle"
  subheading="Specialist IT asset disposition, secure destruction, information management and technology relocation services for organisations across the UK."
  bgImage="/images/services/data-centre-hardware.jpg"
  breadcrumbs={breadcrumbs}
  dividerColor="#ffffff"
/>

  <!-- ===== 1. ONE PARTNER. MULTIPLE SOLUTIONS. ===== -->
<!-- ===== SERVICE DIVISIONS SHOWCASE ===== -->
<section id="divisions" class="bg-white py-10 lg:py-14 overflow-hidden">
  <Container>

<!-- SECTION HEADER -->
<div class="text-center mb-4 lg:mb-6">
  <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#0F623A] mb-3">
    Service Divisions
  </span>

  <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight">
    One Partner. Multiple Solutions.
  </h2>
</div>


    <!-- TWO COLUMNS -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-16 xl:gap-24 items-center">


      <!-- ========================================= -->
      <!-- COLUMN 1 : TITLE + DESCRIPTION -->
      <!-- ========================================= -->

      <div class="flex items-center">

        <div class="max-w-xl">

          <span
            id="division-label"
            class="text-[11px] font-bold tracking-[0.2em] uppercase text-[#0F623A]"
          >
            Division 01
          </span>

          <h2
            id="division-heading"
            class="mt-4 text-3xl sm:text-4xl lg:text-5xl font-light text-slate-900 leading-[1.08] tracking-tight"
          >
            Information Management
          </h2>

          <p
            id="division-description"
            class="mt-6 text-base sm:text-lg text-slate-600 leading-relaxed"
          >
            Secure and efficient information management solutions designed
            to help organisations store, manage and protect their critical
            business information.
          </p>

          <a
            id="division-link"
            href="/services/information-management"
            class="mt-8 inline-flex items-center gap-5 bg-[#0F623A] text-white px-6 py-4 text-sm font-bold hover:bg-[#0c4e2e] transition-all duration-200"
          >
            <span id="division-button">
              Explore Information Management
            </span>

            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M5 12h14m-6-6 6 6-6 6" />
            </svg>
          </a>

        </div>

      </div>


      <!-- ========================================= -->
      <!-- COLUMN 2 : CIRCULAR IMAGE -->
      <!-- ========================================= -->

      <div class="relative h-[380px] lg:h-[440px] flex items-center justify-center">

        <!-- LARGE ORBIT -->
<div
  class="absolute
         w-[340px] h-[340px]
         sm:w-[410px] sm:h-[410px]
         lg:w-[480px] lg:h-[480px]
         rounded-full
         border border-dashed
         border-[#0F623A]/25"
></div>


        <!-- SECOND ORBIT -->
<div
  class="absolute
         w-[260px] h-[260px]
         sm:w-[320px] sm:h-[320px]
         lg:w-[380px] lg:h-[380px]
         rounded-full
         border border-[#0F623A]/10"
></div>


        <!-- ROTATING ORBIT -->
        <div
          class="absolute inset-0 flex items-center justify-center animate-orbit"
        >

          <!-- ORBIT DOT -->
          <span
            class="absolute
                   top-[1px]
                   w-3 h-3
                   rounded-full
                   bg-[#0F623A]
                   shadow-[0_0_0_7px_rgba(15,98,58,0.12)]"
          ></span>

        </div>


        <!-- IMAGE -->
<div
  class="relative z-10
         w-[270px] h-[270px]
         sm:w-[330px] sm:h-[330px]
         lg:w-[390px] lg:h-[390px]
         rounded-full
         overflow-hidden
         border-[7px]
         border-white
         shadow-[0_20px_60px_rgba(15,98,58,0.18)]"
>
          <img
            id="division-image"
            src="/images/services/image1.png"
            alt="Information Management"
            class="w-full h-full object-cover transition-all duration-500"
          />
        </div>


        <!-- SMALL DECORATIVE DOTS -->

        <span
          class="absolute
                 left-[12%] top-[32%]
                 w-2 h-2
                 rounded-full
                 bg-[#0F623A]/50"
        ></span>

        <span
          class="absolute
                 right-[12%] bottom-[30%]
                 w-2 h-2
                 rounded-full
                 bg-[#0F623A]/40"
        ></span>

      </div>

    </div>

  </Container>
</section>
<style>
  @keyframes orbit {
    from {
      transform: rotate(0deg);
    }

    to {
      transform: rotate(360deg);
    }
  }

  .animate-orbit {
    animation: orbit 18s linear infinite;
  }

  #division-image {
    transition:
      opacity 0.4s ease,
      transform 0.4s ease;
  }
</style>
<script>
  const divisionData = {
    information: {
      label: "Division 01",
      title: "Information Management",
      description:
        "Secure and efficient information management solutions designed to help organisations store, manage and protect their critical business information.",
      image: "/images/services/image1.png",
      link: "/services/information-management",
      button: "Explore Information Management",
    },

    lifecycle: {
      label: "Division 02",
      title: "IT Lifecycle Services",
      description:
        "Responsible IT asset lifecycle services covering collection, data sanitisation, reuse, remarketing, recycling and secure destruction.",
      image: "/images/services/image2.jpg",
      link: "/services/it-lifecycle",
      button: "Explore IT Lifecycle Services",
    },

    shredding: {
      label: "Division 03",
      title: "Secure Shredding",
      description:
        "Secure destruction services for confidential documents, data-bearing media and sensitive materials, helping organisations protect information throughout its lifecycle.",
      image: "/images/services/image3.jpg",
      link: "/services/secure-shredding",
      button: "Explore Secure Shredding",
    },

    relocation: {
      label: "Division 04",
      title: "Moving & Relocation",
      description:
        "Specialist technology relocation services for safely moving IT equipment, infrastructure and technology environments with minimal disruption.",
      image: "/images/services/image4.jpg",
      link: "/services/relocation",
      button: "Explore Moving & Relocation",
    },
  };


  const tabs = document.querySelectorAll(".division-tab");

  const image = document.getElementById("division-image");
  const label = document.getElementById("division-label");
  const heading = document.getElementById("division-heading");
  const description = document.getElementById("division-description");
  const link = document.getElementById("division-link");
  const button = document.getElementById("division-button");


  tabs.forEach((tab) => {

    tab.addEventListener("click", () => {

      const key = tab.getAttribute("data-division");

      if (!key || !divisionData[key]) return;

      const data = divisionData[key];


      // Reset all tabs
      tabs.forEach((item) => {

        const title = item.querySelector(".division-title");
        const arrow = item.querySelector(".division-arrow");

        title?.classList.remove("text-[#0F623A]");
        title?.classList.add("text-slate-500");

        arrow?.classList.remove("text-[#0F623A]");
        arrow?.classList.add("text-slate-300");

      });


      // Activate selected tab
      const activeTitle = tab.querySelector(".division-title");
      const activeArrow = tab.querySelector(".division-arrow");

      activeTitle?.classList.remove("text-slate-500");
      activeTitle?.classList.add("text-[#0F623A]");

      activeArrow?.classList.remove("text-slate-300");
      activeArrow?.classList.add("text-[#0F623A]");


      // Small fade effect for image
      if (image) {

        image.style.opacity = "0";

        setTimeout(() => {

          image.setAttribute("src", data.image);
          image.setAttribute("alt", data.title);

          image.style.opacity = "1";

        }, 180);

      }


      // Update content
      if (label) {
        label.textContent = data.label;
      }

      if (heading) {
        heading.textContent = data.title;
      }

      if (description) {
        description.textContent = data.description;
      }

      if (link) {
        link.setAttribute("href", data.link);
      }

      if (button) {
        button.textContent = data.button;
      }

    });

  });
</script>

  <!-- ===== 2. IT ASSET LIFECYCLE VISUAL ===== -->
  <section class="relative bg-white py-20 lg:py-28 overflow-hidden border-t border-slate-100">
    <!-- Subtle organic corner gradient (matching bottom-right of reference design) -->
    <div class="absolute -right-24 -bottom-24 w-96 h-96 rounded-full bg-gradient-to-tl from-[#0F623A]/10 via-[#0F623A]/5 to-transparent blur-3xl pointer-events-none select-none"></div>

    <!-- Floating botanical leaves in bottom-right (from reference design) -->
    <div class="absolute right-4 sm:right-10 bottom-6 sm:bottom-12 pointer-events-none select-none z-0 hidden md:block">
      <div class="relative w-52 h-40">
        <svg class="absolute bottom-2 right-12 w-16 h-16 text-[#0F623A] opacity-40 rotate-[35deg] drop-shadow-sm" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 008 20C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/>
        </svg>
        <svg class="absolute bottom-12 right-2 w-12 h-12 text-[#0F623A] opacity-30 -rotate-[20deg] drop-shadow-sm" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 008 20C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/>
        </svg>
        <svg class="absolute bottom-20 right-24 w-8 h-8 text-[#0F623A] opacity-30 rotate-[65deg]" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 008 20C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/>
        </svg>
        <svg class="absolute bottom-6 right-36 w-6 h-6 text-[#0F623A] opacity-25 -rotate-[40deg]" viewBox="0 0 24 24" fill="currentColor">
          <path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 008 20C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/>
        </svg>
      </div>
    </div>

    <Container className="relative z-10">
      <!-- Top Left Header & Intro (matching the image layout) -->
      <div class="max-w-2xl mb-14 sm:mb-16 lg:mb-20">
        <!-- Eyebrow Pill -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A] text-white text-[11px] font-bold uppercase tracking-wider mb-4 shadow-xs">
          <svg class="w-3.5 h-3.5 text-[#0F623A]" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17 8C8 10 5.9 16.17 3.82 21.34L5.71 22l1-2.3A4.49 4.49 0 008 20C19 20 22 3 22 3c-1 2-8 2.25-13 3.25S2 11.5 2 13.5s1.75 3.75 1.75 3.75C7 8 17 8 17 8z"/>
          </svg>
          <span>Our Work Process</span>
        </div>

        <!-- Main Title: First line bold dark, second line light styled -->
<h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight leading-[1.1]">
  Every Asset.
  <span class="block font-light text-slate-400">
    A Smarter Journey.
  </span>
</h2>

        <!-- Description Paragraph -->
        <p class="mt-4 text-sm sm:text-base text-slate-600 leading-relaxed max-w-xl">
          We help organisations move technology through the right lifecycle pathway, balancing security, value recovery and responsible end-of-life management.
        </p>

        <!-- CTA Link -->
        <div class="mt-5">
          <a
            href="#division-it-lifecycle-services-destruction"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#0F623A] hover:bg-[#146B5C] text-white text-xs sm:text-sm font-bold uppercase tracking-wider transition-all duration-200 shadow-sm hover:shadow-md transform hover:-translate-y-0.5"
          >
            <span>Explore IT Asset Lifecycle</span>
            <span class="text-sm font-bold">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- Stepper Wave Track Area -->
      <div class="relative pt-4 pb-8 lg:pb-16">
        <!-- Connecting Smooth Wave Line (SVG Bezier Path, visible on lg screens) -->
        <svg
          class="absolute inset-x-0 top-0 w-full h-[260px] pointer-events-none z-0 hidden lg:block"
          viewBox="0 0 1200 260"
          fill="none"
          preserveAspectRatio="none"
        >
          <path
            d="M 20 125 C 60 120, 80 112, 100 112 C 180 112, 220 48, 300 48 C 380 48, 420 120, 500 120 C 580 120, 620 40, 700 40 C 780 40, 820 104, 900 104 C 980 104, 1020 48, 1100 48 C 1130 48, 1150 44, 1180 40"
            stroke="#0F623A"
            stroke-width="2.5"
            stroke-linecap="round"
            opacity="0.8"
          />
        </svg>

        <!-- Steps Items: Responsive (horizontal swipe on mobile/tablet, 6-col wave grid on desktop) -->
        <div class="flex lg:grid lg:grid-cols-6 gap-6 sm:gap-8 lg:gap-4 overflow-x-auto lg:overflow-visible pb-6 lg:pb-0 scrollbar-none snap-x relative z-10 px-2 lg:px-0">
          {lifecycleSteps.map((step, i) => {
            // Alternating wave translation classes for desktop to follow the curved SVG path
            const waveY = [
              'lg:translate-y-12',  // Step 1 (Collect): lower
              'lg:-translate-y-4',  // Step 2 (Secure): higher
              'lg:translate-y-14',  // Step 3 (Sanitise): lower
              'lg:-translate-y-6',  // Step 4 (Reuse): higher
              'lg:translate-y-10',  // Step 5 (Recycle): lower
              'lg:-translate-y-4',  // Step 6 (Report): higher
            ][i] || '';

            return (
              <div class={`shrink-0 w-[230px] sm:w-[250px] lg:w-auto snap-center flex flex-col items-center group transition-all duration-300 ${waveY}`}>
                <!-- Circular Photo Card with Radial Halo -->
                <div class="relative mx-auto w-28 h-28 sm:w-32 sm:h-32 mb-4">
                  <!-- Decorative radial rays / dashed ring (matching reference design) -->
                  <svg
                    class="absolute -inset-3 sm:-inset-3.5 w-[calc(100%+24px)] sm:w-[calc(100%+28px)] h-[calc(100%+24px)] sm:h-[calc(100%+28px)] text-[#0F623A]/45 pointer-events-none select-none transition-transform duration-700 group-hover:rotate-45"
                    viewBox="0 0 160 160"
                    fill="none"
                  >
                    <circle cx="80" cy="80" r="70" stroke="currentColor" stroke-width="1.2" stroke-dasharray="3 4" opacity="0.6"/>
                    <circle cx="80" cy="80" r="63" stroke="currentColor" stroke-width="0.8" opacity="0.3"/>
                    {Array.from({ length: 24 }).map((_, idx) => (
                      <line
                        x1="80"
                        y1="3"
                        x2="80"
                        y2="9"
                        stroke="currentColor"
                        stroke-width="1.2"
                        stroke-linecap="round"
                        transform={`rotate(${idx * 15} 80 80)`}
                      />
                    ))}
                  </svg>

                  <!-- Crisp White Circle Container with Drop Shadow -->
                  <div class="relative w-full h-full rounded-full p-1.5 bg-white shadow-[0_12px_28px_rgba(0,0,0,0.12)] border border-slate-100 z-10 transition-transform duration-300 group-hover:scale-105">
                    <div class="w-full h-full rounded-full overflow-hidden bg-slate-100">
                      <img
                        src={step.image}
                        alt={step.step}
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                        loading="lazy"
                      />
                    </div>
                  </div>

                  <!-- Numbered Badge Pinned to Bottom Center (solid green with white digit) -->
                  <div class="absolute -bottom-2.5 left-1/2 -translate-x-1/2 w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-[#0F623A] text-white flex items-center justify-center text-xs sm:text-sm font-extrabold shadow-md border-2 border-white z-20">
                    {i + 1}
                  </div>
                </div>

                <!-- Text Content Below Node -->
                <div class="text-center px-1">
                  <h3 class="text-base sm:text-lg font-bold text-slate-900 mb-1.5 tracking-tight group-hover:text-[#0F623A] transition-colors leading-snug">
                    {step.step}
                  </h3>
                  <p class="text-xs sm:text-[13px] text-slate-500 leading-relaxed max-w-[190px] mx-auto">
                    {step.desc}
                  </p>
                </div>
              </div>
            );
          })}
        </div>
      </div>
    </Container>
  </section>
  <!-- ===== 3. WHY CHOOSE TECHSTEPS & PROVEN SCALE ===== -->
  <section class="relative bg-white pt-0 pb-12 lg:pb-16 overflow-hidden">
    <!-- Photographic Banner with Visible Image & Light Overlay -->
    <div class="relative w-full overflow-hidden pt-24 sm:pt-32 lg:pt-36 pb-32 sm:pb-40 lg:pb-48 bg-[#072011]">
      <!-- Background Image (Vivid & Clearly Visible) -->
      <img
        src="/images/services/why-choose-banner.jpg"
        alt="TechSteps Team Collaborating"
        class="absolute inset-0 w-full h-full object-cover object-[center_30%] opacity-90 select-none pointer-events-none"
        loading="lazy"
      />

      <!-- Light, Translucent Green-Dark Contrast Scrim -->
      <div class="absolute inset-0 bg-gradient-to-r from-[#051a0e]/80 via-[#072412]/55 to-[#051a0e]/80 pointer-events-none select-none"></div>
      <div class="absolute inset-0 bg-black/35 pointer-events-none select-none"></div>

      <!-- Center Banner Content with BIG Typography -->
