---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import HeroHeader from '../../components/global/HeroHeader.astro';
import SectorGrid from '../../components/sectors/SectorGrid.astro';
import CTA from '../../components/global/cta.astro';
import { getDivisions, getServices, getServicesPage, getSectors } from '../../lib/sanity/client';

const [divisions, services, servicesPage, sectors] = await Promise.all([
  getDivisions(),
  getServices(),
  getServicesPage(),
  getSectors(),
]);

const pageTitle = servicesPage?.metaTitle || "Services | Practical, Secure & Sustainable Asset Solutions | TechSteps";
const pageDescription = servicesPage?.metaDescription || "Explore practical, secure, and responsible solutions for managing institutional information, technology assets, and mission-critical business operations throughout their lifecycle.";

// Four Service Cards mapping to images/services assets and existing routes
const serviceCards = [
  {
    title: 'Information Management',
    slug: 'information-management',
    href: '/services/information-management',
    anchorId: '#information-management',
    description: 'Store, scan and manage business information with structured, reliable processes that transition paper to search-ready cloud data.',
    cardImage: '/images/services/Card 1_ Security First (Deep Forest Slate Theme) (1).webp',
    alt: 'Information Management - Secure document storage, scanning and cloud records management',
  },
  {
    title: 'IT Lifecycle Services',
    slug: 'it-lifecycle-services-destruction',
    href: '/services/it-lifecycle',
    anchorId: '#it-lifecycle',
    description: 'Manage IT equipment through certified collection, military-spec data sanitization, refurbishment, and circular zero-waste recovery.',
    cardImage: '/images/services/Card 2_ Environmental Responsibility (Emerald Green Theme) (1).webp',
    alt: 'IT Lifecycle Services - Certified hardware disposition, data sanitization and recycling',
  },
  {
    title: 'Secure Shredding',
    slug: 'secure-shredding-document-integrity',
    href: '/services/secure-destruction',
    anchorId: '#secure-shredding',
    description: 'Support the secure disposal of confidential paper records and media to EN 15713 standards with complete chain-of-custody proof.',
    cardImage: '/images/services/Card 3_ Customer Focus.webp',
    alt: 'Secure Shredding - Compliant on-site and off-site confidential destruction',
  },
  {
    title: 'Relocation Services',
    slug: 'moving-relocation-services',
    href: '/services/relocation',
    anchorId: '#relocation',
    description: 'Help organisations relocate archives, sensitive hardware, and operations equipment with precision scheduling and zero downtime.',
    cardImage: '/images/services/Card 4_ Continuous Improvement.webp',
    alt: 'Relocation Services - Precision business, data centre and heritage equipment moves',
  },
];

// Connected approach 4 steps
const connectedSteps = [
  {
    step: '01',
    title: 'Understand',
    text: 'Identify your regulatory baseline, data sensitivity tiers, and exact hardware or archive inventories.',
  },
  {
    step: '02',
    title: 'Plan',
    text: 'Establish the optimum pathway: digitisation schedules, on-site vs off-site sanitisation, and SLA expectations.',
  },
  {
    step: '03',
    title: 'Manage',
    text: 'Handle assets through vetted personnel with live chain-of-custody tracking accessible via our portal.',
  },
  {
    step: '04',
    title: 'Deliver',
    text: 'Receive comprehensive sanitisation certificates, recycling manifest data, and full audit documentation.',
  },
];

// 4 Benefits in a 2x2 grid
const businessBenefits = [
  {
    title: 'Security First',
    text: 'Rigorous verification protocols and accredited personnel ensure compliance standards are met at every stage of the service lifecycle.',
    icon: 'shield',
  },
  {
    title: 'Clear Accountability',
    text: 'End-to-end audit trails and transparent chain-of-custody documentation provide complete visibility from collection to final outcome.',
    icon: 'check-circle',
  },
  {
    title: 'Responsible Outcomes',
    text: "Prioritising circular economy pathways and zero-landfill disposal methods to help meet your organisation's ESG targets.",
    icon: 'leaf',
  },
  {
    title: 'A Practical Partnership',
    text: 'Flexible scheduling, dedicated account management, and tailored solutions built around your operational needs.',
    icon: 'handshake',
  },
];

---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  hasHeroHeader={true}
>
  <!-- Top Navigation Header -->
  <HeroHeader isHome={false} />

  <!-- =====================================================
       2. HERO SECTION
       ===================================================== -->
  <section class="relative bg-white pt-8 sm:pt-10 lg:pt-12 pb-4 sm:pb-5 lg:pb-6 overflow-hidden">
    <Container size="normal">
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] gap-6 lg:gap-8 items-center">
        
        <!-- Left: Text content -->
        <div class="max-w-xl space-y-5 sm:space-y-6 text-left">
          <h1 class="text-4xl sm:text-5xl lg:text-[54px] xl:text-[58px] font-semibold text-slate-900 tracking-tight leading-[1.12] font-display">
            Services That Move<br class="hidden sm:inline" />
            Your Business<br class="hidden sm:inline" />
            Forward
          </h1>

          <p class="text-lg sm:text-xl text-black leading-relaxed font-normal">
            Explore practical, secure, and responsible solutions for managing institutional information, technology assets, and mission-critical business operations throughout their lifecycle.
          </p>

          <div class="pt-1">
            <a
              href="/contact"
              class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-4 rounded-[12px] bg-[#0B2545] hover:bg-[#133B6B] text-white text-base font-semibold shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#0B2545] focus:ring-offset-2"
            >
              <span>Talk to Our Team</span>
              <span class="text-lg leading-none" aria-hidden="true">&rarr;</span>
            </a>
          </div>
        </div>

        <!-- Right: Technician Cut-out -->
        <div class="relative justify-self-start w-full max-w-[560px] mt-6 lg:mt-0">
          <div class="relative w-full max-w-[560px]">
            <img
              src="/images/services/service main hero.webp"
              alt="TechSteps certified specialist representing compliance, security and lifecycle management"
              width="1560"
              height="2176"
              class="w-full max-w-[560px] h-auto object-contain object-bottom select-none"
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>

      </div>
    </Container>
  </section>


  <!-- =====================================================
       3. "THE RIGHT EXPERTISE, ALL IN ONE PLACE"
       ===================================================== -->
  <section class="bg-white py-10 sm:py-12 lg:py-16 border-t border-slate-100">
    <Container size="normal">
      <div class="text-left max-w-3xl mb-8 sm:mb-10">
        <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-semibold text-slate-900 tracking-tight font-display leading-[1.15]">
          The Right Expertise, All in One Place
        </h2>
        <p class="text-lg sm:text-xl text-black leading-relaxed font-normal mt-3">
          From physical documents to end-of-life technology, our services help businesses manage essential assets with greater control, security, and efficiency.
        </p>
      </div>

      <!-- 4 Deep-Navy Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {serviceCards.map((card) => (
          <a
            href={card.href}
            class="service-feature-card group relative bg-[#0B2545] rounded-[16px] overflow-hidden border border-slate-900/40 shadow-sm hover:shadow-xl hover:-translate-y-1.5 hover:border-slate-400/50 transition-all duration-300 flex flex-col focus:outline-none focus:ring-2 focus:ring-[#0B2545] focus:ring-offset-2"
            aria-label={`${card.title} - ${card.description}`}
          >
            <!-- Card Image -->
            <div class="relative w-full aspect-[888/1068] bg-[#0B2545] overflow-hidden">
              <img
                src={card.cardImage}
                alt={card.alt}
                width="888"
                height="1068"
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02] select-none"
                loading="lazy"
                decoding="async"
              />
            </div>

            <!-- Screen reader accessible semantic hierarchy -->
            <h3 class="sr-only">{card.title}</h3>
            <p class="sr-only">{card.description}</p>
          </a>
        ))}
      </div>
    </Container>
  </section>


  <!-- =====================================================
       4. FOUR ALTERNATING FEATURE SECTIONS
       ===================================================== -->
  <div class="bg-white">

    <!-- 4a. Information Management -->
    <section id="information-management" class="scroll-mt-24 sm:scroll-mt-28 py-10 sm:py-12 lg:py-16 border-t border-slate-100">
      <Container size="normal">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-20 items-center">
          
          <div class="lg:col-span-7 order-2 lg:order-1 space-y-5 sm:space-y-6">
            <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-semibold text-slate-900 tracking-tight font-display leading-[1.18]">
              From Physical Records to Digital Clarity
            </h2>

            <p class="text-lg sm:text-xl text-black leading-relaxed font-normal">
              Keep business information organised, accessible and protected through high-security document warehousing, scanning, digital mailroom automation, and enterprise document management systems.
            </p>

            <!-- Pill Rows with Check Icons -->
            <div class="space-y-3 pt-1">
              <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-slate-50 border border-[#0B2545]/15 text-slate-800 text-xs sm:text-sm font-medium">
                <span class="w-4 h-4 rounded-full bg-[#0B2545] text-white flex items-center justify-center shrink-0" aria-hidden="true">
                  <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span>BS 10008 Evidential Weight Certification</span>
              </div>
              <br class="hidden sm:inline" />
              <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-slate-50 border border-[#0B2545]/15 text-slate-800 text-xs sm:text-sm font-medium">
                <span class="w-4 h-4 rounded-full bg-[#0B2545] text-white flex items-center justify-center shrink-0" aria-hidden="true">
                  <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span>Deep-Tier Secure Climate-Controlled Warehousing</span>
              </div>
            </div>

            <div class="pt-3">
              <a
                href="/services/information-management"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-[12px] bg-[#0B2545] hover:bg-[#133B6B] text-white text-sm sm:text-base font-semibold shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#0B2545] focus:ring-offset-2"
              >
                <span>Explore Information Management</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 order-1 lg:order-2 flex justify-center items-center">
            <div class="relative w-full max-w-[420px] lg:max-w-[460px]">
              <img
                src="/images/services/From Physical Records to  Digital Clarity.webp"
                alt="Female document management specialist organizing physical records and digital transitions"
                width="1543"
                height="1924"
                class="w-full h-auto object-contain select-none"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

        </div>
      </Container>
    </section>

    <!-- 4b. IT Lifecycle -->
    <section id="it-lifecycle" class="scroll-mt-24 sm:scroll-mt-28 py-10 sm:py-12 lg:py-16 border-t border-slate-100">
      <Container size="normal">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-20 items-center">
          
          <div class="lg:col-span-5 order-1 lg:order-1 flex justify-center items-center">
            <div class="relative w-full max-w-[420px] lg:max-w-[460px]">
              <img
                src="/images/services/Give Technology a Responsible Next Chapter.webp"
                alt="Recovered electronic technology hardware components prepared for secure remarketing and zero-waste recycling"
                width="1758"
                height="1272"
                class="w-full h-auto object-contain select-none"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <div class="lg:col-span-7 order-2 lg:order-2 space-y-5 sm:space-y-6">
            <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-semibold text-slate-900 tracking-tight font-display leading-[1.18]">
              Give Technology a Responsible Next Chapter
            </h2>

            <p class="text-lg sm:text-xl text-black leading-relaxed font-normal">
              From collecting retired IT equipment to secure data sanitization, asset remarketing, and compliant e-waste recovery, help your organisation extract value while meeting ESG commitments.
            </p>

            <div class="pt-3">
              <a
                href="/contact"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-[12px] bg-[#0B2545] hover:bg-[#133B6B] text-white text-sm sm:text-base font-semibold shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#0B2545] focus:ring-offset-2"
              >
                <span>Discuss Your Requirements</span>
                <span class="text-base leading-none" aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

        </div>
      </Container>
    </section>

    <!-- 4c. Secure Shredding -->
    <section id="secure-shredding" class="scroll-mt-24 sm:scroll-mt-28 py-10 sm:py-12 lg:py-16 border-t border-slate-100">
      <Container size="normal">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-20 items-center">
          
          <div class="lg:col-span-7 order-2 lg:order-1 space-y-5 sm:space-y-6">
            <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-semibold text-slate-900 tracking-tight font-display leading-[1.18]">
              Confidential Today. Securely Disposed Tomorrow.
            </h2>

            <p class="text-lg sm:text-xl text-black leading-relaxed font-normal">
              Protect sensitive business records and hard drives through controlled, on-site or off-site destruction procedures compliant with British and European standards.
            </p>

            <div class="space-y-3 pt-1">
              <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-slate-50 border border-[#0B2545]/15 text-slate-800 text-xs sm:text-sm font-medium">
                <span class="w-4 h-4 rounded-full bg-[#0B2545] text-white flex items-center justify-center shrink-0" aria-hidden="true">
                  <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span>BS EN 15713 Level 4 to Level 6 Security Standards</span>
              </div>
              <br class="hidden sm:inline" />
              <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-slate-50 border border-[#0B2545]/15 text-slate-800 text-xs sm:text-sm font-medium">
                <span class="w-4 h-4 rounded-full bg-[#0B2545] text-white flex items-center justify-center shrink-0" aria-hidden="true">
                  <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span>100% Closed-Loop Recycled Paper Stream</span>
              </div>
            </div>

            <div class="pt-3">
              <a
                href="/services/secure-destruction"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-[12px] bg-[#0B2545] hover:bg-[#133B6B] text-white text-sm sm:text-base font-semibold shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#0B2545] focus:ring-offset-2"
              >
                <span>Explore Secure Shredding</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

          <div class="lg:col-span-5 order-1 lg:order-2 flex justify-center items-center">
            <div class="relative w-full max-w-[400px] lg:max-w-[440px]">
              <img
                src="/images/services/Confidential Today. Securely Disposed Tomorrow..webp"
                alt="High-security confidential document shredding machinery and securely cross-cut recycled paper"
                width="1584"
                height="1394"
                class="w-full h-auto object-contain select-none"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

        </div>
      </Container>
    </section>

    <!-- 4d. Relocation -->
    <section id="relocation" class="scroll-mt-24 sm:scroll-mt-28 py-10 sm:py-12 lg:py-16 border-t border-slate-100">
      <Container size="normal">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-20 items-center">
          
          <div class="lg:col-span-5 order-1 lg:order-1 flex justify-center items-center">
            <div class="relative w-full max-w-[420px] lg:max-w-[460px]">
              <img
                src="/images/services/Every Move, Carefully Managed.webp"
                alt="Professional relocation technicians handling precision data centre hardware and protective logistics"
                width="1410"
                height="1338"
                class="w-full h-auto object-contain select-none"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>

          <div class="lg:col-span-7 order-2 lg:order-2 space-y-5 sm:space-y-6">
            <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-semibold text-slate-900 tracking-tight font-display leading-[1.18]">
              Every Move, Carefully Managed
            </h2>

            <p class="text-lg sm:text-xl text-black leading-relaxed font-normal">
              Support corporate relocations with structured logistics planning and coordinated handling of archives, server racks, desktop fleets, and delicate equipment.
            </p>

            <div class="space-y-3 pt-1">
              <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-slate-50 border border-[#0B2545]/15 text-slate-800 text-xs sm:text-sm font-medium">
                <span class="w-4 h-4 rounded-full bg-[#0B2545] text-white flex items-center justify-center shrink-0" aria-hidden="true">
                  <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span>Dedicated Project Management & Chain of Custody</span>
              </div>
              <br class="hidden sm:inline" />
              <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-slate-50 border border-[#0B2545]/15 text-slate-800 text-xs sm:text-sm font-medium">
                <span class="w-4 h-4 rounded-full bg-[#0B2545] text-white flex items-center justify-center shrink-0" aria-hidden="true">
                  <svg class="w-2.5 h-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                  </svg>
                </span>
                <span>Air-Ride Logistics & Sensitive Equipment Handling</span>
              </div>
            </div>

            <div class="pt-3">
              <a
                href="/services/relocation"
                class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-[12px] bg-[#0B2545] hover:bg-[#133B6B] text-white text-sm sm:text-base font-semibold shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5 focus:outline-none focus:ring-2 focus:ring-[#0B2545] focus:ring-offset-2"
              >
                <span>Explore Relocation Services</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            </div>
          </div>

        </div>
      </Container>
    </section>

  </div>


  <!-- =====================================================
       5. "MORE THAN INDIVIDUAL SERVICES. A CONNECTED APPROACH."
       ===================================================== -->
  <section class="bg-white py-10 sm:py-12 lg:py-16 border-t border-slate-100">
    <Container size="normal">
      <div class="text-left max-w-3xl mb-8 sm:mb-10">
        <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-semibold text-slate-900 tracking-tight font-display leading-[1.15]">
          More Than Individual Services. A Connected Approach.
        </h2>
        <p class="text-lg sm:text-xl text-black leading-relaxed font-normal mt-3">
          Every organisation maintains different regulatory parameters. TechSteps helps align the appropriate sequence of disciplines so no asset falls outside auditable governance.
        </p>
      </div>

      <!-- 4 Soft Slate Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {connectedSteps.map((item) => (
          <div class="bg-slate-50 rounded-[16px] p-6 sm:p-7 border border-[#0B2545]/10 flex flex-col justify-start transition-all duration-300 hover:shadow-md hover:-translate-y-1">
            <span class="text-2xl sm:text-3xl font-bold text-[#0B2545]/30 mb-5 font-mono select-none" aria-hidden="true">
              {item.step}
            </span>
            <h3 class="text-lg sm:text-xl font-semibold text-slate-900 mb-2 font-display">
              {item.title}
            </h3>
            <p class="text-base sm:text-lg text-black leading-relaxed font-normal">
              {item.text}
            </p>
          </div>
        ))}
      </div>
    </Container>
  </section>


  <!-- =====================================================
       6. "BUILT AROUND WHAT MATTERS TO YOUR BUSINESS"
       ===================================================== -->
  <section class="bg-white py-10 sm:py-12 lg:py-16 border-t border-slate-100">
    <Container size="normal">
      <div class="text-left max-w-3xl mb-8 sm:mb-10">
        <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-semibold text-slate-900 tracking-tight font-display leading-[1.15]">
          Built Around What Matters to Your Business
        </h2>
        <p class="text-lg sm:text-xl text-black leading-relaxed font-normal mt-3">
          Our operational framework is engineered around core principles of data protection, regulatory compliance, environmental sustainability, and dedicated partnership.
        </p>
      </div>

      <!-- 2x2 Grid of Benefits -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-x-12 lg:gap-x-16 gap-y-8 sm:gap-y-10">
        {businessBenefits.map((benefit) => (
          <div class="flex items-start gap-4 sm:gap-5">
            <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-[12px] flex items-center justify-center shrink-0 text-[#0B2545]" aria-hidden="true">
              {benefit.icon === 'shield' && (
                <svg class="w-5 h-5 sm:w-5.5 sm:h-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                </svg>
              )}
              {benefit.icon === 'check-circle' && (
                <svg class="w-5 h-5 sm:w-5.5 sm:h-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                  <polyline points="22 4 12 14.01 9 11.01"></polyline>
                </svg>
              )}
              {benefit.icon === 'leaf' && (
                <svg class="w-5 h-5 sm:w-5.5 sm:h-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"></path>
                  <path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"></path>
                </svg>
              )}
              {benefit.icon === 'handshake' && (
                <svg class="w-5 h-5 sm:w-5.5 sm:h-5.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                  <circle cx="9" cy="7" r="4"></circle>
                  <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                </svg>
              )}
            </div>

            <div class="space-y-1">
              <h3 class="text-lg sm:text-xl font-semibold text-slate-900 font-display">
                {benefit.title}
              </h3>
              <p class="text-base sm:text-lg text-black leading-relaxed font-normal">
                {benefit.text}
              </p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>


  <!-- =====================================================
       7. "SOLUTIONS FOR COMPLEX BUSINESS ENVIRONMENTS"
       ===================================================== -->
  <section class="relative overflow-hidden bg-white  py-10 sm:py-12 lg:py-16 border-t border-slate-200/80">
    <div class="relative z-10 w-full max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-6xl mx-auto space-y-3 mb-6 sm:mb-8">
        <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-semibold font-display text-slate-900 tracking-tight leading-[1.18]">
          Solutions for Complex Business Environments
        </h2>

        <p class="text-lg sm:text-xl text-black leading-relaxed font-normal max-w-4xl mx-auto">
          Tailored lifecycle and information management solutions designed for the regulatory, security, and operational demands of distinct industries.
        </p>
      </div>

      <SectorGrid sectors={sectors} />
    </div>
  </section>


  <!-- =====================================================
       8. FINAL CTA
       ===================================================== -->
  <CTA />

</BaseLayout>