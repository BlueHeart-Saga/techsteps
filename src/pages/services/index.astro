              <span class="px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/25 text-white text-[11px] sm:text-xs font-semibold tracking-wider uppercase shadow-sm">
                {card.division}
              </span>

              <!-- Circular Icon Badge -->
              <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-white/20 backdrop-blur-md border border-white/25 flex items-center justify-center text-white shadow-sm group-hover:bg-white/35 group-hover:scale-105 transition-all duration-300">
