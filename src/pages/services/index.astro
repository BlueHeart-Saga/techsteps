  <!-- ===== 4. SERVICE DIVISIONS CATALOGUE ===== -->
  <section id="divisions-catalogue" class="py-16 lg:py-24 bg-[#FAFBFB] border-t border-slate-100 scroll-mt-20">
    <Container>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 lg:gap-6">
        {divisionCards.map((card) => (
          <a
            id={`division-${card.slug}`}
            href={card.href}
            class="group relative rounded-[28px] sm:rounded-[32px] overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 flex flex-col justify-between p-6 sm:p-7 min-h-[490px] sm:min-h-[530px] border border-black/5"
          >
            <!-- Background Image -->
            <div class="absolute inset-0 z-0 overflow-hidden pointer-events-none select-none">
              <img
                src={card.bgImage}
                alt=""
                aria-hidden="true"
                class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
              />
              <!-- Subtle top shadow for badges -->
              <div class="absolute inset-x-0 top-0 h-32 bg-gradient-to-b from-black/50 via-black/20 to-transparent"></div>
