                  <svg class="w-5 h-5 text-white" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 5h14l8 8v22a3 3 0 0 1-3 3H12a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3z" />
                    <path d="M26 5v8h8" />
                    <line x1="16" y1="18" x2="24" y2="18" />
                    <line x1="16" y1="23" x2="22" y2="23" />
                    <path d="M26 27c0 4.5 5 7.5 5 7.5s5-3 5-7.5v-4l-5-2-5 2v4z" stroke="currentColor" stroke-width="2.2" />
                    <path d="M28.5 29.5l2 2 3.5-3.5" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                )}
                {card.icon === 'laptop-recycle' && (
                  <svg class="w-5 h-5 text-white" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="26" height="19" rx="2.5" />
                    <path d="M5 31h34a1.5 1.5 0 0 1-1.5 1.5H6.5A1.5 1.5 0 0 1 5 31z" />
                    <line x1="18" y1="31" x2="26" y2="31" />
                    <path d="M22 15a4 4 0 0 1 3.8 2.8" />
                    <path d="M26 15v3h-3" />
                    <path d="M22 22a4 4 0 0 1-3.8-2.8" />
                    <path d="M18 22v-3h3" />
                  </svg>
                )}
                {card.icon === 'shredder' && (
                  <svg class="w-5 h-5 text-white" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M14 13V5h16v8" />
                    <line x1="18" y1="9" x2="26" y2="9" />
                    <rect x="7" y="13" width="30" height="10" rx="2.5" />
                    <line x1="12" y1="18" x2="32" y2="18" />
                    <line x1="12" y1="27" x2="12" y2="35" />
                    <line x1="17" y1="27" x2="17" y2="39" />
                    <line x1="22" y1="27" x2="22" y2="34" />
                    <line x1="27" y1="27" x2="27" y2="38" />
                    <line x1="32" y1="27" x2="32" y2="35" />
                  </svg>
                )}
                {card.icon === 'truck' && (
                  <svg class="w-5 h-5 text-white" viewBox="0 0 44 44" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="6" y="11" width="20" height="17" rx="2" />
                    <path d="M26 16h7l5 6v6h-12V16z" />
                    <path d="M28 18h4.5l3.5 4H28v-4z" />
                    <circle cx="13" cy="31" r="3.5" stroke="currentColor" stroke-width="2.2" />
                    <circle cx="33" cy="31" r="3.5" stroke="currentColor" stroke-width="2.2" />
                    <line x1="16.5" y1="31" x2="29.5" y2="31" />
                    <line x1="6" y1="28" x2="9.5" y2="28" />
                    <line x1="36.5" y1="28" x2="39" y2="28" />
                  </svg>
                )}
              </div>
            </div>

            <!-- Bottom Content: Title, Description, and Pill Button -->
            <div class="relative z-10 flex flex-col items-start mt-auto pt-16">
              <!-- Title -->
              <h3 class="text-xl sm:text-[22px] font-bold text-white tracking-tight leading-snug mb-2 group-hover:text-emerald-300 transition-colors">
                {card.title}
              </h3>

              <!-- Description -->
              <p class="text-xs sm:text-[13px] text-white/80 leading-relaxed font-normal mb-5 line-clamp-3">
                {card.desc}
              </p>

              <!-- Pill CTA Button with Explore -->
              <div class="inline-flex items-center gap-2.5 pl-4 pr-1.5 py-1.5 rounded-full bg-white text-slate-900 font-semibold text-xs sm:text-sm shadow-md group-hover:bg-[#0F623A] group-hover:text-white transition-all duration-300">
                <span>Explore</span>
                <span class="w-6 h-6 sm:w-7 sm:h-7 rounded-full bg-slate-900 text-white flex items-center justify-center group-hover:bg-white group-hover:text-[#0F623A] transition-colors shrink-0">
                  <svg class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="7" y1="17" x2="17" y2="7"></line>
                    <polyline points="7 7 17 7 17 17"></polyline>
                  </svg>
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

