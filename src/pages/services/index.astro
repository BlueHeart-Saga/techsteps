              <svg class="w-5 h-5 text-slate-400 group-hover:text-[#0F623A] group-hover:translate-x-1.5 transition-all shrink-0" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
