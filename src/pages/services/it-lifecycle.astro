---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import PageHero from '../../components/hero/PageHero.astro';
import AccordionFaq from '../../components/content/AccordionFaq.astro';
import { services } from '../../lib/sanity/data';

const breadcrumbs = [
  { name: 'Services', url: '/services' },
  { name: 'IT Lifecycle', url: '/services/it-lifecycle' },
];

const divSlug = 'it-lifecycle-services-destruction';
const divServices = services.filter(s => s.divisionSlug === divSlug);

// Lifecycle journey stages (interactive)
const lifecycleStages = [
  { id: 'collect', label: 'Collect', number: '01', desc: 'Secure, GPS-tracked collection of IT equipment from your organisation by BS 7858 security-vetted personnel.' },
  { id: 'secure', label: 'Secure', number: '02', desc: 'Controlled, serialised handling throughout the entire asset lifecycle with full chain of custody documentation.' },
  { id: 'sanitise', label: 'Sanitise', number: '03', desc: 'Data is securely removed or destroyed via ADISA-certified erasure, degaussing or physical destruction — appropriate to the asset.' },
  { id: 'reuse', label: 'Reuse', number: '04', desc: 'Suitable equipment is assessed for continued productive use through refurbishment, redeployment or remarketing.' },
  { id: 'recycle', label: 'Recycle', number: '05', desc: 'End-of-life equipment is responsibly processed through WEEE-compliant zero-landfill recycling streams.' },
  { id: 'report', label: 'Report', number: '06', desc: 'Serialised certificates, full audit trails and ESG reporting provide complete lifecycle visibility and accountability.' },
];

// Customer journey (how it works for the organisation)
const customerJourney = [
  { number: '01', title: 'Assess', desc: 'We understand your asset volumes, security requirements and preferred lifecycle outcomes.' },
  { number: '02', title: 'Collect', desc: 'We arrange secure, vetted collection from your site with full chain of custody from departure.' },
  { number: '03', title: 'Process', desc: 'Assets are sanitised, assessed for reuse, remarketed or responsibly recycled according to your requirements.' },
  { number: '04', title: 'Report', desc: 'You receive certificates, disposal records and ESG reporting for each asset and collection.' },
];

// Sectors
const sectors = [
  { title: 'Defence', slug: 'defence' },
  { title: 'NHS & Healthcare', slug: 'nhs' },
  { title: 'Financial Services', slug: 'finance' },
  { title: 'Central Government', slug: 'central-government' },
];

// FAQs
const faqs = [
  { question: 'What is IT asset lifecycle management?', answer: 'IT asset lifecycle management covers the full journey of a technology asset — from procurement through active use, collection, data sanitisation, reuse or remarketing, recycling and final disposal — with the aim of maximising value recovery, protecting data and achieving responsible environmental outcomes.' },
  { question: 'What happens to our IT equipment after collection?', answer: 'Following secure collection, each asset is audited, data-sanitised and assessed. Equipment suitable for continued use is refurbished or remarketed. Assets that have reached end of life are responsibly recycled through WEEE-compliant streams. You receive a full report for every asset.' },
  { question: 'Can data be securely removed before equipment is recycled?', answer: 'Yes. We use ADISA-certified data erasure, degaussing and physical hard drive destruction depending on the security requirement of the asset. Every data sanitisation event is certificated.' },
  { question: 'Can working equipment be reused or remarketed?', answer: 'Where appropriate, working equipment is assessed for refurbishment, redeployment or responsible remarketing — helping organisations recover residual value from technology assets.' },
  { question: 'What happens to equipment that cannot be reused?', answer: 'Assets that cannot be reused are processed through WEEE-compliant zero-landfill recycling channels. No equipment is sent to landfill.' },
  { question: 'Can Techsteps manage large IT asset volumes?', answer: 'Yes. Our logistics, processing and reporting infrastructure is designed to handle large-scale IT asset collections including full office decommissions, data centre clearances and estate-wide hardware refreshes.' },
];
---

<BaseLayout
  title="IT Asset Lifecycle Services | Secure ITAD, Data Destruction & Recycling | Techsteps"
  description="Complete IT asset lifecycle management — secure collection, ADISA-certified data sanitisation, reuse, remarketing and zero-landfill recycling. UK-wide service from Techsteps."
  hasHeroHeader={true}
>
  <!-- ===== 1. HERO (Simple & Clean, ref: /sustainability) ===== -->
  <PageHero
    eyebrow="IT LIFECYCLE & DESTRUCTION"
    title="A Smarter Lifecycle for Every IT Asset."
    subheading="Secure collection, ADISA-certified data sanitisation, remarketing and zero-landfill recycling."
    bgImage="/images/services/remarketing.jpg"
    breadcrumbs={breadcrumbs}
    dividerColor="#ffffff"
  >
    <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#asset-journey"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#1B3A5C] hover:bg-[#142d4a] text-white text-sm font-bold shadow-lg transition-all duration-200"
      >
        Explore the Journey
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
      <a
        href="/request-a-quote?service=it-lifecycle"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-sm font-bold border border-white/20 transition-all duration-200"
      >
        Get a Quote
      </a>
    </div>
  </PageHero>

  <!-- ===== 1. FROM IT ASSET TO FINAL OUTCOME ===== -->
  <section class="bg-white py-16 lg:py-24">
    <Container>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left: image panel -->
        <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-slate-900 via-[#1B3A5C] to-[#0d1117] min-h-[380px] lg:min-h-[460px] flex items-center justify-center">
          <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"></div>
          <div class="absolute inset-0 bg-gradient-to-t from-black/40 to-transparent"></div>
          <!-- Decorative SVG -->
          <svg class="relative z-10 w-56 h-56 opacity-20 text-white" fill="none" stroke="currentColor" stroke-width="0.5" viewBox="0 0 200 200">
            <rect x="20" y="20" width="70" height="50" rx="4"/>
            <rect x="110" y="20" width="70" height="50" rx="4"/>
            <rect x="20" y="90" width="70" height="50" rx="4"/>
            <rect x="110" y="90" width="70" height="50" rx="4"/>
            <rect x="65" y="155" width="70" height="30" rx="4"/>
            <line x1="55" y1="45" x2="110" y2="45"/>
            <line x1="55" y1="115" x2="110" y2="115"/>
            <line x1="55" y1="45" x2="55" y2="115"/>
            <line x1="145" y1="70" x2="145" y2="90"/>
            <line x1="55" y1="140" x2="100" y2="155"/>
          </svg>
          <div class="absolute bottom-6 left-6 right-6">
            <p class="text-xs font-bold uppercase tracking-widest text-[#1B3A5C]/60 mb-1">Division</p>
            <p class="text-lg font-extrabold text-white">IT Lifecycle Services & Destruction</p>
          </div>
        </div>

        <!-- Right: text -->
        <div>
          <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#1B3A5C] mb-5 border border-[#1B3A5C]/30 px-3 py-1.5 rounded-full bg-[#1B3A5C]/5">Value Proposition</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-5">
            From IT Asset to<br />Final Outcome.
          </h2>
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-6">
            Technology reaches the end of its working life, but that doesn't mean its value has ended. Techsteps provides connected IT lifecycle services that help organisations securely collect, manage, sanitise, reuse, remarket and recycle technology.
          </p>
          <div class="space-y-3 mb-8">
            {[
              { label: 'Security', desc: 'Protecting data throughout every stage of the lifecycle.' },
              { label: 'Value Recovery', desc: 'Recovering residual value through reuse and remarketing.' },
              { label: 'Responsible Recycling', desc: 'Zero-landfill WEEE-compliant recycling outcomes.' },
            ].map(item => (
              <div class="flex items-center gap-3">
                <div class="h-5 w-5 rounded-full bg-[#1B3A5C]/10 border border-[#1B3A5C]/30 flex items-center justify-center shrink-0">
                  <svg class="w-2.5 h-2.5 text-[#1B3A5C]" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                </div>
                <span class="text-sm text-slate-700"><strong class="font-semibold text-slate-900">{item.label}</strong> — {item.desc}</span>
              </div>
            ))}
          </div>
          <a href="/request-a-quote" class="inline-flex items-center gap-2 px-7 py-3 rounded-lg bg-[#1B3A5C] hover:bg-[#142d4a] text-white text-sm font-bold uppercase tracking-wider transition-all duration-200 shadow-md">
            Get a Quote →
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 2. SIGNATURE: EVERY ASSET. A SMARTER JOURNEY. ===== -->
  <section id="asset-journey" class="bg-[#1B3A5C] py-16 lg:py-24">
    <Container>
      <div class="text-center mb-14">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-blue-300 mb-4">The IT Asset Journey</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Every Asset.<br />A Smarter Journey.
        </h2>
        <p class="mt-4 text-base text-blue-100/80 max-w-xl mx-auto leading-relaxed">Click any stage to learn more.</p>
      </div>

      <!-- Interactive lifecycle stages -->
      <div class="max-w-4xl mx-auto" id="lifecycle-nav">
        <!-- Stage tabs -->
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mb-8">
          {lifecycleStages.map((stage, i) => (
            <button
              type="button"
              data-stage={stage.id}
              class={`lifecycle-tab group flex flex-col items-center gap-2 p-3 rounded-xl border transition-all duration-200 cursor-pointer ${i === 0 ? 'bg-white/20 border-white/50 shadow-lg' : 'bg-white/5 border-white/15 hover:bg-white/15 hover:border-white/30'}`}
            >
              <span class={`text-[10px] font-bold uppercase tracking-widest ${i === 0 ? 'text-blue-200' : 'text-blue-300/60 group-hover:text-blue-200'}`}>{stage.number}</span>
              <span class={`text-xs font-extrabold uppercase tracking-wider ${i === 0 ? 'text-white' : 'text-white/70 group-hover:text-white'}`}>{stage.label}</span>
            </button>
          ))}
        </div>

        <!-- Description panel -->
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl border border-white/20 p-7 min-h-[110px]">
          {lifecycleStages.map((stage, i) => (
            <div data-stage-desc={stage.id} class={`transition-all duration-300 ${i === 0 ? 'block' : 'hidden'}`}>
              <p class="text-[11px] font-bold uppercase tracking-widest text-blue-300 mb-2">{stage.number} / {stage.label}</p>
              <p class="text-base sm:text-lg text-white leading-relaxed font-medium">{stage.desc}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="text-center mt-10">
        <a href="#it-services" class="inline-flex items-center gap-2 text-sm font-bold text-blue-200 hover:text-white transition-colors">
          Explore our IT lifecycle services ↓
        </a>
      </div>
    </Container>
  </section>

  <!-- ===== 3. IT LIFECYCLE SERVICES GRID ===== -->
  <section id="it-services" class="bg-[#EFF4FA] py-16 lg:py-20 scroll-mt-20">
    <Container>
      <div class="text-center mb-12">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#1B3A5C] mb-4">Our Capabilities</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Everything Your IT Assets Need.</h2>
        <p class="mt-3 text-base text-slate-600 max-w-xl mx-auto leading-relaxed">Individual services, connected by one lifecycle approach.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {divServices.map(service => (
          <a
            href={`/services/${service.slug}`}
            class="group bg-white rounded-2xl p-6 border border-slate-200/80 hover:border-[#1B3A5C]/40 hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden relative"
          >
            <div class="absolute top-0 left-0 right-0 h-0.5 bg-[#1B3A5C] opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-t-2xl"></div>
            <h3 class="text-base font-bold text-slate-900 group-hover:text-[#1B3A5C] transition-colors leading-snug mb-2">{service.title}</h3>
            <p class="text-xs text-slate-500 leading-relaxed line-clamp-3 flex-1">{service.summary}</p>
            <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#1B3A5C]/50">IT Lifecycle</span>
              <span class="flex items-center gap-1 text-xs font-bold text-[#1B3A5C] group-hover:gap-2 transition-all">
                Explore
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== 4. PROTECT THE DATA. MANAGE THE ASSET. ===== -->
  <section class="bg-slate-950 py-16 lg:py-20">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-12">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-blue-400 mb-4">Security & Data Protection</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">Protect the Data.<br />Manage the Asset.</h2>
        <p class="text-base text-slate-400 leading-relaxed">Responsible IT lifecycle management starts with protecting the information stored on every device.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {[
          { label: 'Data', icon: 'shield', desc: 'Secure data handling at every stage — from collection through sanitisation to certificated destruction.' },
          { label: 'Asset', icon: 'cpu', desc: 'Complete lifecycle visibility with serialised tracking, chain of custody and audit documentation throughout.' },
          { label: 'Outcome', icon: 'check', desc: 'Controlled, verified final disposition — reuse, remarketing or responsible recycling — with reporting for every asset.' },
        ].map(item => (
          <div class="bg-white/5 border border-white/10 hover:bg-white/10 hover:border-white/20 rounded-2xl p-7 text-center transition-all duration-200">
            <div class="h-12 w-12 rounded-2xl bg-blue-500/10 border border-blue-500/20 flex items-center justify-center mx-auto mb-5">
              {item.icon === 'shield' && (
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              )}
              {item.icon === 'cpu' && (
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"/><rect x="9" y="9" width="6" height="6"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" stroke-linecap="round"/></svg>
              )}
              {item.icon === 'check' && (
                <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
              )}
            </div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-3">{item.label}</h3>
            <p class="text-xs text-slate-400 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== 5. REUSE BEFORE RECYCLE ===== -->
  <section class="bg-[#f7f8f5] py-16 lg:py-20 border-t border-slate-200">
    <Container>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left: image -->
        <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-[#2D6A4F] via-[#1a2e1f] to-[#0d1117] min-h-[340px] flex items-center justify-center">
          <div class="absolute inset-0 opacity-[0.07]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 20px 20px;"></div>
          <svg class="relative z-10 w-48 h-48 opacity-25 text-white" fill="none" stroke="currentColor" stroke-width="0.75" viewBox="0 0 160 160">
            <circle cx="80" cy="80" r="60"/>
            <path d="M80 20 A60 60 0 0 1 140 80" stroke-dasharray="4 4"/>
            <path d="M140 80 A60 60 0 0 1 80 140" />
            <path d="M80 140 A60 60 0 0 1 20 80" stroke-dasharray="4 4"/>
            <path d="M20 80 A60 60 0 0 1 80 20"/>
            <circle cx="80" cy="80" r="20"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M70 75l10 10 10-15"/>
          </svg>
          <div class="absolute bottom-6 left-6">
            <p class="text-xs font-bold uppercase tracking-widest text-emerald-300 mb-0.5">Commitment</p>
            <p class="text-lg font-extrabold text-white">Zero Landfill</p>
          </div>
        </div>

        <!-- Right: content -->
        <div>
          <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#2D6A4F] mb-5 border border-[#2D6A4F]/30 px-3 py-1.5 rounded-full bg-[#2D6A4F]/5">Sustainability</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-6">
            Reuse Before Recycle.
          </h2>
          <div class="space-y-5 mb-8">
            {[
              { title: 'Reuse', desc: 'Extend the useful life of equipment where it remains suitable for productive use — reducing demand for new technology.' },
              { title: 'Remarket', desc: 'Recover residual value from suitable equipment through responsible remarketing, returning value to your organisation.' },
              { title: 'Recycle', desc: 'Process end-of-life equipment responsibly through WEEE-compliant zero-landfill channels.' },
            ].map((item, i) => (
              <div class="flex gap-4">
                <div class="h-8 w-8 rounded-lg bg-[#2D6A4F]/10 border border-[#2D6A4F]/25 flex items-center justify-center shrink-0 mt-0.5">
                  <span class="text-[10px] font-extrabold text-[#2D6A4F]">{String(i + 1).padStart(2,'0')}</span>
                </div>
                <div>
                  <p class="text-sm font-bold text-slate-900 mb-1">{item.title}</p>
                  <p class="text-sm text-slate-600 leading-relaxed">{item.desc}</p>
                </div>
              </div>
            ))}
          </div>
          <a href="/sustainability" class="inline-flex items-center gap-2 text-sm font-bold text-[#2D6A4F] hover:underline">
            Explore Sustainability →
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 6. HOW IT WORKS ===== -->
  <section class="bg-white py-16 lg:py-20 border-t border-slate-100">
    <Container>
      <div class="max-w-2xl mx-auto text-center mb-12">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#1B3A5C] mb-4">Your Experience</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">Simple for You.<br />Controlled by Us.</h2>
        <p class="text-base text-slate-600 leading-relaxed">What the process looks like from your organisation's perspective.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {customerJourney.map((step, i) => (
          <div class="relative group">
            {i < customerJourney.length - 1 && (
              <div class="hidden lg:block absolute top-6 left-full w-full h-px bg-gradient-to-r from-[#1B3A5C]/30 to-transparent z-0 pointer-events-none -translate-x-6"></div>
            )}
            <div class="relative pt-6 border-t-2 border-slate-200 group-hover:border-[#1B3A5C] transition-colors duration-300">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#1B3A5C] mb-3 block">{step.number}</span>
              <h3 class="text-base font-bold text-slate-900 mb-2">{step.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== 7. SECTORS ===== -->
  <section class="bg-[#EFF4FA] py-14 lg:py-20 border-t border-slate-200">
    <Container>
      <div class="text-center mb-10">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#1B3A5C] mb-4">Sector Expertise</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">Built for Organisations Where Security Matters.</h2>
        <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">Our IT lifecycle services can be tailored to the operational, security and lifecycle requirements of different organisations.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-3xl mx-auto">
        {sectors.map(sector => (
          <a href={`/sectors/${sector.slug}`} class="group bg-white rounded-2xl px-5 py-5 border border-slate-200 hover:border-[#1B3A5C]/50 hover:shadow-lg transition-all duration-300 text-center">
            <p class="text-sm font-bold text-slate-900 group-hover:text-[#1B3A5C] transition-colors leading-snug">{sector.title}</p>
            <p class="mt-1 text-[10px] text-[#1B3A5C] font-bold">Explore →</p>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== 8. TRUST ===== -->
  <section class="bg-white py-14 lg:py-16 border-t border-slate-100">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-10">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#1B3A5C] mb-4">Accreditations</span>
        <h2 class="text-2xl font-extrabold text-slate-900 mb-3">Trust Built Into Every Step.</h2>
        <p class="text-sm text-slate-600 leading-relaxed">Certificates and documentation provide visibility across the IT asset lifecycle.</p>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-4 max-w-4xl mx-auto">
        {[
          { name: 'ADISA Standard 8.0', note: 'Pass with Distinction' },
          { name: 'ISO 27001', note: 'Information Security' },
          { name: 'ISO 14001', note: 'Environmental Mgmt' },
          { name: 'WEEE Compliant', note: 'Electronics Recycling' },
          { name: 'Cyber Essentials Plus', note: 'NCSC Certified' },
          { name: 'UK GDPR Compliant', note: 'Data Protection' },
        ].map(cert => (
          <div class="bg-[#EFF4FA] rounded-2xl p-4 border border-slate-200/80 text-center hover:border-[#1B3A5C]/30 hover:shadow-sm transition-all duration-200">
            <div class="h-7 w-7 rounded-full bg-[#1B3A5C]/10 flex items-center justify-center mx-auto mb-2">
