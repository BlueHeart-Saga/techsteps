---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import PageHero from '../../components/hero/PageHero.astro';
import AccordionFaq from '../../components/content/AccordionFaq.astro';
import { services } from '../../lib/sanity/data';

const breadcrumbs = [
  { name: 'Services', url: '/services' },
  { name: 'Information Management', url: '/services/information-management' },
];

const divSlug = 'information-management';
const divServices = services.filter(s => s.divisionSlug === divSlug);

const lifecycleStages = [
  { id: 'capture', label: 'Capture', number: '01', desc: 'Information is captured from physical or digital sources — through scanning, mailroom processing or direct ingestion.' },
  { id: 'store', label: 'Store', number: '02', desc: 'Records are stored in secure, climate-controlled facilities or structured digital environments with full index and reference.' },
  { id: 'manage', label: 'Manage', number: '03', desc: 'Information is managed, controlled and accessible to authorised personnel throughout its active lifecycle.' },
  { id: 'access', label: 'Access', number: '04', desc: 'Records can be retrieved physically or digitally on demand, with appropriate authorisation and audit records.' },
  { id: 'retain', label: 'Retain', number: '05', desc: 'Retention schedules are tracked and enforced in line with regulatory, legal and organisational requirements.' },
  { id: 'dispose', label: 'Dispose', number: '06', desc: 'Information is securely and compliantly disposed of at end of retention — with certified destruction records.' },
];

const customerJourney = [
  { number: '01', title: 'Assess', desc: 'We understand your information volumes, retention requirements and access needs.' },
  { number: '02', title: 'Implement', desc: 'Records are catalogued, indexed and transferred into secure storage or digital management.' },
  { number: '03', title: 'Operate', desc: 'Ongoing retrieval, management and access services operate around your requirements.' },
  { number: '04', title: 'Report', desc: 'Retention schedules, destruction records and compliance documentation kept throughout.' },
];

const sectors = [
  { title: 'NHS & Healthcare', slug: 'nhs' },
  { title: 'Financial Services', slug: 'finance' },
  { title: 'Central Government', slug: 'central-government' },
  { title: 'Defence', slug: 'defence' },
];

const faqs = [
  { question: 'What is information lifecycle management?', answer: 'Information lifecycle management covers the full journey of a business record — from creation or capture through active use, storage, retrieval, retention and compliant disposal — with the goal of keeping information secure, accessible and compliantly managed throughout.' },
  { question: 'How secure is off-site document storage?', answer: 'Our storage facilities operate under ISO 27001 and BS 4971 standards with climate control, VESDA smoke detection, FM200 fire suppression, and item-level barcode tracking. Access is restricted to authorised personnel only.' },
  { question: 'How quickly can we access stored records?', answer: 'We offer emergency physical retrieval within 2 hours in major areas, same-day for standard requests, and 1-hour Scan-on-Demand digital delivery for documents requiring rapid access.' },
  { question: 'Can you digitise our existing paper records?', answer: 'Yes. Our document scanning service processes high volumes to BS 10008 legal admissibility standards, with full OCR indexing and integration with your document management systems.' },
  { question: 'How are retention schedules managed?', answer: 'Retention periods are tracked and alerted automatically. When records reach end of retention, we notify you and arrange certificated secure destruction in line with your approval.' },
  { question: 'Can records be securely destroyed at end of retention?', answer: 'Yes. Secure document destruction at end of retention is part of our information management service, with certificates provided for every destruction event.' },
];
---

<BaseLayout
  title="Information Management Services | Document Storage, Scanning & Records Management | Techsteps"
  description="Secure information management services — document storage, high-speed scanning, records management and compliant disposal. UK-wide service from Techsteps."
  hasHeroHeader={true}
>
  <PageHero
    eyebrow="INFORMATION MANAGEMENT"
    title="Secure Information for Every Organisation."
    subheading="Complete physical and digital lifecycle management — from secure vault storage to high-speed digitisation and compliant disposal."
    bgImage="/images/services/document-storage.jpg"
    breadcrumbs={breadcrumbs}
    dividerColor="#ffffff"
  >
    <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#info-services"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#5D4037] hover:bg-[#4e362e] text-white text-sm font-bold shadow-lg transition-all duration-200"
      >
        Explore Solutions
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
      <a
        href="/request-a-quote?service=information-management"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-sm font-bold border border-white/20 transition-all duration-200"
      >
        Get a Quote
      </a>
    </div>
  </PageHero>

  <!-- ===== OVERVIEW ===== -->
  <section class="bg-white py-16 lg:py-24">
    <Container>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-[#3E2723] via-[#5D4037] to-[#1a0f0a] min-h-[380px] lg:min-h-[440px] flex items-center justify-center">
          <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"></div>
          <svg class="relative z-10 w-52 h-52 opacity-20 text-white" fill="none" stroke="currentColor" stroke-width="0.5" viewBox="0 0 180 180">
            <rect x="15" y="20" width="50" height="65" rx="3"/>
            <rect x="25" y="30" width="30" height="4"/><rect x="25" y="40" width="30" height="4"/><rect x="25" y="50" width="20" height="4"/>
            <rect x="75" y="20" width="50" height="65" rx="3"/>
            <rect x="85" y="30" width="30" height="4"/><rect x="85" y="40" width="30" height="4"/><rect x="85" y="50" width="20" height="4"/>
            <rect x="135" y="20" width="30" height="65" rx="3"/>
            <rect x="15" y="100" width="50" height="60" rx="3"/>
            <rect x="75" y="100" width="90" height="60" rx="3"/>
          </svg>
          <div class="absolute bottom-6 left-6">
            <p class="text-xs font-bold uppercase tracking-widest text-amber-300/60 mb-0.5">Division</p>
            <p class="text-lg font-extrabold text-white">Information Management</p>
          </div>
        </div>

        <div>
          <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#5D4037] mb-5 border border-[#5D4037]/30 px-3 py-1.5 rounded-full bg-[#5D4037]/5">Value Proposition</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-5">
            From Record Created<br />to Record Controlled.
          </h2>
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-6">
            Organisations generate and rely on large volumes of information. Managing that information securely, compliantly and efficiently requires specialist expertise. Techsteps provides the facilities, systems and services to manage the full information lifecycle.
          </p>
          <div class="space-y-3 mb-8">
            {[
              { label: 'Security', desc: 'Protecting information throughout its entire lifecycle.' },
              { label: 'Compliance', desc: 'Meeting retention, GDPR and industry-specific requirements.' },
              { label: 'Accessibility', desc: 'Fast, authorised access to records when needed.' },
            ].map(item => (
              <div class="flex items-center gap-3">
                <div class="h-5 w-5 rounded-full bg-[#5D4037]/10 border border-[#5D4037]/30 flex items-center justify-center shrink-0">
                  <svg class="w-2.5 h-2.5 text-[#5D4037]" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                </div>
                <span class="text-sm text-slate-700"><strong class="font-semibold text-slate-900">{item.label}</strong> — {item.desc}</span>
              </div>
            ))}
          </div>
          <a href="/request-a-quote" class="inline-flex items-center gap-2 px-7 py-3 rounded-lg bg-[#5D4037] hover:bg-[#4e362e] text-white text-sm font-bold uppercase tracking-wider transition-all duration-200 shadow-md">
            Get a Quote →
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== SIGNATURE LIFECYCLE ===== -->
  <section class="bg-[#3E2723] py-16 lg:py-24">
    <Container>
      <div class="text-center mb-14">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-amber-300 mb-4">The Information Lifecycle</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Every Record.<br />A Clearer Journey.
        </h2>
        <p class="mt-4 text-base text-amber-100/70 max-w-xl mx-auto leading-relaxed">Click any stage to understand the process.</p>
      </div>

      <div class="max-w-4xl mx-auto" id="info-lifecycle-nav">
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mb-8">
          {lifecycleStages.map((stage, i) => (
            <button
              type="button"
              data-stage={stage.id}
              class={`lifecycle-tab group flex flex-col items-center gap-2 p-3 rounded-xl border transition-all duration-200 cursor-pointer ${i === 0 ? 'bg-white/20 border-white/50 shadow-lg' : 'bg-white/5 border-white/15 hover:bg-white/15 hover:border-white/30'}`}
            >
              <span class={`text-[10px] font-bold uppercase tracking-widest ${i === 0 ? 'text-amber-200' : 'text-amber-300/60 group-hover:text-amber-200'}`}>{stage.number}</span>
              <span class={`text-xs font-extrabold uppercase tracking-wider ${i === 0 ? 'text-white' : 'text-white/70 group-hover:text-white'}`}>{stage.label}</span>
            </button>
          ))}
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl border border-white/20 p-7 min-h-[110px]">
          {lifecycleStages.map((stage, i) => (
            <div data-stage-desc={stage.id} class={i === 0 ? 'block' : 'hidden'}>
              <p class="text-[11px] font-bold uppercase tracking-widest text-amber-300 mb-2">{stage.number} / {stage.label}</p>
              <p class="text-base sm:text-lg text-white leading-relaxed font-medium">{stage.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== SERVICES GRID ===== -->
  <section id="im-services" class="bg-[#FBF8F6] py-16 lg:py-20 scroll-mt-20">
    <Container>
      <div class="text-center mb-12">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#5D4037] mb-4">Our Capabilities</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Everything Your Information Needs.</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {divServices.map(service => (
          <a href={`/services/${service.slug}`} class="group bg-white rounded-2xl p-6 border border-slate-200/80 hover:border-[#5D4037]/40 hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden relative">
            <div class="absolute top-0 left-0 right-0 h-0.5 bg-[#5D4037] opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-t-2xl"></div>
            <h3 class="text-base font-bold text-slate-900 group-hover:text-[#5D4037] transition-colors leading-snug mb-2">{service.title}</h3>
            <p class="text-xs text-slate-500 leading-relaxed line-clamp-3 flex-1">{service.summary}</p>
            <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#5D4037]/50">Information Mgmt</span>
              <span class="flex items-center gap-1 text-xs font-bold text-[#5D4037] group-hover:gap-2 transition-all">
                Explore
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== SECURITY & CONTROL ===== -->
  <section class="bg-slate-950 py-16 lg:py-20">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-12">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-amber-400 mb-4">Security & Compliance</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">Control Information.<br />Protect the Organisation.</h2>
        <p class="text-base text-slate-400 leading-relaxed">Secure information management means protecting records throughout their entire lifecycle — not just in storage.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {[
          { label: 'Physical Security', desc: 'Secure, climate-controlled facilities with controlled access and full audit trails for every item.' },
          { label: 'Digital Control', desc: 'Indexed, structured and access-controlled digital management of records throughout their lifecycle.' },
          { label: 'Compliance', desc: 'Retention scheduling, GDPR management and certificated secure destruction at end of life.' },
        ].map(item => (
          <div class="bg-white/5 border border-white/10 hover:bg-white/10 rounded-2xl p-7 text-center transition-all duration-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-3">{item.label}</h3>
            <p class="text-xs text-slate-400 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="bg-white py-16 lg:py-20 border-t border-slate-100">
    <Container>
      <div class="max-w-2xl mx-auto text-center mb-12">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#5D4037] mb-4">Your Experience</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">Simple for You.<br />Controlled by Us.</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {customerJourney.map((step) => (
          <div class="relative group pt-6 border-t-2 border-slate-200 group-hover:border-[#5D4037] transition-colors duration-300">
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#5D4037] mb-3 block">{step.number}</span>
            <h3 class="text-base font-bold text-slate-900 mb-2">{step.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== SECTORS ===== -->
  <section class="bg-[#FBF8F6] py-14 lg:py-20 border-t border-slate-200">
    <Container>
      <div class="text-center mb-10">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#5D4037] mb-4">Sector Expertise</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">Built for Regulated Organisations.</h2>
        <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">Information management requirements vary by sector. Our services are tailored to meet them.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-3xl mx-auto">
        {sectors.map(sector => (
          <a href={`/sectors/${sector.slug}`} class="group bg-white rounded-2xl px-5 py-5 border border-slate-200 hover:border-[#5D4037]/50 hover:shadow-lg transition-all duration-300 text-center">
            <p class="text-sm font-bold text-slate-900 group-hover:text-[#5D4037] transition-colors leading-snug">{sector.title}</p>
            <p class="mt-1 text-[10px] text-[#5D4037] font-bold">Explore →</p>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="bg-white py-14 lg:py-20 border-t border-slate-100">
    <Container>
      <AccordionFaq faqs={faqs} title="Information Management Questions" subtitle="Answers about our information lifecycle and records management services." />
    </Container>
  </section>

  <!-- ===== CTA (Clean Open Layout - No Background Box) ===== -->
  <section class="relative z-10 py-16 lg:py-24 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-[#5D4037]/10 blur-3xl pointer-events-none"></div>
    <Container className="relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-[#5D4037] mb-4">Get Started</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 mb-5 leading-tight tracking-tight">
          Ready to Manage Your Information<br />More Securely?
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-10 max-w-xl mx-auto font-medium">
          Tell us about your information volumes and requirements — we'll help you build the right solution.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-a-quote" class="px-8 py-4 rounded-xl bg-[#5D4037] hover:bg-[#4e362e] text-white font-bold text-sm uppercase tracking-wider transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">Get a Quote →</a>
          <a href="/contact" class="px-8 py-4 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-900 font-bold text-sm uppercase tracking-wider transition-all duration-200 shadow-xs hover:shadow-md transform hover:-translate-y-0.5">Contact Techsteps</a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const nav = document.getElementById('info-lifecycle-nav');
    if (!nav) return;
    const tabs = nav.querySelectorAll('.lifecycle-tab');
    const descs = nav.querySelectorAll('[data-stage-desc]');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-stage');
        tabs.forEach(t => { t.classList.remove('bg-white/20','border-white/50','shadow-lg'); t.classList.add('bg-white/5','border-white/15'); });
        tab.classList.add('bg-white/20','border-white/50','shadow-lg'); tab.classList.remove('bg-white/5','border-white/15');
        descs.forEach(d => { d.classList.toggle('hidden', d.getAttribute('data-stage-desc') !== id); d.classList.toggle('block', d.getAttribute('data-stage-desc') === id); });
      });
    });
  })();
</script>
