---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import PageHero from '../../components/hero/PageHero.astro';
import AccordionFaq from '../../components/content/AccordionFaq.astro';
import { services } from '../../lib/sanity/data';

const breadcrumbs = [
  { name: 'Services', url: '/services' },
  { name: 'Secure Destruction', url: '/services/secure-destruction' },
];

const divSlug = 'secure-shredding-document-integrity';
const divServices = services.filter(s => s.divisionSlug === divSlug);

const lifecycleStages = [
  { id: 'collect', label: 'Collect', number: '01', desc: 'Materials requiring destruction are securely collected from your premises by vetted personnel in secure, locked containers.' },
  { id: 'secure', label: 'Secure', number: '02', desc: 'Collected material is maintained under controlled custody throughout transit — no access, no tampering, full documentation.' },
  { id: 'destroy', label: 'Destroy', number: '03', desc: 'Material is destroyed through the appropriate process — on-site shredding, off-site destruction or physical hard drive shredding.' },
  { id: 'verify', label: 'Verify', number: '04', desc: 'Destruction is independently verified to the required standard — including particle size, process compliance and chain of custody.' },
  { id: 'report', label: 'Report', number: '05', desc: 'A certificated destruction record is issued, providing documented evidence of compliant disposal for audit and regulatory purposes.' },
];

const customerJourney = [
  { number: '01', title: 'Identify', desc: 'We assess what materials require destruction and the appropriate security level.' },
  { number: '02', title: 'Collect', desc: 'Secure, vetted collection using sealed consoles or direct asset collection.' },
  { number: '03', title: 'Destroy', desc: 'On-site or off-site destruction to the required standard and particle size.' },
  { number: '04', title: 'Certify', desc: 'Destruction certificates issued with full details of material, process and date.' },
];

const sectors = [
  { title: 'Defence', slug: 'defence' },
  { title: 'Financial Services', slug: 'finance' },
  { title: 'NHS & Healthcare', slug: 'nhs' },
  { title: 'Central Government', slug: 'central-government' },
];

const faqs = [
  { question: 'What is secure document destruction?', answer: 'Secure document destruction is the certified, auditable process of permanently destroying documents and media containing sensitive information — preventing any possibility of data recovery or misuse.' },
  { question: 'What is the difference between on-site and off-site shredding?', answer: 'On-site shredding takes place at your premises using a mobile shredding vehicle — you can witness the destruction. Off-site shredding involves secure collection and destruction at our facility. Both methods are certificated.' },
  { question: 'Can hard drives be physically destroyed?', answer: 'Yes. Physical hard drive destruction involves the shredding or crushing of the drive to a particle size that renders data irrecoverable — appropriate where standard data erasure is insufficient.' },
  { question: 'What certificate is issued after destruction?', answer: 'A destruction certificate is issued after each destruction event, recording the material type, quantity, destruction method, date and reference — providing evidence of compliant disposal.' },
  { question: 'What is BS EN 15713?', answer: 'BS EN 15713 is the British Standard for the secure destruction of confidential material, specifying the security requirements for shredding, transport and facility management. Our services operate to this standard.' },
  { question: 'Can you manage regular scheduled collections?', answer: 'Yes. Regular scheduled secure consoles and collection services are available — appropriate for organisations with ongoing document destruction requirements.' },
];
---

<BaseLayout
  title="Secure Destruction Services | Document Shredding, Hard Drive Destruction & Media | Techsteps"
  description="Certified secure destruction of documents, hard drives and media. BS EN 15713 accredited on-site and off-site shredding with destruction certificates. UK-wide from Techsteps."
  hasHeroHeader={true}
>
  <PageHero
    eyebrow="SECURE DESTRUCTION"
    title="Certified Destruction of Sensitive Assets."
    subheading="BS EN 15713 accredited on-site and plant shredding for confidential paper records, hard drives and magnetic media."
    bgImage="/images/services/secure-destruction.jpg"
    breadcrumbs={breadcrumbs}
    dividerColor="#ffffff"
  >
    <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#dest-services"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#2D6A4F] hover:bg-[#245a41] text-white text-sm font-bold shadow-lg transition-all duration-200"
      >
        Explore Destruction Services
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
      <a
        href="/request-a-quote?service=secure-destruction"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-sm font-bold border border-white/20 transition-all duration-200"
      >
        Get a Quote
      </a>
    </div>
  </PageHero>

  <!-- ===== OVERVIEW ===== -->
  <section class="bg-white py-16 lg:py-24">
    <Container>
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <div class="relative rounded-3xl overflow-hidden bg-gradient-to-br from-[#1a2e1f] via-[#2D6A4F] to-[#0d1117] min-h-[380px] lg:min-h-[440px] flex items-center justify-center">
          <div class="absolute inset-0 opacity-[0.06]" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 24px 24px;"></div>
          <svg class="relative z-10 w-52 h-52 opacity-20 text-white" fill="none" stroke="currentColor" stroke-width="0.6" viewBox="0 0 180 180">
            <rect x="30" y="20" width="120" height="90" rx="4"/>
            <path d="M30 60h120M60 20v90M90 20v90M120 20v90"/>
            <path d="M20 120 L160 120 L145 165 L35 165 Z"/>
            <line x1="20" y1="120" x2="160" y2="165" stroke-dasharray="3 3" opacity="0.4"/>
            <line x1="160" y1="120" x2="20" y2="165" stroke-dasharray="3 3" opacity="0.4"/>
          </svg>
          <div class="absolute bottom-6 left-6">
            <p class="text-xs font-bold uppercase tracking-widest text-emerald-300/60 mb-0.5">Division</p>
            <p class="text-lg font-extrabold text-white">Secure Shredding & Document Integrity</p>
          </div>
        </div>

        <div>
          <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#2D6A4F] mb-5 border border-[#2D6A4F]/30 px-3 py-1.5 rounded-full bg-[#2D6A4F]/5">Value Proposition</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-5">
            When Information Reaches<br />Its End, Destroy It Securely.
          </h2>
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-6">
            Not all information can simply be discarded. Sensitive documents, hard drives and media require controlled, certificated destruction that provides evidence of compliant disposal. Techsteps provides certified destruction services from collection through to destruction certificate.
          </p>
          <div class="space-y-3 mb-8">
            {[
              { label: 'Certified', desc: 'BS EN 15713 accredited destruction with full certificates.' },
              { label: 'Controlled', desc: 'Full chain of custody from collection to destruction.' },
              { label: 'Documented', desc: 'Destruction records for every event and every asset.' },
            ].map(item => (
              <div class="flex items-center gap-3">
                <div class="h-5 w-5 rounded-full bg-[#2D6A4F]/10 border border-[#2D6A4F]/30 flex items-center justify-center shrink-0">
                  <svg class="w-2.5 h-2.5 text-[#2D6A4F]" fill="currentColor" viewBox="0 0 8 8"><circle cx="4" cy="4" r="3"/></svg>
                </div>
                <span class="text-sm text-slate-700"><strong class="font-semibold text-slate-900">{item.label}</strong> — {item.desc}</span>
              </div>
            ))}
          </div>
          <a href="/request-a-quote" class="inline-flex items-center gap-2 px-7 py-3 rounded-lg bg-[#2D6A4F] hover:bg-[#245a41] text-white text-sm font-bold uppercase tracking-wider transition-all duration-200 shadow-md">
            Get a Quote →
          </a>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== SIGNATURE LIFECYCLE ===== -->
  <section class="bg-[#1a2e1f] py-16 lg:py-24">
    <Container>
      <div class="text-center mb-14">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-emerald-400 mb-4">The Destruction Process</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-white tracking-tight leading-tight">
          Secure From Collection<br />to Destruction.
        </h2>
        <p class="mt-4 text-base text-emerald-100/70 max-w-xl mx-auto leading-relaxed">Click any stage to understand what happens.</p>
      </div>

      <div class="max-w-4xl mx-auto" id="dest-lifecycle-nav">
        <div class="grid grid-cols-3 sm:grid-cols-5 gap-2 mb-8">
          {lifecycleStages.map((stage, i) => (
            <button
              type="button"
              data-stage={stage.id}
              class={`lifecycle-tab group flex flex-col items-center gap-2 p-3 rounded-xl border transition-all duration-200 cursor-pointer ${i === 0 ? 'bg-white/20 border-white/50 shadow-lg' : 'bg-white/5 border-white/15 hover:bg-white/15 hover:border-white/30'}`}
            >
              <span class={`text-[10px] font-bold uppercase tracking-widest ${i === 0 ? 'text-emerald-200' : 'text-emerald-300/60 group-hover:text-emerald-200'}`}>{stage.number}</span>
              <span class={`text-xs font-extrabold uppercase tracking-wider ${i === 0 ? 'text-white' : 'text-white/70 group-hover:text-white'}`}>{stage.label}</span>
            </button>
          ))}
        </div>
        <div class="bg-white/10 backdrop-blur-sm rounded-2xl border border-white/20 p-7 min-h-[110px]">
          {lifecycleStages.map((stage, i) => (
            <div data-stage-desc={stage.id} class={i === 0 ? 'block' : 'hidden'}>
              <p class="text-[11px] font-bold uppercase tracking-widest text-emerald-300 mb-2">{stage.number} / {stage.label}</p>
              <p class="text-base sm:text-lg text-white leading-relaxed font-medium">{stage.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== SERVICES GRID ===== -->
  <section id="dest-services" class="bg-[#F2F8F5] py-16 lg:py-20 scroll-mt-20">
    <Container>
      <div class="text-center mb-12">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#2D6A4F] mb-4">Our Capabilities</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">Certified Destruction Services.</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {divServices.map(service => (
          <a href={`/services/${service.slug}`} class="group bg-white rounded-2xl p-6 border border-slate-200/80 hover:border-[#2D6A4F]/40 hover:shadow-xl transition-all duration-300 flex flex-col overflow-hidden relative">
            <div class="absolute top-0 left-0 right-0 h-0.5 bg-[#2D6A4F] opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-t-2xl"></div>
            <h3 class="text-base font-bold text-slate-900 group-hover:text-[#2D6A4F] transition-colors leading-snug mb-2">{service.title}</h3>
            <p class="text-xs text-slate-500 leading-relaxed line-clamp-3 flex-1">{service.summary}</p>
            <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-between">
              <span class="text-[10px] font-bold uppercase tracking-widest text-[#2D6A4F]/50">Secure Destruction</span>
              <span class="flex items-center gap-1 text-xs font-bold text-[#2D6A4F] group-hover:gap-2 transition-all">
                Explore
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== SECURITY & CONTROL ===== -->
  <section class="bg-slate-950 py-16 lg:py-20">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-12">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-emerald-400 mb-4">Security & Control</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mb-4">Controlled From<br />Collection to Certificate.</h2>
        <p class="text-base text-slate-400 leading-relaxed">Secure destruction is more than shredding. It requires controlled custody, verified process and documented evidence.</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {[
          { label: 'Chain of Custody', desc: 'Every item tracked from collection through destruction. No gaps, no exceptions.' },
          { label: 'Verified Destruction', desc: 'Destruction verified to the required standard, witnessed where required.' },
          { label: 'Certificated', desc: 'A destruction certificate issued for every event — providing documented evidence of compliant disposal.' },
        ].map(item => (
          <div class="bg-white/5 border border-white/10 hover:bg-white/10 rounded-2xl p-7 text-center transition-all duration-200">
            <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-3">{item.label}</h3>
            <p class="text-xs text-slate-400 leading-relaxed">{item.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== HOW IT WORKS ===== -->
  <section class="bg-white py-16 lg:py-20 border-t border-slate-100">
    <Container>
      <div class="max-w-2xl mx-auto text-center mb-12">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#2D6A4F] mb-4">Your Experience</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-3">Simple for You.<br />Controlled by Us.</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {customerJourney.map((step) => (
          <div class="group pt-6 border-t-2 border-slate-200 hover:border-[#2D6A4F] transition-colors duration-300">
            <span class="text-[10px] font-bold uppercase tracking-widest text-[#2D6A4F] mb-3 block">{step.number}</span>
            <h3 class="text-base font-bold text-slate-900 mb-2">{step.title}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{step.desc}</p>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== SECTORS ===== -->
  <section class="bg-[#F2F8F5] py-14 lg:py-20 border-t border-slate-200">
    <Container>
      <div class="text-center mb-10">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#2D6A4F] mb-4">Sector Expertise</span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 tracking-tight mb-3">Trusted by Regulated Organisations.</h2>
        <p class="text-sm text-slate-600 max-w-xl mx-auto leading-relaxed">Our secure destruction services meet the requirements of organisations handling sensitive and classified information.</p>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-3xl mx-auto">
        {sectors.map(sector => (
          <a href={`/sectors/${sector.slug}`} class="group bg-white rounded-2xl px-5 py-5 border border-slate-200 hover:border-[#2D6A4F]/50 hover:shadow-lg transition-all duration-300 text-center">
            <p class="text-sm font-bold text-slate-900 group-hover:text-[#2D6A4F] transition-colors leading-snug">{sector.title}</p>
            <p class="mt-1 text-[10px] text-[#2D6A4F] font-bold">Explore →</p>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="bg-white py-14 lg:py-20 border-t border-slate-100">
    <Container>
      <AccordionFaq faqs={faqs} title="Secure Destruction Questions" subtitle="Clear answers about our document shredding and destruction services." />
    </Container>
  </section>

  <!-- ===== CTA (Clean Open Layout - No Background Box) ===== -->
  <section class="relative z-10 py-16 lg:py-24 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-[#2D6A4F]/10 blur-3xl pointer-events-none"></div>
    <Container className="relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-[#2D6A4F] mb-4">Get Started</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 mb-5 leading-tight tracking-tight">
          Ready to Destroy Sensitive<br />Information Securely?
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-10 max-w-xl mx-auto font-medium">
          Tell us what you need to destroy and we'll arrange the right certified destruction solution.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-a-quote" class="px-8 py-4 rounded-xl bg-[#2D6A4F] hover:bg-[#245a41] text-white font-bold text-sm uppercase tracking-wider transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5">Get a Quote →</a>
          <a href="/contact" class="px-8 py-4 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-900 font-bold text-sm uppercase tracking-wider transition-all duration-200 shadow-xs hover:shadow-md transform hover:-translate-y-0.5">Contact Techsteps</a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const nav = document.getElementById('dest-lifecycle-nav');
    if (!nav) return;
    const tabs = nav.querySelectorAll('.lifecycle-tab');
    const descs = nav.querySelectorAll('[data-stage-desc]');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-stage');
        tabs.forEach(t => { t.classList.remove('bg-white/20','border-white/50','shadow-lg'); t.classList.add('bg-white/5','border-white/15'); });
        tab.classList.add('bg-white/20','border-white/50','shadow-lg'); tab.classList.remove('bg-white/5','border-white/15');
        descs.forEach(d => { d.classList.toggle('hidden', d.getAttribute('data-stage-desc') !== id); d.classList.toggle('block', d.getAttribute('data-stage-desc') === id); });
      });
    });
  })();
</script>
