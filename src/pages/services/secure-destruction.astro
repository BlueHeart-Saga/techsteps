---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import PageHero from '../../components/hero/PageHero.astro';
import AccordionFaq from '../../components/content/AccordionFaq.astro';
import { getServices, getDivisions } from '../../lib/sanity/client';

const breadcrumbs = [
  { name: 'Services', url: '/services' },
  { name: 'Secure Destruction', url: '/services/secure-destruction' },
];

const [divisions, services] = await Promise.all([
  getDivisions(),
  getServices(),
]);
const divSlug = 'secure-shredding-document-integrity';
const division = divisions.find(d => d.slug === divSlug);
const divServices = services.filter(s => s.divisionSlug === divSlug);

const clr = { accent: '#0F623A', dark: '#0A331E', light: '#F2F8F5' };

const sectorLinks = [
  { title: 'Defence', slug: 'defence' },
  { title: 'Financial Services', slug: 'finance' },
  { title: 'NHS & Healthcare', slug: 'nhs' },
  { title: 'Central Government', slug: 'central-government' },
];

const defaultFaqs = [
  { question: 'What is secure document destruction?', answer: 'Secure document destruction is the certified, auditable process of permanently destroying documents and media containing sensitive information — preventing any possibility of data recovery or misuse.' },
  { question: 'What is the difference between on-site and off-site shredding?', answer: 'On-site shredding takes place at your premises using a mobile shredding vehicle — you can witness the destruction. Off-site shredding involves secure collection and destruction at our facility. Both methods are certificated.' },
  { question: 'Can hard drives and media be physically destroyed?', answer: 'Yes. Physical hard drive and media destruction involves high-torque shredding to a particle size that renders data irrecoverable — appropriate where standard data erasure is insufficient.' },
  { question: 'What certificate is issued after destruction?', answer: 'A Certificate of Destruction is issued after each destruction event, recording the material type, quantity, destruction method, date and reference — providing legal evidence of compliant disposal.' },
];
const faqs = (division?.faqs && division.faqs.length > 0) ? division.faqs : defaultFaqs;

const mainServices = [
  {
    number: '01',
    title: 'Information Management',
    slug: '/services/information-management',
    description: 'Climate-controlled physical document storage, accredited high-speed scanning, digital mailrooms, and secure media vaulting.',
    image: '/images/services/image1.png',
    badge: 'Division 01',
  },
  {
    number: '02',
    title: 'IT Lifecycle & Destruction',
    slug: '/services/it-lifecycle',
    description: 'End-to-end ITAD, tracked GPS logistics, verified data sanitisation (ADISA compliant), and zero-landfill electronic recycling.',
    image: '/images/services/image2.jpg',
    badge: 'Division 02',
  },
  {
    number: '03',
    title: 'Secure Shredding & Destruction',
    slug: '/services/secure-destruction',
    description: 'BS EN 15713 accredited mobile cross-cut shredding, secure console management, product destruction, and certified recycling.',
    image: '/images/services/image3_web.jpg',
    badge: 'Division 03',
  },
  {
    number: '04',
    title: 'Moving & Relocation Services',
    slug: '/services/relocation',
    description: 'Specialist IT relocation, laboratory migration, delicate museum archives, commercial office moves, and turnkey logistics.',
    image: '/images/services/image4.jpg',
    badge: 'Division 04',
  },
];
---

<BaseLayout
  title={division?.metaTitle || "Secure Shredding & Document Integrity | Certified Destruction Services | Techsteps"}
  description={division?.metaDescription || "BS EN 15713 accredited secure document shredding, mobile on-site shredding, hard drive destruction, and certified recycling across the UK."}
  hasHeroHeader={true}
>
  <!-- ===== 1. HERO ===== -->
  <PageHero
    breadcrumbs={breadcrumbs}
    bgImage="/images/brand/hero-bg.jpg"
    showDivider={false}
    minHeight="min-h-[480px] sm:min-h-[520px] lg:min-h-[560px]"
    layout="custom"
  >
    <div class="max-w-4xl mx-auto text-center space-y-6">
      <h1 class="font-display text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black text-white tracking-tight leading-[1.08] drop-shadow-2xl">
        {division?.heroTitle || 'Secure Shredding & Destruction Services UK'}
      </h1>

      <p class="text-base sm:text-lg lg:text-xl text-slate-200/90 leading-relaxed max-w-2xl mx-auto font-medium">
        {division?.heroDescription || 'BS EN 15713 accredited on-site mobile shredding, off-site destruction facilities, and certified product disposal ensuring total compliance with UK GDPR and data protection standards.'}
      </p>

      <!-- CTA Buttons (TechSteps Logo Theme Color) -->
      <div class="flex flex-wrap items-center justify-center gap-4 pt-4">
        <a
          href={division?.heroCtaLink || "/contact?service=secure-destruction"}
          class="inline-flex items-center justify-center px-7 py-4 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white font-bold text-sm sm:text-base shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5 border border-emerald-400/30"
        >
          {division?.heroCtaText || 'Talk to a Shredding Specialist'}
        </a>
        <a
          href="#shredding-services"
          class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white font-bold text-sm sm:text-base border border-white/25 hover:border-white transition-all duration-200 backdrop-blur-xs transform hover:-translate-y-0.5"
        >
          Explore Our Services
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </a>
      </div>
    </div>
  </PageHero>

  <!-- ===== 2. INTRODUCTION TO SECURE SHREDDING ===== -->
  <section class="bg-white py-16 lg:py-24 border-b border-slate-200/80 relative overflow-hidden">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left Side: Introduction Content -->
        <div class="lg:col-span-7 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/20 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
            {division?.aboutBadge || 'About Our Service'}
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-display leading-[1.12]">
            {division?.aboutTitle || 'Certified Data Destruction Built for Total Peace of Mind'}
          </h2>

          <div class="space-y-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
            {(division?.aboutParagraphs && division.aboutParagraphs.length > 0) ? (
              division.aboutParagraphs.map(p => <p>{p}</p>)
            ) : (
              <>
                <p>
                  Sensitive business intelligence, financial accounts, personnel records, and discarded hard drives represent severe security risks if disposed of through standard waste streams. Techsteps delivers certified, auditable destruction services that guarantee complete irreversible disposal of physical and digital records.
                </p>
                <p>
                  Whether you require scheduled locked consoles in corporate offices, bulk archive clearances, or mobile cross-cut shredding vehicles operating at your facility under direct observation, our BS 7858 vetted personnel provide an unbroken chain of custody. Every destruction event concludes with a formal Certificate of Destruction.
                </p>
              </>
            )}
          </div>

          <div class="pt-2">
            <a
              href="#specialist-services"
              class="inline-flex items-center gap-2 text-[#0F623A] hover:text-[#0A331E] font-bold text-sm sm:text-base transition-colors group"
            >
              <span>See our four service groups</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right Side: Shredding / Destruction Photo -->
        <div class="lg:col-span-5 relative">
          <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl border border-slate-200/80 bg-slate-100 aspect-[4/3] sm:aspect-[4/3] lg:aspect-[5/4] group">
            <img
              src="/images/services/on-site-shredding.jpg"
              alt="Techsteps Secure Shredding and Destruction Specialist"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none"></div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 2.5 SPECIALIST SERVICES OVERVIEW (4 MAIN SERVICES) ===== -->
  <section id="specialist-services" class="bg-slate-50 py-16 lg:py-24 border-b border-slate-200/80 scroll-mt-20">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/20 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          Core Divisions
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-display">
          Specialist Services for Your Requirements
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
          Explore our four specialist core divisions delivering nationwide compliance, security, and lifecycle management.
        </p>
      </div>

      <!-- 4 Main Services Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {mainServices.map((service) => (
          <div class="group relative flex flex-col justify-between rounded-2xl sm:rounded-3xl overflow-hidden min-h-[420px] sm:min-h-[460px] p-6 shadow-md hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1.5 border border-slate-200/80 bg-slate-900">
            <!-- Background Image & Dark Gradient -->
            <img
              src={service.image}
              alt={service.title}
              class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/60 to-black/30 pointer-events-none"></div>

            <!-- Top Row (Badge + Number) -->
            <div class="relative z-10 flex items-center justify-between w-full">
              <span class="px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/25 text-white text-[11px] font-mono font-bold tracking-widest uppercase shadow-sm">
                {service.badge}
              </span>
              <span class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-md border border-white/25 flex items-center justify-center text-white font-mono text-xs font-bold shadow-sm">
                {service.number}
              </span>
            </div>

            <!-- Bottom Content Area -->
            <div class="relative z-10 flex flex-col justify-end mt-auto pt-12">
              <h3 class="text-xl sm:text-2xl font-bold font-display text-white tracking-tight leading-snug group-hover:text-emerald-400 transition-colors">
                {service.title}
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-slate-200/90 leading-relaxed font-normal">
                {service.description}
              </p>
            </div>
          </div>
        ))}
      </div>

      <!-- Common Navigation Button to Main Service Page -->
      <div class="mt-12 sm:mt-16 text-center">
        <a
          href="/services"
          class="inline-flex items-center justify-center gap-3 px-8 py-4 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white font-bold text-base shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5 border border-emerald-500/30 group"
        >
          <span>Explore All Services</span>
          <svg class="w-5 h-5 transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </Container>
  </section>

  <!-- ===== WHY CERTIFIED SHREDDING MATTERS (GREEN THEME) ===== -->
  <section class="bg-[#0A331E] py-16 sm:py-20 lg:py-24 border-b border-emerald-900/50 relative overflow-hidden">
    <div class="absolute inset-0 bg-radial-[ellipse_at_top_right] from-emerald-500/10 via-transparent to-transparent pointer-events-none"></div>
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Column: Title & Intro -->
        <div class="lg:col-span-5 space-y-5">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-mono font-medium uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Strategic Value
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white tracking-tight font-display leading-[1.12]">
            Why Certified Shredding & Destruction Matters
          </h2>

          <p class="text-base sm:text-lg text-emerald-100/80 leading-relaxed font-normal">
            Guard against data breaches, corporate espionage, and regulatory penalties while driving circular recycling.
          </p>
        </div>

        <!-- Right Column: 2x2 Pillar Grid with Top Dividers -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-10 lg:gap-y-12">
          <!-- Pillar 1: Ensure UK GDPR Compliance -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-lg bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              Ensure UK GDPR Compliance
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              Comply strictly with Data Protection Act 2018 standards, eliminating privacy breach liabilities.
            </p>
          </div>

          <!-- Pillar 2: Irreversible Particle Destruction -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-lg bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <rect x="4" y="4" width="16" height="16" rx="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 9h6v6H9z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 12h5m6 0h5M12 4v5m0 6v5" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              Irreversible Shredding
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              High-torque cross-cut shredders reduce papers, tapes, and hard drives to unrecoverable particles.
            </p>
          </div>

          <!-- Pillar 3: 100% Recycled Paper Stream -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-lg bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              100% Recycled Paper Stream
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              100% of shredded confidential paper is baled and recycled into secondary paper products in UK mills.
            </p>
          </div>

          <!-- Pillar 4: Certified Chain of Custody -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-lg bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              Auditable Certificates
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              Tamper-evident locked consoles and formal Certificates of Destruction provide foolproof audit proof.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== OUR SECURE SHREDDING PROCESS (WORKFLOW) ===== -->
  <section class="bg-white py-16 sm:py-20 lg:py-24 border-b border-slate-200/80 relative overflow-hidden">
    <Container>
      <div class="relative z-10">
        <!-- Section Header -->
        <div class="max-w-3xl mb-12 sm:mb-16">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/20 text-[#0F623A] text-xs font-mono font-medium uppercase tracking-wider mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
            Workflow & Execution
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 tracking-tight font-display">
            Our Secure Destruction Process
          </h2>
          <p class="mt-3 text-base sm:text-lg text-slate-600 font-normal">
            A secure, verifiable 4-step destruction framework engineered to maintain confidentiality from collection to final recycling.
          </p>
        </div>

        <!-- 4-Step Process Flow -->
        <div class="relative">
          <!-- Continuous connecting line on large screens -->
          <div class="hidden lg:block absolute top-[21px] left-6 right-20 h-[2px] bg-slate-200 -z-0"></div>

          <!-- Steps Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-8 relative z-10">
            <!-- Step 1 -->
            <div class="flex flex-col group">
              <div class="mb-5 flex items-center">
                <div class="w-11 h-11 rounded-lg bg-[#0F623A] text-white font-mono font-bold text-sm flex items-center justify-center shadow-lg shadow-[#0F623A]/20 ring-4 ring-white flex-shrink-0 transition-transform duration-300 group-hover:scale-110">
                  01
                </div>
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight leading-snug group-hover:text-[#0F623A] transition-colors">
                Contain & Deposit
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Place confidential documents or digital media into tamper-proof locked office consoles or sacks.
              </p>
            </div>

            <!-- Step 2 -->
            <div class="flex flex-col group">
              <div class="mb-5 flex items-center">
                <div class="w-11 h-11 rounded-lg bg-[#0F623A] text-white font-mono font-bold text-sm flex items-center justify-center shadow-lg shadow-[#0F623A]/20 ring-4 ring-white flex-shrink-0 transition-transform duration-300 group-hover:scale-110">
                  02
                </div>
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight leading-snug group-hover:text-[#0F623A] transition-colors">
                Vetted Collection
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                BS 7858 security-cleared personnel collect and transfer materials under verified custody.
              </p>
            </div>

            <!-- Step 3 -->
            <div class="flex flex-col group">
              <div class="mb-5 flex items-center">
                <div class="w-11 h-11 rounded-lg bg-[#0F623A] text-white font-mono font-bold text-sm flex items-center justify-center shadow-lg shadow-[#0F623A]/20 ring-4 ring-white flex-shrink-0 transition-transform duration-300 group-hover:scale-110">
                  03
                </div>
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight leading-snug group-hover:text-[#0F623A] transition-colors">
                Certified Shredding
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Mobile on-site shredder or secure facility cross-cuts material to BS EN 15713 standards.
              </p>
            </div>

            <!-- Step 4 -->
            <div class="flex flex-col group">
              <div class="mb-5 flex items-center">
                <div class="w-11 h-11 rounded-lg bg-[#0F623A] text-white font-mono font-bold text-sm flex items-center justify-center shadow-lg shadow-[#0F623A]/20 ring-4 ring-white flex-shrink-0 transition-transform duration-300 group-hover:scale-110">
                  04
                </div>
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 tracking-tight leading-snug group-hover:text-[#0F623A] transition-colors">
                Certify & Recycle
              </h3>
              <p class="mt-2.5 text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                Receive serialized Certificate of Destruction while shredded paper and metals are 100% recycled.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== ONE PARTNER FOR DOCUMENT, MEDIA & PRODUCT SHREDDING ===== -->
  <section id="shredding-services" class="bg-white text-[#0A331E] py-16 sm:py-20 lg:py-24 border-b border-slate-200 relative overflow-hidden scroll-mt-20">
    <div class="absolute inset-0 bg-radial-[ellipse_at_top] from-emerald-50/60 via-transparent to-transparent pointer-events-none"></div>
    <Container>
      <!-- Section Heading -->
      <div class="max-w-3xl mb-12 sm:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 border border-emerald-300 text-[#0F623A] text-xs font-mono font-medium uppercase tracking-wider mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          Certified Destruction Solutions
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-[#0A331E] tracking-tight font-display leading-tight">
          One Partner for Document, Media & Commercial Shredding
        </h2>
      </div>

      <!-- Split Card Container -->
      <div class="max-w-5xl mx-auto relative">
        <div class="grid grid-cols-1 md:grid-cols-2 rounded-3xl overflow-hidden shadow-2xl relative border border-emerald-500/20">
          
          <!-- Left Column: Document Shredding Services (Techsteps Green #0F623A) -->
          <div class="bg-[#0F623A] text-white p-8 sm:p-10 lg:p-12 flex flex-col justify-between">
            <div>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight font-display mb-6 pb-2 border-b border-white/20">
                Confidential Paper Shredding
              </h3>
              <div class="space-y-1 font-sans">
                <a
                  href="/services/on-site-shredding"
                  class="flex items-center justify-between py-3.5 border-b border-white/15 font-semibold text-white text-base sm:text-lg hover:translate-x-1.5 hover:text-emerald-200 transition-all duration-200 group"
                >
