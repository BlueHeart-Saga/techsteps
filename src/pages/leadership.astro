---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import CTA from '../components/global/cta.astro';
import { getLeadershipPage } from '../lib/sanity/client';

const leadership = await getLeadershipPage();

const canonicalUrl = 'https://techsteps.co.uk/leadership';

const leadershipPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: leadership?.metaTitle || 'Leadership Team — TechSteps',
  description:
    leadership?.metaDescription ||
    'Meet the people helping TechSteps build a more secure, responsible and sustainable future for technology.',
  mainEntity: {
    '@id': 'https://techsteps.co.uk/#organization',
  },
};

// Default high-calibre editorial leadership profiles
const defaultTeamMembers = [
  {
    role: 'CHIEF EXECUTIVE OFFICER',
    name: 'Executive Leadership',
    bio: 'Driving the vision and long-term direction of TechSteps, with a focus on responsible growth, operational integrity, and enduring customer trust across regulated enterprise sectors.',
    background: 'Technology lifecycle management & corporate governance',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
    imageUrl: '/images/leadership/leader-1.webp',
    imageAlt: 'TechSteps Chief Executive Officer',
  },
  {
    role: 'OPERATIONS DIRECTOR',
    name: 'Operations Leadership',
    bio: 'Leading nationwide high-security logistics, technical facility infrastructure, and certified chain-of-custody protocols to ensure every stage of the technology lifecycle is executed without compromise.',
    background: 'High-security logistics & chain-of-custody operations',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
    imageUrl: '/images/leadership/leader-2.webp',
    imageAlt: 'TechSteps Operations Director',
  },
  {
    role: 'COMMERCIAL DIRECTOR',
    name: 'Commercial Leadership',
    bio: 'Building long-term partnerships with FTSE 250 enterprises, healthcare trusts, and public agencies, developing tailored value recovery frameworks that maximise financial return and ESG impact.',
    background: 'Enterprise IT solutions & ESG partnership strategy',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
    imageUrl: '/images/leadership/leader-3.webp',
    imageAlt: 'TechSteps Commercial Director',
  },
  {
    role: 'HEAD OF SUSTAINABILITY & COMPLIANCE',
    name: 'Compliance Leadership',
    bio: 'Overseeing regulatory compliance, security accreditations (ISO 27001, ADISA, DIN 66399), and certified zero-landfill circular pathways to deliver measurable Scope 3 carbon savings and full audit readiness.',
    background: 'Environmental governance & circular economy standards',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
    imageUrl: '/images/leadership/leader-4.webp',
    imageAlt: 'TechSteps Head of Sustainability & Compliance',
  },
];

// Merge Sanity data with default team members, ensuring all 4 alternating profiles display
const rawMembers = leadership?.team?.members || [];
const teamMembers = defaultTeamMembers.map((defaultMember, idx) => {
  const sanityMember = rawMembers[idx];
  if (!sanityMember) return defaultMember;
  return {
    ...defaultMember,
    ...sanityMember,
    imageUrl: sanityMember.imageUrl || sanityMember.image || defaultMember.imageUrl,
  };
});

// Append any additional members configured in Sanity beyond the first 4
if (rawMembers.length > 4) {
  for (let i = 4; i < rawMembers.length; i++) {
    const sm = rawMembers[i];
    teamMembers.push({
      role: sm.role || 'LEADERSHIP ROLE',
      name: sm.name || 'Leadership Name',
      bio: sm.bio || 'Leading TechSteps with a commitment to security, compliance and customer trust.',
      background: sm.background || '',
      linkedin: sm.linkedin || '',
      imageUrl: sm.imageUrl || sm.image || `/images/leadership/leader-${(i % 4) + 1}.webp`,
      imageAlt: sm.imageAlt || `${sm.name} - ${sm.role}`,
    });
  }
}
---

<BaseLayout
  title={leadership?.metaTitle || "Leadership Team — TechSteps"}
  description={leadership?.metaDescription || "Meet the people helping TechSteps build a more secure, responsible and sustainable future for technology."}
  canonicalUrl={canonicalUrl}
  jsonLd={leadershipPageSchema}
  hasHeroHeader={true}
>
  <HeroHeader isHome={false} />

  <main class="leadership-page bg-white overflow-hidden">

    <!-- ========================================================
         1. HERO SECTION (Spacious Executive Hero)
         ======================================================== -->
    <section class="relative min-h-[460px] sm:min-h-[500px] lg:min-h-[540px] flex items-center bg-[#072415] overflow-hidden">
      <!-- Background Image -->
      <div class="absolute inset-0 z-0">
        <img
          src={leadership?.hero?.imageUrl || "/images/leadership/leadership-hero.png"}
          alt={leadership?.hero?.imageAlt || "TechSteps leadership team"}
          class="w-full h-full object-cover object-center opacity-35 mix-blend-luminosity scale-105 transition-transform duration-1000 ease-out"
          loading="eager"
          fetchpriority="high"
        />
      </div>

      <!-- Multi-Stage Dark Green Gradient Overlay -->
      <div
        class="absolute inset-0 z-[1] bg-gradient-to-r from-[#072415]/95 via-[#0A331E]/85 to-[#0F623A]/40"
        aria-hidden="true"
      ></div>

      <!-- Subtle Accent Glow -->
      <div
        class="absolute -top-32 right-0 w-[500px] h-[500px] bg-[#3FB33D]/10 rounded-full blur-3xl pointer-events-none z-[1]"
        aria-hidden="true"
      ></div>

      <!-- Hero Content Container -->
      <div class="relative z-10 w-full max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24">
        <div class="max-w-3xl space-y-5 sm:space-y-6">
          <!-- Breadcrumb -->
          <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-medium text-slate-300">
            <a href="/" class="text-slate-300 hover:text-[#3FB33D] transition-colors underline-offset-4 hover:underline">
              Home
            </a>
            <span class="text-[#3FB33D] font-bold" aria-hidden="true">›</span>
            <a href="/about-us" class="text-slate-300 hover:text-[#3FB33D] transition-colors underline-offset-4 hover:underline">
              About Us
            </a>
            <span class="text-[#3FB33D] font-bold" aria-hidden="true">›</span>
            <span class="text-white font-semibold">Leadership</span>
          </nav>

          <!-- Eyebrow -->
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-white/10 border border-white/15 backdrop-blur-xs text-xs font-mono font-bold tracking-[0.2em] text-[#3FB33D] uppercase">
            {leadership?.hero?.eyebrow || "OUR LEADERSHIP"}
          </div>

          <!-- Main Heading -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-semibold text-white tracking-tight leading-[1.12] font-display">
            {leadership?.hero?.title && leadership?.hero?.title !== "Leadership with" ? leadership?.hero?.title : "Leadership Team"}
          </h1>

          <!-- Supporting Text -->
          <p class="text-lg sm:text-xl lg:text-[21px] text-slate-200/95 leading-relaxed font-sans font-normal max-w-2xl">
            {leadership?.hero?.subtitle && leadership?.hero?.subtitle !== "Guiding TechSteps with integrity, innovation and a commitment to creating a more responsible technology lifecycle." ? leadership?.hero?.subtitle : "Meet the people helping TechSteps build a more secure, responsible and sustainable future for technology."}
          </p>
        </div>
      </div>
    </section>

    <!-- ========================================================
         2. INTRODUCTION SECTION (Devopstrio-Inspired Editorial Intro)
         ======================================================== -->
    <section class="bg-white py-20 sm:py-24 lg:py-32 border-b border-slate-100">
      <div class="w-full max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-4xl">
          <!-- Section Label -->
          <div class="mb-4">
            <span class="text-xs sm:text-sm font-mono font-bold tracking-[0.2em] uppercase text-[#0F623A]">
              OUR PHILOSOPHY
            </span>
          </div>

          <!-- Editorial Heading -->
          <h2 class="text-3xl sm:text-4xl lg:text-[46px] font-semibold text-slate-900 tracking-tight font-display leading-[1.18] mb-8">
            People. Experience. Purpose.
          </h2>

          <!-- Wide Editorial Supporting Copy -->
          <div class="space-y-6 text-lg sm:text-xl lg:text-[22px] text-slate-700 leading-relaxed font-sans font-normal">
            <p>
              At TechSteps, leadership is built around experience, responsibility and a clear commitment to helping organisations manage technology securely and sustainably.
            </p>
            <p class="text-base sm:text-lg text-slate-600 leading-relaxed pt-2">
              Our team brings together the expertise needed to protect data, recover value from technology and support businesses through every stage of the IT asset lifecycle.
            </p>
          </div>
        </div>
      </div>
    </section>

    <!-- ========================================================
         3. LEADERSHIP PROFILES (Large Editorial Alternating Profiles)
         ======================================================== -->
    <section class="bg-white py-20 sm:py-24 lg:py-32">
      <div class="w-full max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Section Header -->
        <div class="max-w-3xl mb-16 sm:mb-20 lg:mb-24">
          <span class="text-xs sm:text-sm font-mono font-bold tracking-[0.2em] uppercase text-[#0F623A] block mb-3">
            EXECUTIVE LEADERSHIP
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-semibold text-slate-900 tracking-tight font-display leading-[1.15]">
            Experience That Moves Us Forward
          </h2>
          <p class="mt-4 text-lg sm:text-xl text-slate-600 leading-relaxed font-sans">
            Our leadership team brings together experience, expertise and a shared commitment to responsible technology management.
          </p>
        </div>

        <!-- Alternating Profiles Container -->
        <div class="divide-y divide-slate-200/80">
          {teamMembers.map((member, idx) => {
            const isEven = idx % 2 === 0;
            const numberLabel = String(idx + 1).padStart(2, '0');

            return (
              <article class="py-16 sm:py-24 lg:py-28 first:pt-0 last:pb-0">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 xl:gap-20 items-center">

                  {/* Image Column: Large editorial portrait. On mobile, order-1 (always above content). On desktop, alternates! */}
                  <div
                    class={`w-full order-1 ${
                      isEven ? 'lg:col-span-5 xl:col-span-5 lg:order-1' : 'lg:col-span-5 xl:col-span-5 lg:order-2'
                    }`}
                  >
                    <div class="group relative w-full aspect-[4/5] max-h-[580px] rounded-2xl lg:rounded-3xl overflow-hidden bg-slate-100 border border-slate-200/90 shadow-sm hover:shadow-xl transition-all duration-500">
                      <img
                        src={member.imageUrl}
                        alt={member.imageAlt || `${member.name} - ${member.role}`}
                        class="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                        loading="lazy"
                        decoding="async"
                        onerror="this.onerror=null; this.src='/images/leadership/leader-1.webp';"
                      />
                      {/* Subtle Vignette Tint */}
                      <div class="absolute inset-0 bg-gradient-to-t from-black/25 via-transparent to-transparent pointer-events-none" aria-hidden="true"></div>
                      {/* Subtle bottom brand gradient line */}
                      <div class="absolute bottom-0 inset-x-0 h-1.5 bg-gradient-to-r from-[#0F623A] to-[#3FB33D] opacity-80 group-hover:opacity-100 transition-opacity" aria-hidden="true"></div>
                    </div>
                  </div>

                  {/* Information Column: Alternates on desktop, second on mobile */}
                  <div
                    class={`space-y-6 order-2 ${
                      isEven ? 'lg:col-span-7 xl:col-span-7 lg:order-2' : 'lg:col-span-7 xl:col-span-7 lg:order-1'
                    }`}
                  >
                    <!-- Small Number / Label -->
                    <div class="flex items-center gap-3">
                      <span class="font-mono text-xs font-bold text-[#0F623A] tracking-[0.2em] uppercase bg-[#0F623A]/10 px-3.5 py-1.5 rounded-full">
                        {numberLabel}
                      </span>
                      <span class="text-xs font-mono font-bold tracking-[0.2em] uppercase text-slate-400">
                        LEADERSHIP
                      </span>
                    </div>

                    <!-- Leader Name -->
                    <h3 class="text-3xl sm:text-4xl lg:text-[42px] font-semibold text-slate-900 font-display tracking-tight leading-tight">
                      {member.name || "Executive Leadership"}
                    </h3>

                    <!-- Role -->
                    <p class="text-sm sm:text-base font-bold text-[#0F623A] uppercase tracking-wider font-sans">
                      {member.role || "LEADERSHIP ROLE"}
                    </p>

                    <!-- Elegant Green Divider Line -->
                    <div class="w-12 h-0.5 bg-[#3FB33D]" aria-hidden="true"></div>

                    <!-- Short Leadership Statement / Background -->
                    {member.background && (
                      <div class="pl-4 border-l-2 border-[#3FB33D] py-1 my-3 bg-[#0F623A]/[0.02] rounded-r-lg">
                        <p class="text-base sm:text-lg font-medium text-slate-800 leading-snug font-sans">
                          {member.background}
                        </p>
                      </div>
                    )}

                    <!-- Biography Text -->
                    <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal max-w-2xl pt-1">
                      {member.bio || "Leading TechSteps with a commitment to security, compliance and customer trust."}
                    </p>

                    <!-- Optional LinkedIn Link -->
                    {member.linkedin && (
                      <div class="pt-3">
                        <a
                          href={member.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center gap-2.5 px-4 py-2.5 rounded-lg bg-slate-50 hover:bg-[#0F623A]/10 text-slate-700 hover:text-[#0F623A] border border-slate-200 hover:border-[#0F623A]/30 text-xs sm:text-sm font-semibold transition-all duration-200 group font-sans focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
                          aria-label={`Connect with ${member.name} on LinkedIn`}
                        >
                          <svg class="w-4 h-4 text-[#0077B5] fill-current" viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                          </svg>
                          <span>Connect on LinkedIn</span>
                          <svg class="w-3.5 h-3.5 text-slate-400 group-hover:text-[#0F623A] transition-transform duration-200 group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                          </svg>
                        </a>
                      </div>
                    )}
                  </div>

                </div>
              </article>
            );
          })}
        </div>

      </div>
    </section>

    <!-- ========================================================
         4. LEADERSHIP VALUES SECTION (Three Refined Editorial Pillars)
         ======================================================== -->
    <section class="bg-[#F8FAF9] py-20 sm:py-24 lg:py-32 border-t border-b border-slate-200/80">
      <div class="w-full max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Section Heading -->
        <div class="max-w-3xl mb-14 sm:mb-16 lg:mb-20">
          <span class="text-xs sm:text-sm font-mono font-bold tracking-[0.2em] uppercase text-[#0F623A] block mb-3">
            LEADERSHIP PHILOSOPHY
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-semibold text-slate-900 tracking-tight font-display leading-[1.18]">
            Leading With Purpose
          </h2>
          <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans">
            Leading Technology Towards a More Responsible Future — The principles that guide our leadership team in delivering security, recovery, and genuine environmental accountability.
          </p>
        </div>

        <!-- Three Editorial Pillars Grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14">

          <!-- Pillar 1: Security -->
          <div class="space-y-4">
            <div class="h-1 w-12 bg-[#0F623A] mb-6 rounded-full" aria-hidden="true"></div>
            <span class="font-mono text-xs font-bold text-slate-400 tracking-wider">01</span>
            <h3 class="text-2xl sm:text-[26px] font-semibold text-slate-900 font-display tracking-tight leading-snug">
              Security
            </h3>
            <p class="text-base font-semibold text-[#0F623A] font-sans">
              Protecting information and ensuring technology assets are handled responsibly.
            </p>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
              Upholding uncompromised physical chain-of-custody, BS 7858 vetted personnel, and DIN 66399 / NIST 800-88 sanitisation protocols so client information remains secure at every touchpoint.
            </p>
          </div>

          <!-- Pillar 2: Recovery -->
          <div class="space-y-4">
            <div class="h-1 w-12 bg-[#0F623A] mb-6 rounded-full" aria-hidden="true"></div>
            <span class="font-mono text-xs font-bold text-slate-400 tracking-wider">02</span>
            <h3 class="text-2xl sm:text-[26px] font-semibold text-slate-900 font-display tracking-tight leading-snug">
              Recovery
            </h3>
            <p class="text-base font-semibold text-[#0F623A] font-sans">
              Creating greater value from technology through reuse, refurbishment and responsible recovery.
            </p>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
              Applying technical precision to test, refurbish, and remarket enterprise equipment, returning financial capital to client budgets while extending hardware lifecycles.
            </p>
          </div>

          <!-- Pillar 3: Sustainability -->
          <div class="space-y-4">
            <div class="h-1 w-12 bg-[#3FB33D] mb-6 rounded-full" aria-hidden="true"></div>
            <span class="font-mono text-xs font-bold text-slate-400 tracking-wider">03</span>
            <h3 class="text-2xl sm:text-[26px] font-semibold text-slate-900 font-display tracking-tight leading-snug">
              Sustainability
            </h3>
            <p class="text-base font-semibold text-[#0F623A] font-sans">
              Helping businesses reduce unnecessary waste and support a more circular technology lifecycle.
            </p>
            <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
              Operating under strict WEEE directives and Environment Agency AATF licenses to divert 100% of e-waste from landfill and deliver auditable Scope 3 carbon savings.
            </p>
          </div>

        </div>

      </div>
    </section>

    <!-- ========================================================
         5. CLOSING STATEMENT (Spacious & Minimal)
         ======================================================== -->
    <section class="bg-white py-20 sm:py-24 lg:py-32 border-b border-slate-100">
      <div class="w-full max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="max-w-3xl mx-auto space-y-6">
          <span class="text-xs sm:text-sm font-mono font-bold tracking-[0.2em] uppercase text-[#0F623A] block">
            FORWARD-LOOKING LEADERSHIP
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-[46px] font-semibold text-slate-900 tracking-tight font-display leading-[1.2]">
            Building a Better Technology Lifecycle
          </h2>
          <p class="text-base sm:text-lg font-medium text-[#0F623A] font-sans">
            Building the next chapter of responsible technology.
          </p>
          <p class="text-lg sm:text-xl text-slate-600 leading-relaxed font-sans max-w-2xl mx-auto">
            Our leadership team is focused on building trusted partnerships, delivering responsible technology solutions and helping organisations create greater value from every stage of the IT asset lifecycle.
          </p>
        </div>
      </div>
    </section>

  </main>

  <!-- ========================================================
       6. EXISTING CTA (Preserved)
       ======================================================== -->
  <CTA
    title={leadership?.cta?.title || "Let's Build a More Responsible Technology Future"}
    description={leadership?.cta?.description || "Talk to our team about secure, sustainable and responsible IT asset management."}
    primaryText={leadership?.cta?.primaryText || "Talk to Our Team"}
    primaryHref={leadership?.cta?.primaryHref || "/contact"}
    secondaryText={leadership?.cta?.secondaryText || "Request a Collection"}
    secondaryHref={leadership?.cta?.secondaryHref || "/request-a-collection"}
  />
</BaseLayout>