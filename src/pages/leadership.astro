---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import CTA from '../components/global/cta.astro';
import { getLeadershipPage } from '../lib/sanity/client';

const leadership = await getLeadershipPage();
const canonicalUrl = 'https://techsteps.co.uk/leadership';

const leadershipPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: leadership?.metaTitle || 'Leadership & Executive Team — TechSteps UK',
  description:
    leadership?.metaDescription ||
    'Meet the executive leaders, technical directors, and operations specialists driving secure, circular, and certified technology lifecycle management at TechSteps UK.',
  mainEntity: {
    '@id': 'https://techsteps.co.uk/#organization',
  },
};

// 1. Board of Directors (4 Leaders)
const executiveMembers = [
  {
    name: 'John Matthews',
    title: 'Chief Executive Officer',
    kicker: 'CEO & DIRECTOR',
    imageUrl: '/images/leadership/leader-1.webp',
    imageAlt: 'John Matthews — Chief Executive Officer',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Marcus Vance',
    title: 'Operations Director',
    kicker: 'OPERATIONS',
    imageUrl: '/images/leadership/leader-2.webp',
    imageAlt: 'Marcus Vance — Operations Director',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Rachel Thornwood',
    title: 'Commercial Director',
    kicker: 'COMMERCIAL',
    imageUrl: '/images/leadership/leader-3.webp',
    imageAlt: 'Rachel Thornwood — Commercial Director',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Dr. Aris Thorne',
    title: 'Head of Sustainability & Compliance',
    kicker: 'SUSTAINABILITY',
    imageUrl: '/images/leadership/leader-4.webp',
    imageAlt: 'Dr. Aris Thorne — Head of Sustainability & Compliance',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
];

const mappedExecutiveMembers = (leadership?.team?.members && leadership.team.members.length > 0)
  ? leadership.team.members.slice(0, 4).map((m: any, idx: number) => ({
      name: m.name || executiveMembers[idx]?.name,
      title: m.role || m.title || executiveMembers[idx]?.title,
      kicker: m.kicker || executiveMembers[idx]?.kicker || 'EXECUTIVE',
      imageUrl: m.imageUrl || m.image || executiveMembers[idx]?.imageUrl,
      imageAlt: m.imageAlt || m.name || executiveMembers[idx]?.imageAlt,
      linkedin: m.linkedin || executiveMembers[idx]?.linkedin,
    }))
  : executiveMembers;

// 2. Technical & Operations Directors (8 Members)
const operationalMembers = [
  {
    name: 'Liam Gallagher',
    title: 'Fleet & Security Logistics Director',
    kicker: 'SECURE LOGISTICS',
    imageUrl: '/images/leadership/operational-1.jpg',
    imageAlt: 'Liam Gallagher — Fleet & Security Logistics Director',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Tariq Al-Mansoor',
    title: 'Head of Technical Operations',
    kicker: 'DATA SANITISATION',
    imageUrl: '/images/leadership/operational-2.jpg',
    imageAlt: 'Tariq Al-Mansoor — Head of Technical Operations',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Sarah Jenkins',
    title: 'Information Governance Director',
    kicker: 'RECORDS GOVERNANCE',
    imageUrl: '/images/leadership/operational-3.jpg',
    imageAlt: 'Sarah Jenkins — Information Governance Director',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'James Harrison',
    title: 'Enterprise Client Director',
    kicker: 'CLIENT ADVISORY',
    imageUrl: '/images/leadership/operational-4.jpg',
    imageAlt: 'James Harrison — Enterprise Client Director',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Oliver Bailey',
    title: 'Lead Hardware Lifecycle Specialist',
    kicker: 'HARDWARE LIFECYCLE',
    imageUrl: '/images/leadership/operational-5.jpg',
    imageAlt: 'Oliver Bailey — Lead Hardware Lifecycle Specialist',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Megan Ross',
    title: 'Specialist Relocations Lead',
    kicker: 'SITE RELOCATIONS',
    imageUrl: '/images/leadership/operational-6.jpg',
    imageAlt: 'Megan Ross — Specialist Relocations Lead',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Nathan Wright',
    title: 'Head of Secure Storage & Vault Integrity',
    kicker: 'VAULT OPERATIONS',
    imageUrl: '/images/leadership/operational-7.jpg',
    imageAlt: 'Nathan Wright — Head of Secure Storage & Vault Integrity',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Hannah Brooks',
    title: 'Compliance & Chain-of-Custody Auditor',
    kicker: 'AUDIT & COMPLIANCE',
    imageUrl: '/images/leadership/operational-8.jpg',
    imageAlt: 'Hannah Brooks — Compliance & Chain-of-Custody Auditor',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
];

// 3. Regional Hub & On-Site Specialists (8 Members)
const regionalMembers = [
  {
    name: 'Edward Cole',
    title: 'London & South East Hub Director',
    kicker: 'REGIONAL OPERATIONS',
    imageUrl: '/images/testimonials/avatar-5.jpg',
    imageAlt: 'Edward Cole — London Regional Lead',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Amira Patel',
    title: 'Midlands Facility Operations Manager',
    kicker: 'PROCESSING FACILITY',
    imageUrl: '/images/testimonials/avatar-6.jpg',
    imageAlt: 'Amira Patel — Midlands Facility Manager',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Callum Stewart',
    title: 'Northern & Scotland Logistics Lead',
    kicker: 'REGIONAL DISPATCH',
    imageUrl: '/images/about/who-we-are-technician.png',
    imageAlt: 'Callum Stewart — Northern Regional Lead',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Simon Vance',
    title: 'Mobile Destruction Supervisor',
    kicker: 'ON-SITE DESTRUCTION',
    imageUrl: '/images/services/process-step-3-sanitise.jpg',
    imageAlt: 'Simon Vance — Mobile Destruction Supervisor',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Chloe Bennett',
    title: 'Secure Shredding Operations Officer',
    kicker: 'DOCUMENT INTEGRITY',
    imageUrl: '/images/services/secure-shredding-officer.png',
    imageAlt: 'Chloe Bennett — Secure Shredding Operations Officer',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'David Chen',
    title: 'Enterprise ESG & Audit Specialist',
    kicker: 'AUDIT',
    imageUrl: '/images/brand/investors-operations-technician.jpg',
    imageAlt: 'David Chen — Enterprise ESG Specialist',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Kieran Walsh',
    title: 'South West & Wales Regional Lead',
    kicker: 'REGIONAL DISPATCH',
    imageUrl: '/images/services/process-step-4-reuse.jpg',
    imageAlt: 'Kieran Walsh — South West & Wales Regional Lead',
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
  {
    name: 'Grace O\'Connor',
    title: 'Data Centre Decommissioning Lead',
    kicker: 'DATA CENTRE ITAD',
    imageUrl: '/images/services/process-step-6-report.jpg',
    imageAlt: "Grace O'Connor — Data Centre Decommissioning Lead",
    linkedin: 'https://www.linkedin.com/company/techsteps-uk',
  },
];

// All 4 Core Services
const coreServices = [
  {
    title: 'IT Lifecycle & Destruction',
    description: 'Certified ITAD, secure data wiping and sustainable hardware recovery.',
    image: '/images/services/2.webp',
    href: '/services/it-lifecycle',
  },
  {
    title: 'Information Management',
    description: 'Secure document storage, certified scanning and digital archive records.',
    image: '/images/services/1.webp',
    href: '/services/information-management',
  },
  {
    title: 'Secure Shredding',
    description: 'Accredited confidential destruction of sensitive documents and digital media.',
    image: '/images/services/3.webp',
    href: '/services/secure-destruction',
  },
  {
    title: 'Specialist Relocations',
    description: 'Zero-downtime data centre migrations and specialist equipment moves.',
    image: '/images/services/4.webp',
    href: '/services/relocation',
  },
];

// Industry Insights Data
const insights = [
  {
    title: 'How Financial Institutions Achieve FCA-Aligned ITAD Resilience',
    category: 'Finance & Compliance',
    image: '/images/sectors/finance.jpg',
    href: '/insights',
  },
  {
    title: 'The 2026 Guide to Corporate Scope 3 Carbon E-Waste Reduction',
    category: 'Sustainability & ESG',
    image: '/images/services/image3_web.jpg',
    href: '/insights',
  },
  {
    title: 'Why On-Site Shredding Outperforms Off-Site for High-Security Estates',
    category: 'Data Security',
    image: '/images/services/process-step-2-secure.jpg',
    href: '/insights',
  },
];
---

<BaseLayout
  title={leadership?.metaTitle || "Leadership & Executive Team | TechSteps UK"}
  description={leadership?.metaDescription || "Meet the executive leaders, principal directors, and operations specialists driving certified IT lifecycle management, data security, and circular sustainability at TechSteps UK."}
  canonicalUrl={canonicalUrl}
  jsonLd={leadershipPageSchema}
  hasHeroHeader={true}
>
  <HeroHeader isHome={false} />

  <!-- Clean, Unified White Theme Across Entire Page -->
  <main class="min-h-screen bg-white text-slate-900 font-sans overflow-x-hidden selection:bg-[#0F623A] selection:text-white">

    <!-- ========================================================
         1. HERO SECTION (Centered Title + Quote + Compact Image)
         ======================================================== -->
    <section class="relative w-full bg-white select-none pt-6 sm:pt-8 lg:pt-10 pb-0 sm:pb-2">
      <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Top Centered Heading & Quote -->
        <div class="max-w-3xl mx-auto text-center space-y-3 sm:space-y-3.5">
          <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-bold text-slate-900 tracking-tight leading-[1.12]">
            {leadership?.hero?.title ? (
              <span>
                {leadership.hero.title}{' '}
                {leadership.hero.highlightedTitle && (
                  <span class="text-[#0F623A]">{leadership.hero.highlightedTitle}</span>
                )}
              </span>
            ) : (
              <span>
                Leadership &amp; <span class="text-[#0F623A]">Executive Team</span>
              </span>
            )}
          </h1>
          <p class="text-base sm:text-lg text-slate-600 font-normal italic leading-relaxed max-w-2xl mx-auto">
            &ldquo;{leadership?.hero?.subtitle || 'Responsible leadership is measured by the trust we earn, the security we protect, and the sustainable future we help build.'}&rdquo;
          </p>
        </div>

        <!-- Centered Image (Compact Size & Tighter Spacing) -->
        <div class="relative w-full max-w-5xl mx-auto mt-4 sm:mt-5 flex justify-center">
          <img
            src="/images/about/Leadership/hero.png"
            alt="TechSteps UK Leadership & Executive Team"
            class="w-full h-auto object-cover rounded-[16px] block border-none shadow-none"
            width="1672"
            height="941"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </section>

    <!-- ========================================================
         2. TIER 1 — BOARD OF DIRECTORS (4 Leaders)
         ======================================================== -->
    <section id="executive-team" class="relative pt-4 sm:pt-6 pb-8 sm:pb-10 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left relative">

        <div class="mb-5 sm:mb-6">
          <p class="text-xs font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-1">Strategic Governance</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-[#12322C] tracking-tight font-display">
            Board of Directors
          </h2>
        </div>

        <!-- 4-Column Card Grid (4 Cards Per Row on Desktop) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 xl:gap-6 pt-1 pb-4">
          {mappedExecutiveMembers.map((member, idx) => (
            <article class="leadership-card group relative bg-white rounded-[18px] p-3 sm:p-3.5 flex flex-col justify-between text-left overflow-visible">
              
              <!-- 4th Card Top-Right Draw Line Asset (card-righttop.png) -->
              {idx === 3 && (
                <div class="card-corner-accent absolute -top-5 -right-5 sm:-top-6 sm:-right-6 w-14 h-14 sm:w-16 sm:h-16 pointer-events-none select-none z-20" aria-hidden="true">
                  <img
                    src="/images/floating-assets/card-righttop.png"
                    alt=""
                    class="w-full h-full object-contain filter drop-shadow-[0_2px_8px_rgba(15,159,145,0.20)]"
                    loading="lazy"
                  />
                </div>
              )}

              <div>
                <!-- Rounded Image Area (13px radius, tight compact padding) -->
                <div class="relative w-full aspect-[4/3] rounded-[13px] overflow-hidden bg-slate-100 shadow-2xs mb-2">
                  <img
                    src={member.imageUrl}
                    alt={member.imageAlt || member.name}
                    class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </div>

                <!-- Category Kicker (Refined micro size) -->
                <p class="text-[7px] font-bold text-[#0F623A] uppercase tracking-[0.12em] font-mono leading-none whitespace-nowrap">
                  {member.kicker}
                </p>

                <!-- Full Name -->
                <h3 class="text-lg sm:text-[19px] font-bold text-[#12322C] tracking-tight leading-snug font-display mt-0.5 group-hover:text-[#0F623A] transition-colors">
                  {member.name}
                </h3>

                <!-- Designation / Role -->
                <p class="text-xs sm:text-[13px] font-semibold text-slate-600 leading-snug mt-0.5">
                  {member.title}
                </p>
              </div>

              <!-- Bottom CTA Bar (Executive Leadership Only) -->
              <div class="mt-3.5 pt-2.5 border-t border-slate-100 flex items-center justify-between">
                <span class="text-[11px] font-medium text-slate-400">TechSteps UK</span>
                <a
                  href={member.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full border border-slate-200/90 bg-white hover:bg-[#F0FDF4] hover:border-[#0F623A] text-slate-700 hover:text-[#0F623A] transition-all duration-200 text-xs font-semibold shadow-2xs group/btn"
                  aria-label={`Connect with ${member.name} on LinkedIn`}
                >
                  <svg class="w-3.5 h-3.5 fill-current text-[#0A66C2]" viewBox="0 0 24 24">
                    <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                  </svg>
                  <span>Connect</span>
                </a>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- ========================================================
         3. TIER 2 — TECHNICAL & OPERATIONS DIRECTORS (8 Leaders)
         ======================================================== -->
    <section class="relative py-6 sm:py-10 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left relative">

        <div class="mb-5 sm:mb-6">
          <p class="text-xs font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-1">Operations &amp; Security</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-[#12322C] tracking-tight font-display">
            Technical &amp; Operational Leadership
          </h2>
        </div>

        <!-- 4-Column Card Grid (4 Cards Per Row on Desktop) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 xl:gap-6 pt-1 pb-4">
          {operationalMembers.map((member, idx) => (
            <article class="leadership-card group relative bg-white rounded-[18px] p-3 sm:p-3.5 flex flex-col text-left overflow-visible">
              
              <!-- 4th or Last Card Top-Right Draw Line Asset (card-righttop.png) -->
              {((idx + 1) % 4 === 0 || idx === operationalMembers.length - 1) && (
                <div class="card-corner-accent absolute -top-5 -right-5 sm:-top-6 sm:-right-6 w-14 h-14 sm:w-16 sm:h-16 pointer-events-none select-none z-20" aria-hidden="true">
                  <img
                    src="/images/floating-assets/card-righttop.png"
                    alt=""
                    class="w-full h-full object-contain filter drop-shadow-[0_2px_8px_rgba(15,159,145,0.20)]"
                    loading="lazy"
                  />
                </div>
              )}

              <div>
                <!-- Rounded Image Area (13px radius, tight compact padding) -->
                <div class="relative w-full aspect-[4/3] rounded-[13px] overflow-hidden bg-slate-100 shadow-2xs mb-2">
                  <img
                    src={member.imageUrl}
                    alt={member.imageAlt || member.name}
                    class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </div>

                <!-- Category Kicker (Refined micro size) -->
                <p class="text-[7px] font-bold text-[#0F623A] uppercase tracking-[0.12em] font-mono leading-none whitespace-nowrap">
                  {member.kicker}
                </p>

                <!-- Full Name -->
                <h3 class="text-lg sm:text-[19px] font-bold text-[#12322C] tracking-tight leading-snug font-display mt-0.5 group-hover:text-[#0F623A] transition-colors">
                  {member.name}
                </h3>

                <!-- Designation / Role -->
                <p class="text-xs sm:text-[13px] font-semibold text-slate-600 leading-snug mt-0.5">
                  {member.title}
                </p>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- ========================================================
         4. TIER 3 — REGIONAL HUB & ON-SITE SPECIALISTS (8 Specialists)
         ======================================================== -->
    <section class="py-6 sm:py-10 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">

        <div class="mb-3 sm:mb-4">
          <p class="text-xs font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-1">Local Strength · Nationwide Coverage</p>
          <h2 class="text-2xl sm:text-3xl font-bold text-[#12322C] tracking-tight font-display">
            Regional Hub &amp; On-Site Specialists
          </h2>
        </div>

        <!-- 4-Column Card Grid (4 Cards Per Row on Desktop) -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 xl:gap-6 pt-1 pb-4">
          {regionalMembers.map((member, idx) => (
            <article class="leadership-card group relative bg-white rounded-[18px] p-3 sm:p-3.5 flex flex-col text-left overflow-visible">
              
              <!-- 4th or Last Card Top-Right Draw Line Asset (card-righttop.png) -->
              {((idx + 1) % 4 === 0 || idx === regionalMembers.length - 1) && (
                <div class="card-corner-accent absolute -top-5 -right-5 sm:-top-6 sm:-right-6 w-14 h-14 sm:w-16 sm:h-16 pointer-events-none select-none z-20" aria-hidden="true">
                  <img
                    src="/images/floating-assets/card-righttop.png"
                    alt=""
                    class="w-full h-full object-contain filter drop-shadow-[0_2px_8px_rgba(15,159,145,0.20)]"
                    loading="lazy"
                  />
                </div>
              )}

              <div>
                <!-- Rounded Image Area (13px radius, tight compact padding) -->
                <div class="relative w-full aspect-[4/3] rounded-[13px] overflow-hidden bg-slate-100 shadow-2xs mb-2">
                  <img
                    src={member.imageUrl}
                    alt={member.imageAlt || member.name}
                    class="w-full h-full object-cover object-top transition-transform duration-500 ease-out group-hover:scale-[1.03]"
                    loading="lazy"
                  />
                </div>

                <!-- Category Kicker (Refined micro size) -->
                <p class="text-[7px] font-bold text-[#0F623A] uppercase tracking-[0.12em] font-mono leading-none whitespace-nowrap">
                  {member.kicker}
                </p>

                <!-- Full Name -->
                <h3 class="text-lg sm:text-[19px] font-bold text-[#12322C] tracking-tight leading-snug font-display mt-0.5 group-hover:text-[#0F623A] transition-colors">
                  {member.name}
                </h3>

                <!-- Designation / Role -->
                <p class="text-xs sm:text-[13px] font-semibold text-slate-600 leading-snug mt-0.5">
                  {member.title}
                </p>
              </div>
            </article>
          ))}
        </div>

      </div>
    </section>

    <!-- ========================================================
         5. OUR CORE SERVICES (All 4 Specialised Divisions)
         ======================================================== -->
    <section id="core-capabilities" class="py-10 sm:py-14 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-left">

        <div class="mb-8 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
          <div class="relative">
            <div class="relative inline-block">
              <!-- Floating Doodle Accent on Left Corner -->
              <div class="absolute -top-7 -left-8 sm:-top-8 sm:-left-10 w-11 h-11 sm:w-13 sm:h-13 pointer-events-none select-none z-10" aria-hidden="true">
                <img
                  src="/images/floating-assets/card-lefttop.png"
                  alt=""
                  class="w-full h-full object-contain filter drop-shadow-[0_2px_6px_rgba(0,0,0,0.08)]"
                  loading="lazy"
                />
              </div>
              <p class="text-xs sm:text-[13px] font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-1">Our Core Services</p>
            </div>
            <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight font-display">
              Explore what we <span class="text-[#0F623A]">lead</span> and how we <span class="text-[#0F623A]">deliver</span> it
            </h2>
          </div>
          <a
            href="/services"
            class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold text-[#0F623A] hover:text-[#07572F] transition-colors shrink-0 group/link"
          >
            <span>View All Services</span>
            <span class="transition-transform duration-200 group-hover/link:translate-x-1">&rarr;</span>
          </a>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 xl:gap-6">
          {coreServices.map((service) => (
            <div class="group bg-white rounded-[20px] overflow-hidden shadow-[0_4px_20px_rgba(0,0,0,0.04)] hover:shadow-[0_16px_36px_rgba(0,0,0,0.09)] hover:-translate-y-1 transition-all duration-300 flex flex-col justify-between">
              <div>
                <a href={service.href} class="block relative w-full aspect-[16/10] overflow-hidden bg-slate-100">
                  <img
                    src={service.image}
                    alt={service.title}
                    class="w-full h-full object-cover object-center transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                  />
                </a>

                <div class="p-5 sm:p-6 pb-2">
