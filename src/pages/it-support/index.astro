---
/**
 * IT Support Hub Page (src/pages/it-support/index.astro)
 * Complete UK Enterprise IT Support & Managed Services Directory
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTA from '../../components/global/cta.astro';
import { itSupportCategories } from '../../data/itSupportServices';

const hubFaqs = [
  {
    question: "What response times can our organisation expect under your IT support SLA?",
    answer: "We guarantee a 15-minute response SLA for critical Priority-1 incidents affecting operations. Routine technical requests and user guidance are acknowledged and scheduled within 1 to 2 business hours under dedicated service tiers."
  },
  {
    question: "How do your remote and on-site engineering teams coordinate?",
    answer: "Our operations operate on a seamless hybrid escalation model. Immediate diagnostics, software patches, and configurations occur remotely via encrypted sessions. If physical hardware, cabling, or server room interventions are required, certified field engineers dispatch directly from regional UK hubs."
  },
  {
    question: "Which geographical areas across the UK do you support with on-site dispatch?",
    answer: "We provide nationwide UK coverage. We maintain regional engineering hubs across Greater London, the South East, Midlands, North West, Yorkshire, the South West, Wales, and Scotland, guaranteeing prompt on-site attendance with emergency 4-hour dispatch options."
  },
  {
    question: "What certifications and qualifications do TechSteps IT engineers hold?",
    answer: "Our engineers hold industry certifications including Microsoft Certified Solutions Expert (MCSE), Cisco CCNA/CCNP, CompTIA Network+/Security+, and Apple Certified Support Professional (ACSP). Our operations are ISO 27001, ISO 9001, and Cyber Essentials Plus certified."
  },
  {
    question: "Can TechSteps work alongside our existing in-house IT manager or software vendors?",
    answer: "Yes. Many UK organisations use our co-managed IT model to provide specialized Level-2 and Level-3 infrastructure escalation, vacation/sickness cover, and project support, while leaving daily line-of-business software admin with internal staff."
  },
  {
    question: "How does TechSteps handle out-of-hours or weekend emergency outages?",
    answer: "We offer tailored 24/7/365 Network Operations Centre (NOC) monitoring and on-call engineer dispatch for mission-critical operations such as healthcare trusts, legal practices, and high-volume e-commerce clients."
  },
  {
    question: "How do you protect confidential company data during technical interventions?",
    answer: "All remote sessions require explicit user approval and operate over AES 256-bit encrypted channels. TechSteps is certified to ISO 27001 and Cyber Essentials Plus, ensuring strict adherence to UK GDPR and complete audit trails of all system interactions."
  },
  {
    question: "What commercial contract models are available? Are we locked in?",
    answer: "We operate transparent, value-led commercial agreements. You can choose from flexible rolling monthly support agreements, prepaid engineer credit blocks, or customized Annual Maintenance Contracts (AMC) with fixed predictable monthly billing."
  },
  {
    question: "How straightforward is the onboarding process for new corporate clients?",
    answer: "Our structured onboarding takes 3 to 5 business days: we perform a comprehensive non-disruptive infrastructure audit, map all endpoints and network topology, install lightweight monitoring agents, and establish your dedicated support portal credentials."
  },
  {
    question: "Can TechSteps assist with hardware procurement and decommission through certified ITAD?",
    answer: "Yes. As an accredited UK IT Asset Disposition (ITAD) provider, we source new equipment at volume distributor pricing and offset costs by collecting and recycling retired corporate hardware with certified data erasure."
  }
];

const pageTitle = "IT Support & Managed Services | UK Nationwide | TechSteps";
const pageDescription = "Enterprise-grade IT support, proactive helpdesk, hardware maintenance, network engineering & managed IT services across the UK with a 15-minute response SLA.";
const canonicalUrl = "https://techsteps.co.uk/it-support";

const stats = [
  { value: "15 Mins", label: "Remote Response SLA", desc: "Rapid Tier-2 triage for critical tickets" },
  { value: "99.4%", label: "First-Contact Resolution", desc: "Resolved without repeated escalations" },
  { value: "4 Hours", label: "Nationwide Onsite SLA", desc: "Field engineers on-site across the UK" },
  { value: "ISO 27001", label: "Security & Compliance", desc: "Certified UK information security" },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
>
  <!-- =====================================================
       HERO SECTION
  ====================================================== -->
  <section class="relative pt-12 sm:pt-16 pb-16 sm:pb-20 overflow-hidden bg-gradient-to-b from-[#F2F8F5] via-white to-white border-b border-slate-100">
    <Container>
      <div class="max-w-4xl mx-auto text-center">
        <!-- Eyebrow -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-[#EAF5F1] border border-[#07572F]/20 mb-6">
          <span class="w-2 h-2 rounded-full bg-[#07572F] animate-pulse"></span>
          <span class="text-xs font-bold uppercase tracking-wider text-[#07572F]">UK Enterprise IT Support</span>
        </div>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-bold text-slate-900 tracking-tight leading-[1.15] mb-6">
          Proactive IT Support, Managed Helpdesk &amp; Infrastructure Maintenance
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg md:text-xl text-slate-600 leading-relaxed max-w-3xl mx-auto mb-8 font-normal">
          Eliminate workplace downtime with certified UK engineers. From 15-minute remote helpdesk diagnostics to nationwide on-site hardware support and cloud optimization.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
          <a
            href="/request-a-quote?service=it-support"
            class="w-full sm:w-auto inline-flex items-center justify-center h-12 px-7 rounded-[12px] bg-[#07572F] hover:bg-[#054324] text-white font-sans text-[15px] font-semibold tracking-tight transition-all duration-150 shadow-md hover:shadow-lg"
          >
            Request IT Support Quote &rarr;
          </a>
          <a
            href="#categories"
            class="w-full sm:w-auto inline-flex items-center justify-center h-12 px-7 rounded-[12px] border border-slate-300 hover:border-slate-400 bg-white hover:bg-slate-50 text-slate-800 font-sans text-[15px] font-semibold tracking-tight transition-all duration-150"
          >
            Explore 6 Service Categories
          </a>
        </div>

        <!-- Helpline Info -->
        <p class="mt-4 text-xs sm:text-sm text-slate-500">
          Urgent outage? Call our UK technical dispatch desk on <a href="tel:+441784640216" class="font-semibold text-[#07572F] hover:underline">+44 1784 640216</a>
        </p>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 max-w-5xl mx-auto mt-14 pt-10 border-t border-slate-200/80">
        {stats.map((s) => (
          <div class="p-4 sm:p-5 rounded-[16px] bg-white border border-slate-200/70 shadow-xs text-center">
            <div class="text-2xl sm:text-3xl font-extrabold text-[#07572F] tracking-tight">{s.value}</div>
            <div class="text-sm font-semibold text-slate-800 mt-1">{s.label}</div>
            <div class="text-xs text-slate-500 mt-0.5">{s.desc}</div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- =====================================================
       6 CATEGORIES DIRECTORY
  ====================================================== -->
  <section id="categories" class="py-16 sm:py-24 bg-slate-50/50">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-14">
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold text-slate-900 tracking-tight mb-4">
          Complete IT Support Service Directory
        </h2>
        <p class="text-base text-slate-600 leading-relaxed">
          Six specialised technical pillars covering all aspects of enterprise workplace technology, hardware maintenance, network infrastructure, and 24/7 managed operations.
        </p>
      </div>

      <div class="space-y-12">
        {itSupportCategories.map((category, catIndex) => (
          <div class="rounded-[24px] bg-white border border-slate-200/80 p-6 sm:p-8 lg:p-10 shadow-xs">
            <!-- Category Header -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 pb-6 border-b border-slate-100 mb-8">
              <div class="flex items-center gap-3.5">
                <div class="w-12 h-12 rounded-[14px] bg-[#EAF5F1] text-[#07572F] flex items-center justify-center shrink-0">
                  {category.iconName === 'helpdesk' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2zM9 9h6M9 13h4" />
                    </svg>
                  )}
                  {category.iconName === 'office' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                    </svg>
                  )}
                  {category.iconName === 'hardware' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
                    </svg>
                  )}
                  {category.iconName === 'software' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                  )}
                  {category.iconName === 'network' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
                    </svg>
                  )}
                  {category.iconName === 'managed' && (
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  )}
                </div>
                <div>
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-bold text-slate-400">0{catIndex + 1}</span>
                    <h3 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">{category.name}</h3>
                  </div>
                  <p class="text-sm text-slate-500 mt-0.5">{category.description}</p>
                </div>
              </div>

              <a
                href={`/request-a-quote?service=${category.id}`}
                class="self-start md:self-center inline-flex items-center text-xs font-semibold text-[#07572F] hover:text-[#054324] hover:underline"
              >
                Inquire about {category.name} &rarr;
              </a>
            </div>

            <!-- Subservices 4-Card Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
              {category.services.map((subservice) => {
                const href = subservice.customRoute || `/it-support/${subservice.slug}`;

                return (
                  <a
                    href={href}
                    class="group flex flex-col justify-between p-5 rounded-[16px] border border-slate-200/80 hover:border-[#07572F]/50 bg-white hover:bg-[#F8FCFA] transition-all duration-200 shadow-2xs hover:shadow-md"
                  >
                    <div>
                      <div class="flex items-center justify-between mb-2">
                        <span class="text-xs font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-600 group-hover:bg-[#EAF5F1] group-hover:text-[#07572F] transition-colors">
                          {subservice.sla}
                        </span>
                        <span class="text-sm text-[#07572F] opacity-0 group-hover:opacity-100 group-hover:translate-x-1 transition-all">
                          &rarr;
                        </span>
                      </div>
                      <h4 class="text-base font-bold text-slate-900 group-hover:text-[#07572F] transition-colors mb-2">
                        {subservice.name}
                      </h4>
                      <p class="text-xs text-slate-600 leading-relaxed mb-4 line-clamp-3">
                        {subservice.shortDescription}
                      </p>
                    </div>

                    <div class="pt-3 border-t border-slate-100 flex items-center text-xs font-semibold text-[#07572F]">
                      <span>View Service Details</span>
                    </div>
                  </a>
                );
              })}
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- =====================================================
       ENTERPRISE IT SLA GUARANTEE SECTION
  ====================================================== -->
  <section class="py-16 sm:py-20 bg-white border-t border-slate-100">
    <Container>
      <div class="max-w-4xl mx-auto rounded-[24px] bg-[#062C20] text-white p-8 sm:p-12 shadow-xl">
        <div class="text-center max-w-2xl mx-auto mb-10">
          <span class="text-xs font-bold uppercase tracking-wider text-[#2DD4BF] block mb-2">
            The TechSteps Enterprise SLA
          </span>
          <h2 class="text-2xl sm:text-3xl font-bold tracking-tight text-white mb-3">
            Why UK Businesses Rely on TechSteps for IT Support
          </h2>
          <p class="text-sm text-slate-300">
            Predictable response times, dedicated account management, and accredited UK security standards with zero long-term tie-ins.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 text-center">
          <div class="p-5 rounded-[16px] bg-white/5 border border-white/10">
            <div class="text-3xl font-extrabold text-[#2DD4BF] mb-1">15 Mins</div>
            <div class="text-sm font-semibold text-white">Guaranteed Response</div>
            <p class="text-xs text-slate-300 mt-1">Direct contact with a certified engineer, not an unassisted triage queue.</p>
          </div>

          <div class="p-5 rounded-[16px] bg-white/5 border border-white/10">
            <div class="text-3xl font-extrabold text-[#2DD4BF] mb-1">UK Wide</div>
            <div class="text-sm font-semibold text-white">Field Engineers</div>
            <p class="text-xs text-slate-300 mt-1">Satellite-tracked mobile engineering units dispatched for physical repairs.</p>
          </div>

          <div class="p-5 rounded-[16px] bg-white/5 border border-white/10">
            <div class="text-3xl font-extrabold text-[#2DD4BF] mb-1">100%</div>
            <div class="text-sm font-semibold text-white">Certified Team</div>
            <p class="text-xs text-slate-300 mt-1">CompTIA, Microsoft 365, Cisco CCNA, and Cyber Essentials certified professionals.</p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- =====================================================
       FREQUENTLY ASKED QUESTIONS (ACCORDION DESIGN)
  ====================================================== -->
  <FAQSection
    eyebrow="COMMON QUESTIONS"
    title="Frequently Asked Questions About IT Support"
    subtitle="Everything you need to know about our enterprise response SLAs, certified UK engineers, and flexible support agreements."
    faqs={hubFaqs}
    sectionId="it-support-hub-faqs"
  />

  <!-- =====================================================
       GLOBAL CTA COMPONENT
  ====================================================== -->
  <CTA />
</BaseLayout>
