---
export const prerender = true;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/global/HeroHeader.astro';
import CTA from '../../../components/global/cta.astro';
import InteractiveLikeButton from '../../../components/insights/InteractiveLikeButton';
import { insightsApi, isPublishedPost, extractPostId, type Post } from '../../../lib/insightsApi';
import { getSiteSettings } from '../../../lib/sanity/client';
import { generatePostSchema, generateBreadcrumbSchema } from '../../../lib/seo/jsonld';
import { getCategoryHeroImage } from '../../../lib/insightsCategories';

export async function getStaticPaths() {
  let allPosts: Post[] = [];

  try {
    // Fetch all posts with full block content for static generation
    const res = await insightsApi.getAllPosts(100, { includeDetails: true });
    allPosts = (res || []).filter(isPublishedPost);
  } catch (err) {
    console.error('Error fetching posts for getStaticPaths:', err);
  }

  const paths: any[] = [];
  const seenPaths = new Set<string>();

  for (const post of allPosts) {
    const categorySlug = post.category?.slug || 'blogs';
    const primarySlug = post.seoSlug || post.id;

    const pathKey1 = `${categorySlug}/${primarySlug}`;
    if (!seenPaths.has(pathKey1)) {
      seenPaths.add(pathKey1);
      paths.push({
        params: { categorySlug, postId: primarySlug },
        props: { post, allPosts },
      });
    }

    // Also support raw ID if different from seoSlug
    if (post.id && post.id !== primarySlug) {
      const pathKey2 = `${categorySlug}/${post.id}`;
      if (!seenPaths.has(pathKey2)) {
        seenPaths.add(pathKey2);
        paths.push({
          params: { categorySlug, postId: post.id },
          props: { post, allPosts },
        });
      }
    }
  }

  return paths;
}

interface Props {
  post: Post;
  allPosts: Post[];
}

const { post: propPost, allPosts: propAllPosts } = Astro.props;
const { categorySlug: paramCategory, postId: paramPostId } = Astro.params;

let post = propPost;
let allPosts = propAllPosts || [];

// Resilient fallback: If post is missing or missing body content, fetch it live
if (!post || !post.content || !post.rawBlocks || post.rawBlocks.length === 0) {
  const targetId = (post && post.id) || (paramPostId ? extractPostId(paramPostId) : '');
  if (targetId) {
    try {
      const fullPost = await insightsApi.getPostById(targetId);
      if (fullPost) {
        post = fullPost;
      }
    } catch (e) {
      console.error('Failed to fetch full post detail for', targetId, e);
    }
  }
}

// Fallback for allPosts if empty
if (!allPosts || allPosts.length === 0) {
  try {
    allPosts = await insightsApi.getAllPosts(10);
  } catch {
    allPosts = [];
  }
}

if (!post) {
  return Astro.redirect('/insights');
}

const siteSettings = await getSiteSettings();

const categorySlug = post.category?.slug || paramCategory || 'blogs';
const categoryName = post.category?.name || 'Blogs';

const primaryPostSlug = post.seoSlug || post.id;
const canonicalUrl = `https://techsteps.co.uk/insights/${categorySlug}/${primaryPostSlug}`;

const breadcrumbs = [
  { name: 'Insights', url: '/insights' },
  { name: categoryName, url: `/insights/${categorySlug}` },
  { name: post.title, url: `/insights/${categorySlug}/${primaryPostSlug}` },
];

const origin = Astro.site?.origin || 'https://techsteps.co.uk';
const postSchema = generatePostSchema(post, siteSettings, origin);
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs, origin);

// Related posts: prioritize same category, exclude current
const relatedPosts = (allPosts || [])
  .filter((p) => p.id !== post.id)
  .sort((a, b) => {
    if (a.category?.slug === categorySlug && b.category?.slug !== categorySlug) return -1;
    if (b.category?.slug === categorySlug && a.category?.slug !== categorySlug) return 1;
    return 0;
  })
  .slice(0, 3);

// Document attachments
const documents = (post as any).documents || [];

// Fallback illustration artwork if post does not have a custom cover image
const categoryArtwork = getCategoryHeroImage(categorySlug);
const displayCoverImage = post.image || null;

// Markdown / rich content formatter
function formatMarkdown(content: string = ''): string {
  if (!content) return '';

  return content
    // Headings
    .replace(/^### (.*$)/gim, '<h3 class="font-display text-xl sm:text-2xl font-bold text-slate-900 mt-8 mb-4 tracking-tight leading-snug">$1</h3>')
    .replace(/^## (.*$)/gim, '<h2 class="font-display text-2xl sm:text-3xl font-bold text-slate-900 mt-10 mb-5 tracking-tight border-b border-slate-100 pb-3 leading-snug">$1</h2>')
    .replace(/^# (.*$)/gim, '<h2 class="font-display text-2xl sm:text-3xl font-bold text-slate-900 mt-10 mb-5 tracking-tight border-b border-slate-100 pb-3 leading-snug">$1</h2>')
    // Blockquotes
    .replace(/^\> (.*$)/gim, '<blockquote class="border-l-4 border-[#0F623A] bg-emerald-50/50 p-6 rounded-r-2xl my-6 text-base sm:text-lg italic text-slate-800 font-medium leading-relaxed">&ldquo;$1&rdquo;</blockquote>')
    // Images
    .replace(/!\[(.*?)\]\((.*?)\)/gim, '<figure class="my-8 rounded-2xl overflow-hidden border border-slate-200 bg-slate-50"><img src="$2" alt="$1" class="w-full h-auto object-cover block" loading="lazy" /></figure>')
    // Links (avoid matching already processed image markdown)
    .replace(/(?<!\!)\[(.*?)\]\((.*?)\)/gim, '<a href="$2" target="_blank" rel="noopener noreferrer" class="text-[#0F623A] font-semibold underline underline-offset-4 hover:text-[#0c4e2e] transition-colors">$1</a>')
    // Inline code
    .replace(/`([^`]+)`/gim, '<code class="bg-slate-100 text-[#0F623A] px-1.5 py-0.5 rounded text-sm font-mono">$1</code>')
    // Bold / Italic
    .replace(/\*\*(.*?)\*\*/gim, '<strong class="font-bold text-slate-900">$1</strong>')
    .replace(/\*(.*?)\*/gim, '<em class="italic text-slate-800">$1</em>')
    // Unordered lists
    .replace(/^- (.*$)/gim, '<li class="flex items-start gap-3 my-2"><span class="mt-2 h-2 w-2 rounded-full bg-[#0F623A] shrink-0"></span><span class="text-slate-700 leading-relaxed">$1</span></li>')
    // Numbered lists
    .replace(/^([0-9]+)\. (.*$)/gim, '<li class="flex items-start gap-3 my-2"><span class="font-bold text-[#0F623A] text-sm shrink-0">$1.</span><span class="text-slate-700 leading-relaxed">$2</span></li>')
    // Paragraphs & Block grouping
    .split(/\n\n+/)
    .map((block) => {
      const trimmed = block.trim();
      if (!trimmed) return '';
      if (
        trimmed.startsWith('<h1') ||
        trimmed.startsWith('<h2') ||
        trimmed.startsWith('<h3') ||
        trimmed.startsWith('<h4') ||
        trimmed.startsWith('<blockquote') ||
        trimmed.startsWith('<figure') ||
        trimmed.startsWith('<div') ||
        trimmed.startsWith('<ul') ||
        trimmed.startsWith('<ol') ||
        trimmed.startsWith('<li')
      ) {
        if (trimmed.startsWith('<li')) {
          return `<ul class="my-5 pl-1 space-y-1">${trimmed}</ul>`;
        }
        return trimmed;
      }
      return `<p class="text-base sm:text-lg text-slate-700 leading-relaxed mb-6 font-normal">${trimmed}</p>`;
    })
    .join('\n');
}

const renderedHtml = formatMarkdown(post.content || post.excerpt || '');
---

<BaseLayout
  title={`${post.title} | TechSteps Insights`}
  description={post.excerpt || post.subtitle || 'Read verified technical analysis, regulatory briefs, and zero-landfill insights from TechSteps UK.'}
  canonicalUrl={canonicalUrl}
  ogType="article"
  ogImage={displayCoverImage || categoryArtwork}
  jsonLd={[postSchema, breadcrumbSchema]}
  hasHeroHeader={true}
>
  <!-- Top Navigation Header on clean white background (About Us standard) -->
  <HeroHeader isHome={false} />

  <div class="article-page-wrapper bg-white text-slate-900 selection:bg-[#0F623A] selection:text-white">

    <!-- =====================================================
         1. ARTICLE HERO SECTION (About-Us Layout & Fonts)
    ====================================================== -->
    <article
      id="article-detail"
      class="relative w-full bg-white select-none pt-4 sm:pt-6 lg:pt-8 pb-8 sm:pb-12 border-b border-slate-100"
    >
      <div class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-semibold text-slate-600 mb-4 sm:mb-6">
          <a href="/" class="text-slate-600 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
            Home
          </a>
          <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
          <a href="/insights" class="text-slate-600 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
            Insights
          </a>
          <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
          <a href={`/insights/${categorySlug}`} class="text-slate-600 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
            {categoryName}
          </a>
          <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
          <span class="text-slate-900 font-bold truncate max-w-xs">{post.title}</span>
        </nav>

        <!-- Top Metadata & Action Row -->
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <div class="flex flex-wrap items-center gap-3">
            <a
              href={`/insights/${categorySlug}`}
              class="inline-block text-xs font-bold uppercase tracking-[0.14em] text-[#0F623A] bg-[#0F623A]/10 hover:bg-[#0F623A]/20 px-3.5 py-1.5 rounded-full transition-colors"
            >
              {categoryName}
            </a>
            {post.readTime && (
              <>
                <span class="text-slate-300">&bull;</span>
                <span class="text-xs font-semibold text-slate-600">{post.readTime} min read</span>
              </>
            )}
            {post.date && (
              <>
                <span class="text-slate-300">&bull;</span>
                <time class="text-xs font-semibold text-slate-500">{post.date}</time>
              </>
            )}
          </div>

          <!-- Interactive Like Button Island -->
          <div class="shrink-0">
            <InteractiveLikeButton
              client:load
              postId={post.id}
              initialLikes={post.likes || 0}
            />
          </div>
        </div>

        <!-- H1 Title -->
        <h1 class="font-display text-3xl sm:text-4xl lg:text-[46px] font-bold text-slate-900 tracking-tight leading-[1.15] mb-5">
          {post.title}
        </h1>

        <!-- Subtitle / Deck Statement -->
        {post.subtitle && (
          <p class="text-lg sm:text-xl text-slate-600 font-normal italic leading-relaxed mb-6">
            &ldquo;{post.subtitle}&rdquo;
          </p>
        )}

        <!-- Author Attribution Bar -->
        <div class="flex flex-wrap items-center justify-between gap-4 pt-5 border-t border-slate-100">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 flex items-center justify-center font-bold text-[#0F623A] text-sm shrink-0">
              {post.author ? post.author.split(' ').map((n: string) => n[0]).join('').slice(0, 2) : 'TS'}
            </div>
            <div>
              <p class="text-sm font-bold text-slate-900">{post.author || 'TechSteps Advisory Desk'}</p>
              <p class="text-xs text-slate-500">TechSteps IT Lifecycle &amp; Compliance</p>
            </div>
          </div>

          {post.tags && post.tags.length > 0 && (
            <div class="flex flex-wrap gap-1.5">
              {post.tags.slice(0, 4).map((tag: string) => (
                <span class="text-[11px] font-semibold text-slate-600 bg-slate-100 px-2.5 py-0.5 rounded-md">
                  #{tag}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Featured Visual / Artwork Container -->
        <div class="relative w-full max-w-5xl mx-auto mt-8 sm:mt-10 rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-900">
          {displayCoverImage ? (
            <img
              src={displayCoverImage}
              alt={post.title}
              class="w-full max-h-[480px] object-cover block"
              loading="eager"
            />
          ) : (
            <div class="relative w-full aspect-[16/9] max-h-[440px] flex items-center justify-center bg-slate-50 p-6 sm:p-10">
              <img
                src={categoryArtwork}
                alt={`${categoryName} illustration`}
                class="max-h-[360px] w-auto object-contain block"
                loading="eager"
              />
            </div>
          )}
        </div>

      </div>
    </article>

    <!-- =====================================================
         2. ARTICLE CONTENT & METRICS SIDEBAR
    ====================================================== -->
    <section class="py-10 sm:py-14 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">

          <!-- Main Text Column -->
          <main class="lg:col-span-8 min-w-0">
            <!-- Article Body -->
            <div class="article-body prose prose-slate max-w-none">
              <Fragment set:html={renderedHtml} />
            </div>

            <!-- Downloadable Attachments -->
            {documents && documents.length > 0 && (
              <div class="mt-12 bg-slate-50 border border-slate-200 rounded-2xl p-6 sm:p-8">
                <div class="flex items-center gap-3 mb-4">
                  <div class="h-10 w-10 rounded-xl bg-[#0F623A]/10 flex items-center justify-center text-[#0F623A]">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="font-display text-base font-bold text-slate-900">Official Downloadable Documents</h3>
                    <p class="text-xs text-slate-500">Verified cryptographic whitepapers &amp; audit checklists</p>
                  </div>
                </div>

                <div class="space-y-2.5">
                  {documents.map((doc: any) => (
                    <div class="flex items-center justify-between p-3.5 bg-white rounded-xl border border-slate-200">
                      <div class="truncate mr-3">
                        <p class="text-sm font-bold text-slate-900 truncate">{doc.name || 'Technical Document.pdf'}</p>
                        <p class="text-[11px] text-slate-400 font-mono">Official PDF Document &bull; Verified Safe</p>
                      </div>
                      <a
                        href={insightsApi.getDocumentUrl(doc.id || doc.file_id, doc.url)}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="px-4 py-2 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-xs font-bold uppercase tracking-wider shrink-0 transition-colors"
                      >
                        Download &darr;
                      </a>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Bottom Engagement Row -->
            <div class="mt-12 pt-6 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-4 bg-slate-50/70 p-6 rounded-2xl border border-slate-100">
              <div>
                <p class="text-sm font-bold text-slate-900">Was this briefing insightful?</p>
                <p class="text-xs text-slate-500">Save it for your records or share it with your team.</p>
              </div>

              <div class="flex items-center gap-3">
                <InteractiveLikeButton
                  client:load
                  postId={post.id}
                  initialLikes={post.likes || 0}
                />
                <button
                  type="button"
                  id="copy-article-link"
                  class="px-4 py-2 rounded-full border border-slate-200 bg-white text-xs font-bold uppercase tracking-wider text-slate-700 hover:text-slate-900 hover:border-slate-300 shadow-xs cursor-pointer transition-colors"
                >
                  Share / Copy Link
                </button>
              </div>
            </div>

            <!-- Prev / Next Navigation Links -->
            <div class="mt-8 pt-6 border-t border-slate-100 flex items-center justify-between">
              <a
                href={`/insights/${categorySlug}`}
                class="inline-flex items-center gap-2 text-xs font-bold text-[#0F623A] hover:underline uppercase tracking-wider"
              >
                &larr; More {categoryName}
              </a>
              <a
                href="/insights"
                class="inline-flex items-center gap-2 text-xs font-bold text-slate-600 hover:text-slate-900 uppercase tracking-wider"
              >
                All Insights Hub &rarr;
              </a>
            </div>
          </main>

          <!-- Sidebar -->
          <aside class="lg:col-span-4 space-y-6">
            <!-- Author Profile Card -->
            <div class="bg-slate-50/80 rounded-2xl p-6 border border-slate-200/80">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#0F623A] mb-3">
                Author &amp; Advisory Desk
              </p>
              <div class="flex items-center gap-3 mb-3">
                <div class="h-11 w-11 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 flex items-center justify-center font-bold text-[#0F623A] text-sm shrink-0">
                  {post.author ? post.author.split(' ').map((n: string) => n[0]).join('').slice(0, 2) : 'TS'}
                </div>
                <div>
                  <p class="text-sm font-bold text-slate-900">{post.author || 'TechSteps Advisory Desk'}</p>
                  <p class="text-xs text-slate-500">Compliance &amp; ITAD Assurance</p>
                </div>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Specialising in ADISA 8.0 audits, BS 10008 legal admissibility, and zero-landfill electronic lifecycle strategies at TechSteps UK.
              </p>
            </div>

            <!-- Publication Metrics Card -->
            <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-400 mb-3">
                Publication Metadata
              </p>
              <dl class="space-y-2.5 text-xs">
                <div class="flex justify-between py-1.5 border-b border-slate-100">
                  <dt class="text-slate-500">Category</dt>
                  <dd class="font-bold text-[#0F623A]">{categoryName}</dd>
                </div>
                {post.readTime && (
                  <div class="flex justify-between py-1.5 border-b border-slate-100">
                    <dt class="text-slate-500">Reading Time</dt>
                    <dd class="font-mono text-slate-800">{post.readTime} min</dd>
                  </div>
                )}
                {post.date && (
                  <div class="flex justify-between py-1.5 border-b border-slate-100">
                    <dt class="text-slate-500">Published Date</dt>
                    <dd class="font-mono text-slate-800">{post.date}</dd>
                  </div>
                )}
                {typeof post.views === 'number' && post.views > 0 && (
                  <div class="flex justify-between py-1.5 border-b border-slate-100">
                    <dt class="text-slate-500">Total Views</dt>
                    <dd class="font-mono text-slate-800">{post.views}</dd>
                  </div>
                )}
                <div class="flex justify-between py-1.5">
                  <dt class="text-slate-500">Compliance Standard</dt>
                  <dd class="font-bold text-slate-800">ADISA &bull; BS 10008</dd>
                </div>
              </dl>
            </div>

            <!-- Advisory Consultation Card -->
            <div class="bg-[#0F623A] text-white rounded-2xl p-6 shadow-md">
              <p class="text-[10px] font-bold uppercase tracking-widest text-emerald-200 mb-2">
                Specialist Consultation
              </p>
              <h4 class="font-display text-lg font-bold mb-2 leading-snug">
                Need enterprise ITAD or data destruction guidance?
              </h4>
              <p class="text-xs text-emerald-100 leading-relaxed mb-5">
                Connect directly with certified engineers to discuss security classifications, logistics, and audit trails.
              </p>
              <a
                href="/contact"
                class="block text-center py-2.5 px-4 rounded-xl bg-white hover:bg-slate-50 text-[#0F623A] text-xs font-bold uppercase tracking-wider transition-colors shadow-xs"
              >
                Speak to Specialists &rarr;
              </a>
            </div>
          </aside>

        </div>
      </div>
    </section>

    <!-- =====================================================
         3. RELATED INSIGHTS SECTION
    ====================================================== -->
    {relatedPosts.length > 0 && (
      <section class="py-12 sm:py-16 bg-slate-50/70 border-t border-slate-200/80">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-10">
            <div>
              <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-1.5">
                Related Reading
              </p>
              <h2 class="font-display text-2xl sm:text-3xl font-bold text-slate-900 tracking-tight leading-[1.15]">
                More Insights &amp; <span class="text-[#0F623A]">Briefings</span>
              </h2>
            </div>
            <a
              href="/insights"
              class="text-xs font-bold uppercase tracking-wider text-[#0F623A] hover:underline"
            >
              All Publications &rarr;
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
            {relatedPosts.map((rel) => {
              const relCategorySlug = rel.category?.slug || 'blogs';
              const relUrl = `/insights/${relCategorySlug}/${rel.seoSlug || rel.id}`;
              const relArtwork = getCategoryHeroImage(relCategorySlug);

              return (
                <a
                  href={relUrl}
                  class="group bg-white hover:bg-slate-50/50 border border-slate-200/80 hover:border-[#0F623A]/40 rounded-2xl overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between"
                >
                  <div class="relative w-full aspect-[16/10] bg-slate-900 overflow-hidden">
                    {rel.image ? (
                      <img
                        src={rel.image}
                        alt={rel.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    ) : (
                      <img
                        src={relArtwork}
                        alt={rel.title}
                        class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                        loading="lazy"
                      />
                    )}
                    <div class="absolute top-3 left-3 right-3 flex items-center justify-between">
                      <span class="text-[10px] font-bold uppercase tracking-wider text-white bg-black/60 backdrop-blur-sm px-2.5 py-1 rounded-full">
                        {rel.category?.name || 'Insight'}
                      </span>
                      <span class="text-[10px] font-medium text-slate-200 bg-black/60 backdrop-blur-sm px-2.5 py-1 rounded-full">
                        {rel.readTime} min
                      </span>
                    </div>
                  </div>

                  <div class="p-6 flex-1 flex flex-col justify-between">
                    <div>
                      <p class="text-[11px] font-mono text-slate-400 mb-1.5">{rel.date}</p>
                      <h3 class="font-display text-base sm:text-lg font-bold text-slate-900 group-hover:text-[#0F623A] transition-colors leading-snug line-clamp-2 mb-2">
                        {rel.title}
                      </h3>
                      <p class="text-xs sm:text-sm text-slate-600 line-clamp-2 mb-4 leading-relaxed">
                        {rel.excerpt}
                      </p>
                    </div>

                    <div class="pt-3 border-t border-slate-100 flex items-center justify-between text-xs">
                      <span class="text-slate-500 font-semibold">{rel.author}</span>
                      <span class="font-bold text-[#0F623A] flex items-center gap-1">
                        Read &rarr;
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}

    <!-- =====================================================
         4. COMMON TECHSTEPS CTA SECTION
    ====================================================== -->
    <CTA />

  </div>
</BaseLayout>

<script>
  function setupCopyButton() {
    const copyBtn = document.getElementById('copy-article-link');
    if (copyBtn) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(window.location.href);
          const originalText = copyBtn.innerText;
          copyBtn.innerText = 'Copied Link!';
          copyBtn.classList.add('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
          setTimeout(() => {
            copyBtn.innerText = originalText;
            copyBtn.classList.remove('bg-emerald-50', 'text-emerald-700', 'border-emerald-300');
          }, 2500);
        } catch (err) {
          console.error('Failed to copy link:', err);
        }
      });
    }
  }

  setupCopyButton();
  document.addEventListener('astro:page-load', setupCopyButton);
</script>

