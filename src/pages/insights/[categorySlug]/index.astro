---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import HeroHeader from '../../../components/global/HeroHeader.astro';
import CTA from '../../../components/global/cta.astro';
import { insightsApi, isPublishedPost, type Post } from '../../../lib/insightsApi';
import {
  getCategoryHeroImage,
  getCategoryArchiveHeroImage,
  getCategoryDescription,
  formatCategoryTitle,
  type CategoryMeta,
} from '../../../lib/insightsCategories';
import { generateBreadcrumbSchema } from '../../../lib/seo/jsonld';

export async function getStaticPaths() {
  let siteStructure: any[] = [];
  let allPosts: Post[] = [];

  try {
    const [structureRes, postsRes] = await Promise.all([
      insightsApi.getFullSiteStructure(),
      insightsApi.getAllPosts(100),
    ]);
    siteStructure = structureRes || [];
    allPosts = (postsRes || []).filter(isPublishedPost);
  } catch (err) {
    console.error('Error in getStaticPaths for category archive:', err);
  }

  const categoriesMap = new Map<string, CategoryMeta>();

  siteStructure.forEach((sec: any) => {
    (sec.categories || []).forEach((cat: any) => {
      if (cat.slug) {
        categoriesMap.set(cat.slug, {
          name: cat.name || formatCategoryTitle(cat.name, cat.slug),
          slug: cat.slug,
          description: getCategoryDescription(cat.slug, cat.description),
          image: getCategoryHeroImage(cat.slug),
          sectionName: sec.name || 'Insights & Knowledge',
          sectionSlug: sec.slug || 'insights-knowledge',
          count: 0,
        });
      }
    });
  });

  allPosts.forEach((p) => {
    const catSlug = p.category?.slug;
    if (catSlug) {
      if (!categoriesMap.has(catSlug)) {
        categoriesMap.set(catSlug, {
          name: p.category?.name || formatCategoryTitle(p.category?.name, catSlug),
          slug: catSlug,
          description: getCategoryDescription(catSlug),
          image: getCategoryHeroImage(catSlug),
          sectionName: p.section?.name || 'Insights & Knowledge',
          sectionSlug: p.section?.slug || 'insights-knowledge',
          count: 0,
        });
      }
    }
  });

  allPosts.forEach((p) => {
    const catSlug = p.category?.slug;
    if (catSlug && categoriesMap.has(catSlug)) {
      categoriesMap.get(catSlug)!.count += 1;
    }
  });

  const allCategoryList = Array.from(categoriesMap.values());

  return allCategoryList.map((cat) => {
    const categoryPosts = allPosts.filter((p) => {
      const pSlug = (p.category?.slug || '').toLowerCase();
      return pSlug === cat.slug;
    });

    return {
      params: { categorySlug: cat.slug },
      props: {
        category: cat,
        posts: categoryPosts,
        allCategories: allCategoryList,
      },
    };
  });
}

interface Props {
  category: CategoryMeta;
  posts: Post[];
  allCategories: CategoryMeta[];
}

const { category, posts, allCategories } = Astro.props;

const breadcrumbs = [
  { name: 'Insights', url: '/insights' },
  { name: category.name, url: `/insights/${category.slug}` },
];

const origin = Astro.site?.origin || 'https://techsteps.co.uk';
const canonicalUrl = `${origin}/insights/${category.slug}`;
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs, origin);

const heroArtwork = getCategoryArchiveHeroImage(category.slug);
---

<BaseLayout
  title={`${category.name} | TechSteps Insights`}
  description={`Browse verified ${category.name.toLowerCase()} regarding certified IT asset disposition, ADISA 8.0 standards, BS 10008 legal admissibility, and zero-landfill ESG recycling from TechSteps.`}
  canonicalUrl={canonicalUrl}
  jsonLd={[breadcrumbSchema]}
  hasHeroHeader={true}
>
  <HeroHeader isHome={false} />

  <div class="category-page-wrapper bg-white text-slate-900 selection:bg-[#0F623A] selection:text-white">

    <!-- 1. CATEGORY HERO SECTION -->
    <section
      id="category-hero"
      class="relative w-full bg-white select-none pt-4 sm:pt-6 lg:pt-8 pb-2 sm:pb-3"
    >
      <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-semibold text-slate-600 mb-4 sm:mb-5">
          <a href="/" class="text-slate-600 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
            Home
          </a>
          <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
          <a href="/insights" class="text-slate-600 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
            Insights
          </a>
          <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
          <span class="text-slate-900 font-bold">{category.name}</span>
        </nav>

        <!-- Hero Header Content -->
        <div class="max-w-4xl mx-auto text-center space-y-1 sm:space-y-2">
          <div class="inline-flex items-center gap-2 text-xs font-bold text-[#0F623A] uppercase tracking-[0.16em] bg-[#0F623A]/10 px-4 py-1.5 rounded-full">
            <span>{posts.length} {posts.length === 1 ? 'Article' : 'Articles'}</span>
          </div>

          <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-bold text-slate-900 tracking-tight leading-[1.12]">
            {category.name} <span class="text-[#0F623A]">Archive</span>
          </h1>

          <p class="text-base sm:text-lg text-slate-600 font-normal italic leading-relaxed max-w-2xl mx-auto">
            &ldquo;{category.description}&rdquo;
          </p>
        </div>

        <!-- Category Dedicated Illustrated Hero Showcase -->
        <div class="relative w-full max-w-3xl lg:max-w-4xl mx-auto mt-2 sm:mt-3 flex justify-center">
          <div class="w-full flex items-center justify-center">
            <img
              src={heroArtwork}
              alt={`${category.name} illustration`}
              class="w-full max-h-[290px] object-contain block mx-auto transition-transform duration-500 hover:scale-[1.02]"
              width="720"
              height="520"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </div>

      </div>
    </section>

    <!-- 2. CATEGORY POSTS GRID -->
    <section class="py-12 sm:py-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Grid Header -->
        <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 sm:mb-10">
          <div>
            <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-1.5">
              Verified Technical Records
            </p>
            <h2 class="font-display text-2xl sm:text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight leading-[1.15]">
              Articles in <span class="text-[#0F623A]">{category.name}</span>
            </h2>
          </div>

          <div class="flex items-center gap-2">
            <span class="text-xs font-semibold text-slate-600 bg-slate-100 border border-slate-200 px-3.5 py-1.5 rounded-full">
              Showing {posts.length} {posts.length === 1 ? 'record' : 'records'}
            </span>
          </div>
        </div>

        {posts.length > 0 ? (
          <>
            <div id="category-posts-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
              {posts.map((post, index) => {
                const postUrl = `/insights/${category.slug}/${post.seoSlug || post.id}`;
                const fallbackImage = heroArtwork;
                
                const isHidden = index >= 6;

                return (
                  <a
                    href={postUrl}
                    data-index={index}
                    class={`category-post-card group bg-white hover:bg-slate-50/50 border border-slate-200/80 hover:border-[#0F623A]/40 rounded-2xl overflow-hidden shadow-xs hover:shadow-xl transition-all duration-300 flex flex-col justify-between ${isHidden ? 'hidden' : ''}`}
                  >
                    <div class="relative w-full aspect-[16/10] bg-slate-900 overflow-hidden">
                      {post.image ? (
                        <img
                          src={post.image}
                          alt={post.title}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                        />
                      ) : (
                        <img
                          src={fallbackImage}
                          alt={post.title}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                          loading="lazy"
                        />
                      )}

                      <div class="absolute top-3 left-3 right-3 flex items-center justify-between">
                        <span class="text-[11px] font-bold uppercase tracking-wider text-white bg-black/60 backdrop-blur-sm px-2.5 py-1 rounded-full">
                          {category.name}
                        </span>
                        <span class="text-[11px] font-medium text-slate-200 bg-black/60 backdrop-blur-sm px-2.5 py-1 rounded-full">
                          {post.readTime} min
                        </span>
                      </div>

                      {post.date && (
                        <div class="absolute bottom-2.5 left-3 text-[11px] font-semibold text-white/90 bg-black/50 px-2.5 py-0.5 rounded-md backdrop-blur-xs">
                          {post.date}
                        </div>
                      )}
                    </div>

                    <div class="p-6 flex-1 flex flex-col justify-between">
                      <div>
                        <h3 class="font-display text-lg sm:text-xl font-bold text-slate-900 group-hover:text-[#0F623A] transition-colors leading-snug line-clamp-2 mb-2.5">
                          {post.title}
                        </h3>

                        <p class="text-sm text-slate-600 leading-relaxed line-clamp-3 mb-4">
                          {post.excerpt}
                        </p>
                      </div>

                      <div class="mt-4 pt-4 border-t border-slate-100 flex items-center justify-between">
                        <p class="text-xs font-semibold text-slate-700 line-clamp-1">
                          {post.author}
                        </p>

                        <span class="inline-flex items-center gap-1 text-xs font-bold text-[#0F623A] group-hover:gap-2 transition-all">
                          <span>Read</span>
                          <span>&rarr;</span>
                        </span>
                      </div>
                    </div>
                  </a>
                );
              })}
            </div>

            <!-- Load More Button -->
            {posts.length > 6 && (
              <div class="mt-10 text-center" id="load-more-container">
                <button 
                  id="load-more-btn" 
                  class="inline-flex items-center justify-center px-8 py-3.5 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm font-bold uppercase tracking-wider transition-colors shadow-md hover:shadow-lg focus:outline-none focus:ring-2 focus:ring-[#0F623A] focus:ring-offset-2"
                >
                  Load More Articles
                </button>
              </div>
            )}
          </>
        ) : (
          <div class="max-w-xl mx-auto bg-slate-50 rounded-2xl p-8 sm:p-12 border border-slate-200 text-center shadow-xs my-8">
            <div class="h-16 w-16 rounded-full bg-emerald-50 border border-emerald-200 flex items-center justify-center mx-auto mb-4 text-[#0F623A]">
              <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
            </div>
            <h3 class="font-display text-xl sm:text-2xl font-bold text-slate-900 mb-2">
              New {category.name} in Preparation
            </h3>
            <p class="text-sm sm:text-base text-slate-600 mb-6 leading-relaxed">
              Our engineering and compliance team are currently reviewing verified data for this category. Explore our other published insights or contact us directly.
            </p>
            <div class="flex flex-wrap items-center justify-center gap-3">
              <a
                href="/insights"
                class="inline-block px-5 py-2.5 rounded-xl bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold uppercase tracking-wider transition-colors"
              >
                View All Insights
              </a>
              <a
                href="/contact"
                class="inline-block px-5 py-2.5 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-xs font-bold uppercase tracking-wider transition-colors"
              >
                Contact Advisory Team
              </a>
            </div>
          </div>
        )}

      </div>
    </section>

    <!-- 3. EXPLORE TECHSTEPS BY TOPIC -->
    <section id="categories-hub" class="pt-12 pb-12 sm:pb-16 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-10">
          <h2 class="font-display text-3xl sm:text-4xl font-bold text-slate-900 tracking-tight">
            Explore TechSteps by <span class="text-[#0F623A]">Topic</span>
          </h2>
          <p class="text-slate-600 mt-2">
            Browse our resource hubs to find focused intelligence across every facet of technology management.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-6 gap-y-10">
          {allCategories.map((cat) => (
            <a
              href={`/insights/${cat.slug}`}
              class="group flex flex-col items-center text-center bg-transparent border-none"
            >
              <!-- Image -->
              <div class="relative w-full aspect-[4/3] overflow-hidden mb-4 flex items-center justify-center">
                <img
                  src={cat.image}
                  alt={`${cat.name} topic`}
                  class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105"
                  loading="lazy"
                />
              </div>

              <!-- Text Content -->
              <div class="flex flex-col items-center flex-1">
                <h3 class="font-display text-lg font-bold text-slate-900 mb-2 group-hover:text-[#0F623A] transition-colors">
                  {cat.name}
                </h3>
                
                <div class="mt-auto flex items-center justify-center gap-1.5 text-sm font-bold text-[#0F623A]">
                  <span>Explore {cat.name}</span>
                  <span class="group-hover:translate-x-1 transition-transform">&rarr;</span>
                </div>
              </div>
            </a>
          ))}
        </div>

      </div>
    </section>

    <!-- 4. COMMON TECHSTEPS CTA -->
    <CTA />

  </div>
</BaseLayout>

<script is:inline>
  function initCategoryPage() {
    const loadMoreBtn = document.getElementById('load-more-btn');
    const grid = document.getElementById('category-posts-grid');

    if (loadMoreBtn && grid) {
      // Clone button to remove previous event listeners (prevents double firing on Astro navigation)
      const newLoadMoreBtn = loadMoreBtn.cloneNode(true);
      loadMoreBtn.parentNode.replaceChild(newLoadMoreBtn, loadMoreBtn);

      newLoadMoreBtn.addEventListener('click', () => {
        const hiddenCards = grid.querySelectorAll('.category-post-card.hidden');
        
        // Show next 3 hidden cards
        let shownCount = 0;
        for (let i = 0; i < hiddenCards.length; i++) {
          if (shownCount < 3) {
            hiddenCards[i].classList.remove('hidden');
            shownCount++;
          }
        }

        // If no more hidden cards, hide the button
        if (grid.querySelectorAll('.category-post-card.hidden').length === 0) {
          const container = document.getElementById('load-more-container');
          if (container) container.style.display = 'none';
        }
      });
    }
  }

  document.addEventListener('DOMContentLoaded', initCategoryPage);
  document.addEventListener('astro:page-load', initCategoryPage);
</script>