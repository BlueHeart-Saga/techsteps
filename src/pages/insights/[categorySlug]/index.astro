---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/layout/Container.astro';
import PageHero from '../../../components/hero/PageHero.astro';
import { insightsApi, isPublishedPost, type Post } from '../../../lib/insightsApi';
import InlineNewsletter from '../../../components/newsletter/InlineNewsletter';

export async function getStaticPaths() {
  let siteStructure: any[] = [];
  let allPosts: Post[] = [];

  try {
    const [structureRes, postsRes] = await Promise.all([
      insightsApi.getFullSiteStructure(),
      insightsApi.getAllPosts(100),
    ]);
    siteStructure = structureRes || [];
    allPosts = (postsRes || []).filter(isPublishedPost);
  } catch (err) {
    console.error('Error in getStaticPaths for category archive:', err);
  }

  const categoriesMap = new Map<string, any>();

  // Populate directly from live CMS siteStructure
  siteStructure.forEach((sec: any) => {
    (sec.categories || []).forEach((cat: any) => {
      categoriesMap.set(cat.slug, {
        name: cat.name,
        slug: cat.slug,
        description: cat.description || '',
        sectionName: sec.name,
        sectionSlug: sec.slug,
      });
    });
  });

  // Populate from published posts
  allPosts.forEach((p) => {
    if (p.category?.slug && !categoriesMap.has(p.category.slug)) {
      categoriesMap.set(p.category.slug, {
        name: p.category.name,
        slug: p.category.slug,
        sectionName: p.section?.name || 'Knowledge Hub',
        sectionSlug: p.section?.slug || 'insights-knowledge',
      });
    }
  });

  const ALLOWED_SLUGS = new Set(['blogs', 'testimonials', 'impact-metrics', 'impact']);

  // Ensure the 3 core categories are always present
  if (!categoriesMap.has('blogs')) {
    categoriesMap.set('blogs', { name: 'Blogs', slug: 'blogs', description: 'Expert analysis and technical guides.', sectionName: 'Insights & Knowledge' });
  }
  if (!categoriesMap.has('testimonials')) {
    categoriesMap.set('testimonials', { name: 'Testimonials', slug: 'testimonials', description: 'Client reviews and partner endorsements.', sectionName: 'Success Stories' });
  }
  if (!categoriesMap.has('impact-metrics')) {
    categoriesMap.set('impact-metrics', { name: 'Impact Content', slug: 'impact-metrics', description: 'Sustainability metrics and ESG data.', sectionName: 'Success Stories' });
  }
  if (!categoriesMap.has('impact')) {
    categoriesMap.set('impact', { name: 'Impact Content', slug: 'impact', description: 'Sustainability metrics and ESG data.', sectionName: 'Success Stories' });
  }

  const allCategoryList = Array.from(categoriesMap.values()).filter((c) =>
    ALLOWED_SLUGS.has(c.slug)
  );

  return allCategoryList.map((cat) => {
    const categoryPosts = allPosts.filter((p) => {
      const pSlug = (p.category?.slug || 'blogs').toLowerCase();
      return pSlug === cat.slug || (cat.slug === 'impact' && pSlug === 'impact-metrics');
    });

    return {
      params: { categorySlug: cat.slug },
      props: {
        category: cat,
        posts: categoryPosts,
        allCategories: allCategoryList,
      },
    };
  });
}

interface Props {
  category: {
    name: string;
    slug: string;
    description?: string;
    sectionName?: string;
    sectionSlug?: string;
  };
  posts: Post[];
  allCategories: Array<{ name: string; slug: string; sectionName?: string }>;
}

const { category, posts, allCategories } = Astro.props;

const breadcrumbs = [
  { name: 'Insights', url: '/insights' },
  { name: category.name, url: `/insights/${category.slug}` },
];
---

<BaseLayout
  title={`${category.name} | TechSteps Insights & Research Hub`}
  description={`Browse verified ${category.name.toLowerCase()} regarding certified IT asset disposition, ADISA 8.0 standards, BS 10008 legal admissibility, and zero-landfill ESG recycling from TechSteps.`}
  hasHeroHeader={true}
>

  <!-- ===== CATEGORY HERO ===== -->
  <PageHero
    eyebrow={category.sectionName ? `SECTION: ${category.sectionName.toUpperCase()}` : 'INSIGHTS & RESEARCH'}
    title={`${category.name}.`}
    subheading={category.description || `Explore our latest research, verified technical briefs, and analysis filed under ${category.name}.`}
    bgImage="/images/brand/hero-bg.jpg"
    breadcrumbs={breadcrumbs}
    dividerColor="#ffffff"
  >
    <div class="pt-4 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/insights"
        class="inline-flex items-center gap-2 px-5 py-3 rounded-xl bg-white/10 hover:bg-white/20 text-white border border-white/25 text-xs font-bold uppercase tracking-wider backdrop-blur-sm transition-all"
      >
        &larr; Back to All Insights
      </a>
      <span class="inline-flex items-center gap-1.5 px-4 py-3 rounded-xl bg-[#2D6A4F] text-white text-xs font-bold uppercase tracking-wider shadow-sm">
        {posts.length} {posts.length === 1 ? 'Article' : 'Articles'} Found
      </span>
    </div>
  </PageHero>

  <!-- ===== CATEGORY SELECTOR / TABS ===== -->
  <section class="bg-white border-b border-slate-200 sticky top-0 z-30 backdrop-blur-md bg-white/95 shadow-xs">
    <Container>
      <div class="overflow-x-auto scrollbar-hide py-3.5 -mx-4 px-4">
        <div class="flex items-center gap-2 min-w-max">
          <a
            href="/insights"
            class="px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-100 hover:bg-slate-200 text-slate-700 transition-colors shrink-0"
          >
            All Insights
          </a>

          {allCategories.map((c) => {
            const isActive = c.slug === category.slug;
            return (
              <a
                href={`/insights/${c.slug}`}
                class={`px-4 py-2 rounded-full text-xs font-bold uppercase tracking-wider transition-all shrink-0 ${
                  isActive
                    ? 'bg-[#2D6A4F] text-white shadow-xs'
                    : 'bg-slate-50 hover:bg-emerald-50 text-slate-700 hover:text-[#2D6A4F] border border-slate-200 hover:border-emerald-300'
                }`}
              >
                {c.name}
              </a>
            );
          })}
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== POSTS GRID ===== -->
  <section class="bg-[#fafbf9] py-16 lg:py-20 min-h-[500px]">
    <Container>
      {posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {posts.map((post) => (
            <a
              href={`/insights/${category.slug}/${post.seoSlug || post.id}`}
              class="group flex flex-col bg-white rounded-2xl border border-slate-200 hover:border-[#2D6A4F]/50 hover:shadow-xl transition-all duration-300 overflow-hidden"
            >
              <!-- Card visual header -->
              <div class="relative h-48 bg-gradient-to-br from-slate-900 via-[#182f22] to-[#2D6A4F] overflow-hidden flex-shrink-0">
                <div class="absolute inset-0 opacity-15" style="background-image: radial-gradient(circle, #fff 1px, transparent 1px); background-size: 20px 20px;"></div>

                {post.coverImage && (
                  <img
                    src={insightsApi.getImageUrl(post.coverImage)}
                    alt={post.title}
                    class="absolute inset-0 w-full h-full object-cover mix-blend-overlay opacity-50 group-hover:scale-105 transition-transform duration-500"
                  />
                )}

                <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
                  <span class="inline-block text-[10px] font-bold uppercase tracking-widest text-emerald-300 border border-emerald-400/40 bg-black/40 backdrop-blur-xs px-2.5 py-0.5 rounded-full">
                    {category.name}
                  </span>
                  <span class="text-[11px] font-mono text-emerald-200 bg-black/40 px-2.5 py-0.5 rounded-full backdrop-blur-xs">
                    {post.readTime}
                  </span>
                </div>

                <div class="absolute bottom-3 left-4 right-4 flex items-center justify-between text-[11px] text-slate-300">
                  <span>{post.date}</span>
                  <div class="flex items-center gap-3">
                    <span class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-rose-400" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M3.172 5.172a4 4 0 015.656 0L10 6.343l1.172-1.171a4 4 0 115.656 5.656L10 17.657l-6.828-6.829a4 4 0 010-5.656z" clip-rule="evenodd" />
                      </svg>
                      {post.likes || 0}
                    </span>
                    <span class="flex items-center gap-1">
                      <svg class="w-3.5 h-3.5 text-sky-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                      </svg>
                      {post.views || 0}
                    </span>
                  </div>
                </div>
              </div>

              <!-- Card content -->
              <div class="flex-1 flex flex-col p-6">
                <h3 class="text-lg font-bold text-slate-900 group-hover:text-[#2D6A4F] transition-colors leading-snug mb-3 line-clamp-2">
                  {post.title}
                </h3>
                <p class="text-sm text-slate-600 leading-relaxed line-clamp-3 flex-1 mb-4">
                  {post.excerpt}
                </p>

                <div class="mt-auto pt-4 border-t border-slate-100 flex items-center justify-between">
                  <div class="flex items-center gap-2">
                    <div class="h-7 w-7 rounded-full bg-[#2D6A4F]/10 border border-[#2D6A4F]/20 flex items-center justify-center text-[10px] font-bold text-[#2D6A4F]">
                      {post.author.split(' ').map((n: string) => n[0]).join('').slice(0, 2)}
                    </div>
                    <p class="text-xs font-semibold text-slate-700 line-clamp-1">{post.author}</p>
                  </div>
                  <span class="flex items-center gap-1 text-xs font-bold text-[#2D6A4F] group-hover:gap-2 transition-all">
                    Read
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <div class="max-w-xl mx-auto bg-white rounded-3xl p-10 border border-slate-200 text-center shadow-sm">
          <div class="h-16 w-16 rounded-2xl bg-emerald-50 border border-emerald-200/80 flex items-center justify-center mx-auto mb-5 text-[#2D6A4F]">
            <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z" />
            </svg>
          </div>
          <h3 class="text-xl font-bold text-slate-900 mb-2">
            Publications Coming Soon
          </h3>
          <p class="text-sm text-slate-600 mb-8 leading-relaxed">
            Our editorial and technical assurance teams are currently compiling articles and case studies for the <strong class="text-slate-800">{category.name}</strong> category.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
            <a
              href="/insights"
              class="w-full sm:w-auto px-6 py-3 rounded-xl bg-[#2D6A4F] hover:bg-[#245a41] text-white text-xs font-bold uppercase tracking-wider transition-colors"
            >
              Browse All Insights
            </a>
            <a
              href="/contact"
              class="w-full sm:w-auto px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold uppercase tracking-wider transition-colors"
            >
              Request Custom Whitepaper
            </a>
          </div>
        </div>
      )}
    </Container>
  </section>

  <!-- ===== NEWSLETTER CTA ===== -->
  <section class="relative z-10 py-16 lg:py-24 overflow-hidden bg-white border-t border-slate-200">
    <Container className="relative z-10">
      <div class="max-w-2xl mx-auto text-center">
        <span class="inline-block text-xs font-bold tracking-[0.2em] uppercase text-[#2D6A4F] mb-3">
          Updates &amp; Whitepapers
        </span>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-slate-900 mb-3">
          Get notified when new {category.name} are published.
        </h2>
        <p class="text-sm text-slate-600 mb-8">
          Join UK IT directors, compliance officers, and sustainability heads receiving TechSteps quarterly reports.
        </p>
        <InlineNewsletter
          client:visible
          categorySlug={category.slug}
          categoryName={category.name}
          buttonText="Subscribe"
        />
      </div>
    </Container>
  </section>

</BaseLayout>
