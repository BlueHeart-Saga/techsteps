---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import PageHero from '../../components/hero/PageHero.astro';
import { articles } from '../../lib/sanity/data';

const breadcrumbs = [
  { name: 'Insights', url: '/insights' },
];
---

<BaseLayout
  title="Insights, Regulations & Circular Economy Analysis | Techsteps UK"
  description="Stay ahead of UK data protection regulations, WEEE compliance directives, and hardware lifecycle security with expert analysis from Techsteps UK."
  hasHeroHeader={true}
>
  <PageHero
    title="Insights"
    breadcrumbs={breadcrumbs}
    dividerColor="#f1f4ef"
  />

  <Section theme="white">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {articles.map((article) => (
          <article class="group flex flex-col bg-white rounded-2xl border border-slate-200 shadow-xs hover:shadow-xl hover:border-brand-accent/50 transition-all duration-300 overflow-hidden">
            <div class="h-52 relative bg-gradient-to-br from-brand-navy to-slate-900 p-6 flex flex-col justify-between">
              <span class="px-2.5 py-1 rounded-md bg-white/15 backdrop-blur-md text-white text-[11px] font-bold w-fit">
                {article.category}
              </span>
              <div>
                <span class="text-xs text-slate-300 font-mono">{article.publishedDate} &bull; {article.readTime}</span>
              </div>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <h2 class="text-xl font-bold text-brand-navy group-hover:text-brand-accent transition-colors">
                  <a href={`/insights/${article.slug}`}>{article.title}</a>
                </h2>
                <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">
                  {article.summary}
                </p>
              </div>

              <div class="pt-4 border-t border-slate-100 flex items-center justify-between">
                <div class="text-xs text-slate-500">
                  <span class="font-semibold text-slate-800">{article.author}</span> &bull; {article.authorRole}
                </div>
                <a
                  href={`/insights/${article.slug}`}
                  class="text-xs font-bold text-brand-blue group-hover:text-brand-accent flex items-center gap-1"
                >
                  <span>Read Article</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
