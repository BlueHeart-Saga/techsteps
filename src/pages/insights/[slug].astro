---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import HeroHeader from '../../components/global/HeroHeader.astro';
import CTA from '../../components/global/cta.astro';
import { getArticles, getSiteSettings } from '../../lib/sanity/client';
import { generateArticleSchema, generateBreadcrumbSchema } from '../../lib/seo/jsonld';
import type { Article } from '../../lib/sanity/types';
import { getCategoryHeroImage } from '../../lib/insightsCategories';

export async function getStaticPaths() {
  const allArticles = await getArticles();
  return allArticles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

interface Props {
  article: Article;
}

const { article } = Astro.props;
const [articles, siteSettings] = await Promise.all([
  getArticles(),
  getSiteSettings(),
]);

// Related articles: same category or others, excluding current
const relatedArticles = articles
  .filter((a) => a.slug !== article.slug)
  .slice(0, 3);

// Key takeaways: pull first sentence of each paragraph as a summary point
const keyTakeaways = article.content.slice(0, 4).map((p: string) => {
  const firstSentence = p.split('. ')[0];
  return firstSentence.length > 120 ? firstSentence.substring(0, 120) + '…' : firstSentence + '.';
});

const breadcrumbs = [
  { name: 'Insights', url: '/insights' },
  { name: article.title, url: `/insights/${article.slug}` },
];

const articleSchema = generateArticleSchema(article, siteSettings, Astro.site?.origin || 'https://techsteps.co.uk');
const breadcrumbSchema = generateBreadcrumbSchema(breadcrumbs, Astro.site?.origin || 'https://techsteps.co.uk');

// Related service links based on category
const categoryServiceMap: Record<string, { label: string; href: string }[]> = {
  'Regulatory Compliance': [
    { label: 'Simpler Recycling Services', href: '/services/simpler-recycling-services' },
    { label: 'Secure IT Disposal', href: '/services/secure-it-disposal' },
  ],
  'Cyber Security & ITAD': [
    { label: 'Hard Drive Destruction', href: '/services/ultra-secure-hard-drive-destruction' },
    { label: 'ITAD Services', href: '/services/it-asset-disposition-services' },
    { label: 'Secure IT Disposal', href: '/services/secure-it-disposal' },
  ],
};
const relatedServices = categoryServiceMap[article.category] || [
  { label: 'IT Asset Disposition', href: '/services/it-asset-disposition-services' },
  { label: 'Secure IT Disposal', href: '/services/secure-it-disposal' },
];

const categoryArtwork = getCategoryHeroImage(article.category);
---

<BaseLayout
  title={article.metaTitle || `${article.title} | TechSteps Insights`}
  description={article.metaDescription || article.summary}
  ogType="article"
  jsonLd={[articleSchema, breadcrumbSchema]}
  hasHeroHeader={true}
>
  <!-- Top Navigation Header on clean white background (About Us standard) -->
  <HeroHeader isHome={false} />

  <div class="article-page-wrapper bg-white text-slate-900 selection:bg-[#0F623A] selection:text-white">

    <!-- =====================================================
         1. ARTICLE HERO SECTION (About-Us Layout & Fonts)
    ====================================================== -->
    <article
      id="article-detail"
      class="relative w-full bg-white select-none pt-4 sm:pt-6 lg:pt-8 pb-8 sm:pb-12 border-b border-slate-100"
    >
      <div class="relative z-10 w-full max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Breadcrumbs -->
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-semibold text-slate-600 mb-4 sm:mb-6">
          <a href="/" class="text-slate-600 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
            Home
          </a>
          <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
          <a href="/insights" class="text-slate-600 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
            Insights
          </a>
          <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
          <span class="text-slate-900 font-bold truncate max-w-xs">{article.title}</span>
        </nav>

        <!-- Top Meta Row -->
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <span class="inline-block text-xs font-bold uppercase tracking-[0.14em] text-[#0F623A] bg-[#0F623A]/10 px-3.5 py-1.5 rounded-full">
            {article.category}
          </span>
          <span class="text-slate-300">&bull;</span>
          <span class="text-xs font-semibold text-slate-600">{article.readTime}</span>
          <span class="text-slate-300">&bull;</span>
          <time class="text-xs font-semibold text-slate-500 font-mono" datetime={article.publishedDate}>{article.publishedDate}</time>
        </div>

        <!-- H1 Title -->
        <h1 class="font-display text-3xl sm:text-4xl lg:text-[46px] font-bold text-slate-900 tracking-tight leading-[1.15] mb-5">
          {article.title}
        </h1>

        <!-- Summary / Deck -->
        <p class="text-lg sm:text-xl text-slate-600 font-normal italic leading-relaxed mb-6">
          &ldquo;{article.summary}&rdquo;
        </p>

        <!-- Author Row -->
        <div class="flex items-center gap-3.5 pt-5 border-t border-slate-100">
          <div class="h-10 w-10 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 flex items-center justify-center font-bold text-[#0F623A] text-sm shrink-0">
            {article.author.split(' ').map((n: string) => n[0]).join('')}
          </div>
          <div>
            <p class="text-sm font-bold text-slate-900">{article.author}</p>
            <p class="text-xs text-slate-500">{article.authorRole} &bull; TechSteps Advisory</p>
          </div>
        </div>

        <!-- Featured Artwork -->
        <div class="relative w-full max-w-5xl mx-auto mt-8 sm:mt-10 rounded-2xl overflow-hidden border border-slate-200 shadow-sm bg-slate-50 p-6 sm:p-10 flex items-center justify-center">
          <img
            src={categoryArtwork}
            alt={`${article.category} illustration`}
            class="max-h-[360px] w-auto object-contain block"
            loading="eager"
          />
        </div>

      </div>
    </article>

    <!-- =====================================================
         2. ARTICLE CONTENT
    ====================================================== -->
    <section class="py-10 sm:py-14 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-start">

          <!-- Main Content Column -->
          <main class="lg:col-span-8 min-w-0">
            <div class="space-y-6">
              {article.content.map((paragraph: string, i: number) => (
                <p class={`leading-relaxed text-slate-700 ${i === 0 ? 'text-lg sm:text-xl font-medium text-slate-800' : 'text-base sm:text-lg'}`}>
                  {paragraph}
                </p>
              ))}
            </div>

            <!-- Key Takeaways -->
            <div class="mt-12 bg-slate-50 border border-slate-200/90 rounded-2xl p-6 sm:p-8">
              <div class="flex items-center gap-3 mb-4">
                <div class="h-9 w-9 rounded-xl bg-[#0F623A]/10 flex items-center justify-center text-[#0F623A]">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </div>
                <h2 class="font-display text-base font-bold text-slate-900 uppercase tracking-wider">Key Takeaways</h2>
              </div>
              <ul class="space-y-3">
                {keyTakeaways.map((point: string) => (
                  <li class="flex items-start gap-3">
                    <span class="mt-2 h-2 w-2 rounded-full bg-[#0F623A] shrink-0"></span>
                    <p class="text-sm sm:text-base text-slate-700 leading-relaxed">{point}</p>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Internal Service Links -->
            <div class="mt-10 pt-8 border-t border-slate-100">
              <p class="text-xs font-bold uppercase tracking-[0.15em] text-[#0F623A] mb-3">Related TechSteps Services</p>
              <div class="flex flex-wrap gap-2">
                {relatedServices.map((svc) => (
                  <a
                    href={svc.href}
                    class="inline-flex items-center gap-1.5 px-4 py-2 rounded-full border border-slate-200 text-xs font-bold uppercase tracking-wider text-slate-700 hover:border-[#0F623A] hover:text-[#0F623A] hover:bg-emerald-50/50 transition-all duration-200"
                  >
                    <span>{svc.label}</span>
                    <span>&rarr;</span>
                  </a>
                ))}
              </div>
            </div>

            <!-- Navigation Links -->
            <div class="mt-10 pt-6 border-t border-slate-100 flex items-center justify-between">
              <a
                href="/insights"
                class="inline-flex items-center gap-2 text-xs font-bold text-[#0F623A] hover:underline uppercase tracking-wider"
              >
                &larr; All Insights
              </a>
              <a
                href="/contact"
                class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-xs font-bold uppercase tracking-wider transition-colors shadow-xs"
              >
                Speak to Our Team &rarr;
              </a>
            </div>
          </main>

          <!-- Sidebar -->
          <aside class="lg:col-span-4 space-y-6">
            <div class="bg-slate-50/80 rounded-2xl p-6 border border-slate-200/80">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[#0F623A] mb-3">Author Profile</p>
              <div class="flex items-center gap-3 mb-3">
                <div class="h-10 w-10 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 flex items-center justify-center font-bold text-[#0F623A] text-sm shrink-0">
                  {article.author.split(' ').map((n: string) => n[0]).join('')}
                </div>
                <div>
                  <p class="text-sm font-bold text-slate-900">{article.author}</p>
                  <p class="text-xs text-slate-500">{article.authorRole}</p>
                </div>
              </div>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed">
                Expert in information security and technology lifecycle compliance at TechSteps UK.
              </p>
            </div>

            <div class="bg-white rounded-2xl p-6 border border-slate-200/80 shadow-xs">
              <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-slate-400 mb-3">Article Details</p>
              <dl class="space-y-2.5 text-xs">
                <div class="flex justify-between py-1.5 border-b border-slate-100">
                  <dt class="text-slate-500">Category</dt>
                  <dd class="font-bold text-[#0F623A]">{article.category}</dd>
                </div>
                <div class="flex justify-between py-1.5 border-b border-slate-100">
                  <dt class="text-slate-500">Published</dt>
                  <dd class="font-mono text-slate-700">{article.publishedDate}</dd>
                </div>
                <div class="flex justify-between py-1.5">
                  <dt class="text-slate-500">Read Time</dt>
                  <dd class="font-mono text-slate-700">{article.readTime}</dd>
                </div>
              </dl>
            </div>

            <div class="bg-[#0F623A] text-white rounded-2xl p-6 shadow-md">
              <p class="text-[10px] font-bold uppercase tracking-widest text-emerald-200 mb-2">Need Expert Help?</p>
              <h4 class="font-display text-lg font-bold mb-2 leading-snug">Talk to our team about compliance &amp; asset disposition.</h4>
              <p class="text-xs text-emerald-100 leading-relaxed mb-5">We partner with businesses to securely manage retired technology.</p>
              <a
                href="/contact"
                class="block text-center py-2.5 px-4 rounded-xl bg-white hover:bg-slate-50 text-[#0F623A] text-xs font-bold uppercase tracking-wider transition-colors shadow-xs"
              >
                Contact Us &rarr;
              </a>
            </div>
          </aside>

        </div>
      </div>
    </section>

    <!-- =====================================================
         3. COMMON TECHSTEPS CTA
    ====================================================== -->
    <CTA />

  </div>
</BaseLayout>
