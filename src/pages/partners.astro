    badge: 'BSI Verified',
  },
  {
    name: 'Crown Commercial Service',
    category: 'Public Sector Frameworks',
    authority: 'Cabinet Office',
    logo: '/images/certifications/crown-commercial.png',
    desc: 'Approved supplier across UK public procurement alliances, enabling direct, compliant engagement for NHS trusts and central government.',
    quote: 'Pre-approved public sector supplier status facilitating compliant, competitive asset management for UK public bodies.',
    badge: 'CCS Approved',
  },
  {
    name: 'NHS IG Toolkit / DSPT',
    category: 'Healthcare Governance',
    authority: 'NHS England & Caldicott',
    logo: '/images/certifications/nhs.png',
    desc: 'Full compliance with the NHS Data Security & Protection Toolkit, ensuring Caldicott Guardian principles and clinical data disposal.',
    quote: 'Exceeding NHS Data Security & Protection Toolkit standards, safeguarding sensitive clinical patient archives.',
    badge: 'DSPT Standards Met',
  },
  {
    name: 'EcoVadis Sustainability',
    category: 'ESG Assessment',
    authority: 'Global ESG Platform',
    logo: '/images/certifications/ecovadis.png',
    desc: 'Collaborative corporate network benchmarking corporate social responsibility, carbon reduction initiatives, and circular supply chains.',
    quote: 'Independently audited ESG performance validating circular economy workflows and sustainable supply chain procurement.',
    badge: 'ESG Audited',
  },
  {
    name: 'National Cyber Security Centre',
    category: 'Government Cyber Resilience',
    authority: 'NCSC Technical Standard',
    logo: '/images/certifications/cas-sanitisation.jpg',
    desc: 'Commercial service certification for the sanitisation of sensitive government media and cryptographic data destruction.',
    quote: 'Government-grade cryptographic erasure and physical media sanitisation conforming to national cyber defence benchmarks.',
    badge: 'CAS Certified',
  },
  {
    name: 'Cyber Essentials Plus',
    category: 'Cyber Defence',
    authority: 'UK Gov. Assured',
    logo: '/images/certifications/cyber-essentials-plus.png',
    desc: 'Hands-on technical verification defending our operational infrastructure and client custody registers against advanced cyber threats.',
    quote: 'Technical audit verification ensuring resilient defences against internet-borne vulnerabilities across all operational systems.',
    badge: 'Gov.UK Assured',
  },
  {
    name: 'ADISA Industry Alliance',
    category: 'ITAD Forensic Security',
    authority: 'ADISA Asset Disposal',
    logo: '/images/certifications/bs-7858.png',
    desc: 'Adherence to forensic data sanitisation standards, unannounced operational audits, and defensible custody tracking.',
    quote: 'Unannounced operational audits and forensic data security benchmarks ensuring industry-leading ITAD chain of custody.',
    badge: 'Forensic Standard',
  },
  {
    name: 'PCI Security Standards',
    category: 'Payment Hardware Security',
    authority: 'PCI Standards Council',
    logo: '/images/certifications/pci-dss.png',
    desc: 'Payment Card Industry alignment ensuring financial hardware destruction exceeds strict banking criteria.',
    quote: 'Stringent cardholder data hardware destruction protocols meeting and exceeding global financial institution criteria.',
    badge: 'Level 1 Criteria',
  },
  {
    name: 'Diamond Industry Membership',
    category: 'Commercial Logistics & ITAD',
    authority: 'Industry Association',
    logo: '/images/certifications/diamond-member.png',
    desc: 'Premier industry association tier recognising ongoing contributions to UK technology recycling, data protection, and circular innovation.',
    quote: 'Premier commercial relocation and recycling standards ensuring safe, GPS-tracked transportation of corporate IT estates.',
    badge: 'Premier Tier',
  },
  {
    name: 'King’s Award for Enterprise',
    category: 'Enterprise Honours',
    authority: 'Royal Enterprise Award',
    logo: '/images/certifications/kings-award.jpg',
    desc: 'Prestigious royal recognition honoring outstanding contribution to sustainable development and circular innovation.',
    quote: 'Prestigious corporate honour celebrating enterprise leadership in sustainable innovation and circular economy advancement.',
    badge: 'Sustainable Dev.',
  },
];

const reviewSlides = [
  // Slide 1 (Cards 1, 2, 3)
  [
    {
      quote:
        'TechSteps’ certified chain of custody and serialized destruction reports gave our board total legal confidence during our multi-site data center refresh.',
      role: 'Chief Information Security Officer',
      industry: 'Banking & Finance',
    },
    {
      quote:
        'Security-vetted logistics crews and GPS-tracked lockable vehicles made our nationwide asset collection effortless, auditable, and entirely zero-incident.',
      role: 'VP of IT Infrastructure',
      industry: 'Enterprise Cloud',
    },
    {
      quote:
        'PCI DSS compliant storage and automated Blancco erasure integration allow our DevOps pods to decommission server clusters with zero security friction.',
      role: 'Chief Technology Officer',
      industry: 'Fintech & Payments',
    },
  ],
  // Slide 2 (Cards 4, 5, 6)
  [
    {
      quote:
        'Their zero-to-landfill guarantee and transparent Scope 3 carbon savings reporting directly accelerate our annual ESG disclosure and sustainability goals.',
      role: 'Head of Sustainability & ESG',
      industry: 'FTSE 100 Retail',
    },
    {
      quote:
        'Strict adherence to NHS IG Toolkit and Caldicott principles ensured patient record hardware and clinical telemetry systems were decommissioned with flawless compliance.',
      role: 'Director of Information Governance',
      industry: 'Healthcare & NHS',
    },
    {
      quote:
        'With multi-million-pound GDPR liabilities on client archives, TechSteps’ tamper-proof erasure certificates and BS EN 15713 physical shredding provide absolute certainty.',
      role: 'General Counsel & Head of Risk',
      industry: 'Legal & Corporate',
    },
  ],
  // Slide 3 (Cards 7, 8, 9)
  [
    {
      quote:
        'Managing estate-wide laptop and workstation turnover across 40 UK locations was simplified by TechSteps’ online asset portal and serialized consignment manifests.',
      role: 'Head of Enterprise Workplace Tech',
      industry: 'Global Consulting',
    },
    {
      quote:
        'TechSteps delivered complete circular remarketing rebates for retired mobile and desktop hardware while maintaining uncompromised data sanitisation standards.',
      role: 'Director of Procurement & Supply Chain',
      industry: 'Telecommunications',
    },
    {
      quote:
        'Strict 5-year BS 7858 vetted personnel and dual-custody verification protocols provide complete compliance assurance for our sensitive operational hardware.',
      role: 'Head of Security Operations',
      industry: 'Aerospace & Defence',
    },
  ],
];
---

<BaseLayout
  title="Partners & Associations — TechSteps UK"
  description="Explore TechSteps strategic technology partners, industry associations, and public framework memberships driving responsible IT asset management across the UK."
  canonicalUrl={canonicalUrl}
  jsonLd={pageSchema}
  hasHeroHeader={true}
>
  <!-- Top Navigation Header on clean white background -->
  <HeroHeader isHome={false} />

  <div class="partners-page-wrapper bg-white text-slate-900 selection:bg-[#0F623A] selection:text-white">

    <!-- =====================================================
         1. HERO SECTION (Ref: About Us Centered Title + Quote + Showcase Card)
    ====================================================== -->
    <section
      id="partners-hero"
      class="relative w-full bg-white select-none pt-6 sm:pt-8 lg:pt-10 pb-4 sm:pb-6"
    >
      <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Top Centered Heading & Quote (Matching About Us Hero Typography) -->
        <div class="max-w-4xl lg:max-w-5xl mx-auto text-center space-y-3 sm:space-y-3.5">
          <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[46px] xl:text-[50px] font-bold text-slate-900 tracking-tight leading-[1.14] lg:whitespace-nowrap">
            Growing Stronger Together with <span class="text-[#0F623A]">Trusted Partners</span>
          </h1>
          <p class="text-base sm:text-lg text-slate-600 font-normal italic leading-relaxed max-w-2xl mx-auto">
            &ldquo;Collaborating with world-class technology providers, statutory regulators, and premier industry bodies — delivering unassailable data security, audited compliance, and verifiable circular economy outcomes across the UK.&rdquo;
          </p>
        </div>

        <!-- Centered Image (Matching About Us Hero Visual Style) -->
        <div class="relative w-full max-w-4xl lg:max-w-5xl mx-auto mt-4 sm:mt-5 flex justify-center">
          <img
            src="/images/about/certificates/partner-hero.png"
            alt="TechSteps collaborative partnerships with technology providers, regulators, and industry alliances"
            class="w-full h-auto object-contain block border-none shadow-none"
            width="1916"
            height="821"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </section>


    <!-- =====================================================
         2. SECTION 2 — EDITORIAL SPLIT: COLLABORATIVE EXCELLENCE & TRUST
         (Ref: About Us Section 3 "Nationwide network, local expertise")
    ====================================================== -->
    <section id="partnership-rigor" class="bg-white py-10 sm:py-14 lg:py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

          <!-- Left Column: Simple Feel-Good Message -->
          <div class="lg:col-span-7">
            <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-2 sm:mb-3">
              Trust &amp; Collaboration
            </p>
            <h2 class="text-3xl sm:text-4xl lg:text-[46px] font-bold text-slate-900 tracking-tight font-display leading-[1.14]">
              Collaborative Excellence, <span class="text-[#0F623A]">Complete Enterprise Trust</span>
            </h2>

            <p class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-700 font-medium leading-relaxed max-w-none">
              We believe great partnerships drive lasting impact. By embedding market-leading data sanitisation software, statutory environmental licensing, and verified public frameworks directly into our workflow, we ensure your IT assets are managed with bulletproof security and circular sustainability.
            </p>

            <div class="mt-6 sm:mt-8 space-y-3.5">
              <div class="flex items-center gap-3">
                <div class="w-6 h-6 rounded-full bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center shrink-0 text-xs font-bold">
                  ✓
                </div>
                <span class="text-base font-medium text-slate-800">
                  Certified Technology Alliances with Industry Leaders (Blancco, ADISA, NCSC)
                </span>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-6 h-6 rounded-full bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center shrink-0 text-xs font-bold">
                  ✓
                </div>
                <span class="text-base font-medium text-slate-800">
                  Direct Statutory Environmental Licences with the UK Environment Agency
                </span>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-6 h-6 rounded-full bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center shrink-0 text-xs font-bold">
                  ✓
                </div>
                <span class="text-base font-medium text-slate-800">
                  Pre-Approved Public Procurement Framework Access (Crown Commercial &amp; NHS DSPT)
                </span>
              </div>
            </div>
          </div>

          <!-- Right Column: Full Image (image.png - No Wrap, No Borderlines) -->
          <div class="lg:col-span-5 flex justify-center lg:justify-end">
            <img
              src="/images/about/certificates/image.png"
              alt="TechSteps collaborative partnerships and circular economy alliances"
              class="w-full max-w-xs sm:max-w-sm lg:max-w-[360px] h-auto object-contain block border-none shadow-none"
              width="600"
              height="800"
              loading="lazy"
            />
          </div>

        </div>
      </div>
    </section>


    <!-- =====================================================
         3. SECTION 3 — ANIMATED STATS STRIP (Ref: About Us Section 5)
    ====================================================== -->
    <section class="bg-white py-8 sm:py-10 select-none">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          id="stats-counter-block"
          class="flex flex-wrap items-center justify-between gap-6 sm:gap-8 lg:gap-10 text-center"
        >
          <!-- Metric 1 -->
          <div class="stat-item flex-1 min-w-[140px] sm:min-w-0">
            <span
              class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
            >
              25+
            </span>
            <span class="block mt-2 text-sm sm:text-base font-medium text-slate-700">
              Strategic Alliances
            </span>
          </div>

          <div class="hidden sm:block w-px h-10 bg-slate-200" aria-hidden="true"></div>

          <!-- Metric 2 -->
          <div class="stat-item flex-1 min-w-[140px] sm:min-w-0">
            <span
              class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
            >
              100%
            </span>
            <span class="block mt-2 text-sm sm:text-base font-medium text-slate-700">
              Audit-Ready Documentation
            </span>
          </div>

          <div class="hidden sm:block w-px h-10 bg-slate-200" aria-hidden="true"></div>

          <!-- Metric 3 -->
          <div class="stat-item flex-1 min-w-[140px] sm:min-w-0">
            <span
              class="block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none"
            >
              BS 7858
            </span>
            <span class="block mt-2 text-sm sm:text-base font-medium text-slate-700">
              Security-Vetted Personnel
            </span>
          </div>

          <div class="hidden sm:block w-px h-10 bg-slate-200" aria-hidden="true"></div>

          <!-- Metric 4 -->
          <div class="stat-item flex-1 min-w-[140px] sm:min-w-0">
            <span
              class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
            >
              0%
            </span>
            <span class="block mt-2 text-sm sm:text-base font-medium text-slate-700">
              Landfill (100% Diversion)
            </span>
          </div>
        </div>
      </div>
    </section>


    <!-- =====================================================
         4. SECTION 4 — OUR PARTNERSHIP ECOSYSTEM (ITAD Focused 4 Capability Cards)
    ====================================================== -->
    <section id="partnership-ecosystem" class="py-14 sm:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="w-full text-center max-w-3xl mx-auto mb-12 sm:mb-16">
          <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-2 sm:mb-3">
            Collaborative Capabilities
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold text-slate-900 tracking-tight font-display leading-[1.14]">
            Our Partnership <span class="text-[#0F623A]">Ecosystem</span>
          </h2>
          <p class="mt-3.5 text-base sm:text-lg text-slate-600 font-normal leading-relaxed">
            Aligning specialized enterprise capabilities across every operational phase of the technology lifecycle — ensuring defensible security, unbroken custody, and zero-landfill circularity.
          </p>
        </div>

        <!-- 4-Column Responsive Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          
          <!-- Card 1: IT Lifecycle & Asset Recovery -->
          <div class="group relative bg-slate-50/70 hover:bg-white border border-slate-200/90 hover:border-[#0F623A]/40 rounded-2xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:shadow-md">
            <div>
              <div class="w-12 h-12 rounded-xl bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center mb-5 group-hover:bg-[#0F623A] group-hover:text-white transition-colors duration-300">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-[#0F623A] transition-colors leading-snug mb-2.5">
                IT Lifecycle &amp; Asset Recovery
              </h3>
              <p class="text-sm text-slate-600 font-normal leading-relaxed mb-6">
                Technology recovery, testing, remarketing relationships, and value-optimised hardware renewal.
              </p>
            </div>
            <div class="pt-4 border-t border-slate-200/80 space-y-2 text-xs text-slate-700 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-[#0F623A] font-bold">✓</span>
                <span>Serialized hardware auditing</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#0F623A] font-bold">✓</span>
                <span>Secondary market remarketing</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#0F623A] font-bold">✓</span>
                <span>Maximum residual value return</span>
              </div>
            </div>
          </div>

          <!-- Card 2: Secure Data Destruction -->
          <div class="group relative bg-slate-50/70 hover:bg-white border border-slate-200/90 hover:border-[#0F623A]/40 rounded-2xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:shadow-md">
            <div>
              <div class="w-12 h-12 rounded-xl bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center mb-5 group-hover:bg-[#0F623A] group-hover:text-white transition-colors duration-300">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-[#0F623A] transition-colors leading-snug mb-2.5">
                Secure Data Destruction
              </h3>
              <p class="text-sm text-slate-600 font-normal leading-relaxed mb-6">
                Specialist capabilities supporting controlled data sanitisation and certified physical destruction.
              </p>
            </div>
            <div class="pt-4 border-t border-slate-200/80 space-y-2 text-xs text-slate-700 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-[#0F623A] font-bold">✓</span>
                <span>Blancco cryptographic erasure</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#0F623A] font-bold">✓</span>
                <span>ADISA &amp; NIST 800-88 compliance</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#0F623A] font-bold">✓</span>
                <span>BS EN 15713 physical shredding</span>
              </div>
            </div>
          </div>

          <!-- Card 3: Recycling & Circular Economy -->
          <div class="group relative bg-slate-50/70 hover:bg-white border border-slate-200/90 hover:border-[#0F623A]/40 rounded-2xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:shadow-md">
            <div>
              <div class="w-12 h-12 rounded-xl bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center mb-5 group-hover:bg-[#0F623A] group-hover:text-white transition-colors duration-300">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-[#0F623A] transition-colors leading-snug mb-2.5">
                Recycling &amp; Circular Economy
              </h3>
              <p class="text-sm text-slate-600 font-normal leading-relaxed mb-6">
                Responsible material recovery, zero-to-landfill standards, and transparent carbon abatement reporting.
              </p>
            </div>
            <div class="pt-4 border-t border-slate-200/80 space-y-2 text-xs text-slate-700 font-medium">
              <div class="flex items-center gap-2">
                <span class="text-[#0F623A] font-bold">✓</span>
                <span>Environment Agency upper-tier license</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#0F623A] font-bold">✓</span>
                <span>100% zero-to-landfill guarantee</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#0F623A] font-bold">✓</span>
                <span>Scope 3 carbon reduction metrics</span>
              </div>
            </div>
          </div>

          <!-- Card 4: Logistics & Specialist Services -->
          <div class="group relative bg-slate-50/70 hover:bg-white border border-slate-200/90 hover:border-[#0F623A]/40 rounded-2xl p-6 sm:p-7 flex flex-col justify-between transition-all duration-300 hover:shadow-md">
            <div>
              <div class="w-12 h-12 rounded-xl bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center mb-5 group-hover:bg-[#0F623A] group-hover:text-white transition-colors duration-300">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0" />
                </svg>
              </div>
              <h3 class="text-lg font-bold text-slate-900 group-hover:text-[#0F623A] transition-colors leading-snug mb-2.5">
                Logistics &amp; Specialist Services
              </h3>
              <p class="text-sm text-slate-600 font-normal leading-relaxed mb-6">
                Secure nationwide collection, GPS-tracked transportation, and specialized IT relocation services.
