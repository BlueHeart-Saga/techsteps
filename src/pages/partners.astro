<!-- Client Script for Animated Counters, Story Reveal & 3-and-3 Carousel -->
<script>
  function initPartnersPage() {
    // 1. Animated Stats Counter (Ref: About Us)
    const statsBlock = document.getElementById('stats-counter-block');
    if (statsBlock && statsBlock.dataset.observed !== 'true') {
      statsBlock.dataset.observed = 'true';
      const statElements = statsBlock.querySelectorAll<HTMLElement>('.stat-counter-number');

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!prefersReducedMotion && 'IntersectionObserver' in window && statElements.length) {
        const parsedStats: {
          element: HTMLElement;
          raw: string;
          prefix: string;
          target: number;
          suffix: string;
          start: number;
        }[] = [];

        statElements.forEach((el) => {
          const raw = (el.textContent || '').trim();
          const match = raw.match(/^([^\d]*)(\d+)(.*)$/);
          if (match) {
            const prefix = match[1] || '';
            const target = parseInt(match[2], 10);
            const suffix = match[3] || '';
            const start = target === 0 ? 100 : 0;
            parsedStats.push({ element: el, raw, prefix, target, suffix, start });
          }
        });

        if (parsedStats.length) {
          const statsObserver = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  observer.unobserve(entry.target);
                  const duration = 1800;
                  let startTime: number | null = null;

                  function step(timestamp: number) {
                    if (!startTime) startTime = timestamp;
                    const elapsed = timestamp - startTime;
                    const p = Math.min(1, elapsed / duration);
                    const eased = 1 - Math.pow(1 - p, 3);

                    parsedStats.forEach((stat) => {
                      const current = Math.round(stat.start + (stat.target - stat.start) * eased);
                      stat.element.textContent = stat.prefix + current + stat.suffix;
                    });

                    if (p < 1) {
                      requestAnimationFrame(step);
                    } else {
                      parsedStats.forEach((stat) => {
                        stat.element.textContent = stat.raw;
                      });
                    }
                  }

                  requestAnimationFrame(step);
                }
              });
            },
            { threshold: 0.4 }
          );

          statsObserver.observe(statsBlock);
        }
      }
    }

    // 2. Story Quotes Staggered Scroll Reveal (Ref: About Us)
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const storyQuotes = document.querySelectorAll('.story-quote-card');
    if (storyQuotes.length) {
      if (prefersReducedMotion || !('IntersectionObserver' in window)) {
        storyQuotes.forEach((card) => card.classList.add('revealed'));
      } else {
        const quotesObserver = new IntersectionObserver(
          (entries, observer) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                observer.unobserve(entry.target);
                const delay = parseInt((entry.target as HTMLElement).dataset.delay || '0', 10);
                setTimeout(() => {
                  entry.target.classList.add('revealed');
                }, delay);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
        );

        storyQuotes.forEach((card, index) => {
          if (card.dataset.observed !== 'true') {
            card.dataset.observed = 'true';
            (card as HTMLElement).dataset.delay = String(index * 150);
            quotesObserver.observe(card);
          }
        });
      }
    }

    // 3. Client Reviews 3-Card Carousel with Auto-Scroll & Interactive Dots
    const slider = document.getElementById('client-reviews-slider');
    const track = document.getElementById('reviews-slides-track');
    const dotsContainer = document.getElementById('reviews-dots-nav');

    if (slider && track && dotsContainer) {
      const dots = dotsContainer.querySelectorAll<HTMLButtonElement>('.reviews-dot');
      const totalSlides = dots.length;
      let currentSlide = 0;
      let autoScrollTimer: ReturnType<typeof setInterval> | null = null;
      const slideInterval = 5500;

      function updateSlide(index: number) {
        currentSlide = (index + totalSlides) % totalSlides;
        if (track) {
          track.style.transform = `translateX(-${currentSlide * 100}%)`;
        }

        dots.forEach((dot, idx) => {
          if (idx === currentSlide) {
            dot.classList.add('w-7', 'bg-[#0F623A]');
            dot.classList.remove('w-2', 'bg-slate-300', 'hover:bg-slate-400');
            dot.setAttribute('aria-selected', 'true');
          } else {
            dot.classList.remove('w-7', 'bg-[#0F623A]');
            dot.classList.add('w-2', 'bg-slate-300', 'hover:bg-slate-400');
            dot.setAttribute('aria-selected', 'false');
          }
        });
      }

      function startTimer() {
        stopTimer();
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion || totalSlides <= 1) return;
        autoScrollTimer = setInterval(() => {
          updateSlide(currentSlide + 1);
        }, slideInterval);
      }

      function stopTimer() {
        if (autoScrollTimer !== null) {
          clearInterval(autoScrollTimer);
          autoScrollTimer = null;
        }
      }

      if (slider.dataset.bound !== 'true') {
        slider.dataset.bound = 'true';

        dots.forEach((dot) => {
          dot.addEventListener('click', () => {
            const targetIdx = parseInt(dot.dataset.slideIndex || '0', 10);
            updateSlide(targetIdx);
            startTimer();
          });
        });

        slider.addEventListener('mouseenter', stopTimer);
        slider.addEventListener('mouseleave', startTimer);
        dotsContainer.addEventListener('mouseenter', stopTimer);
        dotsContainer.addEventListener('mouseleave', startTimer);

        let touchStartX = 0;
        slider.addEventListener(
          'touchstart',
          (e) => {
            touchStartX = e.changedTouches[0].clientX;
            stopTimer();
          },
          { passive: true }
        );

        slider.addEventListener(
          'touchend',
          (e) => {
            const touchEndX = e.changedTouches[0].clientX;
            const diff = touchStartX - touchEndX;
            if (Math.abs(diff) > 45) {
              if (diff > 0) {
                updateSlide(currentSlide + 1);
              } else {
                updateSlide(currentSlide - 1);
              }
            }
            startTimer();
          },
          { passive: true }
        );
      }

      updateSlide(0);
      startTimer();
    }
  }

  // Initial and Astro navigation setup
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPartnersPage);
  } else {
    initPartnersPage();
  }
  document.addEventListener('astro:page-load', initPartnersPage);
</script>
