---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import HeroSector from '../../components/hero/HeroSector.astro';
import CTA from '../../components/global/cta.astro';
import { getSectors, getServices, getCaseStudies, getSiteSettings } from '../../lib/sanity/client';
import { generateSectorSchema, generateBreadcrumbSchema } from '../../lib/seo/jsonld';
import type { Sector, Service } from '../../lib/sanity/types';
import { isValidSector, normalizeRouteSlug, buildSectorPaths } from '../../lib/routeHelpers';

export async function getStaticPaths() {
  return buildSectorPaths(await getSectors());
}

interface Props {
  sector?: Sector;
}

const { sector: propsSector } = Astro.props;

const [allSectors, allServices, caseStudies, siteSettings] = await Promise.all([
  getSectors(),
  getServices(),
  getCaseStudies(),
  getSiteSettings(),
]);

const requestedSlug = normalizeRouteSlug(Astro.params.slug);
const sector = isValidSector(propsSector)
  ? propsSector
  : buildSectorPaths(allSectors).find((path) => path.params.slug === requestedSlug)?.props.sector;

if (!sector) {
  return Astro.rewrite('/404');
}

const origin = Astro.site?.origin || 'https://techsteps.co.uk';
const sectorSchema = generateSectorSchema(sector, siteSettings, origin);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Sectors', url: '/sectors' },
  { name: sector.title, url: `/sectors/${sector.slug}` },
], origin);

const defaultSectorOrgs: Record<string, { name: string; description: string }[]> = {
  'nhs': [
    { name: 'NHS Integrated Care Boards & Acute Trusts', description: 'Supporting compliant health records management, Caldicott governance, and acute hospital ward IT decommissions.' },
    { name: 'Private Hospital Groups & Clinics', description: 'Guaranteeing medical records security, rapid 1-hour scan-on-demand, and compliant diagnostic asset lifecycle management.' },
    { name: 'Medical Research Institutes & Labs', description: 'Protecting clinical trials databases, specialized laboratory relocations, and confidential pathology archives.' },
  ],
  'defence': [
    { name: 'Ministry of Defence Prime Contractors', description: 'Enforcing JSP 440 compliance, MOD security clearance, and audited on-site granulator destruction.' },
    { name: 'Aerospace & Defence Manufacturers', description: 'Providing certified chain-of-custody tracking for restricted intellectual property and avionics hardware.' },
    { name: 'National Security & Sensitive Facilities', description: 'High-security biometric transport, dual-custody handling, and DIN 66399 Level H-5 hardware sanitisation.' },
  ],
  'finance': [
    { name: 'Retail & Commercial Banking Groups', description: 'Delivering FCA-compliant IT asset disposition, Blancco cryptographic sanitisation, and secure branch decommissioning.' },
    { name: 'Investment Managers & Trading Firms', description: 'Decommissioning high-frequency trading servers, SAN storage arrays, and immutable financial audit registers.' },
    { name: 'FinTech Leaders & Insurance Providers', description: 'Scalable data centre de-racking, distributed remote employee hardware recovery, and ESG remarketing rebates.' },
  ],
  'central-government': [
    { name: 'Ministerial Departments & Core Civil Service', description: 'Delivering Crown Commercial Service aligned records lifecycles and FOI-ready physical archiving.' },
    { name: 'Executive Agencies & Arm’s-Length Bodies', description: 'Secure hardware decommissioning adhering strictly to Greening Government Commitments (GGC).' },
    { name: 'Local Authorities & Civic Councils', description: 'Departmental office relocations, confidential historical document scanning, and civic asset tracking.' },
  ],
  'education-universities': [
    { name: 'Russell Group Universities & HE Institutions', description: 'Managing large-scale campus computer fleet refreshes, research data protection, and lab moves.' },
    { name: 'Multi-Academy Trusts & School Networks', description: 'Compliant pupil records digitization, statutory retention tracking, and hardware remarketing rebates.' },
    { name: 'Higher Education Colleges & Campuses', description: 'Certified WEEE recycling, confidential examination paper shredding, and secure hardware redeployment.' },
  ],
  'legal-professional-services': [
    { name: 'Law Firms & Barristers Chambers', description: 'Guaranteeing absolute client-solicitor confidentiality, deed vaulting, and SRA-compliant destruction.' },
    { name: 'Accountancy & Audit Practices', description: 'Multi-year statutory retention scheduling, high-volume tax file scanning, and secure document storage.' },
    { name: 'Management Consultancies & Corporate Advisory', description: 'Rapid workplace decants, secure encrypted drive shredding, and agile hardware lifecycle tracking.' },
  ],
  'manufacturing-engineering': [
    { name: 'Precision Manufacturing & Engineering Leaders', description: 'Secure decommissioning of legacy industrial control systems (ICS) and SCADA assets.' },
    { name: 'Automotive & Aerospace Production Plants', description: 'Controlled destruction of prototype components, CAD design drives, and proprietary tooling.' },
    { name: 'Pharmaceutical & Life Science Facilities', description: 'Certified cleanroom equipment relocations and BS EN 15713 confidential documentation shredding.' },
  ],
  'it-technology': [
    { name: 'Cloud & Colocation Data Centre Providers', description: 'High-density rack de-installation, Blancco server sanitisation, and bulk solid-state drive destruction.' },
    { name: 'Enterprise Software & SaaS Vendors', description: 'Remote workforce laptop returns kits, custom golden image deployment, and asset recovery rebates.' },
    { name: 'Telecommunications & Network Operators', description: 'Decommissioning central office switching gear, optical hardware, and cellular masts under WEEE.' },
  ],
};

const organizationsSupported = (sector.whoWeSupport && sector.whoWeSupport.length > 0)
  ? sector.whoWeSupport
  : (defaultSectorOrgs[sector.slug] || [
      { name: `${sector.title} Enterprise Organisations`, description: `Supporting specialized information lifecycle, secure disposal, and data integrity for ${sector.title.toLowerCase()}.` },
      { name: `Regulated ${sector.title} Institutions`, description: `Full regulatory adherence and chain-of-custody audit trails tailored for ${sector.title.toLowerCase()} mandates.` },
      { name: `Specialist Facilities & Operations`, description: `End-to-end logistics, compliant relocations, and confidential lifecycle decommissioning.` },
    ]);

const mappedServices = (sector.relevantServices || [])
  .map((slug) => {
    const clean = slug.toLowerCase().replace(/-services|-uk/g, '');
    return allServices.find((s) => {
      const sClean = s.slug?.toLowerCase().replace(/-services|-uk/g, '');
      return s.slug?.toLowerCase() === slug.toLowerCase() || sClean === clean;
    });
  })
  .filter(Boolean) as Service[];

const serviceMappings = (sector.challenges || []).map((challenge, idx) => {
  const matchedService = mappedServices[idx] || mappedServices[idx % (mappedServices.length || 1)] || allServices[0];
  return {
    need: challenge.title,
    needDesc: challenge.description,
    service: matchedService,
  };
}).filter((m) => Boolean(m.service));

const sectorFallbackImages: Record<string, string> = {
  defence: '/images/sectors/defence(1).webp',
  nhs: '/images/sectors/healthcare.webp',
  healthcare: '/images/sectors/healthcare.webp',
  finance: '/images/sectors/finance.webp',
  'financial-services': '/images/sectors/finance.webp',
  'central-government': '/images/sectors/government.webp',
  government: '/images/sectors/government.webp',
  'education-universities': '/images/sectors/education(1).webp',
  education: '/images/sectors/education(1).webp',
  'legal-professional-services': '/images/sectors/corporate(1).webp',
  'legal-professional-sector': '/images/sectors/corporate(1).webp',
  legal: '/images/sectors/corporate(1).webp',
  corporate: '/images/sectors/corporate(1).webp',
  'manufacturing-engineering': '/images/sectors/manufacturing(1).webp',
  manufacturing: '/images/sectors/manufacturing(1).webp',
  'it-technology': '/images/sectors/It.webp',
  technology: '/images/sectors/It.webp',
};

const sectorDeliveryImages: Record<string, string> = {
  defence: '/images/sectors/defence(1).webp',
  nhs: '/images/sectors/healthcare.webp',
  healthcare: '/images/sectors/healthcare.webp',
  finance: '/images/sectors/finance.webp',
  'financial-services': '/images/sectors/finance.webp',
  'central-government': '/images/sectors/government.webp',
  government: '/images/sectors/government.webp',
  'education-universities': '/images/sectors/education(1).webp',
  education: '/images/sectors/education(1).webp',
  'legal-professional-services': '/images/sectors/corporate(1).webp',
  'legal-professional-sector': '/images/sectors/corporate(1).webp',
  legal: '/images/sectors/corporate(1).webp',
  corporate: '/images/sectors/corporate(1).webp',
  'manufacturing-engineering': '/images/sectors/manufacturing(1).webp',
  manufacturing: '/images/sectors/manufacturing(1).webp',
  'it-technology': '/images/sectors/It.webp',
  technology: '/images/sectors/It.webp',
};

const deliveryImage =
  sectorDeliveryImages[sector.slug] ||
  '/images/sectors/corporate(1).webp';

const matchingCaseStudy = (caseStudies || []).find((c) => {
  if (!c) return false;
  const targetIndustry = (c.clientIndustry || '').toLowerCase();
  const sectorTitle = sector.title.toLowerCase();
  const slug = sector.slug.toLowerCase();

  if (targetIndustry && sectorTitle && (targetIndustry.includes(sectorTitle) || sectorTitle.includes(targetIndustry))) return true;
  if (slug === 'finance' && (targetIndustry.includes('financial') || targetIndustry.includes('bank') || targetIndustry.includes('investment'))) return true;
  if (slug === 'nhs' && (targetIndustry.includes('healthcare') || targetIndustry.includes('nhs') || targetIndustry.includes('hospital') || targetIndustry.includes('patient'))) return true;
  if (slug === 'central-government' && (targetIndustry.includes('central government') || targetIndustry.includes('civil service'))) return true;
  if (slug === 'defence' && (targetIndustry.includes('defence') || targetIndustry.includes('defense') || targetIndustry.includes('mod') || targetIndustry.includes('military'))) return true;
  if (slug === 'legal-professional-services' && (targetIndustry.includes('legal') || targetIndustry.includes('law firm') || targetIndustry.includes('barrister'))) return true;
  if (slug === 'education-universities' && (targetIndustry.includes('university') || targetIndustry.includes('higher education'))) return true;
  if (slug === 'manufacturing-engineering' && (targetIndustry.includes('manufacturing') || targetIndustry.includes('aerospace engineering'))) return true;
  if (slug === 'it-technology' && (targetIndustry.includes('data centre') || targetIndustry.includes('telecom') || targetIndustry === 'technology')) return true;

  return false;
});
---

<BaseLayout
  title={sector.metaTitle || `${sector.title} Solutions | Techsteps UK`}
  description={sector.metaDescription || sector.summary}
  jsonLd={[sectorSchema, breadcrumbSchema]}
  hasHeroHeader={true}
>
  <!-- ========================================================= -->
  <!-- SECTION 1: HERO                                           -->
  <!-- ========================================================= -->
  <HeroSector sector={sector} />

  <!-- ========================================================= -->
  <!-- SECTION 2: WHO WE SUPPORT                                 -->
  <!-- ========================================================= -->
  <section id={sector.slug === "nhs" ? "nhs-who-we-support" : undefined} class="py-14 sm:py-16 lg:py-20 bg-white">
    <Container>
      <div class="max-w-3xl mb-10 sm:mb-12">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
          Tailored for {sector.title} Organisations
        </h2>
        <p class="mt-3 text-base sm:text-lg text-slate-700 leading-relaxed font-sans font-normal">
          {sector.summary}
        </p>
      </div>

      <div class="nhs-motion-deck grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {organizationsSupported.slice(0, 3).map((org: any, idx: number) => {
          const num = String(idx + 1).padStart(2, '0');
          const tiers = ['Enterprise Operations', 'Regulated Entities', 'Specialist Facilities'];
          const tierTag = tiers[idx] || `Tier ${idx + 1}`;
          return (
            <div class="nhs-motion-card rounded-[16px] p-7 sm:p-8 shadow-xs flex flex-col justify-between h-full cursor-pointer" data-nhs-index={idx}>
              <div class="space-y-4">
                <div class="flex items-center justify-between">
                  <span class="nhs-tier-badge text-xs font-mono font-bold uppercase tracking-wider px-3 py-1 rounded-full transition-colors">
                    {tierTag}
                  </span>
                  <span class="nhs-card-num text-2xl font-mono font-bold transition-colors">
                    {num}
                  </span>
                </div>

                <h3 class="nhs-card-title text-xl sm:text-2xl font-bold font-display leading-snug transition-colors">
                  {org.name}
                </h3>

                <p class="nhs-card-desc text-sm sm:text-base leading-relaxed font-sans transition-colors">
                  {org.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </Container>
    
    <style is:global>
      /* Base styles */
      #nhs-who-we-support .nhs-motion-card {
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
      }
      #nhs-who-we-support .nhs-motion-card .nhs-card-title { color: #0f172a; }
      #nhs-who-we-support .nhs-motion-card .nhs-card-desc { color: #475569; }
      #nhs-who-we-support .nhs-motion-card .nhs-card-num { color: #cbd5e1; }
      #nhs-who-we-support .nhs-motion-card .nhs-tier-badge { 
        color: #0F623A; 
        background-color: rgba(15,98,58,.1); 
      }

      @media (max-width:1023px) {
        #nhs-who-we-support .nhs-motion-card { min-height:300px; }
      }

      /* Desktop Motion */
      @media (min-width: 1024px) {
        #nhs-who-we-support[data-nhs-motion="ready"] .nhs-motion-deck {
          position:relative; display:block; height:395px; isolation:isolate; overflow:visible;
          perspective:1400px;
        }
        #nhs-who-we-support[data-nhs-motion="ready"] .nhs-motion-card {
          position:absolute; left:50%; top:14px; width:39%; height:355px; min-width:0;
          margin:0; box-sizing:border-box;
          translate:-50% 0;
          transform: translateX(calc(var(--nhs-side, 0) * 80%)) scale(var(--nhs-scale, 1));
          opacity:var(--nhs-opacity, 1);
          z-index:var(--nhs-depth, 1);
          border-color:var(--nhs-border, #e2e8f0) !important;
          background-color:var(--nhs-bg, #ffffff) !important;
          box-shadow:var(--nhs-shadow, 0 8px 30px rgba(12,49,40,.06));
          transition:transform 820ms cubic-bezier(.22,1,.36,1), opacity 600ms ease,
            box-shadow 820ms ease, border-color 820ms ease, background-color 820ms ease, color 500ms ease;
          will-change:transform;
        }
        
        /* Center Card - Teal Green */
        #nhs-who-we-support[data-nhs-motion="ready"] .nhs-motion-card[data-nhs-place="center"] {
          --nhs-side:0; --nhs-scale:1.035; --nhs-depth:3;
          --nhs-border: #0F623A;
          --nhs-bg: #0F623A;
          --nhs-shadow:0 26px 52px rgba(8,57,40,.30);
        }

        /* Side Cards */
        #nhs-who-we-support[data-nhs-motion="ready"] .nhs-motion-card[data-nhs-place="left"] {
          --nhs-side:-1; --nhs-scale:.90; --nhs-depth:1;
          --nhs-shadow:0 12px 26px rgba(12,49,40,.08);
        }
        #nhs-who-we-support[data-nhs-motion="ready"] .nhs-motion-card[data-nhs-place="right"] {
          --nhs-side:1; --nhs-scale:.90; --nhs-depth:1;
          --nhs-shadow:0 12px 26px rgba(12,49,40,.08);
        }

        /* Center Card Text Colors */
        #nhs-who-we-support[data-nhs-motion="ready"] .nhs-motion-card[data-nhs-place="center"] .nhs-card-title {
          color: #ffffff !important;
        }
        #nhs-who-we-support[data-nhs-motion="ready"] .nhs-motion-card[data-nhs-place="center"] .nhs-card-desc {
          color: rgba(255, 255, 255, 0.85) !important;
        }
        #nhs-who-we-support[data-nhs-motion="ready"] .nhs-motion-card[data-nhs-place="center"] .nhs-card-num {
          color: rgba(255, 255, 255, 0.45) !important;
        }
        #nhs-who-we-support[data-nhs-motion="ready"] .nhs-motion-card[data-nhs-place="center"] .nhs-tier-badge {
          color: #ffffff !important;
          background-color: rgba(255, 255, 255, 0.15) !important;
        }
      }

      @media (prefers-reduced-motion:reduce) {
        #nhs-who-we-support .nhs-motion-card { 
          transition:none !important; 
          transform:none !important; 
          background-color: #ffffff !important;
        }
        #nhs-who-we-support .nhs-motion-card .nhs-card-title { color: #0f172a !important; }
        #nhs-who-we-support .nhs-motion-card .nhs-card-desc  { color: #475569 !important; }
        #nhs-who-we-support .nhs-motion-card .nhs-card-num   { color: #cbd5e1 !important; }
        #nhs-who-we-support .nhs-motion-card .nhs-tier-badge {
          color: #0F623A !important;
          background-color: rgba(15,98,58,.1) !important;
        }
      }
    </style>

    <script is:inline>
      (() => {
        const init = () => {
          const section = document.getElementById('nhs-who-we-support');
          if (!section || section.dataset.nhsInitialized === '1') return;
          const cards = [...section.querySelectorAll('.nhs-motion-card')];
          if (cards.length !== 3) return;
          section.dataset.nhsInitialized = '1';
          const reduced = matchMedia('(prefers-reduced-motion: reduce)');
          const desktop = matchMedia('(min-width:1024px)');
          let index = 0, timer = null, relocation = null, visible = false, paused = false;
          const clearTimers = () => {
            if (timer !== null) clearInterval(timer);
            if (relocation !== null) clearTimeout(relocation);
            timer = null; relocation = null;
          };
          const place = () => {
            cards.forEach((card, i) => {
              const relative = (i - index + 3) % 3;
              card.dataset.nhsPlace = relative === 0 ? 'center' : relative === 1 ? 'right' : 'left';
            });
          };
          const canAnimate = () => desktop.matches && !reduced.matches;
          const sync = () => {
            clearTimers();
            if (!canAnimate()) { 
              section.removeAttribute('data-nhs-motion'); 
              cards.forEach(c => c.removeAttribute('data-nhs-place'));
              return; 
            }
            place();
            section.dataset.nhsMotion = 'ready';
            if (!visible || document.hidden || paused) return;
            timer = setInterval(() => { index = (index + 1) % cards.length; place(); }, 3300);
          };
          const observer = new IntersectionObserver(entries => {
            visible = Boolean(entries[0]?.isIntersecting); sync();
          }, { threshold:.18 });
          observer.observe(section);
          const onVisibility = () => sync();
          
          // Click Event to pause/play
          const onClick = (e) => {
            if (e.target.closest('.nhs-motion-card')) {
              paused = !paused;
              sync();
            }
          };

          section.addEventListener('click', onClick);
          desktop.addEventListener('change', sync);
          reduced.addEventListener('change', sync);
          document.addEventListener('visibilitychange', onVisibility);
          
          const cleanup = () => {
            clearTimers(); observer.disconnect();
            section.removeEventListener('click', onClick);
            desktop.removeEventListener('change', sync);
            reduced.removeEventListener('change', sync);
            document.removeEventListener('visibilitychange', onVisibility);
            section.removeAttribute('data-nhs-initialized');
          };
          document.addEventListener('astro:before-swap', cleanup, {once:true});
          sync();
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, {once:true});
        else init();
        document.addEventListener('astro:page-load', init);
      })();
    </script>
  </section>

  <!-- ========================================================= -->
  <!-- SECTION 3: CHALLENGES & SOLUTIONS                         -->
  <!-- ========================================================= -->
  <section id="challenges-solutions" class="py-14 sm:py-16 lg:py-20 bg-white">
    <Container>
      <div class="max-w-3xl mb-10 sm:mb-12">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
          Resolving {sector.title} Operational Risks
        </h2>
        <p class="mt-3 text-base sm:text-lg text-slate-700 leading-relaxed font-sans font-normal">
          Direct alignment between key {sector.title.toLowerCase()} operational liabilities and TechSteps accredited service delivery.
        </p>
      </div>

      <div class="space-y-4 sm:space-y-5">
        {serviceMappings.map((item, idx) => {
          const num = String(idx + 1).padStart(2, '0');
          return (
            <div class="rounded-[16px] border border-slate-200/90 bg-white p-6 sm:p-8 hover:border-[#0F623A]/40 hover:shadow-md transition-all duration-300">
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-center">
                <div class="lg:col-span-5 space-y-2">
                  <div class="flex items-center gap-2.5">
                    <span class="text-xs font-mono font-bold text-slate-400">
                      {num}
                    </span>
                    <span class="text-xs font-mono font-bold uppercase tracking-wider text-rose-700 px-2.5 py-0.5 rounded-full bg-rose-50 border border-rose-200/70">
                      Industry Challenge
                    </span>
                  </div>
                  <h3 class="text-lg sm:text-xl font-bold font-display text-slate-900 leading-snug">
                    {item.need}
                  </h3>
                  <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
                    {item.needDesc}
                  </p>
                </div>

                <div class="lg:col-span-2 flex flex-col items-center justify-center py-2 lg:py-0">
                  <div class="flex items-center gap-2 lg:flex-col">
                    <div class="w-10 h-10 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/20 flex items-center justify-center text-[#0F623A] shadow-xs">
                      <svg class="w-4 h-4 transform lg:rotate-0 rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                      </svg>
                    </div>
                    <span class="text-[11px] font-mono font-bold uppercase tracking-widest text-[#0F623A]">
                      Mapped To
                    </span>
                  </div>
                </div>

                <div class="lg:col-span-5 space-y-2 bg-white rounded-[12px] border border-slate-200/80 p-5 sm:p-6 shadow-xs">
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#0F623A] px-2.5 py-0.5 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/20">
                      Accredited Delivery
                    </span>
                    <a
                      href={`/services/${item.service.slug}`}
                      class="text-xs font-bold text-[#0F623A] hover:text-[#0c4e2e] inline-flex items-center gap-1 transition-colors"
                    >
                      View Service ↗
                    </a>
                  </div>
                  <h4 class="text-lg sm:text-xl font-bold font-display text-slate-900 leading-snug">
                    <a href={`/services/${item.service.slug}`} class="hover:text-[#0F623A] transition-colors">
                      {item.service.title}
                    </a>
                  </h4>
                  <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
                    {item.service.summary || item.service.solution || 'Certified lifecycle delivery meeting strict statutory requirements.'}
                  </p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- ========================================================= -->
  <!-- SECTION 4: HOW WE DELIVER                                 -->
  <!-- ========================================================= -->
  <section class="py-14 sm:py-16 lg:py-20 bg-white">
    <Container>
      <div class="rounded-[24px] border border-slate-200/90 bg-white p-6 sm:p-8 lg:p-12 shadow-xs ">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
<div class="lg:col-span-5">
  <div class="relative overflow-hidden group">
    <img
      src={deliveryImage}
      alt={sector.heroAlt || `TechSteps operational deployment for ${sector.title}`}
      class="w-full h-auto object-cover transition-transform duration-500 group-hover:scale-[1.02]"
      loading="lazy"
    />
  </div>
</div>

          <div class="lg:col-span-7 space-y-6">
            <div>
              <h3 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-slate-900 font-display leading-tight">
                Enterprise Lifecycle Management in Action
              </h3>
            </div>

