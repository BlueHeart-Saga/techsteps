---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import HeroSector from '../../components/hero/HeroSector.astro';
import BenefitsList from '../../components/services/BenefitsList.astro';
import ServiceCard from '../../components/services/ServiceCard.astro';
import AccordionFaq from '../../components/content/AccordionFaq.astro';
import { sectors, services, caseStudies } from '../../lib/sanity/data';
import type { Sector } from '../../lib/sanity/types';

export async function getStaticPaths() {
  return sectors.map((sector) => ({
    params: { slug: sector.slug },
    props: { sector },
  }));
}

interface Props {
  sector: Sector;
}

const { sector } = Astro.props;

// Fetch services aligned with this sector
const alignedServices = services.filter((s) =>
  sector.relevantServices.includes(s.slug) || s.relatedSectors?.includes(sector.slug)
);

// Matching case study
const matchingCaseStudy = caseStudies.find(
  (c) => c.clientIndustry.toLowerCase().includes(sector.title.toLowerCase()) ||
         (sector.slug === 'finance' && c.clientIndustry.includes('Financial')) ||
         (sector.slug === 'nhs' && c.clientIndustry.includes('Healthcare'))
);
---

<BaseLayout
  title={sector.metaTitle || `${sector.title} Solutions | Techsteps UK`}
  description={sector.metaDescription || sector.summary}
>
  <HeroSector sector={sector} />

  <!-- Industry Context & Challenges -->
  <Section theme="white">
    <Container>
      <div class="space-y-12">
        <div class="max-w-3xl space-y-4">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Operational Context</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-navy tracking-tight">
            Key Industry Challenges in {sector.title}
          </h2>
          <p class="text-base text-slate-600 leading-relaxed">
            Organizations within the UK {sector.title} ecosystem operate under unforgiving compliance scrutiny. Standard commercial disposal, moving, and archiving contractors lack the specialized vetting and technical procedures needed to neutralize these liabilities.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {sector.challenges.map((c) => (
            <div class="p-6 rounded-2xl bg-brand-slate border border-slate-200/90 shadow-xs space-y-3">
              <div class="h-8 w-8 rounded-lg bg-red-100 text-red-700 flex items-center justify-center font-bold text-xs">
                !
              </div>
              <h3 class="text-lg font-bold text-brand-navy">{c.title}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{c.description}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </Section>

  <!-- Security Considerations & How Techsteps Helps -->
  <Section theme="slate">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-7 space-y-6">
          <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Tailored Operational Architecture</span>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-navy tracking-tight">
            How Techsteps Solves {sector.title} Vulnerabilities
          </h2>
          <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
            {sector.howTechstepsHelps}
          </p>

          <div class="space-y-4 pt-2">
            {sector.solutions.map((sol) => (
              <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-xs space-y-1">
                <h4 class="font-bold text-brand-navy text-base">{sol.title}</h4>
                <p class="text-sm text-slate-600">{sol.description}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="lg:col-span-5">
          <div class="p-8 rounded-2xl bg-brand-navy text-white space-y-6 shadow-xl">
            <h3 class="text-xl font-bold text-white border-b border-white/15 pb-3">
              Sector Security Protocols
            </h3>
            <ul class="space-y-4 text-sm text-slate-200">
              {sector.securityConsiderations.map((secNote) => (
                <li class="flex items-start gap-3">
                  <div class="h-5 w-5 rounded-full bg-emerald-500/20 text-emerald-300 flex items-center justify-center flex-shrink-0 mt-0.5 text-xs">
                    ✓
                  </div>
                  <span>{secNote}</span>
                </li>
              ))}
            </ul>

            <div class="pt-4 border-t border-white/15">
              <span class="text-xs text-slate-400 block mb-1">Governing Standards:</span>
              <p class="text-xs font-mono text-emerald-300">
                {sector.complianceStandards.join(' • ')}
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </Section>

  <!-- Sector Benefits -->
  <Section theme="white">
    <Container>
      <BenefitsList benefits={sector.keyBenefits} title={`Commercial & Compliance Outcomes for ${sector.title}`} />
    </Container>
  </Section>

  <!-- Relevant Services Grid -->
  {alignedServices.length > 0 && (
    <Section theme="slate" id="relevant-services">
      <Container>
        <div class="space-y-8">
          <div class="text-center max-w-2xl mx-auto space-y-2">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Certified Capability Matrix</span>
            <h2 class="text-3xl font-extrabold text-brand-navy tracking-tight">
              Recommended Services for {sector.title}
            </h2>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
            {alignedServices.slice(0, 4).map((service) => (
              <ServiceCard service={service} showDivision={true} />
            ))}
          </div>
        </div>
      </Container>
    </Section>
  )}

  <!-- Case Study Proof (if available) -->
  {matchingCaseStudy && (
    <Section theme="white">
      <Container>
        <div class="p-8 sm:p-12 rounded-2xl bg-brand-slate border border-slate-200/90 shadow-sm space-y-6 max-w-4xl mx-auto">
          <div class="flex items-center justify-between">
            <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Verified Case Study</span>
            <span class="text-xs font-semibold text-slate-500">{matchingCaseStudy.clientIndustry}</span>
          </div>
          <h3 class="text-2xl font-bold text-brand-navy">
            {matchingCaseStudy.title}
          </h3>
          <p class="text-sm text-slate-600 leading-relaxed">
            {matchingCaseStudy.solution}
          </p>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2">
            {matchingCaseStudy.results.map((r) => (
              <div class="flex items-center gap-2 text-xs font-semibold text-brand-navy">
                <span class="text-emerald-600">✓</span>
                <span>{r}</span>
              </div>
            ))}
          </div>
          <div class="pt-4">
            <a
              href={`/case-studies/${matchingCaseStudy.slug}`}
              class="text-xs font-bold text-brand-blue hover:text-brand-accent flex items-center gap-1 group"
            >
              <span>Read Full Case Study Breakdown</span>
              <span class="transition-transform group-hover:translate-x-1">&rarr;</span>
            </a>
          </div>
        </div>
      </Container>
    </Section>
  )}

  <!-- FAQs -->
  {sector.faqs && sector.faqs.length > 0 && (
    <Section theme="slate">
      <Container>
        <AccordionFaq faqs={sector.faqs} title={`Frequently Asked Questions: ${sector.title}`} />
      </Container>
    </Section>
  )}

  <!-- Final Sector CTA -->
  <section class="relative bg-[#f1f4ef] py-16 sm:py-24 overflow-hidden select-none border-t border-slate-300/60">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-[#146B5C]/15 blur-3xl pointer-events-none"></div>

    <Container className="relative z-10 text-center max-w-4xl mx-auto space-y-6">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-brand-navy tracking-tight leading-tight">
        Schedule a confidential {sector.title} consultation
      </h2>
      <p class="text-base sm:text-lg text-slate-700 max-w-2xl mx-auto leading-relaxed font-normal">
        Speak directly with our security-cleared sector lead to discuss chain-of-custody protocols, framework procurement, or site audits.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href={`/request-a-quote?sector=${encodeURIComponent(sector.slug)}`}
          class="px-8 py-4 rounded-xl bg-[#146B5C] hover:bg-[#0D5549] text-white text-base font-bold shadow-lg hover:shadow-xl transition-all duration-300 transform hover:-translate-y-0.5"
        >
          Request {sector.title} Briefing
        </a>
        <a
          href="/contact"
          class="px-8 py-4 rounded-xl bg-white hover:bg-slate-50 text-brand-navy text-base font-bold border border-slate-300/90 shadow-sm transition-all"
        >
          Speak with Sector Lead
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
