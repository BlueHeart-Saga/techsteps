---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import HeroSector from '../../components/hero/HeroSector.astro';
import CTA from '../../components/global/cta.astro';
import { getSectors, getServices, getCaseStudies, getSiteSettings } from '../../lib/sanity/client';
import { generateSectorSchema, generateBreadcrumbSchema } from '../../lib/seo/jsonld';
import type { Sector, Service } from '../../lib/sanity/types';

export async function getStaticPaths() {
  const allSectors = await getSectors();

  return allSectors.map((sector) => ({
    params: { slug: sector.slug },
    props: { sector },
  }));
}

interface Props {
  sector: Sector;
}

const { sector } = Astro.props;

const [allSectors, allServices, caseStudies, siteSettings] = await Promise.all([
  getSectors(),
  getServices(),
  getCaseStudies(),
  getSiteSettings(),
]);

const origin = Astro.site?.origin || 'https://techsteps.co.uk';
const sectorSchema = generateSectorSchema(sector, siteSettings, origin);
const breadcrumbSchema = generateBreadcrumbSchema([
  { name: 'Sectors', url: '/sectors' },
  { name: sector.title, url: `/sectors/${sector.slug}` },
], origin);

/*
 * Grouped section fields
 */
const sectorData = sector as Sector & {
  challengesSection?: {
    eyebrow?: string;
    heading?: string;
    description?: string;
  };

  solutionsSection?: {
    eyebrow?: string;
    heading?: string;
    description?: string;
  };

  securitySection?: {
    eyebrow?: string;
    heading?: string;
    description?: string;
  };

  benefitsSection?: {
    eyebrow?: string;
    heading?: string;
    description?: string;
  };

  caseStudySection?: {
    eyebrow?: string;
    heading?: string;
    description?: string;
  };

  faqSection?: {
    eyebrow?: string;
    heading?: string;
    description?: string;
  };

  cta?: {
    eyebrow?: string;
    heading?: string;
    description?: string;
    primaryButtonText?: string;
    secondaryButtonText?: string;
  };
};

// 01 / WHO WE SUPPORT: Verified organisation groups
const defaultSectorOrgs: Record<string, { name: string; description: string }[]> = {
  'nhs': [
    { name: 'NHS Integrated Care Boards & Acute Trusts', description: 'Supporting compliant health records management, Caldicott governance, and acute hospital ward IT decommissions.' },
    { name: 'Private Hospital Groups & Clinics', description: 'Guaranteeing medical records security, rapid 1-hour scan-on-demand, and compliant diagnostic asset lifecycle management.' },
    { name: 'Medical Research Institutes & Labs', description: 'Protecting clinical trials databases, specialized laboratory relocations, and confidential pathology archives.' },
  ],
  'defence': [
    { name: 'Ministry of Defence Prime Contractors', description: 'Enforcing JSP 440 compliance, MOD security clearance, and audited on-site granulator destruction.' },
    { name: 'Aerospace & Defence Manufacturers', description: 'Providing certified chain-of-custody tracking for restricted intellectual property and avionics hardware.' },
    { name: 'National Security & Sensitive Facilities', description: 'High-security biometric transport, dual-custody handling, and DIN 66399 Level H-5 hardware sanitisation.' },
  ],
  'finance': [
    { name: 'Retail & Commercial Banking Groups', description: 'Delivering FCA-compliant IT asset disposition, Blancco cryptographic sanitisation, and secure branch decommissioning.' },
    { name: 'Investment Managers & Trading Firms', description: 'Decommissioning high-frequency trading servers, SAN storage arrays, and immutable financial audit registers.' },
    { name: 'FinTech Leaders & Insurance Providers', description: 'Scalable data centre de-racking, distributed remote employee hardware recovery, and ESG remarketing rebates.' },
  ],
  'central-government': [
    { name: 'Ministerial Departments & Core Civil Service', description: 'Delivering Crown Commercial Service aligned records lifecycles and FOI-ready physical archiving.' },
    { name: 'Executive Agencies & Arm’s-Length Bodies', description: 'Secure hardware decommissioning adhering strictly to Greening Government Commitments (GGC).' },
    { name: 'Local Authorities & Civic Councils', description: 'Departmental office relocations, confidential historical document scanning, and civic asset tracking.' },
  ],
  'education-universities': [
    { name: 'Russell Group Universities & HE Institutions', description: 'Managing large-scale campus computer fleet refreshes, research data protection, and lab moves.' },
    { name: 'Multi-Academy Trusts & School Networks', description: 'Compliant pupil records digitization, statutory retention tracking, and hardware remarketing rebates.' },
    { name: 'Higher Education Colleges & Campuses', description: 'Certified WEEE recycling, confidential examination paper shredding, and secure hardware redeployment.' },
  ],
  'legal-professional-services': [
    { name: 'Law Firms & Barristers Chambers', description: 'Guaranteeing absolute client-solicitor confidentiality, deed vaulting, and SRA-compliant destruction.' },
    { name: 'Accountancy & Audit Practices', description: 'Multi-year statutory retention scheduling, high-volume tax file scanning, and secure document storage.' },
    { name: 'Management Consultancies & Corporate Advisory', description: 'Rapid workplace decants, secure encrypted drive shredding, and agile hardware lifecycle tracking.' },
  ],
  'manufacturing-engineering': [
    { name: 'Precision Manufacturing & Engineering Leaders', description: 'Secure decommissioning of legacy industrial control systems (ICS) and SCADA assets.' },
    { name: 'Automotive & Aerospace Production Plants', description: 'Controlled destruction of prototype components, CAD design drives, and proprietary tooling.' },
    { name: 'Pharmaceutical & Life Science Facilities', description: 'Certified cleanroom equipment relocations and BS EN 15713 confidential documentation shredding.' },
  ],
  'it-technology': [
    { name: 'Cloud & Colocation Data Centre Providers', description: 'High-density rack de-installation, Blancco server sanitisation, and bulk solid-state drive destruction.' },
    { name: 'Enterprise Software & SaaS Vendors', description: 'Remote workforce laptop returns kits, custom golden image deployment, and asset recovery rebates.' },
    { name: 'Telecommunications & Network Operators', description: 'Decommissioning central office switching gear, optical hardware, and cellular masts under WEEE.' },
  ],
};

const organizationsSupported = (sector.whoWeSupport && sector.whoWeSupport.length > 0)
  ? sector.whoWeSupport
  : (defaultSectorOrgs[sector.slug] || [
      { name: `${sector.title} Enterprise Organisations`, description: `Supporting specialized information lifecycle, secure disposal, and data integrity for ${sector.title.toLowerCase()}.` },
      { name: `Regulated ${sector.title} Institutions`, description: `Full regulatory adherence and chain-of-custody audit trails tailored for ${sector.title.toLowerCase()} mandates.` },
      { name: `Specialist Facilities & Operations`, description: `End-to-end logistics, compliant relocations, and confidential lifecycle decommissioning.` },
    ]);

// 03 / TAILORED SOLUTIONS: Resolve mapped services from sector.relevantServices
const mappedServices = (sector.relevantServices || [])
  .map((slug) => {
    const clean = slug.toLowerCase().replace(/-services|-uk/g, '');
    return allServices.find((s) => {
      const sClean = s.slug?.toLowerCase().replace(/-services|-uk/g, '');
      return s.slug?.toLowerCase() === slug.toLowerCase() || sClean === clean;
    });
  })
  .filter(Boolean) as Service[];

// 04 / SERVICE MAPPING: Connect challenges to accredited services
const serviceMappings = (sector.challenges || []).map((challenge, idx) => {
  const matchedService = mappedServices[idx] || mappedServices[0];
  return {
    need: challenge.title,
    needDesc: challenge.description,
    service: matchedService,
  };
}).filter((m) => Boolean(m.service));

// 08 / PROVEN EXPERIENCE: Strictly sector-specific verified case study
const matchingCaseStudy = (caseStudies || []).find((c) => {
  if (!c) return false;
  const targetIndustry = (c.clientIndustry || '').toLowerCase();
  const sectorTitle = sector.title.toLowerCase();
  const slug = sector.slug.toLowerCase();

  if (targetIndustry && sectorTitle && (targetIndustry.includes(sectorTitle) || sectorTitle.includes(targetIndustry))) return true;
  if (slug === 'finance' && (targetIndustry.includes('financial') || targetIndustry.includes('bank') || targetIndustry.includes('investment'))) return true;
  if (slug === 'nhs' && (targetIndustry.includes('healthcare') || targetIndustry.includes('nhs') || targetIndustry.includes('hospital') || targetIndustry.includes('patient'))) return true;
  if (slug === 'central-government' && (targetIndustry.includes('central government') || targetIndustry.includes('civil service'))) return true;
  if (slug === 'defence' && (targetIndustry.includes('defence') || targetIndustry.includes('defense') || targetIndustry.includes('mod') || targetIndustry.includes('military'))) return true;
  if (slug === 'legal-professional-services' && (targetIndustry.includes('legal') || targetIndustry.includes('law firm') || targetIndustry.includes('barrister'))) return true;
  if (slug === 'education-universities' && (targetIndustry.includes('university') || targetIndustry.includes('higher education'))) return true;
  if (slug === 'manufacturing-engineering' && (targetIndustry.includes('manufacturing') || targetIndustry.includes('aerospace engineering'))) return true;
  if (slug === 'it-technology' && (targetIndustry.includes('data centre') || targetIndustry.includes('telecom') || targetIndustry === 'technology')) return true;

  return false;
});
---

<BaseLayout
  title={sector.metaTitle || `${sector.title} Solutions | Techsteps UK`}
  description={sector.metaDescription || sector.summary}
  jsonLd={[sectorSchema, breadcrumbSchema]}
  hasHeroHeader={true}
>
  <!-- ========================================================= -->
  <!-- 1. HERO -->
  <!-- ========================================================= -->
  <HeroSector sector={sector} />

  <!-- ===== 01 / WHO WE SUPPORT ===== -->
  <section class="py-16 lg:py-24 bg-white border-b border-slate-200/80">
    <Container>
      <div class="max-w-3xl mb-12 lg:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          01 / WHO WE SUPPORT
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
          Solutions for {sector.title} Organisations
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
          {sector.summary}
        </p>
      </div>

      <div class="divide-y divide-slate-200/90 border-t border-b border-slate-200/90">
        {organizationsSupported.map((org: any, idx: number) => {
          const num = String(idx + 1).padStart(2, '0');
          return (
            <div class="py-7 sm:py-8 group transition-colors duration-200 hover:bg-[#F8FAF9] px-4 sm:px-6 -mx-4 sm:-mx-6 rounded-lg">
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-baseline">
                <div class="md:col-span-2">
                  <span class="text-2xl sm:text-3xl font-mono font-bold text-[#0F623A] tracking-tight">
                    {num}
                  </span>
                </div>
                <div class="md:col-span-4">
                  <h3 class="text-xl sm:text-2xl font-semibold text-slate-900 font-display group-hover:text-[#0F623A] transition-colors leading-snug">
                    {org.name}
                  </h3>
                </div>
                <div class="md:col-span-6">
                  <p class="text-base text-slate-600 font-sans leading-relaxed">
                    {org.description}
                  </p>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- ===== 02 / INDUSTRY CHALLENGES ===== -->
  <section class="py-16 lg:py-24 bg-[#F8FAF9] border-b border-slate-200/80">
    <Container>
      <div class="max-w-3xl mb-12 lg:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          02 / INDUSTRY CHALLENGES
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
          We Understand Your Challenges
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
          {sectorData.challengesSection?.description ||
            `Organisations across the UK ${sector.title} ecosystem operate under unforgiving statutory and operational standards. Standard commercial contractors lack the specialist clearance and chain-of-custody controls needed to neutralize these liabilities.`}
        </p>
      </div>

      <div class="divide-y divide-slate-200/90 border-t border-b border-slate-200/90">
        {sector.challenges?.map((challenge, idx) => {
          const num = String(idx + 1).padStart(2, '0');
          return (
            <div class="py-7 sm:py-9 group transition-colors duration-200 hover:bg-white px-4 sm:px-6 -mx-4 sm:-mx-6 rounded-lg">
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-center">
                <div class="md:col-span-2 flex items-baseline gap-3">
                  <span class="text-2xl sm:text-3xl font-mono font-bold text-[#0F623A] tracking-tight">
                    {num}
                  </span>
                </div>
                <div class="md:col-span-9">
                  <h3 class="text-xl sm:text-2xl font-semibold text-slate-900 font-display group-hover:text-[#0F623A] transition-colors leading-snug">
                    {challenge.title}
                  </h3>
                  <p class="mt-2 text-base text-slate-600 font-sans leading-relaxed">
                    {challenge.description}
                  </p>
                </div>
                <div class="md:col-span-1 flex justify-end">
                  <span class="w-10 h-10 rounded-full border border-slate-200 group-hover:border-[#0F623A] group-hover:bg-[#0F623A] group-hover:text-white flex items-center justify-center text-slate-400 transition-all duration-300 transform group-hover:translate-x-1">
                    <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </span>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- ===== 03 / TAILORED SOLUTIONS ===== -->
  <section id="tailored-solutions" class="py-16 lg:py-24 bg-white border-b border-slate-200/80">
    <Container>
      <div class="max-w-3xl mb-12 lg:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          03 / TAILORED SOLUTIONS
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
          Our {sector.title} Solutions
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
          {sectorData.solutionsSection?.description ||
            `Accredited services specifically deployed and certified to meet the operational demands of ${sector.title.toLowerCase()}.`}
        </p>
      </div>

      <div class="divide-y divide-slate-200/90 border-t border-b border-slate-200/90">
        {mappedServices.map((service, idx) => {
          const num = String(idx + 1).padStart(2, '0');
          return (
            <div class="py-8 sm:py-9 group transition-colors duration-200 hover:bg-[#F8FAF9] px-4 sm:px-6 -mx-4 sm:-mx-6 rounded-lg">
              <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-8 items-center">
                <div class="md:col-span-2">
                  <span class="text-2xl sm:text-3xl font-mono font-bold text-[#0F623A] tracking-tight">
                    {num}
                  </span>
                </div>
                <div class="md:col-span-7">
                  <h3 class="text-xl sm:text-2xl font-semibold text-slate-900 font-display group-hover:text-[#0F623A] transition-colors leading-snug">
                    {service.title}
                  </h3>
                  <p class="mt-2 text-base text-slate-600 font-sans leading-relaxed">
                    {service.summary || service.solution || 'Certified lifecycle delivery meeting strict statutory requirements.'}
                  </p>
                </div>
                <div class="md:col-span-3 flex md:justify-end">
                  <a
                    href={`/services/${service.slug}`}
                    class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-[#0F623A] group-hover:text-[#0c4e2e] transition-colors py-2 px-4 rounded-lg bg-[#0F623A]/10 group-hover:bg-[#0F623A] group-hover:text-white"
                  >
                    <span>Learn More</span>
                    <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                    </svg>
                  </a>
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- ===== 04 / SERVICE MAPPING ===== -->
  <section class="py-16 lg:py-24 bg-[#F8FAF9] border-b border-slate-200/80">
    <Container>
      <div class="max-w-3xl mb-12 lg:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          04 / SERVICE MAPPING
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
          Connecting Challenges to Solutions
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
          Direct alignment between key {sector.title.toLowerCase()} operational requirements and TechSteps accredited service delivery.
        </p>
      </div>

      <!-- Editorial Mapping Grid (Not a basic HTML table) -->
      <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs overflow-hidden">
        <!-- Table Column Header -->
        <div class="hidden md:grid md:grid-cols-12 gap-6 px-8 py-4 bg-slate-50/80 border-b border-slate-200 text-xs font-mono font-bold uppercase tracking-wider text-slate-500">
          <div class="md:col-span-5">Business Need / Challenge</div>
          <div class="md:col-span-2 text-center">Relationship</div>
          <div class="md:col-span-5">TechSteps Accredited Solution</div>
        </div>

        <div class="divide-y divide-slate-100">
          {serviceMappings.map((item) => (
            <div class="p-6 sm:p-8 grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 items-center hover:bg-slate-50/50 transition-colors group">
              <!-- Left: Need -->
              <div class="md:col-span-5 space-y-1">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#0F623A] block md:hidden mb-1">
                  Business Need
                </span>
                <h4 class="text-lg font-semibold text-slate-900 font-display">
                  {item.need}
                </h4>
                <p class="text-sm text-slate-600 leading-relaxed font-sans">
                  {item.needDesc}
                </p>
              </div>

              <!-- Center: Arrow -->
              <div class="md:col-span-2 flex items-center justify-start md:justify-center py-1 md:py-0">
                <div class="w-9 h-9 rounded-full bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center font-bold text-sm group-hover:bg-[#0F623A] group-hover:text-white transition-colors duration-200">
                  <svg class="w-4 h-4 transform group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                  </svg>
                </div>
              </div>

              <!-- Right: Solution -->
              <div class="md:col-span-5 flex items-center justify-between gap-4">
                <div class="space-y-1">
                  <span class="text-xs font-mono font-bold uppercase tracking-wider text-[#0F623A] block md:hidden mb-1">
                    TechSteps Solution
                  </span>
                  <a
                    href={`/services/${item.service.slug}`}
                    class="text-lg font-semibold text-slate-900 hover:text-[#0F623A] transition-colors font-display inline-flex items-center gap-1.5"
                  >
                    <span>{item.service.title}</span>
                    <span class="text-xs text-[#0F623A]">↗</span>
                  </a>
                  <p class="text-sm text-slate-600 leading-relaxed font-sans line-clamp-2">
                    {item.service.summary || item.service.solution}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 05 / OPERATIONAL USE CASES ===== -->
  <section class="py-16 lg:py-24 bg-white border-b border-slate-200/80">
    <Container>
      <div class="max-w-3xl mb-12 lg:mb-16">
        <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/25 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          05 / OPERATIONAL USE CASES
        </div>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
          Designed for Real {sector.title} Needs
        </h2>
        <p class="mt-4 text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
          How TechSteps delivers end-to-end information governance, secure asset disposition, and compliant relocations in practice.
        </p>
      </div>

      <!-- Large Image + Editorial Layout -->
      <div class="rounded-3xl border border-slate-200/90 bg-[#F8FAF9] p-6 sm:p-8 lg:p-12 shadow-xs">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
          <!-- Large Realistic Image -->
          <div class="lg:col-span-6">
            <div class="relative rounded-2xl overflow-hidden shadow-lg border border-slate-200 aspect-[4/3] bg-slate-900 group">
              <img
                src={sector.heroImage || `/images/sectors/${sector.slug}.jpg`}
                alt={sector.heroAlt || `TechSteps operational deployment for ${sector.title}`}
                class="w-full h-full object-cover transform group-hover:scale-[1.02] transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/40 via-transparent to-transparent pointer-events-none"></div>
            </div>
          </div>

          <!-- Editorial Scenario Content -->
          <div class="lg:col-span-6 space-y-6">
            <span class="inline-block text-xs font-mono font-bold uppercase tracking-widest text-[#0F623A] px-3 py-1 rounded-full bg-[#0F623A]/10">
              Operational Delivery
            </span>

            <h3 class="text-2xl sm:text-3xl font-semibold text-slate-900 font-display leading-tight">
              Enterprise Lifecycle Management in Action
            </h3>

            <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-sans font-normal">
              {sector.howTechstepsHelps}
            </p>

            <!-- Verified Highlights -->
            <div class="space-y-3 pt-2">
              {sector.solutions?.map((sol) => (
                <div class="flex items-start gap-3">
                  <div class="w-5 h-5 rounded-full bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center shrink-0 mt-0.5 text-xs font-bold">
                    ✓
                  </div>
                  <span class="text-sm sm:text-base font-medium text-slate-900 leading-snug">
                    {sol.title} — <span class="text-slate-600 font-normal">{sol.description}</span>
                  </span>
                </div>
              ))}
            </div>

            <div class="pt-4">
              <a
                href="#tailored-solutions"
                class="inline-flex items-center gap-2 text-sm font-bold uppercase tracking-wider text-[#0F623A] hover:text-[#0c4e2e] transition-colors"
              >
                <span>Explore Relevant Services</span>
