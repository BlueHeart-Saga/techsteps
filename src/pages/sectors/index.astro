---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import HeroHeader from '../../components/global/HeroHeader.astro';
import CommonCTA from '../../components/global/CommonCTA.astro';
import { getSectors, getDivisions, getSectorsPage } from '../../lib/sanity/client';

const breadcrumbs = [
  { name: 'Sectors', url: '/sectors' },
];

const [sectors, divisions, sectorsPage] = await Promise.all([
  getSectors(),
  getDivisions(),
  getSectorsPage(),
]);

// Verified four core sectors in preferred display order with background photography
const coreSectors = [
  {
    slug: 'defence',
    title: 'Defence',
    tagline: 'Secure technology and information lifecycle solutions for organisations operating in highly controlled environments.',
    accent: '#0F623A',
    icon: 'shield-check',
    image: '/images/sectors/defence.jpg',
  },
  {
    slug: 'nhs',
    title: 'NHS & Healthcare',
    tagline: 'Responsible IT asset, information and destruction solutions supporting healthcare organisations and NHS Trusts.',
    accent: '#005EB8',
    icon: 'heart',
    image: '/images/sectors/nhs.jpg',
  },
  {
    slug: 'finance',
    title: 'Financial Services',
    tagline: 'Secure lifecycle management for technology and information where security and accountability are paramount.',
    accent: '#0F623A',
    icon: 'building',
    image: '/images/sectors/finance.jpg',
  },
  {
    slug: 'central-government',
    title: 'Central Government',
    tagline: 'Controlled technology and information lifecycle services aligned with public sector requirements and frameworks.',
    accent: '#0A331E',
    icon: 'landmark',
    image: '/images/sectors/government.jpg',
  },
  {
    slug: 'education-universities',
    title: 'Education & Universities',
    tagline: 'Campus IT refreshes, student data sanitisation, laboratory relocations & BS 10008 academic archive digitization.',
    accent: '#1D4ED8',
    icon: 'academic-cap',
    image: '/images/sectors/education.jpg',
  },
  {
    slug: 'legal-professional-services',
    title: 'Legal & Professional Services',
    tagline: 'SRA-aligned confidentiality, litigation bundle digitization, deep vault storage & on-site hard drive destruction.',
    accent: '#991B1B',
    icon: 'scale',
    image: '/images/sectors/legal.jpg',
  },
  {
    slug: 'manufacturing-engineering',
    title: 'Manufacturing & Engineering',
    tagline: 'CAD/CAM blueprint protection, industrial control ITAD, prototype destruction & clean production lab relocations.',
    accent: '#0F766E',
    icon: 'cog',
    image: '/images/sectors/manufacturing.jpg',
  },
  {
    slug: 'it-technology',
    title: 'IT & Technology',
    tagline: 'Hyperscale data centre de-racking, NIST 800-88 certified mass erasure, zero landfill & server remarketing.',
    accent: '#065F46',
    icon: 'server',
    image: '/images/sectors/technology.jpg',
  },
];

// Lifecycle steps with enterprise ITAD photography matching reference workflow
const defaultLifecycleSteps = [
  {
    step: 'Collect',
    desc: 'Secure, GPS-tracked collection by BS 7858 vetted personnel.',
    image: '/images/services/process-step-1-collect.jpg',
  },
  {
    step: 'Secure',
    desc: 'Controlled handling and high-security chain of custody.',
    image: '/images/services/process-step-2-secure.jpg',
  },
  {
    step: 'Sanitise',
    desc: 'ADISA-certified data erasure, degaussing or physical shredding.',
    image: '/images/services/process-step-3-sanitise.jpg',
  },
  {
    step: 'Reuse',
    desc: 'Refurbishment and remarketing to maximise asset value.',
    image: '/images/services/process-step-4-reuse.jpg',
  },
  {
    step: 'Recycle',
    desc: 'Zero-landfill, WEEE-compliant responsible recycling.',
    image: '/images/services/process-step-5-recycle.jpg',
  },
  {
    step: 'Report',
    desc: 'Complete audit trails, serialized certificates and ESG reporting.',
    image: '/images/services/process-step-6-report.jpg',
  },
];

const lifecycleSteps = sectorsPage?.lifecycle?.steps?.length
  ? sectorsPage.lifecycle.steps.map((s, idx) => ({
      step: s.step || defaultLifecycleSteps[idx]?.step || '',
      desc: s.desc || defaultLifecycleSteps[idx]?.desc || '',
      image: s.image || defaultLifecycleSteps[idx]?.image || '/images/services/process-step-1-collect.jpg',
    }))
  : defaultLifecycleSteps;


// Service category cards
const serviceCategories = [
  {
    title: 'IT Lifecycle',
    items: 'ITAD · Disposal · Data Destruction · Recycling',
    href: '/services/it-asset-disposition-services',
    image: '/images/services/1.webp',
    icon: 'cpu',
  },
  {
    title: 'Information Management',
    items: 'Storage · Scanning · Records Management',
    href: '/services/document-storage',
    image: '/images/services/2.webp',
    icon: 'folder',
  },
  {
    title: 'Secure Destruction',
    items: 'Hard Drive · Media · Document Shredding',
    href: '/services/ultra-secure-hard-drive-destruction',
    image: '/images/services/3.webp',
    icon: 'shield',
  },
  {
    title: 'Relocation',
    items: 'IT Moves · Data Centre · Technology Logistics',
    href: '/services/it-relocations-specialist',
    image: '/images/services/4.webp',
    icon: 'truck',
  },
];

// 3 sets of categories for seamless infinite rotating carousel
const repeatedCategories = [...serviceCategories, ...serviceCategories, ...serviceCategories];

// Accreditations & Certifications (comprehensive compliance register with official logos)
const accreditations = [
  { name: 'BSI Kitemark™',  logo: '/images/certifications/bsi-kitemark.png' },
  { name: 'NCSC CAS Certified', logo: '/images/certifications/cas-sanitisation.jpg' },
  { name: 'ISO 27001', logo: '/images/certifications/iso-27001.png' },
  { name: 'ISO 9001', logo: '/images/certifications/iso-9001.png' },
  { name: 'ISO 14001', logo: '/images/certifications/iso-14001.png' },
  { name: 'BS 7858:2012', logo: '/images/certifications/bs-7858.png' },
  { name: 'BS EN 15713', logo: '/images/certifications/bs-en-15713.png' },
  { name: 'ISO 45001', logo: '/images/certifications/iso-45001.png' },
  { name: 'Blancco Certified', logo: '/images/certifications/blancco.jpg' },
  { name: 'Cyber Essentials Plus', logo: '/images/certifications/cyber-essentials-plus.png' },
  { name: 'Crown Commercial Service', logo: '/images/certifications/crown-commercial.png' },
  { name: 'NHS IG Toolkit / DSPT', logo: '/images/certifications/nhs.png' },
  { name: 'Environment Agency', logo: '/images/certifications/environment-agency.png' },
  { name: 'EcoVadis Sustainability', logo: '/images/certifications/ecovadis.png' },
  { name: 'Committed to Equality', logo: '/images/certifications/equality.png' },
  { name: 'PCI DSS Compliant', logo: '/images/certifications/pci-dss.png' },
  { name: 'King’s Award Enterprise', logo: '/images/certifications/kings-award.jpg' },
  { name: 'Diamond Membership', logo: '/images/certifications/diamond-member.png' },
];
---

<BaseLayout
  title={sectorsPage.metaTitle || "Sector Expertise | IT Lifecycle Solutions for Defence, NHS, Finance & Government | Techsteps"}
  description={sectorsPage.metaDescription || "Specialist information management, IT lifecycle, secure destruction and relocation solutions tailored for the requirements of Defence, NHS, Financial Services and Central Government."}
  hasHeroHeader={true}
>
  <!-- =========================
       1. SECTORS HERO SECTION
       Featuring /images/hero/Sector hero.webp
  ========================= -->
  <section
    id="sectors-hero"
    class="relative w-full bg-white select-none border-b border-slate-100"
  >
    <!-- Top Hero Header (Integrated light hero navbar) -->
    <HeroHeader isHome={true} />

    <!-- Hero Content in same container as header -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative w-full min-h-[460px] sm:min-h-[500px] lg:min-h-[560px] flex flex-col justify-center">

        <!-- Contained Image Wrapper (ends at right edge of header container) -->
        <div class="absolute inset-y-0 right-0 w-full lg:w-[62%] overflow-hidden pointer-events-none select-none z-0">
          <img
            src="/images/hero/Sector hero.webp"
            alt="Sector IT Lifecycle and Information Governance - TechSteps UK"
            aria-hidden="true"
            class="w-full h-full object-cover object-right pointer-events-none select-none"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/30 lg:via-white/10 to-transparent pointer-events-none"></div>
          <div class="absolute inset-y-0 right-0 w-1/4 bg-gradient-to-l from-white via-white/70 to-transparent pointer-events-none"></div>
        </div>

        <!-- Main Hero Content Container -->
        <div
          class="relative z-10 w-full
                 pt-4 sm:pt-8 lg:pt-12 xl:pt-14
                 pb-6 sm:pb-8 lg:pb-10"
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-10 items-center">

        <!-- HERO CONTENT (Left) -->
        <div class="lg:col-span-6 xl:col-span-6 max-w-2xl lg:max-w-none pt-2 sm:pt-4 z-10">

          <!-- Breadcrumb Navigation -->
          <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-semibold text-slate-600 mb-3 sm:mb-4">
            <a href="/" class="text-slate-700 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
              Home
            </a>
            <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
            <span class="text-slate-900 font-bold">Sectors</span>
          </nav>

          <!-- Eyebrow Badge -->
          {/*<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0F623A]/10 text-[#0F623A] text-xs sm:text-sm font-sans font-bold uppercase tracking-[0.18em] mb-3 sm:mb-4">
            <span>{sectorsPage.hero?.eyebrow || 'SECTOR EXPERTISE'}</span>
          </div>*/}

          <!-- Heading -->
          <h1
            class="font-display
                   text-3xl sm:text-4xl md:text-5xl lg:text-[50px] xl:text-[56px]
                   font-semibold
                   text-slate-900
                   tracking-normal
                   leading-[1.12] sm:leading-[1.1]
                   max-w-xl"
          >
            {sectorsPage.hero?.title || 'Sector-Specific ITAD & Governance'}
          </h1>

          <!-- Description -->
          <p
            class="mt-4 sm:mt-5
                   text-lg sm:text-xl lg:text-lg
                   text-black
                   max-w-lg
                   leading-relaxed
                   font-sans font-normal"
          >
            {sectorsPage.hero?.subheading || 'Specialist information, IT lifecycle, destruction and relocation solutions designed around the strict compliance and security requirements of your organisation.'}
          </p>

          <!-- CTA Buttons -->
          <div
            class="mt-6 sm:mt-8
                   flex flex-wrap
                   items-center
                   gap-3.5 sm:gap-4"
          >
            <a
              href={sectorsPage.hero?.primaryButtonLink || "/request-a-quote"}
              class="inline-flex items-center justify-center
                     gap-2.5
                     px-6 sm:px-7
                     py-3 sm:py-3.5
                     rounded-none
                     bg-[#0F623A] hover:bg-[#0c4e2e]
                     text-white
                     text-sm sm:text-base
                     font-bold
                     shadow-md hover:shadow-lg
                     transition-all duration-200
                     hover:scale-[1.02]
                     focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
            >
              <span>{sectorsPage.hero?.primaryButtonText || "Request Sector Consultation"}</span>
              <svg
                class="w-4 h-4 text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M14 5l7 7m0 0l-7 7m7-7H3"
                />
              </svg>
            </a>

            <a
              href={sectorsPage.hero?.secondaryButtonLink || "#sector-intro"}
              class="inline-flex items-center justify-center
                     px-6 sm:px-7
                     py-3 sm:py-3.5
                     rounded-none
                     bg-white hover:bg-slate-50
                     border-2 border-[#0F623A] hover:border-[#0c4e2e]
                     text-[#0F623A] hover:text-[#0c4e2e]
                     text-sm sm:text-base
                     font-bold
                     transition-all duration-200
                     hover:scale-[1.02]
                     shadow-xs
                     focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
            >
              {sectorsPage.hero?.secondaryButtonText || "Explore Sectors"}
            </a>
          </div>

          <!-- Mobile & Tablet Visual Stack (Below Text on <lg) -->
          <div class="lg:hidden w-full flex justify-center items-center mt-8 sm:mt-10">
            <div class="relative w-full max-w-[480px]">
              <img
                src="/images/hero/Sector hero.webp"
                alt="Sector IT Lifecycle and Information Governance - TechSteps UK"
                class="w-full h-auto object-contain drop-shadow-md select-none mx-auto block rounded-2xl"
                loading="eager"
                decoding="sync"
              />
            </div>
          </div>

        </div>

        <!-- HERO SPACER (Right on Desktop) -->
        <div class="hidden lg:flex lg:col-span-6 xl:col-span-6 items-center justify-end min-h-[420px] lg:min-h-[480px] xl:min-h-[520px] pointer-events-none" aria-hidden="true">
        </div>

      </div>
    </div>
  </div>
  </div>
</section>

  <!-- ===== 1. SECTOR EXPERTISE INTRO ===== -->
  <section id="sector-intro" class="relative bg-[#F8FAF7] py-8 sm:py-10 lg:py-12 overflow-hidden border-b border-slate-200/80">
    <!-- Ambient subtle glow behind pillars -->
    <div class="absolute -top-24 right-0 w-96 h-96 rounded-full bg-emerald-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <Container>
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left text narrative (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          {/*<div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-600/20 text-[#0F623A] text-xs font-mono font-bold uppercase tracking-widest">
            <span class="w-2 h-2 rounded-full bg-[#0F623A] animate-pulse"></span>
            <span>{sectorsPage.intro?.badge || "Our Approach & Framework"}</span>
          </div>*/}

          <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-semibold text-slate-900 tracking-tight leading-[1.15] font-display">
            {sectorsPage.intro?.heading || "Solutions Built Around Your Organisation"}
          </h2>

          <p class="text-black leading-relaxed text-lg sm:text-xl">
            {sectorsPage.intro?.description || "Every sector has different requirements for security, compliance, information management and technology. Techsteps brings together the expertise and certified services needed to manage those requirements throughout the asset lifecycle."}
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href="/service"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm font-bold shadow-md hover:shadow-lg transition-all duration-200"
            >
              <span>Explore Services</span>
              <span>&rarr;</span>
            </a>
            <a
              href="/contact"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 text-sm font-bold shadow-xs hover:shadow-md transition-all duration-200"
            >
              <span>Contact Us</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-4 border-t border-slate-200/80 flex flex-wrap items-center gap-4 text-xs sm:text-sm font-bold text-slate-700">
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
              ADISA 8.0 Sanitisation
            </span>
            <span class="text-slate-300">&bull;</span>
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
              100% Vetted UK Team
            </span>
            <span class="text-slate-300">&bull;</span>
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
              Zero-Landfill Scope 3
            </span>
          </div>
        </div>

        <!-- Right: 4 Cohesive Pillar Cards (7 cols) -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
          {[
            {
              label: 'Security',
              icon: 'lock',
              desc: 'Uncompromising chain of custody, GPS-tracked transit, and ADISA-certified data destruction throughout.',
            },
            {
              label: 'Lifecycle',
              icon: 'cycle',
              desc: 'End-to-end IT asset management from serialised on-site collection to itemised audit certificates.',
            },
            {
              label: 'Responsibility',
              icon: 'leaf',
              desc: 'Guaranteed zero-landfill processing with circular economy value recovery and Scope 3 carbon reporting.',
            },
            {
              label: 'Expertise',
              icon: 'star',
              desc: 'Sector-specific clearance and accredited capabilities tailored for NHS, Defence, Finance and Gov.',
            },
          ].map((p) => (
            <div class="group relative p-6 sm:p-7 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-xl hover:border-[#0F623A]/40 transition-all duration-300 flex flex-col justify-between space-y-4 hover:-translate-y-1">
              <div class="flex items-center justify-between">
                <div class="h-11 w-11 rounded-xl bg-[#0F623A]/10 border border-[#0F623A]/20 flex items-center justify-center text-[#0F623A] group-hover:bg-[#0F623A] group-hover:text-white transition-colors duration-300">
                  {p.icon === 'lock' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor"/><path d="M7 11V7a5 5 0 0110 0v4" stroke="currentColor" stroke-linecap="round"/>
                    </svg>
                  )}
                  {p.icon === 'cycle' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                  )}
                  {p.icon === 'leaf' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 3s2 8 0 12c0 0 4-2 8-2 5.523 0 8 3 8 3S19 4.5 5 3zM5 15s2 3 2 6"/>
                    </svg>
                  )}
                  {p.icon === 'star' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                    </svg>
                  )}
                </div>
                <span class="text-xs font-mono font-bold text-slate-400 group-hover:text-[#0F623A] transition-colors">{p.num}</span>
              </div>
              <div class="space-y-1.5">
                <h3 class="text-base sm:text-lg font-semibold text-slate-900 font-display">{p.label}</h3>
                <p class="text-base text-black leading-relaxed">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

<!-- ===== 2. SECTORS WE SERVE — Hover Reveal Cards ===== -->
<section class="bg-[#F2F8F5] py-8 lg:py-12 border-t border-slate-200">
  <Container>
    <div class="text-center mb-14">
      {/*<span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#0F623A] mb-3 font-mono">
        {sectorsPage.sectorsSection?.eyebrow || "Industries"}
      </span>*/}

      <h2 class="text-3xl sm:text-4xl font-semibold text-slate-900 tracking-tight font-display">
        {sectorsPage.sectorsSection?.heading || "Sectors We Serve"}
      </h2>

      <p class="mt-4 text-lg text-black max-w-xl mx-auto leading-relaxed font-sans">
        {sectorsPage.sectorsSection?.description || "Built around the specific security, compliance and operational requirements of regulated industries."}
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
      {coreSectors.map((sector) => (
        <a
          href={`/sectors/${sector.slug}`}
          class="group relative rounded-none overflow-hidden border border-slate-300/80 hover:border-[#0F623A] shadow-md hover:shadow-2xl transition-all duration-500 bg-[#0B0F0D] min-h-[320px] sm:min-h-[340px] flex flex-col justify-end p-8 lg:p-10"
        >
          <!-- Background Image -->
          <img
            src={sector.image}
            alt={`${sector.title} sector IT solutions`}
            class="absolute inset-0 w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-110"
            loading="lazy"
          />

          <!-- Dark Gradient Overlay -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#0B0F0D]/95 via-[#0B0F0D]/60 to-[#0B0F0D]/20 transition-all duration-500 group-hover:from-[#0B0F0D] group-hover:via-[#0B0F0D]/80 group-hover:to-[#0B0F0D]/50"></div>

          <div class="relative z-10">
            <!-- Title: Always Visible -->
            <h3 class="text-2xl sm:text-3xl font-semibold text-white leading-tight font-display transition-colors duration-300 group-hover:text-[#0F623A]">
              {sector.title}
            </h3>

            <!-- Description and Link: Visible Only on Hover -->
            <div class="grid transition-all duration-500 ease-out grid-rows-[0fr] opacity-0 translate-y-4 group-hover:grid-rows-[1fr] group-hover:opacity-100 group-hover:translate-y-0">
              <div class="overflow-hidden">
                <p class="text-sm sm:text-[15px] text-slate-200/90 leading-relaxed max-w-md mt-2.5 mb-6 font-sans">
                  {sector.tagline}
                </p>

                <span class="inline-flex items-center gap-2 text-sm font-bold text-white group-hover:gap-3 transition-all duration-200 font-sans">
                  <span>Explore {sector.title}</span>
                  <span class="text-base">&rarr;</span>
                </span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </Container>
</section>

  <!-- ===== 3. SECURITY-FIRST APPROACH ===== -->
  <section class="bg-white py-8 lg:py-12 border-t border-slate-100">
    <Container>
      <div class="max-w-2xl mx-auto text-center mb-14">
        {/*<span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#2D6A4F] mb-4">Our Philosophy</span>*/}
        <h2 class="text-3xl sm:text-4xl font-semibold text-slate-900 tracking-tight">
          Security Is Part of Every Lifecycle
        </h2>
        <p class="mt-4 text-lg text-black leading-relaxed">
          Whatever your sector, our approach is built around three consistent principles.
        </p>
      </div>

