---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import PageHero from '../../components/hero/PageHero.astro';
import { sectors, divisions } from '../../lib/sanity/data';

const breadcrumbs = [
  { name: 'Sectors', url: '/sectors' },
];

// Verified four core sectors in preferred display order with background photography
const coreSectors = [
  {
    slug: 'defence',
    title: 'Defence',
    tagline: 'Secure technology and information lifecycle solutions for organisations operating in highly controlled environments.',
    accent: '#0F623A',
    icon: 'shield-check',
    image: '/images/sectors/defence.jpg',
  },
  {
    slug: 'nhs',
    title: 'NHS & Healthcare',
    tagline: 'Responsible IT asset, information and destruction solutions supporting healthcare organisations and NHS Trusts.',
    accent: '#005EB8',
    icon: 'heart',
    image: '/images/sectors/nhs.jpg',
  },
  {
    slug: 'finance',
    title: 'Financial Services',
    tagline: 'Secure lifecycle management for technology and information where security and accountability are paramount.',
    accent: '#0F623A',
    icon: 'building',
    image: '/images/sectors/finance.jpg',
  },
  {
    slug: 'central-government',
    title: 'Central Government',
    tagline: 'Controlled technology and information lifecycle services aligned with public sector requirements and frameworks.',
    accent: '#0A331E',
    icon: 'landmark',
    image: '/images/sectors/government.jpg',
  },
  {
    slug: 'education-universities',
    title: 'Education & Universities',
    tagline: 'Campus IT refreshes, student data sanitisation, laboratory relocations & BS 10008 academic archive digitization.',
    accent: '#1D4ED8',
    icon: 'academic-cap',
    image: '/images/sectors/education.jpg',
  },
  {
    slug: 'legal-professional-services',
    title: 'Legal & Professional Services',
    tagline: 'SRA-aligned confidentiality, litigation bundle digitization, deep vault storage & on-site hard drive destruction.',
    accent: '#991B1B',
    icon: 'scale',
    image: '/images/sectors/legal.jpg',
  },
  {
    slug: 'manufacturing-engineering',
    title: 'Manufacturing & Engineering',
    tagline: 'CAD/CAM blueprint protection, industrial control ITAD, prototype destruction & clean production lab relocations.',
    accent: '#0F766E',
    icon: 'cog',
    image: '/images/sectors/manufacturing.jpg',
  },
  {
    slug: 'it-technology',
    title: 'IT & Technology',
    tagline: 'Hyperscale data centre de-racking, NIST 800-88 certified mass erasure, zero landfill & server remarketing.',
    accent: '#065F46',
    icon: 'server',
    image: '/images/sectors/technology.jpg',
  },
];

// Lifecycle steps
const lifecycleSteps = [
  { step: 'Collect', desc: 'Secure, GPS-tracked collection by BS 7858 vetted personnel.' },
  { step: 'Secure', desc: 'Controlled handling and high-security chain of custody.' },
  { step: 'Sanitise', desc: 'ADISA-certified data erasure, degaussing or physical shredding.' },
  { step: 'Reuse', desc: 'Refurbishment and remarketing to maximise asset value.' },
  { step: 'Recycle', desc: 'Zero-landfill, WEEE-compliant responsible recycling.' },
  { step: 'Report', desc: 'Complete audit trails, serialized certificates and ESG reporting.' },
];

// Service category cards
const serviceCategories = [
  {
    title: 'IT Lifecycle',
    items: 'ITAD · Disposal · Data Destruction · Recycling',
    href: '/services/it-asset-disposition-services',
    image: '/images/services/image2.jpg',
    icon: 'cpu',
  },
  {
    title: 'Information Management',
    items: 'Storage · Scanning · Records Management',
    href: '/services/document-storage',
    image: '/images/services/image1.png',
    icon: 'folder',
  },
  {
    title: 'Secure Destruction',
    items: 'Hard Drive · Media · Document Shredding',
    href: '/services/ultra-secure-hard-drive-destruction',
    image: '/images/services/image3_web.jpg',
    icon: 'shield',
  },
  {
    title: 'Relocation',
    items: 'IT Moves · Data Centre · Technology Logistics',
    href: '/services/it-relocations-specialist',
    image: '/images/services/image4.jpg',
    icon: 'truck',
  },
];

// 3 sets of categories for seamless infinite rotating carousel
const repeatedCategories = [...serviceCategories, ...serviceCategories, ...serviceCategories];

// Accreditations & Certifications (comprehensive compliance register with official logos)
const accreditations = [
  { name: 'BSI Kitemark™', note: 'Remanufactured IT Devices', logo: '/images/certifications/bsi-kitemark.png' },
  { name: 'NCSC CAS Certified', note: 'Government Security Scheme', logo: '/images/certifications/cas-sanitisation.jpg' },
  { name: 'ISO 27001', note: 'Information Security Management', logo: '/images/certifications/iso-27001.png' },
  { name: 'ISO 9001', note: 'Quality Management Systems', logo: '/images/certifications/iso-9001.png' },
  { name: 'ISO 14001', note: 'Environmental Management', logo: '/images/certifications/iso-14001.png' },
  { name: 'BS 7858:2012', note: 'Security Screening of Personnel', logo: '/images/certifications/bs-7858.png' },
  { name: 'BS EN 15713', note: 'Secure Destruction of Material', logo: '/images/certifications/bs-en-15713.png' },
  { name: 'ISO 45001', note: 'Health & Safety Management', logo: '/images/certifications/iso-45001.png' },
  { name: 'Blancco Certified', note: 'Industry Standard Data Erasure', logo: '/images/certifications/blancco.jpg' },
  { name: 'Cyber Essentials Plus', note: 'NCSC Government-Backed Cyber', logo: '/images/certifications/cyber-essentials-plus.png' },
  { name: 'Crown Commercial Service', note: 'CCS Framework Supplier', logo: '/images/certifications/crown-commercial.png' },
  { name: 'NHS IG Toolkit / DSPT', note: 'Data Security & Protection', logo: '/images/certifications/nhs.png' },
  { name: 'Environment Agency', note: 'Approved AATF Waste Carrier', logo: '/images/certifications/environment-agency.png' },
  { name: 'EcoVadis Sustainability', note: 'Business Sustainability Rating', logo: '/images/certifications/ecovadis.png' },
  { name: 'Committed to Equality', note: 'Diversity & Equality Standard', logo: '/images/certifications/equality.png' },
  { name: 'PCI DSS Compliant', note: 'Cardholder Data Security', logo: '/images/certifications/pci-dss.png' },
  { name: 'King’s Award Enterprise', note: 'Promoting Opportunity & ESG', logo: '/images/certifications/kings-award.jpg' },
  { name: 'Diamond Membership', note: 'Verified Quality & Warranty', logo: '/images/certifications/diamond-member.png' },
];
---

<BaseLayout
  title="Sector Expertise | IT Lifecycle Solutions for Defence, NHS, Finance & Government | Techsteps"
  description="Specialist information management, IT lifecycle, secure destruction and relocation solutions tailored for the requirements of Defence, NHS, Financial Services and Central Government."
  hasHeroHeader={true}
>
  <!-- ===== EXISTING HERO — KEPT UNCHANGED ===== -->
  <PageHero
    title="Sectors"
    eyebrow="SECTOR EXPERTISE"
    subheading="Specialist information, IT lifecycle, destruction and relocation solutions designed around the requirements of your organisation."
    breadcrumbs={breadcrumbs}
    dividerColor="#ffffff"
    bgImage="/images/brand/sectors-hero-bg.jpg"
  >
    <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
      <a
        href="/request-a-quote"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm font-bold shadow-lg transition-all duration-200"
      >
        Request Sector Consultation
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
        </svg>
      </a>
      <a
        href="#sector-intro"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-sm font-bold border border-white/20 transition-all duration-200"
      >
        Explore Sectors
      </a>
    </div>
  </PageHero>

  <!-- ===== 1. SECTOR EXPERTISE INTRO ===== -->
  <section class="relative bg-[#F8FAF7] py-16 sm:py-20 lg:py-24 overflow-hidden border-b border-slate-200/80">
    <!-- Ambient subtle glow behind pillars -->
    <div class="absolute -top-24 right-0 w-96 h-96 rounded-full bg-emerald-100/40 blur-3xl pointer-events-none" aria-hidden="true"></div>

    <Container>
      <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left text narrative (5 cols) -->
        <div class="lg:col-span-5 space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-600/20 text-[#0F623A] text-xs font-mono font-bold uppercase tracking-widest">
            <span class="w-2 h-2 rounded-full bg-[#0F623A] animate-pulse"></span>
            <span>Our Approach & Framework</span>
          </div>

          <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold text-slate-900 tracking-tight leading-[1.15] font-display">
            Solutions Built Around <span class="text-[#0F623A]">Your Organisation</span>
          </h2>

          <p class="text-slate-600 leading-relaxed text-base sm:text-lg">
            Every sector has different requirements for security, compliance, information management and technology. Techsteps brings together the expertise and certified services needed to manage those requirements throughout the asset lifecycle.
          </p>

          <div class="pt-2 flex flex-wrap items-center gap-3">
            <a
              href="/contact"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm font-bold shadow-md hover:shadow-lg transition-all duration-200"
            >
              <span>Discuss Your Requirements</span>
              <span>&rarr;</span>
            </a>
            <a
              href="/services"
              class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-800 text-sm font-bold shadow-xs hover:shadow-md transition-all duration-200"
            >
              <span>Explore Services</span>
            </a>
          </div>

          <!-- Trust Badges -->
          <div class="pt-4 border-t border-slate-200/80 flex flex-wrap items-center gap-4 text-xs sm:text-sm font-bold text-slate-700">
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
              ADISA 8.0 Sanitisation
            </span>
            <span class="text-slate-300">&bull;</span>
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
              100% Vetted UK Team
            </span>
            <span class="text-slate-300">&bull;</span>
            <span class="inline-flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
              Zero-Landfill Scope 3
            </span>
          </div>
        </div>

        <!-- Right: 4 Cohesive Pillar Cards (7 cols) -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-5">
          {[
            {
              num: '01',
              label: 'Security',
              icon: 'lock',
              desc: 'Uncompromising chain of custody, GPS-tracked transit, and ADISA-certified data destruction throughout.',
            },
            {
              num: '02',
              label: 'Lifecycle',
              icon: 'cycle',
              desc: 'End-to-end IT asset management from serialised on-site collection to itemised audit certificates.',
            },
            {
              num: '03',
              label: 'Responsibility',
              icon: 'leaf',
              desc: 'Guaranteed zero-landfill processing with circular economy value recovery and Scope 3 carbon reporting.',
            },
            {
              num: '04',
              label: 'Expertise',
              icon: 'star',
              desc: 'Sector-specific clearance and accredited capabilities tailored for NHS, Defence, Finance and Gov.',
            },
          ].map((p) => (
            <div class="group relative p-6 sm:p-7 rounded-2xl bg-white border border-slate-200 shadow-sm hover:shadow-xl hover:border-[#0F623A]/40 transition-all duration-300 flex flex-col justify-between space-y-4 hover:-translate-y-1">
              <div class="flex items-center justify-between">
                <div class="h-11 w-11 rounded-xl bg-[#0F623A]/10 border border-[#0F623A]/20 flex items-center justify-center text-[#0F623A] group-hover:bg-[#0F623A] group-hover:text-white transition-colors duration-300">
                  {p.icon === 'lock' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <rect x="3" y="11" width="18" height="11" rx="2" stroke="currentColor"/><path d="M7 11V7a5 5 0 0110 0v4" stroke="currentColor" stroke-linecap="round"/>
                    </svg>
                  )}
                  {p.icon === 'cycle' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
                    </svg>
                  )}
                  {p.icon === 'leaf' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 3s2 8 0 12c0 0 4-2 8-2 5.523 0 8 3 8 3S19 4.5 5 3zM5 15s2 3 2 6"/>
                    </svg>
                  )}
                  {p.icon === 'star' && (
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/>
                    </svg>
                  )}
                </div>
                <span class="text-xs font-mono font-bold text-slate-400 group-hover:text-[#0F623A] transition-colors">{p.num}</span>
              </div>
              <div class="space-y-1.5">
                <h3 class="text-base sm:text-lg font-bold text-slate-900 font-sans">{p.label}</h3>
                <p class="text-sm text-slate-600 leading-relaxed">{p.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 2. SECTORS WE SERVE — Large Image Cards 2x2 with Sharp Edges ===== -->
  <section class="bg-[#F2F8F5] py-16 lg:py-24 border-t border-slate-200">
    <Container>
      <div class="text-center mb-14">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#0F623A] mb-3 font-mono">Industries</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-display">Sectors We Serve</h2>
        <p class="mt-4 text-base text-slate-600 max-w-xl mx-auto leading-relaxed font-sans">
          Built around the specific security, compliance and operational requirements of regulated industries.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
        {coreSectors.map((sector) => (
          <a
            href={`/sectors/${sector.slug}`}
            class="group relative rounded-none overflow-hidden border border-slate-300/80 hover:border-[#0F623A] shadow-md hover:shadow-2xl transition-all duration-500 bg-[#0B0F0D] min-h-[320px] sm:min-h-[340px] flex flex-col justify-end p-8 lg:p-10"
          >
            <!-- Background Photography with smooth hover zoom -->
            <img
              src={sector.image}
              alt={`${sector.title} sector IT solutions`}
              class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-110 transition-transform duration-700 ease-out"
              loading="lazy"
            />

            <!-- Dark Gradient Vignette for high text contrast -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#0B0F0D] via-[#0B0F0D]/80 to-[#0B0F0D]/40 transition-opacity duration-300"></div>

            <!-- Top Accent Line (Sharp) -->
            <div class="absolute top-0 left-0 right-0 h-1 bg-[#0F623A] opacity-80 group-hover:opacity-100 transition-opacity"></div>

            <div class="relative z-10">
              <span class="inline-block text-[10.5px] font-bold uppercase tracking-[0.18em] text-white/90 mb-3.5 border border-white/30 px-3 py-1 rounded-none bg-black/40 backdrop-blur-xs font-mono">
                Sector Expertise
              </span>
              <h3 class="text-2xl sm:text-3xl font-extrabold text-white leading-tight mb-2.5 font-display group-hover:text-[#0F623A] transition-colors">
                {sector.title}
              </h3>
              <p class="text-sm sm:text-[15px] text-slate-200/90 leading-relaxed max-w-md mb-6 font-sans">
                {sector.tagline}
              </p>
              <span class="inline-flex items-center gap-2 text-sm font-bold text-[#0F623A] group-hover:text-white group-hover:gap-3 transition-all duration-200 font-sans">
                <span>Explore {sector.title}</span>
                <span class="text-base">&rarr;</span>
              </span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== 3. SECURITY-FIRST APPROACH ===== -->
  <section class="bg-white py-16 lg:py-24 border-t border-slate-100">
    <Container>
      <div class="max-w-2xl mx-auto text-center mb-14">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#2D6A4F] mb-4">Our Philosophy</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight">
          Security Is Part of Every Lifecycle
        </h2>
        <p class="mt-4 text-base text-slate-600 leading-relaxed">
          Whatever your sector, our approach is built around three consistent principles.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 lg:gap-10">
        {[
          {
            label: 'Protect',
            number: '01',
            desc: 'Safeguard information and technology throughout the entire process — from first collection through to final certificate.',
            color: '#1B3A5C',
          },
          {
            label: 'Control',
            number: '02',
            desc: 'Maintain appropriate visibility and accountability at every stage. Serialised tracking, chain-of-custody documentation and real-time reporting.',
            color: '#2D6A4F',
          },
          {
            label: 'Responsibly Manage',
            number: '03',
            desc: 'Choose the right outcome for every asset — reuse, remarketing, destruction or recycling — with zero-landfill commitment and ESG reporting.',
            color: '#375647',
          },
        ].map((principle) => (
          <div class="relative group">
            <div class="absolute -top-3 -left-1 text-[72px] font-black text-slate-100 select-none leading-none pointer-events-none group-hover:text-[#2D6A4F]/10 transition-colors duration-300">
              {principle.number}
            </div>
            <div class="relative pt-8 pb-8 px-0 border-t-2 border-slate-200 group-hover:border-[#2D6A4F] transition-colors duration-300">
              <span class="inline-block text-[11px] font-bold uppercase tracking-[0.2em] text-[#2D6A4F] mb-3">{principle.label}</span>
              <p class="text-base text-slate-700 leading-relaxed">{principle.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== 4. LIFECYCLE: COLLECT → REPORT ===== -->
  <section class="bg-[#1a2e1f] py-16 lg:py-20 border-t border-slate-800">
    <Container>
      <div class="text-center mb-14">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-emerald-400 mb-4">Our Process</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          From First Collection to Final Outcome.
        </h2>
        <p class="mt-4 text-base text-slate-400 max-w-xl mx-auto leading-relaxed">
          Whatever the sector, our approach connects security, asset management and responsible lifecycle decisions.
        </p>
      </div>

      <div class="relative">
        <div class="hidden lg:block absolute top-7 left-[8.33%] right-[8.33%] h-px bg-gradient-to-r from-transparent via-emerald-500/40 to-transparent pointer-events-none"></div>
        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-5 lg:gap-4">
          {lifecycleSteps.map((step, i) => (
            <div class="flex flex-col items-center text-center group">
              <div class="relative mb-4">
                <div class="h-14 w-14 rounded-2xl bg-[#2D6A4F]/20 border border-[#2D6A4F]/40 flex items-center justify-center group-hover:bg-[#2D6A4F]/40 group-hover:border-[#2D6A4F] transition-all duration-300">
                  <span class="text-sm font-extrabold text-emerald-300">{String(i + 1).padStart(2, '0')}</span>
                </div>
              </div>
              <p class="text-xs font-bold uppercase tracking-widest text-white mb-2">{step.step}</p>
              <p class="text-[11px] text-slate-400 leading-relaxed">{step.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 5. SPECIALIST SERVICES (Centered Focus Rotating Carousel) ===== -->
  <section class="bg-white py-16 lg:py-24 border-t border-slate-100 overflow-hidden" id="specialist-services-section">
    <Container>
      <!-- Header with Eyebrow & Title (Numbers removed) -->
      <div class="flex flex-col items-center justify-center text-center mb-10 sm:mb-14">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#0F623A] mb-3 font-mono">Capabilities</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight font-display">
          Specialist Services for Your Requirements
        </h2>
      </div>

      <!-- Carousel Outer Stage with Left & Right Arrow Buttons -->
      <div class="relative w-full max-w-6xl mx-auto px-2 sm:px-8">
        <!-- Left Arrow Navigation Button (Rotating) -->
        <button
          type="button"
          id="carousel-prev-btn"
          class="absolute left-0 sm:left-2 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-13 sm:h-13 rounded-full bg-white border border-slate-300 text-slate-800 hover:text-[#0F623A] hover:border-[#0F623A] hover:bg-emerald-50/70 shadow-lg hover:shadow-xl flex items-center justify-center transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[#0F623A] cursor-pointer"
          aria-label="Previous service"
        >
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
          </svg>
        </button>

        <!-- Right Arrow Navigation Button (Rotating) -->
        <button
          type="button"
          id="carousel-next-btn"
          class="absolute right-0 sm:right-2 top-1/2 -translate-y-1/2 z-30 w-11 h-11 sm:w-13 sm:h-13 rounded-full bg-white border border-slate-300 text-slate-800 hover:text-[#0F623A] hover:border-[#0F623A] hover:bg-emerald-50/70 shadow-lg hover:shadow-xl flex items-center justify-center transition-all duration-200 focus:outline-none focus:ring-2 focus:ring-[#0F623A] cursor-pointer"
          aria-label="Next service"
        >
          <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>

        <!-- Carousel Viewport Window -->
        <div id="carousel-viewport" class="overflow-hidden w-full py-6 sm:py-8 [perspective:1200px]" role="region" aria-live="polite" aria-label="Specialist Services Carousel">
          <!-- Horizontal Slides Track -->
          <div
            id="carousel-track"
            class="flex items-center will-change-transform"
          >
            {repeatedCategories.map((cat, index) => (
              <div
                class="carousel-slide w-[86vw] sm:w-[400px] lg:w-[460px] shrink-0 px-2 sm:px-3.5 select-none"
                data-slide-index={index}
                data-category-index={index % serviceCategories.length}
              >
                <a
                  href={cat.href}
                  class="service-card-inner group block relative rounded-3xl p-5 sm:p-7 lg:p-8 border transition-all duration-500 overflow-hidden"
                >
                  <!-- Top Green Accent Line -->
                  <div class="absolute top-0 left-0 right-0 h-1.5 bg-[#0F623A] opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-t-3xl"></div>

                  <!-- Service Image Box (Numbers removed) -->
                  <div class="relative h-48 sm:h-52 w-full rounded-2xl overflow-hidden mb-5 bg-slate-100 border border-slate-200/70">
                    <img
                      src={cat.image}
                      alt={`${cat.title} Specialist Service`}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                      loading="lazy"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-black/20 pointer-events-none"></div>

                    <!-- Floating Icon Badge -->
                    <div class="absolute top-3 left-3 h-11 w-11 rounded-xl bg-white/95 backdrop-blur-xs border border-white/60 flex items-center justify-center text-[#0F623A] shadow-md group-hover:bg-[#0F623A] group-hover:text-white transition-all duration-300">
                      {cat.icon === 'cpu' && (
                        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                          <rect x="4" y="4" width="16" height="16" rx="2" stroke="currentColor"/><rect x="9" y="9" width="6" height="6" stroke="currentColor"/><path d="M9 2v2M15 2v2M9 20v2M15 20v2M2 9h2M2 15h2M20 9h2M20 15h2" stroke="currentColor" stroke-linecap="round"/>
                        </svg>
                      )}
                      {cat.icon === 'folder' && (
                        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M3 7a2 2 0 012-2h4l2 2h8a2 2 0 012 2v8a2 2 0 01-2 2H5a2 2 0 01-2-2V7z"/>
                        </svg>
                      )}
                      {cat.icon === 'shield' && (
                        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                        </svg>
                      )}
                      {cat.icon === 'truck' && (
                        <svg class="w-5 h-5 sm:w-6 sm:h-6" fill="none" stroke="currentColor" stroke-width="1.75" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M1 3h15v13H1V3zm15 5h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="1.5"/><circle cx="18.5" cy="18.5" r="1.5"/>
                        </svg>
                      )}
                    </div>
                  </div>

                  <!-- Title & Service Scope -->
                  <h3 class="text-2xl sm:text-[25px] font-bold text-slate-900 group-hover:text-[#0F623A] transition-colors mb-2 font-display tracking-tight leading-snug">
                    {cat.title}
                  </h3>
                  <p class="text-xs sm:text-[13.5px] text-slate-600 leading-relaxed font-mono mb-6 min-h-[38px]">
                    {cat.items}
                  </p>

                  <!-- Bottom Link -->
                  <div class="inline-flex items-center gap-2 text-sm font-bold text-[#0F623A] group-hover:gap-3 transition-all">
                    <span>Explore {cat.title}</span>
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Bottom Dot Indicators -->
      <div class="flex items-center justify-center gap-2 mt-4 sm:mt-6" aria-hidden="true">
        {serviceCategories.map((_, i) => (
          <button
            type="button"
            class={`carousel-dot h-2 rounded-full transition-all duration-300 cursor-pointer ${
              i === 0 ? 'w-8 bg-[#0F623A]' : 'w-2 bg-slate-300 hover:bg-slate-400'
            }`}
            data-dot-index={i}
            aria-label={`Go to slide ${i + 1}`}
          />
        ))}
      </div>
    </Container>
  </section>

  <script>
    function setupServiceHorizontalCarousel() {
      const section = document.getElementById('specialist-services-section');
      const viewport = document.getElementById('carousel-viewport');
      const track = document.getElementById('carousel-track') as HTMLElement | null;
      const prevBtn = document.getElementById('carousel-prev-btn') as HTMLButtonElement | null;
      const nextBtn = document.getElementById('carousel-next-btn') as HTMLButtonElement | null;
      const slides = document.querySelectorAll('.carousel-slide') as NodeListOf<HTMLElement>;
      const dots = document.querySelectorAll('.carousel-dot') as NodeListOf<HTMLButtonElement>;

      if (!viewport || !track || !prevBtn || !nextBtn || slides.length === 0) return;

      const totalUnique = 4;
      const setLength = 4;
      // Start in the middle set (Set 1, index 4)
      let currentIndex = setLength;
      let isTransitioning = false;

      function updateSlideStyles(index: number) {
        slides.forEach((slide, i) => {
          const cardInner = slide.querySelector('.service-card-inner') as HTMLElement | null;
          if (!cardInner) return;

          const diff = i - index;

          if (diff === 0) {
            // Center active card - prominent, scale 1.0, 0 rotation
            cardInner.style.transform = 'perspective(1000px) rotateY(0deg) scale(1)';
            cardInner.style.opacity = '1';
            cardInner.style.backgroundColor = '#ffffff';
            cardInner.style.borderColor = 'rgba(15, 98, 58, 0.4)';
            cardInner.style.boxShadow = '0 25px 50px -12px rgba(15, 98, 58, 0.22)';
          } else if (diff === 1) {
            // Next card (right side) - angled inward with 3D perspective rotation
            cardInner.style.transform = 'perspective(1000px) rotateY(-8deg) scale(0.88)';
            cardInner.style.opacity = '0.45';
            cardInner.style.backgroundColor = '#f7f8f5';
            cardInner.style.borderColor = 'rgb(226, 232, 240)';
            cardInner.style.boxShadow = '0 4px 6px -1px rgba(0, 0, 0, 0.05)';
          } else if (diff === -1) {
            // Previous card (left side) - angled inward with 3D perspective rotation
            cardInner.style.transform = 'perspective(1000px) rotateY(8deg) scale(0.88)';
            cardInner.style.opacity = '0.45';
            cardInner.style.backgroundColor = '#f7f8f5';
            cardInner.style.borderColor = 'rgb(226, 232, 240)';
            cardInner.style.boxShadow = '0 4px 6px -1px rgba(0, 0, 0, 0.05)';
          } else {
            // Farther cards
            cardInner.style.transform = 'perspective(1000px) scale(0.82)';
            cardInner.style.opacity = '0.2';
            cardInner.style.backgroundColor = '#f7f8f5';
            cardInner.style.borderColor = 'rgb(226, 232, 240)';
            cardInner.style.boxShadow = 'none';
          }
        });

        // Update dot indicators
        const activeCategory = ((index % totalUnique) + totalUnique) % totalUnique;
        dots.forEach((dot, i) => {
          if (i === activeCategory) {
            dot.classList.remove('w-2', 'bg-slate-300');
            dot.classList.add('w-8', 'bg-[#0F623A]');
          } else {
            dot.classList.remove('w-8', 'bg-[#0F623A]');
            dot.classList.add('w-2', 'bg-slate-300');
          }
        });
      }

      function moveTo(index: number, animate = true) {
        if (!track || !viewport) return;
        currentIndex = index;

        if (animate) {
          isTransitioning = true;
          track.style.transition = 'transform 500ms cubic-bezier(0.2, 0.8, 0.2, 1)';
        } else {
          track.style.transition = 'none';
        }

        const activeSlide = slides[currentIndex];
        if (!activeSlide) return;

        const viewportWidth = viewport.offsetWidth;
        const slideOffsetLeft = activeSlide.offsetLeft;
        const slideWidth = activeSlide.offsetWidth;
        const targetTranslate = (viewportWidth / 2) - (slideOffsetLeft + (slideWidth / 2));
        track.style.transform = `translateX(${targetTranslate}px)`;

        updateSlideStyles(currentIndex);
      }

      // Handle seamless infinite wrap-around on transition finish
      track.addEventListener('transitionend', () => {
        isTransitioning = false;
        if (!track) return;

        // If moved into Set 2, silently jump back to Set 1
        if (currentIndex >= setLength * 2) {
          moveTo(currentIndex - setLength, false);
          track.offsetHeight;
        }
        // If moved into Set 0, silently jump forward to Set 1
        else if (currentIndex < setLength) {
          moveTo(currentIndex + setLength, false);
          track.offsetHeight;
        }
      });

      // Next button - rotate cards forward
      nextBtn.onclick = (e) => {
        e.preventDefault();
        if (isTransitioning) return;
        moveTo(currentIndex + 1, true);
      };

      // Prev button - rotate cards backward
      prevBtn.onclick = (e) => {
        e.preventDefault();
        if (isTransitioning) return;
        moveTo(currentIndex - 1, true);
      };

      // Dot buttons
      dots.forEach((dot, i) => {
        dot.onclick = (e) => {
          e.preventDefault();
          if (isTransitioning) return;
          const currentCategory = ((currentIndex % totalUnique) + totalUnique) % totalUnique;
          const diff = i - currentCategory;
          moveTo(currentIndex + diff, true);
        };
      });

      // Clicking neighbouring card rotates it to center
      slides.forEach((slide, i) => {
        slide.onclick = (e) => {
          if (i !== currentIndex) {
            e.preventDefault();
            if (!isTransitioning) {
              moveTo(i, true);
            }
          }
        };
      });

      // Keyboard navigation
      if (section) {
        section.onkeydown = (e) => {
          if (e.key === 'ArrowLeft' && !isTransitioning) {
            moveTo(currentIndex - 1, true);
          } else if (e.key === 'ArrowRight' && !isTransitioning) {
            moveTo(currentIndex + 1, true);
          }
        };
      }

      // Touch / swipe support for mobile
      let touchStartX = 0;
      viewport.addEventListener('touchstart', (e) => {
        touchStartX = e.changedTouches[0].screenX;
      }, { passive: true });

      viewport.addEventListener('touchend', (e) => {
        const touchEndX = e.changedTouches[0].screenX;
        const diff = touchStartX - touchEndX;
        if (Math.abs(diff) > 40 && !isTransitioning) {
          if (diff > 0) {
            moveTo(currentIndex + 1, true);
          } else {
            moveTo(currentIndex - 1, true);
          }
        }
      }, { passive: true });

      // Window resize re-alignment
      window.addEventListener('resize', () => {
        moveTo(currentIndex, false);
      });

      // Initial position without animation
      setTimeout(() => {
        moveTo(setLength, false);
      }, 50);
    }

    document.addEventListener('astro:page-load', setupServiceHorizontalCarousel);
    document.addEventListener('DOMContentLoaded', setupServiceHorizontalCarousel);
    setupServiceHorizontalCarousel();
  </script>

  <!-- ===== 6. TRUST & COMPLIANCE ===== -->
  <section class="bg-[#F2F8F5] py-16 lg:py-24 border-t border-slate-200">
    <Container>
      <div class="max-w-3xl mx-auto text-center mb-12">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#0F623A] mb-3 font-mono">Accreditations</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-slate-900 tracking-tight mb-4 font-display">Aligned with Us.</h2>
        <p class="text-base text-slate-600 leading-relaxed font-sans">
          Our services are designed to help organisations manage technology and information with security, accountability and responsible lifecycle practices.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4 sm:gap-5">
        {accreditations.map((cert) => (
          <div class="group bg-white rounded-none p-5 border border-slate-200/90 hover:border-[#0F623A]/40 hover:shadow-lg transition-all duration-200 text-center flex flex-col items-center justify-between min-h-[170px]">
            <!-- Official Accreditation Logo -->
            <div class="h-14 w-full flex items-center justify-center mb-2 px-1">
              <img
                src={cert.logo}
