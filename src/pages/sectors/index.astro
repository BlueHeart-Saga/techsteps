                class="max-h-12 max-w-[110px] w-auto h-auto object-contain transition-transform duration-300 group-hover:scale-105"
                loading="lazy"
              />
            </div>

            <div class="space-y-1 w-full pt-2 border-t border-slate-100">
              <p class="text-xs sm:text-[13px] font-bold text-slate-900 leading-snug">{cert.name}</p>
              <p class="text-[10px] sm:text-[11px] text-slate-500 font-medium leading-tight">{cert.note}</p>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== 7. FINAL CTA (Clean Open Layout - No Background Box) ===== -->
  <section class="relative z-10 py-16 lg:py-24 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full bg-[#0F623A]/10 blur-3xl pointer-events-none"></div>
    <Container className="relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-xs sm:text-sm font-bold tracking-[0.2em] uppercase text-[#0F623A] mb-4 font-mono">Work With Techsteps</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 mb-5 leading-tight tracking-tight font-display">
          Let's Build the Right Solution<br />for Your Sector.
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-10 font-medium max-w-xl mx-auto">
          Talk to our team about your organisation's technology and information lifecycle requirements.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href="/contact"
            class="px-8 py-4 rounded-xl bg-[#0F623A] hover:bg-[#0c4e2e] text-white font-bold text-sm uppercase tracking-wider transition-all duration-200 shadow-lg hover:shadow-xl transform hover:-translate-y-0.5"
          >
            Get In Touch →
          </a>
          <a
            href="/services"
            class="px-8 py-4 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-900 font-bold text-sm uppercase tracking-wider transition-all duration-200 shadow-xs hover:shadow-md transform hover:-translate-y-0.5"
          >
            Explore Our Services
          </a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>
