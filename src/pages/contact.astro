---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import PageHero from '../components/hero/PageHero.astro';
import { getSiteSettings } from '../lib/sanity/client';

const siteSettings = await getSiteSettings();
import { Map, MapGeoJSON, CustomStyleExample } from '@/components/ui/map';
import { WORLD_GEOJSON } from '@/lib/use-world-data';

const breadcrumbs = [
  { name: 'Contact Us', url: '/contact' },
];
---

<BaseLayout
  title="Contact Techsteps UK | UK Head Office & Sovereign Hub"
  description="Contact Techsteps UK. Reach our UK headquarters in Dartford, Kent, or speak directly with our logistics dispatch and customer compliance teams."
  hasHeroHeader={true}
>
  <!-- 1. HERO SECTION (Matching about-us page hero structure) -->
  <PageHero
    eyebrow="CONTACT US"
    title="Contact us"
    subheading="Techsteps is ready to provide the right solution according to your needs"
    bgImage="/images/brand/contact-hero-bg.jpg"
    breadcrumbs={breadcrumbs}
    dividerColor="#f1f4ef"
  />

  <!-- 2. MAIN CONTACT SECTION (Seamless flow directly after Hero Torn Paper Edge) -->
  <section class="relative bg-[#f1f4ef] pt-8 sm:pt-12 pb-20 sm:pb-24">
    <Container>
      <!-- Main Contact Wrapper (Unboxed, direct on #f1f4ef canvas) -->
      <div class="max-w-6xl mx-auto relative z-30">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-start">
          
          <!-- LEFT COLUMN: Get in touch -->
          <div class="lg:col-span-5 space-y-8">
            <div class="space-y-3">
              <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-slate-900 tracking-tight">
                Get in touch
              </h2>
              <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-medium">
                Reach our UK sovereign headquarters or speak directly with our logistics dispatch and compliance teams.
              </p>
            </div>

            <!-- Contact Information List with Vibrant Round Circle Icons -->
            <div class="space-y-6">
              <!-- Item 1: Head Office -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-[#146B5C] text-white flex items-center justify-center shrink-0 shadow-md">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg font-bold font-display text-slate-900 tracking-tight">
                    Head Office
                  </h3>
                  <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                    {siteSettings.address.street}, {siteSettings.address.city}, {siteSettings.address.county} {siteSettings.address.postcode}
                  </p>
                </div>
              </div>

              <!-- Item 2: Email Us -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-[#146B5C] text-white flex items-center justify-center shrink-0 shadow-md">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg font-bold font-display text-slate-900 tracking-tight">
                    Email Us
                  </h3>
                  <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                    <a href={`mailto:${siteSettings.email}`} class="hover:text-[#146B5C] transition-colors block">
                      {siteSettings.email}
                    </a>
                  </p>
                </div>
              </div>

              <!-- Item 3: Call Us -->
              <div class="flex items-start gap-4">
                <div class="w-12 h-12 rounded-full bg-[#146B5C] text-white flex items-center justify-center shrink-0 shadow-md">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg font-bold font-display text-slate-900 tracking-tight">
                    Call Us
                  </h3>
                  <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                    Phone : <a href={`tel:${siteSettings.phone.replace(/[^0-9+]/g, '')}`} class="hover:text-[#146B5C] font-bold text-slate-900">{siteSettings.phone}</a><br />
                    Freephone : <a href="tel:08000834700" class="hover:text-[#146B5C] font-bold text-slate-900">0800 083 4700</a>
                  </p>
                </div>
              </div>
            </div>

            <!-- Follow our social media -->
            <div class="pt-4 space-y-3 border-t border-slate-200">
              <h4 class="text-base font-bold text-slate-900 tracking-tight">
                Follow our social media
              </h4>
              <div class="flex items-center gap-3">
                <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#146B5C] text-white flex items-center justify-center hover:bg-[#0D5549] transition-all hover:scale-105 shadow-xs" aria-label="LinkedIn">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.75a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9z"/></svg>
                </a>
                <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#146B5C] text-white flex items-center justify-center hover:bg-[#0D5549] transition-all hover:scale-105 shadow-xs" aria-label="Twitter X">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                </a>
                <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#146B5C] text-white flex items-center justify-center hover:bg-[#0D5549] transition-all hover:scale-105 shadow-xs" aria-label="Facebook">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/></svg>
                </a>
                <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#146B5C] text-white flex items-center justify-center hover:bg-[#0D5549] transition-all hover:scale-105 shadow-xs" aria-label="YouTube">
                  <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
                </a>
              </div>
            </div>
          </div>

          <!-- RIGHT COLUMN: Send us a message -->
          <div class="lg:col-span-7 space-y-6">
            <div class="space-y-2">
              <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-slate-900 tracking-tight">
                Send us a message
              </h2>
            </div>

            <form
              name="contact-enquiry"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="space-y-6"
              id="techsteps-contact-form"
            >
              <p class="hidden">
                <label>Don't fill this out if you're human: <input name="bot-field" /></label>
              </p>
              <input type="hidden" name="form-name" value="contact-enquiry" />

              <!-- Row 1: Name & Company -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="space-y-1.5">
                  <label for="contact-name" class="block text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-800">
                    Name <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="text"
                    id="contact-name"
                    name="name"
                    required
                    placeholder="Enter your name"
                    class="w-full px-1 py-2.5 bg-transparent border-0 border-b-2 border-slate-300 focus:border-[#146B5C] text-base font-semibold text-slate-900 placeholder:text-slate-400 outline-none transition-colors duration-200 rounded-none"
                  />
                </div>

                <div class="space-y-1.5">
                  <label for="contact-company" class="block text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-800">
                    Company
                  </label>
                  <input
                    type="text"
                    id="contact-company"
                    name="company"
                    placeholder="Enter company name"
                    class="w-full px-1 py-2.5 bg-transparent border-0 border-b-2 border-slate-300 focus:border-[#146B5C] text-base font-semibold text-slate-900 placeholder:text-slate-400 outline-none transition-colors duration-200 rounded-none"
                  />
                </div>
              </div>

              <!-- Row 2: Phone & Email -->
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                <div class="space-y-1.5">
                  <label for="contact-phone" class="block text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-800">
                    Phone <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="tel"
                    id="contact-phone"
                    name="phone"
                    required
                    placeholder="Enter phone number"
                    class="w-full px-1 py-2.5 bg-transparent border-0 border-b-2 border-slate-300 focus:border-[#146B5C] text-base font-semibold text-slate-900 placeholder:text-slate-400 outline-none transition-colors duration-200 rounded-none"
                  />
                </div>

                <div class="space-y-1.5">
                  <label for="contact-email" class="block text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-800">
                    Email <span class="text-red-500">*</span>
                  </label>
                  <input
                    type="email"
                    id="contact-email"
                    name="email"
                    required
                    placeholder="Enter email address"
                    class="w-full px-1 py-2.5 bg-transparent border-0 border-b-2 border-slate-300 focus:border-[#146B5C] text-base font-semibold text-slate-900 placeholder:text-slate-400 outline-none transition-colors duration-200 rounded-none"
                  />
                </div>
              </div>

              <!-- Row 3: Subject -->
              <div class="space-y-1.5">
                <label for="contact-subject" class="block text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-800">
                  Subject <span class="text-red-500">*</span>
                </label>
                <input
                  type="text"
                  id="contact-subject"
                  name="subject"
                  required
                  placeholder="How can we help you?"
                  class="w-full px-1 py-2.5 bg-transparent border-0 border-b-2 border-slate-300 focus:border-[#146B5C] text-base font-semibold text-slate-900 placeholder:text-slate-400 outline-none transition-colors duration-200 rounded-none"
                />
              </div>

              <!-- Row 4: Message -->
              <div class="space-y-1.5">
                <label for="contact-message" class="block text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-800">
                  Message <span class="text-red-500">*</span>
                </label>
                <textarea
                  id="contact-message"
                  name="message"
                  required
                  rows="3"
                  placeholder="Write your message here..."
                  class="w-full px-1 py-2.5 bg-transparent border-0 border-b-2 border-slate-300 focus:border-[#146B5C] text-base font-semibold text-slate-900 placeholder:text-slate-400 outline-none transition-colors duration-200 rounded-none resize-none"
                ></textarea>
              </div>

              <!-- Submit Button -->
              <div class="pt-4">
                <button
                  type="submit"
                  class="w-full py-4 rounded-xl bg-[#146B5C] hover:bg-[#0D5549] text-white text-base font-bold shadow-md hover:shadow-lg transition-all duration-200 cursor-pointer"
                >
                  Send Message
                </button>
              </div>

              <div id="contact-success" class="hidden p-4 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-800 text-base font-semibold">
                Thank you for contacting Techsteps. Your enquiry has been routed to our UK support desk and a team member will reply shortly.
              </div>
            </form>
          </div>
        </div>
      </div>

    </Container>

    <!-- 3. MAP SECTION (Container with Left & Right Side Gaps & Rounded Edge) -->
    <div class="mt-16 sm:mt-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
      <div class="rounded-3xl overflow-hidden shadow-lg relative">
        <CustomStyleExample client:visible />
      </div>
    </div>

    <!-- 4. TRUST / SECURITY SECTION (After Map) -->
    <div class="mt-20 sm:mt-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <h2 class="text-2xl sm:text-3xl font-extrabold font-display text-slate-900 tracking-tight">
          Your Information. Handled Responsibly.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8 max-w-5xl mx-auto">
        <!-- Point 1: SECURE -->
        <div class="bg-white/70 backdrop-blur-xs rounded-2xl p-6 sm:p-8 border border-slate-200/80 space-y-3 shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-[#146B5C]/10 text-[#146B5C] flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold font-mono tracking-widest text-[#146B5C] uppercase">
            SECURE
          </h3>
          <p class="text-base text-slate-800 font-semibold leading-relaxed">
            Your enquiry is handled responsibly.
          </p>
        </div>

        <!-- Point 2: CONFIDENTIAL -->
        <div class="bg-white/70 backdrop-blur-xs rounded-2xl p-6 sm:p-8 border border-slate-200/80 space-y-3 shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-[#146B5C]/10 text-[#146B5C] flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
          </div>
          <h3 class="text-sm font-bold font-mono tracking-widest text-[#146B5C] uppercase">
            CONFIDENTIAL
          </h3>
          <p class="text-base text-slate-800 font-semibold leading-relaxed">
            Project information is treated appropriately.
          </p>
        </div>

        <!-- Point 3: ACCOUNTABLE -->
        <div class="bg-white/70 backdrop-blur-xs rounded-2xl p-6 sm:p-8 border border-slate-200/80 space-y-3 shadow-xs">
          <div class="w-10 h-10 rounded-xl bg-[#146B5C]/10 text-[#146B5C] flex items-center justify-center">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
            </svg>
          </div>
          <h3 class="text-sm font-bold font-mono tracking-widest text-[#146B5C] uppercase">
            ACCOUNTABLE
          </h3>
          <p class="text-base text-slate-800 font-semibold leading-relaxed">
            Clear communication from enquiry to delivery.
          </p>
        </div>
      </div>
    </div>

  
  </section>
</BaseLayout>

<script>
  function setupContactForm() {
    const form = document.getElementById('techsteps-contact-form') as HTMLFormElement | null;
    const successMsg = document.getElementById('contact-success');

    if (!form || !successMsg) return;

    form.addEventListener('submit', (e) => {
      if (!window.location.hostname.includes('netlify')) {
        e.preventDefault();
        successMsg.classList.remove('hidden');
        form.reset();
        successMsg.scrollIntoView({ behavior: 'smooth' });
      }
    });
  }

  setupContactForm();
  document.addEventListener('astro:page-load', setupContactForm);
</script>
