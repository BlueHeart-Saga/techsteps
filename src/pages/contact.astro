---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import CTA from '../components/global/cta.astro';
import { getContactPage, getSiteSettings } from '../lib/sanity/client';

const [contactPage, siteSettings] = await Promise.all([
  getContactPage(),
  getSiteSettings(),
]);
import { Map, MapGeoJSON, CustomStyleExample } from '@/components/ui/map';
import UKLocationsMap from '@/components/ui/UKLocationsMap';
import { WORLD_GEOJSON } from '@/lib/use-world-data';

const breadcrumbs = [
  { name: 'Contact Us', url: '/contact' },
];

const phoneClean = (siteSettings.phone || '+44 1784 640216').replace(/[^0-9+]/g, '');
const officialEmail = siteSettings.email || 'collection@techsteps.co.uk';
---

<BaseLayout
  title={contactPage.metaTitle || "Contact Techsteps UK | UK Head Office & Sovereign Hub"}
  description={contactPage.metaDescription || "Contact Techsteps UK. Reach our UK headquarters or speak directly with our logistics dispatch and customer compliance teams."}
  hasHeroHeader={true}
>
  <!-- ===================================================== -->
  <!-- 1. HERO SECTION (Premium, Clean, Borderless Layout matching Mockup adb4b501.jpg) -->
  <!-- ===================================================== -->
  <section class="relative w-full bg-white overflow-x-clip overflow-y-visible">
    
    <!-- Header at Top of Page (Transparent Navbar) -->
    <div class="relative z-20">
      <HeroHeader isHome={true} />
    </div>

    <!-- Background Decorative Elements System:
         - Left: Cropped teal outline circle arc (#146B5C) + thin concentric arc + teal accent dot + subtle continuing curve
         - Right: Soft mint bubble (#D1F3EC) + thin concentric arc + mint dot + subtle continuing curve
         - Center: Subtle mint radial glow blending seamlessly into pure white
    -->
    <div class="pointer-events-none select-none absolute inset-0 w-full h-full overflow-x-clip overflow-y-visible z-0" aria-hidden="true">
      
      <!-- Subtle Mint Radial Glow behind Center -->
      <div class="absolute inset-0 flex items-center justify-center">
        <div class="w-[550px] sm:w-[750px] lg:w-[900px] h-[340px] sm:h-[400px] bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-[#D1F3EC]/50 via-[#EAF8F5]/25 to-transparent rounded-full blur-3xl pointer-events-none"></div>
      </div>

      <!-- Left Side: Cropped Teal Outline Circle Arc (#146B5C) -->
      <div class="absolute top-1/2 -translate-y-1/2 -left-[clamp(90px,12vw,160px)] w-[clamp(280px,30vw,440px)] aspect-square pointer-events-none">
        <!-- Concentric thin outer arc -->
        <div class="absolute inset-0 rounded-full border-[1.2px] border-[#008F83]/35"></div>
        <!-- Main thick teal circle arc (#146B5C) -->
        <div class="absolute inset-[10px] sm:inset-[14px] rounded-full border-[8px] sm:border-[11px] border-[#146B5C]"></div>
        <!-- Concentric thin inner arc -->
        <div class="absolute inset-[26px] sm:inset-[34px] rounded-full border border-[#008F83]/25"></div>
        <!-- Solid teal accent dot (#146B5C) on lower-right arc perimeter -->
        <div class="absolute bottom-[24%] right-[4%] w-3 h-3 rounded-full bg-[#146B5C]"></div>
      </div>

      <!-- Left Side: Thin curve continuing seamlessly into the next section -->
      <svg class="absolute -bottom-8 left-0 w-[260px] sm:w-[320px] h-[120px] pointer-events-none" viewBox="0 0 320 120" fill="none">
        <path d="M-40 0 C 40 40, 100 70, 140 120" stroke="#008F83" stroke-width="1.2" stroke-opacity="0.3" fill="none" />
        <path d="M-20 20 C 60 60, 120 90, 160 140" stroke="#008F83" stroke-width="0.8" stroke-opacity="0.2" fill="none" />
      </svg>

      <!-- Right Side: Soft Mint Circles (#D1F3EC) + Concentric Outline Arc -->
      <div class="absolute -top-12 sm:-top-20 -right-[clamp(90px,12vw,170px)] w-[clamp(300px,32vw,480px)] aspect-square pointer-events-none">
        <!-- Concentric thin outer arc -->
        <div class="absolute -inset-[18px] sm:-inset-[26px] rounded-full border-[1.2px] border-[#008F83]/35"></div>
        <!-- Main soft mint-green filled bubble (#D1F3EC) -->
        <div class="w-full h-full rounded-full bg-[#D1F3EC]"></div>
        <!-- Inner highlight -->
        <div class="absolute inset-[28px] sm:inset-[40px] rounded-full bg-[#E5F9F4]/70"></div>
        <!-- Floating solid mint/teal accent dot -->
        <div class="absolute bottom-[22%] -left-3 sm:-left-4 w-3 h-3 rounded-full bg-[#008F83]"></div>
      </div>

      <!-- Right Side: Thin curve continuing seamlessly into the next section -->
      <svg class="absolute -bottom-10 right-0 w-[260px] sm:w-[340px] h-[130px] pointer-events-none" viewBox="0 0 340 130" fill="none">
        <path d="M360 0 C 280 40, 220 80, 180 130" stroke="#008F83" stroke-width="1.2" stroke-opacity="0.3" fill="none" />
        <path d="M380 20 C 300 60, 240 100, 200 150" stroke="#008F83" stroke-width="0.8" stroke-opacity="0.2" fill="none" />
      </svg>
    </div>

    <!-- Centered Borderless Hero Content (Desktop target 380–440px excluding header) -->
    <div class="relative z-10 w-full min-h-[380px] sm:min-h-[400px] lg:min-h-[420px] max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-12 lg:py-14 flex flex-col justify-center items-center text-center">
      
      <!-- Eyebrow: Small uppercase WE'RE HERE TO HELP -->
      <p class="text-xs sm:text-[13px] font-bold font-sans tracking-[0.22em] text-[#146B5C] uppercase">
        WE'RE HERE TO HELP
      </p>

      <!-- Short Teal Underline -->
      <div class="w-12 h-[2.5px] bg-[#146B5C] rounded-full mx-auto mt-2 sm:mt-2.5 mb-3.5 sm:mb-4" aria-hidden="true"></div>

      <!-- Heading: Contact Us -->
      <h1 class="font-display text-4xl sm:text-5xl lg:text-[54px] font-bold text-slate-900 tracking-tight leading-[1.12]">
        Contact Us
      </h1>

      <!-- Description: Questions about IT collections? Our team is ready to help. -->
      <p class="mt-3 sm:mt-3.5 text-base sm:text-lg text-slate-600 font-normal leading-relaxed max-w-lg mx-auto">
        Questions about IT collections? Our team is ready to help.
      </p>

      <!-- Action Buttons Row -->
      <div class="mt-6 sm:mt-7 flex flex-wrap items-center justify-center gap-4 sm:gap-6">
        <!-- Primary Book a Collection CTA: #146B5C -->
        <a
          href="/request-a-quote"
          class="inline-flex items-center justify-center px-6 sm:px-7 py-3 rounded-[10px] bg-[#146B5C] hover:bg-[#0D5549] text-white text-sm sm:text-base font-semibold shadow-xs hover:shadow-md transition-all duration-200 hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-[#146B5C]"
        >
          Book a Collection
        </a>

        <!-- Secondary View UK Locations CTA -->
        <a
          href="#get-in-touch"
          class="inline-flex items-center gap-1.5 text-[#146B5C] hover:text-[#0D5549] text-sm sm:text-base font-semibold transition-colors duration-200 group py-2"
        >
          <span>View UK Locations</span>
          <span class="transition-transform duration-200 group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- 2. NEXT SECTION: OUR UK LOCATIONS (Clean 2-Column, Verified Hubs & Functioning Interactive Map) -->
  <!-- ===================================================== -->
  <section id="get-in-touch" class="relative w-full bg-white pt-8 sm:pt-12 pb-14 sm:pb-18 scroll-mt-24 border-t border-slate-100 overflow-x-clip overflow-y-visible">
    
    <!-- Decorative background elements continuing behind this section -->
    <div class="pointer-events-none select-none absolute inset-0 w-full h-full overflow-hidden z-0" aria-hidden="true">
      <!-- Left side: subtle cropped teal outline circle arc (#146B5C/30) -->
      <div class="absolute top-[20%] -left-[clamp(60px,8vw,120px)] w-[clamp(180px,20vw,280px)] aspect-square rounded-full border-[1.5px] border-[#008F83]/30 pointer-events-none">
        <div class="absolute inset-[12px] rounded-full border border-[#008F83]/15"></div>
        <div class="absolute top-[52%] -right-1 w-2 h-2 rounded-full bg-[#146B5C]"></div>
      </div>

      <!-- Right side: subtle soft mint bubble (#D1F3EC/40) -->
      <div class="absolute bottom-[10%] -right-[clamp(50px,7vw,100px)] w-[clamp(160px,18vw,240px)] aspect-square rounded-full bg-[#D1F3EC]/40 pointer-events-none"></div>

      <!-- Flowing thin curved line continuing into the form section below -->
      <svg class="absolute bottom-0 left-[10%] w-[420px] h-[80px] pointer-events-none opacity-20" viewBox="0 0 420 80" fill="none">
        <path d="M0 10 C 140 60, 280 20, 420 70" stroke="#008F83" stroke-width="1.2" fill="none" />
      </svg>
    </div>

    <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
        
        <!-- LEFT COLUMN: Minimalist Address Rows & Direct Contact (Ref: 4b203b10.png) -->
        <div class="lg:col-span-6 xl:col-span-6 flex flex-col justify-between space-y-5 sm:space-y-6">
          
          <!-- Section Title & Subtitle matching reference -->
          <div>
            <h2 class="text-3xl sm:text-4xl font-bold font-display text-slate-900 tracking-tight">
              Our UK Locations
            </h2>
            <p class="text-base text-slate-600 font-normal mt-1 leading-relaxed">
              Two operational hubs supporting collections across the UK.
            </p>
          </div>

          <!-- Minimalist Address Rows (Hainault Hub & Stafford Hub) -->
          <div class="space-y-4 pt-1">
            
            <!-- Row 1: Hainault Hub -->
            <div 
              class="flex items-start gap-3.5 group cursor-pointer"
              onmouseenter="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'hainault' } }))"
              onpointerenter="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'hainault' } }))"
              onclick="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'hainault' } }))"
              title="Focus Hainault Hub on map"
            >
              <!-- Pin Icon on soft mint background -->
              <div class="w-10 h-10 rounded-full bg-[#E6F7F3] text-[#146B5C] flex items-center justify-center shrink-0 mt-0.5 group-hover:scale-105 group-hover:bg-[#146B5C] group-hover:text-white transition-all shadow-xs">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>

              <div class="space-y-1 flex-1 min-w-0">
                <h3 class="text-lg font-bold font-display text-slate-900 group-hover:text-[#146B5C] transition-colors tracking-tight">
                  Hainault Hub
                </h3>
                <p class="text-sm text-slate-600 font-medium leading-relaxed">
                  Unit B, Roebuck Road, Hainault Business Park, IG6 3UF
                </p>
                <div>
                  <a
                    href="https://www.google.com/maps/dir/?api=1&destination=Unit+B+Roebuck+Road+Hainault+Business+Park+IG6+3UF"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs sm:text-sm font-semibold text-slate-800 hover:text-[#146B5C] underline decoration-dotted underline-offset-4 inline-flex items-center gap-1 transition-colors"
                    title="Get directions to Hainault Hub"
                  >
                    <span>Directions</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </div>

            <!-- Subtle Row Divider -->
            <div class="border-b border-slate-100" aria-hidden="true"></div>

            <!-- Row 2: Stafford Hub -->
            <div 
              class="flex items-start gap-3.5 group cursor-pointer"
              onmouseenter="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'stafford' } }))"
              onpointerenter="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'stafford' } }))"
              onclick="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'stafford' } }))"
              title="Focus Stafford Hub on map"
            >
              <!-- Pin Icon on soft mint background -->
              <div class="w-10 h-10 rounded-full bg-[#E6F7F3] text-[#146B5C] flex items-center justify-center shrink-0 mt-0.5 group-hover:scale-105 group-hover:bg-[#146B5C] group-hover:text-white transition-all shadow-xs">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>

              <div class="space-y-1 flex-1 min-w-0">
                <h3 class="text-lg font-bold font-display text-slate-900 group-hover:text-[#146B5C] transition-colors tracking-tight">
                  Stafford Hub
                </h3>
                <p class="text-sm text-slate-600 font-medium leading-relaxed">
                  Rickerscote Hall Lane, Stafford, ST17 4HF
                </p>
                <div>
                  <a
                    href="https://www.google.com/maps/dir/?api=1&destination=Rickerscote+Hall+Lane+Stafford+ST17+4HF"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="text-xs sm:text-sm font-semibold text-slate-800 hover:text-[#146B5C] underline decoration-dotted underline-offset-4 inline-flex items-center gap-1 transition-colors"
                    title="Get directions to Stafford Hub"
                  >
                    <span>Directions</span>
                    <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </div>

          </div>

          <!-- Divider before contact & socials -->
          <div class="border-b border-slate-100 pt-2" aria-hidden="true"></div>

          <!-- Bottom Contact & Socials Bar (Matching Reference 4b203b10.png) -->
          <div class="flex flex-wrap items-center justify-between gap-4 pt-1">
            <!-- Completely Visible and Clickable Phone & Email -->
            <div class="flex flex-wrap items-center gap-4 sm:gap-6">
              <!-- Phone -->
              <a
                href="tel:02085015050"
                class="inline-flex items-center gap-2 text-sm sm:text-[15px] font-semibold text-slate-900 hover:text-[#146B5C] transition-colors"
              >
                <svg class="w-4.5 h-4.5 text-[#146B5C]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <span>020 8501 5050</span>
              </a>

              <!-- Email -->
              <a
                href="mailto:info@techsteps.co.uk"
                class="inline-flex items-center gap-2 text-sm sm:text-[15px] font-semibold text-slate-900 hover:text-[#146B5C] transition-colors"
              >
                <svg class="w-4.5 h-4.5 text-[#146B5C]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <span>info@techsteps.co.uk</span>
              </a>
            </div>

            <!-- Simplified Social Links -->
            <div class="flex items-center gap-2">
              <a
                href={siteSettings.socialLinks?.linkedin || "https://www.linkedin.com/company/techsteps-uk/posts/?feedView=all"}
                target="_blank"
                rel="noopener noreferrer"
                class="w-7 h-7 rounded-full bg-[#E6F7F3] text-[#146B5C] hover:bg-[#146B5C] hover:text-white flex items-center justify-center transition-all hover:scale-105"
                aria-label="LinkedIn"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.75a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9z"/></svg>
              </a>
              <a
                href={siteSettings.socialLinks?.instagram || "https://www.instagram.com/techsteps_official/"}
                target="_blank"
                rel="noopener noreferrer"
                class="w-7 h-7 rounded-full bg-[#E6F7F3] text-[#146B5C] hover:bg-[#146B5C] hover:text-white flex items-center justify-center transition-all hover:scale-105"
                aria-label="Instagram"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>
              </a>
              <a
                href={siteSettings.socialLinks?.facebook || "http://facebook.com/profile.php?id=61584942775645"}
                target="_blank"
                rel="noopener noreferrer"
                class="w-7 h-7 rounded-full bg-[#E6F7F3] text-[#146B5C] hover:bg-[#146B5C] hover:text-white flex items-center justify-center transition-all hover:scale-105"
                aria-label="Facebook"
              >
                <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24"><path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/></svg>
              </a>
            </div>
          </div>

        </div>

        <!-- RIGHT COLUMN: Functioning Interactive UK Locations Map (CustomStyleExample) -->
        <div class="lg:col-span-6 xl:col-span-6">
          <div class="relative w-full h-[420px] rounded-[22px] overflow-hidden border border-slate-200/90 shadow-[0_10px_30px_rgba(15,23,42,0.05)] bg-[#F1F4EF]">
            <CustomStyleExample client:only="react" className="w-full h-full" />
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ===================================================== -->
  <!-- 3. SECTION BELOW: "HOW CAN WE HELP?" ENQUIRY FORM + SPECIALIST IMAGE -->
  <!-- ===================================================== -->
  <section id="contact-form" class="relative w-full bg-white pt-8 sm:pt-10 pb-14 sm:pb-18 overflow-hidden border-t border-slate-100">
    <div class="max-w-[1140px] mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-center">

        <!-- LEFT: CUSTOMER SUPPORT SPECIALIST IMAGE (Enlarged ~20%, Tight Whitespace, Mint & Teal Circular Backdrop) -->
        <div class="lg:col-span-5 flex items-center justify-center w-full">
          <div class="relative w-full max-w-[440px] sm:max-w-[480px] lg:max-w-[500px] flex items-center justify-center">
            
            <!-- Circular Mint & Curved Teal Background Continuous with Page Theme -->
            <div class="pointer-events-none select-none absolute inset-0 flex items-center justify-center overflow-visible" aria-hidden="true">
              <!-- Soft filled mint circle bubble (#D1F3EC) -->
              <div class="w-[280px] sm:w-[340px] lg:w-[390px] aspect-square rounded-full bg-[#D1F3EC]/70"></div>
              <!-- Concentric delicate teal outline arc -->
              <div class="absolute w-[320px] sm:w-[380px] lg:w-[440px] aspect-square rounded-full border-[1.2px] border-[#008F83]/30"></div>
              <!-- Inner subtle teal ring -->
              <div class="absolute w-[240px] sm:w-[290px] lg:w-[330px] aspect-square rounded-full border border-[#146B5C]/15"></div>
              <!-- Solid teal accent dot on perimeter -->
              <div class="absolute bottom-[20%] left-[6%] sm:left-[8%] w-3 h-3 rounded-full bg-[#146B5C]"></div>
              <div class="absolute top-[16%] right-[8%] sm:right-[10%] w-2.5 h-2.5 rounded-full bg-[#008F83]/70"></div>
              <!-- Flowing curved path continuous with section background -->
              <svg class="absolute -bottom-8 -left-10 w-[260px] sm:w-[300px] h-[120px] pointer-events-none" viewBox="0 0 300 120" fill="none">
                <path d="M-20 20 C 60 70, 160 80, 240 120" stroke="#008F83" stroke-width="1.2" stroke-opacity="0.25" fill="none" />
              </svg>
            </div>

            <!-- Customer-Support Technician Image (Enlarged ~20%, Drop Shadow) -->
            <img
              src="/images/contact/Contact page.webp"
              alt="Techsteps UK dedicated client consultation and support specialist"
              class="relative z-10 w-full h-auto max-h-[520px] sm:max-h-[560px] object-contain select-none mx-auto block drop-shadow-[0_15px_30px_rgba(0,0,0,0.1)] pointer-events-none"
              width="818"
              height="1003"
              loading="lazy"
