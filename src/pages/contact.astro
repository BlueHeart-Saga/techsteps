---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import PageHero from '../components/hero/PageHero.astro';
import { getContactPage, getSiteSettings } from '../lib/sanity/client';

const [contactPage, siteSettings] = await Promise.all([
  getContactPage(),
  getSiteSettings(),
]);
import { Map, MapGeoJSON, CustomStyleExample } from '@/components/ui/map';
import { WORLD_GEOJSON } from '@/lib/use-world-data';

const breadcrumbs = [
  { name: 'Contact Us', url: '/contact' },
];
---

<BaseLayout
  title={contactPage.metaTitle || "Contact Techsteps UK | UK Head Office & Sovereign Hub"}
  description={contactPage.metaDescription || "Contact Techsteps UK. Reach our UK headquarters in Dartford, Kent, or speak directly with our logistics dispatch and customer compliance teams."}
  hasHeroHeader={true}
>
  <!-- 1. HERO SECTION (Matching about-us page hero structure) -->
  <PageHero
    eyebrow={contactPage.hero?.eyebrow || "CONTACT US"}
    title={contactPage.hero?.title || "Contact us"}
    subheading={contactPage.hero?.subheading || "Techsteps is ready to provide the right solution according to your needs"}
    bgImage={contactPage.hero?.bgImage || "/images/brand/contact-hero-bg.jpg"}
    breadcrumbs={breadcrumbs}
    dividerColor="#f1f4ef"
  />

  <!-- 2. MAIN CONTACT FORM SECTION (Image on Left, Send us a message Form on Right) -->
  <!-- 2. MAIN CONTACT FORM SECTION -->
  <section class="relative bg-[#f1f4ef] pt-12 sm:pt-16 lg:pt-20 pb-16 sm:pb-20 lg:pb-24 overflow-hidden">
    
    <!-- Subtle decorative background -->
    <div
      class="absolute top-0 right-0 w-[420px] h-[420px] rounded-full bg-[#146B5C]/[0.035] blur-3xl pointer-events-none"
    ></div>

    <Container>
      <div class="w-full mx-auto relative z-10">

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 xl:gap-20 items-center">

          <!-- ===================================================== -->
          <!-- LEFT: UNIQUE IMAGE LAYOUT -->
          <!-- ===================================================== -->
          <div class="lg:col-span-5 relative">

            <!-- Decorative green shape behind image -->
            <div
              class="absolute -left-4 sm:-left-6 bottom-[-20px] sm:bottom-[-28px]
                     w-[78%] h-[72%]
                     bg-[#146B5C]
                     rounded-[2rem] sm:rounded-[2.5rem]
                     rotate-[-5deg]"
              aria-hidden="true"
            ></div>

            <!-- Secondary decorative shape -->
            <div
              class="absolute -right-3 sm:-right-5 top-[-18px] sm:top-[-24px]
                     w-24 h-24 sm:w-32 sm:h-32
                     border-[14px] sm:border-[18px]
                     border-[#3FB33D]/20
                     rounded-full"
              aria-hidden="true"
            ></div>

            <!-- Main image -->
            <div
              class="relative z-10
                     w-full
                     aspect-[4/5]
                     sm:aspect-[5/5.5]
                     lg:aspect-[4/5.2]
                     overflow-hidden
                     rounded-[2rem] sm:rounded-[2.5rem]
                     bg-slate-200
                     shadow-[0_25px_60px_rgba(15,98,58,0.16)]
                     border border-white/80"
            >
              <img
                src={
                  contactPage.formSection?.image ||
                  "/images/contact/contact-consultation.jpg"
                }
                alt="Techsteps UK client consultation and support"
                class="w-full h-full object-cover
                       transition-transform duration-700
                       hover:scale-[1.04]"
                loading="eager"
              />

              <!-- Image overlay -->
              <div
                class="absolute inset-0 bg-gradient-to-t from-[#063b2c]/35 via-transparent to-transparent pointer-events-none"
              ></div>
            </div>

            <!-- Small decorative corner -->
            <div
              class="absolute z-20 bottom-5 right-[-10px] sm:right-[-18px]
                     w-16 h-16 sm:w-20 sm:h-20
                     bg-white
                     rounded-2xl
                     shadow-xl
                     border border-slate-100
                     flex items-center justify-center"
              aria-hidden="true"
            >
              <div class="w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-[#146B5C]/10 flex items-center justify-center">
                <svg
                  class="w-4 h-4 sm:w-5 sm:h-5 text-[#146B5C]"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M21 10c0 7-9 12-9 12S3 17 3 10a9 9 0 1118 0z"
                  />
                  <circle
                    cx="12"
                    cy="10"
                    r="3"
                    stroke-width="1.8"
                  />
                </svg>
              </div>
            </div>

          </div>


          <!-- ===================================================== -->
          <!-- RIGHT: PROFESSIONAL CONTACT FORM -->
          <!-- ===================================================== -->
          <div class="lg:col-span-7">

            <div
              class="relative
                     bg-white
                     rounded-[2rem] sm:rounded-[2.5rem]
                     border border-slate-200/80
                     shadow-[0_20px_60px_rgba(15,23,42,0.08)]
                     p-6 sm:p-8 lg:p-10 xl:p-12"
            >

              <!-- Form heading -->
              <div class="mb-8 sm:mb-10">

                <div class="flex items-center gap-3 mb-4">
                  <span class="h-px w-8 bg-[#146B5C]"></span>

                  <span
                    class="text-[10px] sm:text-[11px]
                           font-bold
                           uppercase
                           tracking-[0.22em]
                           text-[#146B5C]"
                  >
                    Get in touch
                  </span>
                </div>

                <h2
                  class="text-3xl sm:text-4xl lg:text-[2.7rem]
                         font-semibold
                         font-display
                         text-slate-900
                         tracking-tight
                         leading-[1.08]"
                >
                  {contactPage.formSection?.heading || "Send us a message"}
                </h2>

                <p
                  class="mt-3
                         text-sm sm:text-base
                         text-slate-500
                         leading-relaxed
                         max-w-xl"
                >
                  Tell us what you need and our team will get back to you shortly.
                </p>

              </div>


              <!-- Contact Form -->
              <form
                class="space-y-6"
                id="techsteps-contact-form"
              >

                <!-- Row 1 -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">

                  <!-- Name -->
                  <div class="space-y-2">

                    <label
                      for="contact-name"
                      class="block text-xs
                             font-bold
                             uppercase
                             tracking-[0.12em]
                             text-slate-700"
                    >
                      Name <span class="text-red-500">*</span>
                    </label>

                    <input
                      type="text"
                      id="contact-name"
                      name="name"
                      required
                      placeholder="Enter your name"
                      class="w-full
                             h-12 sm:h-[52px]
                             px-4
                             rounded-xl
                             bg-slate-50
                             border border-slate-200
                             text-sm sm:text-base
                             font-medium
                             text-slate-900
                             placeholder:text-slate-400
                             outline-none
                             transition-all duration-200
                             focus:bg-white
                             focus:border-[#146B5C]
                             focus:ring-4
                             focus:ring-[#146B5C]/10"
                    />

                  </div>


                  <!-- Company -->
                  <div class="space-y-2">

                    <label
                      for="contact-company"
                      class="block text-xs
                             font-bold
                             uppercase
                             tracking-[0.12em]
                             text-slate-700"
                    >
                      Company
                    </label>

                    <input
                      type="text"
                      id="contact-company"
                      name="company"
                      placeholder="Enter company name"
                      class="w-full
                             h-12 sm:h-[52px]
                             px-4
                             rounded-xl
                             bg-slate-50
                             border border-slate-200
                             text-sm sm:text-base
                             font-medium
                             text-slate-900
                             placeholder:text-slate-400
                             outline-none
                             transition-all duration-200
                             focus:bg-white
                             focus:border-[#146B5C]
                             focus:ring-4
                             focus:ring-[#146B5C]/10"
                    />

                  </div>

                </div>


                <!-- Row 2 -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">

                  <!-- Phone -->
                  <div class="space-y-2">

                    <label
                      for="contact-phone"
                      class="block text-xs
                             font-bold
                             uppercase
                             tracking-[0.12em]
                             text-slate-700"
                    >
                      Phone <span class="text-red-500">*</span>
                    </label>

                    <input
                      type="tel"
                      id="contact-phone"
                      name="phone"
                      required
                      placeholder="Enter phone number"
                      class="w-full
                             h-12 sm:h-[52px]
                             px-4
                             rounded-xl
                             bg-slate-50
                             border border-slate-200
                             text-sm sm:text-base
                             font-medium
                             text-slate-900
                             placeholder:text-slate-400
                             outline-none
                             transition-all duration-200
                             focus:bg-white
                             focus:border-[#146B5C]
                             focus:ring-4
                             focus:ring-[#146B5C]/10"
                    />

                  </div>


                  <!-- Email -->
                  <div class="space-y-2">

                    <label
                      for="contact-email"
                      class="block text-xs
                             font-bold
                             uppercase
                             tracking-[0.12em]
                             text-slate-700"
                    >
                      Email <span class="text-red-500">*</span>
                    </label>

                    <input
                      type="email"
                      id="contact-email"
                      name="email"
                      required
                      placeholder="Enter email address"
                      class="w-full
                             h-12 sm:h-[52px]
                             px-4
                             rounded-xl
                             bg-slate-50
                             border border-slate-200
                             text-sm sm:text-base
                             font-medium
                             text-slate-900
                             placeholder:text-slate-400
                             outline-none
                             transition-all duration-200
                             focus:bg-white
                             focus:border-[#146B5C]
                             focus:ring-4
                             focus:ring-[#146B5C]/10"
                    />

                  </div>

                </div>


                <!-- Subject -->
                <div class="space-y-2">

                  <label
                    for="contact-subject"
                    class="block text-xs
                           font-bold
                           uppercase
                           tracking-[0.12em]
                           text-slate-700"
                  >
                    Subject <span class="text-red-500">*</span>
                  </label>

                  <input
                    type="text"
                    id="contact-subject"
                    name="subject"
                    required
                    placeholder="How can we help you?"
                    class="w-full
                           h-12 sm:h-[52px]
                           px-4
                           rounded-xl
                           bg-slate-50
                           border border-slate-200
                           text-sm sm:text-base
                           font-medium
                           text-slate-900
                           placeholder:text-slate-400
                           outline-none
                           transition-all duration-200
                           focus:bg-white
                           focus:border-[#146B5C]
                           focus:ring-4
                           focus:ring-[#146B5C]/10"
                  />

                </div>


                <!-- Message -->
                <div class="space-y-2">

                  <label
                    for="contact-message"
                    class="block text-xs
                           font-bold
                           uppercase
                           tracking-[0.12em]
                           text-slate-700"
                  >
                    Message <span class="text-red-500">*</span>
                  </label>

                  <textarea
                    id="contact-message"
                    name="message"
                    required
                    rows="5"
                    placeholder="Write your message here..."
                    class="w-full
                           min-h-[130px]
                           px-4
                           py-3.5
                           rounded-xl
                           bg-slate-50
                           border border-slate-200
                           text-sm sm:text-base
                           font-medium
                           text-slate-900
                           placeholder:text-slate-400
                           outline-none
                           transition-all duration-200
                           focus:bg-white
                           focus:border-[#146B5C]
                           focus:ring-4
                           focus:ring-[#146B5C]/10
                           resize-none"
                  ></textarea>

                </div>


                <!-- Submit -->
                <div class="pt-2">

                  <button
                    type="submit"
                    class="group
                           w-full
                           min-h-[54px]
                           px-6
                           rounded-xl
                           bg-[#146B5C]
                           hover:bg-[#0D5549]
                           text-white
                           text-sm sm:text-base
                           font-bold
                           tracking-wide
                           shadow-[0_10px_25px_rgba(20,107,92,0.18)]
                           hover:shadow-[0_14px_30px_rgba(20,107,92,0.25)]
                           transition-all duration-200
                           cursor-pointer
                           flex items-center justify-center gap-3"
                  >
                    <span>Send Message</span>

                    <span
                      class="text-lg transition-transform duration-200 group-hover:translate-x-1"
                      aria-hidden="true"
                    >
                      →
                    </span>
                  </button>

                </div>


                <!-- Success / Error message -->
                <div
                  id="contact-success"
                  class="hidden p-4 rounded-xl
                         bg-emerald-50
                         border border-emerald-200
                         text-emerald-800
                         text-sm
                         font-semibold"
                >
                  Thank you for contacting Techsteps. Your enquiry has been routed to our UK support desk and a team member will reply shortly.
                </div>

              </form>

            </div>

          </div>

        </div>

      </div>
    </Container>

    <!-- 3. MAP & GET IN TOUCH SECTION (Get in Touch on Left, Map on Right) -->
    <div class="mt-16 sm:mt-24 px-4 sm:px-6 lg:px-8 max-w-[1240px] mx-auto w-full">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center bg-white/60 backdrop-blur-xs rounded-3xl p-6 sm:p-10 lg:p-12 border border-slate-200/80 shadow-lg">
        
        <!-- LEFT COLUMN: Get in touch -->
        <div class="lg:col-span-5 space-y-8">
          <div class="space-y-3">
            <h2 class="text-3xl sm:text-4xl font-semibold font-display text-slate-900 tracking-tight">
              Get in touch
            </h2>
            <p class="text-base sm:text-lg text-slate-700 leading-relaxed font-normal">
              Reach our UK sovereign headquarters or speak directly with our logistics dispatch and compliance teams.
            </p>
          </div>

          <!-- Contact Information List with Vibrant Round Circle Icons -->
          <div class="space-y-6">
            <!-- Address 1 -->
            <div 
              class="flex items-start gap-4 group cursor-pointer p-2.5 -mx-2.5 rounded-2xl hover:bg-white/80 transition-all duration-200" 
              onmouseenter="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'address1' } }))"
              onpointerenter="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'address1' } }))"
              onclick="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'address1' } }))"
              title="View Address 1 on map"
            >
              <div class="w-12 h-12 rounded-full bg-[#146B5C] text-white flex items-center justify-center shrink-0 shadow-md group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div class="space-y-1">
                <h3 class="text-lg font-semibold font-display text-slate-900 group-hover:text-[#146B5C] transition-colors tracking-tight">
                  Address 1
                </h3>
                <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                  Unit B, Roebuck road<br />
                  Hainault business park, IG6 3UF
                </p>
              </div>
            </div>

            <!-- Address 2 -->
            <div 
              class="flex items-start gap-4 group cursor-pointer p-2.5 -mx-2.5 rounded-2xl hover:bg-white/80 transition-all duration-200"
              onmouseenter="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'address2' } }))"
              onpointerenter="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'address2' } }))"
              onclick="window.dispatchEvent(new CustomEvent('techsteps:switch-location', { detail: { location: 'address2' } }))"
              title="View Address 2 on map"
            >
              <div class="w-12 h-12 rounded-full bg-[#146B5C] text-white flex items-center justify-center shrink-0 shadow-md group-hover:scale-105 transition-transform">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />
                </svg>
              </div>
              <div class="space-y-1">
                <h3 class="text-lg font-semibold font-display text-slate-900 group-hover:text-[#146B5C] transition-colors tracking-tight">
                  Address 2
                </h3>
                <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                  Rickerscote Hall Ln, Stafford ST17 4HF
                </p>
              </div>
            </div>

            <!-- Item 2: Email Us -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-[#146B5C] text-white flex items-center justify-center shrink-0 shadow-md">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </div>
              <div class="space-y-1">
                <h3 class="text-lg font-semibold font-display text-slate-900 tracking-tight">
                  Email Us
                </h3>
                <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                  <a href={`mailto:${siteSettings.email}`} class="hover:text-[#146B5C] transition-colors block">
                    {siteSettings.email}
                  </a>
                </p>
              </div>
            </div>

            <!-- Item 3: Call Us -->
            <div class="flex items-start gap-4">
              <div class="w-12 h-12 rounded-full bg-[#146B5C] text-white flex items-center justify-center shrink-0 shadow-md">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
              </div>
              <div class="space-y-1">
                <h3 class="text-lg font-semibold font-display text-slate-900 tracking-tight">
                  Call Us
                </h3>
                <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                  Phone : <a href={`tel:${siteSettings.phone.replace(/[^0-9+]/g, '')}`} class="hover:text-[#146B5C] font-bold text-slate-900">{siteSettings.phone}</a><br />
                  Freephone : <a href="tel:08000834700" class="hover:text-[#146B5C] font-bold text-slate-900">0800 083 4700</a>
                </p>
              </div>
            </div>
          </div>

          <!-- Follow our social media -->
          <div class="pt-4 space-y-3 border-t border-slate-200">
            <h4 class="text-base font-semibold text-slate-900 tracking-tight">
              Follow our social media
            </h4>
            <div class="flex items-center gap-3">
              <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#146B5C] text-white flex items-center justify-center hover:bg-[#0D5549] transition-all hover:scale-105 shadow-xs" aria-label="LinkedIn">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.25V10.9H6.46M7.86 6.75a1.45 1.45 0 1 0 0 2.9 1.45 1.45 0 0 0 0-2.9z"/></svg>
              </a>
              <a href="https://twitter.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#146B5C] text-white flex items-center justify-center hover:bg-[#0D5549] transition-all hover:scale-105 shadow-xs" aria-label="Twitter X">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
              </a>
              <a href="https://facebook.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#146B5C] text-white flex items-center justify-center hover:bg-[#0D5549] transition-all hover:scale-105 shadow-xs" aria-label="Facebook">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2.04C6.5 2.04 2 6.53 2 12.06C2 17.06 5.66 21.21 10.44 21.96V14.96H7.9V12.06H10.44V9.85C10.44 7.34 11.93 5.96 14.22 5.96C15.31 5.96 16.45 6.15 16.45 6.15V8.62H15.19C13.95 8.62 13.56 9.39 13.56 10.18V12.06H16.34L15.89 14.96H13.56V21.96A10 10 0 0 0 22 12.06C22 6.53 17.5 2.04 12 2.04Z"/></svg>
              </a>
              <a href="https://youtube.com" target="_blank" rel="noopener noreferrer" class="w-10 h-10 rounded-full bg-[#146B5C] text-white flex items-center justify-center hover:bg-[#0D5549] transition-all hover:scale-105 shadow-xs" aria-label="YouTube">
                <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
              </a>
            </div>
          </div>
        </div>

        <!-- RIGHT COLUMN: Interactive Map -->
        <div class="lg:col-span-7">
          <div class="rounded-2xl overflow-hidden shadow-md border border-slate-200/90 relative">
            <CustomStyleExample client:visible />
          </div>
        </div>
      </div>
    </div>

    <!-- 4. TRUST / SECURITY SECTION (After Map) -->
