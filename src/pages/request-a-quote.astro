---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import PageHero from '../components/hero/PageHero.astro';
import { siteSettings } from '../lib/sanity/data';

const currentPath = Astro.url.pathname;
const isQuoteRoute = currentPath === '/request-a-quote';

const heroTitle = 'Request a Collection';
const breadcrumbs = [
  { name: heroTitle, url: isQuoteRoute ? '/request-a-quote' : '/request-a-collection' },
];

const title = "Book your collection | Techsteps UK";
const description = "Book an IT equipment collection. Takes about two minutes. You'll get a reference number immediately, and we'll confirm your collection window within two working days.";
---

<BaseLayout
  title={title}
  description={description}
  hasHeroHeader={true}
>
  <PageHero
    title={heroTitle}
    breadcrumbs={breadcrumbs}
    dividerColor="#f1f4ef"
  />

  <section class="relative bg-[#f1f4ef] pt-8 sm:pt-12 lg:pt-16 pb-20 sm:pb-28">
    <Container>
      <!-- Page Header matching reference image -->
      <div class="max-w-4xl mx-auto mb-8 sm:mb-10">
        <h2 class="font-display text-4xl sm:text-5xl lg:text-6xl font-bold text-slate-950 tracking-tight leading-[1.08] mb-4">
          Book your collection
        </h2>
        <p class="font-sans text-base sm:text-lg lg:text-[19px] text-slate-600 leading-relaxed max-w-2xl font-normal">
          Takes about two minutes. You'll get a reference number as soon as you submit, and we'll come back with a collection window within two working days.
        </p>
      </div>

      <!-- Main Form Card matching reference image -->
      <div class="max-w-4xl mx-auto bg-white rounded-2xl sm:rounded-3xl border border-slate-200/90 shadow-[0_10px_35px_rgba(0,0,0,0.03)] p-7 sm:p-10 lg:p-12">
        <!-- Submission Success Alert (Shown after submit) -->
        <div
          id="booking-success-message"
          class="hidden mb-8 p-6 rounded-xl bg-emerald-50 border border-emerald-200 text-emerald-900 space-y-2 animate-fadeIn"
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shrink-0">
              ✓
            </div>
            <h2 class="font-bold text-lg text-emerald-900">
              Collection Request Received! Reference: <span id="booking-ref-number" class="font-mono underline font-extrabold text-[#0F5A47]"></span>
            </h2>
          </div>
          <p class="text-sm text-emerald-800 pl-11">
            Our logistics team will review your quantities and contact you with a formal confirmation and collection window within two working days.
          </p>
        </div>

        <form
          id="collection-booking-form"
          name="book-collection"
          method="POST"
          data-netlify="true"
          class="space-y-6"
        >
          <input type="hidden" name="form-name" value="book-collection" />

          <!-- Row 1: Full Name & Company -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
            <div class="space-y-1.5">
              <label for="fullName" class="block text-xs sm:text-[13px] font-semibold text-slate-800">
                Full name
              </label>
              <input
                type="text"
                id="fullName"
                name="fullName"
                required
                placeholder="Jordan Ellis"
                class="w-full bg-[#F1F3EE] border border-slate-200/90 rounded-lg px-4 py-3 text-slate-900 text-sm sm:text-base placeholder:text-slate-400 focus:bg-white focus:border-[#0F5A47] focus:ring-1 focus:ring-[#0F5A47] outline-none transition-all font-sans"
              />
            </div>

            <div class="space-y-1.5">
              <label for="company" class="block text-xs sm:text-[13px] font-semibold text-slate-800">
                Company (leave blank if personal)
              </label>
              <input
                type="text"
                id="company"
                name="company"
                placeholder="Acme Ltd"
                class="w-full bg-[#F1F3EE] border border-slate-200/90 rounded-lg px-4 py-3 text-slate-900 text-sm sm:text-base placeholder:text-slate-400 focus:bg-white focus:border-[#0F5A47] focus:ring-1 focus:ring-[#0F5A47] outline-none transition-all font-sans"
              />
            </div>
          </div>

          <!-- Row 2: Email & Phone -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
            <div class="space-y-1.5">
              <label for="email" class="block text-xs sm:text-[13px] font-semibold text-slate-800">
                Email
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="jordan@example.com"
                class="w-full bg-[#F1F3EE] border border-slate-200/90 rounded-lg px-4 py-3 text-slate-900 text-sm sm:text-base placeholder:text-slate-400 focus:bg-white focus:border-[#0F5A47] focus:ring-1 focus:ring-[#0F5A47] outline-none transition-all font-sans"
              />
            </div>

            <div class="space-y-1.5">
              <label for="phone" class="block text-xs sm:text-[13px] font-semibold text-slate-800">
                Phone
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="07xxx xxxxxx"
                class="w-full bg-[#F1F3EE] border border-slate-200/90 rounded-lg px-4 py-3 text-slate-900 text-sm sm:text-base placeholder:text-slate-400 focus:bg-white focus:border-[#0F5A47] focus:ring-1 focus:ring-[#0F5A47] outline-none transition-all font-sans"
              />
            </div>
          </div>

          <!-- Row 3: Collection Address -->
          <div class="space-y-1.5">
            <label for="address" class="block text-xs sm:text-[13px] font-semibold text-slate-800">
              Collection address
            </label>
            <input
              type="text"
              id="address"
              name="address"
              required
              placeholder="Street address, town, postcode"
              class="w-full bg-[#F1F3EE] border border-slate-200/90 rounded-lg px-4 py-3 text-slate-900 text-sm sm:text-base placeholder:text-slate-400 focus:bg-white focus:border-[#0F5A47] focus:ring-1 focus:ring-[#0F5A47] outline-none transition-all font-sans"
            />
          </div>

          <!-- Row 4: Preferred Outcome & Collection Date -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 sm:gap-6">
            <div class="space-y-1.5">
              <label for="outcome" class="block text-xs sm:text-[13px] font-semibold text-slate-800">
                Preferred outcome
              </label>
              <div class="relative">
                <select
                  id="outcome"
                  name="outcome"
                  class="w-full bg-[#F1F3EE] border border-slate-200/90 rounded-lg px-4 py-3 text-slate-900 text-sm sm:text-base focus:bg-white focus:border-[#0F5A47] focus:ring-1 focus:ring-[#0F5A47] outline-none transition-all appearance-none cursor-pointer pr-10 font-sans"
                >
                  <option value="Recycle">Recycle</option>
                  <option value="Reuse / Remarket">Reuse / Remarket</option>
                  <option value="Secure Destruction">Secure Destruction</option>
                  <option value="Audit & Assessment">Audit &amp; Assessment</option>
                  <option value="Relocation">Relocation</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-3.5 text-slate-500">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>

            <div class="space-y-1.5">
              <label for="collectionDate" class="block text-xs sm:text-[13px] font-semibold text-slate-800">
                Preferred collection date
              </label>
              <input
                type="date"
                id="collectionDate"
                name="collectionDate"
                placeholder="dd-mm-yyyy"
                class="w-full bg-[#F1F3EE] border border-slate-200/90 rounded-lg px-4 py-3 text-slate-900 text-sm sm:text-base focus:bg-white focus:border-[#0F5A47] focus:ring-1 focus:ring-[#0F5A47] outline-none transition-all font-sans"
              />
            </div>
          </div>

          <!-- Section: DEVICES & IT ASSETS -->
          <div class="pt-3">
            <h2 class="text-xs font-bold uppercase tracking-[0.18em] text-[#0F623A] mb-4 font-sans">
              DEVICES &amp; IT ASSETS
            </h2>
            <div class="space-y-3.5">
              <!-- Laptops -->
              <div class="flex items-center gap-4">
                <input
                  type="number"
                  min="0"
                  value="0"
                  id="device_laptops"
                  name="device_laptops"
                  class="w-18 h-12 bg-[#F1F3EE] border border-slate-200/90 rounded-lg text-center font-bold text-slate-900 text-base focus:bg-white focus:border-[#0F623A] focus:ring-1 focus:ring-[#0F623A] outline-none transition-all font-sans"
                />
                <label for="device_laptops" class="font-medium text-slate-800 text-sm sm:text-base cursor-pointer select-none">
                  Laptops
                </label>
              </div>

              <!-- Chromebooks -->
              <div class="flex items-center gap-4">
                <input
                  type="number"
                  min="0"
                  value="0"
                  id="device_chromebooks"
                  name="device_chromebooks"
                  class="w-18 h-12 bg-[#F1F3EE] border border-slate-200/90 rounded-lg text-center font-bold text-slate-900 text-base focus:bg-white focus:border-[#0F623A] focus:ring-1 focus:ring-[#0F623A] outline-none transition-all font-sans"
                />
                <label for="device_chromebooks" class="font-medium text-slate-800 text-sm sm:text-base cursor-pointer select-none">
                  Chromebooks
                </label>
              </div>

              <!-- Tablets -->
              <div class="flex items-center gap-4">
                <input
                  type="number"
                  min="0"
                  value="0"
                  id="device_tablets"
                  name="device_tablets"
                  class="w-18 h-12 bg-[#F1F3EE] border border-slate-200/90 rounded-lg text-center font-bold text-slate-900 text-base focus:bg-white focus:border-[#0F623A] focus:ring-1 focus:ring-[#0F623A] outline-none transition-all font-sans"
                />
                <label for="device_tablets" class="font-medium text-slate-800 text-sm sm:text-base cursor-pointer select-none">
                  Tablets
                </label>
              </div>

              <!-- IT Assets (Desktops, Servers, Networking) -->
              <div class="flex items-center gap-4">
                <input
                  type="number"
                  min="0"
                  value="0"
                  id="device_it_assets"
                  name="device_it_assets"
                  class="w-18 h-12 bg-[#F1F3EE] border border-slate-200/90 rounded-lg text-center font-bold text-slate-900 text-base focus:bg-white focus:border-[#0F623A] focus:ring-1 focus:ring-[#0F623A] outline-none transition-all font-sans"
                />
                <label for="device_it_assets" class="font-medium text-slate-800 text-sm sm:text-base cursor-pointer select-none">
                  IT Assets (Desktops, Servers &amp; Networking)
                </label>
              </div>

              <!-- Chargers & Accessories -->
              <div class="flex items-center gap-4">
                <input
                  type="number"
                  min="0"
                  value="0"
                  id="device_accessories"
                  name="device_accessories"
                  class="w-18 h-12 bg-[#F1F3EE] border border-slate-200/90 rounded-lg text-center font-bold text-slate-900 text-base focus:bg-white focus:border-[#0F623A] focus:ring-1 focus:ring-[#0F623A] outline-none transition-all font-sans"
                />
                <label for="device_accessories" class="font-medium text-slate-800 text-sm sm:text-base cursor-pointer select-none">
                  Chargers &amp; accessories
                </label>
              </div>

              <!-- Other Assets with Text Input -->
              <div class="flex flex-col sm:flex-row sm:items-center gap-3 pt-1">
                <label for="device_other_text" class="font-medium text-slate-800 text-sm sm:text-base cursor-pointer select-none shrink-0 w-20">
                  Other
                </label>
                <input
                  type="text"
                  id="device_other_text"
                  name="device_other_text"
                  placeholder="Enter other asset details (e.g. Monitors, Printers, Hard Drives, Racks...)"
                  class="w-full sm:flex-1 bg-[#F1F3EE] border border-slate-200/90 rounded-lg px-4 py-3 text-slate-900 text-sm sm:text-base placeholder:text-slate-400 focus:bg-white focus:border-[#0F623A] focus:ring-1 focus:ring-[#0F623A] outline-none transition-all font-sans"
                />
              </div>
            </div>
          </div>

          <!-- Section: Notes -->
          <div class="space-y-1.5 pt-3">
            <label for="notes" class="block text-xs sm:text-[13px] font-semibold text-slate-800">
              Notes (damage, swollen batteries, access instructions)
            </label>
            <textarea
              id="notes"
              name="notes"
              rows="4"
              placeholder="e.g. one laptop won't power on; building has a loading bay at the rear"
              class="w-full bg-[#F1F3EE] border border-slate-200/90 rounded-lg px-4 py-3 text-slate-900 text-sm sm:text-base placeholder:text-slate-400 focus:bg-white focus:border-[#0F623A] focus:ring-1 focus:ring-[#0F623A] outline-none transition-all resize-y font-sans"
            ></textarea>
          </div>

          <!-- Bottom Row: Disclaimer & Submit Button -->
          <div class="border-t border-dashed border-slate-200 pt-6 mt-8 flex flex-col sm:flex-row sm:items-center justify-between gap-6">
            <p class="text-xs sm:text-[13px] text-slate-500 max-w-sm sm:max-w-md leading-relaxed font-normal font-sans">
              Submitting opens an email to our collection desk with these details pre-filled — this is a placeholder inbox until it's replaced with your live one.
            </p>
            <button
              type="submit"
              class="bg-[#0F623A] hover:bg-[#0c4e2e] text-white font-bold text-sm sm:text-base px-8 py-3.5 rounded-lg shadow-sm hover:shadow-md transition-all shrink-0 cursor-pointer font-sans"
            >
              Submit request
            </button>
          </div>
        </form>
      </div>

      <!-- Quick Contact Option Below Form -->
      <div class="max-w-4xl mx-auto mt-8 text-center">
        <p class="text-xs sm:text-sm text-slate-500 font-medium">
          Need an urgent or same-day collection? Contact our logistics desk directly on{" "}
          <a href={`tel:${siteSettings.phone.replace(/[^0-9+]/g, '')}`} class="font-bold text-[#0F623A] hover:underline">
            {siteSettings.phone}
          </a>
        </p>
      </div>
    </Container>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById("collection-booking-form") as HTMLFormElement | null;
  const successBox = document.getElementById("booking-success-message");
  const refDisplay = document.getElementById("booking-ref-number");

  form?.addEventListener("submit", (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const fullName = formData.get("fullName") || "";
    const company = formData.get("company") || "";
    const email = formData.get("email") || "";
    const phone = formData.get("phone") || "";
    const address = formData.get("address") || "";
    const outcome = formData.get("outcome") || "";
    const collectionDate = formData.get("collectionDate") || "";
    const laptops = formData.get("device_laptops") || "0";
    const chromebooks = formData.get("device_chromebooks") || "0";
    const tablets = formData.get("device_tablets") || "0";
    const itAssets = formData.get("device_it_assets") || "0";
    const accessories = formData.get("device_accessories") || "0";
    const otherText = formData.get("device_other_text") || "";
    const notes = formData.get("notes") || "";

    const ref = `TS-COL-${Math.floor(1000 + Math.random() * 9000)}`;

    if (refDisplay) {
      refDisplay.textContent = ref;
    }

    if (successBox) {
      successBox.classList.remove("hidden");
      successBox.scrollIntoView({ behavior: "smooth", block: "center" });
    }

    // Build prefilled email body
    const subject = encodeURIComponent(`Collection Booking Request - Ref ${ref}`);
    const body = encodeURIComponent(
      `TechSteps Collection Booking Request\n` +
      `Reference Number: ${ref}\n\n` +
      `Contact Details:\n` +
      `- Full Name: ${fullName}\n` +
      `- Company: ${company || "N/A"}\n` +
      `- Email: ${email}\n` +
      `- Phone: ${phone}\n\n` +
      `Collection Details:\n` +
      `- Collection Address: ${address}\n` +
      `- Preferred Outcome: ${outcome}\n` +
      `- Preferred Collection Date: ${collectionDate || "Flexible"}\n\n` +
      `Devices & IT Assets:\n` +
      `- Laptops: ${laptops}\n` +
      `- Chromebooks: ${chromebooks}\n` +
      `- Tablets: ${tablets}\n` +
      `- IT Assets (Desktops / Servers / Networking): ${itAssets}\n` +
      `- Chargers & Accessories: ${accessories}\n` +
      `- Other: ${otherText || "None specified"}\n\n` +
      `Notes / Instructions:\n${notes || "None provided"}\n`
    );

    setTimeout(() => {
      window.location.href = `mailto:collections@techsteps.co.uk?subject=${subject}&body=${body}`;
    }, 500);
  });
</script>
