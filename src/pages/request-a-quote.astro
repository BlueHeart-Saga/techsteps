<script>
  function setupCollectionForm() {
    const form = document.getElementById("collection-booking-form") as HTMLFormElement | null;
    const successBox = document.getElementById("booking-success-message");
    const refDisplay = document.getElementById("booking-ref-number");
    const totalSelectedSpan = document.getElementById("total-selected-count");

    if (!form || form.dataset.hasListener) return;

    form.dataset.hasListener = "true";

    const deviceInputs = [
      "device_computers",
      "device_laptops",
      "device_mobile_phones",
      "device_servers",
      "device_printers",
      "device_tablets",
      "device_monitors",
      "device_accessories",
    ];

    function updateTotalCount() {
      if (!totalSelectedSpan) return;
      let total = 0;
      for (const id of deviceInputs) {
        const input = document.getElementById(id) as HTMLInputElement | null;
        if (input) {
          const val = parseInt(input.value || "0", 10);
          if (!isNaN(val) && val > 0) {
            total += val;
          }
        }
      }
      totalSelectedSpan.textContent = total === 1 ? "1 item selected" : `${total} items selected`;
    }

    // Attach listeners for increment and decrement buttons
    const incButtons = form.querySelectorAll(".device-btn-inc");
    incButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = (btn as HTMLElement).dataset.target;
        if (!targetId) return;
        const input = document.getElementById(targetId) as HTMLInputElement | null;
        if (input) {
          const current = parseInt(input.value || "0", 10);
          input.value = String(Math.max(0, (isNaN(current) ? 0 : current) + 1));
          updateTotalCount();
        }
      });
    });

    const decButtons = form.querySelectorAll(".device-btn-dec");
    decButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        const targetId = (btn as HTMLElement).dataset.target;
        if (!targetId) return;
        const input = document.getElementById(targetId) as HTMLInputElement | null;
        if (input) {
          const current = parseInt(input.value || "0", 10);
          input.value = String(Math.max(0, (isNaN(current) ? 0 : current) - 1));
          updateTotalCount();
        }
      });
    });

    // Also listen for direct input changes
    for (const id of deviceInputs) {
      const input = document.getElementById(id) as HTMLInputElement | null;
      if (input) {
        input.addEventListener("input", () => {
          const val = parseInt(input.value, 10);
          if (val < 0 || isNaN(val)) {
            input.value = "0";
          }
          updateTotalCount();
        });
      }
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      const submitButton = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      if (submitButton) {
        submitButton.disabled = true;
        submitButton.textContent = "Submitting...";
      }

      const formData = new FormData(form);

      const fullName = formData.get("fullName") || "";
      const company = formData.get("company") || "";
      const email = formData.get("email") || "";
      const phone = formData.get("phone") || "";
      const address = formData.get("address") || "";
      const outcome = formData.get("outcome") || "";
      const collectionDate = formData.get("collectionDate") || "";

      const computers = formData.get("device_computers") || "0";
      const laptops = formData.get("device_laptops") || "0";
      const mobilePhones = formData.get("device_mobile_phones") || "0";
      const servers = formData.get("device_servers") || "0";
      const printers = formData.get("device_printers") || "0";
      const tablets = formData.get("device_tablets") || "0";
      const monitors = formData.get("device_monitors") || "0";
      const accessories = formData.get("device_accessories") || "0";
      const otherText = formData.get("device_other_text") || "";
      const notes = formData.get("notes") || "";

      const ref = `TS-COL-${Math.floor(1000 + Math.random() * 9000)}`;

      const collectionData = {
        formType: "collection",
        reference: ref,
        name: fullName,
        company,
        email,
        phone,
        address,
        outcome,
        collectionDate,
        computers,
        laptops,
        mobilePhones,
        servers,
        printers,
        tablets,
        monitors,
        accessories,
        otherText,
        notes
      };

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: {
            "Content-Type": "application/json"
          },
          body: JSON.stringify(collectionData)
        });

        if (!response.ok) {
          const errorText = await response.text();
          console.error(`Collection form submission failed (HTTP ${response.status}):`, errorText);
          let errorJson: { message?: string } | null = null;
          try {
            errorJson = JSON.parse(errorText);
          } catch {}
          throw new Error(errorJson?.message || `Server error (${response.status}). Please try again.`);
        }

        const result = await response.json();

        if (!result.success) {
          throw new Error(
            result.message || "Unable to submit collection request"
          );
        }

        if (refDisplay) {
          refDisplay.textContent = ref;
        }

        if (successBox) {
          successBox.classList.remove("hidden");
          successBox.scrollIntoView({
            behavior: "smooth",
            block: "center"
          });
        }

        form.reset();
        updateTotalCount();

      } catch (error: any) {
        console.error("Collection form error:", error);

        alert(
          error?.message || "Unable to submit your collection request right now. Please try again or contact us directly."
        );
      } finally {
        if (submitButton) {
          submitButton.disabled = false;
          submitButton.textContent = "Submit request";
        }
      }
    });
  }

  setupCollectionForm();
  document.addEventListener("astro:page-load", setupCollectionForm);
</script>
