---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import CTA from '../components/global/cta.astro';
import RequestCollectionHero from '../components/hero/RequestCollectionHero.astro';
import { getRequestCollectionPage, getSiteSettings } from '../lib/sanity/client';

const [pageData, siteSettings] = await Promise.all([
  getRequestCollectionPage(),
  getSiteSettings(),
]);

const currentPath = Astro.url.pathname;
const isQuoteRoute = currentPath === '/request-a-quote';

const heroTitle = 'Request a Collection';
const breadcrumbs = [
  { name: heroTitle, url: isQuoteRoute ? '/request-a-quote' : '/request-a-collection' },
];

const title = pageData.metaTitle || "Book your collection | Techsteps UK";
const description = pageData.metaDescription || "Book an IT equipment collection. Takes about two minutes. You'll get a reference number immediately, and we'll confirm your collection window within two working days.";

// Verified client feedback & feel-good reviews
const verifiedReviews = [
  {
    name: 'Jamie Parker',
    role: 'IT Manager',
    tag: 'Reliable Service',
    quote: 'Professional service and clear communication throughout the entire process. Everything went like clockwork.',
  },
  {
    name: 'Alex Morgan',
    role: 'Healthcare Manager',
    tag: '100% Hassle-Free',
    quote: 'Techsteps made our IT equipment disposal simple, secure, and hassle-free. A breath of fresh air.',
  },
  {
    name: 'Sarah Jenkins',
    role: 'Facilities Manager, NHS Trust',
    tag: 'Peace of Mind',
    quote: 'A seamless experience from start to finish. Friendly drivers, punctual arrival, and complete peace of mind.',
  },
  {
    name: 'Jordan Ellis',
    role: 'Operations Manager',
    tag: 'Delightfully Easy',
    quote: 'A wonderfully reliable team that made our office equipment collection straightforward and delightfully easy.',
  },
  {
    name: 'Skyler James',
    role: 'Campus IT Manager',
    tag: 'Polite & Responsive',
    quote: 'A smooth collection process with a genuinely responsive, polite crew. Zero headache for our campus team.',
  },
  {
    name: 'Taylor Bennett',
    role: 'Finance & Compliance Manager',
    tag: 'Certified Security',
    quote: 'Handled our redundant IT assets efficiently with certified chain of custody. Truly exceptional service.',
  },
  {
    name: 'Casey Brooks',
    role: 'Operations Director',
    tag: 'Zero Disruption',
    quote: 'Organised collection with minimal disruption to our workday — attentive communication from booking to certificate.',
  },
  {
    name: 'Riley Foster',
    role: 'Technology Manager',
    tag: 'Life Made Easy',
    quote: 'Prompt, professional, and courteous. It is rare to find a logistics partner that makes life this easy.',
  },
];
---

<BaseLayout
  title={title}
  description={description}
  hasHeroHeader={true}
>
<RequestCollectionHero />

  <section class="relative bg-transparent pt-10 sm:pt-14 lg:pt-16 pb-14 sm:pb-20">
    <Container>
      <!-- Page Header: Centered with description removed -->
      <div class="max-w-4xl mx-auto mb-10 sm:mb-12 text-center">
        <h2 class="font-display text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-950 tracking-tight leading-[1.12]">
          {pageData.hero?.title || "Book your collection"}
        </h2>
      </div>

      <!-- Main Form: Spacious layout without enclosing box border to avoid box effect -->
      <div class="max-w-4xl mx-auto">
        <!-- Submission Success Alert (Shown after submit) -->
        <div
          id="booking-success-message"
          class="hidden mb-8 p-6 rounded-[12px] bg-emerald-50 border border-emerald-200 text-emerald-900 space-y-2 animate-fadeIn"
        >
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-emerald-600 text-white flex items-center justify-center font-bold text-sm shrink-0">
              ✓
            </div>
            <h2 class="font-semibold text-lg text-emerald-900">
              Collection Request Received! Reference: <span id="booking-ref-number" class="font-mono underline font-extrabold text-[#0F5A47]"></span>
            </h2>
          </div>
          <p class="text-sm text-emerald-800 pl-11">
            Our logistics team will review your quantities and contact you with a formal confirmation and collection window within two working days.
          </p>
        </div>

        <form
          id="collection-booking-form"
          name="book-collection"
          method="POST"
          data-netlify="true"
          class="space-y-8"
        >
          <input type="hidden" name="form-name" value="book-collection" />

          <!-- Contact & Collection Details Grid: Equal width rows and even positioning -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-7">
            <!-- Full Name -->
            <div class="space-y-1.5">
              <label for="fullName" class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                Full name <span class="text-[#0F623A]">*</span>
              </label>
              <input
                type="text"
                id="fullName"
                name="fullName"
                required
                placeholder="Jordan Ellis"
                class="w-full bg-transparent border-0 border-b-2 border-slate-200 focus:border-[#0F623A] rounded-none px-0 py-2.5 text-slate-900 text-base placeholder:text-slate-400 focus:ring-0 outline-none transition-colors font-sans"
              />
            </div>

            <!-- Company Name -->
            <div class="space-y-1.5">
              <label for="company" class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                Company Name <span class="text-xs normal-case text-slate-400 font-normal">(leave blank if personal)</span>
              </label>
              <input
                type="text"
                id="company"
                name="company"
                placeholder="Acme Ltd"
                class="w-full bg-transparent border-0 border-b-2 border-slate-200 focus:border-[#0F623A] rounded-none px-0 py-2.5 text-slate-900 text-base placeholder:text-slate-400 focus:ring-0 outline-none transition-colors font-sans"
              />
            </div>

            <!-- Email -->
            <div class="space-y-1.5">
              <label for="email" class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                Email <span class="text-[#0F623A]">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="jordan@example.com"
                class="w-full bg-transparent border-0 border-b-2 border-slate-200 focus:border-[#0F623A] rounded-none px-0 py-2.5 text-slate-900 text-base placeholder:text-slate-400 focus:ring-0 outline-none transition-colors font-sans"
              />
            </div>

            <!-- Phone -->
            <div class="space-y-1.5">
              <label for="phone" class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                Phone <span class="text-[#0F623A]">*</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="07xxx xxxxxx"
                class="w-full bg-transparent border-0 border-b-2 border-slate-200 focus:border-[#0F623A] rounded-none px-0 py-2.5 text-slate-900 text-base placeholder:text-slate-400 focus:ring-0 outline-none transition-colors font-sans"
              />
            </div>

            <!-- Collection Address: spanning full 2 columns evenly -->
            <div class="sm:col-span-2 space-y-1.5">
              <label for="address" class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                Collection address <span class="text-[#0F623A]">*</span>
              </label>
              <input
                type="text"
                id="address"
                name="address"
                required
                placeholder="Street address, town, postcode"
                class="w-full bg-transparent border-0 border-b-2 border-slate-200 focus:border-[#0F623A] rounded-none px-0 py-2.5 text-slate-900 text-base placeholder:text-slate-400 focus:ring-0 outline-none transition-colors font-sans"
              />
            </div>

            <!-- Preferred Outcome -->
            <div class="space-y-1.5">
              <label for="outcome" class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                Preferred outcome
              </label>
              <div class="relative">
                <select
                  id="outcome"
                  name="outcome"
                  class="w-full bg-transparent border-0 border-b-2 border-slate-200 focus:border-[#0F623A] rounded-none px-0 py-2.5 text-slate-900 text-base focus:ring-0 outline-none transition-colors appearance-none cursor-pointer pr-8 font-sans"
                >
                  <option value="Recycle">Recycle</option>
                  <option value="Reuse / Remarket">Reuse / Remarket</option>
                  <option value="Secure Destruction">Secure Destruction</option>
                  <option value="Audit & Assessment">Audit &amp; Assessment</option>
                  <option value="Relocation">Relocation</option>
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-1 text-slate-500">
                  <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                  </svg>
                </div>
              </div>
            </div>

            <!-- Preferred Collection Date -->
            <div class="space-y-1.5">
              <label for="collectionDate" class="block text-xs font-semibold uppercase tracking-wider text-slate-600">
                Preferred collection date
              </label>
              <input
                type="date"
                id="collectionDate"
                name="collectionDate"
                class="w-full bg-transparent border-0 border-b-2 border-slate-200 focus:border-[#0F623A] rounded-none px-0 py-2.5 text-slate-900 text-base focus:ring-0 outline-none transition-colors font-sans cursor-pointer"
              />
            </div>
          </div>

          <!-- Section: DEVICES & IT ASSETS with interactive counter cards -->
          <div class="pt-6 border-t border-slate-200/70 space-y-4">
            <!-- Header with Title and Selected Count -->
            <div class="flex items-center justify-between">
              <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight font-sans">
                Devices &amp; IT Assets
              </h3>
              <span id="total-selected-count" class="text-xs sm:text-sm text-slate-500 font-medium">
                0 items selected
              </span>
            </div>

            <!-- 8 Device Cards in 2 columns: equal width and height -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- 1. Computers -->
              <div class="rounded-[14px] sm:rounded-[16px] border border-slate-200/90 bg-white p-4 sm:p-4.5 flex flex-col justify-between gap-4 transition-all hover:border-slate-300">
                <div class="flex items-center gap-2.5 text-slate-800">
                  <svg class="w-5 h-5 text-slate-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" />
                    <line x1="8" y1="21" x2="16" y2="21" />
                    <line x1="12" y1="17" x2="12" y2="21" />
                  </svg>
                  <span class="font-semibold text-slate-900 text-sm sm:text-base">Computers</span>
                </div>
                <div class="flex items-center justify-between pt-1">
                  <button
                    type="button"
                    class="device-btn-dec w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_computers"
                    aria-label="Decrease Computers"
                  >
                    −
                  </button>
                  <input
                    type="number"
                    min="0"
                    id="device_computers"
                    name="device_computers"
                    value="0"
                    class="device-counter-input w-16 text-center font-semibold text-slate-950 text-base sm:text-lg bg-transparent border-0 focus:ring-0 outline-none p-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                  <button
                    type="button"
                    class="device-btn-inc w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_computers"
                    aria-label="Increase Computers"
                  >
                    +
                  </button>
                </div>
              </div>

              <!-- 2. Laptops -->
              <div class="rounded-[14px] sm:rounded-[16px] border border-slate-200/90 bg-white p-4 sm:p-4.5 flex flex-col justify-between gap-4 transition-all hover:border-slate-300">
                <div class="flex items-center gap-2.5 text-slate-800">
                  <svg class="w-5 h-5 text-slate-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="4" width="18" height="12" rx="2" />
                    <path d="M2 20h20" />
                  </svg>
                  <span class="font-semibold text-slate-900 text-sm sm:text-base">Laptops</span>
                </div>
                <div class="flex items-center justify-between pt-1">
                  <button
                    type="button"
                    class="device-btn-dec w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_laptops"
                    aria-label="Decrease Laptops"
                  >
                    −
                  </button>
                  <input
                    type="number"
                    min="0"
                    id="device_laptops"
                    name="device_laptops"
                    value="0"
                    class="device-counter-input w-16 text-center font-semibold text-slate-950 text-base sm:text-lg bg-transparent border-0 focus:ring-0 outline-none p-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                  <button
                    type="button"
                    class="device-btn-inc w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_laptops"
                    aria-label="Increase Laptops"
                  >
                    +
                  </button>
                </div>
              </div>

              <!-- 3. Mobile Phones -->
              <div class="rounded-[14px] sm:rounded-[16px] border border-slate-200/90 bg-white p-4 sm:p-4.5 flex flex-col justify-between gap-4 transition-all hover:border-slate-300">
                <div class="flex items-center gap-2.5 text-slate-800">
                  <svg class="w-5 h-5 text-slate-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="7" y="2" width="10" height="20" rx="2" />
                    <circle cx="12" cy="18" r="1" fill="currentColor" />
                  </svg>
                  <span class="font-semibold text-slate-900 text-sm sm:text-base">Mobile Phones</span>
                </div>
                <div class="flex items-center justify-between pt-1">
                  <button
                    type="button"
                    class="device-btn-dec w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_mobile_phones"
                    aria-label="Decrease Mobile Phones"
                  >
                    −
                  </button>
                  <input
                    type="number"
                    min="0"
                    id="device_mobile_phones"
                    name="device_mobile_phones"
                    value="0"
                    class="device-counter-input w-16 text-center font-semibold text-slate-950 text-base sm:text-lg bg-transparent border-0 focus:ring-0 outline-none p-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                  <button
                    type="button"
                    class="device-btn-inc w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_mobile_phones"
                    aria-label="Increase Mobile Phones"
                  >
                    +
                  </button>
                </div>
              </div>

              <!-- 4. Servers -->
              <div class="rounded-[14px] sm:rounded-[16px] border border-slate-200/90 bg-white p-4 sm:p-4.5 flex flex-col justify-between gap-4 transition-all hover:border-slate-300">
                <div class="flex items-center gap-2.5 text-slate-800">
                  <svg class="w-5 h-5 text-slate-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="8" rx="2" />
                    <rect x="2" y="13" width="20" height="8" rx="2" />
                    <circle cx="6" cy="7" r="1" fill="currentColor" />
                    <circle cx="6" cy="17" r="1" fill="currentColor" />
                    <line x1="10" y1="7" x2="18" y2="7" />
                    <line x1="10" y1="17" x2="18" y2="17" />
                  </svg>
                  <span class="font-semibold text-slate-900 text-sm sm:text-base">Servers</span>
                </div>
                <div class="flex items-center justify-between pt-1">
                  <button
                    type="button"
                    class="device-btn-dec w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_servers"
                    aria-label="Decrease Servers"
                  >
                    −
                  </button>
                  <input
                    type="number"
                    min="0"
                    id="device_servers"
                    name="device_servers"
                    value="0"
                    class="device-counter-input w-16 text-center font-semibold text-slate-950 text-base sm:text-lg bg-transparent border-0 focus:ring-0 outline-none p-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                  <button
                    type="button"
                    class="device-btn-inc w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_servers"
                    aria-label="Increase Servers"
                  >
                    +
                  </button>
                </div>
              </div>

              <!-- 5. Printers -->
              <div class="rounded-[14px] sm:rounded-[16px] border border-slate-200/90 bg-white p-4 sm:p-4.5 flex flex-col justify-between gap-4 transition-all hover:border-slate-300">
                <div class="flex items-center gap-2.5 text-slate-800">
                  <svg class="w-5 h-5 text-slate-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M6 9V3h12v6" />
                    <rect x="3" y="9" width="18" height="8" rx="2" />
                    <path d="M6 15v6h12v-6" />
                    <circle cx="17" cy="12" r="0.75" fill="currentColor" />
                  </svg>
                  <span class="font-semibold text-slate-900 text-sm sm:text-base">Printers</span>
                </div>
                <div class="flex items-center justify-between pt-1">
                  <button
                    type="button"
                    class="device-btn-dec w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_printers"
                    aria-label="Decrease Printers"
                  >
                    −
                  </button>
                  <input
                    type="number"
                    min="0"
                    id="device_printers"
                    name="device_printers"
                    value="0"
                    class="device-counter-input w-16 text-center font-semibold text-slate-950 text-base sm:text-lg bg-transparent border-0 focus:ring-0 outline-none p-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                  <button
                    type="button"
                    class="device-btn-inc w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_printers"
                    aria-label="Increase Printers"
                  >
                    +
                  </button>
                </div>
              </div>

              <!-- 6. Tablets -->
              <div class="rounded-[14px] sm:rounded-[16px] border border-slate-200/90 bg-white p-4 sm:p-4.5 flex flex-col justify-between gap-4 transition-all hover:border-slate-300">
                <div class="flex items-center gap-2.5 text-slate-800">
                  <svg class="w-5 h-5 text-slate-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="4" y="2" width="16" height="20" rx="2" />
                    <circle cx="12" cy="18" r="1" fill="currentColor" />
                  </svg>
                  <span class="font-semibold text-slate-900 text-sm sm:text-base">Tablets</span>
                </div>
                <div class="flex items-center justify-between pt-1">
                  <button
                    type="button"
                    class="device-btn-dec w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_tablets"
                    aria-label="Decrease Tablets"
                  >
                    −
                  </button>
                  <input
                    type="number"
                    min="0"
                    id="device_tablets"
                    name="device_tablets"
                    value="0"
                    class="device-counter-input w-16 text-center font-semibold text-slate-950 text-base sm:text-lg bg-transparent border-0 focus:ring-0 outline-none p-0 [appearance:textfield] [&::-webkit-outer-spin-button]:appearance-none [&::-webkit-inner-spin-button]:appearance-none"
                  />
                  <button
                    type="button"
                    class="device-btn-inc w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_tablets"
                    aria-label="Increase Tablets"
                  >
                    +
                  </button>
                </div>
              </div>

              <!-- 7. Monitors -->
              <div class="rounded-[14px] sm:rounded-[16px] border border-slate-200/90 bg-white p-4 sm:p-4.5 flex flex-col justify-between gap-4 transition-all hover:border-slate-300">
                <div class="flex items-center gap-2.5 text-slate-800">
                  <svg class="w-5 h-5 text-slate-700 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="2" y="3" width="20" height="14" rx="2" />
                    <line x1="12" y1="17" x2="12" y2="21" />
                    <line x1="7" y1="21" x2="17" y2="21" />
                  </svg>
                  <span class="font-semibold text-slate-900 text-sm sm:text-base">Monitors</span>
                </div>
                <div class="flex items-center justify-between pt-1">
                  <button
                    type="button"
                    class="device-btn-dec w-8 h-8 rounded-full border border-slate-300 text-slate-700 hover:text-slate-950 hover:border-slate-400 hover:bg-slate-100 flex items-center justify-center text-base font-bold transition-all select-none cursor-pointer"
                    data-target="device_monitors"
                    aria-label="Decrease Monitors"
                  >
                    −
                  </button>
                  <input
                    type="number"
                    min="0"
                    id="device_monitors"
                    name="device_monitors"
                    value="0"
