---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import CTA from '../components/global/cta.astro';
import { getAboutPage } from '../lib/sanity/client';

const about = await getAboutPage();

const canonicalUrl = 'https://techsteps.co.uk/about-us';

const cta = about?.cta;

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://techsteps.co.uk/about-us#webpage',
  url: canonicalUrl,
  name:
    about?.metaTitle ||
    'About Techsteps — Managing What Matters',
  description:
    about?.metaDescription ||
    'TechSteps is an IT asset recovery and responsible recycling company. We partner with businesses to securely manage their retired technology.',
  mainEntity: {
    '@id': 'https://techsteps.co.uk/#organization',
  },
};
---

<BaseLayout
  title={about?.metaTitle || 'About Us — Techsteps'}
  description={about?.metaDescription || 'TechSteps is an IT asset recovery and responsible recycling company.'}
  canonicalUrl={canonicalUrl}
  jsonLd={aboutPageSchema}
  hasHeroHeader={true}
>
  <!-- Top Navigation Header on clean white background -->
  <HeroHeader isHome={false} />

  <div class="about-page-wrapper bg-white text-slate-900 selection:bg-[#0F623A] selection:text-white">

    <!-- =====================================================
         1. SECTION 1 — HERO SECTION (Centered Title + Quote + Compact Image + Purpose Quote)
    ====================================================== -->
    <section
      id="about-hero"
      class="relative w-full bg-white select-none pt-6 sm:pt-8 lg:pt-10 pb-4 sm:pb-6"
    >
      <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Top Centered Heading & Quote -->
        <div class="max-w-3xl mx-auto text-center space-y-3 sm:space-y-3.5">
          <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-bold text-slate-900 tracking-tight leading-[1.12]">
            What TechSteps <span class="text-[#0F623A]">Means</span>
          </h1>
          <p class="text-base sm:text-lg text-slate-600 font-normal italic leading-relaxed max-w-2xl mx-auto">
            &ldquo;To us, TechSteps means delivering certified ITAD, secure data destruction, and responsible asset recycling & safeguarding confidential data, recovering hardware value, and keeping retired technology out of landfills.&rdquo;
          </p>
        </div>

        <!-- Centered Image (Compact Size & Tighter Spacing) -->
        <div class="relative w-full max-w-4xl lg:max-w-5xl mx-auto mt-4 sm:mt-5 flex justify-center">
          <img
            src="/images/about/about-us/hero1.png"
            alt={about?.buildingHero?.imageAlt || "TechSteps IT asset recovery and responsible recycling"}
            class="w-full h-auto object-contain block border-none shadow-none"
            width="1672"
            height="622"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </section>


    <!-- =====================================================
         2. SECTION 2 — ABOUT OUR COMPANY, OUR STORY & JOURNEY
    ====================================================== -->
    <section id="our-story" class="bg-white pt-8 sm:pt-12 lg:pt-14 pb-12 sm:pb-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Top Header & Story Narrative -->
        <div class="w-full text-left">
          <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-2 sm:mb-3">
            About Our Company &amp; Our Story
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold text-slate-900 tracking-tight font-display leading-[1.14] max-w-4xl">
            Empowering Businesses, Protecting What Matters &amp; Shaping a <span class="text-[#0F623A]">Greener Tomorrow</span>
          </h2>

          <div class="mt-8 sm:mt-10 grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
            <div class="story-quote-card relative bg-slate-50/70 hover:bg-slate-50 border border-slate-100 rounded-2xl p-6 sm:p-7 transition-all duration-300">
              <div class="flex items-center gap-2 mb-3">
                
                <span class="text-xs font-bold text-[#0F623A] uppercase tracking-[0.14em]">Our Purpose</span>
              </div>
              <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed italic">
                &ldquo;We founded TechSteps with a clear, heartfelt purpose: to make managing retired technology simple, safe, and sustainable — keeping every asset protected and out of landfills.&rdquo;
              </p>
            </div>

            <div class="story-quote-card relative bg-slate-50/70 hover:bg-slate-50 border border-slate-100 rounded-2xl p-6 sm:p-7 transition-all duration-300">
              <div class="flex items-center gap-2 mb-3">
                
                <span class="text-xs font-bold text-[#0F623A] uppercase tracking-[0.14em]">Our Commitment</span>
              </div>
              <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed italic">
                &ldquo;Today, we proudly partner with organisations nationwide, safeguarding confidential data with certified excellence while transforming retired hardware into lasting value and positive change.&rdquo;
              </p>
            </div>
          </div>
        </div>

        <!-- Magical Building Brush Reveal Showcase -->
        <div class="relative w-full max-w-5xl mx-auto mt-8 sm:mt-10 mb-4 select-none">
          <div
            id="magical-building-showcase"
            class="magical-building-card relative w-full aspect-[1672/941] overflow-hidden cursor-crosshair select-none"
            style="--mouse-x: -500px; --mouse-y: -500px; --brush-radius: 150px; --reveal-opacity: 0;"
          >
            <!-- 1. Base Blueprint Sketch Layer -->
            <img
              src="/images/about/about-us/building.png"
              alt="TechSteps UK Facility Blueprint"
              class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none z-10"
              width="1672"
              height="941"
              loading="lazy"
            />

            <!-- 2. Magic Colored Photograph Layer (Revealed inside brush cursor radius) -->
            <div
              class="magic-color-layer absolute inset-0 w-full h-full pointer-events-none select-none z-20"
              aria-hidden="true"
            >
              <img
                src="/images/about/about-us/building-color.webp"
                alt="TechSteps UK Facility Full Color"
                class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none"
                width="1672"
                height="941"
                loading="lazy"
              />
            </div>
          </div>
        </div>

        <!-- Timeline: Our Journey & Milestones -->
        <div class="mt-14 sm:mt-16 pt-6 sm:pt-8">
          <div class="mb-8 sm:mb-10">
            <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-1">
              Our Journey
            </p>
            <h3 class="text-2xl sm:text-3xl lg:text-[38px] font-bold text-slate-900 tracking-tight font-display leading-[1.16]">
              From a Simple Idea to a <span class="text-[#0F623A]">Lasting Impact</span>
            </h3>
          </div>

          <!-- Horizontal Interactive Timeline Track -->
          <div class="mx-auto max-w-6xl">
            <div class="tl-track" id="tl-track">
              <!-- Step 0: Founded -->
              <div class="st" style="--i:0">
                <div class="nd" aria-hidden="false">
                  <img
                    src="/images/about/Founded.webp"
                    alt="Founded milestone"
                  />
                </div>
                <div class="stem" aria-hidden="true"></div>
                <div class="lb">
                  <h3>Founded</h3>
                  <p>
                    &ldquo;A vision to manage retired tech securely, responsibly, and sustainably.&rdquo;
                  </p>
                </div>
              </div>

              <!-- Step 1: Expanded -->
              <div class="st" style="--i:1">
                <div class="nd" aria-hidden="false">
                  <img
                    src="/images/about/Expanded.webp"
                    alt="Expanded milestone"
                  />
                </div>
                <div class="stem" aria-hidden="true"></div>
                <div class="lb">
                  <h3>Expanded</h3>
                  <p>
                    &ldquo;Scaling into certified ITAD, hardware refurbishment, and zero-landfill recycling.&rdquo;
                  </p>
                </div>
              </div>

              <!-- Step 2: Partnered -->
              <div class="st" style="--i:2">
                <div class="nd" aria-hidden="false">
                  <img
                    src="/images/about/Partnered.webp"
                    alt="Partnered milestone"
                  />
                </div>
                <div class="stem" aria-hidden="true"></div>
                <div class="lb">
                  <h3>Partnered</h3>
                  <p>
                    &ldquo;Delivering trusted compliance and accredited security across the UK.&rdquo;
                  </p>
                </div>
              </div>

              <!-- Step 3: Driving the Future -->
              <div class="st" style="--i:3">
                <div class="nd" aria-hidden="false">
                  <img
                    src="/images/about/Driving.webp"
                    alt="Driving milestone"
                  />
                </div>
                <div class="stem" aria-hidden="true"></div>
                <div class="lb">
                  <h3>Driving Forward</h3>
                  <p>
                    &ldquo;Championing a circular technology economy and zero-landfill future.&rdquo;
                  </p>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- Purpose & Sustainable Future Quote (Below Our Journey) -->
        <div class="max-w-3xl mx-auto text-center mt-12 sm:mt-14 pt-4 sm:pt-6 space-y-2">
          <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em]">
            Our Purpose. Your Sustainable Future.
          </p>
          <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed max-w-2xl mx-auto italic">
            &ldquo;We help organisations securely manage, recover, recycle, and responsibly dispose of IT assets throughout their lifecycle.&rdquo;
          </p>
        </div>

      </div>
    </section>


    <!-- =====================================================
         3. SECTION 3 — MORE THAN RECYCLING. A BRIGHTER FUTURE.
    ====================================================== -->
<section
  id="brighter-future"
  class="bg-white py-10 sm:py-12 lg:py-14"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-6 items-center">

      <!-- Left Column -->
      <div class="lg:col-span-7">
        <h2
          class="text-3xl sm:text-4xl lg:text-[46px] font-semibold text-slate-900 tracking-tight font-display leading-[1.12]"
        >
          {about?.nationwideNetwork?.heading || "Nationwide network, local expertise"}
        </h2>

        <p
          class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-700 font-medium leading-relaxed max-w-none"
        >
          {about?.nationwideNetwork?.description || "Restore Datashred boasts a robust network spanning the entire UK. With strategically located facilities, we ensure efficient and timely service, no matter where your business is located. With our local reach, we can tailor a service plan to perfectly suit your volume and frequency of document shredding, while our national presence guarantees the security and compliance expertise you expect for any data disposal needs, from paper shredding to hard drive destruction."}
        </p>
      </div>

      <!-- Right Column -->
      <div class="lg:col-span-5 flex justify-center lg:justify-end">
        <img
          src={about?.nationwideNetwork?.imageUrl || "/images/about/More Than Recycling. A Brighter Future. (1).webp"}
          alt={about?.nationwideNetwork?.imageAlt || "Hand holding recovered IT components and hardware"}
          class="w-full max-w-md h-auto object-contain rounded-[20px]"
          loading="lazy"
        />
      </div>

    </div>
  </div>
</section>


    <!-- =====================================================
         4. SECTION 4 — BUILT ON TRUST. DRIVEN BY IMPACT.
    ====================================================== -->
    <section id="trust-impact" class="bg-white py-10 sm:py-12 lg:py-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Introductory Two-Column Area -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-10 items-center">
          <div class="lg:col-span-6">
            <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
              {about?.trustAndImpact?.heading ? (
                about.trustAndImpact.heading.includes('.') ? (
                  <>{about.trustAndImpact.heading.split('.')[0]}.<br />{about.trustAndImpact.heading.split('.').slice(1).join('.').trim()}</>
                ) : about.trustAndImpact.heading
              ) : (
                <>Built on Trust.<br />Driven by Impact.</>
              )}
            </h2>
          </div>
          <div class="lg:col-span-6">
            <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed max-w-lg lg:ml-auto">
              {about?.trustAndImpact?.description || "Our values guide everything we do — from how we handle your data and technology to the environmental impact of our operations."}
            </p>
          </div>
        </div>

        <!-- Four Feature Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 mt-8 sm:mt-10">
          <!-- Card 1: Security First -->
          <div class="rounded-[16px] overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <img
              src={about?.trustAndImpact?.cards?.[0]?.imageUrl || "/images/about/Card 1_ Security First (Deep Forest Slate Theme).webp"}
              alt={about?.trustAndImpact?.cards?.[0]?.imageAlt || "Security First: secure asset handling and compliance dashboard"}
              class="w-full h-auto object-contain"
              loading="lazy"
            />
          </div>

          <!-- Card 2: Environmental Responsibility -->
          <div class="rounded-[16px] overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <img
              src={about?.trustAndImpact?.cards?.[1]?.imageUrl || "/images/about/Card 2_ Environmental Responsibility (Emerald Green Theme).webp"}
              alt={about?.trustAndImpact?.cards?.[1]?.imageAlt || "Environmental Responsibility: recycling and responsible material recovery dashboard"}
              class="w-full h-auto object-contain"
              loading="lazy"
            />
          </div>

          <!-- Card 3: Customer Focus -->
          <div class="rounded-[16px] overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <img
              src={about?.trustAndImpact?.cards?.[2]?.imageUrl || "/images/about/card 3.webp"}
              alt={about?.trustAndImpact?.cards?.[2]?.imageAlt || "Customer Focus: transparency, service quality, and reliability dashboard"}
              class="w-full h-auto object-contain"
              loading="lazy"
            />
          </div>

          <!-- Card 4: Continuous Improvement -->
          <div class="rounded-[16px] overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <img
              src={about?.trustAndImpact?.cards?.[3]?.imageUrl || "/images/about/card-4 Deep Forest Theme.webp"}
              alt={about?.trustAndImpact?.cards?.[3]?.imageAlt || "Continuous Improvement: circular economy and performance metrics dashboard"}
              class="w-full h-auto object-contain"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </section>


    <!-- =====================================================
         5. SECTION 5 — PEOPLE. PLANET. PROGRESS.
    ====================================================== -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

   <section
  id="people-planet-progress"
  class="bg-white py-10 sm:py-12 lg:py-14"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-6 items-center">

      <!-- Left Column: Hand holding plant in soil -->
      <div class="lg:col-span-5 flex justify-center lg:justify-start">
        <img
          src={about?.sustainabilityCommitment?.imageUrl || "/images/about/People. Planet. Progress. (1).webp"}
          alt={about?.sustainabilityCommitment?.imageAlt || "Hand holding plant seedling in soil"}
          class="w-full max-w-md h-auto object-contain rounded-[20px]"
          loading="lazy"
        />
      </div>

      <!-- Right Column: Heading, Paragraph, and Three Metrics -->
      <div class="lg:col-span-7">
        <h2
          class="text-3xl sm:text-4xl lg:text-[46px] font-semibold text-slate-900 tracking-tight font-display leading-[1.12]"
        >
          {about?.sustainabilityCommitment?.heading || "Committed to sustainability: 0% landfill shredding"}
        </h2>

        <p
          class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-700 font-medium leading-relaxed max-w-none"
        >
          {about?.sustainabilityCommitment?.description || "Restore Datashred isn’t just about secure data destruction; we’re also passionate about protecting the environment. As a leading recycling business, we’re proud to work towards being Net Zero from our shredding activities by 2035 – a commitment our customers truly value. Furthermore, we are fully authorised by the Environment Agency to handle, transport, and recycle your company’s confidential materials. Choose Restore Datashred for peace of mind on both data security and environmental responsibility."}
        </p>

        <!-- Three Horizontally Aligned Metrics -->
        <div
          id="stats-counter-block"
          class="mt-7 sm:mt-9 flex flex-wrap items-center gap-6 sm:gap-8 lg:gap-10"
        >
          <div
            class="stat-item flex-1 min-w-[120px] sm:min-w-0"
            aria-label={`${about?.sustainabilityCommitment?.metrics?.[0]?.value || '100K+'} ${about?.sustainabilityCommitment?.metrics?.[0]?.label || 'Devices Processed'}`}
          >
            <span
              class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
              aria-hidden="true"
            >
              {about?.sustainabilityCommitment?.metrics?.[0]?.value || "100K+"}
            </span>

            <span class="block mt-2 text-sm sm:text-base font-medium text-slate-700">
              {about?.sustainabilityCommitment?.metrics?.[0]?.label || "Devices Processed"}
            </span>
          </div>

          <div
            class="hidden sm:block w-px h-10 bg-slate-200"
            aria-hidden="true"
          ></div>

          <div
            class="stat-item flex-1 min-w-[120px] sm:min-w-0"
            aria-label={`${about?.sustainabilityCommitment?.metrics?.[1]?.value || '500+'} ${about?.sustainabilityCommitment?.metrics?.[1]?.label || 'Businesses Served'}`}
          >
            <span
              class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
              aria-hidden="true"
            >
              {about?.sustainabilityCommitment?.metrics?.[1]?.value || "500+"}
            </span>

            <span class="block mt-2 text-sm sm:text-base font-medium text-slate-700">
              {about?.sustainabilityCommitment?.metrics?.[1]?.label || "Businesses Served"}
            </span>
          </div>

          <div
            class="hidden sm:block w-px h-10 bg-slate-200"
            aria-hidden="true"
          ></div>

          <div
            class="stat-item flex-1 min-w-[120px] sm:min-w-0"
            aria-label={`${about?.sustainabilityCommitment?.metrics?.[2]?.value || '0%'} ${about?.sustainabilityCommitment?.metrics?.[2]?.label || 'To Landfill (Recoverable)'}`}
          >
            <span
              class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
              aria-hidden="true"
            >
              {about?.sustainabilityCommitment?.metrics?.[2]?.value || "0%"}
            </span>

            <span class="block mt-2 text-sm sm:text-base font-medium text-slate-700">
              {about?.sustainabilityCommitment?.metrics?.[2]?.label || "To Landfill (Recoverable)"}
            </span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>





    <!-- =====================================================
         8. COMMON CTA SECTION
    ====================================================== -->
    <CTA
      title={cta?.title || "Let's Build a More Responsible Technology Future"}
      description={cta?.description || "Talk to our team about secure, sustainable and responsible IT asset management."}
      primaryText={cta?.buttonText || "Talk to Our Team"}
      primaryHref={cta?.buttonLink || "/contact"}
      secondaryText={cta?.secondaryButtonText || "Request a Collection"}
      secondaryHref={cta?.secondaryButtonLink || "/request-a-collection"}
    />

  </div>

  <script>
    function initAboutScrollAnimations() {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Stats Counter Animation
      const statsBlock = document.getElementById('stats-counter-block');
      if (statsBlock && statsBlock.dataset.observed !== 'true') {
        statsBlock.dataset.observed = 'true';

        const statElements = statsBlock.querySelectorAll('.stat-counter-number');

        if (!prefersReducedMotion && 'IntersectionObserver' in window && statElements.length) {
          const parsedStats: {
            element: Element;
            raw: string;
            prefix: string;
            target: number;
            suffix: string;
            start: number;
          }[] = [];

          statElements.forEach((el) => {
            const raw = (el.textContent || '').trim();
            const match = raw.match(/^([^\d]*)(\d+)(.*)$/);
            if (match) {
              const prefix = match[1] || '';
              const target = parseInt(match[2], 10);
              const suffix = match[3] || '';
              const start = target === 0 ? 100 : 0;
              parsedStats.push({
                element: el,
                raw,
                prefix,
                target,
                suffix,
                start,
              });
            }
          });

          if (parsedStats.length) {
            const statsObserver = new IntersectionObserver(
              (entries, observer) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    observer.unobserve(entry.target);

                    const duration = 1900;
                    let startTime: number | null = null;

                    parsedStats.forEach((stat) => {
                      stat.element.textContent = stat.prefix + stat.start + stat.suffix;
                    });

                    function step(timestamp: number) {
                      if (!startTime) startTime = timestamp;
                      const elapsed = timestamp - startTime;
                      const p = Math.min(1, elapsed / duration);
                      const eased = 1 - Math.pow(1 - p, 3);

                      parsedStats.forEach((stat) => {
                        const current = Math.round(stat.start + (stat.target - stat.start) * eased);
                        stat.element.textContent = stat.prefix + current + stat.suffix;
                      });

                      if (p < 1) {
                        requestAnimationFrame(step);
                      } else {
                        parsedStats.forEach((stat) => {
                          stat.element.textContent = stat.raw;
                        });
                      }
                    }

                    requestAnimationFrame(step);
                  }
                });
              },
              { threshold: 0.6 }
            );

            statsObserver.observe(statsBlock);
          }
        }
      }

      // 2. Timeline Sequence Animation
      const tlTrack = document.getElementById('tl-track') as HTMLElement | null;
      if (tlTrack && tlTrack.dataset.observed !== 'true') {
        tlTrack.dataset.observed = 'true';

        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          tlTrack.classList.add('go');
        } else {
          const tlObserver = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  observer.unobserve(entry.target);
                  tlTrack.classList.add('go');
                }
              });
            },
            { threshold: 0.35 }
          );

          tlObserver.observe(tlTrack);
        }
      }

      // 3. Story Quotes Staggered Scroll Reveal
      const storyQuotes = document.querySelectorAll('.story-quote-card');
      if (storyQuotes.length) {
        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          storyQuotes.forEach((card) => card.classList.add('revealed'));
        } else {
          const quotesObserver = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  observer.unobserve(entry.target);
                  const delay = parseInt((entry.target as HTMLElement).dataset.delay || '0', 10);
                  setTimeout(() => {
                    entry.target.classList.add('revealed');
                  }, delay);
                }
              });
            },
            { threshold: 0.15, rootMargin: '0px 0px -40px 0px' }
          );

          storyQuotes.forEach((card, index) => {
            if (card.dataset.observed !== 'true') {
              card.dataset.observed = 'true';
              (card as HTMLElement).dataset.delay = String(index * 200);
              quotesObserver.observe(card);
            }
          });
        }
      }

      // 4. Magical Building Brush Reveal
      const showcase = document.getElementById('magical-building-showcase');
      if (showcase && showcase.dataset.init !== 'true') {
        showcase.dataset.init = 'true';

        let isInside = false;
        let rafId: number | null = null;
        let targetX = -500;
        let targetY = -500;

        function updateBrushPosition() {
          if (showcase && isInside) {
            showcase.style.setProperty('--mouse-x', `${targetX}px`);
            showcase.style.setProperty('--mouse-y', `${targetY}px`);
          }
          rafId = null;
        }

        function handlePointerMove(e: PointerEvent) {
          if (!showcase) return;
          const rect = showcase.getBoundingClientRect();
          targetX = e.clientX - rect.left;
          targetY = e.clientY - rect.top;

          if (!isInside) {
            isInside = true;
            showcase.style.setProperty('--reveal-opacity', '1');
          }

          if (!rafId) {
            rafId = requestAnimationFrame(updateBrushPosition);
          }
        }

        function handlePointerLeave() {
          if (!showcase) return;
          isInside = false;
          showcase.style.setProperty('--reveal-opacity', '0');
        }

        showcase.addEventListener('pointerenter', handlePointerMove);
        showcase.addEventListener('pointermove', handlePointerMove);
        showcase.addEventListener('pointerleave', handlePointerLeave);
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAboutScrollAnimations);
    } else {
      initAboutScrollAnimations();
    }
    document.addEventListener('astro:page-load', initAboutScrollAnimations);
  </script>
</BaseLayout>


