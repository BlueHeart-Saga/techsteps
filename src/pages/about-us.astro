  place-content: center;
  box-shadow: 0 6px 18px rgba(15, 98, 58, 0.16);
  border: 1px solid rgba(255,255,255,0.2);
  transition: all .25s ease;
}

.step:nth-child(even) .hex {
  background: var(--green-primary);
  color: #FFFFFF;
  box-shadow: 0 6px 18px rgba(63, 179, 61, 0.24);
}

.step:hover .hex {
  transform: translateY(-4px) scale(1.05);
  box-shadow: 0 10px 24px rgba(15, 98, 58, 0.25);
}

.hex-icon {
  width: 30px;
  height: 30px;
}

.step h3 {
  font-size: clamp(15px, 1.24vw, 18px);
  text-transform: uppercase;
  letter-spacing: .05em;
  color: #0F172A;
  margin-bottom: 9px;
  font-weight: 600;
}

.step p {
  font-size: 14.2px;
  color: var(--on-surface-dim);
  max-width: 26ch;
  margin-inline: auto;
}

@media (max-width: 860px) {
  .steps {
    grid-template-columns: 1fr;
    gap: 34px;
  }
  .flow > svg {
