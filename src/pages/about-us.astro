  border-radius: 4px;
}

.stat.highlight-stat {
  background: var(--green-primary);
  color: #FFFFFF;
  box-shadow: 0 10px 30px rgba(63,179,61,0.35);
}

.stat > div {
  transform: skewX(9deg);
}

.stat b {
  display: block;
  font-family: var(--display);
  font-weight: 600;
  font-size: clamp(32px, 4vw, 54px);
  letter-spacing: -.04em;
  line-height: 1;
}

.stat em {
  font-style: normal;
  color: #0F623A;
}

.stat.highlight-stat em {
  color: #FFFFFF;
  opacity: .9;
}

.stat span {
  display: block;
  margin-top: 10px;
  font-size: 12.5px;
  color: #D1EFE2;
  line-height: 1.45;
}

.stat.highlight-stat span {
  color: #FFFFFF;
}

@media (max-width: 860px) {
  .caps {
    grid-template-columns: 1fr;
  }
  .stats {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* 6 · TRUST — honeycomb with Green stamps */
.trust {
  background: var(--panel);
  position: relative;
  clip-path: polygon(0 clamp(30px, 4vw, 70px), 100% 0, 100% 100%, 0 100%);
  padding-block: clamp(90px, 11vw, 150px) clamp(64px, 8vw, 110px);
}

.trust h2 {
  font-size: clamp(28px, 3.4vw, 46px);
  max-width: 16ch;
  color: #0F172A;
}

.trust .sub {
  color: var(--on-surface-dim);
  max-width: 52ch;
  margin-top: 16px;
}

.comb {
  margin-top: clamp(40px, 5vw, 66px);
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  column-gap: clamp(18px, 2.6vw, 38px);
  row-gap: clamp(26px, 3vw, 44px);
}

.badge {
  text-align: center;
  transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  padding: 8px 4px;
}

.badge:hover {
  transform: translateY(-4px);
}

.comb .badge:nth-child(even) {
  transform: translateY(34px);
}

.comb .badge:nth-child(even):hover {
  transform: translateY(30px);
}

.stamp {
  width: 112px;
  height: 126px;
  margin: 0 auto 18px;
  display: grid;
  place-content: center;
  text-align: center;
  color: #FFFFFF;
  font-family: var(--display);
  font-weight: 600;
  font-size: 13.5px;
  line-height: 1.2;
  letter-spacing: .03em;
  position: relative;
  clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  filter: drop-shadow(0 8px 18px rgba(15, 98, 58, 0.22));
  transition: transform 0.35s cubic-bezier(0.34, 1.56, 0.64, 1), filter 0.35s ease;
  cursor: default;
}

.badge:hover .stamp {
  transform: scale(1.08);
  filter: drop-shadow(0 14px 26px rgba(24, 98, 55, 0.42));
}

.stamp::after {
  content: "";
  position: absolute;
  inset: 5px;
  clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
  border: 1.5px solid rgba(255, 255, 255, 0.42);
  pointer-events: none;
}

.stamp.stamp-green {
  background: linear-gradient(145deg, #2A7E4F 0%, #0F623A 50%, #104627 100%);
  color: #FFFFFF;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
}

.stamp.stamp-forest {
  background: linear-gradient(145deg, #108A4E 0%, #0F623A 55%, #073B20 100%);
  color: #FFFFFF;
  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.45);
}

.badge h3 {
  font-size: 15.5px;
  font-weight: 600;
  margin-bottom: 6px;
  color: #0F172A;
  transition: color 0.2s ease;
}

.badge:hover h3 {
  color: #0F623A;
}

.badge p {
  font-size: 13px;
  color: var(--on-surface-dim);
  line-height: 1.5;
  max-width: 26ch;
  margin-inline: auto;
}

.trust .note {
  margin-top: clamp(52px, 5vw, 74px);
  padding-top: 20px;
  border-top: 1px solid var(--hairline);
  font-size: 13px;
  color: var(--on-surface-dim);
  max-width: 70ch;
}

@media (max-width: 1000px) {
  .comb {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (max-width: 480px) {
  .comb {
    grid-template-columns: 1fr;
  }
  .comb .badge:nth-child(even) {
    transform: none;
  }
}

/* 7 · BUTTONS */
.btn {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  font-weight: 500;
  font-size: 15px;
  padding: 14px 28px;
  border-radius: 999px;
  transition: all .2s ease;
}

.btn-primary {
  background: var(--green-primary);
  color: #FFFFFF !important;
  box-shadow: 0 4px 14px rgba(15, 98, 58, 0.35);
}

.btn-primary:hover {
  background: var(--green-hover);
  color: #FFFFFF !important;
  transform: translateY(-1px);
  box-shadow: 0 6px 20px rgba(15, 98, 58, 0.45);
}

