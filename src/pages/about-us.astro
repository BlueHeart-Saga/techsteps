---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import { getAboutPage } from '../lib/sanity/client';

const about = await getAboutPage();

const canonicalUrl = 'https://techsteps.co.uk/about-us';

const hero = about?.hero;
const whoWeAre = about?.whoWeAre;
const highlights = whoWeAre?.highlights || [];
const whatWeDo = about?.whatWeDo?.items || [];
const approach = about?.approach;
const approachSteps = approach?.steps || [];
const capabilities = about?.capabilities?.items || [];
const statistics = about?.statistics || [];
const cta = about?.cta;

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://techsteps.co.uk/about-us#webpage',
  url: canonicalUrl,
  name:
    about?.metaTitle ||
    'About Techsteps — Managing What Matters',
  description:
    about?.metaDescription ||
    '',
  mainEntity: {
    '@id': 'https://techsteps.co.uk/#organization',
  },
};
---

<BaseLayout
  title={about?.metaTitle || ''}
  description={about?.metaDescription || ''}
  canonicalUrl={canonicalUrl}
  jsonLd={aboutPageSchema}
  hasHeroHeader={true}
>
  <!-- Google Fonts -->
  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
    slot="head"
  />

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
    slot="head"
  />

  <link
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
    slot="head"
  />

  <div class="about-page-wrapper">

    <!-- =====================================================
         1. HERO
    ====================================================== -->

    <section
      id="top"
      class="hero on-dark select-none"
    >
      <div
        class="hero-bg-media absolute inset-0 select-none pointer-events-none overflow-hidden z-0"
        aria-hidden="true"
      >
<img
  src={hero?.image || "/images/hero/about-hero-technicians.jpg"}
  alt={hero?.imageAlt || 'Techsteps technicians in secure facility'}
  class="w-full h-full object-cover object-center brightness-[0.92] contrast-[1.03] scale-100"
  loading="eager"
/>

        <!-- Left-side High-Contrast Overlay for Brand Badge & Logo -->
        <div class="absolute inset-y-0 left-0 w-full sm:w-[58%] md:w-[50%] lg:w-[44%] xl:w-[40%] 2xl:w-[36%] bg-gradient-to-r from-black/92 via-black/75 via-[55%] via-black/35 via-[82%] to-transparent pointer-events-none z-[1]"></div>
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/45 to-black/20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/25"></div>
      </div>

      <!-- Integrated Hero Navbar -->
      <HeroHeader />

      <div class="shell relative z-10 pt-4 sm:pt-6 lg:pt-8">

        <!-- Breadcrumb -->
        <nav
          class="flex items-center text-xs sm:text-sm font-sans font-medium text-slate-300/90 pb-4 sm:pb-6"
          aria-label="Breadcrumb"
        >
          <a
            href="/"
            class="hover:text-white transition-colors duration-150"
          >
            Home
          </a>

          <span class="inline-flex items-center">
            <span class="mx-2 text-slate-400/80">/</span>

            <span class="text-white font-semibold">
              About Us
            </span>
          </span>
        </nav>

        <div class="grid">

          <div>

            {hero?.eyebrow && (
              <p class="eyebrow lift">
                {hero.eyebrow}
              </p>
            )}

            <h1 class="lift">
              {hero?.title}

              {hero?.highlightedTitle && (
                <span class="l2">
                  {hero.highlightedTitle}
                </span>
              )}
            </h1>

            {hero?.description && (
              <p class="lede lift">
                {hero.description}
              </p>
            )}

          </div>

          <figure class="hero-figure lift">

            <div
              class="photo border-2 border-white/20 shadow-2xl"
              data-caption="Techsteps secure processing facility"
            >
<img
  src={hero?.image || "/images/hero/about-hero-technicians.jpg"}
  alt={hero?.imageAlt || 'Techsteps secure processing facility'}
  class="w-full h-full object-cover object-center"
  loading="eager"
/>
            </div>

            <div
              class="ring"
              aria-hidden="true"
            ></div>

            <div
              class="seal"
              aria-hidden="true"
            >
              Chain of<br />
              custody
            </div>

          </figure>

        </div>
      </div>
    </section>


    <!-- =====================================================
         2. WHO WE ARE
    ====================================================== -->

    <section
      id="who"
      class="band bg-white py-12 sm:py-16 lg:py-20"
    >
      <div class="shell">

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

          <!-- Content -->

          <div class="lg:col-span-7 flex flex-col">

            <div class="flex items-center gap-3 mb-4 sm:mb-5">

              <span class="text-xs sm:text-sm font-bold tracking-widest text-[#0F623A] uppercase font-sans">
                {whoWeAre?.eyebrow || 'WHO WE ARE'}
              </span>

              <span class="w-8 h-[2.5px] bg-[#0F623A] rounded-full inline-block"></span>

            </div>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-950 tracking-tight leading-[1.12] mt-5 mb-8 sm:mb-10 lg:mb-12">

              {whoWeAre?.title}

              {whoWeAre?.highlightedTitle && (
                <span class="text-[#0F623A]">
                  {whoWeAre.highlightedTitle}
                </span>
              )}

            </h2>

            <div class="space-y-5 text-base sm:text-lg text-slate-700 leading-relaxed font-normal mb-3 sm:mb-4 pt-6">

              {whoWeAre?.paragraphs?.map((paragraph) => (
                <p>
                  {paragraph}
                </p>
              ))}

              {!whoWeAre?.paragraphs &&
                whoWeAre?.description && (
                  <p>
                    {whoWeAre.description}
                  </p>
                )}

            </div>


            <!-- Feature Pillars -->

            {highlights.length > 0 && (
              <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-0">

                {highlights.slice(0, 3).map(
                  (highlight, index) => (

                    <div class="space-y-3">

                      <div class="w-12 h-12 rounded-full bg-[#EBF5EF] text-[#0F623A] flex items-center justify-center">

                        {index === 0 && (
                          <svg
                            class="w-6 h-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 00-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                            />
                          </svg>
                        )}

                        {index === 1 && (
                          <svg
                            class="w-6 h-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z"
                            />
                            <line
                              x1="16"
                              y1="8"
                              x2="2"
                              y2="22"
                              stroke-linecap="round"
                              stroke-linejoin="round"
                            />
                          </svg>
                        )}

                        {index === 2 && (
                          <svg
                            class="w-6 h-6"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                            stroke-width="2"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"
                            />
                          </svg>
                        )}

                      </div>

                      <div class="space-y-6">

                        <h3 class="text-base sm:text-[17px] font-bold text-slate-900 leading-snug">
                          {highlight.title}
                        </h3>

                        <p class="text-xs sm:text-[13.5px] text-slate-500 leading-relaxed font-normal">
                          {highlight.description}
                        </p>

                      </div>

                    </div>

                  )
                )}

              </div>
            )}

          </div>


          <!-- Right Image -->

          <div class="lg:col-span-5 flex items-center justify-center lg:justify-end">

            <div class="relative w-full max-w-[520px]">

              <img
                src={whoWeAre?.image || "/images/about/who-we-are-technician.png"}
                alt={
                  whoWeAre?.imageAlt ||
                  'Techsteps certified technician inspecting refurbished hardware'
                }
                class="w-full h-auto object-contain max-h-[560px] drop-shadow-md mx-auto lg:ml-auto"
                loading="lazy"
                decoding="async"
              />

            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- =====================================================
         3. WHAT WE DO
    ====================================================== -->

    <section
      id="do"
      class="band bg-white"
      style="padding-top:0"
    >
      <div class="shell">

        <div class="head-rule">

          <span class="dot"></span>

          <p class="eyebrow">
            {about?.whatWeDo?.eyebrow || 'What we do'}
          </p>

          <span class="line"></span>

        </div>

        <div class="divisions">

          {whatWeDo.map((item, index) => (

            <article class="division">

              <div class="shot">

                <div
                  class="photo"
                  data-caption={item.title || ''}
                >

                  <img
                    src={
                      index === 0
                        ? '/images/services/process-step-2-secure.jpg'
                        : index === 1
                          ? '/images/services/process-step-3-sanitise.jpg'
                          : '/images/services/process-step-1-collect.jpg'
                    }
                    alt={
                      item.imageAlt ||
                      item.title ||
                      ''
                    }
                    class="w-full h-full object-cover"
                    loading="lazy"
                    onerror="this.style.display='none'"
                  />

                </div>

                <span class="no">
                  {item.number ||
                    String(index + 1).padStart(2, '0')}
                </span>

              </div>

              <h3>
                {item.title}
              </h3>

              <p>
                {item.description}
              </p>

              {item.link && (
                <a
                  class="go"
                  href={item.link}
                >
                  Explore services

                  <em aria-hidden="true">
                    &rarr;
                  </em>
                </a>
              )}

            </article>

          ))}

        </div>

      </div>
    </section>


    <!-- =====================================================
         4. APPROACH
    ====================================================== -->

    <section
      id="approach"
      class="approach"
    >
      <div class="shell">

        <div class="head-rule">

          <span class="dot"></span>

          <p class="eyebrow">
            {approach?.eyebrow || 'Our approach'}
          </p>

          <span class="line"></span>

        </div>

        <h2>
          {approach?.title}
        </h2>

        {approach?.description && (
          <p class="intro">
            {approach.description}
          </p>
        )}

        <div class="flow">

          <svg
            viewBox="0 0 1000 80"
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <path
              d="M120 12 C 250 12, 250 60, 375 60 S 500 12, 625 12 S 750 60, 875 60"
              fill="none"
              stroke="#0F623A"
              stroke-width="2"
              stroke-dasharray="6 6"
              opacity=".4"
            />
          </svg>

          <div class="steps">

            {approachSteps.map((step, index) => (

              <div class="step">

                <div
                  class="hex"
                  aria-label={`Step ${index + 1}: ${step.title || ''}`}
                >

                  {index === 0 && (
                    <svg
                      class="hex-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                      <path d="m9 12 2 2 4-4" />
                    </svg>
                  )}

                  {index === 1 && (
                    <svg
                      class="hex-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-1 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5" />
                      <path d="M9 18h6" />
                      <path d="M10 22h4" />
                    </svg>
                  )}

                  {index === 2 && (
                    <svg
                      class="hex-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5" />
                      <path d="M11 19h8.2a1.8 1.8 0 0 0 1.565-.89 1.78 1.78 0 0 0 .004-1.78l-3.955-6.83" />
                      <path d="M8.2 5.8 12 2l3.8 3.8" />
                      <path d="M12 2v10" />
                    </svg>
                  )}

                  {index === 3 && (
                    <svg
                      class="hex-icon"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <polyline points="22 7 13.5 15.5 8.5 10.5 2 17" />
                      <polyline points="16 7 22 7 22 13" />
                    </svg>
                  )}

                </div>

                <div>

                  <h3>
                    {step.title}
                  </h3>

                  <p>
                    {step.description}
                  </p>

                </div>

              </div>

            ))}

          </div>

        </div>

      </div>
    </section>


    <!-- =====================================================
         5. CAPABILITIES
    ====================================================== -->

    <section
      id="caps"
      class="band bg-white"
    >
      <div class="shell">

        <div class="head-rule">

          <span class="dot"></span>

          <p class="eyebrow">
            {about?.capabilities?.eyebrow ||
              'Our capabilities'}
          </p>

          <span class="line"></span>

        </div>

        <div class="caps">

          {capabilities.map((capability, index) => (

            <div class="cap">

              <div class="medal">

                {index === 0 && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                  >
                    <circle cx="9" cy="8" r="3.2" />
                    <path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5" />
                    <path d="M16 5.5a3 3 0 0 1 0 5.6M18 20c0-2.3-.8-3.9-2.2-5" />
                  </svg>
                )}

                {index === 1 && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                  >
                    <path d="M12 2.5 20 6v6.2c0 4.6-3.3 8-8 9.3-4.7-1.3-8-4.7-8-9.3V6z" />
                    <path d="m8.8 12.2 2.2 2.2 4.3-4.6" />
                  </svg>
                )}

                {index === 2 && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                  >
                    <path d="M3 7.5h11v9H3zM14 10.5h4l3 3v3h-7z" />
                    <circle cx="7" cy="18" r="1.9" />
                    <circle cx="17" cy="18" r="1.9" />
                  </svg>
                )}

                {index === 3 && (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                  >
                    <circle cx="12" cy="12" r="9" />
                    <path d="M3 12h18M12 3c2.6 2.6 2.6 15 0 18-2.6-3-2.6-15.4 0-18z" />
                  </svg>
                )}

              </div>

              <div>

                <h3>
                  {capability.title}
                </h3>

                <p>
                  {capability.description}
                </p>

              </div>

            </div>

          ))}

        </div>


        <!-- Statistics -->

        {statistics.length > 0 && (
          <div class="stats">

            {statistics.map((stat, index) => (

              <div
                class:list={[
                  'stat',
                  {
                    'highlight-stat': index === 2
                  }
                ]}
              >

                <div>

                  <b>
                    {stat.value}

                    {stat.suffix && (
                      <em>
                        {stat.suffix}
                      </em>
                    )}
                  </b>

                  <span>
                    {stat.label}
                  </span>

                </div>

              </div>

            ))}

          </div>
        )}

      </div>
    </section>


    <!-- =====================================================
         6. LET'S TALK
    ====================================================== -->

    <section
      id="talk"
      class="talk-white-section py-10 sm:py-12 lg:py-16 bg-white relative overflow-hidden border-t border-slate-200"
    >
      <div class="shell relative z-10">

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">

          <!-- Left Image -->

          <div class="lg:col-span-5 relative">

            <div class="relative photo-split-frame rounded-2xl overflow-hidden shadow-xl border border-slate-200 group">

              <img
                src={cta?.image || "/images/services/process-step-1-collect.jpg"}
                alt={
                  cta?.imageAlt ||
                  'Techsteps fleet and collection team on site'
                }
                class="w-full h-[360px] sm:h-[420px] lg:h-[460px] object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                onerror="this.src='/images/brand/about-hero-bg.jpg'"
              />

              <div class="absolute inset-0 bg-gradient-to-t from-[#0A331E]/80 via-transparent to-transparent"></div>

              <div class="absolute bottom-5 left-5 right-5 flex items-center justify-between text-white text-xs font-mono tracking-wider">

                {cta?.badge && (
                  <span class="bg-[#0F623A] px-3.5 py-1.5 rounded-full font-medium shadow-md flex items-center gap-1.5 text-white">

                    <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>

                    {cta.badge}

                  </span>
                )}

                {cta?.secondaryBadge && (
                  <span class="text-white text-[11px] bg-[#0A331E]/85 px-2.5 py-1 rounded-md backdrop-blur-xs border border-emerald-500/20">
                    {cta.secondaryBadge}
                  </span>
                )}

              </div>

            </div>

            <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-[#0F623A]/10 rounded-full filter blur-2xl -z-10"></div>

          </div>


          <!-- Right Content -->

          <div class="lg:col-span-7">

            <div class="head-rule mb-5">

              <span class="dot"></span>

              <p class="eyebrow">
                {cta?.eyebrow}
              </p>

              <span class="line"></span>

            </div>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight leading-[1.08]">

              {cta?.title}

              {cta?.highlightedTitle && (
                <span class="text-[#0F623A] block mt-1">
                  {cta.highlightedTitle}
                </span>
              )}

            </h2>

            {cta?.description && (
              <p class="text-base sm:text-lg text-slate-600 max-w-2xl mt-5 leading-relaxed font-normal">
                {cta.description}
              </p>
            )}

            <div class="flex flex-wrap items-center gap-4 mt-8">

              {cta?.buttonLink && (
                <a
                  class="btn btn-primary text-white font-bold"
                  href={cta.buttonLink}
                >
                  <span class="text-white">
                    {cta.buttonText}
                  </span>

                  <span
                    aria-hidden="true"
                    class="text-white"
                  >
                    &rarr;
                  </span>
                </a>
              )}

              {cta?.secondaryButtonLink && (
                <a
                  class="btn btn-secondary"
                  href={cta.secondaryButtonLink}
                >
                  <span>
                    {cta.secondaryButtonText}
                  </span>
                </a>
              )}

            </div>

            <div class="talk-contactline mt-10 pt-6 border-t border-slate-200 flex flex-wrap gap-y-3 gap-x-8 text-sm text-slate-600">

              {cta?.phone && (
                <span>
                  <span class="text-slate-900 font-medium">
                    Call:
                  </span>

                  <a
                    href={`tel:${cta.phone.replace(/\s/g, '')}`}
                    class="hover:text-[#0F623A] font-medium transition-colors"
                  >
                    {cta.phone}
                  </a>
                </span>
              )}

              {cta?.email && (
                <span>
                  <span class="text-slate-900 font-medium">
                    Email:
                  </span>

                  <a
                    href={`mailto:${cta.email}`}
                    class="hover:text-[#0F623A] font-medium transition-colors"
                  >
                    {cta.email}
                  </a>
                </span>
              )}

              {cta?.hours && (
                <span>
                  <span class="text-slate-900 font-medium">
                    Hours:
                  </span>

                  {cta.hours}
                </span>
              )}

            </div>

          </div>

        </div>

      </div>
    </section>

  </div>
</BaseLayout>


<style>
.about-page-wrapper {
  --green-primary: #0F623A;
  --green-forest: #0F623A;
  --green-darkest: #0A331E;
  --green-hover: #124d2b;
  --green-light: #F2F8F5;
  --green-surface: #EFF8F3;

  --surface: #FFFFFF;
  --paper: #F8FAF9;
  --on-surface: #0F172A;
  --on-surface-dim: #475569;
  --hairline: #E2E8F0;
  --panel: #FFFFFF;

  --shell: 1320px;
  --gutter: clamp(20px, 5vw, 72px);
  --display: "Archivo", system-ui, sans-serif;
  --text: "IBM Plex Sans", system-ui, sans-serif;
  --cut: 46px;

  background: var(--surface);
  color: var(--on-surface);
  font-family: var(--text);
  font-size: clamp(15.5px, 1.02vw, 17px);
  line-height: 1.62;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

.about-page-wrapper *,
.about-page-wrapper *::before,
.about-page-wrapper *::after {
  box-sizing: border-box;
}

.about-page-wrapper img,
.about-page-wrapper svg {
  display: block;
  max-width: 100%;
}

.about-page-wrapper a {
  color: inherit;
}

.about-page-wrapper h1,
.about-page-wrapper h2,
.about-page-wrapper h3 {
  font-family: var(--display);
