    <!-- Synchronised Scroll Script: Ensures Title and Cards Move Up in Lockstep on Exit -->
    <script is:inline>
      (() => {
        const initStickySync = () => {
          const title = document.getElementById('approach-sticky-title');
          const cards = document.querySelectorAll('.approach-scroll-card');
          if (!title || !cards.length) return;

          const lastCard = cards[cards.length - 1];
          let ticking = false;

          const updateSync = () => {
            // Cards stick at top-[13.5rem] (216px) or sm:top-[14.5rem] (232px)
            const expectedCardTop = window.innerWidth >= 640 ? 232 : 216;
            const lastCardRect = lastCard.getBoundingClientRect();

            // When the last card reaches the end of the container and is pushed up,
            // push the title up by the exact same distance so they never collide!
            if (lastCardRect.top < expectedCardTop) {
              const pushDistance = expectedCardTop - lastCardRect.top;
              title.style.transform = `translateY(-${pushDistance}px)`;
            } else {
              title.style.transform = 'translateY(0px)';
            }
          };

          const onScroll = () => {
            if (!ticking) {
              requestAnimationFrame(() => {
                updateSync();
                ticking = false;
              });
              ticking = true;
            }
          };

          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll, { passive: true });
          updateSync();
        };

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initStickySync);
        } else {
          initStickySync();
        }
        document.addEventListener('astro:page-load', initStickySync);
      })();
    </script>

