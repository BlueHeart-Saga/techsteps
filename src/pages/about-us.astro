---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAboutPage } from '../lib/sanity/client';

const about = await getAboutPage().catch(() => ({}));

const canonicalUrl = 'https://techsteps.co.uk/about-us';

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://techsteps.co.uk/about-us#webpage',
  url: canonicalUrl,
  name: about?.metaTitle || 'About Techsteps — Managing What Matters',
  description: about?.metaDescription || 'We look after the assets that carry the most risk when a business changes — data, records, equipment and premises. Handled securely, recorded end to end, and returned to value wherever it can be.',
  mainEntity: {
    '@id': 'https://techsteps.co.uk/#organization',
  },
};
---

<BaseLayout
  title={about?.metaTitle || 'About Techsteps — Managing What Matters'}
  description={about?.metaDescription || 'We look after the assets that carry the most risk when a business changes — data, records, equipment and premises. Handled securely, recorded end to end, and returned to value wherever it can be.'}
  canonicalUrl={canonicalUrl}
  jsonLd={aboutPageSchema}
>
  <!-- Google Fonts for Archivo and IBM Plex Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
    slot="head"
  />

  <div class="about-page-wrapper">
    <!-- 1 · HERO WITH CLEAR, VIBRANT BACKGROUND IMAGE AS IT IS -->
    <section id="top" class="hero on-dark pt-28 sm:pt-36 lg:pt-40">
      <!-- Background Image Layer: Visible As It Is -->
      <div class="hero-bg-media absolute inset-0 select-none pointer-events-none overflow-hidden z-0" aria-hidden="true">
        <img
          src="/images/hero/about-hero-technicians.jpg"
          alt="Techsteps technicians in secure facility"
          class="w-full h-full object-cover object-center brightness-[0.92] contrast-[1.03] scale-100"
          loading="eager"
        />
        <!-- Subtle Natural Scrim for Text Readability without Obscuring Photo -->
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/45 to-black/20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/25"></div>
      </div>

      <div class="shell relative z-10">
        <div class="grid">
          <div>
            <p class="eyebrow lift">About Techsteps</p>
            <h1 class="lift">Managing What Matters.<span class="l2 text-[#3FB33D]">Protecting What Comes Next.</span></h1>
            <p class="lede lift text-white">We look after the assets that carry the most risk when a business changes — data, records, equipment and premises. Handled securely, recorded end to end, and returned to value wherever it can be.</p>
          </div>
          <figure class="hero-figure lift">
            <div class="photo border-2 border-white/20 shadow-2xl" data-caption="Techsteps secure processing facility">
              <img
                src="/images/hero/about-hero-technicians.jpg"
                alt="Techsteps secure processing facility"
                class="w-full h-full object-cover object-center"
                loading="eager"
              />
            </div>
            <div class="ring" aria-hidden="true"></div>
            <div class="seal" aria-hidden="true">Chain of<br>custody</div>
          </figure>
        </div>
      </div>
    </section>

    <!-- MANIFEST: Chamfered tiles riding the diagonal -->
    <div class="shell">
      <dl class="manifest lift">
        <div>
          <dt>IT Lifecycle</dt>
          <dd>Collection, secure erasure, ITAD and remarketing.</dd>
        </div>
        <div class="active-manifest">
          <dt>Information Management</dt>
          <dd>Storage, scanning and digital mailroom services.</dd>
        </div>
        <div>
          <dt>Moving &amp; Relocation</dt>
          <dd>Business, IT and heritage moves with specialist storage.</dd>
        </div>
      </dl>
    </div>

    <!-- 2 · WHO WE ARE (CLEAN WHITE SURFACE WITH VIBRANT LEAF GREEN ACCENTS) -->
    <section id="who" class="band bg-white">
      <div class="shell">
        <div class="head-rule">
          <span class="dot"></span>
          <p class="eyebrow">Who we are</p>
          <span class="line"></span>
        </div>
        <div class="who">
          <div class="body">
            <h2>Three disciplines, one chain of custody.</h2>
            <p class="first">Techsteps was built around a problem most businesses meet at the worst possible moment: what to do with the equipment, records and premises they are leaving behind.</p>
            <p>We started in secure IT disposal and grew into the services that sit either side of it. Today a single team can clear a floor, erase and remarket the hardware, digitise the paper records, move what stays and store what is not needed yet — under one point of accountability rather than four suppliers pointing at each other.</p>
            <p>That matters because the risk does not stop at the loading bay. Every asset we touch is logged, tracked and reported on, from the moment it leaves your site to the certificate that closes the job. Data-bearing media is erased or destroyed to standard. Equipment with life left in it is refurbished and resold, and the recovered value goes back to you.</p>
            <p>We work with organisations that cannot afford a gap in the record: NHS trusts and healthcare providers, councils and public bodies, financial and legal firms, schools and universities, museums and archives, and IT teams inside businesses of every size.</p>
            <ul class="sectors">
              <li><a href="/sectors/nhs">Healthcare &amp; NHS</a></li>
              <li><a href="/sectors/central-government">Public sector</a></li>
              <li><a href="/sectors/finance">Finance &amp; legal</a></li>
              <li><a href="/sectors">Education</a></li>
              <li><a href="/sectors">Heritage &amp; archives</a></li>
              <li><a href="/sectors">Corporate IT</a></li>
            </ul>
          </div>
          <div class="arcwrap">
            <svg viewBox="0 0 200 420" preserveAspectRatio="none" aria-hidden="true">
              <path d="M8 10 C 78 92, 104 200, 60 410" fill="none" stroke="rgba(63, 179, 61, 0.3)" stroke-width="1.8"/>
            </svg>
            <ol>
              <li>
                <p class="yr">Founded</p>
                <h3>Secure IT disposal</h3>
                <p>One job: get redundant IT off site without losing control of the data on it.</p>
              </li>
              <li>
                <p class="yr">Expanded</p>
                <h3>Records and media</h3>
                <p>Clients kept asking who would handle the paper. Storage and scanning followed.</p>
              </li>
              <li>
                <p class="yr">Scaled</p>
                <h3>Facilities and fleet</h3>
                <p>Dedicated secure premises, vetted crews and a tracked fleet covering the UK.</p>
              </li>
              <li class="now">
                <p class="yr">Today</p>
                <h3>Three divisions, one contract</h3>
                <p>Lifecycle, information and relocation run as one service with a single audit trail.</p>
              </li>
            </ol>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · WHAT WE DO (WHITE SURFACE WITH #3FB33D & #0F623A) -->
    <section id="do" class="band bg-white" style="padding-top:0">
      <div class="shell">
        <div class="head-rule">
          <span class="dot"></span>
          <p class="eyebrow">What we do</p>
          <span class="line"></span>
        </div>
        <div class="divisions">
          <article class="division">
            <div class="shot">
              <div class="photo" data-caption="Asset processing line">
                <img
                  src="/images/services/process-step-2-secure.jpg"
                  alt="IT Lifecycle asset processing"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
              <span class="no">01</span>
            </div>
            <h3>IT Lifecycle Services</h3>
            <p>Secure IT disposal, collection, ITAD, asset management, remarketing and recycling — with certified erasure and a full audit trail.</p>
            <a class="go" href="/it-lifecycle-services-destruction">Explore services <em aria-hidden="true">&rarr;</em></a>
          </article>
          <article class="division">
            <div class="shot">
              <div class="photo" data-caption="Records storage and scanning">
                <img
                  src="/images/services/process-step-3-sanitise.jpg"
                  alt="Records storage and scanning"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
              <span class="no">02</span>
            </div>
            <h3>Information Management</h3>
            <p>Document storage, scanning, digital mailroom, document management and media storage for organisations that must keep the record.</p>
            <a class="go" href="/information-management">Explore services <em aria-hidden="true">&rarr;</em></a>
          </article>
          <article class="division">
            <div class="shot">
              <div class="photo" data-caption="Relocation crew on site">
                <img
                  src="/images/services/process-step-1-collect.jpg"
                  alt="Relocation crew on site"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
              <span class="no">03</span>
            </div>
            <h3>Moving &amp; Relocation</h3>
            <p>Business relocation, IT relocation, heritage relocation and specialist storage, planned and crewed to keep you operating.</p>
            <a class="go" href="/moving-relocation-services">Explore services <em aria-hidden="true">&rarr;</em></a>
          </article>
        </div>
      </div>
    </section>

    <!-- 4 · APPROACH (DEEP FOREST GREEN #0F623A WITH #3FB33D SINE WAVE) -->
    <section id="approach" class="approach on-dark">
      <div class="shell">
        <div class="head-rule">
          <span class="dot"></span>
          <p class="eyebrow">Our approach</p>
          <span class="line"></span>
        </div>
        <h2>Every job runs the same four ways.</h2>
        <p class="intro">Different services, one method. It is what lets us give you a single line of accountability from the first survey to the final certificate.</p>
        <div class="flow">
          <svg viewBox="0 0 1000 80" preserveAspectRatio="none" aria-hidden="true">
            <path
              d="M120 12 C 250 12, 250 60, 375 60 S 500 12, 625 12 S 750 60, 875 60"
              fill="none"
              stroke="#3FB33D"
              stroke-width="2.5"
              stroke-dasharray="7 7"
              opacity=".9"
            />
          </svg>
          <div class="steps">
            <div class="step">
              <div class="hex">01</div>
              <h3>Secure</h3>
              <p>Vetted crews, tracked vehicles, controlled facilities. Custody recorded at every handover.</p>
            </div>
            <div class="step">
              <div class="hex">02</div>
              <h3>Smart</h3>
              <p>We survey before we lift. The plan is built around your operation, not our schedule.</p>
            </div>
            <div class="step">
              <div class="hex">03</div>
              <h3>Responsible</h3>
              <p>Reuse before recycling, zero to landfill, data destroyed to standard with evidence to match.</p>
            </div>
            <div class="step">
              <div class="hex">04</div>
              <h3>Value-focused</h3>
              <p>Working assets are refurbished and remarketed, and the recovered value comes back to you.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · CAPABILITIES (WHITE SURFACE WITH #3FB33D MEDALLIONS & SKEWED STATS) -->
    <section id="caps" class="band bg-white">
      <div class="shell">
        <div class="head-rule">
          <span class="dot"></span>
          <p class="eyebrow">Our capabilities</p>
          <span class="line"></span>
        </div>
        <div class="caps">
          <div class="cap">
            <div class="medal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="9" cy="8" r="3.2"/>
                <path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/>
                <path d="M16 5.5a3 3 0 0 1 0 5.6M18 20c0-2.3-.8-3.9-2.2-5"/>
              </svg>
            </div>
            <div>
              <h3>Specialist people</h3>
              <p>Vetted, trained crews who handle complex projects — live data centres, occupied buildings, fragile heritage collections.</p>
            </div>
          </div>
          <div class="cap">
            <div class="medal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 2.5 20 6v6.2c0 4.6-3.3 8-8 9.3-4.7-1.3-8-4.7-8-9.3V6z"/>
                <path d="m8.8 12.2 2.2 2.2 4.3-4.6"/>
              </svg>
            </div>
            <div>
              <h3>Secure facilities</h3>
              <p>Alarmed, access-controlled and CCTV-monitored premises with segregated areas for data-bearing media.</p>
            </div>
          </div>
          <div class="cap">
            <div class="medal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M3 7.5h11v9H3zM14 10.5h4l3 3v3h-7z"/>
                <circle cx="7" cy="18" r="1.9"/>
                <circle cx="17" cy="18" r="1.9"/>
              </svg>
            </div>
            <div>
              <h3>End-to-end service</h3>
              <p>Collection, processing, erasure, reporting, resale and recycling — handled in house, not passed down a chain.</p>
            </div>
          </div>
          <div class="cap">
            <div class="medal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="12" cy="12" r="9"/>
                <path d="M3 12h18M12 3c2.6 2.6 2.6 15 0 18-2.6-3-2.6-15.4 0-18z"/>
              </svg>
            </div>
            <div>
              <h3>Business coverage</h3>
              <p>UK-wide collections and relocations, with regional teams for multi-site programmes and rolling refresh cycles.</p>
            </div>
          </div>
        </div>

        <div class="stats">
          <div class="stat">
            <div>
              <b>20<em>+</em></b>
              <span>Years handling secure disposal and relocation</span>
            </div>
          </div>
          <div class="stat">
            <div>
              <b>500k<em>+</em></b>
              <span>Assets processed and reported on</span>
            </div>
          </div>
          <div class="stat highlight-stat">
            <div>
              <b>98<em>%</em></b>
              <span>Diverted from landfill through reuse and recycling</span>
            </div>
          </div>
          <div class="stat">
            <div>
              <b>UK</b>
              <span>Nationwide collection and service coverage</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 · TRUST & ACCREDITATIONS (COMMENTED OUT)
    <section id="trust" class="trust bg-white">
      <div class="shell">
        <div class="head-rule">
          <span class="dot"></span>
          <p class="eyebrow">Accreditations</p>
          <span class="line"></span>
        </div>
        <h2>Trust built into every process.</h2>
        <p class="sub">Certifications are only useful if you know what they prove. Here is what each one means for the work we do for you.</p>
        <div class="comb">
          <div class="badge">
            <div class="stamp stamp-green">ISO<br>27001</div>
            <h3>Information security</h3>
            <p>Independently audited controls over how your data is handled, stored and destroyed.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-forest">ISO<br>9001</div>
            <h3>Quality management</h3>
            <p>Documented procedures, so the job runs the same way every time and can be checked.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-green">ISO<br>14001</div>
            <h3>Environmental</h3>
            <p>Measured impact, reuse before recycling and zero to landfill.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-forest">ISO<br>45001</div>
            <h3>Health &amp; safety</h3>
            <p>Safe working on your site, from occupied offices to live data halls.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-green">ADISA</div>
            <h3>Asset disposal standard</h3>
            <p>Sector auditing of our ITAD process, including unannounced inspections.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-forest">CE<br>PLUS</div>
            <h3>Cyber Essentials Plus</h3>
            <p>Our own systems tested against the government-backed cyber standard.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-green">BAR</div>
            <h3>British Association of Removers</h3>
            <p>Commercial moving carried out to a recognised code of practice.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-forest">EA</div>
            <h3>Registered waste carrier</h3>
            <p>Licensed to transport and process waste electricals, with duty-of-care paperwork.</p>
          </div>
        </div>
        <p class="note">Certificates, licence numbers and insurance details are available on request, and supplied as standard with every tender response.</p>
      </div>
    </section>
    -->

    <!-- 7 · LET'S TALK ABOUT SECTION (WHITE BACKGROUND, SPLIT LAYOUT WITH IMAGE ON LEFT & CONTENT ON RIGHT) -->
    <section id="talk" class="talk-white-section py-16 sm:py-20 lg:py-28 bg-white relative overflow-hidden border-t border-slate-200">
      <div class="shell relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          
          <!-- Left Column: Visual Image Card with Services Green Badge -->
          <div class="lg:col-span-5 relative">
            <div class="relative photo-split-frame rounded-2xl overflow-hidden shadow-xl border border-slate-200 group">
              <img
                src="/images/services/process-step-1-collect.jpg"
                alt="Techsteps fleet and collection team on site"
                class="w-full h-[360px] sm:h-[420px] lg:h-[460px] object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                onerror="this.src='/images/brand/about-hero-bg.jpg'"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0A331E]/80 via-transparent to-transparent"></div>
              
              <!-- Bottom Badge on Image -->
              <div class="absolute bottom-5 left-5 right-5 flex items-center justify-between text-white text-xs font-mono tracking-wider">
                <span class="bg-[#3FB33D] px-3.5 py-1.5 rounded-full font-medium shadow-md flex items-center gap-1.5 text-white">
                  <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                  UK-WIDE LOGISTICS
                </span>
                <span class="text-white text-[11px] bg-[#0A331E]/85 px-2.5 py-1 rounded-md backdrop-blur-xs border border-emerald-500/20">
                  Vetted Crews
                </span>
              </div>
            </div>

            <!-- Ambient Background Accent Behind Image -->
            <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-[#3FB33D]/10 rounded-full filter blur-2xl -z-10"></div>
          </div>

          <!-- Right Column: Content, Headings, Buttons & Contact Details -->
          <div class="lg:col-span-7">
            <div class="head-rule mb-5">
              <span class="dot"></span>
              <p class="eyebrow">Get in touch with Techsteps</p>
              <span class="line"></span>
            </div>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight leading-[1.08]">
              Let's Talk About <span class="text-[#3FB33D] block mt-1">What Comes Next.</span>
            </h2>

            <p class="text-base sm:text-lg text-slate-600 max-w-2xl mt-5 leading-relaxed font-normal">
              Whether you need secure IT disposal, information management or relocation support, speak with the Techsteps team. We will survey, scope and quote before anything moves.
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4 mt-8">
              <a class="btn btn-primary" href="/contact">
                <span>Talk to Techsteps</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
              <a class="btn btn-secondary" href="/request-a-collection">
                <span>Request a Collection</span>
              </a>
            </div>

            <!-- Direct Contact Line -->
            <div class="talk-contactline mt-10 pt-6 border-t border-slate-200 flex flex-wrap gap-y-3 gap-x-8 text-sm text-slate-600">
              <span><span class="text-slate-900 font-medium">Call:</span> <a href="tel:+442079460888" class="hover:text-[#3FB33D] font-medium transition-colors">+44 (0) 20 7946 0888</a></span>
              <span><span class="text-slate-900 font-medium">Email:</span> <a href="mailto:hello@techsteps.co.uk" class="hover:text-[#3FB33D] font-medium transition-colors">hello@techsteps.co.uk</a></span>
              <span><span class="text-slate-900 font-medium">Hours:</span> Mon–Fri, 8am–6pm</span>
            </div>
          </div>

        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
.about-page-wrapper {
  /* Techsteps Services Page Signature Color System (#3FB33D + #0F623A + White) */
  --green-primary: #3FB33D;
  --green-forest: #0F623A;
  --green-darkest: #0A331E;
  --green-hover: #329532;
  --green-light: #F2F8F5;
  --green-surface: #EFF8F3;
  
  --surface: #FFFFFF;
  --paper: #F8FAF9;
  --on-surface: #0F172A;
  --on-surface-dim: #475569;
  --hairline: #E2E8F0;
  --panel: #FFFFFF;
  
  --shell: 1320px;
  --gutter: clamp(20px, 5vw, 72px);
  --display: "Archivo", system-ui, sans-serif;
  --text: "IBM Plex Sans", system-ui, sans-serif;
  --cut: 46px;

  background: var(--surface);
  color: var(--on-surface);
  font-family: var(--text);
  font-size: clamp(15.5px, 1.02vw, 17px);
  line-height: 1.62;
  overflow-x: hidden;
  -webkit-font-smoothing: antialiased;
}

.about-page-wrapper *,
.about-page-wrapper *::before,
.about-page-wrapper *::after {
  box-sizing: border-box;
}

.about-page-wrapper img,
.about-page-wrapper svg {
  display: block;
  max-width: 100%;
}

.about-page-wrapper a {
  color: inherit;
}

.about-page-wrapper h1,
.about-page-wrapper h2,
.about-page-wrapper h3 {
  font-family: var(--display);
  margin: 0;
  letter-spacing: -.026em;
  line-height: 1.03;
  font-weight: 600;
  color: #0F172A;
}

.on-dark h1,
.on-dark h2,
.on-dark h3 {
  color: #FFFFFF;
}

.about-page-wrapper p {
  margin: 0;
}

.shell {
  max-width: var(--shell);
  margin-inline: auto;
  padding-inline: var(--gutter);
  position: relative;
}

.eyebrow {
  font-size: 11.5px;
  font-weight: 500;
  letter-spacing: .2em;
  text-transform: uppercase;
  color: var(--green-primary);
}

.on-dark .eyebrow {
  color: #3FB33D;
}

/* Photo slots — chamfered "seal cut", never a plain rectangle */
.photo {
  position: relative;
  overflow: hidden;
  background: #0A331E;
  clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, var(--cut) 100%, 0 calc(100% - var(--cut)));
}

.photo img {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.photo::before {
  display: none;
}

.photo::after {
  content: attr(data-caption);
  position: absolute;
  left: 18px;
  bottom: 14px;
  font-size: 10px;
  letter-spacing: .16em;
  text-transform: uppercase;
  font-weight: 500;
  color: #FFFFFF;
  background: rgba(15, 98, 58, 0.88);
  padding: 3px 9px;
  border-radius: 4px;
  backdrop-filter: blur(4px);
  border: 1px solid rgba(255,255,255,0.2);
  z-index: 3;
}

/* 1 · HERO — diagonal bottom edge on services dark forest green */
.hero {
  background: var(--green-darkest);
  color: #fff;
  position: relative;
  padding-bottom: clamp(120px, 15vw, 210px);
