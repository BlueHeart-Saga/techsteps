}

.about-page-wrapper h1,
.about-page-wrapper h2,
.about-page-wrapper h3 {
  font-family: var(--display);
  margin: 0;
  letter-spacing: -.026em;
  line-height: 1.03;
  font-weight: 600;
  color: #0F172A;
}

.on-dark h1,
.on-dark h2,
