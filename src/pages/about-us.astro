/* 4 · APPROACH — clean surface with hex icons and connecting trajectory */
.approach {
  background: var(--surface);
  color: var(--on-surface);
  position: relative;
  padding-block: clamp(32px, 4.2vw, 56px);
}

.approach .head-rule .line {
