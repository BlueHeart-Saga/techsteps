---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import CTA from '../components/global/cta.astro';
import { getAboutPage } from '../lib/sanity/client';

const about = await getAboutPage();

const canonicalUrl = 'https://techsteps.co.uk/about-us';

const cta = about?.cta;

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://techsteps.co.uk/about-us#webpage',
  url: canonicalUrl,
  name:
    about?.metaTitle ||
    'About Techsteps — Managing What Matters',
  description:
    about?.metaDescription ||
    'TechSteps is an IT asset recovery and responsible recycling company. We partner with businesses to securely manage their retired technology.',
  mainEntity: {
    '@id': 'https://techsteps.co.uk/#organization',
  },
};
---

<BaseLayout
  title={about?.metaTitle || 'About Us — Techsteps'}
  description={about?.metaDescription || 'TechSteps is an IT asset recovery and responsible recycling company.'}
  canonicalUrl={canonicalUrl}
  jsonLd={aboutPageSchema}
  hasHeroHeader={true}
>
  <!-- Top Navigation Header on clean white background -->
  <HeroHeader isHome={false} />

  <div class="about-page-wrapper bg-white text-slate-900 selection:bg-[#0F623A] selection:text-white">

    <!-- =====================================================
         1. SECTION 1 — TECHNOLOGY WITH A PURPOSE (HERO)
    ====================================================== -->
    <section id="technology-purpose" class="relative bg-white pt-8 sm:pt-12 lg:pt-14 pb-0 overflow-hidden min-h-[596px] flex items-center">
      <div class="max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8 w-full">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-6 items-center">

          <!-- Left: Heading and Supporting Text -->
          <div class="lg:col-span-4 xl:col-span-4 text-left">
            <h1 class="text-4xl sm:text-5xl lg:text-[54px] font-semibold text-slate-900 tracking-tight leading-[1.08] font-display">
              Technology<br />With a Purpose
            </h1>
            <p class="mt-6 text-black text-lg sm:text-xl leading-relaxed max-w-sm">
              We give businesses a smarter way to manage their IT assets securely, responsibly, and sustainably.
            </p>
          </div>

          <!-- Center: Technician Worker Image -->
          <div class="lg:col-span-8 xl:col-span-8 flex justify-center items-center relative mt-6 mb-0 lg:my-0">
            <div class="relative w-full max-w-[771px] h-[596px] flex justify-center items-center mx-auto">
              <img
                src="/images/about/about hero.webp"
                alt="TechSteps technician wearing branded uniform"
                class="w-full h-full max-w-[771px] max-h-[596px] object-contain object-bottom drop-shadow-sm select-none mx-auto"
                width="771"
                height="596"
                loading="eager"
              />
            </div>
          </div>
        </div>
      </div>
    </section>


    <!-- =====================================================
         2. SECTION 2 — DRIVING A CLEANER, SMARTER TOMORROW.
    ====================================================== -->
    <section id="cleaner-smarter" class="bg-white pt-4 sm:pt-6 lg:pt-6 pb-10 sm:pb-12 lg:pb-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Centered Heading & Description -->
        <div class="text-center max-w-3xl mx-auto">
          <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-semibold text-slate-900 tracking-tight font-display leading-tight">
            Driving a Cleaner, Smarter Tomorrow.
          </h2>
          <p class="mt-3.5 text-black text-base sm:text-lg leading-relaxed max-w-2xl mx-auto">
We are one of the UK’s leading providers of secure and confidential shredding services. With years of experience in the industry, we have built an extensive customer base spanning all industries, public sectors, and sizes of businesses across the country.          </p>
        </div>

        <!-- Three Horizontally Aligned Value Indicators -->
        <div class="flex flex-wrap items-center justify-center gap-6 sm:gap-10 lg:gap-14 mt-8 sm:mt-10">
          <!-- 1. Secure Handling -->
          <div class="flex flex-col items-center text-center px-4">
            <img
              src="/images/about/Secure Handling.svg"
              alt="Secure Handling icon"
              class="w-10 h-10 object-contain mx-auto"
              loading="lazy"
            />
            <span class="mt-2 text-sm sm:text-base font-semibold text-slate-900">
              Secure Handling
            </span>
          </div>

          <div class="hidden sm:block w-px h-9 bg-slate-200" aria-hidden="true"></div>

          <!-- 2. Recover Value -->
          <div class="flex flex-col items-center text-center px-4">
            <img
              src="/images/about/Recover Value.svg"
              alt="Recover Value icon"
              class="w-10 h-10 object-contain mx-auto"
              loading="lazy"
            />
            <span class="mt-2 text-sm sm:text-base font-semibold text-slate-900">
              Recover Value
            </span>
          </div>

          <div class="hidden sm:block w-px h-9 bg-slate-200" aria-hidden="true"></div>

          <!-- 3. Sustainable Impact -->
          <div class="flex flex-col items-center text-center px-4">
            <img
              src="/images/about/Sustainable Impact.svg"
              alt="Sustainable Impact icon"
              class="w-10 h-10 object-contain mx-auto"
              loading="lazy"
            />
            <span class="mt-2 text-sm sm:text-base font-semibold text-slate-900">
              Sustainable Impact
            </span>
          </div>
        </div>

        <!-- Prominent Building Image -->
        <div class="mt-8 sm:mt-10 max-w-5xl mx-auto overflow-hidden">
          <img
            src="/images/about/building.webp"
            alt="TechSteps secure IT disposal and recycling facility"
            class="w-full h-auto object-contain mx-auto"
            loading="lazy"
          />
        </div>

      </div>
    </section>


    <!-- =====================================================
         3. SECTION 3 — MORE THAN RECYCLING. A BRIGHTER FUTURE.
    ====================================================== -->
    <section id="brighter-future" class="bg-white py-10 sm:py-12 lg:py-14 border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

          <!-- Left Column: Heading and Editorial Description -->
          <div class="lg:col-span-7">
            <h2 class="text-3xl sm:text-4xl lg:text-[46px] font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
              More Than<br />Recycling.<br />A Brighter Future.
            </h2>
            <p class="mt-4 sm:mt-5 text-black text-lg sm:text-xl leading-relaxed max-w-xl">
              We believe technology can create a better future — especially when it's handled responsibly. Our mission is to make IT asset management simple, secure, and sustainable for every business, helping you protect data and protect the planet.
            </p>
          </div>

          <!-- Right Column: Hand holding recovered IT hardware -->
          <div class="lg:col-span-5 flex justify-center lg:justify-end">
            <img
              src="/images/about/More Than Recycling. A Brighter Future. (1).webp"
              alt="Hand holding recovered IT components and hardware"
              class="w-full max-w-md h-auto object-contain rounded-2xl"
              loading="lazy"
            />
          </div>

        </div>
      </div>
    </section>


    <!-- =====================================================
         4. SECTION 4 — BUILT ON TRUST. DRIVEN BY IMPACT.
    ====================================================== -->
    <section id="trust-impact" class="bg-white py-10 sm:py-12 lg:py-14 border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Introductory Two-Column Area -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-10 items-center">
          <div class="lg:col-span-6">
            <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
              Built on Trust.<br />Driven by Impact.
            </h2>
          </div>
          <div class="lg:col-span-6">
            <p class="text-black text-lg sm:text-xl leading-relaxed max-w-lg lg:ml-auto">
              Our values guide everything we do — from how we handle your data and technology to the environmental impact of our operations.
            </p>
          </div>
        </div>

        <!-- Four Feature Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 mt-8 sm:mt-10">
          <!-- Card 1: Security First -->
          <div class="rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <img
              src="/images/about/Card 1_ Security First (Deep Forest Slate Theme).webp"
              alt="Security First: secure asset handling and compliance dashboard"
              class="w-full h-auto object-contain"
              loading="lazy"
            />
          </div>

          <!-- Card 2: Environmental Responsibility -->
          <div class="rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <img
              src="/images/about/Card 2_ Environmental Responsibility (Emerald Green Theme).webp"
              alt="Environmental Responsibility: recycling and responsible material recovery dashboard"
              class="w-full h-auto object-contain"
              loading="lazy"
            />
          </div>

          <!-- Card 3: Customer Focus -->
          <div class="rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <img
              src="/images/about/card 3.webp"
              alt="Customer Focus: transparency, service quality, and reliability dashboard"
              class="w-full h-auto object-contain"
              loading="lazy"
            />
          </div>

          <!-- Card 4: Continuous Improvement -->
          <div class="rounded-2xl overflow-hidden shadow-sm hover:shadow-md transition-shadow">
            <img
              src="/images/about/card-4 Deep Forest Theme.webp"
              alt="Continuous Improvement: circular economy and performance metrics dashboard"
              class="w-full h-auto object-contain"
              loading="lazy"
            />
          </div>
        </div>

      </div>
    </section>


    <!-- =====================================================
         5. SECTION 5 — PEOPLE. PLANET. PROGRESS.
    ====================================================== -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>

    <section id="people-planet-progress" class="bg-white py-10 sm:py-12 lg:py-14 border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

          <!-- Left Column: Hand holding plant in soil -->
          <div class="lg:col-span-5 flex justify-center lg:justify-start">
            <img
              src="/images/about/People. Planet. Progress. (1).webp"
              alt="Hand holding plant seedling in soil"
              class="w-full max-w-md h-auto object-contain rounded-2xl"
              loading="lazy"
            />
          </div>

          <!-- Right Column: Heading, Paragraph, and Three Metrics -->
          <div class="lg:col-span-7">
            <h2 class="text-3xl sm:text-4xl lg:text-[46px] font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
              People. Planet.<br />Progress.
            </h2>
            <p class="mt-4 sm:mt-5 text-black text-lg sm:text-xl leading-relaxed max-w-xl">
              We're committed to creating positive change through responsible IT asset recycling, reducing environmental impact, and supporting a circular economy.
            </p>

            <!-- Three Horizontally Aligned Metrics -->
            <div id="stats-counter-block" class="mt-7 sm:mt-9 flex flex-wrap items-center gap-6 sm:gap-8 lg:gap-10">
              <div class="stat-item flex-1 min-w-[120px] sm:min-w-0" aria-label="100K+ Devices Processed">
                <span
                  class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
                  aria-hidden="true"
                >
                  100K+
                </span>
                <span class="block mt-2 text-sm sm:text-base font-medium text-black">
                  Devices Processed
                </span>
              </div>

              <div class="hidden sm:block w-px h-10 bg-slate-200" aria-hidden="true"></div>

              <div class="stat-item flex-1 min-w-[120px] sm:min-w-0" aria-label="500+ Businesses Served">
                <span
                  class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
                  aria-hidden="true"
                >
                  500+
                </span>
                <span class="block mt-2 text-sm sm:text-base font-medium text-black">
                  Businesses Served
                </span>
              </div>

              <div class="hidden sm:block w-px h-10 bg-slate-200" aria-hidden="true"></div>

              <div class="stat-item flex-1 min-w-[120px] sm:min-w-0" aria-label="0% To Landfill (Recoverable)">
                <span
                  class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
                  aria-hidden="true"
                >
                  0%
                </span>
                <span class="block mt-2 text-sm sm:text-base font-medium text-black">
                  To Landfill (Recoverable)
                </span>
              </div>
            </div>

          </div>

        </div>
      </div>
    </section>


    <!-- =====================================================
         6. SECTION 6 — FROM A SIMPLE IDEA TO A BIGGER IMPACT.
    ====================================================== -->
    <section id="journey-milestones" class="bg-white py-10 sm:py-12 lg:py-14 border-t border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

        <!-- Introductory Two-Column Area -->
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-4 lg:gap-10 items-center">
          <div class="lg:col-span-6">
            <h2 class="text-3xl sm:text-4xl lg:text-[44px] font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
              From a Simple<br />Idea to a Bigger<br />Impact.
            </h2>
          </div>
          <div class="lg:col-span-6">
            <p class="text-black text-lg sm:text-xl leading-relaxed max-w-lg lg:ml-auto">
              What started as a vision to make IT disposal more responsible and secure has grown into a trusted service for businesses across the UK. Today, we continue to expand our impact, helping organisations turn retired technology into new opportunities.
            </p>
          </div>
        </div>

        <!-- Horizontal Timeline -->
        <div class="mt-8 sm:mt-10 mx-auto max-w-6xl">
          <div class="tl-track" id="tl-track">
            <!-- Step 0: Founded -->
            <div class="st" style="--i:0">
              <div class="nd" aria-hidden="false">
                <img src="/images/about/Founded.webp" alt="" />
              </div>
              <div class="stem" aria-hidden="true"></div>
              <div class="lb">
                <h3>Founded</h3>
                <p>With a vision for responsible IT disposal.</p>
              </div>
            </div>

            <!-- Step 1: Expanded -->
            <div class="st" style="--i:1">
              <div class="nd" aria-hidden="false">
                <img src="/images/about/Expanded.webp" alt="" />
              </div>
              <div class="stem" aria-hidden="true"></div>
              <div class="lb">
                <h3>Expanded</h3>
                <p>Our recycling capabilities.</p>
              </div>
            </div>

            <!-- Step 2: Partnered -->
            <div class="st" style="--i:2">
              <div class="nd" aria-hidden="false">
                <img src="/images/about/Partnered.webp" alt="" />
              </div>
              <div class="stem" aria-hidden="true"></div>
              <div class="lb">
                <h3>Partnered</h3>
                <p>With businesses across the UK.</p>
              </div>
            </div>

            <!-- Step 3: Driving -->
            <div class="st" style="--i:3">
              <div class="nd" aria-hidden="false">
                <img src="/images/about/Driving.webp" alt="" />
              </div>
              <div class="stem" aria-hidden="true"></div>
              <div class="lb">
                <h3>Driving</h3>
                <p>Long-term environmental and economic impact.</p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>


    <!-- =====================================================
         7. COMMON CTA SECTION
    ====================================================== -->
    <CTA
      title={cta?.title ? `${cta.title} ${cta?.highlightedTitle || ''}`.trim() : undefined}
      description={cta?.description}
      primaryText={cta?.buttonText || "Talk to Our Team"}
      primaryHref={cta?.buttonLink || "/contact"}
      secondaryText={cta?.secondaryButtonText || "Request a Collection"}
      secondaryHref={cta?.secondaryButtonLink || "/request-a-collection"}
    />

  </div>

  <script>
    function initAboutScrollAnimations() {
      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // 1. Stats Counter Animation
      const statsBlock = document.getElementById('stats-counter-block');
      if (statsBlock && statsBlock.dataset.observed !== 'true') {
        statsBlock.dataset.observed = 'true';

        const statElements = statsBlock.querySelectorAll('.stat-counter-number');

        if (!prefersReducedMotion && 'IntersectionObserver' in window && statElements.length) {
          const parsedStats: {
            element: Element;
            raw: string;
            prefix: string;
            target: number;
            suffix: string;
            start: number;
          }[] = [];

          statElements.forEach((el) => {
            const raw = (el.textContent || '').trim();
            const match = raw.match(/^([^\d]*)(\d+)(.*)$/);
            if (match) {
              const prefix = match[1] || '';
              const target = parseInt(match[2], 10);
              const suffix = match[3] || '';
              const start = target === 0 ? 100 : 0;
              parsedStats.push({
                element: el,
                raw,
                prefix,
                target,
                suffix,
                start,
              });
            }
          });

          if (parsedStats.length) {
            const statsObserver = new IntersectionObserver(
              (entries, observer) => {
                entries.forEach((entry) => {
                  if (entry.isIntersecting) {
                    observer.unobserve(entry.target);

                    const duration = 1900;
                    let startTime: number | null = null;

                    parsedStats.forEach((stat) => {
                      stat.element.textContent = stat.prefix + stat.start + stat.suffix;
                    });

                    function step(timestamp: number) {
                      if (!startTime) startTime = timestamp;
                      const elapsed = timestamp - startTime;
                      const p = Math.min(1, elapsed / duration);
                      const eased = 1 - Math.pow(1 - p, 3);

                      parsedStats.forEach((stat) => {
                        const current = Math.round(stat.start + (stat.target - stat.start) * eased);
                        stat.element.textContent = stat.prefix + current + stat.suffix;
                      });

                      if (p < 1) {
                        requestAnimationFrame(step);
                      } else {
                        parsedStats.forEach((stat) => {
                          stat.element.textContent = stat.raw;
                        });
                      }
                    }

                    requestAnimationFrame(step);
                  }
                });
              },
              { threshold: 0.6 }
            );

            statsObserver.observe(statsBlock);
          }
        }
      }

      // 2. Timeline Sequence Animation
      const tlTrack = document.getElementById('tl-track') as HTMLElement | null;
      if (tlTrack && tlTrack.dataset.observed !== 'true') {
        tlTrack.dataset.observed = 'true';

        if (prefersReducedMotion || !('IntersectionObserver' in window)) {
          tlTrack.classList.add('go');
        } else {
          const tlObserver = new IntersectionObserver(
            (entries, observer) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  observer.unobserve(entry.target);
                  tlTrack.classList.add('go');
                }
              });
            },
            { threshold: 0.35 }
          );

          tlObserver.observe(tlTrack);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAboutScrollAnimations);
    } else {
      initAboutScrollAnimations();
    }
    document.addEventListener('astro:page-load', initAboutScrollAnimations);
  </script>
</BaseLayout>


<style>
/* =========================================================
   STATS COUNTER ANIMATION
========================================================= */
.stat-counter-number {
  font-variant-numeric: tabular-nums;
  display: inline-block;
  min-width: 3.2ch;
}

/* =========================================================
   TIMELINE — DESKTOP (> 900px)
   4-column horizontal, node → stem → label below,
   connecting line drawn via ::after pseudo-element on .st
========================================================= */
.tl-track {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  position: relative;
}

/* Each step is a positioned column */
.st {
  position: relative;
  padding-top: 0;
}

/* Circle node: fixed 46×46px, dark green fill */
.nd {
  width: 46px;
  height: 46px;
  border-radius: 50%;
  background: #1f6b45;
  display: grid;
  place-items: center;
  position: relative;
  z-index: 2;
  flex-shrink: 0;
  transform-origin: center;
}

/* Icon inside node: MUST be exactly 24px, never grow */
.nd img,
.nd svg {
  width: 24px;
  height: 24px;
  max-width: none;
  flex: none;
  display: block;
}

/* Horizontal connecting line: drawn as ::after on .st */
/* Runs from the right edge of this node to the left edge of the next node */
.st::after {
  content: "";
  position: absolute;
  left: 46px;
  right: 0;
  top: 22px;
  height: 2px;
  background: #3a3f3d;
  transform-origin: left;
  z-index: 1;
}

/* Last step has no outgoing line */
.st:last-child::after {
  display: none;
}

/* Short vertical stem below node */
.stem {
  position: absolute;
  left: 22px;
  top: 46px;
  width: 1px;
  height: 38px;
  background: #3a3f3d;
}

/* Text block: sits below stem (top offset = node 46px + stem 38px + gap) */
.lb {
  margin-top: 90px;
  transform-origin: top left;
}

.lb h3 {
  font-size: 18px;
  font-weight: 600;
  color: #0f172a;
  margin: 0 0 6px;
  line-height: 1.3;
}

.lb p {
  font-size: 15px;
  color: #3c4a43;
  max-width: 190px;
  line-height: 1.55;
  margin: 0;
}
@media (min-width: 901px) {
  /* 1. icon fills the whole circle; the empty padding in the file then leaves a ~26px symbol */
  .tl-track .nd { width: 46px; height: 46px; }
  .tl-track .nd img { width: 100%; height: 100%; max-width: none; object-fit: contain; }

  /* 2. line continues past the last circle to the right edge */
  .tl-track .st:last-child::after { display: block; left: 46px; right: 0; }

  /* 3. shorter stem, tighter gap to the title */
  .tl-track .stem { height: 24px; }
  .tl-track .lb { margin-top: 46px; }

  /* 4. align with the heading: remove any left padding/margin on the track */
  .tl-track { padding-left: 0; margin-left: 0; }

  /* 5. wider text column, reference text sizes */
  .tl-track .lb h3 { font-size: 17px; font-weight: 600; }
  .tl-track .lb p  { font-size: 16px; line-height: 1.5; max-width: 215px; color: #222; }
}

/* =========================================================
   TIMELINE — MOBILE (<= 900px)
   Vertical list: node left, text right, line runs down
========================================================= */
@media (max-width: 900px) {
  .tl-track {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .st {
    display: flex;
    flex-direction: row;
    align-items: flex-start;
    padding-bottom: 2.5rem;
    position: relative;
  }

  .st:last-child {
    padding-bottom: 0;
  }

  /* Node stays 46px, no changes */
  .nd {
    flex-shrink: 0;
  }

  /* Vertical line: runs downward from bottom of node to next item */
  .st::after {
    left: 22px;
    right: auto;
    top: 46px;
    bottom: 0;
    width: 2px;
    height: auto;
    transform-origin: top;
  }

  /* Hide last item's line on mobile */
  .st:last-child::after {
    display: none;
  }

  /* Hide horizontal stems on mobile */
  .stem {
    display: none;
  }

  /* Text to the right of node */
  .lb {
    margin-top: 0;
    padding-left: 1.5rem;
    flex: 1;
  }

  .lb h3 {
    font-size: 16px;
    margin-top: 6px;
  }

  .lb p {
    font-size: 14px;
  }
}

