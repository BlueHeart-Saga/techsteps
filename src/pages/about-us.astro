  gap: clamp(10px, 1.4vw, 18px);
}

.stat {
  transform: skewX(-9deg);
  background: var(--green-darkest);
  color: #fff;
  padding: clamp(22px, 2.6vw, 34px) clamp(18px, 2.2vw, 30px);
