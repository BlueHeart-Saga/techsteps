            (entries, observer) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  observer.unobserve(entry.target);
                  tlTrack.classList.add('go');
                }
              });
            },
            { threshold: 0.35 }
          );

          tlObserver.observe(tlTrack);
        }
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initAboutScrollAnimations);
    } else {
