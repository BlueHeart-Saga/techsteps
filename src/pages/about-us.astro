---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getAboutPage } from '../lib/sanity/client';

const about = await getAboutPage().catch(() => ({}));

const canonicalUrl = 'https://techsteps.co.uk/about-us';
const currentPath = Astro.url.pathname;

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://techsteps.co.uk/about-us#webpage',
  url: canonicalUrl,
  name: about?.metaTitle || 'About Techsteps — Managing What Matters',
  description: about?.metaDescription || 'We look after the assets that carry the most risk when a business changes — data, records, equipment and premises. Handled securely, recorded end to end, and returned to value wherever it can be.',
  mainEntity: {
    '@id': 'https://techsteps.co.uk/#organization',
  },
};
---

<BaseLayout
  title={about?.metaTitle || 'About Techsteps — Managing What Matters'}
  description={about?.metaDescription || 'We look after the assets that carry the most risk when a business changes — data, records, equipment and premises. Handled securely, recorded end to end, and returned to value wherever it can be.'}
  canonicalUrl={canonicalUrl}
  jsonLd={aboutPageSchema}
>
  <!-- Google Fonts for Archivo and IBM Plex Sans -->
  <link rel="preconnect" href="https://fonts.googleapis.com" slot="head" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin slot="head" />
  <link
    href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700;800&family=IBM+Plex+Sans:wght@300;400;500;600;700&display=swap"
    rel="stylesheet"
    slot="head"
  />

  <div class="about-page-wrapper">
    <!-- 1 · HERO WITH CLEAR, VIBRANT BACKGROUND IMAGE AS IT IS -->
    <section id="top" class="hero on-dark pt-28 sm:pt-32 lg:pt-36">
      <!-- Background Image Layer: Visible As It Is -->
      <div class="hero-bg-media absolute inset-0 select-none pointer-events-none overflow-hidden z-0" aria-hidden="true">
        <img
          src="/images/hero/about-hero-technicians.jpg"
          alt="Techsteps technicians in secure facility"
          class="w-full h-full object-cover object-center brightness-[0.92] contrast-[1.03] scale-100"
          loading="eager"
        />
        <!-- Subtle Natural Scrim for Text Readability without Obscuring Photo -->
        <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/45 to-black/20"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-black/25"></div>
      </div>

      <div class="shell relative z-10">
        <!-- Breadcrumbs -->
        <nav class="flex items-center text-xs sm:text-sm font-sans font-medium text-slate-300/90 pb-4 sm:pb-6" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors duration-150">Home</a>
          <span class="inline-flex items-center">
            <span class="mx-2 text-slate-400/80">/</span>
            <span class="text-white font-semibold">About Us</span>
          </span>
        </nav>
        <div class="grid">
          <div>
            <p class="eyebrow lift">About Techsteps</p>
            <h1 class="lift">Managing What Matters.<span class="l2 text-[#0F623A]">Protecting What Comes Next.</span></h1>
            <p class="lede lift text-white">We protect your business's critical assets — data, records, and hardware — handled securely and returned to value.</p>
          </div>
          <figure class="hero-figure lift">
            <div class="photo border-2 border-white/20 shadow-2xl" data-caption="Techsteps secure processing facility">
              <img
                src="/images/hero/about-hero-technicians.jpg"
                alt="Techsteps secure processing facility"
                class="w-full h-full object-cover object-center"
                loading="eager"
              />
            </div>
            <div class="ring" aria-hidden="true"></div>
            <div class="seal" aria-hidden="true">Chain of<br>custody</div>
          </figure>
        </div>
      </div>
    </section>

    <!-- 2 · WHO WE ARE (EXACT REFERENCE DESIGN WITH SITE FONTS) -->
    <section id="who" class="band bg-white py-12 sm:py-16 lg:py-20">
      <div class="shell">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          <!-- Left Column: Content, Headline & 3 Icon Pillars -->
          <div class="lg:col-span-7 flex flex-col">
            <!-- Eyebrow with green line -->
            <div class="flex items-center gap-3 mb-4 sm:mb-5">
              <span class="text-xs sm:text-sm font-bold tracking-widest text-[#0F623A] uppercase font-sans">
                WHO WE ARE
              </span>
              <span class="w-8 h-[2.5px] bg-[#0F623A] rounded-full inline-block"></span>
            </div>

            <!-- Main Heading -->
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-950 tracking-tight leading-[1.12] mt-5 mb-8 sm:mb-10 lg:mb-12">
              Technology With <span class="text-[#0F623A]">Purpose</span>
            </h2>

            <!-- Narrative Paragraphs -->
            <div class="space-y-5 text-base sm:text-lg text-slate-700 leading-relaxed font-normal mb-3 sm:mb-4 pt-6">
              <p>
                Techsteps helps businesses manage the complete lifecycle of their IT and information assets &mdash; from secure collection and data destruction to remarketing, recycling and responsible recovery.
              </p>
              <p>
                Our approach combines security, sustainability and value recovery to help organisations handle retired assets with confidence.
              </p>
            </div>

            <!-- 3 Feature Pillars Row -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-0">
              <!-- Feature 1: Secure Asset Handling -->
              <div class="space-y-3">
                <div class="w-12 h-12 rounded-full bg-[#EBF5EF] text-[#0F623A] flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                </div>
                <div class="space-y-6">
                  <h3 class="text-base sm:text-[17px] font-bold text-slate-900 leading-snug">
                    Secure Asset<br class="hidden sm:inline" /> Handling
                  </h3>
                  <p class="text-xs sm:text-[13.5px] text-slate-500 leading-relaxed font-normal">
                    Protecting your data and your business.
                  </p>
                </div>
              </div>

              <!-- Feature 2: Responsible Recovery -->
              <div class="space-y-3">
                <div class="w-12 h-12 rounded-full bg-[#EBF5EF] text-[#0F623A] flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M20.24 12.24a6 6 0 0 0-8.49-8.49L5 10.5V19h8.5z" />
                    <line x1="16" y1="8" x2="2" y2="22" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </div>
                <div class="space-y-6">
                  <h3 class="text-base sm:text-[17px] font-bold text-slate-900 leading-snug">
                    Responsible<br class="hidden sm:inline" /> Recovery
                  </h3>
                  <p class="text-xs sm:text-[13.5px] text-slate-500 leading-relaxed font-normal">
                    Reducing e-waste, protecting the planet.
                  </p>
                </div>
              </div>

              <!-- Feature 3: Value From Retirements -->
              <div class="space-y-3">
                <div class="w-12 h-12 rounded-full bg-[#EBF5EF] text-[#0F623A] flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                </div>
                <div class="space-y-6">
                  <h3 class="text-base sm:text-[17px] font-bold text-slate-900 leading-snug">
                    Value From<br class="hidden sm:inline" /> Retirements
                  </h3>
                  <p class="text-xs sm:text-[13.5px] text-slate-500 leading-relaxed font-normal">
                    Giving IT assets a second life.
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Right Column: Image -->
          <div class="lg:col-span-5 flex items-center justify-center lg:justify-end">
            <div class="relative w-full max-w-[520px]">
              <img
                src="/images/about/who-we-are-technician.png"
                alt="Techsteps certified technician inspecting refurbished hardware"
                class="w-full h-auto object-contain max-h-[560px] drop-shadow-md mx-auto lg:ml-auto"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 3 · WHAT WE DO (WHITE SURFACE WITH #3FB33D & #0F623A) -->
    <section id="do" class="band bg-white" style="padding-top:0">
      <div class="shell">
        <div class="head-rule">
          <span class="dot"></span>
          <p class="eyebrow">What we do</p>
          <span class="line"></span>
        </div>
        <div class="divisions">
          <article class="division">
            <div class="shot">
              <div class="photo" data-caption="Asset processing line">
                <img
                  src="/images/services/process-step-2-secure.jpg"
                  alt="IT Lifecycle asset processing"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
              <span class="no">01</span>
            </div>
            <h3>IT Lifecycle Services</h3>
            <p>Secure IT disposal, collection, ITAD, asset management, remarketing and recycling — with certified erasure and a full audit trail.</p>
            <a class="go" href="/it-lifecycle-services-destruction">Explore services <em aria-hidden="true">&rarr;</em></a>
          </article>
          <article class="division">
            <div class="shot">
              <div class="photo" data-caption="Records storage and scanning">
                <img
                  src="/images/services/process-step-3-sanitise.jpg"
                  alt="Records storage and scanning"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
              <span class="no">02</span>
            </div>
            <h3>Information Management</h3>
            <p>Document storage, scanning, digital mailroom, document management and media storage for organisations that must keep the record.</p>
            <a class="go" href="/information-management">Explore services <em aria-hidden="true">&rarr;</em></a>
          </article>
          <article class="division">
            <div class="shot">
              <div class="photo" data-caption="Relocation crew on site">
                <img
                  src="/images/services/process-step-1-collect.jpg"
                  alt="Relocation crew on site"
                  class="w-full h-full object-cover"
                  loading="lazy"
                  onerror="this.style.display='none'"
                />
              </div>
              <span class="no">03</span>
            </div>
            <h3>Moving &amp; Relocation</h3>
            <p>Business relocation, IT relocation, heritage relocation and specialist storage, planned and crewed to keep you operating.</p>
            <a class="go" href="/moving-relocation-services">Explore services <em aria-hidden="true">&rarr;</em></a>
          </article>
        </div>
      </div>
    </section>

    <!-- 4 · APPROACH (CLEAN LIGHT SURFACE WITH ICONS) -->
    <section id="approach" class="approach">
      <div class="shell">
        <div class="head-rule">
          <span class="dot"></span>
          <p class="eyebrow">Our approach</p>
          <span class="line"></span>
        </div>
        <h2>Every job runs the same four ways.</h2>
        <p class="intro">Different services, one method. It is what lets us give you a single line of accountability from the first survey to the final certificate.</p>
        <div class="flow">
          <svg viewBox="0 0 1000 80" preserveAspectRatio="none" aria-hidden="true">
            <path
              d="M120 12 C 250 12, 250 60, 375 60 S 500 12, 625 12 S 750 60, 875 60"
              fill="none"
              stroke="#0F623A"
              stroke-width="2"
              stroke-dasharray="6 6"
              opacity=".4"
            />
          </svg>
          <div class="steps">
            <div class="step">
              <div class="hex" aria-label="Step 1: Secure">
                <svg class="hex-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
                  <path d="m9 12 2 2 4-4"/>
                </svg>
              </div>
              <h3>Secure</h3>
              <p>Vetted crews, tracked vehicles, controlled facilities. Custody recorded at every handover.</p>
            </div>
            <div class="step">
              <div class="hex" aria-label="Step 2: Smart">
                <svg class="hex-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-1 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/>
                  <path d="M9 18h6"/>
                  <path d="M10 22h4"/>
                </svg>
              </div>
              <h3>Smart</h3>
              <p>We survey before we lift. The plan is built around your operation, not our schedule.</p>
            </div>
            <div class="step">
              <div class="hex" aria-label="Step 3: Responsible">
                <svg class="hex-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M7 19H4.815a1.83 1.83 0 0 1-1.57-.881 1.785 1.785 0 0 1-.004-1.784L7.196 9.5"/>
                  <path d="M11 19h8.2a1.8 1.8 0 0 0 1.565-.89 1.78 1.78 0 0 0 .004-1.78l-3.955-6.83"/>
                  <path d="M8.2 5.8 12 2l3.8 3.8"/>
                  <path d="M12 2v10"/>
                </svg>
              </div>
              <h3>Responsible</h3>
              <p>Reuse before recycling, zero to landfill, data destroyed to standard with evidence to match.</p>
            </div>
            <div class="step">
              <div class="hex" aria-label="Step 4: Value-focused">
                <svg class="hex-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/>
                  <polyline points="16 7 22 7 22 13"/>
                </svg>
              </div>
              <h3>Value-focused</h3>
              <p>Working assets are refurbished and remarketed, and the recovered value comes back to you.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 5 · CAPABILITIES (WHITE SURFACE WITH #3FB33D MEDALLIONS & SKEWED STATS) -->
    <section id="caps" class="band bg-white">
      <div class="shell">
        <div class="head-rule">
          <span class="dot"></span>
          <p class="eyebrow">Our capabilities</p>
          <span class="line"></span>
        </div>
        <div class="caps">
          <div class="cap">
            <div class="medal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="9" cy="8" r="3.2"/>
                <path d="M3 20c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/>
                <path d="M16 5.5a3 3 0 0 1 0 5.6M18 20c0-2.3-.8-3.9-2.2-5"/>
              </svg>
            </div>
            <div>
              <h3>Specialist people</h3>
              <p>Vetted, trained crews who handle complex projects — live data centres, occupied buildings, fragile heritage collections.</p>
            </div>
          </div>
          <div class="cap">
            <div class="medal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M12 2.5 20 6v6.2c0 4.6-3.3 8-8 9.3-4.7-1.3-8-4.7-8-9.3V6z"/>
                <path d="m8.8 12.2 2.2 2.2 4.3-4.6"/>
              </svg>
            </div>
            <div>
              <h3>Secure facilities</h3>
              <p>Alarmed, access-controlled and CCTV-monitored premises with segregated areas for data-bearing media.</p>
            </div>
          </div>
          <div class="cap">
            <div class="medal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <path d="M3 7.5h11v9H3zM14 10.5h4l3 3v3h-7z"/>
                <circle cx="7" cy="18" r="1.9"/>
                <circle cx="17" cy="18" r="1.9"/>
              </svg>
            </div>
            <div>
              <h3>End-to-end service</h3>
              <p>Collection, processing, erasure, reporting, resale and recycling — handled in house, not passed down a chain.</p>
            </div>
          </div>
          <div class="cap">
            <div class="medal">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
                <circle cx="12" cy="12" r="9"/>
                <path d="M3 12h18M12 3c2.6 2.6 2.6 15 0 18-2.6-3-2.6-15.4 0-18z"/>
              </svg>
            </div>
            <div>
              <h3>Business coverage</h3>
              <p>UK-wide collections and relocations, with regional teams for multi-site programmes and rolling refresh cycles.</p>
            </div>
          </div>
        </div>

        <div class="stats">
          <div class="stat">
            <div>
              <b>20<em>+</em></b>
              <span>Years handling secure disposal and relocation</span>
            </div>
          </div>
          <div class="stat">
            <div>
              <b>500k<em>+</em></b>
              <span>Assets processed and reported on</span>
            </div>
          </div>
          <div class="stat highlight-stat">
            <div>
              <b>98<em>%</em></b>
              <span>Diverted from landfill through reuse and recycling</span>
            </div>
          </div>
          <div class="stat">
            <div>
              <b>UK</b>
              <span>Nationwide collection and service coverage</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- 6 · TRUST & ACCREDITATIONS (COMMENTED OUT)
    <section id="trust" class="trust bg-white">
      <div class="shell">
        <div class="head-rule">
          <span class="dot"></span>
          <p class="eyebrow">Accreditations</p>
          <span class="line"></span>
        </div>
        <h2>Trust built into every process.</h2>
        <p class="sub">Certifications are only useful if you know what they prove. Here is what each one means for the work we do for you.</p>
        <div class="comb">
          <div class="badge">
            <div class="stamp stamp-green">ISO<br>27001</div>
            <h3>Information security</h3>
            <p>Independently audited controls over how your data is handled, stored and destroyed.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-forest">ISO<br>9001</div>
            <h3>Quality management</h3>
            <p>Documented procedures, so the job runs the same way every time and can be checked.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-green">ISO<br>14001</div>
            <h3>Environmental</h3>
            <p>Measured impact, reuse before recycling and zero to landfill.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-forest">ISO<br>45001</div>
            <h3>Health &amp; safety</h3>
            <p>Safe working on your site, from occupied offices to live data halls.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-green">ADISA</div>
            <h3>Asset disposal standard</h3>
            <p>Sector auditing of our ITAD process, including unannounced inspections.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-forest">CE<br>PLUS</div>
            <h3>Cyber Essentials Plus</h3>
            <p>Our own systems tested against the government-backed cyber standard.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-green">BAR</div>
            <h3>British Association of Removers</h3>
            <p>Commercial moving carried out to a recognised code of practice.</p>
          </div>
          <div class="badge">
            <div class="stamp stamp-forest">EA</div>
            <h3>Registered waste carrier</h3>
            <p>Licensed to transport and process waste electricals, with duty-of-care paperwork.</p>
          </div>
        </div>
        <p class="note">Certificates, licence numbers and insurance details are available on request, and supplied as standard with every tender response.</p>
      </div>
    </section>
    -->

    <!-- 7 · LET'S TALK ABOUT SECTION (WHITE BACKGROUND, SPLIT LAYOUT WITH IMAGE ON LEFT & CONTENT ON RIGHT) -->
    <section id="talk" class="talk-white-section py-10 sm:py-12 lg:py-16 bg-white relative overflow-hidden border-t border-slate-200">
      <div class="shell relative z-10">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
          
          <!-- Left Column: Visual Image Card with Services Green Badge -->
          <div class="lg:col-span-5 relative">
            <div class="relative photo-split-frame rounded-2xl overflow-hidden shadow-xl border border-slate-200 group">
              <img
                src="/images/services/process-step-1-collect.jpg"
                alt="Techsteps fleet and collection team on site"
                class="w-full h-[360px] sm:h-[420px] lg:h-[460px] object-cover object-center group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                onerror="this.src='/images/brand/about-hero-bg.jpg'"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0A331E]/80 via-transparent to-transparent"></div>
              
              <!-- Bottom Badge on Image -->
              <div class="absolute bottom-5 left-5 right-5 flex items-center justify-between text-white text-xs font-mono tracking-wider">
                <span class="bg-[#0F623A] px-3.5 py-1.5 rounded-full font-medium shadow-md flex items-center gap-1.5 text-white">
                  <span class="w-2 h-2 rounded-full bg-white animate-pulse"></span>
                  UK-WIDE LOGISTICS
                </span>
                <span class="text-white text-[11px] bg-[#0A331E]/85 px-2.5 py-1 rounded-md backdrop-blur-xs border border-emerald-500/20">
                  Vetted Crews
                </span>
              </div>
            </div>

            <!-- Ambient Background Accent Behind Image -->
            <div class="absolute -bottom-6 -left-6 w-32 h-32 bg-[#0F623A]/10 rounded-full filter blur-2xl -z-10"></div>
          </div>

          <!-- Right Column: Content, Headings, Buttons & Contact Details -->
          <div class="lg:col-span-7">
            <div class="head-rule mb-5">
              <span class="dot"></span>
              <p class="eyebrow">Get in touch with Techsteps</p>
              <span class="line"></span>
            </div>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight leading-[1.08]">
              Let's Talk About <span class="text-[#0F623A] block mt-1">What Comes Next.</span>
            </h2>

            <p class="text-base sm:text-lg text-slate-600 max-w-2xl mt-5 leading-relaxed font-normal">
              Whether you need secure IT disposal, information management or relocation support, speak with the Techsteps team. We will survey, scope and quote before anything moves.
            </p>

            <!-- Action Buttons -->
            <div class="flex flex-wrap items-center gap-4 mt-8">
              <a class="btn btn-primary text-white font-bold" href="/contact">
                <span class="text-white">Talk to Techsteps</span>
                <span aria-hidden="true" class="text-white">&rarr;</span>
              </a>
              <a class="btn btn-secondary" href="/request-a-collection">
                <span>Request a Collection</span>
              </a>
            </div>

            <!-- Direct Contact Line -->
