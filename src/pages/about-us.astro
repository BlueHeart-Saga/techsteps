---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import CTA from '../components/global/cta.astro';
import { getAboutPage } from '../lib/sanity/client';

const about = await getAboutPage();

const canonicalUrl = 'https://techsteps.co.uk/about-us';

const cta = about?.cta;

const aboutPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': 'https://techsteps.co.uk/about-us#webpage',
  url: canonicalUrl,
  name:
    about?.metaTitle ||
    'About Techsteps — Managing What Matters',
  description:
    about?.metaDescription ||
    'TechSteps is an IT asset recovery and responsible recycling company. We partner with businesses to securely manage their retired technology.',
  mainEntity: {
    '@id': 'https://techsteps.co.uk/#organization',
  },
};
