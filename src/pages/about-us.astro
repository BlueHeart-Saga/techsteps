  color: #0F172A;
  max-width: 18ch;
}

.approach .intro {
  color: var(--on-surface-dim);
  max-width: 54ch;
  margin-top: 18px;
}

.flow {
  position: relative;
  margin-top: clamp(24px, 3.2vw, 40px);
}

.flow > svg {
  position: absolute;
  left: 0;
  right: 0;
  top: 34px;
  width: 100%;
  height: 70px;
  overflow: visible;
}

.steps {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: clamp(14px, 2vw, 28px);
  position: relative;
  z-index: 2;
}

.step {
  text-align: center;
  padding-top: 0;
}

.step:nth-child(odd) {
  transform: translateY(0);
}

.step:nth-child(even) {
  transform: translateY(28px);
}

.hex {
  width: 76px;
  height: 86px;
  margin: 0 auto 18px;
  background: var(--green-forest);
  color: #FFFFFF;
  clip-path: polygon(50% 0, 100% 25%, 100% 75%, 50% 100%, 0 75%, 0 25%);
