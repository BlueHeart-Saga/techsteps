  .hex {
    margin: 0;
  }
  .step p {
    margin-inline: 0;
  }
  .step h3 {
    margin-top: 6px;
  }
}

/* 5 · CAPABILITIES — medallions + green stats */
.caps {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: clamp(26px, 3.4vw, 52px);
}

.cap {
  display: grid;
  grid-template-columns: 78px 1fr;
  gap: 22px;
  align-items: start;
}

.medal {
  width: 78px;
  height: 78px;
  border-radius: 50%;
  display: grid;
  place-content: center;
  color: var(--green-forest);
  border: 1.5px solid var(--hairline);
  position: relative;
  background: var(--green-surface);
}

.medal::after {
  content: "";
  position: absolute;
  inset: -7px;
  border-radius: 50%;
  border: 1.5px dashed rgba(63,179,61,.45);
}

.medal svg {
  width: 32px;
  height: 32px;
}

.cap h3 {
  font-size: clamp(17px, 1.4vw, 20px);
  text-transform: uppercase;
  letter-spacing: .04em;
