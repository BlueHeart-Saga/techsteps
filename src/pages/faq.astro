---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import PageHero from '../components/hero/PageHero.astro';
import { getFaqPage, getSiteSettings } from '../lib/sanity/client';

const [faqPage, siteSettings] = await Promise.all([
  getFaqPage(),
  getSiteSettings(),
]);

const breadcrumbs = [
  { name: 'FAQ', url: '/faq' },
];

interface FAQCategory {
  id: string;
  name: string;
  icon: string;
}

interface FAQItem {
  id: string;
  category: string;
  question: string;
  answer: string;
}

const defaultIcons: Record<string, string> = {
  all: 'M4 6h16M4 12h16M4 18h16',
  general: 'M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  itad: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  records: 'M8 7v8a2 2 0 002 2h6M8 7V5a2 2 0 012-2h4.586a1 1 0 01.707.293l4.414 4.414a1 1 0 01.293.707V15a2 2 0 01-2 2h-2M8 7H6a2 2 0 00-2 2v10a2 2 0 002 2h8a2 2 0 002-2v-2',
  shredding: 'M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16',
  relocation: 'M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8a1 1 0 011-1h2.586a1 1 0 01.707.293l3.414 3.414a1 1 0 01.293.707V16a1 1 0 01-1 1h-1m-6-1a1 1 0 001 1h1M5 17a2 2 0 104 0m-4 0a2 2 0 114 0m6 0a2 2 0 104 0m-4 0a2 2 0 114 0',
  compliance: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
};

const rawCategories = faqPage.categories || [];
const categories: FAQCategory[] = rawCategories.map((c) => ({
  id: c.id,
  name: c.name,
  icon: c.icon || defaultIcons[c.id] || defaultIcons.general,
}));

const rawItems = (faqPage.items || []) as FAQItem[];

const faqsByCategory: Record<string, { title: string; icon: string; items: FAQItem[] }> = {};
categories.forEach((cat) => {
  if (cat.id !== 'all') {
    faqsByCategory[cat.id] = {
      title: cat.name,
      icon: cat.icon,
      items: rawItems.filter((i) => i.category === cat.id),
    };
  }
});

// Flatten for Schema.org and total count
const allFaqItems = rawItems;

const faqPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: allFaqItems.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.answer,
    },
  })),
};
---

<BaseLayout
  title={faqPage.metaTitle || "Frequently Asked Questions (FAQ) | Techsteps UK"}
  description={faqPage.metaDescription || "Comprehensive knowledge base answering questions about Techsteps IT lifecycle services, confidential shredding, document storage, relocation, and ESG compliance."}
  canonicalUrl="https://techsteps.co.uk/faq"
  jsonLd={faqPageSchema}
  hasHeroHeader={true}
>
  <!-- 1. Hero Section with Signature Integrated Header & Landscape -->
  <PageHero
    title={faqPage.hero?.title || "FREQUENTLY ASKED QUESTIONS"}
    eyebrow={faqPage.hero?.eyebrow || "KNOWLEDGE CENTER // FAQS"}
    subheading={faqPage.hero?.subheading || "Explore our comprehensive knowledge base covering secure IT asset disposition, confidential shredding, records management, relocations, and regulatory compliance."}
    breadcrumbs={breadcrumbs}
    bgImage={faqPage.hero?.bgImage || "/images/brand/about-hero-bg.jpg"}
    minHeight="min-h-[500px] sm:min-h-[540px] lg:min-h-[580px]"
    dividerColor="#F8FAF9"
  />

  <div class="bg-[#F8FAF9] min-h-screen text-[#0F172A] font-sans pb-24">
    <!-- 2. Search Bar Capsule (Floating Over Hero Boundary) -->
    <div class="relative z-20 max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 sm:-mt-12 mb-12 sm:mb-16">
      <div class="relative bg-white rounded-2xl sm:rounded-3xl p-2.5 sm:p-3 shadow-xl border border-slate-200/90 backdrop-blur-sm">
        <div class="relative flex items-center">
          <div class="absolute inset-y-0 left-0 pl-4 sm:pl-5 flex items-center pointer-events-none text-slate-400">
            <svg class="h-5 w-5 sm:h-6 sm:w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="search"
            id="faq-search"
            placeholder="Search by keyword (e.g. GDPR, shredding, ITAD, certificate, retrieval, ISO)..."
            class="w-full pl-12 sm:pl-14 pr-12 py-3.5 sm:py-4 rounded-xl sm:rounded-2xl bg-slate-50/80 hover:bg-slate-50 focus:bg-white border border-slate-200 focus:border-[#0F623A] focus:ring-4 focus:ring-[#0F623A]/15 text-slate-900 placeholder-slate-400 text-sm sm:text-base font-sans transition-all outline-none"
          />
          <button
            type="button"
            id="faq-clear-btn"
            class="hidden absolute inset-y-0 right-0 pr-4 sm:pr-5 flex items-center text-slate-400 hover:text-slate-700 transition-colors"
            aria-label="Clear search"
          >
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>
    </div>

    <!-- 3. Main 2-Column Layout (Chalky Info Structure) -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        
        <!-- Left Sidebar: Sticky Category Navigation (Like Chalky Info) -->
        <aside class="lg:col-span-4 xl:col-span-3 lg:sticky lg:top-32 space-y-3 z-10">
          <div class="bg-white rounded-3xl p-5 sm:p-6 border border-slate-200 shadow-sm space-y-3">
            <div class="flex items-center justify-between pb-3 border-b border-slate-100">
              <h3 class="text-xs font-bold text-slate-500 uppercase tracking-wider">
                Categories
              </h3>
              <span class="text-xs font-semibold px-2 py-0.5 rounded-full bg-slate-100 text-slate-600" id="sidebar-total-count">
                {allFaqItems.length} Qs
              </span>
            </div>

            <div class="space-y-1.5" id="faq-category-nav" role="tablist">
              {categories.map((cat, idx) => (
                <button
                  type="button"
                  data-category={cat.id}
                  role="tab"
                  aria-selected={idx === 0 ? 'true' : 'false'}
                  class={`faq-nav-btn w-full flex items-center justify-between px-3.5 py-3 rounded-xl text-left text-xs sm:text-sm font-semibold transition-all duration-200 group ${
                    idx === 0
                      ? 'bg-[#0F623A] text-white shadow-md shadow-[#0F623A]/20'
                      : 'text-slate-700 hover:bg-slate-50 hover:text-[#0F623A]'
                  }`}
                >
                  <div class="flex items-center gap-2.5 min-w-0 pr-2">
                    <svg class={`w-4 h-4 shrink-0 transition-colors ${idx === 0 ? 'text-[#0F623A]' : 'text-slate-400 group-hover:text-[#0F623A]'}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d={cat.icon} />
                    </svg>
                    <span class="truncate">{cat.name}</span>
                  </div>
                  {cat.id !== 'all' && (
                    <span class={`text-[11px] font-bold px-2 py-0.5 rounded-full shrink-0 ${idx === 0 ? 'bg-white/20 text-white' : 'bg-slate-100 text-slate-500'}`}>
                      {faqsByCategory[cat.id]?.items.length || 0}
                    </span>
                  )}
                </button>
              ))}
            </div>
          </div>

        </aside>

        <!-- Right Content Area: Category Groups with Directly Visible Q&A Cards -->
        <main class="lg:col-span-8 xl:col-span-9 space-y-12">
          
          <!-- Category Sections -->
          {Object.entries(faqsByCategory).map(([catId, catData]) => (
            <section
              id={`cat-${catId}`}
              class="faq-category-section scroll-mt-32 space-y-5"
              data-section-category={catId}
            >
              <!-- Category Header with Icon Badge -->
              <div class="flex items-center justify-between pb-4 border-b border-slate-200">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-xl bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center shrink-0">
                    <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                      <path stroke-linecap="round" stroke-linejoin="round" d={catData.icon} />
                    </svg>
                  </div>
                  <div>
                    <h2 class="text-xl sm:text-2xl font-bold text-slate-900 tracking-tight">
                      {catData.title}
                    </h2>
                  </div>
                </div>
                <span class="text-xs font-semibold px-2.5 py-1 rounded-full bg-slate-100 text-slate-600">
                  {catData.items.length} Questions
                </span>
              </div>

              <!-- Question & Answer Cards: Both Question and Answer are Directly Visible (NO HOVER NEEDED) -->
              <div class="space-y-4">
                {catData.items.map((item) => (
                  <article
                    class="faq-card bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:border-[#0F623A]/40 hover:shadow-md transition-all duration-200 p-6 sm:p-7 space-y-3.5"
                    data-card-category={catId}
                    data-keywords={`${item.question} ${item.answer} ${catData.title}`.toLowerCase()}
                  >
                    <!-- Question Heading with Badge -->
                    <div class="flex items-start justify-between gap-4">
                      <h3 class="font-bold text-slate-950 text-base sm:text-lg leading-snug">
                        {item.question}
                      </h3>
                      <span class="w-8 h-8 rounded-full bg-[#EFF8F3] text-[#0F623A] flex items-center justify-center shrink-0 text-xs font-bold" aria-hidden="true">
                        Q
                      </span>
                    </div>

                    <!-- Directly Visible Answer (NO HOVER TO REVEAL) -->
                    <div class="pt-3.5 border-t border-slate-100 text-slate-600 text-sm sm:text-[15.5px] leading-relaxed">
                      <p>{item.answer}</p>
                    </div>
                  </article>
                ))}
              </div>
            </section>
          ))}

          <!-- Empty State (Shows when Search yields 0 matches) -->
          <div id="faq-empty-state" class="hidden text-center py-16 px-6 bg-white rounded-3xl border border-slate-200 shadow-sm space-y-4">
            <div class="w-14 h-14 rounded-full bg-slate-100 text-slate-400 flex items-center justify-center mx-auto">
              <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg font-bold text-slate-900">No matching questions found</h3>
            <p class="text-sm text-slate-600 max-w-md mx-auto">
              We couldn't find any questions matching your search keywords. Try searching for broader terms like "data", "shredding", "retrieval", or "ISO".
            </p>
            <button
              type="button"
              id="faq-reset-btn"
              class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#0F623A] hover:bg-[#0A331E] text-white text-xs font-bold transition-all shadow-xs"
            >
              <span>Reset Search &amp; Show All</span>
            </button>
          </div>

          <!-- Bottom Assistance Banner -->
          <div class="bg-white rounded-3xl p-8 sm:p-10 border border-slate-200/90 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-6">
            <div class="space-y-1.5 text-center sm:text-left">
              <h3 class="text-lg sm:text-xl font-bold text-slate-900">
                {faqPage.contactCard?.heading || "Still can't find what you're looking for?"}
              </h3>
              <p class="text-sm text-slate-600">
                {faqPage.contactCard?.description || "Our compliance team is ready to answer specific technical, audit, or logistics questions."}
              </p>
            </div>
            <div class="flex items-center gap-3 shrink-0">
              <a
                href={faqPage.contactCard?.buttonLink || "/contact"}
                class="inline-flex items-center justify-center px-6 py-3 rounded-full bg-[#0F623A] hover:bg-[#0A331E] text-white text-sm font-bold shadow-md transition-all"
              >
                {faqPage.contactCard?.buttonText || "Contact Us"}
              </a>
            </div>
          </div>

        </main>
      </div>
    </div>
  </div>
</BaseLayout>

<script>
  function setupFaqInteractivePage() {
    const searchInput = document.getElementById('faq-search') as HTMLInputElement | null;
    const clearBtn = document.getElementById('faq-clear-btn');
    const resetBtn = document.getElementById('faq-reset-btn');
    const navButtons = document.querySelectorAll<HTMLButtonElement>('.faq-nav-btn');
    const categorySections = document.querySelectorAll<HTMLElement>('.faq-category-section');
    const faqCards = document.querySelectorAll<HTMLElement>('.faq-card');
    const emptyState = document.getElementById('faq-empty-state');

    if (!searchInput || !categorySections.length) return;

    let selectedCategory = 'all';
    let searchQuery = '';

    function filterView() {
      const query = searchQuery.trim().toLowerCase();
      let totalVisibleCards = 0;

      categorySections.forEach((section) => {
        const secCat = section.dataset.sectionCategory || '';
        const cardsInSection = section.querySelectorAll<HTMLElement>('.faq-card');
        let visibleCardsInSection = 0;

        // Check if category matches filter
        const categoryMatches = selectedCategory === 'all' || selectedCategory === secCat;

        cardsInSection.forEach((card) => {
          const cardKeywords = card.dataset.keywords || '';
          const matchesSearch = !query || cardKeywords.includes(query);

          if (categoryMatches && matchesSearch) {
            card.classList.remove('hidden');
            visibleCardsInSection++;
            totalVisibleCards++;
          } else {
            card.classList.add('hidden');
          }
        });

        // Hide section if no cards are visible within it
        if (visibleCardsInSection > 0) {
          section.classList.remove('hidden');
        } else {
          section.classList.add('hidden');
        }
      });

      // Handle Empty State
      if (emptyState) {
        if (totalVisibleCards === 0) {
          emptyState.classList.remove('hidden');
        } else {
          emptyState.classList.add('hidden');
        }
      }

      // Handle Search Clear button
      if (clearBtn) {
        if (query) {
          clearBtn.classList.remove('hidden');
        } else {
          clearBtn.classList.add('hidden');
        }
      }
    }

    // Category button click handler
    navButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.category || 'all';
        selectedCategory = cat;

        navButtons.forEach((b) => {
          b.setAttribute('aria-selected', 'false');
          b.classList.remove('bg-[#0F623A]', 'text-white', 'shadow-md', 'shadow-[#0F623A]/20');
          b.classList.add('text-slate-700', 'hover:bg-slate-50', 'hover:text-[#0F623A]');
          const icon = b.querySelector('svg');
          if (icon) {
            icon.classList.remove('text-[#0F623A]');
            icon.classList.add('text-slate-400');
          }
        });

        btn.setAttribute('aria-selected', 'true');
        btn.classList.add('bg-[#0F623A]', 'text-white', 'shadow-md', 'shadow-[#0F623A]/20');
        btn.classList.remove('text-slate-700', 'hover:bg-slate-50', 'hover:text-[#0F623A]');
        const activeIcon = btn.querySelector('svg');
        if (activeIcon) {
          activeIcon.classList.remove('text-slate-400');
          activeIcon.classList.add('text-[#0F623A]');
        }

        filterView();

        // If specific category selected, scroll to it smoothly if on desktop/mobile
        if (cat !== 'all') {
          const targetSection = document.getElementById(`cat-${cat}`);
          if (targetSection && !targetSection.classList.contains('hidden')) {
            targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
          }
        }
      });
    });

    // Search input handler
    searchInput.addEventListener('input', (e) => {
      searchQuery = (e.target as HTMLInputElement).value;
      filterView();
    });

    // Clear search button
    clearBtn?.addEventListener('click', () => {
      if (searchInput) {
        searchInput.value = '';
        searchQuery = '';
        searchInput.focus();
        filterView();
      }
    });

    // Reset button in empty state
    resetBtn?.addEventListener('click', () => {
      if (searchInput) searchInput.value = '';
      searchQuery = '';
      selectedCategory = 'all';

      navButtons.forEach((b, idx) => {
        if (idx === 0) {
          b.setAttribute('aria-selected', 'true');
          b.classList.add('bg-[#0F623A]', 'text-white', 'shadow-md', 'shadow-[#0F623A]/20');
          b.classList.remove('text-slate-700', 'hover:bg-slate-50', 'hover:text-[#0F623A]');
        } else {
          b.setAttribute('aria-selected', 'false');
          b.classList.remove('bg-[#0F623A]', 'text-white', 'shadow-md', 'shadow-[#0F623A]/20');
          b.classList.add('text-slate-700', 'hover:bg-slate-50', 'hover:text-[#0F623A]');
        }
      });

      filterView();
    });
  }

  setupFaqInteractivePage();
  document.addEventListener('astro:page-load', setupFaqInteractivePage);
</script>
