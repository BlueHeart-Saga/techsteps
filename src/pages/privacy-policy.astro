---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { siteSettings } from '../lib/sanity/data';

const breadcrumbs = [
  { name: 'Privacy Policy', url: '/privacy-policy' },
];
---

<BaseLayout
  title="Privacy Policy | UK GDPR Data Protection | Techsteps UK"
  description="Techsteps UK Privacy Policy. Learn how we handle corporate client information, respect UK GDPR rights, and ensure secure data handling."
>
  <div class="bg-brand-navy text-white py-16">
    <Container size="narrow">
      <Breadcrumbs items={breadcrumbs} theme="dark" />
      <div class="space-y-4 mt-6">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Data Protection Compliance</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
          Privacy Policy
        </h1>
        <p class="text-xs text-slate-300 font-mono">
          Last Updated: February 2026 &bull; Compliant with UK Data Protection Act 2018 &amp; UK GDPR
        </p>
      </div>
    </Container>
  </div>

  <Section theme="white">
    <Container size="narrow">
      <div class="prose max-w-none text-slate-700 space-y-6 text-sm sm:text-base leading-relaxed">
        <h2 class="text-xl font-bold text-brand-navy">1. Introduction &amp; Data Controller</h2>
        <p>
          {siteSettings.legalName} ("Techsteps", "we", "us", or "our") is dedicated to protecting the confidentiality and privacy of information entrusted to us. This Privacy Notice describes our practices regarding the collection, storage, and processing of personal data gathered via our website and corporate enquiries.
        </p>
        <p>
          Our registered office is at {siteSettings.address.street}, {siteSettings.address.city}, {siteSettings.address.county}, {siteSettings.address.postcode}, United Kingdom.
        </p>

        <h2 class="text-xl font-bold text-brand-navy">2. Information We Collect</h2>
        <p>
          When you request a quote, submit an enquiry, or engage our services, we may collect:
        </p>
        <ul class="list-disc pl-5 space-y-1">
          <li>Full name, job title, and company name</li>
          <li>Corporate email address and business telephone number</li>
          <li>Collection site address and operational postcodes</li>
          <li>Technical project scope details and hardware inventory counts</li>
        </ul>

        <h2 class="text-xl font-bold text-brand-navy">3. Legal Basis for Processing</h2>
        <p>
          We process personal data under the following lawful bases established by Article 6 of the UK GDPR:
        </p>
        <ul class="list-disc pl-5 space-y-1">
          <li><strong>Contractual Necessity:</strong> To prepare quotes and fulfill commercial service agreements.</li>
          <li><strong>Legal Obligation:</strong> To maintain mandatory Waste Transfer Notes and hazardous consignment manifests required by the Environment Agency.</li>
          <li><strong>Legitimate Interests:</strong> To secure and optimize our enterprise digital infrastructure.</li>
        </ul>

        <h2 class="text-xl font-bold text-brand-navy">4. Data Sharing &amp; Third Parties</h2>
        <p>
          We never sell, lease, or monetize your contact information. Data is disclosed only to accredited subcontractors (e.g. licensed UK smelters or bonded carriers) who are legally bound by strict confidentiality covenants matching ISO 27001 standards.
        </p>

        <h2 class="text-xl font-bold text-brand-navy">5. Your Statutory Rights</h2>
        <p>
          Under UK data protection law, you possess rights including the right of access (Subject Access Request), rectification, erasure, and restriction of processing. To exercise these rights, contact our Data Protection Officer at:
        </p>
        <p class="font-mono text-xs bg-slate-100 p-4 rounded-lg">
          Email: privacy@techsteps.co.uk<br />
          Postal: DPO, {siteSettings.legalName}, {siteSettings.address.street}, {siteSettings.address.postcode}
        </p>
      </div>
    </Container>
  </Section>
</BaseLayout>
