  <!-- Interactive Story Journey Hover & Click Script -->
  <script is:inline>
    (() => {
      const initStoryHover = () => {
        const container = document.getElementById('journey-story-container');
        if (!container) return;

        const cards = Array.from(container.querySelectorAll('.story-card'));
        if (!cards.length) return;

        const activateCard = (targetCard) => {
          cards.forEach((card) => {
            const drawer = card.querySelector('.story-drawer');
            const badge = card.querySelector('.story-badge');

            if (card === targetCard) {
              card.classList.add('active', 'shadow-md');
              card.classList.remove('shadow-xs');

              if (badge) {
                badge.classList.add('bg-brand-accent', 'text-white');
                badge.classList.remove('bg-slate-100', 'text-brand-navy', 'border', 'border-slate-200');
              }
              if (drawer) {
                drawer.style.maxHeight = '420px';
                drawer.style.opacity = '1';
              }
            } else {
              card.classList.remove('active', 'shadow-md');
              card.classList.add('shadow-xs');

              if (badge) {
                badge.classList.remove('bg-brand-accent', 'text-white');
                badge.classList.add('bg-slate-100', 'text-brand-navy', 'border', 'border-slate-200');
              }
              if (drawer) {
                drawer.style.maxHeight = '0px';
                drawer.style.opacity = '0';
              }
            }
          });
        };

        const deactivateAll = () => {
          cards.forEach((card) => {
            const drawer = card.querySelector('.story-drawer');
            const badge = card.querySelector('.story-badge');

            card.classList.remove('active', 'shadow-md');
            card.classList.add('shadow-xs');

            if (badge) {
              badge.classList.remove('bg-brand-accent', 'text-white');
              badge.classList.add('bg-slate-100', 'text-brand-navy', 'border', 'border-slate-200');
            }
            if (drawer) {
              drawer.style.maxHeight = '0px';
              drawer.style.opacity = '0';
            }
          });
        };

        cards.forEach((card) => {
          card.addEventListener('mouseenter', () => {
            activateCard(card);
          });

          card.addEventListener('mouseleave', () => {
            deactivateAll();
          });

          card.addEventListener('click', () => {
            if (card.classList.contains('active')) {
              deactivateAll();
            } else {
              activateCard(card);
            }
          });
        });

        // Ensure container mouseleave also closes any open card
        container.addEventListener('mouseleave', () => {
          deactivateAll();
        });

        // Initial state: all cards closed, image shows strictly on hover
        deactivateAll();
      };

      // Running stats counter animation on scroll into viewport (re-triggers each time user scrolls to it)
      const initStatsCounter = () => {
        const statsContainer = document.getElementById('stats-counter-section');
        if (!statsContainer) return;

        const counterItems = statsContainer.querySelectorAll('.stat-counter-item');
        if (counterItems.length === 0) return;

        let animFrameId = null;

        const resetNumbers = () => {
          if (animFrameId) {
            cancelAnimationFrame(animFrameId);
            animFrameId = null;
          }
          counterItems.forEach((item) => {
            const numSpan = item.querySelector('.stat-count-num');
            if (numSpan) {
              numSpan.textContent = '0';
            }
          });
        };

        const runAnimation = () => {
          if (animFrameId) {
            cancelAnimationFrame(animFrameId);
            animFrameId = null;
          }

          const duration = 1800; // 1.8 seconds running animation
          const startTime = performance.now();

          const update = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);

            // Cubic ease-out curve for smooth deceleration
            const easeProgress = 1 - Math.pow(1 - progress, 3);

            counterItems.forEach((item) => {
              const target = parseInt(item.getAttribute('data-target') || '0', 10);
              const currentVal = Math.floor(easeProgress * target);
              const numSpan = item.querySelector('.stat-count-num');
              if (numSpan) {
                numSpan.textContent = progress >= 1 ? target.toString() : currentVal.toString();
              }
            });

            if (progress < 1) {
              animFrameId = requestAnimationFrame(update);
            } else {
              animFrameId = null;
            }
          };

          animFrameId = requestAnimationFrame(update);
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  runAnimation();
                } else {
                  resetNumbers();
                }
              });
            },
            { threshold: 0.15 }
          );
          observer.observe(statsContainer);
        } else {
          runAnimation();
        }
      };



      // Scroll-based reveal animation for ITAD Section
      const initItadReveal = () => {
        const section = document.getElementById('itad-reveal-section');
        if (!section) return;

        const imgWrap = section.querySelector('.itad-reveal-image');
        const heading = section.querySelector('.itad-reveal-heading');
        const paragraph = section.querySelector('.itad-reveal-paragraph');
        if (!heading || !paragraph) return;

        // Check if user prefers reduced motion
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
          if (imgWrap) {
            imgWrap.style.opacity = '1';
            imgWrap.style.transform = 'none';
          }
          heading.style.opacity = '1';
          heading.style.transform = 'none';
          paragraph.style.opacity = '1';
          paragraph.style.transform = 'none';
          return;
        }

        // Prevent duplicate initialization on view transitions if already revealed
        if (section.dataset.revealed === 'true') {
          if (imgWrap) {
            imgWrap.style.opacity = '1';
            imgWrap.style.transform = 'translateY(0) scale(1)';
          }
          heading.style.opacity = '1';
          heading.style.transform = 'translateY(0)';
          paragraph.style.opacity = '1';
          paragraph.style.transform = 'translateY(0)';
          return;
        }

        // Set initial subtle hidden state
        if (imgWrap) {
          imgWrap.style.opacity = '0.15';
          imgWrap.style.transform = 'translateY(28px) scale(0.97)';
        }
        heading.style.opacity = '0';
        heading.style.transform = 'translateY(20px)';
        paragraph.style.opacity = '0';
        paragraph.style.transform = 'translateY(20px)';

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  section.dataset.revealed = 'true';
                  
                  // 1. Image begins revealing first
                  if (imgWrap) {
                    imgWrap.style.opacity = '1';
                    imgWrap.style.transform = 'translateY(0) scale(1)';
                  }

                  // 2. Heading smoothly glides & fades in shortly after
                  setTimeout(() => {
                    heading.style.opacity = '1';
                    heading.style.transform = 'translateY(0)';
                  }, 180);

                  // 3. Stagger reveal short paragraph next
                  setTimeout(() => {
                    paragraph.style.opacity = '1';
                    paragraph.style.transform = 'translateY(0)';
                  }, 420);

                  // Disconnect so once revealed it stays permanently visible
                  observer.disconnect();
                }
              });
            },
            {
              threshold: 0.15,
              rootMargin: '0px 0px -30px 0px'
            }
          );
          observer.observe(section);
        } else {
          // Fallback for browsers without IntersectionObserver
          if (imgWrap) {
            imgWrap.style.opacity = '1';
            imgWrap.style.transform = 'translateY(0) scale(1)';
          }
          heading.style.opacity = '1';
          heading.style.transform = 'translateY(0)';
          paragraph.style.opacity = '1';
          paragraph.style.transform = 'translateY(0)';
        }
      };

      const initWhyChooseReveal = () => {
        const section = document.getElementById('why-choose-us');
        if (!section) return;

        const revealElements = Array.from(section.querySelectorAll('.why-choose-reveal'));
        if (!revealElements.length) return;

        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (prefersReducedMotion) {
          revealElements.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        if (section.dataset.whyChooseRevealed === 'true') {
          revealElements.forEach((el) => el.classList.add('is-revealed'));
          return;
        }

        const reveal = () => {
          section.dataset.whyChooseRevealed = 'true';
          revealElements.forEach((el, index) => {
            el.style.transitionDelay = `${index * 140}ms`;
            el.classList.add('is-revealed');
          });
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              if (entries.some((entry) => entry.isIntersecting)) {
                reveal();
                observer.disconnect();
              }
            },
            { threshold: 0.12, rootMargin: '0px 0px -30px 0px' }
          );
          observer.observe(section);
        } else {
          reveal();
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initItadReveal();
          initStoryHover();
          initStatsCounter();
          initWhyChooseReveal();
        });
      } else {
        initItadReveal();
        initStoryHover();
        initStatsCounter();
        initWhyChooseReveal();
      }

      document.addEventListener('astro:page-load', () => {
        initItadReveal();
        initStoryHover();
        initStatsCounter();
        initWhyChooseReveal();
      });
    })();
  </script>

  <style>
    /* Why Choose TechSteps — Minimal 2×2 Feature Layout */
    .why-choose-reveal {
      opacity: 0;
      transform: translateY(24px);
      transition:
        opacity 0.65s cubic-bezier(0.16, 1, 0.3, 1),
        transform 0.65s cubic-bezier(0.16, 1, 0.3, 1);
      will-change: transform, opacity;
    }

    .why-choose-reveal.is-revealed {
      opacity: 1;
      transform: translateY(0);
    }

    .why-choose-feature-item {
      transition:
        opacity 650ms cubic-bezier(0.16, 1, 0.3, 1),
        transform 280ms ease;
    }

    .why-choose-feature-item:hover {
      transform: translateY(-3px);
    }

    .why-choose-img {
      will-change: transform;
      transition: transform 0.7s cubic-bezier(0.16, 1, 0.3, 1);
    }

    /* Accessibility: Prefers Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
      .why-choose-reveal {
        opacity: 1 !important;
        transform: none !important;
        transition: none !important;
      }
      .why-choose-img {
        transform: none !important;
        transition: none !important;
      }
      .why-choose-feature-item,
      .why-choose-feature-item.is-revealed:hover {
        transform: none !important;
        transition: none !important;
      }
    }
  </style>
</BaseLayout>
