        const container = document.getElementById('journey-story-container');
        if (!container) return;

        const cards = Array.from(container.querySelectorAll('.story-card'));
        if (!cards.length) return;

        const activateCard = (targetCard) => {
          cards.forEach((card) => {
            const drawer = card.querySelector('.story-drawer');
            const badge = card.querySelector('.story-badge');

            if (card === targetCard) {
              card.classList.add('active', 'shadow-md');
              card.classList.remove('shadow-xs');

              if (badge) {
                badge.classList.add('bg-brand-accent', 'text-white');
                badge.classList.remove('bg-slate-100', 'text-brand-navy', 'border', 'border-slate-200');
              }
              if (drawer) {
                drawer.style.maxHeight = '420px';
                drawer.style.opacity = '1';
              }
            } else {
              card.classList.remove('active', 'shadow-md');
              card.classList.add('shadow-xs');

              if (badge) {
                badge.classList.remove('bg-brand-accent', 'text-white');
                badge.classList.add('bg-slate-100', 'text-brand-navy', 'border', 'border-slate-200');
              }
              if (drawer) {
                drawer.style.maxHeight = '0px';
                drawer.style.opacity = '0';
              }
            }
          });
        };

        const deactivateAll = () => {
          cards.forEach((card) => {
            const drawer = card.querySelector('.story-drawer');
            const badge = card.querySelector('.story-badge');

            card.classList.remove('active', 'shadow-md');
            card.classList.add('shadow-xs');

            if (badge) {
              badge.classList.remove('bg-brand-accent', 'text-white');
              badge.classList.add('bg-slate-100', 'text-brand-navy', 'border', 'border-slate-200');
            }
            if (drawer) {
              drawer.style.maxHeight = '0px';
              drawer.style.opacity = '0';
            }
          });
        };

        cards.forEach((card) => {
          card.addEventListener('mouseenter', () => {
            activateCard(card);
          });

          card.addEventListener('mouseleave', () => {
            deactivateAll();
          });

          card.addEventListener('click', () => {
            if (card.classList.contains('active')) {
              deactivateAll();
            } else {
              activateCard(card);
            }
          });
        });

        // Ensure container mouseleave also closes any open card
        container.addEventListener('mouseleave', () => {
          deactivateAll();
        });

        // Initial state: all cards closed, image shows strictly on hover
        deactivateAll();
      };

      // Running stats counter animation on scroll into viewport (re-triggers each time user scrolls to it)
      const initStatsCounter = () => {
        const statsContainer = document.getElementById('stats-counter-section');
        if (!statsContainer) return;

        const counterItems = statsContainer.querySelectorAll('.stat-counter-item');
        if (counterItems.length === 0) return;

        let animFrameId = null;

        const resetNumbers = () => {
          if (animFrameId) {
            cancelAnimationFrame(animFrameId);
            animFrameId = null;
          }
          counterItems.forEach((item) => {
            const numSpan = item.querySelector('.stat-count-num');
            if (numSpan) {
              numSpan.textContent = '0';
            }
          });
        };

        const runAnimation = () => {
          if (animFrameId) {
            cancelAnimationFrame(animFrameId);
            animFrameId = null;
          }

          const duration = 1800; // 1.8 seconds running animation
          const startTime = performance.now();

          const update = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);

            // Cubic ease-out curve for smooth deceleration
            const easeProgress = 1 - Math.pow(1 - progress, 3);

            counterItems.forEach((item) => {
              const target = parseInt(item.getAttribute('data-target') || '0', 10);
              const currentVal = Math.floor(easeProgress * target);
              const numSpan = item.querySelector('.stat-count-num');
              if (numSpan) {
                numSpan.textContent = progress >= 1 ? target.toString() : currentVal.toString();
              }
            });

            if (progress < 1) {
              animFrameId = requestAnimationFrame(update);
            } else {
              animFrameId = null;
            }
          };

          animFrameId = requestAnimationFrame(update);
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  runAnimation();
                } else {
                  resetNumbers();
                }
              });
            },
            { threshold: 0.15 }
          );
          observer.observe(statsContainer);
        } else {
          runAnimation();
        }
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initStoryHover();
          initStatsCounter();
        });
      } else {
        initStoryHover();
        initStatsCounter();
      }

      document.addEventListener('astro:page-load', () => {
        initStoryHover();
        initStatsCounter();
      });
    })();
  </script>
</BaseLayout>
