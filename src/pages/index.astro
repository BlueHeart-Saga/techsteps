---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import HeroHome from '../components/hero/HeroHome.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import ProcessSteps from '../components/services/ProcessSteps.astro';
import SectorGrid from '../components/sectors/SectorGrid.astro';
import StatCounter from '../components/content/StatCounter.astro';
import TrustBadges from '../components/content/TrustBadges.astro';
import Testimonials from '../components/content/Testimonials.astro';
import {
  getHomePage,
  getDivisions,
  getServices,
  getSectors,
  getStatistics,
  getCaseStudies,
  getArticles,
} from '../lib/sanity/client';

const [
  homePage,
  divisions,
  services,
  sectors,
  statistics,
  caseStudies,
  articles,
] = await Promise.all([
  getHomePage(),
  getDivisions(),
  getServices(),
  getSectors(),
  getStatistics(),
  getCaseStudies(),
  getArticles(),
]);

// Select featured services from each division for the homepage
const featuredServices = services.filter((s) =>
  ['secure-it-disposal', 'it-asset-disposition-services', 'ultra-secure-hard-drive-destruction', 'document-storage', 'document-scanning', 'on-site-shredding', 'it-relocations-specialist', 'simpler-recycling-services'].includes(s.slug)
);

const serviceCards = homePage?.services?.cards || [];

const serviceImages = [
  '/images/services/1.webp',
  '/images/services/2.webp',
  '/images/services/3.webp',
  '/images/services/4.webp',
];

const formatServiceNumber = (numStr?: string, fallback = '01') => {
  if (!numStr) return fallback;
  const digits = numStr.replace(/[^0-9]/g, '');
  return digits ? digits.padStart(2, '0') : fallback;
};

const allServiceCards = serviceCards.slice(0, 4).map((card, idx) => ({
  id: idx,
  number: formatServiceNumber(card.divisionNumber, String(idx + 1).padStart(2, '0')),
  title: card.title || '',
  description: card.description || '',
  image: serviceImages[idx] || `/images/services/${idx + 1}.webp`,
  imageAlt: card.imageAlt || card.title || '',
  link: card.link || '#',
  buttonText: card.buttonText || 'Explore',
}));

const firstServiceCard = allServiceCards[0];
const remainingServiceCards = allServiceCards.slice(1, 4);

const divisionMetadata: Record<
  string,
  {
    image: string;
    imageAlt: string;
    accreditation: string;
  }
> = {
  'information-management': {
    image: '/images/services/document-storage.jpg',
    imageAlt: 'Climate-controlled high-density document archival warehouse with barcoded tracking',
    accreditation: 'ISO 27001 â€¢ BS 4971 â€¢ UK GDPR',
  },
  'it-lifecycle-services-destruction': {
    image: '/images/services/itad.jpg',
    imageAlt: 'Certified IT asset disposition and secure hardware testing facility',
    accreditation: 'ADISA 8.0 â€¢ DIPCOG â€¢ Zero Landfill',
  },
  'secure-shredding-document-integrity': {
    image: '/images/services/hard-drive-destruction.jpg',
    imageAlt: 'Industrial high-security data destruction and mobile shredding operations',
    accreditation: 'BS EN 15713 â€¢ DIN 66399 Level P-4/P-7',
  },
  'moving-relocation-services': {
    image: '/images/services/it-relocations.jpg',
    imageAlt: 'Specialist server rack migration and mission-critical commercial logistics',
    accreditation: 'BAR Accredited â€¢ SafeContractor â€¢ ISO 9001',
  },
};

