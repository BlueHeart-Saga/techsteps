  <Section theme="slate" padding="py-10 md:py-14" className="relative overflow-hidden border-t border-slate-200/80">
    <Container className="relative z-10 text-center max-w-4xl mx-auto space-y-8">
<h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-brand-navy tracking-tight leading-tight min-h-[2lh] min-h-[2.2em] flex items-center justify-center">
