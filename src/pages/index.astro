                src={firstServiceCard.image}
                alt={firstServiceCard.imageAlt || firstServiceCard.title || 'Information Management'}
                class="absolute inset-0 w-full h-full object-cover object-right group-hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
                decoding="async"
