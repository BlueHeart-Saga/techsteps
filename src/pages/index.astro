                <div class="relative z-10 flex-1 pr-3 sm:pr-4 max-w-xs sm:max-w-sm lg:max-w-md">
                  <span class="right-card-num text-2xl sm:text-3xl font-display font-light text-white/90 group-hover:text-[#00DF81] transition-colors duration-300 block mb-1 leading-none">
                    {card.number}
                  </span>
                  <h3 class="right-card-title text-xl sm:text-2xl lg:text-[26px] font-extrabold font-display text-white tracking-tight leading-[1.08] mb-1.5">
                    {card.title}
                  </h3>
                  <p class="right-card-desc text-xs sm:text-sm text-slate-300/90 leading-relaxed font-normal line-clamp-2">
                    {card.description}
                  </p>
                </div>

                <!-- Bottom/Right Circular Arrow Button with green border on hover -->
                <div class="relative z-10 self-end shrink-0 ml-2 sm:ml-3">
                  <span class="w-8 h-8 sm:w-9 sm:h-9 rounded-full bg-black/50 border border-white/20 group-hover:border-[#00DF81] group-hover:border-[2px] group-hover:shadow-[0_0_14px_rgba(0,223,129,0.4)] flex items-center justify-center text-white/70 group-hover:text-white transition-all duration-300 shadow-sm">
