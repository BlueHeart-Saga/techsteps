          <!-- Left Column: Tall Featured Card (7 cols out of 12 for the exact width proportion) -->
          <div class="lg:col-span-7 xl:col-span-7 flex flex-col">
            <a
              id="featured-service-card"
              href={firstServiceCard.link || '#'}
              class="group relative flex-1 h-full flex flex-col justify-end rounded-[16px] overflow-hidden min-h-[480px] sm:min-h-[520px] lg:min-h-[580px] p-6 sm:p-8 lg:p-10 shadow-lg hover:shadow-2xl transition-all duration-300 border border-black/10 bg-slate-950"
