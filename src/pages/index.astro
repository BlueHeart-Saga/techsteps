      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 xl:gap-16 items-center">
        <!-- Left: Transparent Graphic with Shaded Green Backing Accents -->
        <div class="lg:col-span-5 xl:col-span-5 flex justify-center">
          <div class="relative w-full max-w-[460px]">
            <img
              src="/images/brand/itad-intro-green.png"
              alt="TechSteps certified IT recycling and hardware disposition technician"
              class="relative z-10 w-full h-auto object-contain drop-shadow-md select-none"
              loading="lazy"
              decoding="async"
            />
          </div>
        </div>

        <!-- Right: Heading and Concise Narrative Content -->
        <div class="lg:col-span-7 xl:col-span-7 space-y-4 lg:space-y-5 text-left">
          <!-- Main Headline (Dark Green #0F623A) -->
          <h2 class="text-3xl sm:text-4xl lg:text-5xl xl:text-[52px] font-extrabold tracking-tight leading-[1.14] font-display text-[#0F623A]">
            {homePage?.intro?.heading || 'Secure ITAD Services in the UK'}
          </h2>

          <!-- Decorative underline bar (Dark Green #0F623A) -->
          <div class="flex items-center !mt-3 sm:!mt-3.5" aria-hidden="true">
            <span class="w-16 sm:w-24 h-1.5 bg-[#0F623A] rounded-full"></span>
          </div>

          <!-- Description Paragraph (Increased to 3 sentences for ideal visual balance) -->
          <p class="text-base sm:text-lg lg:text-[19px] text-slate-700 leading-relaxed font-normal min-h-[3lh] min-h-[4.8em]">
            {homePage?.intro?.description || "TechSteps provides a fully accredited IT disposal company framework designed for modern UK enterprises. We simplify the ITAD process by combining logistics with maximum security, helping you retire hardware without risk. From single-site pickups to complex IT asset disposal projects, our team ensures your redundant equipment is handled according to the highest environmental standards."}
          </p>
        </div>
      </div>

      <!-- 4 Stats Columns Spread Out With Large Spacing -->
      <div id="stats-counter-section" class="grid grid-cols-2 lg:grid-cols-4 gap-10 sm:gap-14 lg:gap-20 xl:gap-28 mt-16 sm:mt-20 text-center max-w-6xl xl:max-w-7xl mx-auto px-4 sm:px-6">
{
  homePage?.statistics?.map((stat) => (
    <div class="space-y-2.5">
      <div
        class="text-5xl sm:text-6xl lg:text-[70px] font-[900] text-[#0F623A] tracking-tight leading-none font-display stat-counter-item"
        data-target={stat.number || '0'}
        data-suffix={stat.suffix || ''}
      >
        <span class="stat-count-num">
          {stat.number}
        </span>
        <span class="stat-count-suffix">
          {stat.suffix}
        </span>
      </div>

      <p class="text-lg sm:text-xl lg:text-2xl font-bold text-slate-800 leading-snug min-h-[2lh] min-h-[2.75rem] sm:min-h-[3.25rem] flex items-center justify-center">
        {stat.label}
      </p>
    </div>
  ))
}
      </div>
    </Container>
  </Section>

