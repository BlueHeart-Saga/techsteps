    badge: 'PHASE 02 // LOGISTICS',
    tag: 'BS 7858 Vetted Drivers â€¢ Live GPS Telematics',
  },
  {
    stepNumber: '03',
    title: 'Planning & Approval',
    headline: 'Certified Data Sanitisation & Physical Destruction Verification',
    lead: 'Cryptographic data erasure or physical micro-granulation with documented compliance sign-off.',
