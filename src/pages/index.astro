  <!-- Section 4 — Our Services: Solutions for the Complete Business Lifecycle -->
  <section id="divisions" class="relative py-14 sm:py-18 lg:py-22 bg-[#F1F4EE] border-t border-slate-200/60 overflow-hidden">
    <Container className="relative z-10 max-w-7xl">
      <!-- Section Header -->
      <div class="text-center max-w-4xl mx-auto space-y-2.5 mb-10 sm:mb-12">
