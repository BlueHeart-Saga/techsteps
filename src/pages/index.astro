  <!-- Interactive Story Journey Hover & Click Script -->
  <script is:inline>
    (() => {
      const initStoryHover = () => {
        const container = document.getElementById('journey-story-container');
        if (!container) return;

        const cards = Array.from(container.querySelectorAll('.story-card'));
        if (!cards.length) return;

        const activateCard = (targetCard) => {
          cards.forEach((card) => {
            const drawer = card.querySelector('.story-drawer');
            const badge = card.querySelector('.story-badge');

            if (card === targetCard) {
              card.classList.add('active', 'shadow-md');
              card.classList.remove('shadow-xs');

              if (badge) {
                badge.classList.add('bg-brand-accent', 'text-white');
                badge.classList.remove('bg-slate-100', 'text-brand-navy', 'border', 'border-slate-200');
              }
              if (drawer) {
                drawer.style.maxHeight = '420px';
                drawer.style.opacity = '1';
              }
            } else {
              card.classList.remove('active', 'shadow-md');
              card.classList.add('shadow-xs');

              if (badge) {
                badge.classList.remove('bg-brand-accent', 'text-white');
                badge.classList.add('bg-slate-100', 'text-brand-navy', 'border', 'border-slate-200');
              }
              if (drawer) {
                drawer.style.maxHeight = '0px';
                drawer.style.opacity = '0';
              }
            }
          });
        };

        const deactivateAll = () => {
          cards.forEach((card) => {
            const drawer = card.querySelector('.story-drawer');
            const badge = card.querySelector('.story-badge');

            card.classList.remove('active', 'shadow-md');
            card.classList.add('shadow-xs');

            if (badge) {
              badge.classList.remove('bg-brand-accent', 'text-white');
              badge.classList.add('bg-slate-100', 'text-brand-navy', 'border', 'border-slate-200');
            }
            if (drawer) {
              drawer.style.maxHeight = '0px';
              drawer.style.opacity = '0';
            }
          });
        };

        cards.forEach((card) => {
          card.addEventListener('mouseenter', () => {
            activateCard(card);
          });

          card.addEventListener('mouseleave', () => {
            deactivateAll();
          });

          card.addEventListener('click', () => {
            if (card.classList.contains('active')) {
              deactivateAll();
            } else {
              activateCard(card);
            }
          });
        });

        // Ensure container mouseleave also closes any open card
        container.addEventListener('mouseleave', () => {
          deactivateAll();
        });

        // Initial state: all cards closed, image shows strictly on hover
        deactivateAll();
      };

      // Running stats counter animation on scroll into viewport (re-triggers each time user scrolls to it)
      const initStatsCounter = () => {
        const statsContainer = document.getElementById('stats-counter-section');
        if (!statsContainer) return;

        const counterItems = statsContainer.querySelectorAll('.stat-counter-item');
        if (counterItems.length === 0) return;

        let animFrameId = null;

        const resetNumbers = () => {
          if (animFrameId) {
            cancelAnimationFrame(animFrameId);
            animFrameId = null;
          }
          counterItems.forEach((item) => {
            const numSpan = item.querySelector('.stat-count-num');
            if (numSpan) {
              numSpan.textContent = '0';
            }
          });
        };

        const runAnimation = () => {
          if (animFrameId) {
            cancelAnimationFrame(animFrameId);
            animFrameId = null;
          }

          const duration = 1800; // 1.8 seconds running animation
          const startTime = performance.now();

          const update = (currentTime) => {
            const elapsed = currentTime - startTime;
            const progress = Math.min(elapsed / duration, 1);

            // Cubic ease-out curve for smooth deceleration
            const easeProgress = 1 - Math.pow(1 - progress, 3);

            counterItems.forEach((item) => {
              const target = parseInt(item.getAttribute('data-target') || '0', 10);
              const currentVal = Math.floor(easeProgress * target);
              const numSpan = item.querySelector('.stat-count-num');
              if (numSpan) {
                numSpan.textContent = progress >= 1 ? target.toString() : currentVal.toString();
              }
            });

            if (progress < 1) {
              animFrameId = requestAnimationFrame(update);
            } else {
              animFrameId = null;
            }
          };

          animFrameId = requestAnimationFrame(update);
        };

        if ('IntersectionObserver' in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  runAnimation();
                } else {
                  resetNumbers();
                }
              });
            },
            { threshold: 0.15 }
          );
          observer.observe(statsContainer);
        } else {
          runAnimation();
        }
      };

      // Interactive card swap for Section 4 (Our Services)
      const initServicesCardSwap = () => {
        const dataScript = document.getElementById('services-cards-data');
        const leftCard = document.getElementById('featured-service-card');
        const rightCards = document.querySelectorAll('.service-right-card');
        if (!dataScript || !leftCard || rightCards.length === 0) return;

        // Prevent duplicate initialization on view transitions
        if (leftCard.dataset.swapInitialized === 'true') return;
        leftCard.dataset.swapInitialized = 'true';

        let cardsData = [];
        try {
          cardsData = JSON.parse(dataScript.textContent || '[]');
        } catch {
          return;
        }
        if (cardsData.length < 2) return;

        let currentLeftIdx = 0;
        let currentRightIndices = [1, 2, 3];
        let isSwapping = false;

        rightCards.forEach((cardEl) => {
          const slotIdxStr = cardEl.getAttribute('data-slot-index');
          if (slotIdxStr === null) return;
          const slotIdx = parseInt(slotIdxStr, 10);

          const handleSwap = (e) => {
            e.preventDefault();
            if (isSwapping) return;
            isSwapping = true;

            const targetRightCard = cardEl;
            const clickedIdx = currentRightIndices[slotIdx];
            const prevLeftIdx = currentLeftIdx;

            // Smooth cross-fade transition
            leftCard.style.transition = 'opacity 180ms ease, transform 180ms ease';
            targetRightCard.style.transition = 'opacity 180ms ease, transform 180ms ease';
            leftCard.style.opacity = '0';
            leftCard.style.transform = 'scale(0.98)';
            targetRightCard.style.opacity = '0';
            targetRightCard.style.transform = 'scale(0.98)';

            setTimeout(() => {
              // Update state indices
              currentLeftIdx = clickedIdx;
              currentRightIndices[slotIdx] = prevLeftIdx;

              const newLeft = cardsData[currentLeftIdx];
              const newRight = cardsData[prevLeftIdx];

              if (newLeft) {
                leftCard.setAttribute('href', newLeft.link || '#');
                const leftImg = leftCard.querySelector('#featured-service-img');
                const leftNum = leftCard.querySelector('#featured-service-num');
                const leftTitle = leftCard.querySelector('#featured-service-title');
                const leftDesc = leftCard.querySelector('#featured-service-desc');
                const leftBtnText = leftCard.querySelector('#featured-service-btn-text');

                if (leftImg) {
                  leftImg.src = newLeft.image;
                  leftImg.alt = newLeft.imageAlt || newLeft.title;
                }
                if (leftNum) leftNum.textContent = newLeft.number;
                if (leftTitle) leftTitle.textContent = newLeft.title;
                if (leftDesc) leftDesc.textContent = newLeft.description;
                if (leftBtnText) leftBtnText.textContent = newLeft.buttonText || 'Explore';
              }

              if (newRight) {
                targetRightCard.setAttribute('href', newRight.link || '#');
                const rightImg = targetRightCard.querySelector('.right-card-img');
                const rightNum = targetRightCard.querySelector('.right-card-num');
                const rightTitle = targetRightCard.querySelector('.right-card-title');
                const rightDesc = targetRightCard.querySelector('.right-card-desc');

                if (rightImg) {
                  rightImg.src = newRight.image;
                  rightImg.alt = newRight.imageAlt || newRight.title;
                }
                if (rightNum) rightNum.textContent = newRight.number;
                if (rightTitle) rightTitle.textContent = newRight.title;
                if (rightDesc) rightDesc.textContent = newRight.description;
              }

              // Restore visual state
              leftCard.style.opacity = '1';
              leftCard.style.transform = 'scale(1)';
              targetRightCard.style.opacity = '1';
              targetRightCard.style.transform = 'scale(1)';

              setTimeout(() => {
                isSwapping = false;
              }, 180);
            }, 180);
          };

          cardEl.addEventListener('click', handleSwap);
          cardEl.addEventListener('keydown', (e) => {
            if (e.key === 'Enter' || e.key === ' ') {
              handleSwap(e);
            }
          });
        });
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initStoryHover();
          initStatsCounter();
          initServicesCardSwap();
        });
      } else {
        initStoryHover();
        initStatsCounter();
        initServicesCardSwap();
      }

      document.addEventListener('astro:page-load', () => {
        initStoryHover();
        initStatsCounter();
        initServicesCardSwap();
      });
    })();
  </script>
</BaseLayout>
