                  </span>
                </div>
              </div>
            </a>
          </div>

          <!-- Right Column: 3 Stacked Horizontal Cards (5 cols out of 12) -->
          <div class="lg:col-span-5 xl:col-span-5 flex flex-col gap-3.5 sm:gap-4 lg:gap-4 justify-between">
            {remainingServiceCards.map((card, idx) => (
              <a
                href={card.link || '#'}
                data-slot-index={idx}
                class="service-right-card group relative flex-1 flex items-center justify-between rounded-[16px] overflow-hidden p-5 sm:p-6 lg:p-7 shadow-md hover:shadow-2xl transition-all duration-300 border-[1.5px] border-white/10 border-l-[5px] border-l-white/15 hover:border-[#00DF81] hover:border-l-[5px] hover:border-l-[#00DF81] bg-slate-950 min-h-[160px] sm:min-h-[175px] cursor-pointer"
