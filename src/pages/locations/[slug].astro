<script>
  function initLocationForm() {
    const form = document.getElementById('location-collection-form') as HTMLFormElement | null;
    const successBox = document.getElementById('location-form-success');
    const refCodeSpan = document.getElementById('loc-ref-code');

    if (!form || !successBox || !refCodeSpan) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
      const originalBtnText = submitBtn ? submitBtn.textContent : '';
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'SUBMITTING...';
      }

      const formData = new FormData(form);
      const firstName = (formData.get('firstName') as string) || '';
      const lastName = (formData.get('lastName') as string) || '';
      const fullName = `${firstName} ${lastName}`.trim();
      const company = (formData.get('company') as string) || '';
      const email = (formData.get('email') as string) || '';
      const phone = (formData.get('phone') as string) || '';
      const postcode = (formData.get('postcode') as string) || '';
      const details = (formData.get('details') as string) || '';
      const enquiryType = (formData.get('enquiryType') as string) || 'Business';

      const randomId = Math.floor(1000 + Math.random() * 9000);
      const ref = `TS-LOC-${randomId}`;

      const payload = {
        formType: 'collection',
        serviceType: 'Location IT Asset Collection',
        reference: ref,
        name: fullName,
        company,
        email,
        phone,
        address: postcode,
        details,
        notes: `Enquiry Type: ${enquiryType}. Collection Details: ${details}`,
      };

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const result = await res.json();
        if (!res.ok || !result.success) {
          throw new Error(result?.message || 'Failed to submit request');
        }

        refCodeSpan.textContent = result.reference || ref;
        successBox.classList.remove('hidden');
        form.reset();
        successBox.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
      } catch (err: any) {
        console.error('Location form submission error:', err);
        alert(err?.message || 'Unable to submit your collection request. Please try again.');
      } finally {
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = originalBtnText;
        }
      }
    });
  }

  initLocationForm();
  document.addEventListener('astro:page-load', initLocationForm);
</script>
