---
/**
 * [slug].astro
 * Dynamic City & Regional IT Equipment Collection Landing Page
 * Route: /locations/[slug]
 * 
 * Recreates the exact reference image design tailored to each UK city/region:
 * - Localised breadcrumb, hero & top-rated Google review badge
 * - 4 Key service guarantee cards
 * - 2-column split with dedicated booking form on left & local compliance on right
 * - Interactive Boroughs / Districts coverage pill cloud
 * - 8 City-specific FAQs using unified FAQSection component
 * - Bottom "Ready to book?" CTA bar
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import FAQSection from '../../components/FAQSection.astro';
import { locationsList, getLocationBySlug } from '../../data/locationsData';
import { getSiteSettings, getLocations } from '../../lib/sanity/client';

export async function getStaticPaths() {
  const locations = await getLocations();
  const list = locations && locations.length > 0 ? locations : locationsList;
  return list.map((loc) => ({
    params: { slug: loc.slug },
    props: { location: loc },
  }));
}


const rawLocation = Astro.props.location;
const fallbackLocation = getLocationBySlug(rawLocation.slug) || rawLocation;
const location = {
  ...fallbackLocation,
  ...rawLocation,
  seoTitle: rawLocation.seoTitle || fallbackLocation.seoTitle,
  metaDescription: rawLocation.metaDescription || fallbackLocation.metaDescription,
  faqs: (rawLocation.faqs && rawLocation.faqs.length >= 8) ? rawLocation.faqs : fallbackLocation.faqs,
  boroughsOrDistricts: (rawLocation.boroughsOrDistricts && rawLocation.boroughsOrDistricts.length > 0) ? rawLocation.boroughsOrDistricts : fallbackLocation.boroughsOrDistricts,
  featuredTestimonial: rawLocation.featuredTestimonial || fallbackLocation.featuredTestimonial,
};

const siteSettings = await getSiteSettings();

const pageTitle = location.seoTitle || `Free IT Recycling Near Me in ${location.name} | Techsteps`;
const pageDescription = location.metaDescription || location.heroDescription;

const origin = Astro.site?.origin || 'https://techsteps.co.uk';
const pageUrl = `${origin}/locations/${location.slug}`;

const locationJsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'LocalBusiness',
    '@id': `${pageUrl}#localbusiness`,
    name: `Techsteps IT Recycling - ${location.name}`,
    description: pageDescription,
    url: pageUrl,
    telephone: location.phone || '+44 1784 640216',
    address: {
      '@type': 'PostalAddress',
      addressLocality: location.name,
      addressRegion: location.region,
      addressCountry: 'GB',
    },
    areaServed: location.boroughsOrDistricts,
    priceRange: '££',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: (location.faqs || []).map((faq) => ({
      '@type': 'Question',
      name: faq.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faq.answer,
      },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Home',
        item: `${origin}/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Locations',
        item: `${origin}/locations`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: location.name,
        item: pageUrl,
      },
    ],
  },
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  canonicalUrl={pageUrl}
  jsonLd={locationJsonLd}
  hasHeroHeader={false}
>
  <!-- =====================================================
       1. HERO SECTION (CORPORATE GREEN THEME - MATCHING FOOTER)
       ===================================================== -->
  <section class="relative pt-10 pb-14 sm:pt-14 sm:pb-16 lg:pt-16 lg:pb-20 bg-[#062C20] text-white overflow-hidden">
    <!-- Ambient Backdrop Pattern -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_50%_-10%,rgba(163,230,205,0.14),rgba(6,44,32,0))] pointer-events-none"></div>

    <Container>
      <div class="relative z-10">
        
        <!-- Top Bar: Breadcrumb + Google Reviews Badge -->
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-8">
          <!-- Breadcrumb -->
          <nav class="flex items-center gap-1.5 text-xs sm:text-[13px] text-emerald-100/70 font-sans" aria-label="Breadcrumb">
            <a href="/" class="hover:text-white underline underline-offset-2">Home</a>
            <span>&gt;</span>
            <a href="/locations" class="hover:text-white underline underline-offset-2">IT recycling near me free reference across England &amp; Wales</a>
            <span>&gt;</span>
            <span class="text-white font-medium">{location.name}</span>
          </nav>

          <!-- Top Rated Google Badge -->
          <div class="inline-flex items-center gap-3 bg-white text-slate-900 px-4 py-2 rounded-[14px] shadow-md shrink-0 self-start md:self-auto">
            <div class="text-left leading-tight">
              <span class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider font-mono">
                Top Rated Service
              </span>
              <div class="flex items-center gap-1.5 mt-0.5">
                <span class="font-bold text-[14px] text-slate-900">Google</span>
                <span class="text-amber-500 text-xs">★★★★★</span>
                <span class="text-xs font-semibold text-slate-700">{location.rating}</span>
              </div>
            </div>
            <div class="text-[11px] text-slate-500 font-medium pl-2 border-l border-slate-200">
              {location.reviewCount}+ verified<br />UK reviews
            </div>
          </div>
        </div>

        <!-- Headline & Subtitle -->
        <div class="max-w-3xl">
          <h1 class="text-3xl sm:text-4xl lg:text-[46px] font-bold tracking-tight text-[#B8EC4C] font-display leading-[1.12] mb-4">
            {location.tagline}
          </h1>

          <p class="text-base sm:text-lg text-emerald-50/90 leading-relaxed font-sans mb-8 max-w-2xl">
            {location.heroDescription}
          </p>

          <div>
            <a
              href="#book-collection-form"
              class="inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-[10px] bg-[#B8EC4C] hover:bg-[#a6d83e] text-[#0A261F] font-bold text-sm sm:text-base uppercase tracking-wider shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 font-sans"
            >
              REQUEST MY COLLECTION
            </a>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- =====================================================
       2. 4-PILLAR SERVICE GUARANTEE SECTION
       ===================================================== -->
  <section class="py-14 sm:py-16 bg-white border-b border-slate-200/80">
    <Container>
      <!-- Section Header -->
      <div class="max-w-3xl mb-10">
        <h2 class="text-2xl sm:text-3xl lg:text-[34px] font-bold text-[#062C20] font-display tracking-tight leading-tight mb-3">
          Clear communication. Easy collection. Certificates provided.
        </h2>
        <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
          Unused IT equipment can create storage, data security and environmental challenges for businesses. Whether you are upgrading office technology or clearing redundant equipment, choosing a suitable recycling service helps protect business information and manage electronic waste responsibly.
        </p>
      </div>

      <!-- 4 Cards Grid (Light Green Theme with Plain Stroke Icons - No Circle/Box Border) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
        
        <!-- Card 1 -->
        <div class="p-6 rounded-[20px] bg-[#F4FAF6] border border-[#D2EBDC] hover:border-emerald-300 hover:shadow-xs transition-all flex flex-col justify-between">
          <div>
            <svg class="w-8 h-8 text-[#07572F] mb-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375A1.125 1.125 0 012.25 17.625V5.625A1.125 1.125 0 013.375 4.5h9.75a1.125 1.125 0 011.125 1.125v4.875m-11.25 8.25h11.25m0-8.25h4.125a1.125 1.125 0 011.125 1.125v4.5a1.125 1.125 0 01-.33.795l-2.07 2.07a1.125 1.125 0 01-.795.33H14.25m0-8.25v8.25m6 0a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0" />
            </svg>
            <h3 class="font-display font-bold text-base text-[#062C20] leading-snug mb-2">
              Free qualifying collections
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed font-sans">
              Free collection for 10+ qualifying laptops, PCs or servers across {location.name} and surrounding areas, subject to collection eligibility.
            </p>
          </div>
        </div>

        <!-- Card 2 -->
        <div class="p-6 rounded-[20px] bg-[#F4FAF6] border border-[#D2EBDC] hover:border-emerald-300 hover:shadow-xs transition-all flex flex-col justify-between">
          <div>
            <svg class="w-8 h-8 text-[#07572F] mb-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
            </svg>
            <h3 class="font-display font-bold text-base text-[#062C20] leading-snug mb-2">
              Secure data destruction
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed font-sans">
              Appropriate data destruction options for retired IT equipment, including software-based erasure and physical destruction, depending on device requirements.
            </p>
          </div>
        </div>

        <!-- Card 3 -->
        <div class="p-6 rounded-[20px] bg-[#F4FAF6] border border-[#D2EBDC] hover:border-emerald-300 hover:shadow-xs transition-all flex flex-col justify-between">
          <div>
            <svg class="w-8 h-8 text-[#07572F] mb-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z" />
            </svg>
            <h3 class="font-display font-bold text-base text-[#062C20] leading-snug mb-2">
              Certificates always provided
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed font-sans">
              Relevant collection and processing documentation, including applicable Waste Transfer Notes and Certificates of Destruction.
            </p>
          </div>
        </div>

        <!-- Card 4 -->
        <div class="p-6 rounded-[20px] bg-[#F4FAF6] border border-[#D2EBDC] hover:border-emerald-300 hover:shadow-xs transition-all flex flex-col justify-between">
          <div>
            <svg class="w-8 h-8 text-[#07572F] mb-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
            <h3 class="font-display font-bold text-base text-[#062C20] leading-snug mb-2">
              Carbon-negative recycling
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed font-sans">
              Reuse and recovery are prioritised where suitable, helping reduce unnecessary electronic waste and supporting responsible recycling.
            </p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- =====================================================
       3. 2-COLUMN BOOKING FORM & LOCAL CONTENT
       ===================================================== -->
  <section class="py-16 sm:py-20 bg-[#F8FAF9]">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 xl:gap-12 items-start">
        
        <!-- ===================================================
             LEFT: DARK BOOKING FORM CARD (MATCHING SCREENSHOT)
             =================================================== -->
        <div
          id="book-collection-form"
          class="lg:col-span-6 bg-[#062C20] text-white rounded-[24px] p-6 sm:p-8 lg:p-10 shadow-xl border border-emerald-900/60 scroll-mt-28"
        >
          <!-- Success State Notification (Shown After Submit) -->
          <div id="location-form-success" class="hidden mb-6 p-5 rounded-[16px] bg-emerald-500/20 border border-emerald-400 text-white space-y-2 animate-fadeIn">
            <div class="flex items-center gap-3">
              <span class="w-8 h-8 rounded-full bg-emerald-400 text-slate-900 flex items-center justify-center font-bold text-base shrink-0">✓</span>
              <h3 class="font-bold text-base text-white">
                Collection Request Logged! Reference: <span id="loc-ref-code" class="font-mono underline text-[#B8EC4C]"></span>
              </h3>
            </div>
            <p class="text-xs sm:text-sm text-slate-200 pl-11">
              Our {location.name} dispatch team will contact you within 2 working hours with collection date availability.
            </p>
          </div>

          <div class="mb-6">
            <h2 class="text-2xl sm:text-3xl font-bold font-display text-white tracking-tight mb-2">
              Book your free {location.name} IT collection
            </h2>
            <p class="text-xs sm:text-[13.5px] text-slate-300 leading-relaxed font-sans">
              Complete our enquiry form in less than 2 minutes. Our team will review your requirements and contact you by email or phone to discuss collection arrangements. Tell us what equipment you need collected, and we will confirm the available collection options. We will collect eligible equipment from your premises, manage the agreed processing requirements and provide relevant documentation.
            </p>
          </div>

          <form id="location-collection-form" class="space-y-4 text-xs sm:text-sm">
            
            <!-- Enquiry Type Radio Toggle -->
            <div>
              <label class="block text-xs font-semibold text-slate-300 mb-1.5">
                Enquiry type <span class="text-emerald-400">*</span>
              </label>
              <div class="flex items-center gap-3">
                <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 cursor-pointer text-xs font-medium">
                  <input type="radio" name="enquiryType" value="Business" checked class="text-[#B8EC4C] focus:ring-0" />
                  <span>Business</span>
                </label>
                <label class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/15 cursor-pointer text-xs font-medium">
                  <input type="radio" name="enquiryType" value="Personal" class="text-[#B8EC4C] focus:ring-0" />
                  <span>Personal</span>
                </label>
              </div>
              <p class="text-[11px] text-slate-400 mt-1">
                We support businesses, educational institutions, charities and public sector organisations. This service is intended for business equipment rather than household or private waste.
              </p>
            </div>

            <!-- Name Field -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
              <div class="space-y-1">
                <label for="loc_first_name" class="block text-xs font-semibold text-slate-300">
                  First name <span class="text-emerald-400">*</span>
                </label>
                <input
                  type="text"
                  id="loc_first_name"
                  name="firstName"
                  required
                  placeholder="First name"
                  class="w-full bg-white text-slate-900 rounded-[8px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#B8EC4C]"
                />
              </div>
              <div class="space-y-1">
                <label for="loc_last_name" class="block text-xs font-semibold text-slate-300">
                  Last name <span class="text-emerald-400">*</span>
                </label>
                <input
                  type="text"
                  id="loc_last_name"
                  name="lastName"
                  required
                  placeholder="Last name"
                  class="w-full bg-white text-slate-900 rounded-[8px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#B8EC4C]"
                />
              </div>
            </div>

            <!-- Company Name -->
            <div class="space-y-1">
              <label for="loc_company" class="block text-xs font-semibold text-slate-300">
                Company name
              </label>
              <input
                type="text"
                id="loc_company"
                name="company"
                placeholder="Your company name"
                class="w-full bg-white text-slate-900 rounded-[8px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#B8EC4C]"
              />
              <p class="text-[11px] text-slate-400">
                Please provide your organisation's name and business details to help us review your collection request.
              </p>
            </div>

            <!-- Email -->
            <div class="space-y-1">
              <label for="loc_email" class="block text-xs font-semibold text-slate-300">
                Email <span class="text-emerald-400">*</span>
              </label>
              <input
                type="email"
                id="loc_email"
                name="email"
                required
                placeholder="your.email@address.com"
                class="w-full bg-white text-slate-900 rounded-[8px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#B8EC4C]"
              />
              <p class="text-[11px] text-slate-400">
                Our team will send your collection proposal and updates to this email address.
              </p>
            </div>

            <!-- Phone -->
            <div class="space-y-1">
              <label for="loc_phone" class="block text-xs font-semibold text-slate-300">
                Phone <span class="text-emerald-400">*</span>
              </label>
              <input
                type="tel"
                id="loc_phone"
                name="phone"
                required
                placeholder="07xxx xxxxxx / 020 xxx xxxx"
                class="w-full bg-white text-slate-900 rounded-[8px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#B8EC4C]"
              />
            </div>

            <!-- Collection Postcode -->
            <div class="space-y-1">
              <label for="loc_postcode" class="block text-xs font-semibold text-slate-300">
                Collection postcode <span class="text-emerald-400">*</span>
              </label>
              <input
                type="text"
                id="loc_postcode"
                name="postcode"
                required
                placeholder="e.g. SW1A 1AA / EC2R 8AH"
                class="w-full bg-white text-slate-900 rounded-[8px] px-3.5 py-2.5 text-sm uppercase font-mono focus:outline-none focus:ring-2 focus:ring-[#B8EC4C]"
              />
              <p class="text-[11px] text-slate-400">
                Tell us where your equipment is located and whether you would prefer to arrange delivery.
              </p>
            </div>

            <!-- What you'd like to collect -->
            <div class="space-y-1">
              <label for="loc_details" class="block text-xs font-semibold text-slate-300">
                What you'd like to collect <span class="text-emerald-400">*</span>
              </label>
              <textarea
                id="loc_details"
                name="details"
                required
                rows="3"
                placeholder="e.g. 25 Dell laptops, 12 desktops, 2 servers and redundant cables."
                class="w-full bg-white text-slate-900 rounded-[8px] px-3.5 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-[#B8EC4C] resize-y"
              ></textarea>
              <p class="text-[11px] text-slate-400">
                Provide the quantities and types of IT equipment you need us to collect.
              </p>
            </div>

            <!-- Checkboxes -->
            <div class="space-y-2 pt-2">
              <label class="flex items-start gap-2.5 cursor-pointer">
                <input type="checkbox" name="marketingConsent" class="mt-0.5 rounded text-[#B8EC4C] focus:ring-0" />
                <span class="text-[11.5px] text-slate-300 leading-snug">
                  <strong class="text-white">Stay informed</strong><br />
                  Yes, I'd like to receive occasional emails with practical IT management, green computing and data security tips, along with relevant sustainability updates.
                </span>
              </label>

              <label class="flex items-start gap-2.5 cursor-pointer">
                <input type="checkbox" name="termsConsent" required class="mt-0.5 rounded text-[#B8EC4C] focus:ring-0" />
                <span class="text-[11.5px] text-slate-300 leading-snug">
                  <strong class="text-white">Your consent *</strong><br />
                  I have read and agree to the TechSteps <a href="/terms-and-conditions" class="underline text-[#B8EC4C] hover:text-white">Terms and Conditions</a> and understand that my information will be processed in accordance with the <a href="/privacy-policy" class="underline text-[#B8EC4C] hover:text-white">Privacy Notice</a>.
                </span>
              </label>
            </div>

            <!-- Submit Button -->
            <div class="pt-3">
              <button
                type="submit"
                class="w-full py-4 rounded-[10px] bg-[#B8EC4C] hover:bg-[#a6d83e] text-[#0A261F] font-bold text-sm sm:text-base uppercase tracking-wider shadow-lg transition-all cursor-pointer font-sans"
              >
                REQUEST MY COLLECTION
              </button>
            </div>

          </form>
        </div>

        <!-- ===================================================
             RIGHT: LOCAL TRUST & STANDARDS CONTENT
             =================================================== -->
        <div class="lg:col-span-6 space-y-8 text-slate-800">
          
          <div>
            <h2 class="text-2xl sm:text-3xl font-bold text-[#062C20] font-display tracking-tight mb-4">
              Secure, documented &amp; easy to organise.
            </h2>
            
            <ul class="space-y-2.5 text-sm sm:text-base font-semibold text-slate-800 mb-6">
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-[#07572F] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>Business IT collections across {location.name} and surrounding areas</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-[#07572F] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>Responsible WEEE collection and recycling processes</span>
              </li>
              <li class="flex items-center gap-2.5">
                <svg class="w-5 h-5 text-[#07572F] shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                </svg>
                <span>Relevant data destruction and processing documentation</span>
              </li>
