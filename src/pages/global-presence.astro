---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import CTA from '../components/global/cta.astro';
import { getGlobalPresencePage } from '../lib/sanity/client';
import { defaultGlobalPresencePageData } from '../lib/sanity/data';

const pageDataRaw = await getGlobalPresencePage();
const pageData = pageDataRaw || defaultGlobalPresencePageData;
const canonicalUrl = 'https://techsteps.co.uk/global-presence';

const globalPresenceSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: pageData?.metaTitle || 'Global Presence | TechSteps UK',
  description:
    pageData?.metaDescription ||
    'Supporting organisations across key markets with secure, responsible and sustainable technology asset management.',
  mainEntity: {
    '@id': 'https://techsteps.co.uk/#organization',
  },
};
---

<BaseLayout
  title={pageData?.metaTitle || "Global Presence | TechSteps UK"}
  description={pageData?.metaDescription || "Supporting organisations across key markets with secure, responsible and sustainable technology asset management."}
  canonicalUrl={canonicalUrl}
  jsonLd={globalPresenceSchema}
  hasHeroHeader={true}
>
  <HeroHeader isHome={false} />

  <main class="global-presence-page bg-white text-slate-900 selection:bg-[#0F623A] selection:text-white">

    <!-- =====================================================
         1. HERO SECTION (Centered Title + Quote + Hub Pills + Compact Image)
    ====================================================== -->
    <section
      id="global-hero"
      class="relative w-full bg-white select-none pt-6 sm:pt-8 lg:pt-10 pb-6 sm:pb-8 lg:pb-10"
    >
      <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Top Centered Heading & Quote -->
        <div class="max-w-3xl mx-auto text-center space-y-3 sm:space-y-3.5">
          <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-bold text-slate-900 tracking-tight leading-[1.12]">
            Global <span class="text-[#0F623A]">Presence</span>
          </h1>
          <p class="text-base sm:text-lg text-slate-600 font-normal italic leading-relaxed max-w-2xl mx-auto">
            &ldquo;Supporting organisations across key international markets with certified ITAD, secure cross-border logistics, and sustainable technology asset management.&rdquo;
          </p>
        </div>

        <!-- Centered Image (Compact Size & Tighter Spacing) -->
        <div class="relative w-full max-w-4xl lg:max-w-5xl mx-auto mt-6 sm:mt-7 flex justify-center">
          <img
            src="/images/about/global-presence/hero1.png"
            alt={pageData?.hero?.imageAlt || "TechSteps international presence and secure technology asset management"}
            class="w-full h-auto max-h-[520px] object-contain block border-none shadow-none"
            width="1672"
            height="941"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </section>

    <!-- =====================================================
         2. STRATEGIC GEOGRAPHIC SHOWCASE (WORLD MAP)
    ====================================================== -->
    <section class="pt-8 sm:pt-12 lg:pt-14 pb-8 sm:pb-12 lg:pb-16 bg-white relative overflow-hidden">
      <!-- World Dots Subtle Pattern -->
      <div class="absolute inset-0 opacity-[0.04] pointer-events-none flex items-center justify-center select-none" aria-hidden="true">
        <img
          src="/images/brand/world-dots.svg"
          alt=""
          class="w-full max-w-6xl h-auto object-contain"
        />
      </div>

      <Container class="relative z-10">
        <div class="text-center max-w-2xl mx-auto mb-6 sm:mb-8 lg:mb-10">
          <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-2 sm:mb-2.5">
            Global Operations
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold font-display text-slate-900 tracking-tight leading-[1.14]">
            Strategic International <span class="text-[#0F623A]">Hubs</span>
          </h2>
        </div>

        <!-- Clean Interactive Vector Map Representation (Borderless, Unboxed) -->
        <div class="relative w-full max-w-5xl mx-auto aspect-[2/1] min-h-[260px] sm:min-h-[360px] lg:min-h-[420px] flex items-center justify-center select-none">
          <!-- Background Map Image -->
          <img
            src="/images/about/global-presence/map.png"
            alt="TechSteps Global Strategic Hubs Map"
            class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none border-none shadow-none"
            width="1774"
            height="887"
            loading="eager"
          />

          <!-- Hub 1: UNITED KINGDOM PIN (HQ) -->
          <div class="absolute top-[41%] left-[47.2%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer z-20">
            <a href="#location-uk" class="flex flex-col items-center focus:outline-none" aria-label="Jump to United Kingdom location">
              <span class="relative flex h-3.5 w-3.5 items-center justify-center">
                <span class="inline-flex rounded-full h-3.5 w-3.5 bg-[#0F623A] border-2 border-white shadow-md"></span>
              </span>
              <span class="mt-1.5 px-2.5 py-0.5 rounded-full bg-slate-900/90 backdrop-blur-sm border border-slate-700/60 text-[11px] sm:text-xs font-bold text-white shadow-md transition-transform group-hover:scale-105 whitespace-nowrap">
                United Kingdom (HQ)
              </span>
            </a>
          </div>

          <!-- Hub 2: UNITED STATES PIN (Active Services) -->
          <div class="absolute top-[39.5%] left-[19.5%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer z-20">
            <a href="#location-usa" class="flex flex-col items-center focus:outline-none" aria-label="Jump to United States location">
              <span class="relative flex h-3.5 w-3.5 items-center justify-center">
                <span class="inline-flex rounded-full h-3.5 w-3.5 bg-[#0F623A] border-2 border-white shadow-md"></span>
              </span>
              <span class="mt-1.5 px-2.5 py-0.5 rounded-full bg-slate-900/90 backdrop-blur-sm border border-slate-700/60 text-[11px] sm:text-xs font-bold text-white shadow-md transition-transform group-hover:scale-105 whitespace-nowrap">
                United States (Services)
              </span>
            </a>
          </div>

          <!-- Hub 3: INDIA PIN (Future Establishment) -->
          <div class="absolute top-[56.5%] left-[67.5%] -translate-x-1/2 -translate-y-1/2 group cursor-pointer z-20">
            <a href="#location-india" class="flex flex-col items-center focus:outline-none" aria-label="Jump to India location">
              <span class="relative flex h-3.5 w-3.5 items-center justify-center">
                <span class="inline-flex rounded-full h-3.5 w-3.5 bg-amber-500 border-2 border-white shadow-md"></span>
              </span>
              <span class="mt-1.5 px-2.5 py-0.5 rounded-full bg-amber-950/90 backdrop-blur-sm border border-amber-500/40 text-[11px] sm:text-xs font-bold text-amber-300 shadow-md transition-transform group-hover:scale-105 whitespace-nowrap">
                India (Future)
              </span>
            </a>
          </div>
        </div>
      </Container>
    </section>

    <!-- =====================================================
         3. GLOBAL LOCATIONS (UK HQ -> US SERVICES -> INDIA FUTURE)
    ====================================================== -->

    <!-- =====================================================
         LOCATION 1: UNITED KINGDOM (HQ & MAIN COMPANY)
    ====================================================== -->
    <section id="location-uk" class="py-14 sm:py-20 lg:py-24 bg-white scroll-mt-24">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- LEFT: Location Information -->
          <div class="lg:col-span-6 space-y-5">
            <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-2 sm:mb-3">
              01 · Main Company & Headquarters
            </p>

            <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold font-display text-slate-900 tracking-tight leading-[1.14]">
              United Kingdom
            </h2>

            <!-- Feel Good Regional Quote -->
            <blockquote class="italic text-base sm:text-lg text-slate-700 border-l-2 border-[#0F623A] pl-4 py-1 font-normal leading-relaxed">
              &ldquo;Rooted in British operational excellence — delivering uncompromised data security, verified chain-of-custody, and true zero-landfill circular recovery from our sovereign processing facilities.&rdquo;
            </blockquote>

            <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed">
              The sovereign operational core of TechSteps. Operating from audited high-security processing centres in Hainault and Stafford, we manage certified ITAD collections, ADISA-accredited data sanitisation, and accredited zero-landfill electronic recycling nationwide.
            </p>
          </div>

          <!-- RIGHT: Illustrated Country Graphic (Unboxed, Borderless) -->
          <div class="lg:col-span-6 flex items-center justify-center p-2 sm:p-6 select-none">
            <img
              src="/images/about/global-presence/uk.png"
              alt="TechSteps United Kingdom illustrated operational footprint and sovereign core"
              class="w-full max-w-[420px] h-auto max-h-[520px] object-contain block border-none shadow-none transition-transform duration-500 hover:scale-105"
              width="1024"
              height="1536"
              loading="lazy"
            />
          </div>

        </div>
      </Container>
    </section>

    <!-- =====================================================
         LOCATION 2: UNITED STATES (ACTIVE ENTERPRISE SERVICES)
    ====================================================== -->
    <section id="location-usa" class="py-14 sm:py-20 lg:py-24 bg-slate-50/50 scroll-mt-24">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- LEFT: Illustrated Country Graphic (Unboxed, Borderless) -->
          <div class="lg:col-span-6 order-2 lg:order-1 flex items-center justify-center p-2 sm:p-6 select-none">
            <img
              src="/images/about/global-presence/usa.png"
              alt="TechSteps United States enterprise operations and transatlantic services"
              class="w-full max-w-[480px] h-auto max-h-[460px] object-contain block border-none shadow-none transition-transform duration-500 hover:scale-105"
              width="1448"
              height="1086"
              loading="lazy"
            />
          </div>

          <!-- RIGHT: Location Information -->
          <div class="lg:col-span-6 order-1 lg:order-2 space-y-5">
            <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-2 sm:mb-3">
              02 · Enterprise Services
            </p>

            <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold font-display text-slate-900 tracking-tight leading-[1.14]">
              United States
            </h2>

            <!-- Feel Good Regional Quote -->
            <blockquote class="italic text-base sm:text-lg text-slate-700 border-l-2 border-[#0F623A] pl-4 py-1 font-normal leading-relaxed">
              &ldquo;Connecting continents with trusted governance — providing multinational enterprises with secure cross-border relocations, certified ITAD, and auditable ESG accounting.&rdquo;
            </blockquote>

            <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed">
              We provide multinational corporations with certified enterprise IT asset disposal, secure transatlantic relocations, and verified chain-of-custody, aligned seamlessly with UK sovereign compliance standards.
            </p>
          </div>

        </div>
      </Container>
    </section>

    <!-- =====================================================
         LOCATION 3: INDIA (FUTURE ESTABLISHMENT)
    ====================================================== -->
    <section id="location-india" class="py-14 sm:py-20 lg:py-24 bg-white scroll-mt-24">
      <Container>
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <!-- LEFT: Location Information -->
          <div class="lg:col-span-6 space-y-5">
            <h3 class="text-xl sm:text-2xl lg:text-[34px] font-bold font-display text-slate-900 tracking-tight leading-[1.14]">
              India
            </h3>

            <!-- Feel Good Regional Quote -->
            <blockquote class="italic text-base sm:text-lg text-slate-700 border-l-2 border-amber-500 pl-4 py-1 font-normal leading-relaxed">
              &ldquo;Expanding our global horizon with agility and purpose — establishing 24/7 asset tracking workflows, administrative compliance registers, and regional Asia-Pacific support.&rdquo;
            </blockquote>

            <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed">
              Expanding our international roadmap, TechSteps is actively preparing our regional establishment in India. This upcoming facility will deliver 24/7 global asset tracking, client support, and multi-timezone logistics coordination for global enterprises.
            </p>
          </div>

          <!-- RIGHT: Illustrated Country Graphic (Unboxed, Borderless) -->
          <div class="lg:col-span-6 flex items-center justify-center p-2 sm:p-6 select-none">
            <img
              src="/images/about/global-presence/india.png"
              alt="TechSteps India future operations and regional technology support"
              class="w-full max-w-[420px] h-auto max-h-[520px] object-contain block border-none shadow-none transition-transform duration-500 hover:scale-105"
              width="1122"
              height="1402"
              loading="lazy"
            />
          </div>

        </div>
      </Container>
    </section>

    <!-- =====================================================
         4. COMPLIANCE STANDARDS (REUSING SANITY DATA)
    ====================================================== -->
    {pageData?.standards?.items && pageData.standards.items.length > 0 && (
      <section class="py-14 sm:py-20 lg:py-24 bg-white">
        <Container>
          <div class="max-w-3xl mb-12">
            <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-2 sm:mb-3">
              {pageData?.standards?.label || "COMPLIANCE & GOVERNANCE"}
            </p>
            <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold font-display text-slate-900 tracking-tight leading-[1.14]">
              {pageData?.standards?.title || "Certified standards for"}{" "}
              <span class="text-[#0F623A]">{pageData?.standards?.highlightedTitle || "total peace of mind."}</span>
            </h2>
            <p class="mt-3 text-base sm:text-lg text-slate-600 font-normal leading-relaxed">
              {pageData?.standards?.description || "Every facility, vehicle, and partner adheres to the most stringent international compliance benchmarks."}
            </p>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
            {pageData.standards.items.map((std) => (
              <div class="p-6 rounded-2xl border border-slate-100 bg-slate-50/70 hover:border-[#0F623A]/30 hover:bg-white hover:shadow-sm transition-all duration-300">
                <span class="text-xs font-bold text-[#0F623A] px-2.5 py-1 rounded-lg bg-[#0F623A]/10 inline-block mb-3">
                  {std.code}
                </span>
                <h3 class="text-base sm:text-lg font-bold font-display text-slate-900 mb-2">
                  {std.name}
                </h3>
                <p class="text-sm sm:text-base text-slate-600 leading-relaxed font-normal">
                  {std.description}
                </p>
              </div>
            ))}
          </div>
        </Container>
      </section>
    )}

    <!-- =====================================================
         5. CIRCULAR ECONOMY BANNER (REDUCE · REUSE · RECYCLE)
    ====================================================== -->
    <section class="pt-2 sm:pt-4 pb-8 sm:pb-12 bg-white select-none">
      <Container>
        <div class="relative w-full max-w-2xl sm:max-w-3xl mx-auto flex justify-center">
          <img
            src="/images/about/global-presence/banner.png"
            alt="Reduce, Reuse, Recycle — TechSteps Global Sustainable Lifecycle Management"
            class="w-full h-auto max-h-[320px] object-contain block border-none shadow-none"
            width="1774"
            height="887"
            loading="lazy"
          />
        </div>
      </Container>
    </section>

    <!-- =====================================================
         6. CALL TO ACTION (EXISTING SHARED CTA)
    ====================================================== -->
    <CTA
      title={pageData?.cta?.title || "Connect With Our Global Logistics Specialists"}
      subtitle={pageData?.cta?.description || "Whether you require secure UK ITAD collection or cross-border asset transfers across Europe and beyond, our team is ready to assist."}
      primaryBtnText={pageData?.cta?.primaryText || "Speak to a Specialist"}
      primaryBtnUrl={pageData?.cta?.primaryHref || "/contact"}
      secondaryBtnText={pageData?.cta?.secondaryText || "Request a Collection"}
      secondaryBtnUrl={pageData?.cta?.secondaryHref || "/request-a-collection"}
    />

  </main>
</BaseLayout>
