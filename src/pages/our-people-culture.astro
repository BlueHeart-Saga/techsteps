---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import CTA from '../components/global/cta.astro';
import { getPeopleCulturePage } from '../lib/sanity/client';
import { defaultPeopleCulturePageData } from '../lib/sanity/data';

const pageData = (await getPeopleCulturePage()) || defaultPeopleCulturePageData;

const canonicalUrl = 'https://techsteps.co.uk/our-people-culture';

const peopleCultureSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: pageData?.metaTitle || 'Our People & Culture — TechSteps UK',
  description:
    pageData?.metaDescription ||
    'Discover the culture, people, and values powering TechSteps UK. Security-vetted professionals dedicated to responsible technology lifecycle management.',
  mainEntity: {
    '@id': 'https://techsteps.co.uk/#organization',
  },
};
---

<BaseLayout
  title={pageData?.metaTitle || "Our People & Culture — TechSteps UK"}
  description={pageData?.metaDescription || "Discover the culture, people, and values powering TechSteps UK. Security-vetted professionals dedicated to responsible technology lifecycle management."}
  canonicalUrl={canonicalUrl}
  jsonLd={peopleCultureSchema}
  hasHeroHeader={true}
>
  <HeroHeader isHome={false} />

  <main class="people-culture-page bg-white text-slate-900 selection:bg-[#0F623A] selection:text-white">

    <!-- =====================================================
         1. HERO SECTION
    ====================================================== -->
    <section class="relative min-h-[520px] lg:min-h-[580px] bg-[#0c1f17] text-white flex items-center overflow-hidden">
      <!-- Background Image with Overlay -->
      <div class="absolute inset-0 z-0">
        <img
          src={pageData?.hero?.imageUrl || "/images/about/who-we-are-technician.png"}
          alt={pageData?.hero?.imageAlt || "TechSteps technician handling technology equipment"}
          class="w-full h-full object-cover object-center opacity-25 mix-blend-luminosity scale-105"
          loading="eager"
        />
        <div class="absolute inset-0 bg-gradient-to-r from-[#0c1f17] via-[#0c1f17]/90 to-transparent"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#0c1f17] via-transparent to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 lg:py-24 w-full">
        <div class="max-w-3xl">
          <!-- Breadcrumb Navigation -->
          <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-semibold text-slate-300 mb-6">
            <a href="/" class="text-slate-300 hover:text-[#3FB33D] transition-colors underline-offset-4 hover:underline">
              Home
            </a>
            <span class="text-[#3FB33D] font-bold" aria-hidden="true">›</span>
            <a href="/about-us" class="text-slate-300 hover:text-[#3FB33D] transition-colors underline-offset-4 hover:underline">
              About Us
            </a>
            <span class="text-[#3FB33D] font-bold" aria-hidden="true">›</span>
            <span class="text-white font-bold">Our People &amp; Culture</span>
          </nav>

          <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#3FB33D]/20 text-[#3FB33D] text-xs font-bold tracking-widest uppercase mb-4 border border-[#3FB33D]/30 backdrop-blur-sm">
            {pageData?.hero?.eyebrow || "OUR PEOPLE & CULTURE"}
          </span>

          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold font-display tracking-tight text-white mb-6 leading-tight">
            {pageData?.hero?.title || "Powered by people."}
            <span class="text-[#3FB33D] block">{pageData?.hero?.highlightedTitle || "Defined by purpose."}</span>
          </h1>

          <p class="text-lg sm:text-xl text-slate-300 font-sans leading-relaxed">
            {pageData?.hero?.subtitle || "Behind every securely retired device and every sustainable outcome is a dedicated team of security-vetted specialists, engineers and logistics professionals."}
          </p>
        </div>
      </div>
    </section>

    <!-- =====================================================
         2. OUR PEOPLE SECTION
    ====================================================== -->
    <section class="py-20 lg:py-28 bg-white border-b border-slate-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <div class="lg:col-span-6 space-y-6">
            <span class="text-xs font-bold font-sans tracking-widest text-[#0F623A] uppercase block">
              {pageData?.people?.label || "THE TEAM BEHIND THE STANDARDS"}
            </span>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-slate-900 tracking-tight leading-tight">
              {pageData?.people?.title || "Expertise that safeguards"}
              <span class="text-[#0F623A] block">{pageData?.people?.highlightedTitle || "every step."}</span>
            </h2>

            <div class="space-y-4 text-slate-700 font-sans text-base sm:text-lg leading-relaxed">
              <p>
                {pageData?.people?.paragraphs?.[0] || "At TechSteps, our greatest strength is our workforce. From vetted logistics personnel navigating high-security corporate sites to specialist technicians wiping data to ADISA specifications, our team approaches every task with discipline, care, and precision."}
              </p>
              <p>
                {pageData?.people?.paragraphs?.[1] || "We believe that true data security and circular economy outcomes begin with human responsibility. That is why every member of the TechSteps family is invested in our mission: managing what matters for businesses, communities, and the environment."}
              </p>
            </div>

            <!-- Stats Grid -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 pt-6 border-t border-slate-100">
              {(pageData?.people?.stats || defaultPeopleCulturePageData.people!.stats!).map((st) => (
                <div>
                  <div class="text-3xl font-extrabold font-display text-[#0F623A]">
                    {st.number}
                  </div>
                  <div class="text-sm font-bold text-slate-900 mt-1">
                    {st.label}
                  </div>
                  {st.subtext && (
                    <div class="text-xs text-slate-500 font-sans mt-0.5 leading-snug">
                      {st.subtext}
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>

          <div class="lg:col-span-6">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200/80 group">
              <img
                src={pageData?.people?.imageUrl || "/images/brand/milestone-team.jpg"}
                alt={pageData?.people?.imageAlt || "TechSteps operational team"}
                class="w-full h-[420px] sm:h-[480px] object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/60 via-transparent to-transparent"></div>
              <div class="absolute bottom-6 left-6 right-6 p-5 rounded-2xl bg-white/95 backdrop-blur-md border border-white/20 shadow-lg">
                <span class="text-xs font-bold text-[#0F623A] uppercase tracking-wider block mb-1">
                  SECURITY &amp; COMPLIANCE
                </span>
                <p class="text-xs sm:text-sm font-semibold text-slate-800 font-sans">
                  All personnel security-cleared to BS7858 standards with full biometric audit tracking.
                </p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- =====================================================
         3. OUR CULTURE (4 PILLARS)
    ====================================================== -->
    <section class="py-20 lg:py-28 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs font-bold font-sans tracking-widest text-[#0F623A] uppercase block mb-3">
            {pageData?.culture?.label || "OUR VALUES IN PRACTICE"}
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-slate-900 tracking-tight leading-tight mb-5">
            {pageData?.culture?.title || "A culture built on trust,"}
            <span class="text-[#0F623A]">{pageData?.culture?.highlightedTitle || "precision and care."}</span>
          </h2>
          <p class="text-base sm:text-lg text-slate-600 font-sans leading-relaxed">
            {pageData?.culture?.subtitle || "Our daily decisions and workplace environment are guided by four core cultural commitments."}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {(pageData?.culture?.pillars || defaultPeopleCulturePageData.culture!.pillars).map((pillar) => (
            <div class="bg-white rounded-2xl p-8 border border-slate-200/80 shadow-sm hover:shadow-xl hover:border-[#3FB33D]/50 transition-all duration-300 flex flex-col justify-between group">
              <div>
                <div class="flex items-center justify-between mb-6">
                  <span class="text-2xl font-bold font-display text-slate-300 group-hover:text-[#3FB33D] transition-colors">
                    {pillar.number}
                  </span>
                  <span class="text-2xl" aria-hidden="true">
                    {pillar.icon}
                  </span>
                </div>

                <h3 class="text-xl font-bold font-display text-slate-900 mb-3 group-hover:text-[#0F623A] transition-colors">
                  {pillar.title}
                </h3>

                <p class="text-sm text-slate-600 font-sans leading-relaxed">
                  {pillar.description}
                </p>
              </div>

              <div class="pt-6 mt-6 border-t border-slate-100 flex items-center gap-1.5 text-xs font-semibold text-[#0F623A]">
                <span>Guiding standard</span>
                <span aria-hidden="true">&rarr;</span>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- =====================================================
         4. HOW WE WORK (COLLABORATIVE CYCLE)
    ====================================================== -->
    <section class="py-20 lg:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="max-w-3xl mb-16">
          <span class="text-xs font-bold font-sans tracking-widest text-[#0F623A] uppercase block mb-3">
            {pageData?.howWeWork?.label || "OUR COLLABORATIVE APPROACH"}
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-slate-900 tracking-tight leading-tight mb-4">
            {pageData?.howWeWork?.title || "How our teams deliver"}
            <span class="text-[#0F623A] block">{pageData?.howWeWork?.highlightedTitle || "consistent excellence."}</span>
          </h2>
          <p class="text-base sm:text-lg text-slate-600 font-sans leading-relaxed">
            {pageData?.howWeWork?.description || "A disciplined, transparent workflow ensuring client satisfaction and unbroken compliance at every touchpoint."}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {(pageData?.howWeWork?.steps || defaultPeopleCulturePageData.howWeWork!.steps).map((st) => (
            <div class="p-7 rounded-2xl bg-slate-50 border border-slate-200/70 hover:bg-white hover:border-[#0F623A] hover:shadow-md transition-all duration-300">
              <div class="flex items-center justify-between mb-4">
                <span class="w-9 h-9 rounded-xl bg-[#0F623A] text-white font-bold font-display text-sm flex items-center justify-center">
                  {st.stepNumber}
                </span>
                {st.badge && (
                  <span class="text-[11px] font-bold uppercase tracking-wider text-[#0F623A] bg-[#0F623A]/10 px-2.5 py-0.5 rounded-full">
                    {st.badge}
                  </span>
                )}
              </div>

              <h3 class="text-lg font-bold font-display text-slate-900 mb-2">
                {st.title}
              </h3>

              <p class="text-xs sm:text-sm text-slate-600 font-sans leading-relaxed">
                {st.description}
              </p>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- =====================================================
         5. LEARNING & DEVELOPMENT
    ====================================================== -->
    <section class="py-20 lg:py-24 bg-slate-900 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <div class="max-w-3xl mb-14">
          <span class="text-xs font-bold font-sans tracking-widest text-[#3FB33D] uppercase block mb-3">
            {pageData?.learningDevelopment?.label || "CONTINUOUS IMPROVEMENT"}
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-white tracking-tight leading-tight mb-4">
            {pageData?.learningDevelopment?.title || "Investing in our people,"}
            <span class="text-[#3FB33D] block">{pageData?.learningDevelopment?.highlightedTitle || "mastering standards."}</span>
          </h2>
          <p class="text-base sm:text-lg text-slate-300 font-sans leading-relaxed">
            {pageData?.learningDevelopment?.description || "We foster a culture of professional growth, equipping our staff with industry-recognized certifications and ongoing compliance training."}
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {(pageData?.learningDevelopment?.items || defaultPeopleCulturePageData.learningDevelopment!.items).map((prog) => (
            <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:border-[#3FB33D]/50 backdrop-blur-sm transition-all duration-300 flex flex-col justify-between">
              <div>
                {prog.badge && (
                  <span class="text-xs font-mono font-bold text-[#3FB33D] block mb-3 uppercase tracking-wider">
                    {prog.badge}
                  </span>
                )}
                <h3 class="text-lg font-bold font-display text-white mb-2">
                  {prog.title}
                </h3>
                <p class="text-xs sm:text-sm text-slate-300 font-sans leading-relaxed">
                  {prog.description}
                </p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- =====================================================
         6. PEOPLE, PLANET & PROGRESS
    ====================================================== -->
    <section class="py-20 lg:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
          
          <div class="lg:col-span-6 order-2 lg:order-1">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl border border-slate-200/80">
              <img
                src={pageData?.peoplePlanetProgress?.imageUrl || "/images/about/People. Planet. Progress. (1).webp"}
                alt={pageData?.peoplePlanetProgress?.imageAlt || "People, Planet, Progress impact visualization"}
                class="w-full h-auto object-cover"
              />
            </div>
          </div>

          <div class="lg:col-span-6 space-y-6 order-1 lg:order-2">
            <span class="text-xs font-bold font-sans tracking-widest text-[#0F623A] uppercase block">
              {pageData?.peoplePlanetProgress?.label || "SUSTAINABILITY & PURPOSE"}
            </span>

            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-slate-900 tracking-tight leading-tight">
              {pageData?.peoplePlanetProgress?.title || "People. Planet."}
              <span class="text-[#0F623A] block">{pageData?.peoplePlanetProgress?.highlightedTitle || "Progress."}</span>
            </h2>

            <div class="space-y-4 text-slate-700 font-sans text-base sm:text-lg leading-relaxed">
              <p>
                {pageData?.peoplePlanetProgress?.paragraphs?.[0] || "Our team is personally connected to the positive environmental impact we generate every day. When we extend the useful life of enterprise hardware or prevent hazardous e-waste from entering disposal streams, our people see the tangible results of their efforts."}
              </p>
              <p>
                {pageData?.peoplePlanetProgress?.paragraphs?.[1] || "We empower our staff to identify sustainable process enhancements, participate in community e-waste initiatives, and hold ourselves accountable to the highest ecological standards in the UK."}
              </p>
            </div>

            <!-- Metrics -->
            <div class="grid grid-cols-3 gap-6 pt-6 border-t border-slate-100">
              {(pageData?.peoplePlanetProgress?.metrics || defaultPeopleCulturePageData.peoplePlanetProgress!.metrics!).map((m) => (
                <div>
                  <div class="text-2xl sm:text-3xl font-extrabold font-display text-[#0F623A]">
                    {m.number}
                  </div>
                  <div class="text-xs sm:text-sm font-semibold text-slate-700 mt-1">
                    {m.label}
                  </div>
                </div>
              ))}
            </div>

          </div>

        </div>
      </div>
    </section>

    <!-- =====================================================
         7. CALL TO ACTION
    ====================================================== -->
    <CTA
      title={pageData?.cta?.title || "Join Us in Shaping a Responsible Technology Lifecycle"}
      subtitle={pageData?.cta?.description || "Talk to our team about secure, sustainable IT asset management or explore career opportunities with TechSteps."}
      primaryBtnText={pageData?.cta?.primaryText || "Contact Our Team"}
      primaryBtnUrl={pageData?.cta?.primaryHref || "/contact"}
      secondaryBtnText={pageData?.cta?.secondaryText || "Explore Sustainability"}
      secondaryBtnUrl={pageData?.cta?.secondaryHref || "/sustainability"}
    />

  </main>
</BaseLayout>
