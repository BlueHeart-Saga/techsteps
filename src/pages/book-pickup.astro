<style>
  /* =========================================================
     TAB BUTTON STYLES
  ========================================================= */
  .collection-tab-btn {
    background-color: transparent;
    color: #475569;
    border: 1px solid transparent;
  }

  .collection-tab-btn .tab-badge {
    background-color: rgba(148, 163, 184, 0.2);
    color: #475569;
  }

  .collection-tab-btn.active {
    background-color: #FFFFFF;
    color: #101E2C;
    border-color: rgba(203, 213, 225, 0.9);
    box-shadow: 0 4px 12px -2px rgba(15, 23, 42, 0.08);
  }

  .collection-tab-btn.active .tab-badge {
    background-color: #E2EFE8;
    color: #146B5C;
  }

  .collection-tab-btn:hover:not(.active) {
    background-color: rgba(255, 255, 255, 0.6);
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fadeIn {
    animation: fadeIn 250ms cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>

<script>
  function setupBookingTabs() {
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.collection-tab-btn');
    const tabPanels = document.querySelectorAll<HTMLElement>('.tab-panel');
    const confirmationModal = document.getElementById('booking-confirmation-modal');
    const confRefSpan = document.getElementById('conf-ref');
    const btnBookAnother = document.getElementById('btn-book-another');

    if (tabButtons.length === 0) return;

    // Switch Tab Function
    const switchTab = (targetId: string) => {
      // Hide confirmation screen if shown
      if (confirmationModal) {
        confirmationModal.classList.add('hidden');
      }

      tabButtons.forEach((btn) => {
        const isTarget = btn.dataset.tabTarget === targetId;
        btn.classList.toggle('active', isTarget);
        btn.setAttribute('aria-selected', isTarget ? 'true' : 'false');
      });

      tabPanels.forEach((panel) => {
        const panelId = panel.id.replace('panel-', '');
        if (panelId === targetId) {
          panel.classList.remove('hidden');
        } else {
          panel.classList.add('hidden');
        }
      });
    };

    // Attach click listeners to tab buttons
    tabButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const target = btn.dataset.tabTarget;
        if (target) {
          switchTab(target);
          // Update URL without refresh
          const url = new URL(window.location.href);
          url.searchParams.set('tab', target);
          window.history.replaceState({}, '', url.toString());
        }
      });
    });

    // Handle URL query parameters (?tab=free|onsite|box and ?type=laptops|servers...)
    const urlParams = new URLSearchParams(window.location.search);
    const initialTab = urlParams.get('tab');
    const prefillType = urlParams.get('type');

    if (initialTab && ['free', 'onsite', 'box'].includes(initialTab)) {
      switchTab(initialTab);
    }

    if (prefillType) {
      if (prefillType === 'laptops') {
        const input = document.getElementById('free_laptops') as HTMLInputElement;
        if (input) input.value = '15';
      } else if (prefillType === 'computers') {
        const input = document.getElementById('free_pcs') as HTMLInputElement;
        if (input) input.value = '10';
      } else if (prefillType === 'servers') {
        const input = document.getElementById('free_servers') as HTMLInputElement;
        if (input) input.value = '4';
      }
    }

    // Dynamic Free Qualification Calculator inside Panel 1
    const qtyInputs = document.querySelectorAll<HTMLInputElement>('.qty-counter');
    const freeTotalSpan = document.getElementById('free-total-count');
    const freeQualifyPill = document.getElementById('free-qualify-pill');

    const updateFreeCount = () => {
      let total = 0;
      qtyInputs.forEach((inp) => {
        total += parseInt(inp.value || '0', 10);
      });

      if (freeTotalSpan) {
        freeTotalSpan.textContent = String(total);
      }

      if (freeQualifyPill) {
        if (total >= 10) {
          freeQualifyPill.textContent = '✓ Free Collection Guaranteed';
          freeQualifyPill.className = 'font-mono font-bold px-2.5 py-0.5 rounded-full bg-emerald-100 text-[#07572F]';
        } else if (total > 0) {
          freeQualifyPill.textContent = 'Tracked Box Eligible (<10 units)';
          freeQualifyPill.className = 'font-mono font-bold px-2.5 py-0.5 rounded-full bg-amber-100 text-amber-800';
        } else {
          freeQualifyPill.textContent = 'Awaiting device count';
          freeQualifyPill.className = 'font-mono font-bold px-2.5 py-0.5 rounded-full bg-slate-200 text-slate-600';
        }
      }
    };

    qtyInputs.forEach((inp) => {
      inp.addEventListener('input', updateFreeCount);
    });
    updateFreeCount();

    // Form Submissions Handling
    const forms = document.querySelectorAll<HTMLFormElement>('#form-free, #form-onsite, #form-box');

    forms.forEach((form) => {
      form.addEventListener('submit', (e) => {
        e.preventDefault();

        // Generate friendly unique reference
        const randomDigits = Math.floor(1000 + Math.random() * 9000);
        const prefix = form.id === 'form-free' ? 'TS-FREE' : form.id === 'form-onsite' ? 'TS-SITE' : 'TS-BOX';
        const referenceCode = `${prefix}-${randomDigits}`;

        // Hide all tab panels
        tabPanels.forEach((panel) => panel.classList.add('hidden'));

        // Display confirmation modal
        if (confirmationModal && confRefSpan) {
          confRefSpan.textContent = referenceCode;
          confirmationModal.classList.remove('hidden');
          confirmationModal.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      });
    });

    if (btnBookAnother) {
      btnBookAnother.addEventListener('click', () => {
        switchTab('free');
      });
    }
  }

  setupBookingTabs();
  document.addEventListener('astro:page-load', setupBookingTabs);
</script>
