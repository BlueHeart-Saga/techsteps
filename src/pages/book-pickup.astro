---
/**
 * book-pickup.astro
 * Redesigned Premium Tab-Based Collection Booking Experience
 * Route: /book-pickup
 * 
 * Features:
 * - 3 interactive collection modes via modern tab navigation:
 *   1. Free Collection (10+ devices, standard nationwide UK pickup)
 *   2. On-Site Collection & Destruction (Witnessed on-premise wiping, shredding & de-racking)
 *   3. Box Collection (Tracked courier boxes for remote workers & small batches)
 * - Custom tailored form fields per collection mode
 * - Dynamic URL parameter support (?tab=free|onsite|box and ?type=...)
 * - Instant reference generation and submission state
 * - Security & compliance trust badges
 * - Unified FAQSection integration
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import FAQSection from '../components/FAQSection.astro';
import CTA from '../components/global/cta.astro';
import { getSiteSettings } from '../lib/sanity/client';
import { getPageFaqs } from '../data/pageFaqs';

const siteSettings = await getSiteSettings();
const faqConfig = getPageFaqs('collection-overview');
const faqs = faqConfig?.faqs || [];

const pageTitle = "Book an IT Equipment Pickup | Free, On-Site & Box Services | TechSteps";
const pageDescription = "Book an IT equipment collection. Choose from Free Nationwide Collection for 10+ devices, Witnessed On-Site Destruction, or Tracked Courier Boxes for remote teams.";
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  hasHeroHeader={false}
>
  <!-- =====================================================
       1. HERO HEADER SECTION
       ===================================================== -->
  <section class="relative pt-12 pb-16 sm:pt-16 sm:pb-20 lg:pt-20 lg:pb-24 bg-[#0A1A16] text-white overflow-hidden">
    <!-- Ambient Backdrop Effects -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_80%_60%_at_50%_-20%,rgba(20,107,92,0.4),rgba(10,26,22,0))] pointer-events-none"></div>
    <div class="absolute inset-0 bg-[linear-gradient(to_right,rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(to_bottom,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:4rem_4rem] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_100%)] pointer-events-none"></div>

    <Container>
      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <!-- Breadcrumb -->
        <nav class="flex items-center justify-center gap-2 text-xs sm:text-sm text-emerald-300/80 mb-5 font-mono" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors">Home</a>
          <span>/</span>
          <a href="/collection/all-equipement" class="hover:text-white transition-colors">IT Equipment Collection</a>
          <span>/</span>
          <span class="text-white font-medium">Book a Pickup</span>
        </nav>

       

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-semibold tracking-tight text-white font-display leading-[1.12] mb-5">
          Book Your IT Equipment Pickup
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto leading-relaxed font-sans mb-8">
          Fast, certified collection for UK businesses and public sector organisations. Choose your preferred service mode below to receive an instant reference number and collection window.
        </p>

        <!-- Trust Credentials Strip -->
        <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs sm:text-[13px] text-emerald-200/90 font-mono">
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-400 font-bold">✓</span> 100% WEEE Compliant
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-400 font-bold">✓</span> ADISA Certified Erasure
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-400 font-bold">✓</span> GPS Tracked Fleet
          </span>
          <span class="flex items-center gap-1.5">
            <span class="text-emerald-400 font-bold">✓</span> EA Waste Transfer Note
          </span>
        </div>
      </div>
    </Container>
  </section>

  <!-- =====================================================
       2. TAB-BASED BOOKING CONTAINER
       ===================================================== -->
  <section class="relative bg-[#F4F7F5] py-12 sm:py-16 lg:py-20 -mt-6 rounded-t-[32px] sm:rounded-t-[40px] z-20 shadow-2xl">
    <Container>
      <div class="max-w-4xl mx-auto">

        <!-- ===================================================
             TAB NAVIGATION CONTROLLER (3 SERVICE MODES)
             =================================================== -->
        <div class="mb-8" role="tablist" aria-label="Collection Service Options">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-3 p-2 bg-slate-200/80 rounded-[20px] border border-slate-300/80 shadow-inner">
            
            <!-- Tab 1: Free Collection -->
            <button
              type="button"
              id="tab-btn-free"
              role="tab"
              aria-selected="true"
              aria-controls="panel-free"
              data-tab-target="free"
              class="collection-tab-btn active text-left p-4 rounded-[16px] transition-all duration-200 focus:outline-none cursor-pointer flex flex-col justify-between"
            >
              <div class="flex items-center justify-between mb-1.5">
                <svg class="w-5 h-5 text-[#07572F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 18.75a1.5 1.5 0 01-3 0m3 0a1.5 1.5 0 00-3 0m3 0h6m-9 0H3.375A1.125 1.125 0 012.25 17.625V5.625A1.125 1.125 0 013.375 4.5h9.75a1.125 1.125 0 011.125 1.125v4.875m-11.25 8.25h11.25m0-8.25h4.125a1.125 1.125 0 011.125 1.125v4.5a1.125 1.125 0 01-.33.795l-2.07 2.07a1.125 1.125 0 01-.795.33H14.25m0-8.25v8.25m6 0a1.5 1.5 0 11-3 0m3 0a1.5 1.5 0 10-3 0" />
                </svg>
                <span class="tab-badge px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold uppercase tracking-wider">
                  Most Popular
                </span>
              </div>
              <div>
                <span class="tab-title block font-display text-base font-bold leading-tight">
                  Free IT Collection
                </span>
                <span class="tab-desc block text-xs mt-0.5">
                  Qualifying batches (10+ devices) • Nationwide UK
                </span>
              </div>
            </button>

            <!-- Tab 2: On-Site Collection -->
            <button
              type="button"
              id="tab-btn-onsite"
              role="tab"
              aria-selected="false"
              aria-controls="panel-onsite"
              data-tab-target="onsite"
              class="collection-tab-btn text-left p-4 rounded-[16px] transition-all duration-200 focus:outline-none cursor-pointer flex flex-col justify-between"
            >
              <div class="flex items-center justify-between mb-1.5">
                <svg class="w-5 h-5 text-amber-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                </svg>
                <span class="tab-badge px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold uppercase tracking-wider">
                  High Security
                </span>
              </div>
              <div>
                <span class="tab-title block font-display text-base font-bold leading-tight">
                  On-Site Collection
                </span>
                <span class="tab-desc block text-xs mt-0.5">
                  Witnessed shredding, wiping &amp; de-racking
                </span>
              </div>
            </button>

            <!-- Tab 3: Box Collection -->
            <button
              type="button"
              id="tab-btn-box"
              role="tab"
              aria-selected="false"
              aria-controls="panel-box"
              data-tab-target="box"
              class="collection-tab-btn text-left p-4 rounded-[16px] transition-all duration-200 focus:outline-none cursor-pointer flex flex-col justify-between"
            >
              <div class="flex items-center justify-between mb-1.5">
                <svg class="w-5 h-5 text-slate-700" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M21 7.5l-9-5.25L3 7.5m18 0l-9 5.25m9-5.25v9l-9 5.25M3 7.5l9 5.25M3 7.5v9l9 5.25m0-9v9" />
                </svg>
                <span class="tab-badge px-2.5 py-0.5 rounded-full text-[11px] font-mono font-bold uppercase tracking-wider">
                  Remote Teams
                </span>
              </div>
              <div>
                <span class="tab-title block font-display text-base font-bold leading-tight">
                  Tracked Box Service
                </span>
                <span class="tab-desc block text-xs mt-0.5">
                  Pre-paid courier boxes for home workers
                </span>
              </div>
            </button>

          </div>
        </div>

        <!-- ===================================================
             MAIN BOOKING CARD
             =================================================== -->
        <div class="bg-white rounded-[24px] sm:rounded-[28px] border border-slate-200/90 shadow-[0_12px_40px_rgba(0,0,0,0.04)] p-6 sm:p-10 lg:p-12 relative overflow-hidden">
          
          <!-- Submission Confirmation Screen (Hidden by Default) -->
          <div
            id="booking-confirmation-modal"
            class="hidden py-8 text-center space-y-6 animate-fadeIn"
          >
            <div class="w-16 h-16 rounded-full bg-emerald-100 text-[#146B5C] flex items-center justify-center mx-auto text-3xl font-bold shadow-sm">
              ✓
            </div>
            <div>
              <span class="inline-block px-3.5 py-1 rounded-full bg-emerald-50 text-[#146B5C] text-xs font-mono font-bold uppercase tracking-wider mb-2">
                Booking Request Successfully Transmitted
              </span>
              <h2 class="text-2xl sm:text-3xl font-semibold text-[#101E2C] font-display">
                Collection Reference: <span id="conf-ref" class="font-mono text-[#146B5C] underline font-extrabold"></span>
              </h2>
              <p class="text-sm sm:text-base text-slate-600 max-w-lg mx-auto mt-2 leading-relaxed">
                Thank you! We have logged your request. Our UK logistics desk will review your items and confirm your scheduled collection window within <span class="font-bold text-slate-900">two working days</span>.
              </p>
            </div>

            <!-- Next Steps Manifest Summary -->
            <div class="max-w-md mx-auto text-left p-5 rounded-2xl bg-[#F8FAF9] border border-slate-200 text-xs sm:text-[13px] space-y-2.5">
              <div class="font-bold text-slate-800 uppercase tracking-wider font-mono text-[11px] pb-1 border-b border-slate-200">
                What happens next?
              </div>
              <div class="flex items-start gap-2 text-slate-600">
                <span class="text-[#146B5C] font-bold">1.</span>
                <span>You will receive an automated email confirmation receipt.</span>
              </div>
              <div class="flex items-start gap-2 text-slate-600">
                <span class="text-[#146B5C] font-bold">2.</span>
                <span>Our operations coordinator will verify vehicle access &amp; time slots.</span>
              </div>
              <div class="flex items-start gap-2 text-slate-600">
                <span class="text-[#146B5C] font-bold">3.</span>
                <span>Security-vetted drivers will provide an Environment Agency Waste Transfer Note on arrival.</span>
              </div>
            </div>

            <div class="pt-2">
              <button
                type="button"
                id="btn-book-another"
                class="px-6 py-2.5 rounded-[12px] bg-slate-100 hover:bg-slate-200 text-slate-700 text-sm font-semibold transition-colors"
              >
                Submit another collection request
              </button>
            </div>
          </div>

          <!-- =================================================
               FORM PANEL 1: FREE COLLECTION
               ================================================= -->
          <div id="panel-free" role="tabpanel" aria-labelledby="tab-btn-free" class="tab-panel space-y-8">
            <!-- Helper Header Box -->
            <div class="p-5 rounded-[18px] bg-[#EAF2EE] border border-[#D1E2D9] flex items-start gap-3.5">
              <svg class="w-5 h-5 text-[#0F623A] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M11.25 11.25l.041-.02a.75.75 0 011.063.852l-.708 2.836a.75.75 0 001.063.853l.041-.021M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9-3.75h.008v.008H12V8.25z" />
              </svg>
              <div class="text-xs sm:text-[13.5px] text-[#101E2C] leading-relaxed">
                <span class="font-bold block text-sm text-[#0F623A] mb-0.5">
                  100% Free Nationwide IT Collection Eligibility
                </span>
                Free collection applies to UK commercial, educational, and healthcare organisations with <span class="font-bold underline">10 or more</span> desktop PCs, laptops, or enterprise servers. Smaller batches can be bundled or collected via our Tracked Box Service.
              </div>
            </div>

            <form id="form-free" class="space-y-7" data-service-type="Free Nationwide Collection">
              
              <!-- Section A: Hardware Quantities & Types -->
              <div>
                <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-100">
                  <h3 class="text-xs font-bold uppercase tracking-wider text-[#146B5C] font-mono">
                    1. Hardware Quantities &amp; Equipment Count
                  </h3>
                  <span class="text-xs text-slate-400 font-sans">Enter approximate counts</span>
                </div>

                <div class="grid grid-cols-2 sm:grid-cols-3 gap-3.5 sm:gap-4">
                  <!-- Laptops -->
                  <div class="p-3.5 rounded-[14px] bg-[#F8FAF9] border border-slate-200 hover:border-[#146B5C]/40 transition-colors">
                    <label for="free_laptops" class="block text-xs font-bold text-slate-800 mb-1">
                      Laptops / MacBooks
                    </label>
                    <input
                      type="number"
                      id="free_laptops"
                      name="laptops"
                      min="0"
                      value="0"
                      class="qty-counter w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-center font-bold text-slate-900 text-base focus:border-[#146B5C] focus:ring-1 focus:ring-[#146B5C] outline-none"
                    />
                  </div>

                  <!-- Desktops -->
                  <div class="p-3.5 rounded-[14px] bg-[#F8FAF9] border border-slate-200 hover:border-[#146B5C]/40 transition-colors">
                    <label for="free_pcs" class="block text-xs font-bold text-slate-800 mb-1">
                      Desktop PCs &amp; Towers
                    </label>
                    <input
                      type="number"
                      id="free_pcs"
                      name="desktops"
                      min="0"
                      value="0"
                      class="qty-counter w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-center font-bold text-slate-900 text-base focus:border-[#146B5C] focus:ring-1 focus:ring-[#146B5C] outline-none"
                    />
                  </div>

                  <!-- Servers -->
                  <div class="p-3.5 rounded-[14px] bg-[#F8FAF9] border border-slate-200 hover:border-[#146B5C]/40 transition-colors">
                    <label for="free_servers" class="block text-xs font-bold text-slate-800 mb-1">
                      Servers &amp; Storage Arrays
                    </label>
                    <input
                      type="number"
                      id="free_servers"
                      name="servers"
                      min="0"
                      value="0"
                      class="qty-counter w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-center font-bold text-slate-900 text-base focus:border-[#146B5C] focus:ring-1 focus:ring-[#146B5C] outline-none"
                    />
                  </div>

                  <!-- Monitors -->
                  <div class="p-3.5 rounded-[14px] bg-[#F8FAF9] border border-slate-200 hover:border-[#146B5C]/40 transition-colors">
                    <label for="free_monitors" class="block text-xs font-bold text-slate-800 mb-1">
                      Monitors &amp; Screens
                    </label>
                    <input
                      type="number"
                      id="free_monitors"
                      name="monitors"
                      min="0"
                      value="0"
                      class="qty-counter w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-center font-bold text-slate-900 text-base focus:border-[#146B5C] focus:ring-1 focus:ring-[#146B5C] outline-none"
                    />
                  </div>

                  <!-- Mobile Devices -->
                  <div class="p-3.5 rounded-[14px] bg-[#F8FAF9] border border-slate-200 hover:border-[#146B5C]/40 transition-colors">
                    <label for="free_mobiles" class="block text-xs font-bold text-slate-800 mb-1">
                      Mobile Phones &amp; Tablets
                    </label>
                    <input
                      type="number"
                      id="free_mobiles"
                      name="mobiles"
                      min="0"
                      value="0"
                      class="qty-counter w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-center font-bold text-slate-900 text-base focus:border-[#146B5C] focus:ring-1 focus:ring-[#146B5C] outline-none"
                    />
                  </div>

                  <!-- Printers -->
                  <div class="p-3.5 rounded-[14px] bg-[#F8FAF9] border border-slate-200 hover:border-[#146B5C]/40 transition-colors">
                    <label for="free_printers" class="block text-xs font-bold text-slate-800 mb-1">
                      Printers / MFPs
                    </label>
                    <input
                      type="number"
                      id="free_printers"
                      name="printers"
                      min="0"
                      value="0"
                      class="qty-counter w-full bg-white border border-slate-200 rounded-lg px-3 py-2 text-center font-bold text-slate-900 text-base focus:border-[#146B5C] focus:ring-1 focus:ring-[#146B5C] outline-none"
                    />
                  </div>
                </div>

                <!-- Total Count & Qualification Indicator -->
                <div class="mt-4 p-3 rounded-xl bg-slate-50 border border-slate-200 flex items-center justify-between text-xs sm:text-[13px]">
                  <span class="text-slate-600 font-medium">
                    Total Estimated Hardware: <span id="free-total-count" class="font-bold text-slate-900 font-mono text-sm">0</span> items
                  </span>
                  <span id="free-qualify-pill" class="font-mono font-bold px-2.5 py-0.5 rounded-full bg-slate-200 text-slate-600">
                    Awaiting device count
                  </span>
                </div>
              </div>

              <!-- Section B: Preferred Outcome & Logistics -->
              <div>
                <div class="mb-4 pb-2 border-b border-slate-100">
                  <h3 class="text-xs font-bold uppercase tracking-wider text-[#146B5C] font-mono">
                    2. Outcome &amp; Site Logistics
                  </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div class="space-y-1.5">
                    <label for="free_outcome" class="block text-xs font-semibold text-slate-800">
                      Primary Outcome Preference
                    </label>
                    <select
                      id="free_outcome"
                      name="outcome"
                      class="w-full bg-[#F8FAF9] border border-slate-200 rounded-[10px] px-3.5 py-2.5 text-sm text-slate-800 focus:bg-white focus:border-[#146B5C] outline-none font-sans"
                    >
                      <option value="Refurbishment & Remarketing with Rebate">Refurbishment &amp; Remarketing (Max Residual Value)</option>
                      <option value="Zero-Landfill WEEE Recycling">Zero-Landfill WEEE Certified Recycling</option>
                      <option value="High Security Destruction">High Security Physical Shredding</option>
                      <option value="Asset Audit & Assessment">Full Comprehensive Asset Audit</option>
                    </select>
                  </div>

                  <div class="space-y-1.5">
                    <label for="free_date" class="block text-xs font-semibold text-slate-800">
                      Preferred Collection Date
                    </label>
                    <input
                      type="date"
                      id="free_date"
                      name="preferredDate"
                      class="w-full bg-[#F8FAF9] border border-slate-200 rounded-[10px] px-3.5 py-2.5 text-sm text-slate-800 focus:bg-white focus:border-[#146B5C] outline-none font-sans"
                    />
                  </div>
                </div>

                <!-- Collection Address & Access -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-4">
                  <div class="sm:col-span-2 space-y-1.5">
                    <label for="free_address" class="block text-xs font-semibold text-slate-800">
                      Collection Address &amp; Town <span class="text-emerald-700 font-bold">*</span>
                    </label>
                    <input
                      type="text"
                      id="free_address"
                      name="address"
                      required
                      placeholder="e.g. 10 Finsbury Square, London"
                      class="w-full bg-[#F8FAF9] border border-slate-200 rounded-[10px] px-3.5 py-2.5 text-sm text-slate-800 focus:bg-white focus:border-[#146B5C] outline-none font-sans"
                    />
                  </div>
                  <div class="space-y-1.5">
                    <label for="free_postcode" class="block text-xs font-semibold text-slate-800">
                      Postcode <span class="text-emerald-700 font-bold">*</span>
                    </label>
                    <input
                      type="text"
                      id="free_postcode"
                      name="postcode"
                      required
                      placeholder="EC2A 1AF"
                      class="w-full bg-[#F8FAF9] border border-slate-200 rounded-[10px] px-3.5 py-2.5 text-sm text-slate-800 focus:bg-white focus:border-[#146B5C] outline-none font-sans uppercase font-mono"
                    />
                  </div>
                </div>
              </div>

              <!-- Section C: Contact Information -->
              <div>
                <div class="mb-4 pb-2 border-b border-slate-100">
                  <h3 class="text-xs font-bold uppercase tracking-wider text-[#146B5C] font-mono">
                    3. Contact &amp; Company Details
                  </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div class="space-y-1.5">
                    <label for="free_name" class="block text-xs font-semibold text-slate-800">
                      Contact Name <span class="text-emerald-700 font-bold">*</span>
                    </label>
                    <input
                      type="text"
                      id="free_name"
                      name="fullName"
                      required
                      placeholder="Sarah Jenkins"
                      class="w-full bg-[#F8FAF9] border border-slate-200 rounded-[10px] px-3.5 py-2.5 text-sm text-slate-800 focus:bg-white focus:border-[#146B5C] outline-none font-sans"
                    />
                  </div>

                  <div class="space-y-1.5">
                    <label for="free_company" class="block text-xs font-semibold text-slate-800">
                      Company / Organisation <span class="text-emerald-700 font-bold">*</span>
                    </label>
                    <input
                      type="text"
                      id="free_company"
                      name="company"
                      required
                      placeholder="Acme Financial UK Ltd"
                      class="w-full bg-[#F8FAF9] border border-slate-200 rounded-[10px] px-3.5 py-2.5 text-sm text-slate-800 focus:bg-white focus:border-[#146B5C] outline-none font-sans"
                    />
                  </div>

                  <div class="space-y-1.5">
                    <label for="free_email" class="block text-xs font-semibold text-slate-800">
                      Corporate Email <span class="text-emerald-700 font-bold">*</span>
                    </label>
                    <input
                      type="email"
                      id="free_email"
                      name="email"
                      required
                      placeholder="s.jenkins@acmefinance.co.uk"
                      class="w-full bg-[#F8FAF9] border border-slate-200 rounded-[10px] px-3.5 py-2.5 text-sm text-slate-800 focus:bg-white focus:border-[#146B5C] outline-none font-sans"
                    />
                  </div>

                  <div class="space-y-1.5">
                    <label for="free_phone" class="block text-xs font-semibold text-slate-800">
                      Direct Telephone <span class="text-emerald-700 font-bold">*</span>
                    </label>
                    <input
                      type="tel"
                      id="free_phone"
