---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import CommonCTA from '../components/global/CommonCTA.astro';
import { getSustainabilityPage } from '../lib/sanity/client';

const pageData = await getSustainabilityPage();

const breadcrumbs = [
  { name: 'Sustainability', url: '/sustainability' },
];

const approachSteps = (pageData.approach?.steps && pageData.approach.steps.length > 0)
  ? pageData.approach.steps
  : [
      { step: '1', title: 'Collect', badge: 'Chain-of-Custody', desc: 'Secure GPS-tracked transport, tamper-evident containers, and strict chain-of-custody handling directly from enterprise sites.' },
      { step: '2', title: 'Audit & Assess', badge: 'Triage & Verification', desc: 'Granular asset logging, serial number scanning, hardware functional diagnostics, and secondary lifecycle viability assessment.' },
      { step: '3', title: 'Sanitise', badge: 'Cryptographic Erasure', desc: 'Certified ADISA and NIST 800-88 compliant data wiping or physical degaussing to ensure zero data residual liability.' },
      { step: '4', title: 'Reuse', badge: 'Redeployment & Extension', desc: 'Extending useful hardware life through internal redeployment, component harvesting, and secondary hardware assignment.' },
      { step: '5', title: 'Remarket', badge: 'Value Recovery', desc: 'Refurbishing and remarketing high-value IT equipment into global secondary B2B channels to return maximum ROI.' },
      { step: '6', title: 'Recycle & Recover', badge: 'Zero-Landfill Guarantee', desc: 'Eco-certified material separation, WEEE-compliant shredding, and RDF energy recovery ensuring 100% zero-to-landfill diversion.' },
    ];

const displayStats = (pageData.metrics && pageData.metrics.length > 0)
  ? pageData.metrics.map(m => ({
      prefix: '',
      value: m.number,
      suffix: m.suffix || '',
      label: m.label,
      contextNote: m.note,
    }))
  : [
      { prefix: '', value: '100', suffix: '%', label: 'Landfill Diversion Rate', contextNote: 'Verified zero-to-landfill e-waste processing across all domestic UK treatment partners' },
      { prefix: '', value: '99.99', suffix: '%', label: 'Chain-of-Custody Accuracy', contextNote: 'Serialized barcode asset verification tracked from initial collection to final certificate' },
      { prefix: '', value: '24/7', suffix: '', label: 'Vault Security Monitoring', contextNote: 'Continuous Grade 4 telemetry, biometric access controls, and VESDA fire monitoring' },
      { prefix: '', value: '4', suffix: '', label: 'Operational Divisions', contextNote: 'Information Management, IT Lifecycle, Secure Shredding, and Moving & Relocation' },
    ];

const rawSusSteps = pageData.lifecycleSteps || [];

const lifecycleSteps = rawSusSteps.length > 0
  ? rawSusSteps.map((s, idx) => ({
      step: s.step || `0${idx + 1}`,
      title: s.title || '',
      desc: s.desc || '',
    }))
  : [
      { step: '01', title: 'COLLECT', desc: 'Securely collect technology from your organisation.' },
      { step: '02', title: 'SECURE', desc: 'Maintain controlled handling throughout the process.' },
      { step: '03', title: 'SANITISE', desc: 'Remove or destroy data according to the required process.' },
      { step: '04', title: 'REUSE', desc: 'Identify equipment suitable for continued use or remarketing.' },
      { step: '05', title: 'RECYCLE', desc: 'Responsibly process equipment that has reached end of life.' },
      { step: '06', title: 'REPORT', desc: 'Provide appropriate asset and lifecycle documentation.' },
    ];

const serviceCards = [
  {
    title: 'IT Asset Disposition',
    desc: 'Securely manage technology from collection through final disposition.',
    url: '/services/it-asset-disposition-services',
  },
  {
    title: 'Remarketing & Recycling',
    desc: 'Recover value and responsibly manage end-of-life equipment.',
    url: '/services/remarketing-recycling-services',
  },
  {
    title: 'Secure Destruction',
    desc: 'Ensure obsolete or sensitive media is appropriately destroyed.',
    url: '/services/ultra-secure-hard-drive-destruction-services',
  },
  {
    title: 'IT Relocation',
    desc: 'Plan technology moves with lifecycle efficiency in mind.',
    url: '/services/it-relocations-specialist-services',
  },
];
---

<BaseLayout
  title={pageData.metaTitle || "Sustainability & IT Lifecycle Management | Techsteps UK"}
  description={pageData.metaDescription || "Extending technology lifecycles, recovering value, and responsibly managing end-of-life IT assets across the UK."}
  hasHeroHeader={true}
>
  <!-- =========================
       1. SUSTAINABILITY HERO SECTION
       Ref: HeroHome / HeroSector (Light styling, Sustainability hero.webp on the right)
  ========================= -->
  <section
    id="sustainability-hero"
    class="relative w-full bg-white select-none"
  >
    <!-- Top Hero Header (Integrated light hero navbar) -->
    <HeroHeader isHome={true} />

    <!-- Hero Content in same container as header -->
    <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="relative w-full min-h-[460px] sm:min-h-[500px] lg:min-h-[560px] flex flex-col justify-center">

        <!-- Contained Image Wrapper (ends at right edge of header container) -->
        <div class="absolute inset-y-0 right-0 w-full lg:w-[62%] overflow-hidden pointer-events-none select-none z-0">
          <img
            src="/images/sustainability/Sustainability hero.webp"
            alt="Sustainability and Circular IT Lifecycle - TechSteps UK"
            aria-hidden="true"
            class="w-full h-full object-cover object-right pointer-events-none select-none"
            loading="eager"
            fetchpriority="high"
            decoding="sync"
          />
          <div class="absolute inset-0 bg-gradient-to-r from-white/90 via-white/30 lg:via-white/10 to-transparent pointer-events-none"></div>
          <div class="absolute inset-y-0 right-0 w-1/4 bg-gradient-to-l from-white via-white/70 to-transparent pointer-events-none"></div>
        </div>

        <!-- Main Hero Content Container -->
        <div
          class="relative z-10 w-full
                 pt-4 sm:pt-8 lg:pt-12 xl:pt-14
                 pb-6 sm:pb-8 lg:pb-10"
        >
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-10 items-center">

        <!-- HERO CONTENT (Left) -->
        <div class="lg:col-span-6 xl:col-span-6 max-w-2xl lg:max-w-none pt-2 sm:pt-4 z-10">

          <!-- Breadcrumb Navigation -->
          <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-semibold text-slate-600 mb-3 sm:mb-4">
            <a href="/" class="text-slate-700 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
              Home
            </a>
            <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
            <span class="text-slate-900 font-bold">Sustainability</span>
          </nav>

          <!-- Eyebrow Badge -->
          {/*<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0F623A]/10 text-[#0F623A] text-xs sm:text-sm font-sans font-bold uppercase tracking-[0.18em] mb-3 sm:mb-4">
            <span>{pageData.hero?.eyebrow || 'SUSTAINABILITY & CIRCULAR ECONOMY'}</span>
          </div>*/}

          <!-- Heading -->
          <h1
            class="font-display
                   text-3xl sm:text-4xl md:text-5xl lg:text-[50px] xl:text-[56px]
                   font-semibold
                   text-slate-900
                   tracking-normal
                   leading-[1.12] sm:leading-[1.1]
                   max-w-xl"
          >
            {pageData.hero?.title || 'A Smarter Lifecycle for Every Asset.'}
          </h1>

          <!-- Description -->
          <p
            class="mt-4 sm:mt-5
                   text-lg sm:text-xl lg:text-lg
                   text-black
                   max-w-lg
                   leading-relaxed
                   font-sans font-normal"
          >
            {pageData.hero?.subheading || 'We help organisations extend the life of technology, recover value from IT assets and responsibly manage equipment that reaches the end of its useful life.'}
          </p>

          <!-- CTA Buttons -->
          <div
            class="mt-6 sm:mt-8
                   flex flex-wrap
                   items-center
                   gap-3.5 sm:gap-4"
          >
            <a
              href={pageData.hero?.buttonLink || '#our-approach'}
              class="inline-flex items-center justify-center
                     gap-2.5
                     px-6 sm:px-7
                     py-3 sm:py-3.5
                     rounded-[12px]
                     bg-[#0F623A] hover:bg-[#0c4e2e]
                     text-white
                     text-sm sm:text-base
                     font-bold
                     shadow-md hover:shadow-lg
                     transition-all duration-200
                     hover:scale-[1.02]
                     focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
            >
              <span>{pageData.hero?.buttonText || 'Explore Our Approach'}</span>
              <svg
                class="w-4 h-4 text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
                stroke-width="2.2"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M19 9l-7 7-7-7"
                />
              </svg>
            </a>

            <a
              href={pageData.hero?.secondaryButtonLink || "/contact"}
              class="inline-flex items-center justify-center
                     px-6 sm:px-7
                     py-3 sm:py-3.5
                     rounded-[12px]
                     bg-white hover:bg-slate-50
                     border-2 border-[#0F623A] hover:border-[#0c4e2e]
                     text-[#0F623A] hover:text-[#0c4e2e]
                     text-sm sm:text-base
                     font-bold
                     transition-all duration-200
                     hover:scale-[1.02]
                     shadow-xs
                     focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
            >
              {pageData.hero?.secondaryButtonText || "Contact Our Team"}
            </a>
          </div>

          <!-- Mobile & Tablet Visual Stack (Below Text on <lg) -->
          <div class="lg:hidden w-full flex justify-center items-center mt-8 sm:mt-10">
            <div class="relative w-full max-w-[460px]">
              <img
                src={pageData.hero?.imageUrl || "/images/sustainability/Sustainability hero.webp"}
                alt="Sustainability and Circular IT Lifecycle - TechSteps UK"
                class="w-full h-auto object-contain drop-shadow-md select-none mx-auto block rounded-[20px]"
                loading="eager"
                decoding="sync"
              />
            </div>
          </div>

        </div>

        <!-- HERO SPACER (Right on Desktop) -->
        <div class="hidden lg:flex lg:col-span-6 xl:col-span-6 items-center justify-end min-h-[420px] lg:min-h-[480px] xl:min-h-[520px] pointer-events-none" aria-hidden="true">
        </div>

      </div>
    </div>
  </div>
  </div>
</section>

  <!-- MAIN CANVAS SECTION -->
  <section class="relative bg-white py-10 sm:py-16">
    <Container>

      <!-- 2. OUR APPROACH TO SUSTAINABILITY -->
      <div id="our-approach" class="w-full mx-auto space-y-10">
        
        <!-- Section Top Center Heading -->
        <div class="text-center max-w-3xl mx-auto space-y-4">
          {/*<span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#146B5C]">
            {pageData.approach?.eyebrow || "OUR APPROACH"}
          </span>*/}
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold font-display text-slate-900 tracking-tight min-h-[2lh] min-h-[2.2em] flex items-center justify-center">
            {pageData.approach?.heading || "Technology Has More Than One Ending."}
          </h2>
          <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-medium pt-1 min-h-[2.5lh]">
            {pageData.approach?.description || "Not every device needs to become waste. Where appropriate, assets can be securely prepared for reuse, remarketing or recovery before responsible recycling is considered."}
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start pt-4">
          
          <!-- LEFT FEATURE IMAGE CARD (Sticky Pin on Desktop) -->

<div class="lg:col-span-5 lg:sticky lg:top-28 relative group">
  <img
    src="/images/sustainability/OUR%20APPROACH.webp"
    alt="TechSteps sustainability approach and responsible IT asset lifecycle management"
    class="w-full h-auto object-cover object-center group-hover:scale-105 transition-transform duration-700"
    loading="lazy"
    decoding="async"
  />
</div>

          <!-- RIGHT STACK OF 6 CARDS: Dynamic CMS-driven Sticky Scroll Stacking -->
          <div class="lg:col-span-7 flex flex-col gap-5">
            {approachSteps.map((s, idx) => {
              const stickyClasses = [
                'lg:sticky lg:top-24 z-10',
                'lg:sticky lg:top-28 z-20',
                'lg:sticky lg:top-32 z-30',
                'lg:sticky lg:top-36 z-40',
                'lg:sticky lg:top-40 z-50',
                'lg:sticky lg:top-44 z-[60]',
              ];
              const isLast = idx === approachSteps.length - 1;
              return (
                <div class={`${stickyClasses[idx] || 'lg:sticky lg:top-24 z-10'} bg-white rounded-[20px] p-6 sm:p-7 border border-slate-200/90 shadow-md hover:shadow-xl transition-all flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-7`}>
                  <span class={`text-5xl sm:text-6xl font-extrabold font-sans ${isLast ? 'text-slate-700' : 'text-[#146B5C]'} shrink-0 leading-none`}>
                    {s.step || idx + 1}
                  </span>
                  <div class="space-y-1.5 flex-1">
                    <div class="flex items-center justify-between gap-2 flex-wrap">
                      <h3 class="text-xl sm:text-2xl font-semibold font-display text-slate-900">
                        {s.title}
                      </h3>
                      {s.badge && (
                        <span class={`text-xs sm:text-sm font-bold uppercase tracking-wider ${isLast ? 'text-slate-700 bg-slate-100' : 'text-[#146B5C] bg-[#146B5C]/10'} px-3.5 py-1 rounded-full`}>
                          {s.badge}
                        </span>
                      )}
                    </div>
                    <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                      {s.desc}
                    </p>
                  </div>
                </div>
              );
            })}
          </div>
        </div>

      </div>

      <!-- 3. THE IT ASSET LIFECYCLE (Hero Visual Interactive Section) -->
      <div class="mt-24 sm:mt-32 w-full mx-auto space-y-12">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          {/*<span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#146B5C]">
            LIFECYCLE ARCHITECTURE
          </span>*/}
          <h2 class="text-3xl sm:text-4xl font-semibold font-display text-slate-900 tracking-tight">
            Every Asset. A Smarter Journey.
          </h2>
        </div>

        <!-- 6 Steps Grid / Flow -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {lifecycleSteps.map((s) => (
            <div class="bg-white/90 backdrop-blur-xs rounded-[16px] p-6 sm:p-8 border border-slate-200/80 shadow-md space-y-4 hover:shadow-xl transition-all duration-300 relative overflow-hidden group min-h-[220px] flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-3xl sm:text-4xl font-extrabold font-sans text-[#146B5C]/30 group-hover:text-[#146B5C] transition-colors">
                    {s.step}
                  </span>
                  <span class="w-3 h-3 rounded-full bg-[#146B5C]"></span>
                </div>
                <h3 class="text-xl sm:text-2xl font-semibold font-display text-slate-900 tracking-tight min-h-[2lh] min-h-[3.5rem] flex items-start">
                  {s.title}
                </h3>
              </div>
              <p class="text-base text-slate-700 leading-relaxed font-semibold min-h-[3lh] min-h-[4.5rem]">
                {s.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- 4. REUSE BEFORE RECYCLE (Clean Editorial UI) -->
      <div class="mt-14 sm:mt-20 w-full mx-auto relative">
        <!-- Background Decorative Watermark Leaf Circle -->
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-96 h-96 bg-[#146B5C]/5 rounded-full blur-3xl pointer-events-none z-0"></div>

        <div class="relative z-10 space-y-12 sm:space-y-16">
          
          <!-- Top Grid: Left Editorial Text & Right Photo with Floating Badge -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
            
            <!-- Left Text Content -->
            <div class="lg:col-span-6 space-y-6">
              {/*<div class="flex items-center gap-3">
                <span class="w-8 h-[2px] bg-[#146B5C]"></span>
                <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-slate-700">
                  PRIORITISING LONGEVITY
                </span>
              </div>*/}

              <h2 class="text-4xl sm:text-5xl lg:text-6xl font-semibold font-display text-slate-900 tracking-tight leading-[1.1]">
                {pageData.prioritisingLongevity?.heading ? (
                  pageData.prioritisingLongevity.heading === 'Reuse Before Recycle.' ? (
                    <>Reuse Before<br /><span class="text-[#146B5C]">Recycle.</span></>
                  ) : (
                    pageData.prioritisingLongevity.heading
                  )
                ) : (
                  <>Reuse Before<br /><span class="text-[#146B5C]">Recycle.</span></>
                )}
              </h2>

              <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-medium max-w-xl">
                {pageData.prioritisingLongevity?.description || "Not every device needs to become waste. Where possible, we extend the life of technology, recover value and only recycle when it’s the right option."}
              </p>
            </div>

            <!-- Right Image Area (Image Only) -->
            <div class="lg:col-span-6 flex items-center justify-center">
              <img
                src={pageData.prioritisingLongevity?.imageUrl || "/images/sustainability/image.webp"}
                alt={pageData.prioritisingLongevity?.imageAlt || "Enterprise IT Hardware Refurbishment and Remarketing Stack"}
                class="w-full h-auto object-contain max-h-[500px]"
              />
            </div>

          </div>

          <!-- Bottom Row: 3 Circle Icon Steps with Horizontal Flow Arrows -->
          <div class="pt-8 sm:pt-12 border-t border-slate-200/80">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 lg:gap-6">
              
              <!-- Step 1: REUSE -->
              <div class="flex items-center gap-4 sm:gap-5 flex-1">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#E4F2E7] flex items-center justify-center shrink-0 text-[#146B5C] shadow-xs">
                  <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg sm:text-xl font-semibold font-display text-slate-900 tracking-tight">
                    REUSE
                  </h3>
                  <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed max-w-[240px]">
                    Extend the useful life of equipment.
                  </p>
                </div>
              </div>

              <!-- Flow Arrow 1 -->
              <div class="hidden md:block text-slate-400 shrink-0 px-2">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>

              <!-- Step 2: REMARKET -->
              <div class="flex items-center gap-4 sm:gap-5 flex-1">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#E4F2E7] flex items-center justify-center shrink-0 text-[#146B5C] shadow-xs">
                  <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg sm:text-xl font-semibold font-display text-slate-900 tracking-tight">
                    REMARKET
                  </h3>
                  <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed max-w-[240px]">
                    Recover value from suitable technology.
                  </p>
                </div>
              </div>

              <!-- Flow Arrow 2 -->
              <div class="hidden md:block text-slate-400 shrink-0 px-2">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>

              <!-- Step 3: RECYCLE -->
              <div class="flex items-center gap-4 sm:gap-5 flex-1">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#E4F2E7] flex items-center justify-center shrink-0 text-[#146B5C] shadow-xs">
                  <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg sm:text-xl font-semibold font-display text-slate-900 tracking-tight">
                    RECYCLE
                  </h3>
                  <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed max-w-[240px]">
                    Responsibly process assets that can no longer be reused.
                  </p>
                </div>
              </div>

            </div>
          </div>

          <!-- Bottom Footer Accent Lines -->
          {/*<div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-slate-200/60 text-xs sm:text-sm font-extrabold text-slate-700 uppercase tracking-widest">
            <div class="flex items-center gap-2">
              <span class="w-6 h-[2px] bg-[#146B5C]"></span>
              <span>SUSTAINABLE IT LIFECYCLES</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-6 h-[2px] bg-slate-400"></span>
              <span>PEOPLE | TECHNOLOGY | A CLEANER TOMORROW</span>
            </div>
          </div>*/}

        </div>
      </div>

      <!-- 5. RESPONSIBLE RECYCLING -->
      <div class="mt-14 sm:mt-20 max-w-5xl mx-auto space-y-10">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          {/*<span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#146B5C]">
            END OF LIFE MANAGEMENT
          </span>*/}
          <h2 class="text-3xl sm:text-4xl font-semibold font-display text-slate-900 tracking-tight">
            Responsible at End of Life.
          </h2>
        </div>

        <!-- Horizontal Process Stepper Timeline (Reference Design) -->
        <div class="bg-white/90 backdrop-blur-xs rounded-[24px] p-6 sm:p-10 lg:p-12 border border-slate-200/90 shadow-xl relative overflow-hidden">
          
          <div class="max-w-4xl mx-auto">
            <!-- 5-Step Horizontal Stepper -->
            <div class="relative flex items-center justify-between">
              
              <!-- Background Connecting Track Line (Centered on Bullets) -->
