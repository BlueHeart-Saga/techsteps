---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import PageHero from '../components/hero/PageHero.astro';
import { statistics } from '../lib/sanity/data';

const breadcrumbs = [
  { name: 'Sustainability', url: '/sustainability' },
];

const lifecycleSteps = [
  {
    step: '01',
    title: 'COLLECT',
    desc: 'Securely collect technology from your organisation.',
  },
  {
    step: '02',
    title: 'SECURE',
    desc: 'Maintain controlled handling throughout the process.',
  },
  {
    step: '03',
    title: 'SANITISE',
    desc: 'Remove or destroy data according to the required process.',
  },
  {
    step: '04',
    title: 'REUSE',
    desc: 'Identify equipment suitable for continued use or remarketing.',
  },
  {
    step: '05',
    title: 'RECYCLE',
    desc: 'Responsibly process equipment that has reached end of life.',
  },
  {
    step: '06',
    title: 'REPORT',
    desc: 'Provide appropriate asset and lifecycle documentation.',
  },
];

const serviceCards = [
  {
    title: 'IT Asset Disposition',
    desc: 'Securely manage technology from collection through final disposition.',
    url: '/services/it-asset-disposition-services',
  },
  {
    title: 'Remarketing & Recycling',
    desc: 'Recover value and responsibly manage end-of-life equipment.',
    url: '/services/remarketing-recycling',
  },
  {
    title: 'Secure Destruction',
    desc: 'Ensure obsolete or sensitive media is appropriately destroyed.',
    url: '/services/ultra-secure-hard-drive-destruction',
  },
  {
    title: 'IT Relocation',
    desc: 'Plan technology moves with lifecycle efficiency in mind.',
    url: '/services/it-relocations-specialist',
  },
];
---

<BaseLayout
  title="Sustainability & IT Lifecycle Management | Techsteps UK"
  description="Extending technology lifecycles, recovering value, and responsibly managing end-of-life IT assets across the UK."
  hasHeroHeader={true}
>
  <!-- 1. SUSTAINABILITY HERO -->
  <PageHero
    eyebrow="SUSTAINABILITY"
    title="A Smarter Lifecycle for Every Asset."
    subheading="We help organisations extend the life of technology, recover value from IT assets and responsibly manage equipment that reaches the end of its useful life."
    bgImage="/images/services/remarketing.jpg"
    breadcrumbs={breadcrumbs}
    dividerColor="#f1f4ef"
  >
    <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#our-approach"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#146B5C] hover:bg-[#0D5549] text-white text-sm font-bold shadow-lg transition-all duration-200"
      >
        Explore Our Approach
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
    </div>
  </PageHero>

  <!-- MAIN CANVAS SECTION -->
  <section class="relative bg-[#f1f4ef] py-16 sm:py-24">
    <Container>

      <!-- 2. OUR APPROACH TO SUSTAINABILITY -->
      <div id="our-approach" class="max-w-7xl mx-auto space-y-10">
        
        <!-- Section Top Center Heading -->
        <div class="text-center max-w-3xl mx-auto space-y-4">
          <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#146B5C]">
            OUR APPROACH
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold font-display text-slate-900 tracking-tight">
            Technology Has More Than One Ending.
          </h2>
          <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-medium pt-1">
            Not every device needs to become waste. Where appropriate, assets can be securely prepared for reuse, remarketing or recovery before responsible recycling is considered.
          </p>
        </div>

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start pt-4">
          
          <!-- LEFT FEATURE IMAGE CARD (Sticky Pin on Desktop) -->
          <div class="lg:col-span-5 lg:sticky lg:top-28 rounded-[32px] overflow-hidden relative shadow-xl min-h-[420px] lg:h-[calc(100vh-140px)] border border-slate-200/90 group flex flex-col justify-end p-8">
            <img
              src="/images/services/sustainability-approach.jpg"
              alt="TechSteps Sustainable Enterprise Hardware Lifecycle Laboratory"
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 z-0"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/40 to-transparent z-10"></div>
            
            <div class="relative z-20 space-y-2">
              <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md text-[#2DD4BF] text-xs sm:text-sm font-bold uppercase tracking-wider border border-white/20">
                CIRCULAR LIFECYCLE
              </span>
              <h3 class="text-2xl sm:text-3xl font-bold font-display text-white">
                Extending Enterprise Hardware Utility
              </h3>
              <p class="text-sm sm:text-base text-slate-100 font-semibold leading-relaxed">
                Refurbishment, component harvesting, and secure remarketing to maximize secondary B2B asset value.
              </p>
            </div>
          </div>

          <!-- RIGHT STACK OF 6 CARDS: Sticky Scroll One-by-One Stacking -->
          <div class="lg:col-span-7 flex flex-col gap-5">
            
            <!-- STAGE 1: COLLECT -->
            <div class="lg:sticky lg:top-24 bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-md hover:shadow-xl transition-all flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-7 z-10">
              <!-- Huge Number 1 -->
              <span class="text-5xl sm:text-6xl font-extrabold font-display text-[#146B5C] shrink-0 leading-none">
                1
              </span>
              <div class="space-y-1.5 flex-1">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <h3 class="text-xl sm:text-2xl font-bold font-display text-slate-900">
                    COLLECT
                  </h3>
                  <span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-[#146B5C] bg-[#146B5C]/10 px-3.5 py-1 rounded-full">Chain-of-Custody</span>
                </div>
                <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                  Secure GPS-tracked transport, tamper-evident containers, and strict chain-of-custody handling directly from enterprise sites.
                </p>
              </div>
            </div>

            <!-- STAGE 2: AUDIT & ASSESS -->
            <div class="lg:sticky lg:top-28 bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-md hover:shadow-xl transition-all flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-7 z-20">
              <!-- Huge Number 2 -->
              <span class="text-5xl sm:text-6xl font-extrabold font-display text-[#146B5C] shrink-0 leading-none">
                2
              </span>
              <div class="space-y-1.5 flex-1">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <h3 class="text-xl sm:text-2xl font-bold font-display text-slate-900">
                    AUDIT &amp; ASSESS
                  </h3>
                  <span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-[#146B5C] bg-[#146B5C]/10 px-3.5 py-1 rounded-full">Triage &amp; Verification</span>
                </div>
                <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                  Granular asset logging, serial number scanning, hardware functional diagnostics, and secondary lifecycle viability assessment.
                </p>
              </div>
            </div>

            <!-- STAGE 3: SANITISE -->
            <div class="lg:sticky lg:top-32 bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-md hover:shadow-xl transition-all flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-7 z-30">
              <!-- Huge Number 3 -->
              <span class="text-5xl sm:text-6xl font-extrabold font-display text-[#146B5C] shrink-0 leading-none">
                3
              </span>
              <div class="space-y-1.5 flex-1">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <h3 class="text-xl sm:text-2xl font-bold font-display text-slate-900">
                    SANITISE
                  </h3>
                  <span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-[#146B5C] bg-[#146B5C]/10 px-3.5 py-1 rounded-full">Cryptographic Erasure</span>
                </div>
                <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                  Certified ADISA and NIST 800-88 compliant data wiping or physical degaussing to ensure zero data residual liability.
                </p>
              </div>
            </div>

            <!-- STAGE 4: REUSE -->
            <div class="lg:sticky lg:top-36 bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-md hover:shadow-xl transition-all flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-7 z-40">
              <!-- Huge Number 4 -->
              <span class="text-5xl sm:text-6xl font-extrabold font-display text-[#146B5C] shrink-0 leading-none">
                4
              </span>
              <div class="space-y-1.5 flex-1">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <h3 class="text-xl sm:text-2xl font-bold font-display text-slate-900">
                    REUSE
                  </h3>
                  <span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-[#146B5C] bg-[#146B5C]/10 px-3.5 py-1 rounded-full">Redeployment &amp; Extension</span>
                </div>
                <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                  Extending useful hardware life through internal redeployment, component harvesting, and secondary hardware assignment.
                </p>
              </div>
            </div>

            <!-- STAGE 5: REMARKET -->
            <div class="lg:sticky lg:top-40 bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-md hover:shadow-xl transition-all flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-7 z-50">
              <!-- Huge Number 5 -->
              <span class="text-5xl sm:text-6xl font-extrabold font-display text-[#146B5C] shrink-0 leading-none">
                5
              </span>
              <div class="space-y-1.5 flex-1">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <h3 class="text-xl sm:text-2xl font-bold font-display text-slate-900">
                    REMARKET
                  </h3>
                  <span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-[#146B5C] bg-[#146B5C]/10 px-3.5 py-1 rounded-full">Value Recovery</span>
                </div>
                <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                  Refurbishing and remarketing high-value IT equipment into global secondary B2B channels to return maximum ROI.
                </p>
              </div>
            </div>

            <!-- STAGE 6: RECYCLE & RECOVER -->
            <div class="lg:sticky lg:top-44 bg-white rounded-3xl p-6 sm:p-7 border border-slate-200/90 shadow-md hover:shadow-xl transition-all flex flex-col sm:flex-row items-start sm:items-center gap-5 sm:gap-7 z-[60]">
              <!-- Huge Number 6 -->
              <span class="text-5xl sm:text-6xl font-extrabold font-display text-slate-700 shrink-0 leading-none">
                6
              </span>
              <div class="space-y-1.5 flex-1">
                <div class="flex items-center justify-between gap-2 flex-wrap">
                  <h3 class="text-xl sm:text-2xl font-bold font-display text-slate-900">
                    RECYCLE &amp; RECOVER
                  </h3>
                  <span class="text-xs sm:text-sm font-bold uppercase tracking-wider text-slate-700 bg-slate-100 px-3.5 py-1 rounded-full">Zero-Landfill Guarantee</span>
                </div>
                <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed">
                  Eco-certified material separation, WEEE-compliant shredding, and RDF energy recovery ensuring 100% zero-to-landfill diversion.
                </p>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- 3. THE IT ASSET LIFECYCLE (Hero Visual Interactive Section) -->
      <div class="mt-24 sm:mt-32 max-w-6xl mx-auto space-y-12">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#146B5C]">
            LIFECYCLE ARCHITECTURE
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-slate-900 tracking-tight">
            Every Asset. A Smarter Journey.
          </h2>
        </div>

        <!-- 6 Steps Grid / Flow -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {lifecycleSteps.map((s) => (
            <div class="bg-white/90 backdrop-blur-xs rounded-2xl p-6 sm:p-8 border border-slate-200/80 shadow-md space-y-4 hover:shadow-xl transition-all duration-300 relative overflow-hidden group">
              <div class="flex items-center justify-between">
                <span class="text-3xl sm:text-4xl font-extrabold font-display text-[#146B5C]/30 group-hover:text-[#146B5C] transition-colors">
                  {s.step}
                </span>
                <span class="w-3 h-3 rounded-full bg-[#146B5C]"></span>
              </div>
              <h3 class="text-xl sm:text-2xl font-bold font-display text-slate-900 tracking-tight">
                {s.title}
              </h3>
              <p class="text-base text-slate-700 leading-relaxed font-semibold">
                {s.desc}
              </p>
            </div>
          ))}
        </div>
      </div>

      <!-- 4. REUSE BEFORE RECYCLE (Clean Editorial UI) -->
      <div class="mt-24 sm:mt-32 max-w-7xl mx-auto relative">
        <!-- Background Decorative Watermark Leaf Circle -->
        <div class="absolute right-0 top-1/2 -translate-y-1/2 w-96 h-96 bg-[#146B5C]/5 rounded-full blur-3xl pointer-events-none z-0"></div>

        <div class="relative z-10 space-y-12 sm:space-y-16">
          
          <!-- Top Grid: Left Editorial Text & Right Photo with Floating Badge -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
            
            <!-- Left Text Content -->
            <div class="lg:col-span-6 space-y-6">
              <div class="flex items-center gap-3">
                <span class="w-8 h-[2px] bg-[#146B5C]"></span>
                <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-slate-700">
                  PRIORITISING LONGEVITY
                </span>
              </div>

              <h2 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold font-display text-slate-900 tracking-tight leading-[1.1]">
                Reuse Before<br />
                <span class="text-[#146B5C]">Recycle.</span>
              </h2>

              <p class="text-lg sm:text-xl text-slate-700 leading-relaxed font-medium max-w-xl">
                Not every device needs to become waste. Where possible, we extend the life of technology, recover value and only recycle when it’s the right option.
              </p>
            </div>

            <!-- Right Image Area (Image Only) -->
            <div class="lg:col-span-6 flex items-center justify-center">
              <img
                src="/images/sustainability/image.png"
                alt="Enterprise IT Hardware Refurbishment and Remarketing Stack"
                class="w-full h-auto object-contain max-h-[500px]"
              />
            </div>

          </div>

          <!-- Bottom Row: 3 Circle Icon Steps with Horizontal Flow Arrows -->
          <div class="pt-8 sm:pt-12 border-t border-slate-200/80">
            <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-8 lg:gap-6">
              
              <!-- Step 1: REUSE -->
              <div class="flex items-center gap-4 sm:gap-5 flex-1">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#E4F2E7] flex items-center justify-center shrink-0 text-[#146B5C] shadow-xs">
                  <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg sm:text-xl font-extrabold font-display text-slate-900 tracking-tight">
                    REUSE
                  </h3>
                  <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed max-w-[240px]">
                    Extend the useful life of equipment.
                  </p>
                </div>
              </div>

              <!-- Flow Arrow 1 -->
              <div class="hidden md:block text-slate-400 shrink-0 px-2">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>

              <!-- Step 2: REMARKET -->
              <div class="flex items-center gap-4 sm:gap-5 flex-1">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#E4F2E7] flex items-center justify-center shrink-0 text-[#146B5C] shadow-xs">
                  <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg sm:text-xl font-extrabold font-display text-slate-900 tracking-tight">
                    REMARKET
                  </h3>
                  <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed max-w-[240px]">
                    Recover value from suitable technology.
                  </p>
                </div>
              </div>

              <!-- Flow Arrow 2 -->
              <div class="hidden md:block text-slate-400 shrink-0 px-2">
                <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </div>

              <!-- Step 3: RECYCLE -->
              <div class="flex items-center gap-4 sm:gap-5 flex-1">
                <div class="w-16 h-16 sm:w-20 sm:h-20 rounded-full bg-[#E4F2E7] flex items-center justify-center shrink-0 text-[#146B5C] shadow-xs">
                  <svg class="w-8 h-8 sm:w-10 sm:h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
                  </svg>
                </div>
                <div class="space-y-1">
                  <h3 class="text-lg sm:text-xl font-extrabold font-display text-slate-900 tracking-tight">
                    RECYCLE
                  </h3>
                  <p class="text-sm sm:text-base text-slate-700 font-semibold leading-relaxed max-w-[240px]">
                    Responsibly process assets that can no longer be reused.
                  </p>
                </div>
              </div>

            </div>
          </div>

          <!-- Bottom Footer Accent Lines -->
          <div class="flex flex-col sm:flex-row items-center justify-between gap-4 pt-4 border-t border-slate-200/60 text-xs sm:text-sm font-extrabold text-slate-700 uppercase tracking-widest">
            <div class="flex items-center gap-2">
              <span class="w-6 h-[2px] bg-[#146B5C]"></span>
              <span>SUSTAINABLE IT LIFECYCLES</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="w-6 h-[2px] bg-slate-400"></span>
              <span>PEOPLE | TECHNOLOGY | A CLEANER TOMORROW</span>
            </div>
          </div>

        </div>
      </div>

      <!-- 5. RESPONSIBLE RECYCLING -->
      <div class="mt-24 sm:mt-32 max-w-5xl mx-auto space-y-10">
        <div class="text-center max-w-2xl mx-auto space-y-3">
          <span class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#146B5C]">
            END OF LIFE MANAGEMENT
          </span>
          <h2 class="text-3xl sm:text-4xl font-extrabold font-display text-slate-900 tracking-tight">
            Responsible at End of Life.
          </h2>
        </div>

        <!-- Horizontal Process Stepper Timeline (Reference Design) -->
        <div class="bg-white/90 backdrop-blur-xs rounded-3xl p-6 sm:p-10 lg:p-12 border border-slate-200/90 shadow-xl relative overflow-hidden">
          
          <div class="max-w-4xl mx-auto">
            <!-- 5-Step Horizontal Stepper -->
            <div class="relative flex items-center justify-between">
              
              <!-- Background Connecting Track Line (Centered on Bullets) -->
              <div class="absolute top-[74px] left-[10%] right-[10%] h-[3px] bg-slate-200 -z-0 hidden sm:block -translate-y-1/2"></div>
              
              <!-- Active Progress Line Segment (Emerald Highlight) -->
              <div class="absolute top-[74px] left-[10%] w-[40%] h-[3px] bg-[#146B5C] -z-0 hidden sm:block -translate-y-1/2"></div>

              <!-- STEP 1: IT EQUIPMENT -->
              <div class="relative z-10 flex flex-col items-center text-center space-y-3 flex-1">
                <!-- Icon -->
                <div class="w-12 h-12 flex items-center justify-center text-slate-800">
                  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <!-- Node Bullet -->
                <div class="w-7 h-7 rounded-full bg-slate-800 text-white flex items-center justify-center shadow-xs">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <!-- Label -->
                <span class="text-sm sm:text-base font-extrabold font-display text-slate-900 tracking-tight">
                  IT Equipment
                </span>
              </div>

              <!-- STEP 2: SORT -->
              <div class="relative z-10 flex flex-col items-center text-center space-y-3 flex-1">
                <!-- Icon -->
                <div class="w-12 h-12 flex items-center justify-center text-slate-800">
                  <svg class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.6" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
                  </svg>
                </div>
                <!-- Node Bullet -->
                <div class="w-7 h-7 rounded-full bg-slate-800 text-white flex items-center justify-center shadow-xs">
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
                  </svg>
                </div>
                <!-- Label -->
