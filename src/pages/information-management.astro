---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import AccordionFaq from '../components/content/AccordionFaq.astro';
import ServicesCardGrid from '../components/services/ServicesCardGrid.astro';
import CTA from '../components/global/cta.astro';
import { getDivisions, getServices, getSectors } from '../lib/sanity/client';

const breadcrumbs = [
  { name: 'Services', url: '/services' },
  { name: 'Information Management', url: '/information-management' },
];

const [divisions, services, sectors] = await Promise.all([
  getDivisions(),
  getServices(),
  getSectors(),
]);

const division = divisions.find((d) => d.slug === 'information-management')!;
const divisionServices = services.filter((s) => s.divisionSlug === division.slug);

const clr = { accent: '#0F623A', dark: '#0A331E', light: '#F2F8F5' };

const defaultLifecycleStages = [
  { id: 'capture', label: 'Capture', number: '01', desc: 'Information is captured from physical or digital sources — through scanning, mailroom processing or direct ingestion.' },
  { id: 'store', label: 'Store', number: '02', desc: 'Records are stored in secure, climate-controlled facilities or structured digital environments with full index and reference.' },
  { id: 'manage', label: 'Manage', number: '03', desc: 'Information is managed, controlled and accessible to authorised personnel throughout its active lifecycle.' },
  { id: 'access', label: 'Access', number: '04', desc: 'Records can be retrieved physically or digitally on demand, with appropriate authorisation and audit records.' },
  { id: 'retain', label: 'Retain', number: '05', desc: 'Retention schedules are tracked and enforced in line with regulatory, legal and organisational requirements.' },
  { id: 'dispose', label: 'Dispose', number: '06', desc: 'Information is securely and compliantly disposed of at end of retention — with certified destruction records.' },
];
const lifecycleStages = (division?.lifecycleStages && division.lifecycleStages.length > 0) ? division.lifecycleStages : defaultLifecycleStages;

const sectorLinks = [
  { title: 'NHS & Healthcare', slug: 'nhs' },
  { title: 'Financial Services', slug: 'finance' },
  { title: 'Central Government', slug: 'central-government' },
  { title: 'Defence', slug: 'defence' },
];

const defaultFaqs = [
  { question: 'What is information lifecycle management?', answer: 'Information lifecycle management covers the full journey of a business record — from creation or capture through active use, storage, retrieval, retention and compliant disposal — with the goal of keeping information secure, accessible and compliantly managed throughout.' },
  { question: 'How secure is off-site document storage?', answer: 'Our storage facilities operate under ISO 27001 and BS 4971 standards with climate control, VESDA smoke detection, FM200 fire suppression, and item-level barcode tracking. Access is restricted to authorised personnel only.' },
  { question: 'Can you digitise our existing paper records?', answer: 'Yes. Our document scanning service processes high volumes to BS 10008 legal admissibility standards, with full OCR indexing and integration with your document management systems.' },
  { question: 'Can records be securely destroyed at end of retention?', answer: 'Yes. Secure document destruction at end of retention is part of our information management service, with certificates provided for every destruction event.' },
];
const faqs = (division?.faqs && division.faqs.length > 0) ? division.faqs : defaultFaqs;
---

<BaseLayout
  title={division?.metaTitle || "Information Management | Document Storage, Scanning & Records Management | Techsteps"}
  description={division?.metaDescription || "Secure information management — climate-controlled document storage, BS 10008 scanning, digital mailroom, and records lifecycle services. UK-wide from Techsteps."}
  hasHeroHeader={true}
>
  <!-- ===== 1. HERO (Custom section replacing PageHero to remove bg image) ===== -->
  <div class="relative bg-white">
    <!-- Keep the Navbar -->
    <HeroHeader isHome={false} />

    <!-- Hero Content -->
    <section class="relative w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 lg:py-20 overflow-hidden">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-10 items-center">
        
        <!-- HERO CONTENT (Left) -->
        <div class="lg:col-span-6 xl:col-span-6 max-w-2xl lg:max-w-none z-10">
          <!-- Breadcrumb Navigation -->
          <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-semibold text-slate-600 mb-3 sm:mb-4">
            <a href="/services" class="text-slate-700 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
              Services
            </a>
            <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
            <span class="text-slate-900 font-bold">Information Management</span>
          </nav>

          <!-- Heading -->
          <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[50px] xl:text-[56px] font-semibold text-slate-900 tracking-normal leading-[1.12] sm:leading-[1.1] max-w-xl">
            {division?.heroTitle || 'Information Management Services UK'}
          </h1>

          <!-- Description -->
          <p class="mt-4 sm:mt-5 text-lg sm:text-xl lg:text-lg text-black max-w-lg leading-relaxed font-sans font-normal">
            {division?.heroDescription || 'Secure, organised and compliant information management solutions designed to help UK businesses store, manage, protect and access critical business information.'}
          </p>

          <!-- CTA Button -->
          <div class="mt-6 sm:mt-8 flex flex-wrap items-center gap-3.5 sm:gap-4">
            <a href={division?.heroCtaLink || '/request-a-collection?service=information-management'} class="inline-flex items-center justify-center gap-2.5 px-6 sm:px-7 py-3 sm:py-3.5 rounded-[12px] bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm sm:text-base font-bold shadow-md hover:shadow-lg transition-all duration-200 hover:scale-[1.02] focus:outline-none focus:ring-2 focus:ring-[#0F623A]">
              <span>{division?.heroCtaText || 'Request a Collection'}</span>
              <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>

        <!-- HERO IMAGE (Right on Desktop, Below on Mobile) -->
        <div class="flex lg:col-span-6 xl:col-span-6 items-center justify-center lg:justify-end relative z-0 mt-8 lg:mt-0">
          <img 
            src={division?.heroImage || "/images/hero/Information Management (1).webp"} 
            alt="Information Management Services UK" 
            class="w-full max-w-[650px] h-auto object-contain lg:scale-[1.15] lg:translate-x-12 drop-shadow-xl select-none pointer-events-none"
          />
        </div>
      </div>
    </section>
  </div>

  <!-- ===== 2. INTRODUCTION TO INFORMATION MANAGEMENT ===== -->
  <section class="bg-white py-8 lg:py-12 relative overflow-hidden">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left Side: Introduction Content -->
        <div class="lg:col-span-7 space-y-6">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
            {division?.aboutTitle || 'Information Management Built Around Your Business'}
          </h2>

          <div class="space-y-4 text-lg sm:text-xl text-black leading-relaxed font-sans font-normal text-justify">
            {(division?.aboutParagraphs && division.aboutParagraphs.length > 0) ? (
              division.aboutParagraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))
            ) : (
              <>
                <p>
                  Every organisation holds information it cannot afford to lose: contracts, client files, employee records, backup media and historic collections. Information management is the discipline of keeping all of it under control, whether it sits in a box, on a tape or in a digital system.
                </p>
                <p>
                  We help UK businesses manage their records through three connected services: secure off-site document storage in purpose-built facilities, accredited document scanning to bring paperwork into digital workflows, and digital mailroom operations to process inbound post before it reaches an office.
                </p>
              </>
            )}
          </div>

          <div class="pt-2">
            <a href="/services" class="inline-flex items-center gap-2 text-[#0F623A] hover:text-[#0A331E] font-bold text-sm sm:text-base transition-colors group">
              <span>See our four service groups</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right Side: Service Graphic -->
        <div class="lg:col-span-5 relative flex items-center justify-center">
          <img
            src="/images/services/About Our Service 1.webp"
            alt="Techsteps Information Management and hardware specialist"
            class="w-full max-w-[420px] lg:max-w-[460px] h-auto object-contain mx-auto select-none drop-shadow-md hover:scale-[1.02] transition-transform duration-300"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 2.5 SERVICES / CORE DIVISIONS ===== -->
  <ServicesCardGrid />


  <!-- ===== WHY EFFECTIVE INFORMATION MANAGEMENT MATTERS (GREEN THEME) ===== -->
  <section class="bg-[#0A331E] py-8 sm:py-10 lg:py-12 relative overflow-hidden">
    <div class="absolute inset-0 bg-radial-[ellipse_at_top_right] from-emerald-500/10 via-transparent to-transparent pointer-events-none"></div>
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Column: Title & Intro -->
        <div class="lg:col-span-5 space-y-5">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white tracking-tight font-display leading-[1.12]">
            Why Effective Information Management Matters
          </h2>

          <p class="text-base sm:text-lg text-emerald-100/80 leading-relaxed font-normal">
            The right controls keep information safer, quicker to find and cheaper to hold.
          </p>
        </div>

        <!-- Right Column: 2x2 Pillar Grid with Top Dividers -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-10 lg:gap-y-12">
          <!-- Pillar 1: Protect Critical Information -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-[8px] bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              Protect Critical Information
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              Keep important business records secure and accessible.
            </p>
          </div>

          <!-- Pillar 2: Improve Information Access -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-[8px] bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <circle cx="11" cy="11" r="7" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-4.35-4.35" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              Improve Information Access
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              Find the information your teams need faster.
            </p>
          </div>

          <!-- Pillar 3: Support Compliance -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-[8px] bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <rect x="5" y="3" width="14" height="18" rx="2" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              Support Compliance
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              Maintain appropriate controls around sensitive and regulated information.
            </p>
          </div>

          <!-- Pillar 4: Reduce Storage Pressure -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-[8px] bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              Reduce Storage Pressure
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              Move physical records and media away from valuable office space.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== OUR INFORMATION MANAGEMENT PROCESS (WORKFLOW) ===== -->
  <section id="techsteps-lifecycle-steps" class="bg-white py-8 sm:py-10 lg:py-12 relative overflow-hidden">
    <Container>
      <div class="relative z-10">
        <!-- Section Header -->
        <div class="max-w-3xl mb-12 sm:mb-16">
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display">
            Our Information Management Process
          </h2>
          <p class="mt-3 text-lg sm:text-xl text-black font-normal">
            A structured, secure end-to-end framework to audit, transition, safeguard and retrieve your organization's records.
          </p>
        </div>

        <!-- 4-Step Process Grid (Using the Sparkle Animation Structure) -->
        <div class="tlc-grid" aria-label="Four steps to complete information lifecycle governance">
          
          <!-- Step 1 -->
          <article class="tlc-card" data-tlc-step="0" aria-label="Step 01: Assess">
            <div class="tlc-card-copy tlc-card-copy--light">
              <div class="tlc-copy-top">
                <span class="tlc-step-badge">01</span>
                <h3>Assess</h3>
                <p>Understand your information, storage requirements and business needs.</p>
              </div>
              <div class="tlc-visual" aria-hidden="true">
                <img class="tlc-stage-icon" src="https://res.cloudinary.com/dlbeckur1/image/upload/v1792825891/ChatGPT_Image_Oct_24_2026_12_38_32_PM-1_vpdsdz.png" alt="" loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="tlc-cover" aria-hidden="true">
              <img src="/images/process/Information-Management-Card1.png" alt="" loading="eager" decoding="async" onerror="this.style.visibility='hidden'" />
              <span class="tlc-cover-shade"></span>
              <span class="tlc-photo-number">01</span>
            </div>
            <span class="tlc-spark" aria-hidden="true"></span>
          </article>

          <!-- Step 2 -->
          <article class="tlc-card" data-tlc-step="1" aria-label="Step 02: Collect & Prepare">
            <div class="tlc-card-copy tlc-card-copy--light">
              <div class="tlc-copy-top">
                <span class="tlc-step-badge">02</span>
                <h3>Collect &amp; Prepare</h3>
                <p>Securely collect, catalogue and prepare records or media.</p>
              </div>
              <div class="tlc-visual" aria-hidden="true">
                <img class="tlc-stage-icon" src="https://res.cloudinary.com/dlbeckur1/image/upload/v1792825890/ChatGPT_Image_Oct_24_2026_12_38_33_PM-2_sfa7yq.png" alt="" loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="tlc-cover" aria-hidden="true">
              <img src="/images/process/Information-Management-Card2.png" alt="" loading="eager" decoding="async" onerror="this.style.visibility='hidden'" />
              <span class="tlc-cover-shade"></span>
              <span class="tlc-photo-number">02</span>
            </div>
            <span class="tlc-spark" aria-hidden="true"></span>
          </article>

          <!-- Step 3 -->
          <article class="tlc-card" data-tlc-step="2" aria-label="Step 03: Store & Manage">
            <div class="tlc-card-copy tlc-card-copy--light">
              <div class="tlc-copy-top">
                <span class="tlc-step-badge">03</span>
                <h3>Store &amp; Manage</h3>
                <p>Store information in the appropriate physical or digital environment.</p>
              </div>
              <div class="tlc-visual" aria-hidden="true">
                <img class="tlc-stage-icon" src="https://res.cloudinary.com/dlbeckur1/image/upload/v1792825890/ChatGPT_Image_Oct_24_2026_12_38_35_PM-3_btj49m.png" alt="" loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="tlc-cover" aria-hidden="true">
              <img src="/images/process/Information-Management-Card3.png" alt="" loading="eager" decoding="async" onerror="this.style.visibility='hidden'" />
              <span class="tlc-cover-shade"></span>
              <span class="tlc-photo-number">03</span>
            </div>
            <span class="tlc-spark" aria-hidden="true"></span>
          </article>

          <!-- Step 4 -->
          <article class="tlc-card" data-tlc-step="3" aria-label="Step 04: Access & Retrieve">
            <div class="tlc-card-copy tlc-card-copy--light">
              <div class="tlc-copy-top">
                <span class="tlc-step-badge">04</span>
                <h3>Access &amp; Retrieve</h3>
                <p>Provide controlled access, retrieval and ongoing management when required.</p>
              </div>
              <div class="tlc-visual" aria-hidden="true">
                <!-- 4th Icon: Using the 1st link as the 4th link was duplicate -->
                <img class="tlc-stage-icon" src="https://res.cloudinary.com/dlbeckur1/image/upload/v1792825891/ChatGPT_Image_Oct_24_2026_12_38_32_PM-1_vpdsdz.png" alt="" loading="lazy" decoding="async" />
              </div>
            </div>
            <div class="tlc-cover" aria-hidden="true">
              <img src="/images/process/Information-Management-Card4.png" alt="" loading="eager" decoding="async" onerror="this.style.visibility='hidden'" />
              <span class="tlc-cover-shade"></span>
              <span class="tlc-photo-number">04</span>
            </div>
            <span class="tlc-spark" aria-hidden="true"></span>
          </article>

        </div>
      </div>
    </Container>
    
    <!-- Styles for Animation -->
    <style is:global>
      #techsteps-lifecycle-steps .tlc-grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:18px; align-items:stretch; }
      #techsteps-lifecycle-steps .tlc-card { --wipe:0%; position:relative; height:300px; min-width:0; box-sizing:border-box; isolation:isolate; overflow:hidden; border:1px solid #d7e7df; border-radius:20px; background:#fff; box-shadow:0 8px 24px rgba(11,39,31,.05); }
      #techsteps-lifecycle-steps .tlc-card-copy { position:absolute; inset:0; z-index:1; display:flex; flex-direction:column; justify-content:space-between; box-sizing:border-box; padding:18px 17px 0; overflow:hidden; }
      #techsteps-lifecycle-steps .tlc-copy-top { position:relative; z-index:3; flex:0 0 auto; }
      #techsteps-lifecycle-steps .tlc-step-badge { display:inline-flex; align-items:center; justify-content:center; min-width:56px; padding:7px 14px; border-radius:999px; background:#eaf5f0; color:#0e7152; font-size:20px; font-weight:800; line-height:1; }
      #techsteps-lifecycle-steps .tlc-card-copy h3 { margin:17px 0 0; color:#122544; font-size:clamp(17px,1.35vw,20px); font-weight:700; line-height:1.25; }
      #techsteps-lifecycle-steps .tlc-card-copy p { margin:12px 0 0; color:#55657f; font-size:clamp(13px,.97vw,14px); font-weight:400; line-height:1.53; }
      #techsteps-lifecycle-steps .tlc-card-copy--light { background:linear-gradient(180deg,#fff 0%,#fff 48%,#f4fcf8 100%); }
      #techsteps-lifecycle-steps .tlc-card-copy--light::before { content:''; position:absolute; top:-56px; right:-45px; width:146px; height:146px; border-radius:50%; background:radial-gradient(circle,rgba(216,243,231,.7) 0 61%,transparent 62%); pointer-events:none; }
      #techsteps-lifecycle-steps .tlc-card-copy--light::after { content:''; position:absolute; left:-18%; right:-18%; bottom:-18px; height:73px; border-radius:50% 50% 0 0/100% 100% 0 0; background:linear-gradient(180deg,rgba(218,245,233,.12),rgba(216,241,230,.6)); pointer-events:none; }
      #techsteps-lifecycle-steps .tlc-visual { position:relative; flex:0 0 129px; height:129px; width:100%; margin-top:5px; display:flex; align-items:center; justify-content:center; z-index:2; }
      #techsteps-lifecycle-steps .tlc-stage-icon { display:block; width:auto; height:100%; max-width:120px; object-fit:contain; object-position:center; }      
      /* Full-face cover sits ABOVE all text. The same --wipe value controls both clipping and light. */
      #techsteps-lifecycle-steps .tlc-cover { position:absolute; inset:0; z-index:5; overflow:hidden; background:#0A331E; clip-path:inset(0 0 0 var(--wipe)); }
      #techsteps-lifecycle-steps .tlc-cover img { display:block; width:100%; height:100%; object-fit:cover; }
      #techsteps-lifecycle-steps .tlc-cover-shade { position:absolute; inset:0; background:linear-gradient(180deg,transparent 55%,rgba(3,31,21,.62)); }
      #techsteps-lifecycle-steps .tlc-photo-number { position:absolute; bottom:19px; left:18px; font-weight:800; font-size:25px; color:#fff; text-shadow:0 2px 6px #123; }
      
      #techsteps-lifecycle-steps .tlc-spark { position:absolute; z-index:7; top:0; bottom:0; left:var(--wipe); width:3px; transform:translateX(-50%); opacity:0; pointer-events:none; background:linear-gradient(180deg,transparent 5%,#f3ffac 28%,#fff 50%,#bfff4c 72%,transparent 95%); box-shadow:0 0 12px 3px rgba(214,255,74,.8),0 0 28px 9px rgba(196,255,36,.35); }
      #techsteps-lifecycle-steps .tlc-card.is-revealing .tlc-spark { opacity:1; }
      #techsteps-lifecycle-steps .tlc-spark::before { content:''; position:absolute; width:60px; height:60px; left:50%; top:46%; transform:translate(-50%,-50%); background:radial-gradient(circle,#fff 0 8%,#f5ffbe 12%,rgba(214,255,96,.7) 25%,transparent 64%); filter:drop-shadow(0 0 10px #d5ff52); clip-path:polygon(50% 0,56% 39%,100% 50%,56% 58%,50% 100%,44% 58%,0 50%,44% 42%); }
      #techsteps-lifecycle-steps .tlc-spark::after { content:''; position:absolute; inset:6% -13px; background-image:radial-gradient(circle,#e9ff98 1px,transparent 2px),radial-gradient(circle,#fff 1px,transparent 2px); background-size:18px 27px,23px 32px; background-position:1px 1px,8px 12px; mask-image:linear-gradient(180deg,transparent,#000 16%,#000 84%,transparent); }
      #techsteps-lifecycle-steps .tlc-card.is-revealed .tlc-spark { display:none; }
      
      @media(max-width:1023px) { #techsteps-lifecycle-steps .tlc-grid { grid-template-columns:repeat(2,minmax(0,1fr)); } #techsteps-lifecycle-steps .tlc-card-copy h3 {font-size:19px;} #techsteps-lifecycle-steps .tlc-card-copy p {font-size:14px;} }
      @media(max-width:639px) { #techsteps-lifecycle-steps .tlc-grid {grid-template-columns:minmax(0,1fr);gap:15px;} #techsteps-lifecycle-steps .tlc-card {height:300px;} #techsteps-lifecycle-steps .tlc-visual {flex-basis:125px;height:125px;} }
      @media(prefers-reduced-motion:reduce) { #techsteps-lifecycle-steps .tlc-cover {clip-path:inset(0 0 0 100%) !important;} #techsteps-lifecycle-steps .tlc-spark {display:none !important;} }
    </style>

    <!-- Script for Animation -->
    <script is:inline>
      (() => {
        const init = () => {
          const section = document.getElementById('techsteps-lifecycle-steps');
          if (!section || section.dataset.sparkleReady === '1') return;
          const cards = [...section.querySelectorAll('.tlc-card')];
          if (cards.length !== 4) return;
          section.dataset.sparkleReady = '1';

          const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
          const revealDuration = 1650;
          const betweenCards = 300;
          const readingPause = 2600;
          const resetDuration = 550;
          const revealEnd = cards.length * revealDuration + (cards.length - 1) * betweenCards;
          const resetStart = revealEnd + readingPause;
          const cycleDuration = resetStart + resetDuration + 350;

          let frame = 0;
          let observer;
          let visible = false;
          let elapsed = 0;
          let previousFrameTime = null;
          let disposed = false;

          const setWipe = (card, percentage, revealing = false) => {
            card.style.setProperty('--wipe', `${percentage.toFixed(3)}%`);
            card.classList.toggle('is-revealing', revealing);
            card.classList.toggle('is-revealed', !revealing && percentage >= 100);
          };
          const revealAll = () => cards.forEach(card => setWipe(card, 100));
          const showImages = () => cards.forEach(card => setWipe(card, 0));

          const render = () => {
            if (elapsed < revealEnd) {
              cards.forEach((card, index) => {
                const position = (elapsed - index * (revealDuration + betweenCards)) / revealDuration;
                const progress = Math.min(1, Math.max(0, position));
                const eased = progress * progress * (3 - 2 * progress);
                setWipe(card, eased * 100, progress > 0 && progress < 1);
              });
            } else if (elapsed < resetStart) {
              revealAll();
            } else if (elapsed < resetStart + resetDuration) {
              const progress = (elapsed - resetStart) / resetDuration;
              const eased = progress * progress * (3 - 2 * progress);
              cards.forEach(card => setWipe(card, (1 - eased) * 100));
            } else {
              showImages();
            }
          };

          const stop = () => {
            cancelAnimationFrame(frame);
            frame = 0;
            previousFrameTime = null;
          };
          const tick = (now) => {
            if (disposed || !visible || document.hidden || reduced.matches) { stop(); return; }
            if (previousFrameTime !== null) elapsed += Math.min(now - previousFrameTime, 100);
            previousFrameTime = now;
            if (elapsed >= cycleDuration) elapsed %= cycleDuration;
            render();
            frame = requestAnimationFrame(tick);
          };
          const syncPlayback = () => {
            stop();
            if (reduced.matches) { revealAll(); return; }
            if (!visible || document.hidden) return;
            render();
            frame = requestAnimationFrame(tick);
          };

          showImages();
          observer = new IntersectionObserver(entries => {
            visible = entries[0]?.isIntersecting ?? false;
            syncPlayback();
          }, { threshold: 0.15 });
          observer.observe(section);
          const onVisibility = () => syncPlayback();
          const onMotion = () => {
            if (!reduced.matches) { elapsed = 0; showImages(); }
            syncPlayback();
          };
          document.addEventListener('visibilitychange', onVisibility);
          reduced.addEventListener('change', onMotion);
          const cleanup = () => {
            disposed = true;
            stop();
            observer.disconnect();
            document.removeEventListener('visibilitychange', onVisibility);
            reduced.removeEventListener('change', onMotion);
            section.removeAttribute('data-sparkleReady');
          };
          document.addEventListener('astro:before-swap', cleanup, { once: true });
        };
        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
        else init();
        document.addEventListener('astro:page-load', init);
      })();
    </script>
  </section>

