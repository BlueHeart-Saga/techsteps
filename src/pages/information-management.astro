---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import HeroDivision from '../components/hero/HeroDivision.astro';
import ServiceGrid from '../components/services/ServiceGrid.astro';
import BenefitsList from '../components/services/BenefitsList.astro';
import SectorGrid from '../components/sectors/SectorGrid.astro';
import { divisions, services, sectors } from '../lib/sanity/data';

const division = divisions.find((d) => d.slug === 'information-management')!;
const divisionServices = services.filter((s) => s.divisionSlug === division.slug);

const divisionBenefits = [
  'Full legal compliance with BS 4971, ISO 27001, and UK GDPR data preservation mandates',
  'Emergency 2-hour physical record recall or 1-hour Scan-on-Demand digital retrieval',
  'BS 10008 accredited digital scanning giving digital files complete legal court admissibility',
  'Advanced VESDA smoke detection and gaseous clean-agent fire suppression in all vaults',
  'Automated retention policy alerts preventing unnecessary physical archival costs',
  'Seamless API integration with corporate cloud DMS platforms including SharePoint and Box',
];
---

<BaseLayout
  title="Information Management UK | Document Storage, Scanning & Vaults | Techsteps"
  description="Techsteps Information Management division delivers climate-controlled archive storage, BS 10008 scanning, digital mailroom services, and high-security biometric vaulting."
>
  <HeroDivision division={division} serviceCount={divisionServices.length} />

  <!-- Division Introduction -->
  <Section theme="white">
    <Container>
      <div class="max-w-4xl mx-auto text-center space-y-6">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Enterprise Information Governance</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-navy tracking-tight">
          Protecting Your Vital Records Across Their Entire Lifecycle
        </h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed">
          From legacy paper deeds and fragile historical museum manuscripts to modern digital backup tapes and active daily mail, Techsteps provides accredited storage, rapid digitisation, and secure destruction under a single unified governance umbrella.
        </p>
      </div>
    </Container>
  </Section>

  <!-- Division Services -->
  <Section theme="slate" id="division-services">
    <Container>
      <div class="text-center max-w-3xl mx-auto space-y-4 mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Specialized Services</span>
        <h2 class="text-3xl font-extrabold text-brand-navy tracking-tight">
          {division.title} Solutions
        </h2>
        <p class="text-sm sm:text-base text-slate-600">
          Select a service below to review technical specifications, compliance standards, and SLAs.
        </p>
      </div>
      <ServiceGrid services={divisionServices} showDivision={false} />
    </Container>
  </Section>

  <!-- Benefits -->
  <Section theme="white">
    <Container>
      <BenefitsList benefits={divisionBenefits} title="Strategic Advantages of Our Information Management" />
    </Container>
  </Section>

  <!-- Relevant Sectors -->
  <Section theme="slate">
    <Container>
      <div class="text-center max-w-3xl mx-auto space-y-4 mb-12">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Sectors Served</span>
        <h2 class="text-3xl font-extrabold text-brand-navy tracking-tight">
          Industry Frameworks Aligned with Information Management
        </h2>
      </div>
      <SectorGrid sectors={sectors} />
    </Container>
  </Section>

  <!-- Final CTA -->
  <Section theme="navy">
    <Container className="text-center max-w-4xl mx-auto space-y-6">
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
        Modernize your corporate archive and information workflows
      </h2>
      <p class="text-base text-slate-300 max-w-2xl mx-auto">
        Speak with an information management specialist to arrange a site audit or request a competitive storage quotation.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a
          href="/request-a-quote"
          class="px-8 py-4 rounded-xl bg-brand-accent hover:bg-brand-accent-hover text-white text-base font-bold shadow-lg transition-all"
        >
          Request an Archiving Quote
        </a>
        <a
          href="/contact"
          class="px-8 py-4 rounded-xl bg-white/10 hover:bg-white/20 text-white text-base font-bold border border-white/20 transition-all"
        >
          Contact Archive Desk
        </a>
      </div>
    </Container>
  </Section>
</BaseLayout>
