---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import PageHero from '../components/hero/PageHero.astro';
import AccordionFaq from '../components/content/AccordionFaq.astro';
import { getDivisions, getServices, getSectors } from '../lib/sanity/client';

const [divisions, services, sectors] = await Promise.all([
  getDivisions(),
  getServices(),
  getSectors(),
]);

const division = divisions.find((d) => d.slug === 'it-lifecycle-services-destruction')!;
const divisionServices = services.filter((s) => s.divisionSlug === division.slug);

const clr = { accent: '#1B3A5C', dark: '#0f2238', light: '#EFF4FA' };

const breadcrumbs = [
  { name: 'Services', url: '/services' },
  { name: 'IT Lifecycle & Destruction', url: '/it-lifecycle-services-destruction' },
];

const lifecycleStages = [
  { id: 'collect', label: 'Collect', number: '01', desc: 'Secure, GPS-tracked collection of IT equipment from your organisation by BS 7858 security-vetted personnel.' },
  { id: 'secure', label: 'Secure', number: '02', desc: 'Controlled, serialised handling throughout the entire asset lifecycle with full chain of custody documentation.' },
  { id: 'sanitise', label: 'Sanitise', number: '03', desc: 'Data is securely removed or destroyed via ADISA-certified erasure, degaussing or physical destruction — appropriate to the asset.' },
  { id: 'reuse', label: 'Reuse', number: '04', desc: 'Suitable equipment is assessed for continued productive use through refurbishment, redeployment or remarketing.' },
  { id: 'recycle', label: 'Recycle', number: '05', desc: 'End-of-life equipment is responsibly processed through WEEE-compliant zero-landfill recycling streams.' },
  { id: 'report', label: 'Report', number: '06', desc: 'Serialised certificates, full audit trails and ESG reporting provide complete lifecycle visibility and accountability.' },
];

const sectorLinks = [
  { title: 'Defence', slug: 'defence' },
  { title: 'NHS & Healthcare', slug: 'nhs' },
  { title: 'Financial Services', slug: 'finance' },
  { title: 'Central Government', slug: 'central-government' },
];

const faqs = [
  { question: 'What is IT asset lifecycle management?', answer: 'IT asset lifecycle management covers the full journey of a technology asset — from collection through data sanitisation, reuse or remarketing, recycling and final disposal — with the aim of maximising value recovery, protecting data and achieving responsible environmental outcomes.' },
  { question: 'What happens to our IT equipment after collection?', answer: 'Following secure collection, each asset is audited, data-sanitised and assessed. Equipment suitable for continued use is refurbished or remarketed. Assets at end of life are responsibly recycled through WEEE-compliant streams. You receive a full report for every asset.' },
  { question: 'Can data be securely removed before equipment is recycled?', answer: 'Yes. We use ADISA-certified data erasure, degaussing and physical hard drive destruction depending on the security requirement of the asset. Every data sanitisation event is certificated.' },
  { question: 'What happens to equipment that cannot be reused?', answer: 'Assets that cannot be reused are processed through WEEE-compliant zero-landfill recycling channels. No equipment is sent to landfill.' },
];
---

<BaseLayout
  title="IT Lifecycle Services & Destruction | Secure ITAD & Recycling | Techsteps UK"
  description="ADISA certified IT asset lifecycle, secure data destruction, remarketing and zero-landfill recycling. UK-wide IT lifecycle services from Techsteps."
  hasHeroHeader={true}
>
  <!-- ===== 1. HERO (Simple & Clean, ref: /sustainability) ===== -->
  <PageHero
    eyebrow="IT LIFECYCLE & DESTRUCTION"
    title="A Smarter Lifecycle for Every IT Asset."
    subheading="Secure collection, ADISA-certified data sanitisation, remarketing and zero-landfill recycling."
    bgImage="/images/services/remarketing.jpg"
    breadcrumbs={breadcrumbs}
    dividerColor="#1B3A5C"
  >
    <div class="pt-4 flex flex-wrap items-center justify-center gap-4">
      <a
        href="#asset-journey"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-[#1B3A5C] hover:bg-[#142d4a] text-white text-sm font-bold shadow-lg transition-all duration-200"
      >
        Explore the Journey
        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
        </svg>
      </a>
      <a
        href="/request-a-quote?service=it-lifecycle"
        class="inline-flex items-center gap-2 px-6 py-3.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-sm font-bold border border-white/20 transition-all duration-200"
      >
        Get a Quote
      </a>
    </div>
  </PageHero>

  <!-- ===== LIFECYCLE JOURNEY ===== -->
  <section id="asset-journey" class="bg-[#1B3A5C] py-16 lg:py-20">
    <Container>
      <div class="text-center mb-12">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-blue-300 mb-4">The Asset Journey</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Every Asset. A Smarter Journey.</h2>
        <p class="mt-3 text-sm text-blue-100/60 max-w-lg mx-auto">Click any stage to learn more.</p>
      </div>
      <div class="max-w-4xl mx-auto" id="lifecycle-nav">
        <div class="grid grid-cols-3 sm:grid-cols-6 gap-2 mb-6">
          {lifecycleStages.map((stage, i) => (
            <button type="button" data-stage={stage.id} class={`lifecycle-tab group flex flex-col items-center gap-2 p-3 rounded-xl border transition-all duration-200 cursor-pointer ${i === 0 ? 'bg-white/20 border-white/50 shadow-lg' : 'bg-white/5 border-white/15 hover:bg-white/15'}`}>
              <span class={`text-[10px] font-bold uppercase tracking-widest ${i === 0 ? 'text-blue-200' : 'text-blue-300/50 group-hover:text-blue-200'}`}>{stage.number}</span>
              <span class={`text-xs font-extrabold uppercase tracking-wider ${i === 0 ? 'text-white' : 'text-white/60 group-hover:text-white'}`}>{stage.label}</span>
            </button>
          ))}
        </div>
        <div class="bg-white/10 rounded-2xl border border-white/20 p-6 min-h-[90px]">
          {lifecycleStages.map((stage, i) => (
            <div data-stage-desc={stage.id} class={i === 0 ? 'block' : 'hidden'}>
              <p class="text-[10px] font-bold uppercase tracking-widest text-blue-300 mb-2">{stage.number} / {stage.label}</p>
              <p class="text-base text-white leading-relaxed">{stage.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== SERVICES GRID ===== -->
  <section class="py-14 lg:py-20 scroll-mt-20" style={`background: ${clr.light};`} id="division-services">
    <Container>
      <div class="text-center mb-10">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#1B3A5C] mb-4">Our Services</span>
        <h2 class="text-3xl font-extrabold text-slate-900 tracking-tight">IT Lifecycle Services</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
        {divisionServices.map(service => (
          <a href={`/services/${service.slug}`} class="group bg-white rounded-2xl p-6 border border-slate-200/80 hover:border-[#1B3A5C]/40 hover:shadow-xl transition-all duration-300 flex flex-col relative overflow-hidden">
            <div class="absolute top-0 left-0 right-0 h-0.5 bg-[#1B3A5C] opacity-0 group-hover:opacity-100 transition-opacity rounded-t-2xl"></div>
            <h3 class="text-sm font-bold text-slate-900 group-hover:text-[#1B3A5C] transition-colors leading-snug mb-2">{service.title}</h3>
            <p class="text-xs text-slate-500 leading-relaxed line-clamp-3 flex-1">{service.summary}</p>
            <div class="mt-5 pt-4 border-t border-slate-100 flex items-center justify-end">
              <span class="flex items-center gap-1 text-xs font-bold text-[#1B3A5C] group-hover:gap-2 transition-all">
                Explore <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
              </span>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== SECTORS ===== -->
  <section class="bg-white py-14 lg:py-16 border-t border-slate-100">
    <Container>
      <div class="text-center mb-10">
        <span class="inline-block text-[11px] font-bold tracking-[0.2em] uppercase text-[#1B3A5C] mb-4">Sector Expertise</span>
        <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Built for Organisations Where Security Matters</h2>
      </div>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 max-w-3xl mx-auto">
        {sectorLinks.map(s => (
          <a href={`/sectors/${s.slug}`} class="group bg-[#EFF4FA] rounded-2xl px-5 py-5 border border-slate-200 hover:border-[#1B3A5C]/40 hover:shadow-md transition-all text-center">
            <p class="text-sm font-bold text-slate-900 group-hover:text-[#1B3A5C] transition-colors">{s.title}</p>
            <p class="mt-1 text-[10px] text-[#1B3A5C] font-bold">Explore →</p>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- ===== FAQ ===== -->
  <section class="py-14 lg:py-16 border-t border-slate-200" style={`background: ${clr.light};`}>
    <Container>
      <AccordionFaq faqs={faqs} title="IT Lifecycle Questions" subtitle="Common questions about our IT asset lifecycle and disposition services." />
    </Container>
  </section>

  <!-- ===== CTA (Clean Open Layout - No Background Box) ===== -->
  <section class="relative z-10 py-16 lg:py-24 overflow-hidden">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 rounded-full blur-3xl pointer-events-none opacity-15" style={`background: ${clr.accent};`}></div>
    <Container className="relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <span class="inline-block text-xs sm:text-sm font-bold tracking-[0.2em] uppercase mb-4" style={`color: ${clr.accent};`}>Get Started</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-slate-900 mb-5 leading-tight tracking-tight">Ready to Manage Your IT Assets More Responsibly?</h2>
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-10 max-w-xl mx-auto font-medium">Speak with our team to arrange a collection, request an audit or obtain a formal proposal.</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="/request-a-quote" class="px-8 py-4 rounded-xl font-bold text-sm uppercase tracking-wider bg-[#1B3A5C] hover:bg-[#142d4a] text-white shadow-lg hover:shadow-xl transition-all duration-200 transform hover:-translate-y-0.5">Get a Quote →</a>
          <a href="/contact" class="px-8 py-4 rounded-xl bg-white hover:bg-slate-50 border border-slate-300 text-slate-900 font-bold text-sm uppercase tracking-wider transition-all duration-200 shadow-xs hover:shadow-md transform hover:-translate-y-0.5">Contact Techsteps</a>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

<script is:inline>
  (() => {
    const nav = document.getElementById('lifecycle-nav');
    if (!nav) return;
    const tabs = nav.querySelectorAll('.lifecycle-tab');
    const descs = nav.querySelectorAll('[data-stage-desc]');
    tabs.forEach(tab => {
      tab.addEventListener('click', () => {
        const id = tab.getAttribute('data-stage');
        tabs.forEach(t => { t.classList.remove('bg-white/20','border-white/50','shadow-lg'); t.classList.add('bg-white/5','border-white/15'); });
        tab.classList.add('bg-white/20','border-white/50','shadow-lg'); tab.classList.remove('bg-white/5','border-white/15');
        descs.forEach(d => { d.classList.toggle('hidden', d.getAttribute('data-stage-desc') !== id); d.classList.toggle('block', d.getAttribute('data-stage-desc') === id); });
      });
    });
  })();
</script>
