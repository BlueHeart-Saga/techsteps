---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import PageHero from '../components/hero/PageHero.astro';
import AccordionFaq from '../components/content/AccordionFaq.astro';
import ServicesCardGrid from '../components/services/ServicesCardGrid.astro';
import CTA from '../components/global/cta.astro';
import { getDivisions, getServices, getSectors } from '../lib/sanity/client';

const breadcrumbs = [
  { name: 'Services', url: '/services' },
  { name: 'IT Lifecycle & Destruction', url: '/it-lifecycle-services-destruction' },
];

const [divisions, services, sectors] = await Promise.all([
  getDivisions(),
  getServices(),
  getSectors(),
]);

const division = divisions.find((d) => d.slug === 'it-lifecycle-services-destruction')!;
const divisionServices = services.filter((s) => s.divisionSlug === division.slug);

const clr = { accent: '#0F623A', dark: '#0A331E', light: '#F2F8F5' };

const sectorLinks = [
  { title: 'Defence', slug: 'defence' },
  { title: 'NHS & Healthcare', slug: 'nhs' },
  { title: 'Financial Services', slug: 'finance' },
  { title: 'Central Government', slug: 'central-government' },
];

const defaultFaqs = [
  { question: 'What is IT asset lifecycle management?', answer: 'IT asset lifecycle management covers the full journey of a technology asset — from collection through data sanitisation, reuse or remarketing, recycling and final disposal — with the aim of maximising value recovery, protecting data and achieving responsible environmental outcomes.' },
  { question: 'What happens to our IT equipment after collection?', answer: 'Following secure collection, each asset is audited, data-sanitised and assessed. Equipment suitable for continued use is refurbished or remarketed. Assets at end of life are responsibly recycled through WEEE-compliant streams. You receive a full report for every asset.' },
  { question: 'Can data be securely removed before equipment is recycled?', answer: 'Yes. We use ADISA-certified data erasure, degaussing and physical hard drive destruction depending on the security requirement of the asset. Every data sanitisation event is certificated.' },
  { question: 'What happens to equipment that cannot be reused?', answer: 'Assets that cannot be reused are processed through WEEE-compliant zero-landfill recycling channels. No equipment is sent to landfill.' },
];
const faqs = (division?.faqs && division.faqs.length > 0) ? division.faqs : defaultFaqs;
---

<BaseLayout
  title={division?.metaTitle || "IT Lifecycle Services & Destruction | Secure ITAD & Certified Recycling | Techsteps"}
  description={division?.metaDescription || "ADISA-certified IT asset disposition, secure collection, data sanitisation, remarketing, and zero-landfill electronic recycling. UK-wide from Techsteps."}
  hasHeroHeader={true}
>
  <!-- ===== 1. HERO ===== -->
  <PageHero
    bgImage={division?.heroImage || "/images/hero/IT Lifecycle & Destruction.webp"}
    bgAlt="IT Lifecycle & Destruction Services UK - TechSteps"
    breadcrumbs={[]}
    layout="custom"
    showDivider={true}
    dividerColor="#ffffff"
    minHeight="min-h-[540px] sm:min-h-[580px] lg:min-h-[640px]"
    noOverlay={true}
    theme="light"
    contained={true}
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-10 items-center">
      <!-- HERO CONTENT (Left) -->
      <div class="lg:col-span-6 xl:col-span-6 max-w-2xl lg:max-w-none pt-2 sm:pt-4 z-10">

        <!-- Breadcrumb Navigation -->
        <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-2 text-xs sm:text-sm font-sans font-semibold text-slate-600 mb-3 sm:mb-4">
          <a href="/services" class="text-slate-700 hover:text-[#0F623A] transition-colors underline-offset-4 hover:underline">
            Services
          </a>
          <span class="text-[#0F623A] font-bold" aria-hidden="true">›</span>
          <span class="text-slate-900 font-bold">IT Lifecycle & Destruction</span>
        </nav>

        <!-- Heading -->
        <h1
          class="font-display
                 text-3xl sm:text-4xl md:text-5xl lg:text-[50px] xl:text-[56px]
                 font-semibold
                 text-slate-900
                 tracking-normal
                 leading-[1.12] sm:leading-[1.1]
                 max-w-xl"
        >
          {division?.heroTitle || 'IT Lifecycle & Destruction Services UK'}
        </h1>

        <!-- Description -->
        <p
          class="mt-4 sm:mt-5
                 text-lg sm:text-xl lg:text-lg
                 text-black
                 max-w-lg
                 leading-relaxed
                 font-sans font-normal"
        >
          {division?.heroDescription || 'Secure, accredited IT asset disposition (ITAD), verified data erasure, hardware remarketing, and circular zero-landfill electronic recycling for UK enterprise.'}
        </p>

        <!-- CTA Button -->
        <div
          class="mt-6 sm:mt-8
                 flex flex-wrap
                 items-center
                 gap-3.5 sm:gap-4"
        >
          <a
            href={division?.heroCtaLink || '/request-a-collection?service=it-lifecycle'}
            class="inline-flex items-center justify-center
                   gap-2.5
                   px-6 sm:px-7
                   py-3 sm:py-3.5
                   rounded-none
                   bg-[#0F623A] hover:bg-[#0c4e2e]
                   text-white
                   text-sm sm:text-base
                   font-bold
                   shadow-md hover:shadow-lg
                   transition-all duration-200
                   hover:scale-[1.02]
                   focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
          >
            <span>{division?.heroCtaText || 'Request a Collection'}</span>
            <svg
              class="w-4 h-4 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>
        </div>

      </div>

      <!-- HERO SPACER (Right on Desktop) -->
      <div class="hidden lg:flex lg:col-span-6 xl:col-span-6 items-center justify-end min-h-[420px] lg:min-h-[480px] xl:min-h-[520px] pointer-events-none" aria-hidden="true">
      </div>
    </div>
  </PageHero>

  <!-- ===== 2. INTRODUCTION TO IT LIFECYCLE SERVICES ===== -->
  <section class="bg-white py-8 lg:py-12 border-b border-slate-200/80 relative overflow-hidden">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
        <!-- Left Side: Introduction Content -->
        <div class="lg:col-span-7 space-y-6">
          {/*<div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/20 text-[#0F623A] text-xs font-bold uppercase tracking-widest font-mono">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
            {division?.aboutBadge || 'About Our Service'}
          </div>*/}

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display leading-[1.12]">
            {division?.aboutTitle || 'Sustainable, Secure IT Asset Management for Modern Enterprise'}
          </h2>

          <div class="space-y-4 text-lg sm:text-xl text-black leading-relaxed font-sans font-normal text-justify">
            {(division?.aboutParagraphs && division.aboutParagraphs.length > 0) ? (
              division.aboutParagraphs.map((paragraph) => (
                <p>{paragraph}</p>
              ))
            ) : (
              <>
                <p>
                  As enterprise technology rapidly evolves, organisations accumulate redundant workstations, servers, mobile devices, and data storage arrays. IT lifecycle management ensures every retired asset is handled with absolute security, audited transparency, and environmental accountability — protecting your sensitive data while driving sustainable circular economy outcomes.
                </p>
                <p>
                  From BS 7858 vetted collection in GPS-tracked vehicles to ADISA-certified data sanitisation and certified WEEE recycling, Techsteps provides an unbroken chain of custody. We maximise residual asset value through expert refurbishment and remarketing, while guaranteeing zero electronic waste reaches landfill.
                </p>
              </>
            )}
          </div>

          <div class="pt-2">
            <a
              href="/services"
              class="inline-flex items-center gap-2 text-[#0F623A] hover:text-[#0A331E] font-bold text-sm sm:text-base transition-colors group"
            >
              <span>See our four service groups</span>
              <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </a>
          </div>
        </div>

        <!-- Right Side: Service Graphic -->
        <div class="lg:col-span-5 relative flex items-center justify-center">
          <img
            src="/images/services/About our services 2.webp"
            alt="Techsteps IT Lifecycle and Hardware Disposition Specialists"
            class="w-full max-w-[420px] lg:max-w-[460px] h-auto object-contain mx-auto select-none drop-shadow-md hover:scale-[1.02] transition-transform duration-300"
            loading="lazy"
            decoding="async"
          />
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== 2.5 SERVICES / CORE DIVISIONS ===== -->
  <ServicesCardGrid />


  <!-- ===== WHY PROACTIVE IT LIFECYCLE MATTERS (GREEN THEME) ===== -->
  <section class="bg-[#0A331E] py-8 sm:py-10 lg:py-12 border-b border-emerald-900/50 relative overflow-hidden">
    <div class="absolute inset-0 bg-radial-[ellipse_at_top_right] from-emerald-500/10 via-transparent to-transparent pointer-events-none"></div>
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
        <!-- Left Column: Title & Intro -->
        <div class="lg:col-span-5 space-y-5">
          {/*<div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-xs font-mono font-medium uppercase tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
            Strategic Value
          </div>*/}

          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-white tracking-tight font-display leading-[1.12]">
            Why Proactive IT Lifecycle Management Matters
          </h2>

          <p class="text-base sm:text-lg text-emerald-100/80 leading-relaxed font-normal">
            Mitigate data exposure, recover capital value, and meet stringent circular economy standards.
          </p>
        </div>

        <!-- Right Column: 2x2 Pillar Grid with Top Dividers -->
        <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-x-10 gap-y-10 lg:gap-y-12">
          <!-- Pillar 1: Eliminate Data Breach Risks -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-lg bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              Eliminate Data Breach Risks
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              ADISA-certified sanitisation ensures sensitive corporate data is permanently destroyed.
            </p>
          </div>

          <!-- Pillar 2: Recover Asset Value -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-lg bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 7v5l3 3" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              Recover Maximum Asset Value
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              Expert refurbishment and global remarketing return residual revenue to your organisation.
            </p>
          </div>

          <!-- Pillar 3: Zero-Landfill Recycling -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-lg bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              Zero-Landfill Circular Economy
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              100% compliant WEEE recycling ensures obsolete hardware is refined into secondary commodities.
            </p>
          </div>

          <!-- Pillar 4: Complete ESG Compliance -->
          <div class="pt-6 border-t border-emerald-500/30 space-y-3">
            <div class="w-9 h-9 rounded-lg bg-emerald-500/20 border border-emerald-400/30 flex items-center justify-center text-emerald-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 class="text-lg sm:text-xl font-semibold text-white tracking-tight leading-snug">
              Auditable ESG Compliance
            </h3>
            <p class="text-sm text-emerald-100/75 leading-relaxed font-normal">
              Detailed serialised asset reporting and certified destruction simplify regulatory disclosures.
            </p>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== OUR IT LIFECYCLE PROCESS (WORKFLOW) ===== -->
  <section class="bg-white py-8 sm:py-10 lg:py-12 border-b border-slate-200/80 relative overflow-hidden">
    <Container>
      <div class="relative z-10">
        <!-- Section Header -->
        <div class="max-w-3xl mb-12 sm:mb-16">
          {/*<div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-[#0F623A]/10 border border-[#0F623A]/20 text-[#0F623A] text-xs font-mono font-medium uppercase tracking-wider mb-4">
            <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
            Workflow & Execution
          </div>*/}
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-slate-900 tracking-tight font-display">
            Our IT Lifecycle & Disposition Process
          </h2>
          <p class="mt-3 text-lg sm:text-xl text-black font-normal">
            A structured, secure end-to-end framework to collect, audit, sanitise and remarket or recycle technology assets.
          </p>
        </div>

        <!-- 4-Step Process Flow -->
        <div class="relative">
          <!-- Continuous connecting line on large screens -->
          <div class="hidden lg:block absolute top-[21px] left-6 right-20 h-[2px] bg-slate-200 -z-0"></div>

          <!-- Steps Grid -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-8 relative z-10">
            <!-- Step 1 -->
            <div class="flex flex-col group">
              <div class="mb-5 flex items-center">
                <div class="w-11 h-11 rounded-lg bg-[#0F623A] text-white font-mono font-bold text-sm flex items-center justify-center shadow-lg shadow-[#0F623A]/20 ring-4 ring-white flex-shrink-0 transition-transform duration-300 group-hover:scale-110">
                  01
                </div>
              </div>
              <h3 class="text-lg sm:text-xl font-semibold text-slate-900 tracking-tight leading-snug group-hover:text-[#0F623A] transition-colors">
                Collect & Secure
              </h3>
              <p class="mt-2.5 text-sm sm:text-base text-black leading-relaxed font-normal">
                GPS-tracked vehicles and vetted personnel collect hardware with full chain of custody.
              </p>
            </div>

            <!-- Step 2 -->
            <div class="flex flex-col group">
              <div class="mb-5 flex items-center">
                <div class="w-11 h-11 rounded-lg bg-[#0F623A] text-white font-mono font-bold text-sm flex items-center justify-center shadow-lg shadow-[#0F623A]/20 ring-4 ring-white flex-shrink-0 transition-transform duration-300 group-hover:scale-110">
                  02
                </div>
              </div>
              <h3 class="text-lg sm:text-xl font-semibold text-slate-900 tracking-tight leading-snug group-hover:text-[#0F623A] transition-colors">
                Audit & Ingest
              </h3>
              <p class="mt-2.5 text-sm sm:text-base text-black leading-relaxed font-normal">
                Every unit is barcoded, scanned, and logged by serial number into our secure portal.
              </p>
            </div>

            <!-- Step 3 -->
            <div class="flex flex-col group">
              <div class="mb-5 flex items-center">
                <div class="w-11 h-11 rounded-lg bg-[#0F623A] text-white font-mono font-bold text-sm flex items-center justify-center shadow-lg shadow-[#0F623A]/20 ring-4 ring-white flex-shrink-0 transition-transform duration-300 group-hover:scale-110">
                  03
                </div>
              </div>
              <h3 class="text-lg sm:text-xl font-semibold text-slate-900 tracking-tight leading-snug group-hover:text-[#0F623A] transition-colors">
                Sanitise & Grade
              </h3>
              <p class="mt-2.5 text-sm sm:text-base text-black leading-relaxed font-normal">
                ADISA-certified data sanitisation and comprehensive hardware functionality grading.
              </p>
            </div>

            <!-- Step 4 -->
            <div class="flex flex-col group">
              <div class="mb-5 flex items-center">
                <div class="w-11 h-11 rounded-lg bg-[#0F623A] text-white font-mono font-bold text-sm flex items-center justify-center shadow-lg shadow-[#0F623A]/20 ring-4 ring-white flex-shrink-0 transition-transform duration-300 group-hover:scale-110">
                  04
                </div>
              </div>
              <h3 class="text-lg sm:text-xl font-semibold text-slate-900 tracking-tight leading-snug group-hover:text-[#0F623A] transition-colors">
                Remarket or Recycle
              </h3>
              <p class="mt-2.5 text-sm sm:text-base text-black leading-relaxed font-normal">
                Recover value through refurbishment or process end-of-life items via zero-landfill WEEE streams.
              </p>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- ===== ONE PARTNER FOR ASSET DISPOSITION & DATA SECURITY ===== -->
  <section id="it-services" class="bg-white text-[#0A331E] py-8 sm:py-10 lg:py-12 border-b border-slate-200 relative overflow-hidden scroll-mt-20">
    <div class="absolute inset-0 bg-radial-[ellipse_at_top] from-emerald-50/60 via-transparent to-transparent pointer-events-none"></div>
    <Container>
      <!-- Section Heading -->
      <div class="max-w-3xl mb-12 sm:mb-16">
        {/*<div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-emerald-50 border border-emerald-300 text-[#0F623A] text-xs font-mono font-medium uppercase tracking-wider mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0F623A]"></span>
          Integrated Hardware Management
        </div>*/}
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold text-[#0A331E] tracking-tight font-display leading-tight">
          One Partner for ITAD, Data Erasure & Circular Recycling
        </h2>
      </div>

      <!-- Split Card Container -->
      <div class="max-w-5xl mx-auto relative">
        <div class="grid grid-cols-1 md:grid-cols-2 rounded-3xl overflow-hidden shadow-2xl relative border border-emerald-500/20">
          
          <!-- Left Column: Asset Disposition & ITAM (Techsteps Green #0F623A) -->
          <div class="bg-[#0F623A] text-white p-8 sm:p-10 lg:p-12 flex flex-col justify-between">
            <div>
              <h3 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight font-display mb-6 pb-2 border-b border-white/20">
                Asset Disposition & ITAM
              </h3>
              <div class="space-y-1 font-sans">
                <a
                  href="/services/secure-it-disposal"
                  class="flex items-center justify-between py-3.5 border-b border-white/15 font-semibold text-white text-base sm:text-lg hover:translate-x-1.5 hover:text-emerald-200 transition-all duration-200 group"
                >
                  <span class="group-hover:underline">Secure IT Disposal</span>
                  <svg class="w-5 h-5 transition-transform group-hover:translate-x-1 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
                <a
                  href="/services/secure-collection-services"
                  class="flex items-center justify-between py-3.5 border-b border-white/15 font-semibold text-white text-base sm:text-lg hover:translate-x-1.5 hover:text-emerald-200 transition-all duration-200 group"
                >
                  <span class="group-hover:underline">Secure Collection Services</span>
                  <svg class="w-5 h-5 transition-transform group-hover:translate-x-1 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
                <a
                  href="/services/it-asset-disposition-services"
                  class="flex items-center justify-between py-3.5 border-b border-white/15 font-semibold text-white text-base sm:text-lg hover:translate-x-1.5 hover:text-emerald-200 transition-all duration-200 group"
                >
                  <span class="group-hover:underline">IT Asset Disposition (ITAD)</span>
                  <svg class="w-5 h-5 transition-transform group-hover:translate-x-1 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
                <a
                  href="/services/it-asset-management-services"
                  class="flex items-center justify-between py-3.5 border-b border-white/15 font-semibold text-white text-base sm:text-lg hover:translate-x-1.5 hover:text-emerald-200 transition-all duration-200 group"
                >
                  <span class="group-hover:underline">IT Asset Management (ITAM)</span>
                  <svg class="w-5 h-5 transition-transform group-hover:translate-x-1 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              </div>
            </div>
          </div>

          <!-- Center "One Partner" Badge (Desktop) -->
          <div class="hidden md:flex absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-16 h-16 rounded-full bg-white text-[#0F623A] border-4 border-[#0A331E] shadow-2xl items-center justify-center text-center font-bold text-[11px] leading-tight z-20 select-none">
            <span>One<br />partner</span>
          </div>

          <!-- Right Column: Sanitisation & Circular Economy (Deep Forest Green #062615) -->
          <div class="bg-[#062615] text-white p-8 sm:p-10 lg:p-12 flex flex-col justify-between">
            <div>
              <h3 class="text-2xl sm:text-3xl font-semibold text-white tracking-tight font-display mb-6 pb-2 border-b border-white/20">
                Sanitisation & Circular Value
              </h3>
              <div class="space-y-1 font-sans">
                <a
                  href="/services/ultra-secure-hard-drive-destruction"
                  class="flex items-center justify-between py-3.5 border-b border-white/20 font-semibold text-white text-base sm:text-lg hover:translate-x-1.5 hover:text-emerald-300 transition-all duration-200 group"
