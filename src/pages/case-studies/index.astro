---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import Section from '../../components/layout/Section.astro';
import Breadcrumbs from '../../components/seo/Breadcrumbs.astro';
import { caseStudies } from '../../lib/sanity/data';

const breadcrumbs = [
  { name: 'Case Studies', url: '/case-studies' },
];
---

<BaseLayout
  title="Case Studies & Client Outcomes | Real-World ITAD & Digitization | Techsteps UK"
  description="Review verified outcomes from Techsteps client engagements across banking, healthcare, and enterprise data centre relocations."
>
  <div class="bg-brand-navy text-white py-16">
    <Container>
      <Breadcrumbs items={breadcrumbs} theme="dark" />
      <div class="max-w-4xl space-y-4 mt-6">
        <span class="text-xs font-bold uppercase tracking-wider text-brand-accent">Client Results</span>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight">
          Verified Case Studies
        </h1>
        <p class="text-base sm:text-lg text-slate-300">
          Explore how Techsteps resolves high-stakes compliance, data sanitisation, and migration challenges for enterprise and public sector organisations.
        </p>
      </div>
    </Container>
  </div>

  <Section theme="white">
    <Container>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {caseStudies.map((cs) => (
          <div class="group flex flex-col bg-white rounded-2xl border border-slate-200 shadow-xs hover:shadow-xl hover:border-brand-accent/50 transition-all duration-300 overflow-hidden">
            <div class="h-44 relative bg-gradient-to-br from-brand-navy to-slate-900 p-6 flex flex-col justify-between">
              <span class="px-2.5 py-1 rounded-md bg-white/10 backdrop-blur-md text-emerald-300 text-[11px] font-bold w-fit">
                {cs.clientIndustry}
              </span>
              <span class="text-xs font-mono text-slate-400">Completed &bull; {cs.publishedAt}</span>
            </div>

            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-3">
                <h2 class="text-xl font-bold text-brand-navy group-hover:text-brand-accent transition-colors">
                  <a href={`/case-studies/${cs.slug}`}>{cs.title}</a>
                </h2>
                <p class="text-sm text-slate-600 line-clamp-3 leading-relaxed">
                  {cs.challenge}
                </p>
              </div>

              <!-- Top Results Preview -->
              <div class="space-y-1.5 pt-2 border-t border-slate-100 text-xs text-slate-700">
                {cs.results.slice(0, 2).map((res) => (
                  <div class="flex items-center gap-2">
                    <span class="text-emerald-600 font-bold">✓</span>
                    <span class="truncate">{res}</span>
                  </div>
                ))}
              </div>

              <div class="pt-2">
                <a
                  href={`/case-studies/${cs.slug}`}
                  class="text-xs font-bold text-brand-blue group-hover:text-brand-accent flex items-center gap-1"
                >
                  <span>Read Full Outcome Breakdown</span>
                  <span>&rarr;</span>
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </Section>
</BaseLayout>
