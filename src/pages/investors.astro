  <script>
    function setupInvestorStatsCounter() {
      const statsContainer = document.getElementById("investor-stats-card");
      if (!statsContainer) return;

      const numSpans = statsContainer.querySelectorAll(".investor-stat-num");
      if (numSpans.length === 0) return;

      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        numSpans.forEach((span) => {
          span.textContent = span.getAttribute("data-target") || "0";
        });
        return;
      }

      if (statsContainer._statsObserver) {
        statsContainer._statsObserver.disconnect();
        statsContainer._statsObserver = null;
      }

      let animFrameId = null;

      const resetNumbers = () => {
        if (animFrameId) {
          cancelAnimationFrame(animFrameId);
          animFrameId = null;
        }
        numSpans.forEach((span) => {
          span.textContent = "0";
        });
      };

      const runAnimation = () => {
        if (animFrameId) {
          cancelAnimationFrame(animFrameId);
          animFrameId = null;
        }

        const duration = 1800;
        const startTime = performance.now();

        const update = (currentTime) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easeProgress = 1 - Math.pow(1 - progress, 3);

          numSpans.forEach((span) => {
            const target = parseInt(span.getAttribute("data-target") || "0", 10);
            const currentVal = Math.floor(easeProgress * target);
            span.textContent = progress >= 1 ? target.toString() : currentVal.toString();
          });

          if (progress < 1) {
            animFrameId = requestAnimationFrame(update);
          } else {
            animFrameId = null;
          }
        };

        animFrameId = requestAnimationFrame(update);
      };

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                runAnimation();
              } else {
                resetNumbers();
              }
            });
          },
          { threshold: 0.15 }
        );
        observer.observe(statsContainer);
        statsContainer._statsObserver = observer;
      } else {
        runAnimation();
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupInvestorStatsCounter);
    } else {
      setupInvestorStatsCounter();
    }

    document.addEventListener("astro:page-load", setupInvestorStatsCounter);

(() => {
    const init = () => {
      const grid = document.getElementById('biz-interactive-grid');
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll('.biz-card'));

      cards.forEach((card) => {
        card.addEventListener('click', (e) => {
          if (e.target.closest('.biz-cta-link')) return; // the Explore link navigates directly
          const isTouch = window.matchMedia('(pointer: coarse)').matches || window.innerWidth < 1024;
          if (!isTouch) return;

          const wasActive = card.classList.contains('is-active');
          cards.forEach((c) => c !== card && c.classList.remove('is-active'));

          if (!wasActive) {
            e.preventDefault();
            card.classList.add('is-active');            // first tap reveals the details
          } else {
            const link = card.querySelector('.biz-cta-link');
            if (link?.href) window.location.href = link.href; // second tap opens the page
          }
        });
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('.biz-card')) cards.forEach((c) => c.classList.remove('is-active'));
      });
    };

    if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
    else init();
    document.addEventListener('astro:page-load', init);
  })();
  </script>
