---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import PageHero from '../components/hero/PageHero.astro';
import { siteSettings } from '../lib/sanity/data';

const breadcrumbs = [
  { name: 'Investors', url: '/investors' },
];

const investorStats = [
  {
    prefix: '+',
    value: '25',
    suffix: 'M',
    title: 'Items in Storage',
    desc: 'Secure barcoded documents and magnetic media under active vault management',
  },
  {
    prefix: '+',
    value: '238',
    suffix: 'M',
    title: 'Images Scanned',
    desc: 'High-speed OCR-indexed digital records produced for UK public and private enterprises',
  },
  {
    prefix: '+',
    value: '500',
    suffix: 'K',
    title: 'Desktops Moved',
    desc: 'Complex workplace hardware relocations and mission-critical data centre migrations',
  },
  {
    prefix: '+',
    value: '52',
    suffix: 'K',
    title: 'Tonnes Shredded',
    desc: 'Confidential paper and electronic media securely destroyed with zero landfill waste',
  },
];

const strategicPillars = [
  {
    number: '01',
    title: 'Market Leader',
    headline: 'Defensible Market Moats & Trusted Brand Positioning',
    desc: 'Techsteps plc leads its markets, serving public & private sectors with essential services.',
    detail: 'From high-density document archival to ADISA-accredited IT asset disposition, our compliance credentials (ISO 27001, BS EN 15713, DIN 66399) create deep operational barriers against low-end freight commoditisation.',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.504-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.003 0V11.25a2.25 2.25 0 00-2.25-2.25h-1.5a2.25 2.25 0 00-2.25 2.25v3m6.003 0a2.25 2.25 0 00-2.25-2.25H9.75a2.25 2.25 0 00-2.25 2.25" />`,
  },
  {
    number: '02',
    title: 'Predictable Income',
    headline: 'Contracted Recurring Revenues & Robust Free Cash Flow',
    desc: 'Our income is predictable, recurring, and generates strong cashflows.',
    detail: 'Long-term enterprise contracts spanning scheduled office shredding consoles, rotational archive vaults, and continuous IT hardware refresh programs deliver high client retention rates and resilient operating cash generation.',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />`,
  },
  {
    number: '03',
    title: 'Sustainable Growth',
    headline: 'Margin Enhancement, Circular Economics & ESG Leadership',
    desc: 'Our strategy focuses on margin enhancement, organic growth, and sustainability.',
    detail: 'Disciplined organic scaling paired with secondary hardware remarketing delivers high-margin value recovery. Decommissioned assets are restored to productive enterprise cycles or refined into certified clean raw materials.',
    iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />`,
  },
];

const businesses = [
  {
    division: 'DIVISION 01',
    name: 'Information Management',
    tagline: 'Physical document storage, digital conversion, and secure tape vaulting.',
    description: 'Techsteps Information Management specialises in secure physical document storage, digital transformation, and confidential records management with full chain-of-custody tracking.',
    link: '/information-management',
    image: '/images/services/document-storage.jpg',
    accreditations: 'ISO 27001 • BS 4971 • UK GDPR',
  },
  {
    division: 'DIVISION 02',
    name: 'Techsteps Relocations',
    tagline: 'Specialist commercial workplace relocations & data centre engineering.',
    description: 'As the market leader in commercial relocation, we specialise in creating effective workspaces, mission-critical server migration, laboratory transfers, and heritage transport.',
    link: '/moving-relocation-services',
    image: '/images/services/it-relocations.jpg',
    accreditations: 'BAR Accredited • SafeContractor • ISO 9001',
  },
  {
    division: 'DIVISION 03',
    name: 'Datashred Operations',
    tagline: 'Accredited physical document destruction and mobile on-site shredding.',
    description: 'We are one of the leading providers of document destruction in the United Kingdom, delivering high-torque DIN 66399 shredding, secure console rotations, and itemised destruction certificates.',
    link: '/secure-shredding-document-integrity',
    image: '/images/services/hard-drive-destruction.jpg',
    accreditations: 'BS EN 15713 • DIN 66399 P-4/P-7',
  },
  {
    division: 'DIVISION 04',
    name: 'Technology & ITAD',
    tagline: 'Complete lifecycle disposition, data sanitisation, and remarketing.',
    description: 'We offer the complete set of services for your information technology assets: certified ADISA 8.0 data wiping, NIST 800-88 sanitisation, hardware remarketing, and circular lifecycle recovery.',
    link: '/it-lifecycle-services-destruction',
    image: '/images/services/itad.jpg',
    accreditations: 'ADISA Standard 8.0 • DIPCOG • Zero Landfill',
  },
];

const esgPillars = [
  {
    title: 'Environmental Stewardship',
    badge: 'NET ZERO ALIGNED',
    desc: 'Techsteps maintains a strict 100% zero-to-landfill commitment across all electronics and materials. We help institutional clients measure and drastically reduce their Scope 3 greenhouse gas emissions through audited hardware refurbishment and carbon offset reporting.',
  },
  {
    title: 'Social & Community Responsibility',
    badge: 'VETTED UK TEAMS',
    desc: 'Our nationwide operational teams are 100% security vetted under BS 7858 protocols. We invest in local STEM apprenticeships, uphold ethical fair living wages across all logistics hubs, and maintain an exemplary zero-harm occupational health record.',
  },
  {
    title: 'Defensible Board Governance',
    badge: 'ISO 27001 AUDITED',
    desc: 'The Board maintains independent surveillance audits, stringent anti-bribery governance, robust cybersecurity frameworks, and rigorous statutory reporting in full compliance with the UK Companies Act and UK GDPR standards.',
  },
];
---

<BaseLayout
  title="Investors | Corporate Overview & Investment Strategy | Techsteps plc"
  description="Techsteps plc leads its markets in the management of data, information, communications, and assets. Supporting public and private sectors with critical recurring services, strong cashflows, and defensible ESG excellence."
  hasHeroHeader={true}
>
  <!-- 1. Hero Section -->
  <PageHero
    title="INVESTORS"
    eyebrow="TECHSTEPS PLC // INVESTOR RELATIONS"
    subheading="We provide secure and sustainable business services for data, information, communications and assets. Supporting public and private sectors with mission-critical, recurring lifecycle solutions that generate strong cashflows."
    breadcrumbs={breadcrumbs}
    bgImage="/images/brand/about-hero-bg.jpg"
    minHeight="min-h-[500px] sm:min-h-[540px] lg:min-h-[580px]"
    dividerColor="#ffffff"
  />

  <!-- 2. High-Impact Stats Bar (From techsteps.co.uk/investors) -->
  <section class="relative -mt-10 sm:-mt-14 z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="bg-white rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xl border border-slate-200/90">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 divide-y sm:divide-y-0 sm:divide-x divide-slate-100">
        {investorStats.map((stat, idx) => (
          <div class={`space-y-2 ${idx !== 0 ? 'pt-6 sm:pt-0 sm:pl-6 lg:pl-8' : ''}`}>
            <div class="flex items-baseline gap-1 text-[#0F623A]">
              <span class="text-2xl sm:text-3xl font-extrabold">{stat.prefix}</span>
              <span class="text-4xl sm:text-5xl font-black font-display tracking-tight text-slate-900">{stat.value}</span>
              <span class="text-2xl sm:text-3xl font-extrabold text-[#0F623A]">{stat.suffix}</span>
            </div>
            <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-tight">{stat.title}</h3>
            <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">{stat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 3. About Us / Overview Section (Exact Copy & Theme from Reference) -->
  <section class="py-16 sm:py-20 lg:py-24 bg-white overflow-hidden">
    <Container className="max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <!-- Left: Narrative -->
        <div class="lg:col-span-6 space-y-6">
          <div class="space-y-4">
            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-[#0F623A] border border-emerald-200/80 text-xs sm:text-sm font-medium uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
              About Us
            </span>
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-normal font-sans text-slate-900 tracking-normal leading-snug">
              We provide secure and sustainable business services for data, information, communications and assets.
            </h2>
          </div>

          <!-- Core Highlights Checkmarks -->
          <div class="space-y-3 pt-2 text-sm sm:text-base font-normal text-slate-800">
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-100 text-[#0F623A] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span>100% Security-Vetted UK Personnel Fleet</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-100 text-[#0F623A] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span>Predictable Multi-Year Contract Backlog &amp; Deep Client Stickiness</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-100 text-[#0F623A] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span>ADISA Standard 8.0 &amp; ISO 27001 Certified Facilities</span>
            </div>
          </div>

          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm sm:text-base font-bold shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5"
            >
              <span>Get In Touch</span>
              <span class="ml-2">&rarr;</span>
            </a>
            <a
              href="/request-a-quote"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-900 border border-slate-300 text-sm sm:text-base font-bold transition-all duration-200"
            >
              <span>Request a Collection</span>
            </a>
          </div>
        </div>

        <!-- Right: Operations Facility Image with Subtle Elevation -->
        <div class="lg:col-span-6 relative flex justify-center items-center">
          <div class="relative w-full max-w-[600px] group">
            <div class="absolute -inset-3 bg-gradient-to-tr from-[#0F623A]/15 to-emerald-400/10 rounded-3xl blur-2xl pointer-events-none" aria-hidden="true"></div>
            <div class="relative rounded-2xl sm:rounded-3xl overflow-hidden shadow-2xl border border-slate-200/90 bg-white">
              <img
                src="/images/brand/investors-operations-technician.jpg"
                alt="Techsteps certified technician managing enterprise IT lifecycle assets and hardware auditing"
                class="w-full h-full object-cover aspect-[4/3] sm:aspect-[1.15/1] transition-transform duration-500 group-hover:scale-[1.03]"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 4. Strategic Investment Pillars (Market Leader, Predictable Income, Sustainable Growth) -->
  <section class="py-16 sm:py-20 lg:py-24 bg-[#f8faf7] border-y border-slate-200/80">
    <Container className="max-w-7xl">
      <div class="text-center max-w-4xl mx-auto space-y-4 mb-14 sm:mb-18">
        <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100/80 text-[#0F623A] border border-emerald-300/60 text-xs sm:text-sm font-medium uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
          Investment Foundations
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-normal font-sans text-slate-900 tracking-normal leading-snug">
          Techsteps plc has four businesses providing leading services in the management of data, information, communications and assets.
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {strategicPillars.map((pillar) => (
          <div class="bg-white rounded-3xl p-8 sm:p-9 border border-slate-200 shadow-sm hover:shadow-xl transition-all duration-300 flex flex-col justify-between group hover:-translate-y-1">
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <span class="w-12 h-12 rounded-2xl bg-emerald-50 text-[#0F623A] flex items-center justify-center font-mono font-bold text-base border border-emerald-200/70 shadow-xs">
                  {pillar.number}
                </span>
                <span class="w-10 h-10 rounded-full bg-slate-50 text-[#0F623A] group-hover:bg-[#0F623A] group-hover:text-white flex items-center justify-center transition-colors duration-200">
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={pillar.iconSvg} />
                </span>
              </div>
              <h3 class="text-2xl font-extrabold font-display text-slate-900 tracking-tight group-hover:text-[#0F623A] transition-colors">
                {pillar.title}
              </h3>
              <p class="text-sm font-bold text-slate-800 leading-snug">
                {pillar.desc}
              </p>
              <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                {pillar.detail}
              </p>
            </div>
            <div class="pt-6 mt-6 border-t border-slate-100 flex items-center text-xs font-bold text-[#0F623A] tracking-wider uppercase">
              <span>Read Strategy</span>
              <span class="ml-1.5 transition-transform group-hover:translate-x-1">&rarr;</span>
            </div>
          </div>
        ))}
      </div>
    </Container>
  </section>

  <!-- 5. Four Businesses, One Techsteps plc (Division Cards) -->
  <section class="py-16 sm:py-20 lg:py-24 bg-white overflow-hidden">
    <Container className="max-w-7xl">
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-16">
        <div class="max-w-3xl space-y-3">
          <span class="text-sm sm:text-base font-bold uppercase tracking-[0.2em] text-[#146B5C]">
            ABOUT OUR BUSINESSES
          </span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-slate-950 tracking-tight leading-[1.15]">
            Four Businesses, One Techsteps plc
          </h2>
          <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
            Techsteps plc has four businesses, who work together to offer organisations a holistic approach to the management of their data, information, communications and assets.
          </p>
        </div>

        <div class="shrink-0">
          <a
            href="/contact"
            class="inline-flex items-center justify-center px-7 py-3 rounded-full bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm sm:text-base font-bold shadow-md hover:shadow-lg transition-all duration-200"
          >
            <span>Get In Touch</span>
            <span class="ml-2">&rarr;</span>
          </a>
        </div>
      </div>

      <!-- 4 Division Cards Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {businesses.map((biz) => (
          <a
            href={biz.link}
            class="group relative flex flex-col justify-between rounded-[28px] overflow-hidden min-h-[460px] p-6 shadow-md hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-1.5 border border-slate-900/10 bg-slate-900"
          >
            <!-- Background Image & Gradient -->
            <img
              src={biz.image}
              alt={biz.name}
              class="absolute inset-0 w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
              decoding="async"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/75 to-black/30"></div>

            <!-- Top Row -->
            <div class="relative z-10 flex items-center justify-between w-full">
              <span class="px-3.5 py-1.5 rounded-full bg-white/20 backdrop-blur-md border border-white/25 text-white text-[11px] font-mono font-bold tracking-widest uppercase shadow-sm">
                {biz.division}
              </span>
              <span class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-md border border-white/25 flex items-center justify-center text-white shadow-sm">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </span>
            </div>

            <!-- Bottom Content Area -->
            <div class="relative z-10 flex flex-col justify-end mt-auto pt-12 space-y-2">
              <h3 class="text-xl sm:text-2xl font-bold font-display text-white tracking-tight leading-snug group-hover:text-emerald-400 transition-colors">
                {biz.name}
              </h3>
              <p class="text-xs sm:text-sm text-slate-200/90 leading-relaxed font-normal line-clamp-3">
                {biz.description}
              </p>
              <div class="pt-3 flex items-center justify-between">
                <span class="inline-flex items-center gap-2 bg-[#0F623A] group-hover:bg-[#0c4e2e] text-white font-bold text-xs px-3.5 py-1.5 rounded-full shadow-sm transition-colors">
                  <span>Explore Division</span>
                  <span>&rarr;</span>
                </span>
                <span class="text-[10px] font-mono text-emerald-300 font-bold uppercase tracking-wider">
                  Accredited
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </Container>
  </section>

  <!-- 6. Restoring our World – ESG Strategy -->
  <section class="py-16 sm:py-20 lg:py-24 bg-[#f1f4ef] border-t border-slate-200/80">
    <Container className="max-w-7xl">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-14 items-center">
        <!-- Left: Narrative -->
        <div class="lg:col-span-6 space-y-6">
          <div class="space-y-3">
            <span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white text-[#0F623A] border border-slate-200 text-xs sm:text-sm font-bold uppercase tracking-wider shadow-xs">
              <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
              Now It's Your Turn
            </span>
            <h2 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-display text-slate-950 tracking-tight leading-[1.15]">
              Restoring our World – Our ESG strategy
            </h2>
          </div>

          <p class="text-base sm:text-lg text-slate-600 leading-relaxed font-normal">
            Techsteps plc recognises the impact of its operations on the environment, its responsibility to the communities it operates within and its obligations to its people, its suppliers and other invested stakeholders.
          </p>

          <div class="space-y-4 pt-2">
            {esgPillars.map((item) => (
              <div class="p-5 rounded-2xl bg-white border border-slate-200 shadow-xs space-y-1.5">
                <div class="flex items-center justify-between">
                  <h4 class="font-bold text-slate-950 text-base">{item.title}</h4>
                  <span class="text-[10px] font-mono font-bold px-2 py-0.5 rounded bg-emerald-50 text-[#0F623A] border border-emerald-200">
                    {item.badge}
                  </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-normal">
                  {item.desc}
                </p>
              </div>
            ))}
          </div>

          <div class="pt-2 flex flex-wrap items-center gap-4">
            <a
              href="/sustainability"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm sm:text-base font-bold shadow-md hover:shadow-lg transition-all duration-200"
            >
              <span>Explore ESG &amp; Sustainability</span>
              <span class="ml-2">&rarr;</span>
            </a>
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-white hover:bg-slate-50 text-slate-900 border border-slate-300 text-sm sm:text-base font-bold shadow-xs hover:shadow-md transition-all duration-200"
            >
              <span>Get In Touch</span>
            </a>
          </div>
        </div>

        <!-- Right: Hands Collaboration / ESG Sustainability Visual -->
        <div class="lg:col-span-6 relative flex justify-center">
          <div class="relative w-full max-w-lg lg:max-w-none">
            <div class="absolute -inset-4 bg-emerald-500/10 rounded-3xl blur-2xl pointer-events-none" aria-hidden="true"></div>
            <div class="relative rounded-3xl overflow-hidden border border-slate-200 shadow-xl bg-slate-900">
              <img
                src="/images/brand/story-sustainability.jpg"
                alt="Restoring our World - Techsteps plc ESG and circular economy"
                class="w-full h-auto object-cover object-center transform hover:scale-105 transition-transform duration-700 ease-out"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent pointer-events-none"></div>
              <div class="absolute bottom-6 left-6 right-6 text-white z-10">
                <span class="text-xs font-mono font-bold tracking-widest uppercase text-[#0F623A]">ESG ROADMAP // CIRCULAR IMPACT</span>
                <h4 class="text-lg sm:text-xl font-bold font-display mt-1">Driving Verifiable Decarbonisation &amp; Corporate Responsibility</h4>
              </div>
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- 7. Corporate Governance Factsheet & Investor Contacts -->
  <section class="py-16 sm:py-20 bg-white">
    <Container className="max-w-7xl">
      <div class="p-8 sm:p-12 lg:p-14 rounded-3xl bg-slate-950 text-white relative overflow-hidden shadow-2xl">
        <div class="absolute -right-20 -bottom-20 w-96 h-96 bg-emerald-500/10 rounded-full blur-3xl pointer-events-none" aria-hidden="true"></div>
        <div class="relative z-10 max-w-4xl space-y-6">
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-[#0F623A]">
