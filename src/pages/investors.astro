---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/layout/Container.astro';
import Section from '../components/layout/Section.astro';
import CTA from '../components/global/cta.astro';
import PageHero from '../components/hero/PageHero.astro';
import { getInvestorsPage, getDivisions, getSiteSettings } from '../lib/sanity/client';

const [investorsData, divisions, siteSettings] = await Promise.all([
  getInvestorsPage(),
  getDivisions(),
  getSiteSettings(),
]);

const breadcrumbs = [
  { name: 'Investors', url: '/investors' },
];

const investorStats = (investorsData.stats && investorsData.stats.length > 0)
  ? investorsData.stats
  : [
      { prefix: '+', value: '25', suffix: 'M', title: 'Items in Storage', desc: 'Secure barcoded documents and magnetic media under active vault management' },
      { prefix: '+', value: '238', suffix: 'M', title: 'Images Scanned', desc: 'High-speed OCR-indexed digital records produced for UK public and private enterprises' },
      { prefix: '+', value: '500', suffix: 'K', title: 'Desktops Moved', desc: 'Complex workplace hardware relocations and mission-critical data centre migrations' },
      { prefix: '+', value: '52', suffix: 'K', title: 'Tonnes Shredded', desc: 'Confidential paper and electronic media securely destroyed with zero landfill waste' },
    ];

const strategicPillars = (investorsData.strategicPillars && investorsData.strategicPillars.length > 0)
  ? investorsData.strategicPillars
  : [
      {
        number: '01',
        title: 'Market Leader',
        headline: 'Defensible Market Moats & Trusted Brand Positioning',
        desc: 'Techsteps plc leads its markets, serving public & private sectors with essential services.',
        detail: 'From high-density document archival to ADISA-accredited IT asset disposition, our compliance credentials (ISO 27001, BS EN 15713, DIN 66399) create deep operational barriers against low-end freight commoditisation.',
        iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M16.5 18.75h-9m9 0a3 3 0 013 3h-15a3 3 0 013-3m9 0v-3.375c0-.621-.504-1.125-1.125-1.125h-.871M7.5 18.75v-3.375c0-.621.504-1.125 1.125-1.125h.872m5.003 0V11.25a2.25 2.25 0 00-2.25-2.25h-1.5a2.25 2.25 0 00-2.25 2.25v3m6.003 0a2.25 2.25 0 00-2.25-2.25H9.75a2.25 2.25 0 00-2.25 2.25" />`,
      },
      {
        number: '02',
        title: 'Predictable Income',
        headline: 'Contracted Recurring Revenues & Robust Free Cash Flow',
        desc: 'Our income is predictable, recurring, and generates strong cashflows.',
        detail: 'Long-term enterprise contracts spanning scheduled office shredding consoles, rotational archive vaults, and continuous IT hardware refresh programs deliver high client retention rates and resilient operating cash generation.',
        iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 18.75a60.07 60.07 0 0115.797 2.101c.727.198 1.453-.342 1.453-1.096V18.75M3.75 4.5v.75A.75.75 0 013 6h-.75m0 0v-.375c0-.621.504-1.125 1.125-1.125H20.25M2.25 6v9m18-10.5v.75c0 .414.336.75.75.75h.75m-1.5-1.5h.375c.621 0 1.125.504 1.125 1.125v9.75c0 .621-.504 1.125-1.125 1.125h-.375m1.5-1.5H21a.75.75 0 00-.75.75v.75m0 0H3.75m0 0h-.375a1.125 1.125 0 01-1.125-1.125V15m1.5 1.5v-.75A.75.75 0 003 15h-.75M15 10.5a3 3 0 11-6 0 3 3 0 016 0zm3 0h.008v.008H18V10.5zm-12 0h.008v.008H6V10.5z" />`,
      },
      {
        number: '03',
        title: 'Sustainable Growth',
        headline: 'Margin Enhancement, Circular Economics & ESG Leadership',
        desc: 'Our strategy focuses on margin enhancement, organic growth, and sustainability.',
        detail: 'Disciplined organic scaling paired with secondary hardware remarketing delivers high-margin value recovery. Decommissioned assets are restored to productive enterprise cycles or refined into certified clean raw materials.',
        iconSvg: `<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z" />`,
      },
    ];

const defaultBusinesses = [
  {
    division: 'DIVISION 01',
    name: 'Information Management',
    tagline: 'Physical document storage, digital conversion, and secure tape vaulting.',
    description: 'Techsteps Information Management specialises in secure physical document storage, digital transformation, and confidential records management with full chain-of-custody tracking.',
    link: '/information-management',
    image: '/images/services/document-storage.jpg',
    accreditations: 'ISO 27001 • BS 4971 • UK GDPR',
  },
  {
    division: 'DIVISION 02',
    name: 'Techsteps Relocations',
    tagline: 'Specialist commercial workplace relocations & data centre engineering.',
    description: 'As the market leader in commercial relocation, we specialise in creating effective workspaces, mission-critical server migration, laboratory transfers, and heritage transport.',
    link: '/moving-relocation-services',
    image: '/images/services/it-relocations.jpg',
    accreditations: 'BAR Accredited • SafeContractor • ISO 9001',
  },
  {
    division: 'DIVISION 03',
    name: 'Datashred Operations',
    tagline: 'Accredited physical document destruction and mobile on-site shredding.',
    description: 'We are one of the leading providers of document destruction in the United Kingdom, delivering high-torque DIN 66399 shredding, secure console rotations, and itemised destruction certificates.',
    link: '/secure-shredding-document-integrity',
    image: '/images/services/hard-drive-destruction.jpg',
    accreditations: 'BS EN 15713 • DIN 66399 P-4/P-7',
  },
  {
    division: 'DIVISION 04',
    name: 'Technology & ITAD',
    tagline: 'Complete lifecycle disposition, data sanitisation, and remarketing.',
    description: 'We offer the complete set of services for your information technology assets: certified ADISA 8.0 data wiping, NIST 800-88 sanitisation, hardware remarketing, and circular lifecycle recovery.',
    link: '/it-lifecycle-services-destruction',
    image: '/images/services/itad.jpg',
    accreditations: 'ADISA Standard 8.0 • DIPCOG • Zero Landfill',
  },
];

const businesses = (divisions && divisions.length > 0)
  ? divisions.map((d, idx) => ({
      division: `DIVISION 0${d.order || idx + 1}`,
      name: d.title,
      tagline: d.headline || d.summary,
      description: d.summary,
      link: `/${d.slug}`,
      image: d.cardImage || [
        '/images/services/document-storage.jpg',
        '/images/services/itad.jpg',
        '/images/services/hard-drive-destruction.jpg',
        '/images/services/it-relocations.jpg'
      ][idx % 4],
      accreditations: d.accreditation || 'ISO 27001 • BS EN 15713',
    }))
  : (investorsData.businesses && investorsData.businesses.length > 0)
  ? investorsData.businesses
  : defaultBusinesses;

const defaultEsgPillars = [
  {
    title: 'Environmental Stewardship',
    badge: 'NET ZERO ALIGNED',
    desc: 'Techsteps maintains a strict 100% zero-to-landfill commitment across all electronics and materials. We help institutional clients measure and drastically reduce their Scope 3 greenhouse gas emissions through audited hardware refurbishment and carbon offset reporting.',
  },
  {
    title: 'Social & Community Responsibility',
    badge: 'VETTED UK TEAMS',
    desc: 'Our nationwide operational teams are 100% security vetted under BS 7858 protocols. We invest in local STEM apprenticeships, uphold ethical fair living wages across all logistics hubs, and maintain an exemplary zero-harm occupational health record.',
  },
  {
    title: 'Defensible Board Governance',
    badge: 'ISO 27001 AUDITED',
    desc: 'The Board maintains independent surveillance audits, stringent anti-bribery governance, robust cybersecurity frameworks, and rigorous statutory reporting in full compliance with the UK Companies Act and UK GDPR standards.',
  },
];

const esgPillars = (investorsData.esgPillars && investorsData.esgPillars.length > 0)
  ? investorsData.esgPillars
  : defaultEsgPillars;

  // Turns string / Astro image / Sanity image / relative path into a safe URL
const resolveImage = (img: any): string => {
  let src = typeof img === 'string' ? img : (img?.src ?? img?.asset?.url ?? img?.url ?? '');
  src = String(src ?? '').trim();
  if (!src) return '';
  if (!/^(https?:)?\/\//.test(src) && !src.startsWith('/') && !src.startsWith('data:')) src = '/' + src;
  return src.replace(/ /g, '%20');
};

// Same fallback files the homepage service cards use
const fallbackImages = [
  '/images/services/1.jpg',
  '/images/services/2.jpg',
  '/images/services/3.jpg',
  '/images/services/4.jpg',
];
---

<BaseLayout
  title={investorsData.metaTitle || "Investors | Corporate Overview & Investment Strategy | Techsteps plc"}
  description={investorsData.metaDescription || "Techsteps plc leads its markets in the management of data, information, communications, and assets. Supporting public and private sectors with critical recurring services, strong cashflows, and defensible ESG excellence."}
  hasHeroHeader={true}
>
  <!-- 1. Hero Section -->
  <PageHero
    bgImage="/images/hero/Investors.webp"
    bgAlt="Techsteps plc Investor Relations and Executive Overview"
    breadcrumbs={breadcrumbs}
    layout="custom"
    showDivider={true}
    dividerColor="#ffffff"
    minHeight="min-h-[520px] sm:min-h-[560px] lg:min-h-[620px]"
    noOverlay={true}
    theme="light"
    contained={true}
  >
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-8 xl:gap-10 items-center">
      <!-- HERO CONTENT (Left) -->
      <div class="lg:col-span-6 xl:col-span-6 max-w-2xl lg:max-w-none pt-2 sm:pt-4 z-10">

        <!-- Eyebrow Badge -->
        {/*<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0F623A]/10 text-[#0F623A] text-xs sm:text-sm font-sans font-bold uppercase tracking-[0.18em] mb-3 sm:mb-4">
          <span>{investorsData.hero?.eyebrow || 'TECHSTEPS PLC // INVESTOR RELATIONS'}</span>
        </div>*/}

        <!-- Heading -->
        <h1
          class="font-display
                 text-3xl sm:text-4xl md:text-5xl lg:text-[50px] xl:text-[56px]
                 font-semibold
                 text-slate-900
                 tracking-normal
                 leading-[1.12] sm:leading-[1.1]
                 max-w-xl"
        >
          {investorsData.hero?.title || 'Investor Relations'}
        </h1>

        <!-- Description -->
        <p
          class="mt-4 sm:mt-5
                 text-lg sm:text-xl lg:text-lg
                 text-black
                 max-w-lg
                 leading-relaxed
                 font-sans font-normal"
        >
          {investorsData.hero?.subheading || 'We provide secure and sustainable business services for data, information, communications and assets. Supporting public and private sectors with mission-critical, recurring lifecycle solutions that generate strong cashflows.'}
        </p>

        <!-- CTA Buttons -->
        <div
          class="mt-6 sm:mt-8
                 flex flex-wrap
                 items-center
                 gap-3.5 sm:gap-4"
        >
          <a
            href="/contact"
            class="inline-flex items-center justify-center
                   gap-2.5
                   px-6 sm:px-7
                   py-3 sm:py-3.5
                   rounded-none
                   bg-[#0F623A] hover:bg-[#0c4e2e]
                   text-white
                   text-sm sm:text-base
                   font-bold
                   shadow-md hover:shadow-lg
                   transition-all duration-200
                   hover:scale-[1.02]
                   focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
          >
            <span>Contact Investor Relations</span>
            <svg
              class="w-4 h-4 text-white"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="2.2"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M17 8l4 4m0 0l-4 4m4-4H3"
              />
            </svg>
          </a>

          <a
            href="#strategic-pillars"
            class="inline-flex items-center justify-center
                   px-6 sm:px-7
                   py-3 sm:py-3.5
                   rounded-none
                   bg-white hover:bg-slate-50
                   border-2 border-[#0F623A] hover:border-[#0c4e2e]
                   text-[#0F623A] hover:text-[#0c4e2e]
                   text-sm sm:text-base
                   font-bold
                   transition-all duration-200
                   hover:scale-[1.02]
                   shadow-xs
                   focus:outline-none focus:ring-2 focus:ring-[#0F623A]"
          >
            Investment Strategy
          </a>
        </div>

      </div>

      <!-- HERO SPACER (Right on Desktop) -->
      <div class="hidden lg:flex lg:col-span-6 xl:col-span-6 items-center justify-end min-h-[420px] lg:min-h-[480px] xl:min-h-[520px] pointer-events-none" aria-hidden="true">
      </div>
    </div>
  </PageHero>

  <!-- 2. High-Impact Stats Bar (From techsteps.co.uk/investors) -->
 <!-- <section class="relative -mt-10 sm:-mt-14 z-20 max-w-[1240px] mx-auto px-4 sm:px-6 lg:px-8">
    <div id="investor-stats-card" class="bg-white rounded-3xl p-6 sm:p-8 lg:p-10 shadow-xl border border-slate-200/90">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8 divide-y sm:divide-y-0 sm:divide-x divide-slate-100">
        {investorStats.map((stat, idx) => (
          <div class={`space-y-2 ${idx !== 0 ? 'pt-6 sm:pt-0 sm:pl-6 lg:pl-8' : ''}`}>
            <div class="flex items-baseline gap-1 text-[#0F623A]">
              <span class="text-2xl sm:text-3xl font-extrabold">{stat.prefix}</span>
              <span class="text-4xl sm:text-5xl font-black font-sans tracking-tight text-slate-900 tabular-nums investor-stat-num" data-target={stat.value}>{stat.value}</span>
              <span class="text-2xl sm:text-3xl font-extrabold text-[#0F623A]">{stat.suffix}</span>
            </div>
            <h3 class="text-base sm:text-lg font-semibold text-slate-900 tracking-tight">{stat.title}</h3>
            <p class="text-sm sm:text-base text-black leading-relaxed font-normal">{stat.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>-->

  <!-- 3. About Us / Overview Section (Exact Copy & Theme from Reference) -->
  <section class="py-8 sm:py-10 lg:py-12 bg-white overflow-hidden">
    <Container>
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
        <!-- Left: Narrative -->
        <div class="lg:col-span-6 space-y-6">
          <div class="space-y-4">
            {/*<span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 text-[#0F623A] border border-emerald-200/80 text-xs sm:text-sm font-medium uppercase tracking-wider">
              <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
              About Us
            </span>*/}
            <h2 class="text-2xl sm:text-3xl lg:text-4xl font-normal font-display text-slate-900 tracking-normal leading-snug">
              We provide secure and sustainable business services for data, information, communications and assets.
            </h2>
          </div>

          <!-- Core Highlights Checkmarks -->
          <div class="space-y-3 pt-2 text-sm sm:text-base font-normal text-slate-800">
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-100 text-[#0F623A] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span>100% Security-Vetted UK Personnel Fleet</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-100 text-[#0F623A] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span>Predictable Multi-Year Contract Backlog &amp; Deep Client Stickiness</span>
            </div>
            <div class="flex items-center gap-3">
              <span class="w-6 h-6 rounded-full bg-emerald-100 text-[#0F623A] flex items-center justify-center shrink-0">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                </svg>
              </span>
              <span>ADISA Standard 8.0 &amp; ISO 27001 Certified Facilities</span>
            </div>
          </div>

          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href="/contact"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm sm:text-base font-bold shadow-md hover:shadow-lg transition-all duration-200 transform hover:-translate-y-0.5"
            >
              <span>Get In Touch</span>
              <span class="ml-2">&rarr;</span>
            </a>
            <a
              href="/request-a-quote"
              class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-900 border border-slate-300 text-sm sm:text-base font-bold transition-all duration-200"
            >
              <span>Request a Collection</span>
            </a>
          </div>
        </div>

        <!-- Right: Operations Facility Image with Subtle Elevation -->
<div class="lg:col-span-6 relative flex justify-center items-center">
  <div class="relative w-full max-w-[600px] group">
    <div class="absolute -inset-3 bg-gradient-to-tr from-[#0F623A]/15 to-emerald-400/10 rounded-3xl blur-2xl pointer-events-none" aria-hidden="true"></div>
    <img
      src="/images/brand/itad-intro-green.webp"
      alt="Techsteps certified technician managing enterprise IT lifecycle assets and hardware auditing"
      class="relative w-full h-full object-cover aspect-[4/3] sm:aspect-[1.15/1] transition-transform duration-500 group-hover:scale-[1.03]"
      loading="lazy"
      decoding="async"
    />
  </div>
</div>
      </div>
    </Container>
  </section>

  <!-- 4. Strategic Investment Pillars (Redesigned: Asymmetric Featured Grid) -->
  <section id="strategic-pillars" class="py-12 sm:py-16 lg:py-20 bg-[#f8faf7] border-y border-slate-200/80">
    <Container>
      <div class="text-center max-w-4xl mx-auto space-y-4 mb-12 sm:mb-16">
        <!--span class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-100/80 text-[#0F623A] border border-emerald-300/60 text-xs sm:text-sm font-medium uppercase tracking-wider">
          <span class="w-2 h-2 rounded-full bg-[#0F623A]"></span>
          Investment Foundations
        </span-->
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-normal font-display text-slate-900 tracking-normal leading-snug">
          Techsteps plc has four businesses providing leading services in the management of data.
        </h2>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
        {strategicPillars.map((pillar, idx) => {
          const isFeatured = idx === 1;
          return (
            <div
              class={`relative rounded-3xl p-8 sm:p-10 flex flex-col justify-between transition-all duration-300 hover:-translate-y-1 group overflow-hidden
                ${isFeatured
                  ? 'lg:col-span-4 bg-[#0A331E] text-white shadow-2xl'
                  : 'lg:col-span-4 bg-white border border-slate-200 hover:shadow-xl hover:border-[#0F623A]/30'}
              `}
            >
              {/* Featured: subtle grid pattern */}
              {isFeatured && (
                <div class="absolute inset-0 opacity-[0.06] pointer-events-none"
                     style="background-image: linear-gradient(#fff 1px, transparent 1px), linear-gradient(90deg, #fff 1px, transparent 1px); background-size: 40px 40px;"></div>
              )}

              <div class="relative z-10 space-y-5">
                <div class="flex items-center justify-between">
                  <span class={`font-mono font-bold text-sm tracking-[0.3em] ${isFeatured ? 'text-emerald-400' : 'text-slate-400'}`}>
                    {pillar.number}
                  </span>
                  <span class={`w-12 h-12 rounded-2xl flex items-center justify-center transition-colors duration-200
                    ${isFeatured
                      ? 'bg-emerald-400/15 text-emerald-300'
                      : 'bg-emerald-50 text-[#0F623A] group-hover:bg-[#0F623A] group-hover:text-white'}`}>
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8" set:html={pillar.iconSvg} />
                  </span>
                </div>

                <h3 class={`text-2xl sm:text-3xl font-semibold font-display tracking-tight leading-[1.15] ${isFeatured ? 'text-white' : 'text-slate-900 group-hover:text-[#0F623A] transition-colors'}`}>
                  {pillar.title}
                </h3>

                <div class={`w-12 h-0.5 ${isFeatured ? 'bg-emerald-400' : 'bg-[#0F623A]'}`}></div>

                <p class={`text-sm font-bold leading-snug ${isFeatured ? 'text-emerald-50' : 'text-slate-800'}`}>
                  {pillar.desc}
                </p>
                <p class={`text-sm sm:text-base leading-relaxed font-normal ${isFeatured ? 'text-emerald-100/75' : 'text-black'}`}>
                  {pillar.detail}
                </p>
              </div>
            </div>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- 5. Four Businesses, One Techsteps plc (Redesigned: Clean Light Cards) -->
<section class="py-12 sm:py-16 lg:py-20 bg-white overflow-hidden">
  <Container>
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-12 sm:mb-14">
      <div class="max-w-3xl space-y-3">
        {/*<span class="text-xs sm:text-sm font-bold uppercase tracking-[0.25em] text-[#146B5C]">
          ABOUT OUR BUSINESSES
        </span>*/}
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-semibold font-display text-slate-950 tracking-tight leading-[1.15]">
          Four Businesses,<br class="hidden sm:block" /> One Techsteps plc
        </h2>
        <p class="text-lg sm:text-xl text-black leading-relaxed font-normal max-w-2xl">
          Techsteps plc has four businesses, who work together to offer organisations a holistic approach to the management of their data, information, communications and assets.
        </p>
      </div>

      <div class="shrink-0">
        <a href="/contact" class="inline-flex items-center justify-center px-7 py-3.5 rounded-full bg-[#0F623A] hover:bg-[#0c4e2e] text-white text-sm sm:text-base font-bold shadow-md hover:shadow-lg transition-all duration-200">
          <span>Get In Touch</span>
          <span class="ml-2">&rarr;</span>
        </a>
      </div>
    </div>

    <!-- Clip-path shapes (same four shapes as the homepage cards) -->
    <svg class="sr-only" aria-hidden="true" width="0" height="0">
      <defs>
        <clipPath id="biz-clip-0" clipPathUnits="objectBoundingBox">
          <path d="M 0,0 L 0.70,0 C 0.74,0.01 0.78,0.05 0.82,0.12 C 0.86,0.18 0.90,0.20 0.96,0.20 L 1,0.20 L 1,0.78 C 0.94,0.80 0.87,0.84 0.80,0.90 C 0.72,0.96 0.65,1 0.58,1 L 0,1 Z" />
        </clipPath>
        <clipPath id="biz-clip-1" clipPathUnits="objectBoundingBox">
          <path d="M 0,0 L 0.72,0 C 0.76,0.01 0.80,0.06 0.84,0.13 C 0.88,0.19 0.92,0.22 0.97,0.22 L 1,0.22 L 1,1 L 0.48,1 C 0.38,0.98 0.28,0.93 0.18,0.86 C 0.10,0.81 0.04,0.78 0,0.78 Z" />
