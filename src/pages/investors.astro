  <script>
    function setupInvestorStatsCounter() {
      const statsContainer = document.getElementById("investor-stats-card");
      if (!statsContainer) return;

      const numSpans = statsContainer.querySelectorAll(".investor-stat-num");
      if (numSpans.length === 0) return;

      if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        numSpans.forEach((span) => {
          span.textContent = span.getAttribute("data-target") || "0";
        });
        return;
      }

      if (statsContainer._statsObserver) {
        statsContainer._statsObserver.disconnect();
        statsContainer._statsObserver = null;
      }

      let animFrameId = null;

      const resetNumbers = () => {
        if (animFrameId) {
          cancelAnimationFrame(animFrameId);
          animFrameId = null;
        }
        numSpans.forEach((span) => {
          span.textContent = "0";
        });
      };

      const runAnimation = () => {
        if (animFrameId) {
          cancelAnimationFrame(animFrameId);
          animFrameId = null;
        }

        const duration = 1800;
        const startTime = performance.now();

        const update = (currentTime) => {
          const elapsed = currentTime - startTime;
          const progress = Math.min(elapsed / duration, 1);
          const easeProgress = 1 - Math.pow(1 - progress, 3);

          numSpans.forEach((span) => {
            const target = parseInt(span.getAttribute("data-target") || "0", 10);
            const currentVal = Math.floor(easeProgress * target);
            span.textContent = progress >= 1 ? target.toString() : currentVal.toString();
          });

          if (progress < 1) {
            animFrameId = requestAnimationFrame(update);
          } else {
            animFrameId = null;
          }
        };

        animFrameId = requestAnimationFrame(update);
      };

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                runAnimation();
              } else {
                resetNumbers();
              }
            });
          },
          { threshold: 0.15 }
        );
        observer.observe(statsContainer);
        statsContainer._statsObserver = observer;
      } else {
        runAnimation();
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", setupInvestorStatsCounter);
    } else {
      setupInvestorStatsCounter();
    }

    document.addEventListener("astro:page-load", setupInvestorStatsCounter);
  </script>
