          #chain-of-custody .custody-motion-card h3,
          #chain-of-custody .custody-motion-card p,
          #chain-of-custody .custody-motion-card > div:last-child,
          #chain-of-custody .custody-motion-card > div:first-child > span {
            transition: none !important;
          }
        }
      </style>
      <script is:inline>
        (() => {
          const setup = () => {
            const section = document.getElementById('chain-of-custody');
            if (!section || section.dataset.custodyMotionReady === 'true') return;
            const cards = [...section.querySelectorAll('.custody-motion-card')];
            if (cards.length !== 4) return;
            section.dataset.custodyMotionReady = 'true';
            const motion = window.matchMedia('(prefers-reduced-motion: reduce)');
            let observer, timer = null, active = -1, visible = false;
            const stop = () => { if (timer !== null) { clearTimeout(timer); timer = null; } };
            const setActive = (index) => {
              active = index;
              cards.forEach((card, i) => card.classList.toggle('custody-is-active', i === index));
            };
            const advance = () => {
              stop();
              if (!visible || document.hidden || motion.matches) return;
              setActive((active + 1) % cards.length);
              timer = setTimeout(advance, 2800);
            };
            const resume = () => {
              stop();
              if (!visible || document.hidden || motion.matches) {
                if (motion.matches) setActive(-1);
                return;
              }
              timer = setTimeout(advance, active === -1 ? 300 : 2800);
            };
            const onVisibility = () => resume();
            const onMotion = () => resume();
            if ('IntersectionObserver' in window) {
              observer = new IntersectionObserver(entries => {
                visible = entries[0]?.isIntersecting ?? false;
                resume();
              }, { threshold: 0.15 });
              observer.observe(section);
            } else { visible = true; resume(); }
            document.addEventListener('visibilitychange', onVisibility);
            motion.addEventListener('change', onMotion);
            document.addEventListener('astro:before-swap', () => {
              stop(); observer?.disconnect();
              document.removeEventListener('visibilitychange', onVisibility);
              motion.removeEventListener('change', onMotion);
              section.removeAttribute('data-custody-motion-ready');
            }, { once: true });
          };
          if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', setup, { once: true });
          else setup();
          document.addEventListener('astro:page-load', setup);
        })();
      </script>
