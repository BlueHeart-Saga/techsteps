        #chain-of-custody .custody-motion-card.custody-is-active > div:last-child {
          color: #D8F3E7;
          border-color: rgba(216,243,231,.3);
        }
        @media (hover: hover) {
          #chain-of-custody .custody-motion-card:not(.custody-is-active):hover {
            border-color: rgba(11,122,83,.42);
