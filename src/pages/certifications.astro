---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroHeader from '../components/global/HeroHeader.astro';
import Container from '../components/layout/Container.astro';
import CTA from '../components/global/cta.astro';

const canonicalUrl = 'https://techsteps.co.uk/certifications';

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  '@id': `${canonicalUrl}#webpage`,
  url: canonicalUrl,
  name: 'Certifications & Accreditations — TechSteps UK',
  description:
    'Comprehensive register of TechSteps accreditations and certifications including ISO 27001, ISO 9001, ISO 14001, ISO 45001, ADISA, BS EN 15713, and Cyber Essentials Plus.',
  mainEntity: {
    '@id': 'https://techsteps.co.uk/#organization',
  },
};

const accreditations = [
  {
    name: 'ISO 27001',
    categoryGroup: 'security',
    categoryLabel: 'Information Security',
    logo: '/images/certifications/iso-27001.png',
    authority: 'UKAS Accredited Body',
    desc: 'International standard for Information Security Management Systems (ISMS), governing end-to-end data sanitisation, custody tracking, and operational security.',
    quote: 'Independently verified Information Security Management governing end-to-end data sanitisation, unbroken custody chains, and total operational security.',
    standardCode: 'ISO/IEC 27001:2022',
  },
  {
    name: 'ISO 9001',
    categoryGroup: 'quality',
    categoryLabel: 'Quality Management',
    logo: '/images/certifications/iso-9001.png',
    authority: 'UKAS Accredited Body',
    desc: 'Quality Management System validation ensuring consistent process rigor, operational efficiency, and customer satisfaction across all service lines.',
    quote: 'Certified Quality Management ensuring consistent process rigor, operational efficiency, and flawless service delivery across every asset.',
    standardCode: 'ISO 9001:2015',
  },
  {
    name: 'ISO 14001',
    categoryGroup: 'environmental',
    categoryLabel: 'Environmental Management',
    logo: '/images/certifications/iso-14001.png',
    authority: 'UKAS Accredited Body',
    desc: 'Environmental Management System certification validating responsible recycling, energy efficiency, and certified zero-to-landfill circular economy workflows.',
    quote: 'Validated Environmental Management guaranteeing certified zero-to-landfill e-waste processing and circular economy recycling workflows.',
    standardCode: 'ISO 14001:2015',
  },
  {
    name: 'ISO 45001',
    categoryGroup: 'quality',
    categoryLabel: 'Health & Safety',
    logo: '/images/certifications/iso-45001.png',
    authority: 'UKAS Accredited Body',
    desc: 'Occupational Health and Safety Management System protecting our workforce, logistics crews, and client sites during secure asset extraction.',
    quote: 'Audited Occupational Health & Safety protocols safeguarding our engineering crews and client sites during secure asset decommissioning.',
    standardCode: 'ISO 45001:2018',
  },
  {
    name: 'BS EN 15713',
    categoryGroup: 'security',
    categoryLabel: 'Secure Destruction',
    logo: '/images/certifications/bs-en-15713.png',
    authority: 'British Standards Inst.',
    desc: 'European standard for the Secure Destruction of Confidential Material, encompassing physical shredding, degaussing, and disintegrator compliance.',
    quote: 'European gold standard for Secure Destruction of Confidential Material through monitored high-security shredding and degaussing.',
    standardCode: 'BS EN 15713:2009',
  },
  {
    name: 'BS 7858:2012',
    categoryGroup: 'quality',
    categoryLabel: 'Personnel Vetting',
    logo: '/images/certifications/bs-7858.png',
    authority: 'UK Security Industry',
    desc: 'Code of practice for security screening of personnel employed in an environment where the security of people, property, or confidential information is at stake.',
    quote: 'Strict security screening ensuring 100% of our logistics drivers and IT technicians pass 5-year criminal and financial vetting.',
    standardCode: 'BS 7858 Vetted',
  },
  {
    name: 'Cyber Essentials Plus',
    categoryGroup: 'security',
    categoryLabel: 'Cyber Resilience',
    logo: '/images/certifications/cyber-essentials-plus.png',
    authority: 'UK National Cyber Centre',
    desc: 'UK Government-backed certification verifying technical controls against internet-borne attacks, validated through hands-on technical audits.',
    quote: 'Hands-on technical verification defending our operational infrastructure and client custody registers against advanced cyber threats.',
    standardCode: 'Gov.UK Assured',
  },
  {
    name: 'NCSC CAS Sanitisation',
    categoryGroup: 'security',
    categoryLabel: 'Government Security',
    logo: '/images/certifications/cas-sanitisation.jpg',
    authority: 'NCSC Technical Standard',
    desc: 'National Cyber Security Centre certified commercial service for the sanitisation of sensitive media and government-grade cryptographic erasure.',
    quote: 'Government-grade cryptographic erasure and physical media sanitisation conforming to National Cyber Security Centre benchmarks.',
    standardCode: 'CAS Certified',
  },
  {
    name: 'Blancco Certified Partner',
    categoryGroup: 'security',
    categoryLabel: 'Data Sanitisation',
    logo: '/images/certifications/blancco.jpg',
    authority: 'ADISA & NIST 800-88',
    desc: 'Industry-leading certified data erasure partner delivering tamper-proof certificates of sanitisation compliant with DoD, NIST 800-88, and ADISA standards.',
    quote: 'Automated certified data wiping generating legally defensible, tamper-proof audit certificates compliant with NIST 800-88 and ADISA.',
    standardCode: 'ADISA Compliant',
  },
  {
    name: 'Crown Commercial Service',
    categoryGroup: 'public',
    categoryLabel: 'Public Frameworks',
    logo: '/images/certifications/crown-commercial.png',
    authority: 'Cabinet Office',
    desc: 'Approved supplier across UK public sector procurement frameworks, enabling direct, compliant engagement for central and local government bodies.',
    quote: 'Pre-approved public sector supplier status enabling fast, compliant procurement for UK central and local government authorities.',
    standardCode: 'CCS Approved',
  },
  {
    name: 'NHS IG Toolkit / DSPT',
    categoryGroup: 'public',
    categoryLabel: 'Healthcare Governance',
    logo: '/images/certifications/nhs.png',
    authority: 'NHS England & Caldicott',
    desc: 'Full compliance with the NHS Data Security and Protection Toolkit, ensuring Caldicott Guardian principles and secure healthcare informatics disposal.',
    quote: 'Exceeding NHS Data Security & Protection Toolkit standards, safeguarding clinical records under strict Caldicott Guardian principles.',
    standardCode: 'DSPT Standards Met',
  },
  {
    name: 'Environment Agency',
    categoryGroup: 'environmental',
    categoryLabel: 'Environmental Authority',
    logo: '/images/certifications/environment-agency.png',
    authority: 'Statutory Regulator',
    desc: 'Licensed upper-tier waste carrier, broker, and dealer authorised by the UK Environment Agency for certified WEEE collection and processing.',
    quote: 'Licensed Upper-Tier Waste Carrier, Broker & Dealer ensuring fully compliant WEEE collection and legal duty-of-care consignment notes.',
    standardCode: 'Upper Tier Carrier',
  },
  {
    name: 'BSI Kitemark™',
    categoryGroup: 'quality',
    categoryLabel: 'Quality Mark',
    logo: '/images/certifications/bsi-kitemark.png',
    authority: 'BSI Assurance UK',
    desc: 'Symbol of trust and independent verification by the British Standards Institution, reflecting continuous adherence to international benchmarks.',
    quote: 'The UK’s foremost emblem of integrity, trust, and continuous third-party audit across our operational facilities.',
    standardCode: 'BSI Verified',
  },
  {
    name: 'EcoVadis Sustainability',
    categoryGroup: 'environmental',
    categoryLabel: 'ESG Recognition',
    logo: '/images/certifications/ecovadis.png',
    authority: 'Global ESG Platform',
    desc: 'Independent evaluation of TechSteps environmental, social, ethics, and sustainable procurement governance with benchmarked ESG performance.',
    quote: 'Benchmarked ESG performance recognizing our commitment to environmental impact reduction, ethical labor, and sustainable procurement.',
    standardCode: 'ESG Audited',
  },
  {
    name: 'PCI DSS Compliant',
    categoryGroup: 'security',
    categoryLabel: 'Payment Security',
    logo: '/images/certifications/pci-dss.png',
    authority: 'PCI Security Standards',
    desc: 'Payment Card Industry Data Security Standard alignment ensuring cardholder data hardware destruction exceeds global banking criteria.',
    quote: 'Stringent cardholder data hardware destruction protocols meeting and exceeding global financial institution security benchmarks.',
    standardCode: 'Level 1 Criteria',
  },
  {
    name: 'Committed to Equality',
    categoryGroup: 'environmental',
    categoryLabel: 'Social Responsibility',
    logo: '/images/certifications/equality.png',
    authority: 'Equality Framework',
    desc: 'Verified commitment to diversity, equity, inclusive opportunity, and ethical workplace practices across all UK facilities.',
    quote: 'Verified dedication to diversity, ethical opportunity, and fair employment standards across our nationwide workforce.',
    standardCode: 'Ethical Workplace',
  },
  {
    name: 'King’s Award Enterprise',
    categoryGroup: 'environmental',
    categoryLabel: 'Enterprise Honours',
    logo: '/images/certifications/kings-award.jpg',
    authority: 'Royal Enterprise Award',
    desc: 'Prestigious UK corporate recognition honoring outstanding contribution to sustainable development, circular economy, and community impact.',
    quote: 'Prestigious corporate honour celebrating outstanding enterprise leadership in sustainable innovation and circular economy advancement.',
    standardCode: 'Sustainable Dev.',
  },
  {
    name: 'Diamond Membership',
    categoryGroup: 'public',
    categoryLabel: 'Industry Leadership',
    logo: '/images/certifications/diamond-member.png',
    authority: 'Industry Association',
    desc: 'Premier industry association tier recognising ongoing contributions to UK technology recycling, data protection standards, and circular innovation.',
    quote: 'Premier tier recognition for ongoing industry leadership and policy advancement in sustainable IT asset disposition.',
    standardCode: 'Premier Tier',
  },
];

// NEW REVIEWS FROM DOCX
const reviews = [
  { role: 'Alex Morgan', industry: 'Healthcare Manager', quote: 'Techsteps made our IT equipment disposal simple, secure, and hassle-free.' },
  { role: 'Jamie Parker', industry: 'IT Manager', quote: 'Professional service and clear communication throughout the entire process.' },
  { role: 'Taylor Bennett', industry: 'Finance Manager', quote: 'Techsteps handled our redundant IT equipment efficiently and professionally.' },
  { role: 'Jordan Ellis', industry: 'Operations Manager', quote: 'A reliable team that made our equipment disposal straightforward.' },
  { role: 'Casey Brooks', industry: 'Operations Manager', quote: 'Techsteps provided an organised service with minimal disruption to our work.' },
  { role: 'Riley Foster', industry: 'Technology Manager', quote: 'Excellent communication and a smooth IT disposal experience.' },
  { role: 'Cameron Reed', industry: 'Technology Manager', quote: 'A professional team that made our IT equipment retirement easier.' },
  { role: 'Morgan Hayes', industry: 'Engineering Manager', quote: 'Techsteps delivered a helpful, well-coordinated service from start to finish.' },
  { role: 'Avery Collins', industry: 'Business Manager', quote: 'The team made disposing of our old office technology simple and efficient.' },
  { role: 'Quinn Harper', industry: 'Operations Director', quote: 'Reliable service, helpful support, and excellent communication throughout.' },
  { role: 'Drew Palmer', industry: 'Education Manager', quote: 'Techsteps helped us manage outdated computers quickly and professionally.' },
  { role: 'Skyler James', industry: 'Campus IT Manager', quote: 'A smooth collection process with a friendly and responsive team.' },
  { role: 'Robin Mitchell', industry: 'Operations Manager', quote: 'Techsteps made our surplus IT equipment disposal easy to manage.' },
  { role: 'Finley Cooper', industry: 'Engineering Manager', quote: 'Efficient service and clear communication made the whole process easier.' },
  { role: 'Blake Turner', industry: 'IT Operations Manager', quote: 'Techsteps provided a reliable and straightforward IT asset disposal service.' },
  { role: 'Rowan Ellis', industry: 'Technology Manager', quote: 'A professional partner for managing end-of-life business technology.' },
  { role: 'Frankie Dawson', industry: 'Healthcare Facilities Manager', quote: 'Helpful support and a well-organised service for our IT disposal needs.' },
  { role: 'Sidney Clarke', industry: 'Financial Operations Manager', quote: 'Techsteps made our equipment collection simple and convenient.' },
  { role: 'Remy Walker', industry: 'Public Sector IT Manager', quote: 'A responsive team that handled our IT disposal requirements professionally.' },
  { role: 'Ellis Parker', industry: 'Education Technology Manager', quote: 'An easy, efficient experience with a team that understood our needs.' },
];
---

<BaseLayout
  title="Certifications & Accreditations — TechSteps UK"
  description="Explore TechSteps industry certifications and compliance register: ISO 27001, ISO 9001, ISO 14001, ISO 45001, ADISA, BS EN 15713, Cyber Essentials Plus, and more."
  canonicalUrl={canonicalUrl}
  jsonLd={pageSchema}
  hasHeroHeader={true}
>
  <!-- Top Navigation Header on clean white background -->
  <HeroHeader isHome={false} />

  <div class="certifications-page-wrapper bg-white text-slate-900 selection:bg-[#0F623A] selection:text-white">

    <!-- =====================================================
         1. HERO SECTION (Ref: About Us Centered Title + Quote + Showcase Card)
    ====================================================== -->
    <section
      id="certifications-hero"
      class="relative w-full bg-white select-none pt-4 sm:pt-6 lg:pt-8 pb-4 sm:pb-6"
    >
      <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Top Centered Heading & Quote (Matching About Us Hero Typography) -->
        <div class="max-w-3xl mx-auto text-center space-y-3 sm:space-y-3.5">
          <h1 class="font-display text-3xl sm:text-4xl md:text-5xl lg:text-[52px] font-bold text-slate-900 tracking-tight leading-[1.12]">
            Certified Standards &amp; <span class="text-[#0F623A]">Accreditations</span>
          </h1>
          <p class="text-base sm:text-lg text-slate-600 font-normal italic leading-relaxed max-w-2xl mx-auto">
            &ldquo;Operating under verified UKAS-accredited management systems, European destruction standards, and statutory environmental licences — delivering unbroken custody and defensible auditability across every consignment.&rdquo;
          </p>
        </div>

        <!-- Centered Image (Matching About Us Hero Visual Style) -->
        <div class="relative w-full max-w-4xl lg:max-w-5xl mx-auto mt-4 sm:mt-5 flex justify-center">
          <img
            src="/images/about/certificates/hero.png"
            alt="TechSteps certified compliance, secure transit, data sanitisation, and zero-landfill lifecycle"
            class="w-full h-auto object-contain block border-none shadow-none"
            width="1672"
            height="450"
            loading="eager"
            fetchpriority="high"
          />
        </div>

      </div>
    </section>


    <!-- =====================================================
         2. SECTION 2 — ANIMATED STATS STRIP (Ref: About Us Section 5)
    ====================================================== -->
    <section class="bg-white py-6 sm:py-8 select-none">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          id="stats-counter-block"
          class="flex flex-wrap items-center justify-between gap-6 sm:gap-8 lg:gap-10 text-center"
        >
          <!-- Metric 1 -->
          <div class="stat-item flex-1 min-w-[140px] sm:min-w-0">
            <span
              class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
            >
              18+
            </span>
            <span class="block mt-2 text-sm sm:text-base font-medium text-slate-700">
              Accreditations &amp; Standards
            </span>
          </div>

          <div class="hidden sm:block w-px h-10 bg-slate-200" aria-hidden="true"></div>

          <!-- Metric 2 -->
          <div class="stat-item flex-1 min-w-[140px] sm:min-w-0">
            <span
              class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
            >
              100%
            </span>
            <span class="block mt-2 text-sm sm:text-base font-medium text-slate-700">
              Audit-Ready Documentation
            </span>
          </div>

          <div class="hidden sm:block w-px h-10 bg-slate-200" aria-hidden="true"></div>

          <!-- Metric 3 -->
          <div class="stat-item flex-1 min-w-[140px] sm:min-w-0">
            <span
              class="block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none"
            >
              BS 7858
            </span>
            <span class="block mt-2 text-sm sm:text-base font-medium text-slate-700">
              Security-Vetted Personnel
            </span>
          </div>

          <div class="hidden sm:block w-px h-10 bg-slate-200" aria-hidden="true"></div>

          <!-- Metric 4 -->
          <div class="stat-item flex-1 min-w-[140px] sm:min-w-0">
            <span
              class="stat-counter-number block text-3xl sm:text-4xl lg:text-[42px] font-semibold text-[#0F623A] font-display tracking-tight leading-none tabular-nums"
            >
              0%
            </span>
            <span class="block mt-2 text-sm sm:text-base font-medium text-slate-700">
              Landfill (100% Diversion)
            </span>
          </div>
        </div>
      </div>
    </section>


    <!-- =====================================================
         3. SECTION 3 — EDITORIAL SPLIT: RIGOROUS GOVERNANCE & TRUST
         (Ref: About Us Section 3 "Nationwide network, local expertise")
    ====================================================== -->
    <section id="compliance-rigor" class="bg-white py-8 sm:py-12 lg:py-14">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">

          <!-- Left Column: Simple Feel-Good Message -->
          <div class="lg:col-span-7">
            <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-2 sm:mb-3">
              Trust &amp; Peace of Mind
            </p>
            <h2 class="text-3xl sm:text-4xl lg:text-[46px] font-bold text-slate-900 tracking-tight font-display leading-[1.14]">
              Certified Protection, <span class="text-[#0F623A]">Complete Peace of Mind</span>
            </h2>

            <p class="mt-4 sm:mt-5 text-base sm:text-lg text-slate-700 font-medium leading-relaxed max-w-none">
              We take the complexity out of IT disposal. Every asset is handled with certified care, verified security, and genuine environmental dedication — keeping your confidential data protected and your retired technology out of landfills.
            </p>

            <div class="mt-6 sm:mt-8 space-y-3.5">
              <div class="flex items-center gap-3">
                <div class="w-6 h-6 rounded-full bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center shrink-0 text-xs font-bold">
                  ✓
                </div>
                <span class="text-base font-medium text-slate-800">
                  100% Guaranteed Data Sanitisation &amp; Certified Destruction
                </span>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-6 h-6 rounded-full bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center shrink-0 text-xs font-bold">
                  ✓
                </div>
                <span class="text-base font-medium text-slate-800">
                  Zero-to-Landfill Responsible Recycling &amp; Sustainable Recovery
                </span>
              </div>

              <div class="flex items-center gap-3">
                <div class="w-6 h-6 rounded-full bg-[#0F623A]/10 text-[#0F623A] flex items-center justify-center shrink-0 text-xs font-bold">
                  ✓
                </div>
                <span class="text-base font-medium text-slate-800">
                  Security-Vetted Specialists &amp; Audit-Ready Certificates
                </span>
              </div>
            </div>
          </div>

          <!-- Right Column: Full Image (No Wrap, No Borderlines) -->
          <div class="lg:col-span-5 flex justify-center lg:justify-end">
            <img
              src="/images/about/who-we-are-technician.png"
              alt="TechSteps certified specialist securely handling and testing retired IT hardware"
              class="w-full max-w-sm sm:max-w-md h-auto object-contain block border-none shadow-none"
              width="800"
              height="800"
              loading="lazy"
            />
          </div>

        </div>
      </div>
    </section>


    <!-- =====================================================
         4. SECTION 4 — TRUSTED PARTNERSHIPS & GLOBAL COLLABORATION
         (Ref: About Us Section 2 Story Quote Cards)
    ====================================================== -->
    <section id="trusted-partnerships" class="bg-white py-8 sm:py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header -->
        <div class="w-full text-left mb-8 sm:mb-10">
          <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-2 sm:mb-3">
            Trusted Partnerships &amp; Global Network
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold text-slate-900 tracking-tight font-display leading-[1.14] max-w-4xl">
            Strong Partnerships with <span class="text-[#0F623A]">Trusted Industry Leaders</span>
          </h2>
          <p class="mt-3 text-base sm:text-lg text-slate-600 font-normal leading-relaxed max-w-3xl">
            We work closely with trusted companies, certified ITAD recyclers, and global technology partners to deliver seamless asset management, maximum value recovery, and responsible circular solutions.
          </p>
        </div>

        <!-- 2 Simple Feel-Good Quote Cards (Matching About Us Story Cards) -->
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
          
          <!-- Card 1: Enterprise ITAD & Security -->
          <div class="story-quote-card relative bg-slate-50/70 hover:bg-slate-50 border border-slate-100 rounded-2xl p-6 sm:p-7 transition-all duration-300">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-bold text-[#0F623A] uppercase tracking-[0.14em]">Enterprise ITAD &amp; Data Security</span>
            </div>
            <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed italic">
              &ldquo;Proudly partnering with leading organisations nationwide, providing certified asset disposition, guaranteed data destruction, and transparent chain-of-custody tracking at every step.&rdquo;
            </p>
          </div>

          <!-- Card 2: Responsible Recycling & Global Reach -->
          <div class="story-quote-card relative bg-slate-50/70 hover:bg-slate-50 border border-slate-100 rounded-2xl p-6 sm:p-7 transition-all duration-300">
            <div class="flex items-center gap-2 mb-3">
              <span class="text-xs font-bold text-[#0F623A] uppercase tracking-[0.14em]">Responsible Recycling &amp; Global Reach</span>
            </div>
            <p class="text-base sm:text-lg text-slate-700 font-medium leading-relaxed italic">
              &ldquo;Collaborating with trusted UK and international recycling partners to drive circular recovery, keep retired technology out of landfills, and create a sustainable global future.&rdquo;
            </p>
          </div>

        </div>

      </div>
    </section>


    <!-- =====================================================
         5. SECTION 5 — OFFICIAL ACCREDITATIONS REGISTER (LOGO & TITLE GRID)
    ====================================================== -->
    <section id="register-directory" class="py-10 sm:py-14 bg-white scroll-mt-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        
        <!-- Header (Clean Centered Heading, Ref: Partner Grid) -->
        <div class="w-full text-center max-w-3xl mx-auto mb-8 sm:mb-12">
          <p class="text-xs sm:text-sm font-bold text-[#0F623A] uppercase tracking-[0.15em] mb-2 sm:mb-3">
            Official Compliance Directory
          </p>
          <h2 class="text-3xl sm:text-4xl lg:text-[42px] font-bold text-slate-900 tracking-tight font-display leading-[1.14]">
            Certified Standards &amp; <span class="text-[#0F623A]">Accreditations</span>
          </h2>
        </div>

        <!-- Accreditations Clean Grid (Image + Title + Hover Tooltip, Ref: Partner Grid) -->
        <div class="rounded-2xl border border-slate-200/90 bg-white shadow-xs relative">
          <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 -mr-px -mb-px">
            {accreditations.map((cert) => (
              <div
                class="group relative border-r border-b border-slate-200/80 p-5 sm:p-6 flex flex-col items-center justify-center text-center bg-white hover:bg-slate-50/80 hover:z-30 transition-all duration-200 min-h-[140px] sm:min-h-[155px]"
                title={`${cert.name} — "${cert.quote}" (${cert.authority})`}
              >
                <!-- Logo -->
                <div class="h-12 sm:h-14 w-full flex items-center justify-center mb-3">
                  <img
                    src={cert.logo}
                    alt={`${cert.name} logo`}
                    class="max-h-10 max-w-[105px] w-auto h-auto object-contain transition-transform duration-300 group-hover:scale-105"
                    loading="lazy"
                    width="105"
                    height="40"
                  />
                </div>

                <!-- Title -->
                <h3 class="text-xs sm:text-sm font-bold text-slate-800 group-hover:text-[#0F623A] transition-colors leading-snug">
                  {cert.name}
                </h3>

                <!-- Hover Tooltip showing Quote Description -->
                <div
                  role="tooltip"
                  class="pointer-events-none absolute bottom-full left-1/2 -translate-x-1/2 mb-2.5 z-50 opacity-0 group-hover:opacity-100 group-hover:-translate-y-1 transition-all duration-200 w-64 sm:w-72 select-none"
                >
                  <div class="relative bg-teal-50 backdrop-blur-md text-slate-800 p-3.5 sm:p-4 rounded-xl shadow-xl shadow-teal-900/20 border border-teal-200 text-left">
                    <!-- Category & Standard Code Header -->
                    <div class="flex items-center justify-between gap-2 mb-2">
                      <span class="text-[10px] font-bold text-teal-800 uppercase tracking-wider bg-teal-200/50 px-2 py-0.5 rounded-full">
                        {cert.categoryLabel}
                      </span>
                      {cert.standardCode && (
                        <span class="text-[10px] text-teal-600/80 font-mono tracking-tight">
                          {cert.standardCode}
                        </span>
                      )}
                    </div>

                    <!-- Quote-Like Description -->
                    <p class="text-xs text-slate-700 font-normal leading-relaxed italic">
                      &ldquo;{cert.quote}&rdquo;
                    </p>

