        }
        /* A separate overlay permits a truly smooth gradient reveal, rather than
           jumping between an image gradient and a flat background colour. */
        #chain-of-custody .custody-motion-card::before {
          content: '';
          position: absolute;
          inset: 0;
          z-index: -1;
