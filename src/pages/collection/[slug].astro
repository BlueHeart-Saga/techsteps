---
import CollectionPageLayout from '../../components/collection/CollectionPageLayout.astro';
import { collectionServices } from '../../data/collectionServices';

export function getStaticPaths() {
  const paths = [];
  for (const [key, data] of Object.entries(collectionServices)) {
    paths.push({ params: { slug: key }, props: { data } });
    if (!key.endsWith('-services')) {
      paths.push({ params: { slug: `${key}-services` }, props: { data } });
    }
  }
  return paths;
}

const { data } = Astro.props;
---

<CollectionPageLayout data={data} />
