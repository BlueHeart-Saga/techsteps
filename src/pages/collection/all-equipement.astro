---
/**
 * all-equipement.astro
 * Comprehensive Directory of Accepted IT Equipment & Hardware
 * Route: /collection/all-equipement
 * 
 * Features:
 * - One-by-one showcase of all 8 equipment divisions with high-res photography
 * - Streamlined, premium copy with feel-good words and clean layout
 * - Unboxed plain SVG stroke icons (no emojis, no circles or box borders)
 * - Corporate green theme matching footer (#062C20)
 * - Unified FAQSection and global CTA
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/layout/Container.astro';
import FAQSection from '../../components/FAQSection.astro';
import CTA from '../../components/global/cta.astro';
import { getPageFaqs } from '../../data/pageFaqs';

const pageTitle = "Explore All IT Equipment & Devices We Collect | TechSteps UK";
const pageDescription = "Comprehensive directory of all business IT equipment collected by TechSteps. Laptops, desktops, enterprise servers, mobile fleets, monitors, printers, AV hardware and storage media. Free nationwide collection for qualifying UK organisations.";

const faqConfig = getPageFaqs('collection-overview');
const faqs = faqConfig?.faqs || [];

const equipmentList = [
  {
    id: "laptops",
    title: "Laptops & Notebooks",
    category: "Mobile Computing",
    badge: "Free Collection Eligible",
    image: "/images/collection/laptop-collection-hero.jpg",
    alt: "Corporate enterprise laptops and ultrabooks ready for collection",
    serviceUrl: "/laptop-collection",
    bookingType: "laptops",
    summary: "Complete lifecycle management for corporate laptop fleets, executive ultrabooks, and educational devices.",
    acceptedItems: [
      "MacBooks, ThinkPads, Latitudes & EliteBooks",
      "Chromebooks, Surface Pro & mobile workstations",
      "Field laptops, netbooks & tablet hybrids",
      "Docking stations, power adapters & accessories"
    ],
    security: "NIST 800-88 & ADISA certified multi-pass sanitisation or mobile on-site SSD shredding.",
    circular: "Refurbishment-first testing, graded remarketing, and circular component reuse."
  },
  {
    id: "computers",
    title: "Desktop Computers & Workstations",
    category: "Desktop Systems",
    badge: "Free Collection Eligible",
    image: "/images/collection/computer-collection-hero.jpg",
    alt: "Commercial desktop PC towers and workstations",
    serviceUrl: "/computer-collection",
    bookingType: "computers",
    summary: "Secure collection for commercial PC fleets, compact mini-units, all-in-ones, and high-performance CAD workstations.",
    acceptedItems: [
      "Micro, Mini & Small Form Factor (SFF) corporate PCs",
      "Mid-tower workstations & All-in-One iMacs/desktops",
      "Financial trading rigs & graphics rendering towers",
      "Keyboards, mice, connectivity cables & peripherals"
    ],
    security: "Cryptographic data erasure or physical hard drive destruction to Level H-5.",
    circular: "Memory and processor harvesting, chassis materials refined with zero landfill."
  },
  {
    id: "servers",
    title: "Servers & Data Centre Infrastructure",
    category: "Enterprise Infrastructure",
    badge: "De-Racking Service Available",
    image: "/images/collection/server-collection-hero.jpg",
    alt: "Enterprise rackmount servers and SAN arrays in data centre facility",
    serviceUrl: "/server-collection",
    bookingType: "servers",
    summary: "Accredited decommissioning and transport for enterprise rackmount servers, SAN arrays, blade chassis, and network fabrics.",
    acceptedItems: [
      "1U to 4U rackmount servers (Dell, HPE, Cisco)",
      "High-density blade chassis & modular enclosures",
      "SAN & NAS storage arrays (NetApp, Pure Storage)",
      "Core switches, firewalls, server racks & UPS units"
    ],
    security: "Witnessed on-site drive degaussing or certified destruction certificates.",
    circular: "Security-cleared de-racking, component recovery, and commercial remarketing."
  },
  {
    id: "mobile",
    title: "Smartphones & Mobile Tablets",
    category: "Mobile & Handhelds",
    badge: "Certified Factory Erasure",
    image: "/images/collection/mobile-device-collection-hero.jpg",
    alt: "Corporate smartphones, tablets and handheld devices",
    serviceUrl: "/mobile-device-collection",
    bookingType: "mobile",
    summary: "Secure retirement for distributed company smartphone fleets, tablets, and ruggedised warehouse scanners.",
    acceptedItems: [
      "Apple iPhones & iPads (all enterprise generations)",
      "Samsung Galaxy Enterprise phones & Android tablets",
      "Zebra & Honeywell rugged handheld scanners",
      "Charging cradles, docks & contactless payment terminals"
    ],
    security: "MDM lock removal, certified factory resets, and serialised erasure records.",
    circular: "Battery recycling under ADR regulations, precious metals recovered cleanly."
  },
  {
    id: "monitors",
    title: "Monitors & Commercial Displays",
    category: "Displays & Screens",
    badge: "WEEE Glass Stewardship",
    image: "/images/collection/monitor-screen-collection-hero.jpg",
    alt: "Commercial office monitors, ultrawide displays and presentation screens",
    serviceUrl: "/monitor-screen-collection",
    bookingType: "monitors",
    summary: "Responsible recycling for office monitors, high-resolution designer screens, ultrawide panels, and boardroom displays.",
    acceptedItems: [
      "Standard commercial LED & LCD monitors (21\" to 32\")",
      "Ultrawide curved displays & 4K designer screens",
      "Interactive smartboards & conference touchscreens",
      "Mounting arms, dual stands & digital signage panels"
    ],
    security: "Flash memory sanitisation and inspection on all integrated displays.",
    circular: "Safe lamp and backlight isolation, plastic pelletisation, high-grade cullet glass recovery."
  },
  {
    id: "printers",
    title: "Printers, Copiers & Scanners",
    category: "Print & Imaging",
    badge: "Internal Storage Sanitisation",
    image: "/images/collection/printer-copier-collection-hero.jpg",
    alt: "Commercial photocopiers and multi-function office printers",
    serviceUrl: "/printer-copier-collection",
    bookingType: "printers",
    summary: "Heavy-lift collection for floor-standing copiers, departmental multifunction printers, and wide-format CAD plotters.",
    acceptedItems: [
      "Floor-standing multifunction copiers (Canon, Ricoh, Xerox)",
      "Workgroup laser printers & network scanners",
      "Wide-format plotters & architectural printers",
      "Spent toner cartridges and imaging drum units"
    ],
    security: "Mandatory extraction and destruction of internal print-spool storage drives.",
    circular: "Ferrous metal separation, toner waste recovery, and responsible plastic recycling."
  },
  {
    id: "av-media",
    title: "Audio-Visual & Boardroom Systems",
    category: "Audio-Visual & Media",
    badge: "De-Installation Support",
    image: "/images/collection/av-media-collection-hero.jpg",
    alt: "Video conferencing bars, microphones and commercial projectors",
    serviceUrl: "/av-media-equipment-collection",
    bookingType: "av",
    summary: "Decommissioning and sustainable disposal for Teams/Zoom Room systems, ceiling mic arrays, and studio equipment.",
    acceptedItems: [
      "Video conference bars & PTZ conference cameras",
      "Teams/Zoom room hubs, DSPs & ceiling microphones",
      "Commercial laser projectors & projection screens",
      "AV rack matrix switchers, amplifiers & media consoles"
    ],
    security: "Full network credential clearing, cache deletion, and firmware resets.",
    circular: "Tested for circular redeployment to schools and non-profits, or raw metal recycling."
  },
  {
    id: "storage-media",
    title: "Storage Media, Hard Drives & Networking",
    category: "Storage & Networking",
    badge: "Level H-5 Physical Shredding",
    image: "/images/collection/collection-overview-hero.jpg",
    alt: "Loose hard drives, SSDs, backup tapes and networking switches",
    serviceUrl: "/services/collection",
    bookingType: "storage",
    summary: "Guaranteed destruction for bulk loose hard drives, enterprise solid-state media, backup tapes, and network hardware.",
    acceptedItems: [
      "2.5\" & 3.5\" SAS, SATA & Fibre Channel hard drives",
      "M.2, NVMe & PCIe enterprise SSD storage drives",
      "LTO magnetic backup tapes (all generations) & DLT media",
      "Managed switches, routers, firewalls & structured cabling"
    ],
    security: "Cross-cut shredding down to 6mm/2mm with serialised Certificates of Destruction.",
    circular: "Smelted for precious metals (gold, platinum, neodymium) with 0% landfill."
  }
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  hasHeroHeader={false}
>
  <!-- =====================================================
       1. HERO HEADER SECTION (CORPORATE GREEN THEME)
       ===================================================== -->
  <section class="relative pt-10 pb-16 sm:pt-14 sm:pb-20 lg:pt-16 lg:pb-24 bg-[#062C20] text-white overflow-hidden">
    <!-- Ambient Background Glow -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_70%_50%_at_50%_-10%,rgba(163,230,205,0.14),rgba(6,44,32,0))] pointer-events-none"></div>

    <Container>
      <div class="relative z-10 max-w-4xl mx-auto text-center">
        <!-- Breadcrumbs -->
        <nav class="flex items-center justify-center gap-2 text-xs sm:text-sm text-emerald-100/70 mb-6 font-sans" aria-label="Breadcrumb">
          <a href="/" class="hover:text-white transition-colors underline underline-offset-2">Home</a>
          <span>&gt;</span>
          <a href="/services/collection" class="hover:text-white transition-colors underline underline-offset-2">Free Collection</a>
          <span>&gt;</span>
          <span class="text-white font-medium">All Equipment Directory</span>
        </nav>

        <!-- Headline -->
        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight text-white font-display leading-[1.15] mb-4">
          All Equipment We Collect
        </h1>

        <!-- Subtitle -->
        <p class="text-base sm:text-lg text-emerald-50/90 max-w-2xl mx-auto leading-relaxed font-sans mb-8">
          Certified, zero-landfill collection for workplace technology, enterprise infrastructure, and storage media across the UK.
        </p>

        <!-- CTAs -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3">
          <a
            href="/book-pickup"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-8 py-3.5 rounded-[10px] bg-[#B8EC4C] hover:bg-[#a6d83e] text-[#0A261F] font-bold text-sm sm:text-base uppercase tracking-wider shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 font-sans"
          >
            REQUEST A COLLECTION
          </a>
          <a
            href="#equipment-showcase"
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 px-7 py-3.5 rounded-[10px] bg-white/10 hover:bg-white/15 text-white text-sm sm:text-base font-semibold border border-white/20 transition-all font-sans"
          >
            Explore Equipment Below ↓
          </a>
        </div>

        <!-- 4 Key Value Pillars -->
        <div class="grid grid-cols-2 md:grid-cols-4 gap-3.5 mt-12 pt-10 border-t border-white/10 text-left">
          <div class="p-3.5 rounded-[14px] bg-white/[0.04] border border-white/10">
            <div class="text-[#B8EC4C] text-xs font-mono font-bold mb-0.5">FREE COLLECTION</div>
            <div class="text-sm font-bold text-white">Nationwide UK</div>
            <p class="text-[12px] text-emerald-100/70 mt-0.5">10+ qualifying laptops, PCs or servers</p>
          </div>
          <div class="p-3.5 rounded-[14px] bg-white/[0.04] border border-white/10">
            <div class="text-[#B8EC4C] text-xs font-mono font-bold mb-0.5">DATA SECURITY</div>
            <div class="text-sm font-bold text-white">ADISA &amp; NIST 800-88</div>
            <p class="text-[12px] text-emerald-100/70 mt-0.5">Certified Blancco wiping &amp; shredding</p>
          </div>
          <div class="p-3.5 rounded-[14px] bg-white/[0.04] border border-white/10">
            <div class="text-[#B8EC4C] text-xs font-mono font-bold mb-0.5">ENVIRONMENT</div>
            <div class="text-sm font-bold text-white">0% Landfill Guarantee</div>
            <p class="text-[12px] text-emerald-100/70 mt-0.5">Refurbishment-first circular lifecycle</p>
          </div>
          <div class="p-3.5 rounded-[14px] bg-white/[0.04] border border-white/10">
            <div class="text-[#B8EC4C] text-xs font-mono font-bold mb-0.5">COMPLIANCE</div>
            <div class="text-sm font-bold text-white">Audit Certificates</div>
            <p class="text-[12px] text-emerald-100/70 mt-0.5">Duty of care Waste Transfer Notes</p>
          </div>
        </div>

      </div>
    </Container>
  </section>

  <!-- =====================================================
       2. ONE-BY-ONE EQUIPMENT SHOWCASE SECTION
       ===================================================== -->
  <section id="equipment-showcase" class="py-16 sm:py-20 bg-[#F8FAF9]">
    <Container>
      <!-- Section Header -->
      <div class="text-center max-w-3xl mx-auto mb-12 sm:mb-16">
        <span class="inline-block text-xs font-bold uppercase tracking-widest text-[#07572F] mb-2 font-mono">
          HARDWARE DIRECTORY
        </span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-[#062C20] tracking-tight font-display leading-tight">
          Accepted Equipment Breakdown
        </h2>
        <p class="mt-2.5 text-sm sm:text-base text-slate-600 font-sans leading-relaxed">
          Every item collected is handled securely and sustainably in strict accordance with UK environmental and data protection laws.
        </p>
      </div>

      <!-- Equipment Cards Stack -->
      <div class="space-y-10 sm:space-y-12">
        {equipmentList.map((item, index) => {
          const isEven = index % 2 === 1;

          return (
            <div
              id={item.id}
              class="bg-white rounded-[20px] sm:rounded-[24px] border border-slate-200/90 shadow-sm hover:shadow-md transition-all duration-200 overflow-hidden"
            >
              <div class={`flex flex-col ${isEven ? 'lg:flex-row-reverse' : 'lg:flex-row'} items-stretch`}>
                
                <!-- Visual Column (~42%) -->
                <div class="w-full lg:w-[42%] relative bg-slate-900 min-h-[260px] sm:min-h-[300px] lg:min-h-[360px] overflow-hidden">
                  <img
                    src={item.image}
                    alt={item.alt}
                    class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                    loading="lazy"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/20 to-transparent"></div>
                  
                  <!-- Top Badge -->
                  <div class="absolute top-4 left-4 right-4 flex items-center justify-between">
                    <span class="px-3 py-1 rounded-full bg-white/90 backdrop-blur-xs text-[#062C20] text-xs font-bold tracking-wide shadow-xs">
                      {item.category}
                    </span>
                    <span class="px-2.5 py-0.5 rounded-full bg-[#062C20] text-white text-[11px] font-mono font-bold tracking-wider uppercase border border-white/20">
                      0{index + 1}
                    </span>
                  </div>

                  <!-- Bottom Caption on Image -->
                  <div class="absolute bottom-4 left-4 right-4 text-white">
                    <p class="text-[11px] text-[#B8EC4C] font-mono font-bold uppercase tracking-wider mb-1">
                      {item.badge}
                    </p>
                    <h3 class="text-lg sm:text-xl font-bold font-display leading-snug drop-shadow-xs">
                      {item.title}
                    </h3>
                  </div>
                </div>

                <!-- Content Column (~58%) -->
                <div class="w-full lg:w-[58%] p-6 sm:p-8 lg:p-9 flex flex-col justify-between">
                  <div>
                    <h3 class="text-xl sm:text-2xl font-bold text-[#062C20] font-display leading-tight mb-2">
                      {item.title}
                    </h3>

                    <p class="text-xs sm:text-sm text-slate-600 leading-relaxed font-sans mb-5">
                      {item.summary}
                    </p>

                    <!-- Accepted Items Checklist -->
                    <div class="mb-5">
                      <h4 class="text-[11px] font-bold uppercase tracking-wider text-slate-500 mb-2 font-mono">
                        Common Devices &amp; Models Accepted:
                      </h4>
                      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs sm:text-[13px] text-slate-700">
                        {item.acceptedItems.map((accepted) => (
                          <li class="flex items-start gap-2">
                            <svg class="w-4 h-4 text-[#07572F] shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5" />
                            </svg>
                            <span>{accepted}</span>
                          </li>
                        ))}
                      </ul>
                    </div>

                    <!-- Security & Circular Specs (Clean Plain SVG Icons - No Emojis) -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 p-3.5 rounded-[14px] bg-[#F4FAF6] border border-[#D2EBDC] mb-6 text-xs text-slate-700">
                      <div>
                        <span class="font-bold text-[#07572F] flex items-center gap-1.5 mb-1 font-mono uppercase tracking-wider text-[11px]">
                          <svg class="w-3.5 h-3.5 text-[#07572F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
                          </svg>
                          Data Security
                        </span>
                        <p class="leading-relaxed">
                          {item.security}
                        </p>
                      </div>
                      <div>
                        <span class="font-bold text-[#07572F] flex items-center gap-1.5 mb-1 font-mono uppercase tracking-wider text-[11px]">
                          <svg class="w-3.5 h-3.5 text-[#07572F]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                          </svg>
                          Circular Outcome
                        </span>
                        <p class="leading-relaxed">
                          {item.circular}
                        </p>
                      </div>
                    </div>
                  </div>

                  <!-- Actions & Link -->
                  <div class="pt-4 border-t border-slate-100 flex flex-wrap items-center justify-between gap-3">
                    <a
                      href={item.serviceUrl}
                      class="text-xs sm:text-sm font-bold text-[#07572F] hover:text-[#062C20] hover:underline transition-colors font-sans"
                    >
                      View Dedicated Service &rarr;
                    </a>

                    <a
                      href={`/book-pickup?type=${item.bookingType}`}
                      class="px-5 py-2.5 rounded-[10px] bg-[#B8EC4C] hover:bg-[#a6d83e] text-[#0A261F] text-xs sm:text-sm font-bold uppercase tracking-wider shadow-xs hover:shadow transition-all font-sans"
                    >
                      Book Collection
                    </a>
                  </div>

                </div>

              </div>
            </div>
          );
        })}
      </div>
    </Container>
  </section>

  <!-- =====================================================
       3. FREE COLLECTION QUALIFICATION BANNER
       ===================================================== -->
  <section class="py-14 sm:py-16 bg-white border-t border-slate-200/80">
    <Container>
      <div class="max-w-4xl mx-auto bg-[#062C20] text-white rounded-[24px] p-8 sm:p-12 shadow-lg border border-emerald-900/60">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6">
          <div class="space-y-3">
            <span class="px-3 py-1 rounded-full bg-white/10 text-[#B8EC4C] text-[11px] font-mono font-bold uppercase tracking-wider inline-block">
              Eligibility Guide
            </span>
            <h2 class="text-2xl sm:text-3xl font-bold font-display text-white tracking-tight">
              Do You Qualify for Free UK Collection?
            </h2>
            <p class="text-xs sm:text-sm text-slate-300 leading-relaxed max-w-xl font-sans">
              Free collection is standard for UK organisations with <strong class="text-white">10 or more</strong> qualifying devices (laptops, PCs, or servers). For smaller quantities, our Tracked Courier Box service provides nationwide collection with certified disposal.
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-3 shrink-0 w-full md:w-auto">
            <a
              href="/book-pickup"
              class="w-full sm:w-auto text-center px-6 py-3.5 rounded-[10px] bg-[#B8EC4C] hover:bg-[#a6d83e] text-[#0A261F] font-bold text-xs sm:text-sm uppercase tracking-wider shadow transition-colors font-sans"
            >
              Book Free Collection
            </a>
            <a
              href="/book-pickup?tab=box"
              class="w-full sm:w-auto text-center px-6 py-3.5 rounded-[10px] bg-white/10 hover:bg-white/20 text-white font-bold text-xs sm:text-sm tracking-wider border border-white/20 transition-colors font-sans"
            >
              Tracked Box Service
            </a>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- =====================================================
       4. SECURITY & COMPLIANCE STANDARDS (PLAIN SVG ICONS)
       ===================================================== -->
  <section class="py-14 bg-[#F8FAF9] border-t border-slate-200/80">
    <Container>
      <div class="text-center max-w-2xl mx-auto mb-10">
        <h3 class="text-xs font-bold uppercase tracking-widest text-[#07572F] font-mono mb-1.5">
          OPERATIONAL SECURITY STANDARDS
        </h3>
        <p class="text-xl sm:text-2xl font-bold text-[#062C20] font-display">
          Guaranteed Compliance on Every Collection
        </p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto text-center">
        <!-- 1: ADISA Standard 8.0 -->
        <div class="p-5 rounded-[18px] bg-white border border-slate-200/90 shadow-xs">
          <svg class="w-7 h-7 text-[#07572F] mx-auto mb-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z" />
          </svg>
          <div class="font-bold text-sm text-[#062C20]">ADISA Standard 8.0</div>
          <p class="text-xs text-slate-500 mt-0.5">Certified Sanitisation</p>
        </div>

        <!-- 2: Environment Agency -->
        <div class="p-5 rounded-[18px] bg-white border border-slate-200/90 shadow-xs">
          <svg class="w-7 h-7 text-[#07572F] mx-auto mb-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-.778.099-1.533.284-2.253" />
          </svg>
          <div class="font-bold text-sm text-[#062C20]">Environment Agency</div>
          <p class="text-xs text-slate-500 mt-0.5">Licensed Carrier CBDU45123</p>
        </div>

        <!-- 3: ISO Certifications -->
        <div class="p-5 rounded-[18px] bg-white border border-slate-200/90 shadow-xs">
          <svg class="w-7 h-7 text-[#07572F] mx-auto mb-2.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75" aria-hidden="true">
