<script>
  // Simple Volume Qualifier Interactivity
  function initVolumeChecker() {
    const inputs = document.querySelectorAll<HTMLInputElement>('#calc-laptops, #calc-pcs, #calc-servers, #calc-monitors');
    const resultBox = document.getElementById('calc-result');
    if (!resultBox || inputs.length === 0) return;

    const checkTotal = () => {
      let total = 0;
      inputs.forEach(input => {
        total += parseInt(input.value || '0', 10);
      });

      if (total >= 10) {
        resultBox.innerHTML = `
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-emerald-400 text-emerald-950 font-bold flex items-center justify-center shrink-0">
              ✓
            </div>
            <div>
              <div class="font-bold text-white text-sm sm:text-base">
                Your batch qualifies for 100% Free Nationwide Collection! (${total} items total)
              </div>
              <div class="text-xs text-emerald-200">
                Includes GPS-tracked transport, Waste Transfer Note, and certified data erasure.
              </div>
            </div>
          </div>
          <a
            href="/book-pickup"
            class="shrink-0 px-6 py-2.5 rounded-[12px] bg-white text-[#0F3D32] font-bold text-xs sm:text-sm hover:bg-emerald-50 transition-colors shadow"
          >
            Confirm Free Pickup &rarr;
          </a>
        `;
        resultBox.className = "p-4 rounded-xl bg-emerald-500/20 border border-emerald-400/40 flex flex-col sm:flex-row items-center justify-between gap-4";
      } else {
        resultBox.innerHTML = `
          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-full bg-amber-400 text-amber-950 font-bold flex items-center justify-center shrink-0">
              ℹ
            </div>
            <div>
              <div class="font-bold text-white text-sm sm:text-base">
                Small batch detected (${total} items) — Eligible for Tracked Courier Box or Combined Run!
              </div>
              <div class="text-xs text-amber-200">
                You can still book a subsidized pickup or choose our convenient Tracked Box Service.
              </div>
            </div>
          </div>
          <a
            href="/book-pickup?tab=box"
            class="shrink-0 px-6 py-2.5 rounded-[12px] bg-amber-400 text-amber-950 font-bold text-xs sm:text-sm hover:bg-amber-300 transition-colors shadow"
          >
            Explore Box Service &rarr;
          </a>
        `;
        resultBox.className = "p-4 rounded-xl bg-amber-500/20 border border-amber-400/40 flex flex-col sm:flex-row items-center justify-between gap-4";
      }
    };

    inputs.forEach(input => {
      input.addEventListener('input', checkTotal);
    });
  }

  initVolumeChecker();
  document.addEventListener('astro:page-load', initVolumeChecker);
</script>
