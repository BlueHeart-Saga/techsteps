<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <!-- HTTP Compression -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Static Content & MIME Mapping -->
    <staticContent>
      <!-- Remove existing extensions before adding to avoid duplicate mime mapping errors -->
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />

      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />

      <remove fileExtension=".woff" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />

      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />

      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />

      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />

      <remove fileExtension=".xml" />
      <mimeMap fileExtension=".xml" mimeType="application/xml" />

      <!-- Default Client Cache (7 days) -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>

    <!-- Custom HTTP Security Headers -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-XSS-Protection" value="1; mode=block" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
        <add name="Strict-Transport-Security" value="max-age=31536000; includeSubDomains; preload" />
      </customHeaders>
    </httpProtocol>

    <!-- URL Rewrite & Routing Rules -->
    <rewrite>
      <rules>
        <!-- Rule 1: Enforce HTTPS -->
        <rule name="Redirect to HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^localhost" negate="true" />
            <add input="{HTTP_HOST}" pattern="^127\.0\.0\.1" negate="true" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>

        <!-- Rule 2: Legacy Devopstrio Link -->
        <rule name="Redirect Devopstrio" stopProcessing="true">
          <match url="^devopstrio(.*)" />
          <action type="Redirect" url="/services/secure-it-disposal" redirectType="Permanent" />
        </rule>

        <!-- Rule 3: Terms Alias to Terms and Conditions -->
        <rule name="Redirect Terms Alias" stopProcessing="true">
          <match url="^terms/?$" />
          <action type="Redirect" url="/terms-and-conditions" redirectType="Permanent" />
        </rule>

        <!-- Rule 4: Legacy WordPress Redirects -->
        <rule name="Redirect About" stopProcessing="true">
          <match url="^about/?$" />
          <action type="Redirect" url="/about-us" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Contact" stopProcessing="true">
          <match url="^contact-us/?$" />
          <action type="Redirect" url="/contact" redirectType="Permanent" />
        </rule>
        <rule name="Redirect Quote" stopProcessing="true">
          <match url="^(request-quote|quote)/?$" />
          <action type="Redirect" url="/request-a-quote" redirectType="Permanent" />
        </rule>

        <!-- Rule 5: Block WordPress Admin Scans -->
        <rule name="Block WP Admin" stopProcessing="true">
          <match url="^(wp-login\.php|wp-admin/?.*)" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Resource does not exist." />
        </rule>

        <!-- Rule 6: Clean URL routing for Astro static build -->
        <rule name="Rewrite to HTML" stopProcessing="true">
          <match url="^(.*)$" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
            <add input="{DOCUMENT_ROOT}/{R:1}.html" matchType="IsFile" />
          </conditions>
          <action type="Rewrite" url="{R:1}.html" />
        </rule>
      </rules>
    </rewrite>

    <!-- Custom 404 Error Page -->
    <httpErrors errorMode="Custom" existingResponse="Auto">
      <remove statusCode="404" />
      <error statusCode="404" path="/404.html" responseMode="ExecuteURL" />
    </httpErrors>
  </system.webServer>
</configuration>
